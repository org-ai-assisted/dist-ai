#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Shared harness for the derivative-maker 'help-steps/' functional tests:
## assertion counters, subject lookup, and the mount-namespace runner that
## gives these tests mount capability.
##
## Not a '*_test.sh', so 'dm-help-steps-tests' does not run it as a test.
##
## style-ok: no-strict -- sourced-only fragment; a top-level 'set -o errexit'/
## 'nounset'/'pipefail' would leak into (and could kill) the sourcing shell.

test_failures=0

## The derivative-maker checkout under test. An explicitly named tree is the ONLY
## answer: falling back to '~/derivative-maker' reports on a DIFFERENT tree than
## the caller asked about, and a stale checkout there then reads as a defect in
## the code under test rather than as a stale checkout.
if [ -n "${DERIVATIVE_MAKER_DIR:-}" ]; then
   dm_checkout="${DERIVATIVE_MAKER_DIR}"
else
   dm_checkout="${HOME}/derivative-maker"
fi

pass() {
   printf '%s\n' "PASS: $*"
}

fail() {
   printf '%s\n' "FAIL: $*" >&2
   test_failures=$((test_failures + 1))
}

## Resolve the help-steps script named '$1' (first hit wins):
##   '$2', when non-empty -- the suite's env override
##   -> a copy staged in '$3', the calling test's directory
##   -> a derivative-maker checkout under ~/derivative-maker
locate_help_step() {
   local script_name env_override test_dir checkout

   script_name="$1"
   env_override="${2:-}"
   test_dir="$3"

   if [ -n "${env_override}" ]; then
      printf '%s\n' "${env_override}"
      return 0
   fi
   if [ -r "${test_dir}/${script_name}" ]; then
      printf '%s\n' "${test_dir}/${script_name}"
      return 0
   fi
   checkout="${dm_checkout}/help-steps/${script_name}"
   if [ -r "${checkout}" ]; then
      printf '%s\n' "${checkout}"
      return 0
   fi
   printf '%s\n' "ERROR: help-steps script '${script_name}' not found." >&2
   return 1
}

## The 'unshare' flags that give this process mount capability, chosen by
## privilege. Root already holds CAP_SYS_ADMIN and only needs its own mount
## namespace; adding '--user' there is not merely redundant but FATAL on a
## hardened kernel, where an LSM denies user-namespace creation outright
## (Kicksecure does) and the run dies with "Permission denied" -- which reads
## as "no mount capability" and silently drops every mount assertion.
mount_namespace_flags=()

## Populate 'mount_namespace_flags'; non-zero when no flavour works, in which
## case the caller has no mount capability at all.
mount_namespace_available() {
   mount_namespace_flags=()

   if [ "${EUID}" = "0" ]; then
      if unshare --mount --propagation private true 2>/dev/null; then
         mount_namespace_flags=( --mount --propagation private )
         return 0
      fi
   fi

   ## Unprivileged: a user namespace grants tmpfs-mount capability without
   ## real privilege, so the checks still run in an unprivileged container.
   if unshare --user --map-root-user --mount --propagation private true 2>/dev/null; then
      mount_namespace_flags=( --user --map-root-user --mount --propagation private )
      return 0
   fi

   return 1
}

## Run '$1' (an inner script) inside a private mount namespace, with '$2'
## (the script under test) staged alongside it; any further arguments are
## passed to the inner script verbatim. Prints the run's combined output and
## exits with its status.
##
## The namespace's private mounts vanish with it, so there is nothing to
## clean up on the host.
##
## Both scripts are STAGED as world-readable copies first: under
## '--map-root-user' the checkout's own path is often untraversable (its
## owner is unmapped in the namespace, so bash reads it EPERM), while a temp
## copy is reachable.
run_in_mount_namespace() {
   local inner_script subject_script staged_inner staged_subject namespace_rc

   inner_script="$1"
   subject_script="$2"
   shift 2

   if [ "${#mount_namespace_flags[@]}" = "0" ]; then
      printf '%s\n' "ERROR: run_in_mount_namespace called without a successful mount_namespace_available." >&2
      return 1
   fi

   staged_inner="$(mktemp)"
   staged_subject="$(mktemp)"
   cp -- "${inner_script}" "${staged_inner}"
   cp -- "${subject_script}" "${staged_subject}"
   chmod 0755 -- "${staged_inner}" "${staged_subject}"

   namespace_rc=0
   unshare "${mount_namespace_flags[@]}" \
      bash "${staged_inner}" "${staged_subject}" "$@" 2>&1 || namespace_rc="$?"

   safe-rm --force -- "${staged_inner}" "${staged_subject}"

   return "${namespace_rc}"
}

## Assert that '$1' (the inner run's output) carries the marker '$2'.
require_result() {
   local run_output marker description

   run_output="$1"
   marker="$2"
   description="$3"

   if printf '%s\n' "${run_output}" | grep --max-count=1 --fixed-strings -- "${marker}" >/dev/null 2>&1; then
      pass "${description}"
   else
      fail "${description} (missing marker '${marker}')"
      printf '%s\n' "DEBUG: inner run output follows:" >&2
      printf '%s\n' "${run_output}" >&2
   fi
}
