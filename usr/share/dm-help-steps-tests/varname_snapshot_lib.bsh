## AI-Assisted

## Shared capture + normalization for the derivative-maker variable snapshots.
## Sourced by both the generator 'dm-varname-snapshot' and the drift test
## 'varname_snapshot_test.sh', so the two cannot diverge on what a snapshot is.
##
## What a snapshot is: for one build command (a --flavor x --target pair), the
## set of variables that 'help-steps/variables' introduces on top of a bare
## 'help-steps/pre', dumped as 'declare -p' lines with all machine-, clock-, and
## checkout-varying values normalized to placeholders -- so a rerun on any
## machine yields byte-identical output. This is the baseline a large 'variables'
## refactoring is checked against.
##
## Not a '*_test.sh', so 'dm-help-steps-tests' does not run it as a test.
##
## style-ok: no-strict -- sourced-only fragment; a top-level 'set -o errexit'/
## 'nounset' would leak into (and could kill) the sourcing shell.

## The build commands to snapshot: every flavor x every target. Invalid combos
## are rejected by derivative-maker's own parse-cmd/variables validation and
## recorded in '_rejected.txt', not curated here (we do not reinvent dm's
## validity matrix). Flavor and target lists mirror parse_cmd_flavor_error and
## parse_cmd_target_error in help-steps/parse-cmd.
vs_flavors=(
   whonix-gateway-lxqt
   whonix-gateway-rpi
   whonix-gateway-cli
   whonix-workstation-lxqt
   whonix-workstation-cli
   whonix-custom-workstation
   whonix-host-lxqt
   whonix-host-cli
   kicksecure-cli
   kicksecure-lxqt
   kicksecure-ci-tiny-do-not-use
   dist-installer-cli
   source
)
vs_targets=(
   virtualbox
   qcow2
   utm
   iso
   raw
   dist-installer-cli
   windows
   root
)

## Fixed, deterministic build inputs shared by every capture, so only the
## flavor/target axes vary between snapshots.
##   --arch amd64      pins every architecture-derived value (the suite/CI run amd64)
##   --freshness current  satisfies the mandatory freshness choice without touching
##                        a frozen pin file
##   --freedom false   satisfies the mandatory firmware choice (required for the
##                     '--target iso' combos; harmless for the rest)
vs_fixed_args=( --freshness current --arch amd64 --freedom false )

## Environment shared by BOTH the baseline sourcing and the combo capture. It
## MUST be identical for the two, or a variable set here leaks: these names are
## process-environment entries that 'declare -p' reports regardless of what
## pre/variables do, so any set only for the combo would be absent from the
## baseline and never subtracted -- polluting every snapshot (and masking the
## case where 'variables' itself ever sets one of these names).
##   dist_build_dump_varnames        triggers the dump hook at the end of variables
##   dist_build_unlock_dangerous_options  allows the dangerous ci-tiny flavor
##   dist_build_allow_root           lets pre source under root (CI/suite elevates)
vs_capture_env=(
   dist_build_dump_varnames=true
   dist_build_unlock_dangerous_options=true
   dist_build_allow_root=true
)

## Shell-special names that 'declare -p' emits but 'variables' never sets. Most
## are already in the pre baseline; BASH_REMATCH and a few others populate
## lazily, so name-subtraction alone can miss them. Dropped unconditionally.
vs_shell_special_re='^(BASH_REMATCH|BASH_ARGC|BASH_ARGV|BASH_LINENO|BASH_SOURCE|BASH_COMMAND|BASH_SUBSHELL|BASH_EXECUTION_STRING|FUNCNAME|PIPESTATUS|LINENO|RANDOM|SECONDS|SRANDOM|EPOCHREALTIME|EPOCHSECONDS|_)$'

## Variables whose VALUE is 'git describe'-derived off the PINNED dist_build_version
## sentinel, so the snapshot value is a pin artifact carrying no build-config signal and
## has no stable placeholder: dist_build_version_described is dist_build_version's commit
## id (empty here, since the sentinel's short id is not 40-hex). DROPPED by name like the
## shell-specials -- keeps the oracle insensitive to whether a given dm version defines it,
## so it is not perpetual snapshot noise.
vs_volatile_derived_re='^(dist_build_version_described)$'

## help-steps/variables loop-sources variables.d/*.bsh with this loop variable; it
## is 'unset' after the loop, so a real build never sees it -- but the dump hook
## fires from the LAST module (60_*), i.e. mid-loop, before that unset runs, so a
## snapshot would otherwise carry the last module's path. Loader plumbing, no
## build-config signal: DROPPED by name like the shell-specials.
vs_loader_plumbing_re='^(variables_d_module)$'

## The file contents that variables.d/99_effects.bsh writes are STAGED into these
## variables by the resolver modules, then written to disk. They are effect inputs
## (one is the whole multi-line pbuilder.conf), not part of the variable contract,
## and the files' correctness is verified by the build steps that read them --
## DROPPED so the snapshot tracks the variable surface, not staged file bodies.
vs_effect_staging_re='^(dist_aptgetopt_file_content|dist_build_pbuilder_config_content)$'

## The EXPORTED-CONTRACT: the interface between 'help-steps/variables' and the rest
## of the build. A producer rewrite (file split, helper reuse, declaration block,
## effect relocation) legitimately changes internal temporaries and non-consumed
## function bodies, so the full 'declare -p' snapshot is NOT a neutrality gate for
## it -- only this contract is. Two parts:
##   1. every EXPORTED variable (name + normalized value), per build command;
##   2. the bodies of the functions build steps actually call (below).
##
## vs_consumed_funcs: functions 'variables' introduces that are called OUTSIDE the
## resolution machinery (build-steps.d, other help-steps, dev-meta libexec). Their
## bodies are part of the contract; internal-only helpers are not. Kept in sync by
## vs_assert_consumed_complete (fails if the tree gains/loses an external caller).
vs_consumed_funcs=(
   chroot_run
   dist_build_arch_to_qemu_machine
   repository_dist_initializer_setup
   set_cowbuilder_folders
   set_dist_build_reprepro_folder_options
)

## Files that DEFINE the resolution machinery: a reference to a function here is its
## definition or an internal call, not external consumption. Paths relative to the
## derivative-maker checkout root. Extend when the resolver layout changes.
vs_resolution_machinery_res=(
   '^help-steps/variables$'
   '^help-steps/parse-cmd$'
   '^help-steps/pre$'
   '^buildconfig\.d/'
   '^variables\.d/'
   'arch-to-qemu-machine\.bsh$'
)

## Set by vs_init_baseline: a sorted file of the names to subtract.
vs_baseline_file=""

## Set by vs_init_func_baseline: a sorted file of the function NAMES to subtract
## (those 'help-steps/pre' defines), so a function snapshot shows only the
## functions 'variables' itself introduces.
vs_baseline_func_file=""

## Resolve the derivative-maker checkout (env override, else ~/derivative-maker),
## matching help_steps_test_lib.bsh.
vs_resolve_dm() {
   if [ -n "${DERIVATIVE_MAKER_DIR:-}" ]; then
      printf '%s\n' "${DERIVATIVE_MAKER_DIR}"
   else
      printf '%s\n' "${HOME}/derivative-maker"
   fi
}

## Extract the variable name from a single 'declare -p' line.
vs_declare_name() {
   sed -E 's/^declare -[-a-zA-Z]+ ([A-Za-z_][A-Za-z0-9_]*).*/\1/'
}

## Names present after sourcing only help-steps/pre (no parse-cmd, no variables):
## the inherited-env + pre baseline to subtract, so a snapshot shows only what
## 'variables' itself introduced. Printed sorted, one per line.
vs_baseline_names() {
   local dm="$1"
   ( cd -- "${dm}" && env "${vs_capture_env[@]}" bash -c 'source help-steps/pre; declare -p' ) 2>/dev/null \
      | grep '^declare ' | vs_declare_name | LC_ALL=C sort -u
}

## Compute the baseline once for a checkout, into a temp file named by
## vs_baseline_file. Non-zero (and an error) if pre cannot be sourced -- an empty
## baseline would make every inherited name look 'introduced'.
vs_init_baseline() {
   local dm="$1"
   vs_baseline_file="$(mktemp)"
   ## '|| true': vs_baseline_names ends in a pipeline, so under errexit+pipefail a
   ## failed 'source pre' (empty output -> grep exits 1) would abort here BEFORE
   ## the '-s' check, losing the actionable message below. Let the check report it.
   vs_baseline_names "${dm}" > "${vs_baseline_file}" || true
   if [ ! -s "${vs_baseline_file}" ]; then
      printf '%s\n' "ERROR: empty variable baseline for '${dm}'; help-steps/pre failed to source." >&2
      return 1
   fi
}

## Replace every machine-, clock-, checkout-, and arch-varying value with a
## stable placeholder. Args: <dm-checkout-path> <home>. Reads 'declare -p' lines
## on stdin, writes normalized lines on stdout.
##
## Path substitution QUOTES the pattern ('${x//"$a"/b}') so bash matches it
## literally -- an unquoted pattern is glob-expanded, and a '[' / '*' / '?' in the
## checkout path or $HOME would then under- or over-match. The checkout path is
## replaced before $HOME because it is the more specific (longer) prefix. The
## git-describe version token is replaced before the bare 40-hex commit id because
## the token contains a hash.
vs_normalize() {
   local dm="$1" home="$2" line
   ## '|| [ -n "${line}" ]' processes a final line with no trailing newline (the
   ## rejection reason arrives that way); a plain 'while read' would drop it.
   while IFS= read -r line || [ -n "${line}" ]; do
      line="${line//"${dm}"/@DM@}"
      line="${line//"${home}"/@HOME@}"
      printf '%s\n' "${line}"
   done | sed -E '
      s/[0-9]+(\.[0-9]+)*-[0-9]+-g[0-9a-f]{7,40}/@VERSION@/g
      s/[0-9a-f]{40}/@GITHEAD@/g
      s/(SOURCE_DATE_EPOCH=")[0-9]+/\1@EPOCH@/g
      s/(host_architecture=")[^"]*/\1@ARCH@/g
      s/(user_name=")[^"]*/\1@USER@/g
      s/[[:space:]]+$//
   '
}

## Keep only variables-introduced names (drop the baseline and shell-specials),
## then normalize. Arg: <dm-checkout-path>. Reads 'declare -p' lines on stdin.
vs_filter_and_normalize() {
   local dm="$1"
   grep '^declare ' \
      | awk -v basefile="${vs_baseline_file}" -v specialre="${vs_shell_special_re}" \
            -v volatilere="${vs_volatile_derived_re}" -v plumbingre="${vs_loader_plumbing_re}" \
            -v stagingre="${vs_effect_staging_re}" '
           BEGIN { while ((getline n < basefile) > 0) base[n] = 1 }
           {
              name = $0
              sub(/^declare -[-a-zA-Z]+ /, "", name)
              sub(/[^A-Za-z0-9_].*/, "", name)
              if (name in base) next
              if (name ~ specialre) next
              if (name ~ volatilere) next
              if (name ~ plumbingre) next
              if (name ~ stagingre) next
              print
           }' \
      | vs_normalize "${dm}" "${HOME}"
}

## Capture the outcome of one build command. Args: <dm> <flavor> <target>.
##   Valid combo:    prints the normalized snapshot to stdout, returns 0.
##   Rejected combo: prints a single-line sanitized rejection reason to stdout,
##                   returns 1.
## The caller distinguishes the two by return code and captures either result
## from stdout the same way -- so it works through '$(...)' (a subshell), where a
## global side-effect would be lost.
##
## dm's exception handler prints its error block to STDOUT (only bash's own
## 'command not found' for the absent full-harness error helper reaches stderr),
## so both streams are captured and the salient 'message:' line is pulled from
## either. The reason is normalized and reduced to printable ASCII so
## '_rejected.txt' stays byte-identical across reruns (ASCII-only, per repo
## rules; no stray color escapes or checkout paths).
vs_capture_combo() {
   local dm="$1" flavor="$2" target="$3"
   local outfile errfile rc reason
   outfile="$(mktemp)"
   errfile="$(mktemp)"
   ## Pin dist_build_version to a fixed git-describe-form sentinel. Unset, it is
   ## 'git describe' of the checkout: a describable tag yields X.Y.Z-N-gHASH
   ## (normalized to @VERSION@), but a tagless / shallow checkout (as CI's
   ## actions/checkout is) falls back to the bare 40-hex head (normalized to
   ## @GITHEAD@) -- so the same version-bearing paths normalized differently by
   ## machine, and a host-generated snapshot never matched CI. Pinning makes the
   ## version deterministic -> @VERSION@ everywhere; the real head
   ## (dist_build_current_git_head) is still @GITHEAD@.
   if (
      cd -- "${dm}" \
         && env dist_build_dump_varnames=true dist_build_unlock_dangerous_options=true \
            dist_build_allow_root=true \
            dist_build_version='0.0.0-0-g0000000' \
            bash -c 'source help-steps/pre; source help-steps/variables "$@"' _ \
            --flavor "${flavor}" --target "${target}" "${vs_fixed_args[@]}"
   ) >"${outfile}" 2>"${errfile}"; then
      rc=0
   else
      rc=$?
   fi
   if [ "${rc}" -ne 0 ]; then
      reason="$(cat -- "${outfile}" "${errfile}" | grep -m1 -E '^message:' || true)"
      [ -n "${reason}" ] || reason="rejected by derivative-maker (no 'message:' emitted)"
      ## Strip ANSI color escapes, normalize volatile substrings, keep printable
      ## ASCII only, collapse whitespace to one line.
      reason="$(
         printf '%s' "${reason}" \
            | LC_ALL=C sed -E 's/\x1b\[[0-9;]*[A-Za-z]//g' \
            | vs_normalize "${dm}" "${HOME}" \
            | LC_ALL=C tr -cd '[:print:]' \
            | LC_ALL=C sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//'
      )"
      safe-rm --force -- "${outfile}" "${errfile}"
      printf '%s\n' "${reason}"
      return 1
   fi
   safe-rm --force -- "${errfile}"
   vs_filter_and_normalize "${dm}" < "${outfile}"
   safe-rm --force -- "${outfile}"
}

## Function names present after sourcing only help-steps/pre: the baseline of
## functions to subtract, so a function snapshot shows only what 'variables'
## introduces. 'declare -F' prints 'declare -f NAME' lines; keep the NAME.
## Printed sorted, one per line.
vs_baseline_func_names() {
   local dm="$1"
   ( cd -- "${dm}" && env "${vs_capture_env[@]}" bash -c 'source help-steps/pre; declare -F' ) 2>/dev/null \
      | awk '{ print $3 }' | LC_ALL=C sort -u
}

## Compute the function-name baseline once for a checkout, into a temp file named
## by vs_baseline_func_file. Non-zero (and an error) if pre cannot be sourced --
## an empty baseline would make every inherited function look 'introduced'.
vs_init_func_baseline() {
   local dm="$1"
   vs_baseline_func_file="$(mktemp)"
   ## '|| true': the pipeline can fail (empty output -> awk still 0, but keep the
   ## same shape as vs_init_baseline); let the '-s' check report an empty baseline.
   vs_baseline_func_names "${dm}" > "${vs_baseline_func_file}" || true
   if [ ! -s "${vs_baseline_func_file}" ]; then
      printf '%s\n' "ERROR: empty function baseline for '${dm}'; help-steps/pre failed to source." >&2
      return 1
   fi
}

## Drop the baseline functions from a 'declare -f' dump, keeping only the
## functions 'variables' introduces. Reads 'declare -f' output on stdin. bash's
## pretty-print starts each definition with a 'name () ' header at column 0 and
## closes it with a '}' at column 0; nested braces are INDENTED, so the closer is
## the only bare '}' -- EXCEPT a heredoc body, which bash emits verbatim (not
## indented), so a heredoc line that is just '}' also sits at column 0. Keying the
## end off the FIRST bare '}' therefore truncates any function with such a
## heredoc. Instead buffer each function's lines (header to the next header / EOF)
## and emit through its LAST bare '}': that is the real closer, so a heredoc's '}'
## stays in the body and the trailing 'help-steps/pre' EXIT-trap banner (its
## varying 'Execution Time: Ns') after the closer is dropped. Then normalize, so a
## stray checkout path in a body cannot vary the snapshot.
vs_filter_functions() {
   local dm="$1"
   awk -v basefile="${vs_baseline_func_file}" '
      function flush(   k, last) {
         if (keep && nbuf > 0) {
            last = 0
            for (k = 1; k <= nbuf; k++) if (buf[k] == "}") last = k
            for (k = 1; k <= last; k++) print buf[k]
         }
         nbuf = 0
      }
      BEGIN { while ((getline n < basefile) > 0) base[n] = 1 }
      /^[A-Za-z_][A-Za-z0-9_]* \(\) $/ { flush(); keep = ($1 in base) ? 0 : 1 }
      { if (keep) buf[++nbuf] = $0 }
      END { flush() }
   ' \
      | vs_normalize "${dm}" "${HOME}"
}

## Capture the function definitions 'variables' introduces for one build command.
## Args: <dm> <flavor> <target>. Prints the filtered, normalized snapshot to
## stdout and returns 0 on a valid combo; returns 1 (no output) on a rejected
## combo -- the caller uses a KNOWN-valid combo, so a non-zero here is an error.
## Mirrors vs_capture_combo but drives the 'dist_build_dump_funcnames' hook.
vs_capture_functions() {
   local dm="$1" flavor="$2" target="$3"
   local outfile rc
   outfile="$(mktemp)"
   if (
      cd -- "${dm}" \
         && env dist_build_dump_funcnames=true dist_build_unlock_dangerous_options=true \
            dist_build_allow_root=true \
            bash -c 'source help-steps/pre; source help-steps/variables "$@"' _ \
            --flavor "${flavor}" --target "${target}" "${vs_fixed_args[@]}"
   ) >"${outfile}" 2>/dev/null; then
      rc=0
   else
      rc=$?
   fi
   if [ "${rc}" -ne 0 ]; then
      safe-rm --force -- "${outfile}"
      return 1
   fi
   vs_filter_functions "${dm}" < "${outfile}"
   safe-rm --force -- "${outfile}"
}

## Extract the bodies of the vs_consumed_funcs from a function snapshot, in the
## array's order, each as a 'name ()' header block. Reads a functions.snapshot
## file (already baseline-subtracted + normalized) named by $1; writes to stdout.
## Same bash-pretty-print block shape as vs_filter_functions: a 'name ()' header
## (trailing space stripped by vs_normalize, so tolerate both) to the next header /
## EOF, emitted through the LAST bare '}' -- the real closer -- so a heredoc body
## line that is just '}' at column 0 does not truncate the captured body.
vs_extract_consumed_bodies() {
   local snapshot="$1" fn
   for fn in "${vs_consumed_funcs[@]}"; do
      awk -v want="${fn}" '
         function flush(   k, last) {
            if (inblock && nbuf > 0) {
               last = 0
               for (k = 1; k <= nbuf; k++) if (buf[k] == "}") last = k
               for (k = 1; k <= last; k++) print buf[k]
            }
            inblock = 0; nbuf = 0
         }
         /^[A-Za-z_][A-Za-z0-9_]* \(\) ?$/ {
            if (inblock) flush()
            if ($0 == want" ()" || $0 == want" () ") inblock = 1
         }
         { if (inblock) buf[++nbuf] = $0 }
         END { flush() }
      ' "${snapshot}"
   done
}

## Derive the exported contract from a full snapshot dir ($1) into an output dir
## ($2): per-combo exported-only '.vars', the consumed-function bodies, and the
## rejected-combo validity matrix. This is what the neutrality gate diffs -- NOT
## the full 'declare -p', so an internal-temporary rename does not trip it.
vs_derive_contract() {
   local full_dir="$1" out_dir="$2" f base
   mkdir --parents -- "${out_dir}"
   shopt -s nullglob
   for f in "${full_dir}"/*.vars; do
      base="${f##*/}"
      ## Exported == declare flags string contains 'x' (declare -x, -ax, -rx, ...).
      grep -E '^declare -[a-zA-Z-]*x[a-zA-Z-]* ' -- "${f}" | LC_ALL=C sort > "${out_dir}/${base}"
   done
   if [ -f "${full_dir}/functions.snapshot" ]; then
      vs_extract_consumed_bodies "${full_dir}/functions.snapshot" > "${out_dir}/_consumed_functions.snapshot"
   fi
   [ ! -f "${full_dir}/_rejected.txt" ] || cp -- "${full_dir}/_rejected.txt" "${out_dir}/_rejected.txt"
}

## The functions 'variables' introduces (headers of a functions.snapshot, $1),
## sorted unique.
vs_introduced_func_names() {
   grep -oE '^[A-Za-z_][A-Za-z0-9_]* \(\)' -- "$1" | sed 's/ ()$//' | LC_ALL=C sort -u
}

## Verify vs_consumed_funcs still equals the set of introduced functions called
## OUTSIDE the resolution machinery. Args: <dm> <functions.snapshot>. Prints the
## drift and returns 1 if the tree gained or lost an external caller (so the
## hand-maintained list cannot silently fall out of sync); 0 when they agree.
vs_assert_consumed_complete() {
   local dm="$1" snapshot="$2" fn machine_grep actual_file expected_file candidate_files f
   ## One alternation of all machinery path patterns for a single grep -vE.
   machine_grep="$(IFS='|'; printf '%s' "${vs_resolution_machinery_res[*]}")"
   actual_file="$(mktemp)"
   expected_file="$(mktemp)"
   printf '%s\n' "${vs_consumed_funcs[@]}" | LC_ALL=C sort -u > "${expected_file}"
   while IFS= read -r fn; do
      ## Candidate call-site FILES: the name word-bounded on a non-comment,
      ## non-definition line, in a checkout-relative path that is NOT resolution
      ## machinery. cut to the file, unique.
      candidate_files="$(
         ( cd -- "${dm}" \
              && grep -rnE "\\b${fn}\\b" build-steps.d help-steps packages 2>/dev/null ) \
            | grep -vE ":[0-9]+:[[:space:]]*#" \
            | grep -vE ":[0-9]+:[[:space:]]*${fn}[[:space:]]*\\(\\)" \
            | sed -E 's/^\.\///' \
            | grep -vE "(${machine_grep})" \
            | cut -d: -f1 | LC_ALL=C sort -u
      )"
      ## A file that DEFINES its own '${fn}()' (e.g. an installed package binary
      ## with a same-named helper) references its own copy, not the build-time
      ## resolver -- drop it. If any candidate remains, the function is genuinely
      ## consumed outside the machinery.
      while IFS= read -r f; do
         [ -n "${f}" ] || continue
         grep --quiet --extended-regexp "^[[:space:]]*${fn}[[:space:]]*\\(\\)" -- "${dm}/${f}" && continue
         printf '%s\n' "${fn}"
         break
      done <<< "${candidate_files}"
   done < <(vs_introduced_func_names "${snapshot}") | LC_ALL=C sort -u > "${actual_file}"
   if diff -u "${expected_file}" "${actual_file}"; then
      safe-rm --force -- "${actual_file}" "${expected_file}"
      return 0
   fi
   printf '%s\n' "MISMATCH: vs_consumed_funcs (< expected) vs functions actually called outside the resolution machinery (> actual)." >&2
   safe-rm --force -- "${actual_file}" "${expected_file}"
   return 1
}
