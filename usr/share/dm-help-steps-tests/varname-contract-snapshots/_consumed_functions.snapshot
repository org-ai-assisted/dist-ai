chroot_run ()
{
    ${SUDO_TO_ROOT} env ${chroot_remove_env_list} -- chroot -- "${CHROOT_FOLDER}" "$@"
}
dist_build_arch_to_qemu_machine ()
{
    case "${1}" in
        amd64)
            printf '%s' "x86_64"
        ;;
        arm64)
            printf '%s' "aarch64"
        ;;
        armel)
            printf '%s' "arm"
        ;;
        armhf)
            printf '%s' "arm"
        ;;
        mipsel)
            printf '%s' "mipsel"
        ;;
        mips64el)
            printf '%s' "mips64el"
        ;;
        ppc64el)
            printf '%s' "ppc64le"
        ;;
        riscv64)
            printf '%s' "riscv64"
        ;;
        s390x)
            printf '%s' "s390x"
        ;;
        *)
            return 1
        ;;
    esac
}
loop_teardown_verify ()
{
    local image loop_devices_output loop_devices_item attempt losetup_rc;
    image="$1";
    if [ "${image:-}" = "" ]; then
        return 1;
    fi;
    for ((attempt = 0; attempt < 5; attempt++ ))
    do
        losetup_rc=0;
        loop_devices_output="$(${SUDO_TO_ROOT} losetup --associated "${image}" --noheadings --output NAME)" || losetup_rc="$?";
        if [ "${losetup_rc}" != "0" ]; then
            return 1;
        fi;
        if [ "${loop_devices_output:-}" = "" ]; then
            return 0;
        fi;
        while read -r loop_devices_item; do
            if [ "${loop_devices_item:-}" = "" ]; then
                continue;
            fi;
            ${SUDO_TO_ROOT} kpartx -d -s -v -- "${loop_devices_item}" || true "INFO: kpartx non-zero exit code.";
            ${SUDO_TO_ROOT} losetup --detach "${loop_devices_item}" || true "INFO: losetup non-zero exit code.";
        done <<< "${loop_devices_output}";
        ${SUDO_TO_ROOT} udevadm settle --timeout 5 || true;
        sleep 1;
    done;
    losetup_rc=0;
    loop_devices_output="$(${SUDO_TO_ROOT} losetup --associated "${image}" --noheadings --output NAME)" || losetup_rc="$?";
    if [ "${losetup_rc}" != "0" ]; then
        return 1;
    fi;
    [ "${loop_devices_output:-}" = "" ]
}
repository_dist_initializer_setup ()
{
    [ -n "${binary_build_folder_dist}" ] || error "repository_dist_initializer_setup: variable binary_build_folder_dist missing!";
    [ -n "${CHROOT_FOLDER}" ] || error "repository_dist_initializer_setup: variable CHROOT_FOLDER missing!";
    true "INFO: build_remote_repo_enable: ${build_remote_repo_enable}";
    if [ "${build_remote_repo_enable}" = 'true' ]; then
        printf "%s\n" "${DERIVATIVE_APT_REPOSITORY_OPTS}" | sponge -- "${binary_build_folder_dist}/derivative_apt_repository_opts";
        true "INFO: sudo test";
        ${SUDO_TO_ROOT} test -d /usr;
        ${SUDO_TO_ROOT} mkdir --parents -- "${CHROOT_FOLDER}/var/lib/repository-dist/";
        ${SUDO_TO_ROOT} cp -- "${binary_build_folder_dist}/derivative_apt_repository_opts" "${CHROOT_FOLDER}/var/lib/repository-dist/derivative_apt_repository_opts";
    else
        safe-rm --force -- "${binary_build_folder_dist}/derivative_apt_repository_opts";
    fi
}
resolve-partition-uuid ()
{
    local partition_name lsblk_output name uuid;
    partition_name="$1";
    lsblk_output="$(lsblk --raw --noheadings --output NAME,UUID)";
    while read -r name uuid; do
        if [ "${name}" = "${partition_name}" ]; then
            printf '%s\n' "${uuid}";
            return 0;
        fi;
    done <<< "${lsblk_output}"
}
set_cowbuilder_folders ()
{
    cow_folder="${cowbuilder_cache_dir}/cow.cow_${dist_build_multiarch_package_item}";
    base_folder="${cowbuilder_cache_dir}/base.cow_${dist_build_multiarch_package_item}"
}
set_dist_build_reprepro_folder_options ()
{
    local derivative_name_item valid_repository_name;
    valid_repository_name=false;
    if [ "${derivative_repository_name:-}" = "" ]; then
        error "derivative_repository_name is empty!";
    fi;
    true "derivative_repository_name: ${derivative_repository_name}";
    for derivative_name_item in ${derivative_name_list};
    do
        if [ "${derivative_repository_name:-}" = "${derivative_name_item}" ]; then
            valid_repository_name=true;
            break;
        fi;
    done;
    if [ ! "${valid_repository_name:-}" = "true" ]; then
        error "derivative_repository_name '${derivative_repository_name}' is invalid! (not in derivative_name_list)";
    fi;
    [[ -v make_reprepro_codename_item ]] || make_reprepro_codename_item="${dist_build_apt_codename}";
    true "make_reprepro_codename_item: ${make_reprepro_codename_item}";
    if [ "${make_reprepro_codename_item:-}" = "local" ]; then
        apt_repo_sub_folder="aptrepo_local/${derivative_repository_name}";
    else
        apt_repo_sub_folder="aptrepo_remote/${derivative_repository_name}";
    fi;
    dist_apt_repository_folder="${binary_build_folder_dist}/${apt_repo_sub_folder}";
    export dist_apt_repository_folder;
    dist_build_reprepro_folder_options=(--basedir "${source_code_folder_dist}/${apt_repo_sub_folder}" --outdir "${binary_build_folder_dist}/${apt_repo_sub_folder}" --dbdir "${binary_build_folder_dist}/${apt_repo_sub_folder}/db" --logdir "${binary_build_folder_dist}/${apt_repo_sub_folder}/log")
}
unmount_if_mounted ()
{
    local mountpoint_rc=0;
    ${SUDO_TO_ROOT} mountpoint --quiet -- "$1" || mountpoint_rc="$?";
    case "${mountpoint_rc}" in
        0)
            ${SUDO_TO_ROOT} umount --verbose -- "$1"
        ;;
        32)
            return 0
        ;;
        *)
            return "${mountpoint_rc}"
        ;;
    esac
}
username-plain-for-sudoers ()
{
    local candidate LC_ALL=C;
    candidate="$1";
    if [[ "${candidate}" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
        return 1;
    fi;
    check_valid_linux_user_account_name "${candidate}"
}
