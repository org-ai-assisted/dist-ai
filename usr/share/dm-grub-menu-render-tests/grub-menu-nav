## AI-Assisted

## Boot a grub-menu test ISO under a chosen firmware, drive the REAL derivative-maker
## ISO GRUB menu over serial, enter the "Utilities..." submenu, and report whether a
## given menuentry title renders -- the interactive menu observation the boot-test
## harness (dm-smbios-reader-boot-tests) deliberately lacks (it autoboots past the menu).
##
## qemu argv (incl. the correct OVMF/SeaBIOS wiring per --firmware) is obtained from
## the REAL `dm-smbios-reader-qemu --emit-argv`, so this composes with the existing harness rather
## than reimplementing firmware setup. This process only adds the serial-driven menu
## navigation on top.
##
## Exit: 0 the observation MATCHED --expect; 1 it did not (or the submenu never
## rendered); 2 setup error.

import argparse
import os
import shutil
import subprocess
import sys
import tempfile


def log(msg):
    print("grub-menu-nav: %s" % msg, file=sys.stderr, flush=True)


def die_setup(msg):
    log(msg)
    sys.exit(2)


def emit_qemu_argv(dm_qemu, firmware, iso, serial_log, tmpdir):
    ## dm-smbios-reader-qemu prints qemu_bin + one arg per line to STDOUT (notes to STDERR),
    ## then exits 0 without booting. --serial-logfile wires an explicit stdio
    ## chardev, so THIS process (pexpect) owns the serial pty while a complete
    ## copy still lands in the log file.
    ##
    ## dm-smbios-reader-qemu's OVMF-vars copy (efi/efi-secureboot) is created with `mktemp`,
    ## which honours TMPDIR -- so point it at OUR private dir and remove that,
    ## rather than parsing a workdir path out of dm-smbios-reader-qemu's stderr (a stream that
    ## also echoes the caller-controlled --iso value, so a crafted path could
    ## steer an rmtree).
    cmd = [
        dm_qemu, "--emit-argv",
        "--firmware", firmware,
        "--iso", iso,
        "--serial-logfile", serial_log,
    ]
    env = dict(os.environ, TMPDIR=tmpdir)
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, env=env)
    except OSError as exc:
        die_setup("cannot run dm-smbios-reader-qemu (%s): %s" % (dm_qemu, exc))
    if proc.returncode != 0:
        die_setup("dm-smbios-reader-qemu --emit-argv failed (rc=%s):\n%s" % (proc.returncode, proc.stderr))
    argv = [line for line in proc.stdout.splitlines() if line != ""]
    if len(argv) < 2:
        die_setup("dm-smbios-reader-qemu --emit-argv produced no argv:\n%s" % proc.stdout)
    return argv


def main():
    ## Lightweight dependency probe for the entrypoint's e2e gate: exit 0 iff
    ## pexpect imports, without the other required args. Kept here (rather than an
    ## inline `python3 -c` in the shell gate) so the check runs the same
    ## interpreter as the real driver.
    if "--check-deps" in sys.argv[1:]:
        try:
            import pexpect  # noqa: F401
        except ImportError:
            return 1
        return 0

    parser = argparse.ArgumentParser()
    parser.add_argument("--dm-smbios-reader-qemu", required=True)
    parser.add_argument("--firmware", required=True, choices=["bios", "efi", "efi-secureboot"])
    parser.add_argument("--iso", required=True)
    parser.add_argument("--serial-log", required=True)
    parser.add_argument("--submenu-hotkey", required=True,
                        help="GRUB --hotkey char of the submenu to enter (e.g. 'u')")
    parser.add_argument("--submenu-marker", required=True,
                        help="a title that renders in the submenu (proves it opened)")
    parser.add_argument("--entry-title", required=True,
                        help="the menuentry title under test")
    parser.add_argument("--expect", required=True, choices=["present", "absent"])
    parser.add_argument("--menu-timeout", type=int, default=180,
                        help="seconds to wait for the top menu (TCG boot is slow)")
    parser.add_argument("--submenu-timeout", type=int, default=60,
                        help="seconds to wait for the submenu to render")
    parser.add_argument("--top-marker", default="Utilities",
                        help="a title in the TOP menu (proves it rendered)")
    args = parser.parse_args()

    if not os.path.isfile(args.iso):
        die_setup("iso not found: %s" % args.iso)

    try:
        import pexpect
    except ImportError:
        die_setup("python3-pexpect is required")

    ## Private scratch dir for dm-smbios-reader-qemu's OVMF-vars copy (via TMPDIR); removed
    ## wholesale below -- no path is parsed from any output.
    nav_tmp = tempfile.mkdtemp(prefix="grub-menu-nav.")
    child = None
    rc = 2
    try:
        argv = emit_qemu_argv(args.dm_smbios_reader_qemu, args.firmware, args.iso, args.serial_log, nav_tmp)
        log("firmware=%s: spawning %s" % (args.firmware, " ".join(argv)))

        child = pexpect.spawn(
            argv[0], args=argv[1:],
            timeout=args.menu_timeout,
            encoding="utf-8", codec_errors="replace",
        )

        ## 1. Top menu rendered on serial.
        try:
            child.expect(args.top_marker, timeout=args.menu_timeout)
        except pexpect.TIMEOUT:
            log("FAIL: top menu (%r) never rendered within %ss"
                % (args.top_marker, args.menu_timeout))
            return 1
        except pexpect.EOF:
            log("FAIL: qemu exited before the top menu rendered")
            return 1

        ## 2. Enter the submenu via its GRUB hotkey. A keypress also cancels the
        ## menu countdown, so the menu holds while we read.
        child.send(args.submenu_hotkey)

        ## 3. Read to the submenu marker (the LAST entry in the block); everything
        ## rendered before it -- including the entry under test, if present -- is in
        ## child.before. Deterministic: no reliance on match ordering of the title.
        try:
            child.expect(args.submenu_marker, timeout=args.submenu_timeout)
        except pexpect.TIMEOUT:
            log("FAIL: submenu marker (%r) never rendered after hotkey %r; the "
                "submenu did not open (see %s)"
                % (args.submenu_marker, args.submenu_hotkey, args.serial_log))
            return 1
        except pexpect.EOF:
            log("FAIL: qemu exited before the submenu rendered")
            return 1

        submenu_text = child.before + args.submenu_marker
        present = args.entry_title in submenu_text
        observed = "present" if present else "absent"

        if observed == args.expect:
            log("PASS: entry %r is %s in the %s submenu (as expected)"
                % (args.entry_title, observed, args.firmware))
            rc = 0
        else:
            log("FAIL: entry %r is %s in the %s submenu; expected %s"
                % (args.entry_title, observed, args.firmware, args.expect))
            rc = 1
    finally:
        if child is not None:
            try:
                child.terminate(force=True)
            except Exception:
                pass
        shutil.rmtree(nav_tmp, ignore_errors=True)

    return rc


if __name__ == "__main__":
    sys.exit(main())
