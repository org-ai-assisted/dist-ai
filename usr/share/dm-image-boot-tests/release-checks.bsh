#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## The SINGLE source of truth for the numbered release-critical checks (the
## catastrophic-regression gate: "stable users receiving stable updates are never
## bricked"). Both the Calamares install gate (dm-calamares-install) and the
## upgrade-regression gate (dm-upgrade-regression) iterate THIS table, so the two
## gates can never drift -- a check added/changed here changes both at once.
##
## The TABLE is transport-agnostic; HOW a check runs in-guest is the caller's
## executor callback (OCR terminal markers for a Guest-Additions-less Calamares
## disk; VBoxManage guestcontrol for a shipped VM image). The caller sets `me`
## (program name, for messages) and, when it matters, RELEASE_CHECK_FIRMWARE
## (bios|efi|efi-secureboot) so check 8 can tolerate the SecureBoot-only GA failures.
##
## style-ok: no-strict -- sourced-only fragment; a top-level 'set -o errexit'/
## 'nounset'/'pipefail' would leak into (and could kill) the sourcing shell.
## SC2154: `me` is set by the sourcing tool. SC2034: the RELEASE_CHECK_FAILED_*
## status vars are WRITTEN here but READ by the sourcing tool (consumed externally).
# shellcheck disable=SC2154,SC2034

## Battery run order: ALL user-session checks, then ALL sysmaint-session checks
## (exactly one user->sysmaint transition, which the driver turns into a reboot).
RELEASE_CHECK_ORDER=(1 5 6 4 8 2 3)

## Which boot role each check must run in.
declare -A RELEASE_CHECK_SESSION=(
   [1]='user' [5]='user' [6]='user' [4]='user' [8]='user'
   [2]='sysmaint' [3]='sysmaint'
)

## Per-check wall-clock budget (seconds).
declare -A RELEASE_CHECK_TIMEOUT=(
   [1]=60 [5]=60 [6]=60 [4]=90 [8]=300 [2]=60 [3]=1800
)

## Attempts (1 = no retry). Check 8 (systemcheck) retries across the transient
## just-booted window where check_system_ready is not yet settled.
declare -A RELEASE_CHECK_RETRIES=(
   [1]=1 [5]=1 [6]=1 [4]=1 [8]=3 [2]=1 [3]=1
)

## Sleep between retries (seconds); default 0 when unset.
declare -A RELEASE_CHECK_RETRY_SLEEP=(
   [8]=45
)

## Human description (names the guarantee a red check broke).
declare -A RELEASE_CHECK_DESC=(
   [1]='user session boot'
   [5]='CLI login'
   [6]='GUI login'
   [4]='networking'
   [8]='systemcheck --leak-tests'
   [2]='sysmaint session boot'
   [3]='upgrade-nonroot'
)

## Whether the screen is expected to show a full graphical desktop at this check
## (lets a visual cross-check assert a real graphical mode; the Calamares gate uses
## it for its check-6 render wait, the guestcontrol gate for a resolution check).
declare -A RELEASE_CHECK_DESKTOP=(
   [1]='true' [5]='true' [6]='true' [4]='true' [8]='true'
   [2]='false' [3]='false'
)

## The check command (in-guest). No pipe/tab needed; run by the caller's executor.
declare -A RELEASE_CHECK_CMD=(
   [1]='! grep -q boot-role=sysmaint /proc/cmdline'
   [5]='whoami'
   [6]='pgrep labwc'
   [4]='curl --silent --fail --max-time 30 --output /dev/null https://deb.debian.org'
   [8]='systemcheck --cli --leak-tests --ci'
   [2]='grep -q boot-role=sysmaint /proc/cmdline'
   [3]='upgrade-nonroot'
)

## VBox Guest-Additions service units that SecureBoot REJECTS (unsigned, out-of-tree
## modules) in an EFI+SecureBoot test VM, leaving systemd 'degraded'. These units are
## TEST-INFRA ONLY (the GA is injected for the VBox test; nothing ships them, and no
## shipped modules-load.d references them), so check 8 (systemcheck) tolerates EXACTLY
## these -- and ONLY under efi-secureboot -- via systemcheck's --ignore-failed-unit.
## Any OTHER failed unit, or any other firmware (bios / plain-efi, where the modules
## load fine), still fails check 8.
##
## DELIBERATELY NOT here: systemd-modules-load.service. It also loads SHIPPED hardened
## modules (e.g. jitterentropy_rng via security-misc's 30_security-misc.conf), so a
## unit-wide ignore would MASK a real shipped-module load regression under the most
## security-critical config -- the exact "stable users bricked" guarantee this gate
## protects. If it fails under SB for a test-only module, fix that at the specific
## module/injection, never by ignoring the whole unit.
RELEASE_CHECK8_SB_IGNORED_UNITS=(
   vboxadd.service
   vboxadd-service.service
)

## The in-guest command for a check, with firmware-specific adjustments applied.
## RELEASE_CHECK_FIRMWARE (caller-set; empty = none) gates the check-8 SecureBoot
## tolerance above -- so bios / plain-efi and other callers (dm-upgrade-regression)
## are byte-for-byte unchanged. Pure (no side effects), hence unit-testable.
release_check_cmd() {
   local num="$1" unit
   local cmd="${RELEASE_CHECK_CMD[${num}]}"
   if [ "${num}" = '8' ] && [ "${RELEASE_CHECK_FIRMWARE:-}" = 'efi-secureboot' ]; then
      for unit in "${RELEASE_CHECK8_SB_IGNORED_UNITS[@]}"; do
         cmd+=" --ignore-failed-unit ${unit}"
      done
   fi
   printf '%s' "${cmd}"
}

## Set by the driver on a failed check; READ by the sourcing tool for its message.
RELEASE_CHECK_FAILED_NUM=''
RELEASE_CHECK_FAILED_REASON=''

## Run ONE check. The visual cross-check (verify_fn) runs FIRST ("render-first"):
## the screen must look right BEFORE the functional probe, so a "process ok but the
## screen is blank/panic" divergence fails HERE, and the executor -- which owns the
## single "check N PASS" line -- prints it only after BOTH signals hold (never a
## premature green). The check is GREEN only when BOTH agree.
##   verify_fn NUM DESKTOP -> rc (0 visual ok); '' to skip. DESKTOP='true' means a
##             full graphical desktop is expected at this check.
##   exec_fn   NUM SESSION CMD TIMEOUT -> rc (0 pass); emits "check N PASS" on pass.
## Returns 0 PASS / 1 FAIL (reason in RELEASE_CHECK_FAILED_*).
release_check_one() {
   local exec_fn="$1" verify_fn="$2" num="$3"
   local session="${RELEASE_CHECK_SESSION[${num}]}"
   local cmd; cmd="$(release_check_cmd "${num}")"
   local timeout="${RELEASE_CHECK_TIMEOUT[${num}]}"
   local retries="${RELEASE_CHECK_RETRIES[${num}]}"
   local retry_sleep="${RELEASE_CHECK_RETRY_SLEEP[${num}]:-0}"
   local desktop="${RELEASE_CHECK_DESKTOP[${num}]}"
   local desc="${RELEASE_CHECK_DESC[${num}]}"
   ## render-first visual pre-check.
   if [ -n "${verify_fn}" ]; then
      if ! "${verify_fn}" "${num}" "${desktop}"; then
         RELEASE_CHECK_FAILED_NUM="${num}"
         RELEASE_CHECK_FAILED_REASON="${desc} (visual cross-check: the screen did not render as expected)"
         return 1
      fi
   fi
   local attempt rc=1
   for (( attempt = 1; attempt <= retries; attempt++ )); do
      rc=0
      "${exec_fn}" "${num}" "${session}" "${cmd}" "${timeout}" || rc=$?
      if [ "${rc}" -eq 0 ]; then
         break
      fi
      if [ "${attempt}" -lt "${retries}" ]; then
         printf '%s\n' "${me}: check ${num} (${desc}) not clean yet (attempt ${attempt}); retrying" >&2
         sleep "${retry_sleep}"
      fi
   done
   if [ "${rc}" -ne 0 ]; then
      RELEASE_CHECK_FAILED_NUM="${num}"
      RELEASE_CHECK_FAILED_REASON="${desc} (functional, rc=${rc})"
      return 1
   fi
   return 0
}

## Run the full battery in order. Reboots into sysmaint (via reboot_sysmaint_fn)
## when the table crosses from the user group to the sysmaint group. Fail-fast:
## returns nonzero on the FIRST failed check (reason in RELEASE_CHECK_FAILED_*),
## so a broken guest never burns the 1800s upgrade-nonroot budget needlessly.
##   exec_fn           NUM SESSION CMD TIMEOUT -> rc (emits "check N PASS" on pass)
##   reboot_sysmaint_fn                         -> reach a ready sysmaint session
##   verify_fn         NUM DESKTOP             -> rc; '' to skip the visual cross-check
run_release_check_battery() {
   local exec_fn="$1" reboot_sysmaint_fn="$2" verify_fn="${3:-}"
   local num cur_session='user' session
   RELEASE_CHECK_FAILED_NUM=''
   RELEASE_CHECK_FAILED_REASON=''
   for num in "${RELEASE_CHECK_ORDER[@]}"; do
      session="${RELEASE_CHECK_SESSION[${num}]}"
      if [ "${session}" != "${cur_session}" ]; then
         ## The table only ever steps user -> sysmaint once.
         if [ "${cur_session}" = 'user' ] && [ "${session}" = 'sysmaint' ]; then
            printf '%s\n' "${me}: reboot into the SYSMAINT session for checks 2, 3"
            ## A failed reboot (guest never comes back) must fail the battery, not be
            ## discarded -- else a later reachable probe could mask the reboot failure.
            if ! "${reboot_sysmaint_fn}"; then
               RELEASE_CHECK_FAILED_NUM="${num}"
               RELEASE_CHECK_FAILED_REASON="could not reach the SYSMAINT session (reboot failed) before check ${num}"
               return 1
            fi
            cur_session='sysmaint'
         else
            RELEASE_CHECK_FAILED_NUM="${num}"
            RELEASE_CHECK_FAILED_REASON="unsupported session transition ${cur_session} -> ${session}"
            return 1
         fi
      fi
      release_check_one "${exec_fn}" "${verify_fn}" "${num}" || return 1
   done
   return 0
}
