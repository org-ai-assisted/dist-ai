## AI-Assisted

## Generates a self-test fixture for iso-download: a signing keypair, a fake
## ISO published under iso/<version>/ with its OpenPGP .asc and .sha512sums, a
## directory-index page (to exercise highest-version discovery), a wiki
## Template:VersionNew raw body (the stable pin), and a urlmap that maps the
## exact URLs iso-download will request to those local files -- so the curl-stub
## can serve the whole flow with no network. Fault flags produce the negatives.
##
## The base URLs below MUST match what run-tests passes to iso-download.
##
## Key generation and signing go through sqop (Stateless OpenPGP).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## style-ok: no-has -- standalone fixture generator; probes for sqop with
## 'command -v' rather than helper-scripts' 'has'.

me="${0##*/}"

if [ "${ISO_DOWNLOAD_TESTS:-}" != '1' ]; then
   printf '%s\n' "${me}: must be run via the iso-download-tests entrypoint." >&2
   exit 1
fi

die() {
   printf '%s\n' "${me}: ERROR: $*" >&2
   exit 1
}

## Shared with run-tests; RFC 2606 reserved names, unresolvable.
download_base='https://download.example.com'
wiki_base='https://www.example.com'

out_dir=""
version="18.4.0.5"
stable_version=""
older_version="18.3.0.0"
vmname="Kicksecure"
desktop="Xfce"
arch="Intel_AMD64"
wrong_signer='false'
bad_hash='false'
bad_sig='false'
sums_wrong_name='false'
omit_wiki='false'
wiki_crlf='false'
index_leading_version='false'

print_usage() {
   printf '%s\n' "Usage:
  ${me} <output_dir> [--version V] [--stable-version V] [--older-version V]
        [--vmname N] [--desktop T] [--arch A]
        [--wrong-signer] [--bad-hash] [--bad-sig]
        [--sums-wrong-name] [--omit-wiki] [--wiki-crlf]
        [--index-leading-version]"
}

while [ "$#" -gt 0 ]; do
   case "$1" in
      --version)
         [ "$#" -ge 2 ] || die "missing value for --version"
         version="$2"
         shift 2
         ;;
      --stable-version)
         [ "$#" -ge 2 ] || die "missing value for --stable-version"
         stable_version="$2"
         shift 2
         ;;
      --older-version)
         [ "$#" -ge 2 ] || die "missing value for --older-version"
         older_version="$2"
         shift 2
         ;;
      --vmname)
         [ "$#" -ge 2 ] || die "missing value for --vmname"
         vmname="$2"
         shift 2
         ;;
      --desktop)
         [ "$#" -ge 2 ] || die "missing value for --desktop"
         desktop="$2"
         shift 2
         ;;
      --arch)
         [ "$#" -ge 2 ] || die "missing value for --arch"
         arch="$2"
         shift 2
         ;;
      --wrong-signer)
         wrong_signer='true'
         shift
         ;;
      --bad-hash)
         bad_hash='true'
         shift
         ;;
      --bad-sig)
         bad_sig='true'
         shift
         ;;
      --sums-wrong-name)
         sums_wrong_name='true'
         shift
         ;;
      --omit-wiki)
         omit_wiki='true'
         shift
         ;;
      --wiki-crlf)
         wiki_crlf='true'
         shift
         ;;
      --index-leading-version)
         index_leading_version='true'
         shift
         ;;
      -h|--help)
         print_usage
         exit 0
         ;;
      --)
         shift
         break
         ;;
      -*)
         die "unknown flag '$1'"
         ;;
      *)
         [ -z "${out_dir}" ] || die "unexpected positional '$1'"
         out_dir="$1"
         shift
         ;;
   esac
done

[ -n "${out_dir}" ] || die "missing <output_dir> argument"
command -v sqop >/dev/null || die "sqop not installed (Debian: sqop)"

if [ -z "${stable_version}" ]; then
   stable_version="${version}"
fi

mkdir --parents -- "${out_dir}"
out_dir="$(cd -- "${out_dir}" && pwd)"

image="${vmname}-${desktop}-${version}.${arch}.iso"
version_dir="${out_dir}/iso/${version}"
mkdir --parents -- "${version_dir}"

secret_key="${out_dir}/test-key.sec"
public_cert="${out_dir}/test-cert.asc"
image_path="${version_dir}/${image}"
sums_path="${image_path}.sha512sums"
sig_path="${sums_path}.asc"
index_path="${out_dir}/iso-index.html"
wiki_path="${out_dir}/wiki-versionnew.raw"
urlmap="${out_dir}/urlmap"

sqop generate-key '<iso-download-self-test-primary@example.com>' > "${secret_key}"
sqop extract-cert < "${secret_key}" > "${public_cert}"

if [ "${wrong_signer}" = 'true' ]; then
   signing_key="${out_dir}/wrong-signer.sec"
   sqop generate-key '<iso-download-self-test-attacker@example.com>' > "${signing_key}"
   sqop extract-cert < "${signing_key}" > "${out_dir}/wrong-signer.asc"
else
   signing_key="${secret_key}"
fi

{
   printf '%s\n' "FAKE KICKSECURE/WHONIX SELF-TEST ISO"
   printf '%s\n' \
      "vmname=${vmname} desktop=${desktop} version=${version} arch=${arch}"
} > "${image_path}"

## Basename-relative sha512sums, as dm-prepare-release publishes it. The name
## field binds the digest to a specific filename.
sums_name="${image}"
if [ "${sums_wrong_name}" = 'true' ]; then
   ## A validly-signed sums that names a DIFFERENT (older) image, to prove the
   ## tool rejects a same-key release served under the requested name.
   sums_name="${vmname}-${desktop}-${older_version}.${arch}.iso"
fi
digest="$(sha512sum -- "${image_path}" | cut --delimiter=' ' --fields=1)"
printf '%s\n' "${digest}  ${sums_name}" > "${sums_path}"

## OpenPGP signature over the .sha512sums file (as dm-prepare-release's
## sign_and_verify publishes <image>.sha512sums.asc).
sqop sign --as=binary "${signing_key}" < "${sums_path}" > "${sig_path}"

if [ "${bad_sig}" = 'true' ]; then
   printf '%s\n' "-----BEGIN PGP SIGNATURE-----" > "${sig_path}"
   printf '%s\n' "garbage-not-a-real-signature" >> "${sig_path}"
   printf '%s\n' "-----END PGP SIGNATURE-----" >> "${sig_path}"
fi

if [ "${bad_hash}" = 'true' ]; then
   ## Flip one byte in the image AFTER the sums were signed: the signature
   ## stays valid but the image no longer matches the signed digest, so only
   ## the HASH check rejects it.
   printf '%s' $'\xff' | dd of="${image_path}" bs=1 seek=1 count=1 conv=notrunc status=none
fi

## Directory index: several version dirs plus non-version noise, so the parser
## must filter and version-sort. ${version} is the highest.
{
   if [ "${index_leading_version}" = 'true' ]; then
      ## A bare-version first text line (ahead of the markup, so href parsing is
      ## unaffected). Makes a stale fetch_text read observable: if the reused tmp
      ## leaks this index body into the stable-pin fetch, sanitize_wiki_version
      ## returns ${version} -- a false stable pin equal to the highest.
      printf '%s\n' "${version}"
   fi
   printf '%s\n' "<html><body><pre>"
   printf '%s\n' "<a href=\"../\">../</a>"
   printf '%s\n' "<a href=\"robots.txt\">robots.txt</a>"
   printf '%s\n' "<a href=\"${older_version}/\">${older_version}/</a>"
   printf '%s\n' "<a href=\"${version}/\">${version}/</a>"
   printf '%s\n' "</pre></body></html>"
} > "${index_path}"

if [ "${wiki_crlf}" = 'true' ]; then
   ## CRLF body with the version alone on the first line: a trailing CR then
   ## sits AFTER the version and BEFORE any '<', so sanitize_wiki_version's
   ## '<'-cut cannot strip it -- the version must be CR-stripped in its own right.
   printf '%s\n' \
      "${stable_version}"$'\r' \
      "<noinclude>[[Category:MultiWiki]]"$'\r' \
      "{{mbox}}"$'\r' \
      "</noinclude>"$'\r' > "${wiki_path}"
else
   printf '%s\n' \
      "${stable_version}<noinclude>[[Category:MultiWiki]]" \
      "{{mbox}}" \
      "</noinclude>" > "${wiki_path}"
fi

{
   if [ "${omit_wiki}" != 'true' ]; then
      printf '%s\n' "${wiki_base}/w/index.php?title=Template:VersionNew&stable=0&action=raw"$'\t'"${wiki_path}"
   fi
   printf '%s\n' "${download_base}/iso/"$'\t'"${index_path}"
   printf '%s\n' "${download_base}/iso/${version}/${image}"$'\t'"${image_path}"
   printf '%s\n' "${download_base}/iso/${version}/${image}.sha512sums"$'\t'"${sums_path}"
   printf '%s\n' "${download_base}/iso/${version}/${image}.sha512sums.asc"$'\t'"${sig_path}"
} > "${urlmap}"

printf '%s\n' "${me}: done"
printf '%s\n' "  image     : ${image_path}"
printf '%s\n' "  cert      : ${public_cert}"
printf '%s\n' "  urlmap    : ${urlmap}"
printf '%s\n' "  version   : ${version} (stable pin ${stable_version})"
