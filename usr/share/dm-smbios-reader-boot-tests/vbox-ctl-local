#!/usr/bin/python3 -Bsu
"""Host-side VBox guest input/output via the vboxapi Main API (in-process XPCOM).

Gives real mouse (absolute), keyboard and screenshot for a RUNNING VM without
Guest Additions -- the low-mental-load GUI drive (mouse + screenshot share ONE
pixel space, so you click where the screenshot shows something). It is the
host-side counterpart to VBoxManage keyboardputscancode, adding the mouse that
the CLI lacks. Needs the VM defined with --mouse usbtablet + a USB controller
(build_install_vm_plan does this) so putMouseEventAbsolute works pre-Guest-Additions.

Usage: vbox-ctl-local <vm> <res | shot PATH | click X Y [button] | move X Y
                             | type TEXT | key HEXSCANCODE...>
button bitmask: 1=left 2=right 4=middle (0 = release).
"""
import math
import os
import sys
import time

## vboxapi is imported lazily inside _console so the pure scancode helper stays
## importable (and unit-testable) on a host without the VirtualBox bindings.

## US set-1 make scancodes for every UNSHIFTED printable key; break = make | 0x80.
_MAKE = {
    'a': 0x1e, 'b': 0x30, 'c': 0x2e, 'd': 0x20, 'e': 0x12, 'f': 0x21, 'g': 0x22,
    'h': 0x23, 'i': 0x17, 'j': 0x24, 'k': 0x25, 'l': 0x26, 'm': 0x32, 'n': 0x31,
    'o': 0x18, 'p': 0x19, 'q': 0x10, 'r': 0x13, 's': 0x1f, 't': 0x14, 'u': 0x16,
    'v': 0x2f, 'w': 0x11, 'x': 0x2d, 'y': 0x15, 'z': 0x2c,
    '0': 0x0b, '1': 0x02, '2': 0x03, '3': 0x04, '4': 0x05, '5': 0x06, '6': 0x07,
    '7': 0x08, '8': 0x09, '9': 0x0a,
    ' ': 0x39, '-': 0x0c, '=': 0x0d, '[': 0x1a, ']': 0x1b, '\\': 0x2b,
    ';': 0x27, "'": 0x28, '`': 0x29, ',': 0x33, '.': 0x34, '/': 0x35,
}
## Shifted printable -> the unshifted key that yields it with Shift held (so the
## full ASCII command set -- $ > | ; ( ) etc. -- can be typed, needed to drive a
## shell in-guest, not just simple words).
_SHIFTED = {
    '!': '1', '@': '2', '#': '3', '$': '4', '%': '5', '^': '6', '&': '7',
    '*': '8', '(': '9', ')': '0', '_': '-', '+': '=', '{': '[', '}': ']',
    '|': '\\', ':': ';', '"': "'", '~': '`', '<': ',', '>': '.', '?': '/',
}
_SHIFT_MAKE = 0x2a
_SHIFT_BREAK = 0xaa
_BREAK_BIT = 0x80

## Named non-printable keys for a chord (modifiers + function/navigation keys): set-1
## MAKE codes (break = make | 0x80). Lets a caller express a key combo by NAME --
## 'ctrl alt f2' to switch to a virtual terminal -- instead of hand-coding make/break
## hex via the raw `key` verb. Kept here (module scope) so chord_scancodes is importable
## and unit-testable without the VirtualBox bindings, like text_scancodes.
_CHORD_MAKE = {
    'ctrl': 0x1d, 'lctrl': 0x1d, 'alt': 0x38, 'lalt': 0x38,
    'shift': 0x2a, 'lshift': 0x2a,
    'enter': 0x1c, 'esc': 0x01, 'tab': 0x0f, 'backspace': 0x0e, 'space': 0x39,
    'f1': 0x3b, 'f2': 0x3c, 'f3': 0x3d, 'f4': 0x3e, 'f5': 0x3f, 'f6': 0x40,
    'f7': 0x41, 'f8': 0x42, 'f9': 0x43, 'f10': 0x44, 'f11': 0x57, 'f12': 0x58,
}

## A button press fired with ZERO delay after the absolute move is DROPPED by the
## guest at higher resolutions (a plain-EFI / EFI+SB Calamares at the GOP's
## 1920x1080, rendered by the slow headless llvmpipe): the pointer motion / focus-
## enter has not propagated when the button goes down, so the FIRST click is
## silently lost and the page never advances. Dwell after the move, then hold
## before release, so the press lands on the widget under the pointer. Resolution-
## independent: at the BIOS 1280x800 it is just a harmless sub-second pause.
def _env_float(name, default):
    """A float tuning knob from the environment, falling back to the safe default
    on a MISSING, MALFORMED or NONSENSICAL value -- a bad VBOX_GUESTCTL_CLICK_* must
    neither crash unrelated subcommands (res/shot never dwell) with a traceback nor
    degrade a click. A negative or NaN dwell is meaningless, and a non-finite one
    (inf) is a duration time.sleep rejects AFTER the press and BEFORE the release in
    perform_pointer, stranding the mouse button -- so treat all of them as absent and
    use the safe finite default (a 0 settle, by contrast, just loses the first click).
    An explicit finite 0 is honored."""
    try:
        value = float(os.environ[name])
    except (KeyError, ValueError):
        return default
    if not math.isfinite(value) or value < 0.0:
        return default
    return value


CLICK_SETTLE = _env_float('VBOX_GUESTCTL_CLICK_SETTLE', 0.3)
CLICK_HOLD = _env_float('VBOX_GUESTCTL_CLICK_HOLD', 0.08)


def perform_pointer(mouse, x, y, do_click, button, *,
                    settle=CLICK_SETTLE, hold=CLICK_HOLD, sleep=time.sleep):
    """Move the absolute pointer to (x, y); for a click, dwell after the move so the
    guest processes the motion BEFORE the press (else the first click is lost at high
    resolutions), then hold briefly before release. Takes the IMouse + sleep so the
    sequence is unit-testable without a VM. The press and hold are in a try whose
    finally ALWAYS sends the release, so neither a press that dispatches the button-
    down and then raises (e.g. a KeyboardInterrupt as the XPCOM call returns) nor a
    sleep(hold) that raises (a duration time.sleep rejects) can leave the button
    pressed and wedge the test. settle is outside: if it raises, no press has
    happened, and a release for a press that never dispatched is a harmless no-op."""
    mouse.putMouseEventAbsolute(x, y, 0, 0, 0)
    if do_click:
        sleep(settle)
        try:
            mouse.putMouseEventAbsolute(x, y, 0, 0, button)
            sleep(hold)
        finally:
            mouse.putMouseEventAbsolute(x, y, 0, 0, 0)


def text_scancodes(text):
    """Set-1 make/break scancode ints to type a literal string (no trailing Enter).
    Covers the full US printable set incl. uppercase and shifted symbols."""
    codes = []
    for char in text:
        if char in _SHIFTED:
            base, shift = _SHIFTED[char], True
        elif char.isupper():
            base, shift = char.lower(), True
        else:
            base, shift = char, False
        make = _MAKE.get(base)
        if make is None:
            raise ValueError('no scancode for %r' % (char,))
        if shift:
            codes.append(_SHIFT_MAKE)
        codes.append(make)
        codes.append(make | _BREAK_BIT)
        if shift:
            codes.append(_SHIFT_BREAK)
    return codes


def chord_scancodes(keys):
    """Set-1 scancodes to press KEYS together then release them: MAKE in the given order,
    BREAK in REVERSE order (so a modifier is held around the inner key's press+release and
    released last). KEYS are names from _CHORD_MAKE, e.g. ['ctrl','alt','f2'] to switch to
    a virtual terminal. Raises ValueError on an unknown key. No VM needed -- unit-testable."""
    makes = []
    for key in keys:
        code = _CHORD_MAKE.get(key.lower())
        if code is None:
            raise ValueError('no scancode for chord key %r' % (key,))
        makes.append(code)
    return makes + [code | _BREAK_BIT for code in reversed(makes)]


def send_scancodes(keyboard, codes):
    """Inject scancodes PACED in small chunks: one big putScancodes overruns the
    guest input buffer and silently DROPS keys (e.g. 'calamares' -> 'calaares'),
    which corrupts a typed command or passphrase."""
    for start in range(0, len(codes), 6):
        keyboard.putScancodes(codes[start:start + 6])
        time.sleep(0.05)


def _console(name):
    import vboxapi
    mgr = vboxapi.VirtualBoxManager(None, None)
    vbox = mgr.getVirtualBox()
    machine = vbox.findMachine(name)
    session = mgr.getSessionObject(vbox)
    machine.lockMachine(session, mgr.constants.LockType_Shared)
    return mgr, session, session.console


def _build_parser():
    import argparse
    parser = argparse.ArgumentParser(
        prog='vbox-ctl-local',
        description='host-side VBox guest I/O via vboxapi (mouse/keyboard/screenshot)')
    parser.add_argument('vm')
    sub = parser.add_subparsers(dest='cmd', required=True)
    sub.add_parser('res', help='print the guest screen resolution')
    shot = sub.add_parser('shot', help='write a screenshot PNG')
    shot.add_argument('path')
    for name in ('click', 'move'):
        mouse = sub.add_parser(name, help='%s the pointer (screenshot pixel coords)' % name)
        mouse.add_argument('x', type=int)
        mouse.add_argument('y', type=int)
        mouse.add_argument('button', type=int, nargs='?', default=1,
                           help='bitmask 1=left 2=right 4=middle (click only)')
    typ = sub.add_parser('type', help='type a literal string')
    typ.add_argument('text')
    sub.add_parser('type-stdin',
                   help='type text read from stdin (keeps secrets out of argv/proc)')
    key = sub.add_parser('key', help='inject raw hex scancodes')
    key.add_argument('codes', nargs='+', metavar='HEX')
    chord = sub.add_parser('chord',
                           help='press named keys together then release '
                                '(e.g. "chord ctrl alt f2" to switch virtual terminal)')
    chord.add_argument('keys', nargs='+', metavar='KEY')
    return parser


def main(argv=None):
    args = _build_parser().parse_args(argv)
    mgr, session, console = _console(args.vm)
    try:
        disp = console.display
        width, height = disp.getScreenResolution(0)[:2]
        if args.cmd == 'res':
            print('%d %d' % (width, height))
        elif args.cmd == 'shot':
            if not width or not height:
                ## early boot (pre-EFI-framebuffer) reports 0x0; a clean error, not
                ## an XPCOM traceback, so a caller polling for readiness can retry.
                print('display not ready (%dx%d)' % (width, height), file=sys.stderr)
                return 3
            data = disp.takeScreenShotToArray(
                0, width, height, mgr.constants.BitmapFormat_PNG)
            with open(args.path, 'wb') as handle:
                handle.write(bytes(data))
            print('shot %dx%d -> %s' % (width, height, args.path))
        elif args.cmd in ('click', 'move'):
            ## CLI coords are 0-based screenshot pixels; VBox absolute coords are
            ## 1-based [1..width], so map with +1 (screenshot (0,0) -> guest top-left,
            ## and a 0 edge coord is never pushed out of the valid range).
            gx, gy = args.x + 1, args.y + 1
            perform_pointer(console.mouse, gx, gy, args.cmd == 'click',
                            args.button)
            print('%s %d %d' % (args.cmd, args.x, args.y))
        elif args.cmd == 'type':
            send_scancodes(console.keyboard, text_scancodes(args.text))
            ## NEVER echo the typed text -- it may be a LUKS passphrase (CWE-532);
            ## report only the length.
            print('type: %d char(s)' % (len(args.text),))
        elif args.cmd == 'type-stdin':
            ## secret text (LUKS passphrase) read from stdin so it never lands in
            ## argv/proc (CWE-214); strip one trailing newline a shell may add.
            text = sys.stdin.read()
            if text.endswith('\n'):
                text = text[:-1]
            send_scancodes(console.keyboard, text_scancodes(text))
            print('type-stdin: %d char(s)' % (len(text),))
        elif args.cmd == 'key':
            send_scancodes(console.keyboard, [int(code, 16) for code in args.codes])
            print('key %s' % (' '.join(args.codes),))
        elif args.cmd == 'chord':
            send_scancodes(console.keyboard, chord_scancodes(args.keys))
            print('chord %s' % (' '.join(args.keys),))
        return 0
    finally:
        session.unlockMachine()


if __name__ == '__main__':
    sys.exit(main())
