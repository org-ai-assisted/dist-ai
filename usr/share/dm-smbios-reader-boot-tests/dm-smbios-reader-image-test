"""Boot an image in qemu, log in over the serial console, run functional checks
(by default 'systemcheck --leak-tests') and report a single pass/fail exit code.

This is the functional layer on top of dm-smbios-reader-qemu: dm-smbios-reader-qemu owns qemu, firmware,
Secure Boot and the SMBIOS kernel-cmdline injection; dm-smbios-reader-image-test only drives
the login conversation and aggregates the checks' exit codes. It obtains the
exact qemu argv from 'dm-smbios-reader-qemu --emit-argv' (which builds but does not boot), then
spawns it under pexpect so it can interact with the guest.

Session selection (user vs sysmaint) is done through dm-smbios-reader-qemu's --smbios-append,
which injects a kernel cmdline the in-image GRUB SMBIOS reader appends -- no image
edit, works on BIOS, EFI and EFI+Secure Boot alike.

Exit codes mirror dm-smbios-reader-qemu's triad so CI reads one consistent signal:
  0  every check returned its expected exit code (PASS)
  5  booted but a check failed, or the login prompt was never reached (FAIL)
  2  setup / usage error (bad flag, dm-smbios-reader-qemu missing, qemu argv error)
"""

import argparse
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
from typing import NoReturn

PASS = 0
FAIL = 5
SETUP = 2

## Map --session to the kernel cmdline the sysmaint boot entry uses (see
## user-sysmaint-split grub.d_10_10_linux_sysmaint). 'user' is the default
## session and needs no injection.
SESSION_CMDLINE = {
    "user": "",
    "sysmaint": "boot-role=sysmaint systemd.unit=sysmaint-boot.target",
}

## Kernel command-line hardening that security-misc sets via /etc/default/grub.d and
## grub-mkconfig emits on the disk 'linux' line. A live ISO carries it only if
## build-steps.d/4310_convert-raw-to-iso scrapes it into the live boot append; a
## regression dropping that scrape boots an UNHARDENED live system, and with
## rd.shell=0/rd.emergency=halt gone the initramfs drops to a dracut rescue shell
## instead of halting. Asserted on the ISO legs only -- the disk image inherits these
## straight from its installed grub, a separate pre-existing path.
ISO_HARDENING_TOKENS = ("slab_nomerge", "rd.shell=0", "rd.emergency=halt")


def hardening_cmdline_check(cmdline_path="/proc/cmdline"):
    """Shell command that exits 0 iff every ISO_HARDENING_TOKENS entry is present as
    a whole word in cmdline_path, else prints the first missing token and exits 1."""
    import shlex
    parts = [
        "grep -q -F -w -- %s %s || { echo MISSING-HARDENING:%s; exit 1; }"
        % (shlex.quote(token), shlex.quote(cmdline_path), token)
        for token in ISO_HARDENING_TOKENS
    ]
    return "; ".join(parts) + "; true"


## The EFI global SecureBoot variable (vendor-neutral GUID). Its value byte is 1
## when Secure Boot is enabled/enforcing, 0 otherwise.
SECUREBOOT_EFIVAR = (
    "/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c"
)


def firmware_sentinels(firmware):
    """Shell commands (list) asserting the guest actually booted the CLAIMED
    firmware, so a leg cannot silently pass on a different one:
      - bios: /sys/firmware/efi ABSENT (legacy BIOS, not EFI);
      - efi / efi-secureboot: /sys/firmware/efi PRESENT, and the SecureBoot EFI
        variable enabled iff the leg is -secureboot (so an efi leg cannot pass on
        SB firmware, nor an efi-secureboot leg pass without SB enforcing).
    Reads the SecureBoot value byte with od (no mokutil dependency), mounting
    efivarfs first if the kernel has not. Root: efivars are root-readable only.
    An unknown/empty firmware yields no assertion (nothing to verify).

    'bios' == legacy no-EFI is x86 (SeaBIOS) semantics: only the amd64 wrappers
    pass bios/efi/efi-secureboot, while the arm64 wrapper -- where 'bios' would
    still be edk2 UEFI -- passes no --firmware at all (empty -> no assertion), so
    the bios/no-EFI check is never reached on arm64."""
    import shlex
    if firmware == "bios":
        return [
            "if [ -d /sys/firmware/efi ]; then"
            " echo WRONG-FIRMWARE:expected-bios-but-efi-present; exit 1; fi"
        ]
    if firmware not in ("efi", "efi-secureboot"):
        return []
    want = "1" if firmware == "efi-secureboot" else "0"
    sb_var = shlex.quote(SECUREBOOT_EFIVAR)
    return [
        "[ -d /sys/firmware/efi ] ||"
        " { echo WRONG-FIRMWARE:expected-efi-but-none; exit 1; }",
        "[ -e %s ] ||"
        " mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null || true;"
        " sb=$(od -An -t u1 %s 2>/dev/null | awk 'END{print $NF}'); sb=${sb:-0};"
        ' [ "$sb" = "%s" ] ||'
        " { echo WRONG-SECUREBOOT:want=%s:got=${sb:-empty}; exit 1; }"
        % (sb_var, sb_var, want, want),
    ]


## Whole-token 'boot-role=sysmaint' in /proc/cmdline. NOT 'grep -w': -w only
## checks the chars around the MATCH, so it accepts a longer token that merely
## starts with it ('boot-role=sysmaint-canary'), which a caller-controlled
## --smbios-append could inject; anchor on a space or line edge on both sides.
## 'boot-role=sysmaint' has no regex metacharacter, so -E is exact here.
BOOT_ROLE_SYSMAINT_RE = r"(^| )boot-role=sysmaint( |$)"


def boot_role_sentinel(session):
    """Shell command asserting the guest booted the CLAIMED session: the injected
    'boot-role=sysmaint' whole token must be PRESENT in /proc/cmdline for the
    sysmaint session and ABSENT for user -- proving the SMBIOS session injection
    took effect (and, for user, did not accidentally select sysmaint)."""
    if session == "sysmaint":
        return (
            "grep -qE %s /proc/cmdline ||"
            " { echo WRONG-ROLE:expected-sysmaint-absent-from-cmdline; exit 1; }"
            % shlex.quote(BOOT_ROLE_SYSMAINT_RE)
        )
    return (
        "if grep -qE %s /proc/cmdline; then"
        " echo WRONG-ROLE:expected-user-but-sysmaint-in-cmdline; exit 1; fi"
        % shlex.quote(BOOT_ROLE_SYSMAINT_RE)
    )


## Release-critical checks (the catastrophic-regression gate; see the parent plan
## "release-critical checks"). SINGLE SOURCE OF TRUTH for the numbers + names this
## serial leg can assert; the numbers MUST match dm-calamares-install's numbered
## run_check battery (a contract test in test_dm_image_test.py enforces no drift).
## A headless, no-network serial leg covers only these; checks 3 (upgrade-nonroot),
## 4 (networking) and 6 (GUI login) -- and 0 (install), 7 (LUKS) -- need network, a
## display or an installer, so they are covered by the VBox path (dm-calamares-install),
## not here. report_release_summary() states that explicitly so a green serial leg is
## never read as "all release checks passed".
RELEASE_CHECKS = {
    1: "user session boots",
    2: "sysmaint session boots",
    5: "CLI login works",
    8: "systemcheck --leak-tests passes",
}

## checks this serial leg does NOT run (delegated to dm-calamares-install).
DELEGATED_CHECKS = (
    (0, "install"),
    (3, "upgrade-nonroot"),
    (4, "networking"),
    (6, "GUI login"),
    (7, "LUKS"),
)


def cli_login_check(login_user):
    """check 5 command: exit 0 iff the session's CLI login yields the EXPECTED
    identity. Run as the login user (force_root False) through the same
    non-interactive 'su - <user>' path systemcheck uses, so a login that silently
    dropped to the wrong account fails. On a headless image this proxies "CLI login
    works" -- the console is a login-free root debug-shell with no getty to drive."""
    return 'test "$(id -un)" = %s' % shlex.quote(login_user)


def die_setup(message) -> NoReturn:
    print("dm-smbios-reader-image-test: %s" % message, file=sys.stderr)
    sys.exit(SETUP)


def parse_args():
    parser = argparse.ArgumentParser(
        prog="dm-smbios-reader-image-test",
        description="Boot an image, log in and run functional checks.",
    )
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--disk", help="disk image to boot (qcow2/raw/vdi/vmdk)")
    source.add_argument("--iso", help="live ISO to boot")
    parser.add_argument("--arch", default="", help="amd64|arm64 (default: host)")
    parser.add_argument(
        "--firmware", default="",
        help="bios|efi|efi-secureboot (x86; forwarded to dm-smbios-reader-qemu)",
    )
    parser.add_argument(
        "--session", choices=sorted(SESSION_CMDLINE), default="user",
        help="which session to boot into (default: user)",
    )
    parser.add_argument("--login-user", default="user", help="serial login account")
    ## TODO(dm-smbios-reader-boot-tests): --login-pass is accepted but NEVER read -- the serial
    ## login flow assumes a passwordless console and never sends a password at the prompt.
    ## Either wire it into the pexpect login (send it when a Password: prompt appears) or
    ## drop the flag. Verifying a real password prompt needs an actual image boot +
    ## serial console, so this is left documented, not fixed here.
    parser.add_argument(
        "--login-pass", default="",
        help="serial login password; empty means no password is expected",
    )
    parser.add_argument(
        "--run", action="append", metavar="CMD", default=None,
        help="command to run after login (repeatable). "
        "Default: 'systemcheck --cli --leak-tests --verbose'.",
    )
    parser.add_argument(
        "--expect-rc", type=int, default=0,
        help="exit code every --run command must return (default: 0)",
    )
    parser.add_argument("--timeout", type=int, default=1800, help="overall timeout (s)")
    parser.add_argument(
        "--smbios-append", default="",
        help="extra kernel cmdline to inject (merged with --session)",
    )
    parser.add_argument("--serial-log", default="", help="write the serial log here")
    parser.add_argument(
        "--backend", choices=("auto", "qemu", "vbox"), default="auto",
        help="VM backend: auto (vbox when VBoxManage + no /dev/kvm + amd64, else"
             " qemu), qemu, or vbox (forces VBox/AMD-V; requires VBoxManage)",
    )
    parser.add_argument(
        "--resolve-backend", dest="resolve_backend", action="store_true",
        help="print the backend --backend/auto resolves to (qemu|vbox) and exit;"
             " the single source the front-ends query to gate on the right tool",
    )
    parser.add_argument(
        "--dm-smbios-reader-qemu", default="dm-smbios-reader-qemu",
        help="path to the dm-smbios-reader-qemu executable (default: PATH lookup)",
    )
    ## Any tokens after '--' are passed straight to dm-smbios-reader-qemu (e.g. --memory, --smp).
    parser.add_argument("dm_smbios_reader_qemu_args", nargs=argparse.REMAINDER)
    return parser.parse_args()


def merged_smbios_append(args):
    """Merge the --session cmdline with any caller --smbios-append (extra kernel
    cmdline injected via SMBIOS). Shared by the qemu argv and the vbox DMI serial so
    both backends inject the same session selection + append."""
    parts = [p for p in (SESSION_CMDLINE[args.session], args.smbios_append) if p]
    return " ".join(parts)


def build_qemu_argv(args):
    """Return the qemu argv by asking dm-smbios-reader-qemu to emit it (build-only, no boot)."""
    cmd = [args.dm_smbios_reader_qemu]
    if args.disk:
        cmd += ["--disk", args.disk]
    else:
        cmd += ["--iso", args.iso]
    if args.arch:
        cmd += ["--arch", args.arch]
    if args.firmware:
        cmd += ["--firmware", args.firmware]

    ## Reliable automation channel: a login-free ROOT shell on the serial console
    ## (systemd debug-shell + masked login getty), so we never drive the image's
    ## interactive user zsh (whose line editor corrupts programmatic input).
    cmd += ["--test-console"]

    ## Lossless serial capture: we read the console through a pexpect pty, and a slow
    ## reader lets qemu drop the serial bytes it cannot hand to a full pty (a verbose
    ## systemcheck burst loses most of its output that way). Have qemu ALSO copy every
    ## serial byte to the log file directly (a blocking regular-file write that never
    ## drops), so the log is complete regardless of reader speed. We therefore do NOT
    ## open/write the log from Python; qemu owns it.
    if args.serial_log:
        cmd += ["--serial-logfile", args.serial_log]

    ## Merge the session cmdline with any caller-supplied --smbios-append (shared with
    ## the vbox backend via merged_smbios_append).
    merged = merged_smbios_append(args)
    if merged:
        cmd += ["--smbios-append", merged]

    ## Drop the leading '--' argparse leaves in REMAINDER.
    extra = args.dm_smbios_reader_qemu_args
    if extra and extra[0] == "--":
        extra = extra[1:]
    cmd += extra
    cmd += ["--emit-argv"]

    try:
        result = subprocess.run(
            cmd, check=True, capture_output=True, text=True
        )
    except FileNotFoundError:
        die_setup("dm-smbios-reader-qemu not found: %s" % args.dm_smbios_reader_qemu)
    except OSError as exc:
        ## dm-smbios-reader-qemu exists but cannot be executed (not +x, bad interpreter, ...):
        ## an environment/setup problem, not a harness bug -- map to SETUP(2)
        ## instead of letting the raw OSError escape as an uncaught exit 1.
        die_setup("cannot execute dm-smbios-reader-qemu %s: %s" % (args.dm_smbios_reader_qemu, exc))
    except subprocess.CalledProcessError as exc:
        sys.stderr.write(exc.stderr or "")
        die_setup("dm-smbios-reader-qemu --emit-argv failed (exit %s)" % exc.returncode)

    ## dm-smbios-reader-qemu --emit-argv prints one token per line, each '\n'-terminated and
    ## containing no newline (dm-smbios-reader-qemu guarantees this), so splitting on '\n'
    ## yields the tokens plus a trailing '' after the final newline -- the line
    ## terminator, not a token. Drop ONLY that trailing empty: an EMPTY argv token
    ## is legitimate (e.g. an empty '-append' value, and --dm-smbios-reader-qemu is
    ## user-overridable), and dropping interior empties would shift every later
    ## token. split('\n'), not splitlines(), which would also break a token on an
    ## embedded '\r' / other line boundary.
    argv = result.stdout.split("\n")
    if argv and argv[-1] == "":
        argv.pop()
    if not argv:
        die_setup("dm-smbios-reader-qemu --emit-argv produced no qemu argv")

    ## dm-smbios-reader-qemu leaves any per-boot workdir (kernel/initrd extraction or the EFI
    ## OVMF_VARS copy) for us to remove once qemu has exited; it reports the path
    ## on stderr. Capture it so we clean up instead of leaking under /tmp.
    workdir = None
    marker = "dm-smbios-reader-qemu: emit-argv workdir (caller owns cleanup): "
    for line in (result.stderr or "").splitlines():
        if line.startswith(marker):
            workdir = line[len(marker):].strip()
    return argv, workdir


def safe_rmtree_workdir(path, log):
    """Recursively delete a dm-smbios-reader-qemu per-boot workdir, but only when it is safe.

    `path` is parsed from dm-smbios-reader-qemu's stderr marker, so a marker-format change or a bug
    could aim rmtree at an arbitrary location. Remove ONLY an absolute, real
    (non-symlink) directory strictly UNDER the temp root -- never a symlink, never the
    temp root or '/' itself. Returns True iff it removed the tree.
    """
    tmp_root = os.path.realpath(tempfile.gettempdir())
    real = os.path.realpath(path)
    if (os.path.isdir(path) and not os.path.islink(path)
            and real != tmp_root and (real + os.sep).startswith(tmp_root + os.sep)):
        shutil.rmtree(real, ignore_errors=True)
        return True
    log("dm-smbios-reader-image-test: refusing to rmtree suspicious qemu workdir %r" % path)
    return False


def build_check_plan(args):
    """Build the ordered list of checks to run over the serial shell. PURE: no I/O,
    so it is unit-testable without qemu (mirrors build_qemu_argv / the sentinel
    helpers the tests already exercise).

    Returns a list of (command, force_root, want_rc, num) entries:
      - command: the shell command run on the guest's root serial shell.
      - force_root: run as root even when --login-user is set (integrity guards +
        the diagnostic need root; the release-critical functional checks run as the
        login user).
      - want_rc: the exit code the command must return, or None to EXEMPT it from
        the verdict (the always-passing diagnostic).
      - num: a RELEASE_CHECKS key for a numbered release-critical check, or None for
        a boot-integrity guard (firmware/hardening) or the diagnostic.

    Order (both paths): the integrity prefix runs FIRST and fails fast, at the top of
    the serial log -- a leg that booted the wrong session/firmware cannot pass on the
    wrong combination. 'boot-role' doubles as release check 1 (user) / 2 (sysmaint):
    the claimed session actually booted.
    """
    plan = []
    ## check 1 (user leg) / check 2 (sysmaint leg): the CLAIMED session booted
    ## (the injected boot-role whole-token present for sysmaint, absent for user).
    role_num = 2 if args.session == "sysmaint" else 1
    plan.append((boot_role_sentinel(args.session), True, 0, role_num))
    ## firmware actually in effect -- a leg-validity guard, not a release check.
    for cmd in firmware_sentinels(args.firmware):
        plan.append((cmd, True, 0, None))

    if args.run is not None:
        ## A newline in a --run value would submit each line as its own statement,
        ## so only the LAST line's exit code reaches the sentinel printf -- a failure
        ## in any earlier line is silently dropped. Fail closed rather than mislead.
        for command in args.run:
            if "\n" in command:
                die_setup("--run command must be a single line (got an embedded"
                          " newline); pass one --run per command")
            plan.append((command, False, args.expect_rc, None))
        return plan

    ## On the live ISO legs, assert the Kicksecure kernel hardening reached
    ## /proc/cmdline: the live cmdline is assembled by 4310's grub-mkconfig scrape,
    ## and a regression that drops it boots unhardened. Leg-validity guard (root,
    ## rc-checked). The disk legs inherit hardening from the installed grub.
    if args.iso:
        plan.append((hardening_cmdline_check(), True, 0, None))

    ## check 5 (CLI login): run as the login user; the login must yield the expected
    ## identity. Placed before systemcheck so a broken login path is isolated from a
    ## systemcheck failure (both run as the login user).
    plan.append((cli_login_check(args.login_user), False, 0, 5))

    ## check 8 (systemcheck): the core catastrophic-regression gate. Environment /
    ## timing checks are skipped via systemcheck's own --skip (NOT an image edit --
    ## the image and real-user systemcheck are untouched), so a healthy image passes
    ## DETERMINISTICALLY. None of the skipped checks is an image-integrity property:
    ##  - check_operating_system: a snapshot-pinned image always has apt updates
    ##    pending ("packages can be updated") -- freshness, not a boot failure.
    ##  - check_tor_bootstrap / check_tor_connectivity / check_stream_isolation:
    ##    live Tor connectivity races Tor's async bootstrap over the CI network and
    ##    is non-deterministic; Tor's CONFIG is still validated (check_tor_config,
    ##    check_tor_enabled). Live connectivity belongs in a dedicated network test.
    ## check_journal is NOT skipped: systemcheck's log-checker word-anchors 'BUG',
    ## so the debug-shell.service "FOR DEBUGGING ONLY" line does not match it and the
    ## debug shell (the automation channel) does not flag check_journal.
    ## --skip matches the name passed to systemcheck_run_function. The tor
    ## connectivity tests (incl. the SocksPort "Connectivity Test") run under
    ## check_tor_connectivity, so THAT is the effective skip token, not
    ## check_tor_socks_or_trans_port (which matches no run-function). A minimal
    ## kicksecure-debug ships no tor and no meta package, so those checks and
    ## check_meta_packages do not apply here.
    systemcheck_cmd = (
        "systemcheck --cli --leak-tests --verbose"
        ## --ci turns on systemcheck's module-specific tolerance for a tirdad
        ## Secure Boot rejection: systemd-modules-load degraded SOLELY because
        ## tirdad could not load is tolerated (failed-units, system-ready AND
        ## journal), while a jitterentropy_rng / other module failure still fails.
        " --ci"
        " --skip check_operating_system"
        " --skip check_tor_bootstrap"
        " --skip check_tor_connectivity"
        " --skip check_tor_socks_port_reachability"
        " --skip check_stream_isolation"
        " --skip check_meta_packages"
        ## check_privilege_escalation_tools runs 'privleapd --check-config',
        ## which systemcheck fails on ANY output. On a no-tor image privleapd
        ## prints benign warnings for tor actions whose 'debian-tor' TargetUser
        ## is absent (exit 0, valid config), so the check reports a
        ## misconfiguration and systemcheck returns 1 -- failing every boot leg.
        ## Making privleapd --check-config silent on a valid config was proposed
        ## (org-ai-assisted privleap PR #5) and REJECTED: the accepted approach
        ## is to ignore the expected output on the consumer side instead. So
        ## skip the whole check here (this also drops the leaprun check-privleap
        ## / check-privleap-environment-variables / check-sudo sub-checks; a
        ## no-tor boot test accepts that tradeoff).
        " --skip check_privilege_escalation_tools"
    )
    ## Live-ISO ONLY: the Kicksecure APT repository is DISABLED on the live ISO by
    ## design (it enables on install), so check_apt_repository reports "Disabled" and
    ## systemcheck returns 1 on every live leg. --ci does NOT cover this -- it is
    ## scoped to the tirdad/systemd-modules-load tolerance by design, since extending
    ## it would mask a real apt misconfiguration on an INSTALLED system. So skip the
    ## check for --iso legs ONLY; on a --disk (installed) image apt-repo-enabled MUST
    ## stay enforced (its being disabled there is a real regression).
    if args.iso:
        systemcheck_cmd += " --skip check_apt_repository"
    ## Whitelist the expected privleapd journal warnings on a no-tor image:
    ## upstream privleap (Kicksecure 5af499b) logs a WARNING when it ignores a
    ## tor action whose 'debian-tor' TargetUser is absent, which otherwise trips
    ## check_journal (log-checker greps the journal for 'warn'). "' of action '"
    ## matches only privleap's "'TargetUser'/'TargetGroup' of action '...'"
    ## target-missing messages.
    ## This covers check_journal; the separate 'privleapd --check-config'
    ## systemcheck check is handled by the check_privilege_escalation_tools
    ## skip above. The privleap-side fix (silent --check-config) was proposed
    ## and rejected (PR #5), so ignoring the expected privleap output on the
    ## consumer side -- here and in the skip above -- is the accepted approach.
    systemcheck_cmd += " --journal-ignore-fixed \"' of action '\""
    ## No shared folder is attached to the qemu invocation, so vm-config-dist's
    ## mount-shared cannot mount /mnt/shared and mount logs "wrong fs type, bad
    ## option, bad superblock". The script already tolerates the failure
    ## ('|| true'); only the stderr reaches the journal, where check_journal
    ## reports it and fails every qcow2 leg (the ISO legs do not attempt it).
    ## Ignored HERE rather than silenced in vm-config-dist: suppressing it in
    ## the shipped script would also hide a real mount failure on a VM that
    ## does have a shared folder configured (org-ai-assisted vm-config-dist
    ## PR #5, closed for that reason). The string names the mount point, so a
    ## different failing mount is still reported.
    systemcheck_cmd += " --journal-ignore-fixed \"mount: /mnt/shared: wrong fs type\""
    ## sdwdate cannot reach Tor on a no-network CI boot, so anondate-get returns
    ## no time; anondate-set then dies at its empty-result check (before set_date)
    ## and its errexit trap logs the fixed "Unexpected error (1). No exit code set
    ## yet" text, which check_journal greps as an error and fails every leg. Same
    ## no-tor condition the check_tor_* skips above cover. Match that exact
    ## unset-exit-code text (both the anondate and sdwdate-file-watcher journal
    ## copies share it) -- NOT a bare exit_code '1', which would also swallow
    ## anondate-set's deliberate exit_code=1 "error" path.
    systemcheck_cmd += " --journal-ignore-fixed \"anondate-set: ### END: ### Exiting with exit_code '1' indicating 'Unexpected error (1). No exit code set yet.\""
    ## Same no-tor condition: with no Tor reachable, anondate-get cannot read a
    ## Tor certificate lifetime from the (absent) Tor log, so it logs two fixed
    ## WARNING lines that check_journal greps as warnings and fails every leg.
    ## Both the anondate and sdwdate-file-watcher journal copies share the exact
    ## text; match the anondate-get substring so the source prefix does not
    ## matter. Ignored on the consumer side, like the anondate-set line above --
    ## silencing it in the shipped anondate would hide a real Tor-cert problem on
    ## an actual Tor system.
    systemcheck_cmd += " --journal-ignore-fixed \"anondate-get: WARNING: Could not determine Tor certificate lifetime.\""
    systemcheck_cmd += " --journal-ignore-fixed \"anondate-get: WARNING: Tor certificate lifetime invalid according to Tor log.\""
    ## Under Secure Boot an unsigned out-of-tree module (tirdad) cannot load, so
    ## systemd-modules-load.service fails -- expected there, not an image defect.
    ## This is handled by systemcheck's --ci tolerance (above), which is
    ## module-specific (tirdad only) and covers the failed-units, system-ready and
    ## journal checks -- so no blunt --ignore-failed-unit / --journal-ignore-fixed
    ## is needed here, and a non-tirdad module failure under SB still fails.
    plan.append((systemcheck_cmd, False, args.expect_rc, 8))

    ## Diagnostic (exempt from the verdict, num None): name every failed system unit
    ## AND dump each one's status + boot journal, so a 'degraded' system-ready
    ## failure shows the culprit AND why it failed, in the serial log. Runs AFTER
    ## systemcheck so it reads at the end of the log next to the verdict; every
    ## command runs even after one fails. (Full output is captured regardless:
    ## qemu's chardev logfile writes a complete, never-truncated serial log.)
    diag_cmd = (
        "echo FAILED-UNITS-BEGIN;"
        " systemctl --no-pager --plain --no-legend --failed || true;"
        " echo FAILED-UNITS-END;"
        " systemctl list-units --state=failed --plain --no-legend --no-pager"
        " | while read -r unit _; do"
        " [ -n \"$unit\" ] || continue;"
        " echo \"UNIT-DIAG-BEGIN $unit\";"
        " systemctl status --no-pager --full \"$unit\" 2>&1 | tail -n 20 || true;"
        " journalctl -b --no-pager -u \"$unit\" 2>&1 | tail -n 30 || true;"
        " echo \"UNIT-DIAG-END $unit\";"
        " done; true")
    plan.append((diag_cmd, True, None, None))
    return plan


def report_release_summary(args, results, log):
    """Log the release-critical check verdicts for this leg, then an HONEST line
    naming the checks a headless no-network serial leg does NOT run (so a green
    serial summary is never read as "all release-critical checks passed"). `results`
    maps a RELEASE_CHECKS number to True (PASS) / False (FAIL)."""
    leg = "%s session, %s" % (args.session, args.firmware or "default firmware")
    log("dm-smbios-reader-image-test: release-critical check summary (%s):" % leg)
    for num in sorted(results):
        log("dm-smbios-reader-image-test:   check %s (%s): %s"
            % (num, RELEASE_CHECKS.get(num, "?"),
               "PASS" if results[num] else "FAIL"))
    delegated = ", ".join("%s (%s)" % (num, name) for num, name in DELEGATED_CHECKS)
    log("dm-smbios-reader-image-test:   checks %s are covered by dm-calamares-install (VBox path),"
        " not this headless no-network serial leg" % delegated)


def run_checks(child, args, log):
    """Run the checks over the login-free ROOT serial shell that dm-smbios-reader-qemu
    --test-console binds to the console (systemd debug-shell, login getty masked).

    This deliberately bypasses the image's interactive user zsh, whose line editor
    corrupts programmatically-sent input (mangles "$?", swallows 'exec'). We drive
    a plain root bash, match on our OWN accumulated buffer (read_nonblocking is more
    reliable than pexpect.expect on the noisy console), and read each command's exit
    code from a unique sentinel. Commands run as root by default, or as --login-user
    via a NON-interactive 'su -' (never the user's interactive shell).
    """
    import re
    import shlex
    import time
    import pexpect  # noqa: E402  (lazy so --help works without it)

    accum = [""]

    ## Single overall deadline so --timeout bounds the WHOLE conversation, not
    ## each phase independently (a short --timeout must not still run ~10 min
    ## through the 60-iteration probe plus a full per-phase wait each).
    overall_deadline = time.time() + args.timeout

    def wait_for(needle, timeout, regex=False):
        """Read until 'needle' appears in the accumulated output, or the phase
        timeout or the overall deadline, whichever is first. Returns the re.Match
        (regex) / True (substring) / None on timeout|EOF."""
        deadline = min(time.time() + timeout, overall_deadline)
        pattern = re.compile(needle) if regex else None
        while time.time() < deadline:
            try:
                accum[0] += child.read_nonblocking(size=4096, timeout=1)
            except pexpect.TIMEOUT:
                ## Expected on every quiet second: this is a poll loop, and the
                ## 1s read timeout is how it yields. The real deadline is the
                ## while condition above, so keep reading.
                pass
            except pexpect.EOF:
                return None
            if regex:
                assert pattern is not None
                match = pattern.search(accum[0])
                if match:
                    return match
            elif needle in accum[0]:
                return True
        return None

    ## 1) Wait for the login-free root shell. systemd's debug-shell binds it to the
    ##    console mid-boot; probe with a split-token printf (only the shell's real
    ##    OUTPUT of the joined token matches, not the command echo) until it answers.
    token = "DMRDY%d" % os.getpid()
    needle = "DM<>%s<>" % token
    shell_live = False
    for _ in range(60):
        if time.time() >= overall_deadline:
            break
        child.sendline("printf 'DM<>%%s<>\\n' %s" % token)
        if wait_for(needle, 10):
            shell_live = True
            break
    if not shell_live:
        log("dm-smbios-reader-image-test: root serial shell (--test-console) never came up")
        return FAIL

    ## 2) Boot barrier: wait until the system finishes coming up so checks see a
    ##    complete environment. is-system-running --wait blocks until
    ##    running/degraded; its status is not the verdict, just the barrier.
    boot_done = "DMBOOT%d" % os.getpid()
    child.sendline("systemctl is-system-running --wait >/dev/null 2>&1; printf '%s\\n'"
                   % boot_done)
    wait_for(boot_done, args.timeout)

    ## The ordered checks to run (pure; see build_check_plan). Each entry is
    ## (command, force_root, want_rc, num): systemcheck + the CLI-login check run as
    ## the login user (--login-user); the integrity guards + the diagnostic run as
    ## root. want_rc is the exit code the command must return, or None to exempt it
    ## (the diagnostic). num is a RELEASE_CHECKS key for a numbered release-critical
    ## check, or None for a boot-integrity guard / the diagnostic.
    plan = build_check_plan(args)

    ## 3) Run each check; read its exit code from a unique sentinel (the echoed
    ##    command carries a literal '%s', so only the real output matches). Root by
    ##    default; --login-user (!= root) runs the command as that user via a
    ##    non-interactive 'su -', never touching the user's interactive shell.
    sentinel = "DMRC%d" % os.getpid()
    rc_re = r"%s:(-?\d+):%s" % (sentinel, sentinel)
    overall = PASS
    ## num -> PASS(True)/FAIL(False), for the release-critical summary.
    results = {}
    for command, force_root, want_rc, num in plan:
        if not force_root and args.login_user and args.login_user != "root":
            ## shlex.quote leaves a bare '-x' unquoted, so 'su - -x -c CMD' would
            ## parse -x as an su OPTION and silently run the command as ROOT instead
            ## of the account. Reject a login user beginning with '-': the boot-test
            ## matrix sets a real name ('user'/'sysmaint'), so this only fail-closes
            ## a malformed override rather than passing it to su.
            if args.login_user.startswith("-"):
                log("dm-smbios-reader-image-test: refusing --login-user %r: a leading '-' would be"
                    " parsed as an su option" % args.login_user)
                if num is not None:
                    results[num] = False
                return FAIL
            payload = "su - %s -c %s" % (shlex.quote(args.login_user),
                                         shlex.quote(command))
        else:
            payload = command
        ## Run the payload in a SUBSHELL so a command that ends with 'exit N' (the
        ## hardening + firmware/role boot-integrity sentinels do, to fail fast on a
        ## mismatch) exits the subshell, not this debug-shell -- otherwise the shell
        ## dies before the sentinel printf runs, and run_checks stalls until the
        ## timeout instead of reading the rc. The '$?' the printf reports is the
        ## subshell's exit code.
        child.sendline("( %s ); printf '%s:%%s:%s\\n' \"$?\""
                       % (payload, sentinel, sentinel))
        match = wait_for(rc_re, args.timeout, regex=True)
        if match is None:
            log("dm-smbios-reader-image-test: command timed out or guest died: %s" % command)
            if num is not None:
                results[num] = False
            overall = FAIL
            ## Stop driving a dead/stuck guest; still print the summary below.
            break
        rc = int(match.group(1))
        ## Drop consumed output so the next command's sentinel is unambiguous.
        accum[0] = accum[0][match.end():]
        ## want_rc is the exact exit code this command must return, or None to
        ## EXEMPT it from the verdict. The diagnostic (None) always exits 0 and only
        ## dumps failed-unit status into the log, so its rc must never flip the
        ## verdict (with --expect-rc 1 a rc=0 diag would otherwise force FAIL even
        ## when the real check passed). A timed-out/guest-died command still fails
        ## above -- only the rc COMPARISON is skipped. systemcheck carries
        ## --expect-rc; the boot-integrity sentinels (hardening, firmware, role)
        ## carry 0 so they hold regardless of --expect-rc.
        if want_rc is None:
            log("dm-smbios-reader-image-test: diag (rc=%s) %s" % (rc, command))
            continue
        passed = rc == want_rc
        if num is not None:
            ## A numbered release-critical check: report it by number + name so a red
            ## gate names exactly which guarantee broke (and matches the VBox path's
            ## 'check N PASS|FAIL' vocabulary).
            results[num] = passed
            log("dm-smbios-reader-image-test: check %s (%s) %s (rc=%s%s)"
                % (num, RELEASE_CHECKS.get(num, "?"),
                   "PASS" if passed else "FAIL", rc,
                   "" if passed else ", want %s" % want_rc))
        elif passed:
            log("dm-smbios-reader-image-test: OK   (rc=%s) %s" % (rc, command))
        else:
            log("dm-smbios-reader-image-test: FAIL (rc=%s, want %s) %s"
                % (rc, want_rc, command))
        if not passed:
            overall = FAIL

    ## 4) Report the release-critical verdicts + the honest coverage line, then the
    ##    verdict is decided; main's finally SIGKILLs qemu. Do NOT send a graceful
    ##    'poweroff' first: the live image runs a slow RAM-wipe on shutdown (dracut
    ##    wipe-ram.sh), and SIGKILLing a qemu that is mid-wipe leaves it terminating
    ##    for the container init to force-reap on teardown, which surfaces as a
    ##    spurious non-zero STEP exit even though every check passed. The image is
    ##    booted with -snapshot, so a hard kill loses nothing.
    report_release_summary(args, results, log)
    return overall


def resolve_backend(args, log):
    """Return 'qemu' or 'vbox'. 'auto' picks vbox when VBoxManage is present AND there
    is no usable /dev/kvm (so qemu would fall back to slow software TCG) AND the target
    arch is amd64 -- VBox is x86-only and CANNOT run a foreign-ISA (arm64) guest, which
    qemu does via TCG, so an arm64 image must stay on qemu. Else qemu. The safe default,
    overridable, no flag to recall. Explicit --backend vbox REQUIRES VBoxManage (loud
    SETUP, never a skip)."""
    import shutil
    if args.backend == "qemu":
        return "qemu"
    have_vbox = shutil.which("VBoxManage") is not None
    if args.backend == "vbox":
        if not have_vbox:
            die_setup("--backend vbox requires VBoxManage (install VirtualBox);"
                      " this is a hard dependency, not a skip")
        if args.arch not in ("", "amd64"):
            die_setup("--backend vbox cannot run a %s guest (VBox is x86-only);"
                      " use --backend qemu for a non-amd64 arch" % (args.arch,))
        return "vbox"
    ## auto: vbox only when qemu would be slow (no KVM) AND the arch is x86.
    has_kvm = os.access("/dev/kvm", os.R_OK | os.W_OK)
    arch_ok = args.arch in ("", "amd64")
    if have_vbox and not has_kvm and arch_ok:
        log("dm-smbios-reader-image-test: backend auto -> vbox (no usable /dev/kvm)")
        return "vbox"
    log("dm-smbios-reader-image-test: backend auto -> qemu")
    return "qemu"


def start_qemu_backend(args, log):
    """Spawn qemu under pexpect; return (child, cleanup). cleanup SIGKILLs+reaps qemu
    and removes the per-boot workdir dm-smbios-reader-qemu left for us (OVMF_VARS copy
    or kernel/initrd extraction) so nothing leaks under /tmp."""
    import pexpect
    qemu_argv, qemu_workdir = build_qemu_argv(args)

    def drop_workdir():
        if qemu_workdir:
            safe_rmtree_workdir(qemu_workdir, log)

    ## qemu owns the serial log (its chardev 'logfile='): a blocking regular-file copy
    ## of every serial byte that never drops, so a verbose systemcheck burst is captured
    ## in full even though the pexpect reader may fall behind and lose bytes to a full
    ## pty. Truncate it up front so the artifact exists and an unwritable path fails
    ## early. Do NOT also log the pexpect stream here -- two writers would race.
    if args.serial_log:
        try:
            with open(args.serial_log, "wb"):
                pass
        except OSError as exc:
            drop_workdir()
            die_setup("cannot open --serial-log %s: %s" % (args.serial_log, exc))

    print("dm-smbios-reader-image-test: spawning: %s"
          % " ".join(shlex.quote(token) for token in qemu_argv), file=sys.stderr)
    ## codec_errors="replace": read_nonblocking chops the stream at a byte count, so a
    ## multi-byte char straddling the boundary (or outright non-UTF-8 framing noise) is
    ## routine; strict decoding would raise inside wait_for() and escape as a traceback.
    try:
        child = pexpect.spawn(
            qemu_argv[0], qemu_argv[1:], timeout=args.timeout,
            encoding="utf-8", codec_errors="replace")
    except pexpect.ExceptionPexpect as exc:
        drop_workdir()
        die_setup("cannot spawn qemu %s: %s" % (qemu_argv[0], exc))
    ## Pace input: the guest zsh line editor mangles rapidly-sent lines; a small
    ## pre-send delay lets each line run before the next.
    child.delaybeforesend = 0.4

    def cleanup():
        ## Deterministically kill+reap qemu (close(force=True) SIGKILLs + waits) so
        ## nothing lingers for the container init to force-reap as a spurious non-zero
        ## step exit; the image boots with -snapshot, so a hard kill loses nothing.
        try:
            child.close(force=True)
        except Exception:
            pass
        drop_workdir()

    return child, cleanup


def _acquire_amd_v_lock(timeout, log):
    """Hold an exclusive flock serialising concurrent BOOT-TEST runs. VBox SHARES AMD-V
    across its own VMs (the fleet runs many concurrently), so this guards VM-name / RAM
    contention between boot-test runs, NOT the fleet; ensure-amd-v (in serial-up) still
    guards the KVM<->VBox boundary. Bounded by --timeout."""
    import fcntl
    import tempfile
    import time
    fh = None
    path = None
    ## DM_SMBIOS_READER_VBOX_LOCK is a test seam (point the lock at a tmp path so
    ## parallel test runs do not collide on the shared /run/lock file); unset in
    ## production, which uses /run/lock then a tmp fallback.
    override = os.environ.get("DM_SMBIOS_READER_VBOX_LOCK")
    candidates = ([override] if override else
                  ["/run/lock/dm-smbios-reader-vbox-amd-v.lock",
                   os.path.join(tempfile.gettempdir(),
                                "dm-smbios-reader-vbox-amd-v.lock")])
    for candidate in candidates:
        try:
            fh = open(candidate, "w")
            path = candidate
            break
        except OSError:
            continue
    if fh is None:
        die_setup("cannot open the AMD-V boot-test lock file")
    deadline = time.monotonic() + max(timeout, 1)
    while True:
        try:
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            log("dm-smbios-reader-image-test: holding AMD-V boot-test lock %s" % (path,))
            return fh
        except OSError:
            if time.monotonic() >= deadline:
                fh.close()
                die_setup("timed out waiting for the AMD-V boot-test lock %s" % (path,))
            time.sleep(2)


def _release_lock(fh):
    import fcntl
    try:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()
    except OSError:
        pass


def _serial_down(vbox, vm, sock, log):
    try:
        subprocess.run([vbox, "serial-down", "--vm", vm, "--uart-socket", sock],
                       check=False)
    except OSError as exc:
        log("dm-smbios-reader-image-test: serial-down failed: %s" % (exc,))


def start_vbox_backend(args, log):
    """Build + boot a VBox VM wired for serial driving via dm-smbios-reader-vbox, connect
    its UART host socket and return (child, cleanup). The cmdline payload comes from
    dm-smbios-reader-qemu --emit-cmdline (single source), injected via VBox DMI; an
    AMD-V run-mutex serialises concurrent boot-test runs. run_checks drives it unchanged.
    """
    import socket
    import tempfile
    import time
    import pexpect
    import pexpect.fdpexpect

    self_dir = os.path.dirname(os.path.realpath(__file__))
    vbox = os.path.join(self_dir, "dm-smbios-reader-vbox")

    ## The SAME cmdline the qemu backend injects, from the shared --emit-cmdline source
    ## (single commas; VBox DMI takes the value verbatim, no qemu comma-doubling).
    emit = [args.dm_smbios_reader_qemu, "--emit-cmdline", "--test-console"]
    if args.arch:
        emit += ["--arch", args.arch]
    merged = merged_smbios_append(args)
    if merged:
        emit += ["--smbios-append", merged]
    emit += (["--disk", args.disk] if args.disk else ["--iso", args.iso])
    try:
        payload = subprocess.run(
            emit, check=True, capture_output=True, text=True).stdout.strip("\n")
    except (OSError, subprocess.CalledProcessError) as exc:
        die_setup("dm-smbios-reader-qemu --emit-cmdline failed: %s" % (exc,))

    lock_fh = _acquire_amd_v_lock(args.timeout, log)
    vm = "dm-smbios-reader-boot-%d" % os.getpid()
    sock = os.path.join(tempfile.gettempdir(), "%s.serial.sock" % (vm,))
    up = [vbox, "serial-up", "--vm", vm, "--uart-socket", sock,
          "--smbios-serial", "dm-cmdline=" + payload,
          ## Default to bios when --firmware is unset, matching dm-smbios-reader-qemu's
          ## own default so the SAME input boots the SAME firmware on both backends --
          ## and bios uses the pcbios DMI keys that are known to feed the GRUB reader
          ## (EFI DMI is a live-server-verify item).
          "--firmware", args.firmware or "bios"]
    up += (["--disk", args.disk] if args.disk else ["--iso", args.iso])
    try:
        rc = subprocess.run(up).returncode
    except OSError as exc:
        ## dm-smbios-reader-vbox missing / not executable (partial install): a setup
        ## error, not an uncaught traceback escaping as exit 1.
        _release_lock(lock_fh)
        die_setup("cannot run %s: %s" % (vbox, exc))
    if rc != 0:
        ## serial-up printed its own reason and its rc is already our contract
        ## (2 setup / 5 fail); tear the half-built VM down and propagate it.
        _serial_down(vbox, vm, sock, log)
        _release_lock(lock_fh)
        sys.exit(rc)

    ## Connect the UART socket VBox now listens on (it appears shortly after power-on).
    sk = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    deadline = time.monotonic() + 30
    while True:
        try:
            sk.connect(sock)
            break
        except OSError:
            if time.monotonic() >= deadline:
                sk.close()
                _serial_down(vbox, vm, sock, log)
                _release_lock(lock_fh)
                die_setup("VBox serial socket never appeared: %s" % (sock,))
            time.sleep(0.5)

    child = pexpect.fdpexpect.fdspawn(
        sk, timeout=args.timeout, encoding="utf-8", codec_errors="replace")
    child.delaybeforesend = 0.4
    ## No qemu writer here, so Python owns the serial log: the lossy-pty concern does
    ## not apply to a socket (a slow reader backpressures the UART rather than dropping).
    log_fh = None
    if args.serial_log:
        try:
            log_fh = open(args.serial_log, "w", encoding="utf-8")
        except OSError as exc:
            try:
                child.close()
            except Exception:
                pass
            sk.close()
            _serial_down(vbox, vm, sock, log)
            _release_lock(lock_fh)
            die_setup("cannot open --serial-log %s: %s" % (args.serial_log, exc))
        child.logfile_read = log_fh

    def cleanup():
        try:
            child.close()
        except Exception:
            pass
        try:
            sk.close()
        except Exception:
            pass
        if log_fh is not None:
            try:
                log_fh.close()
            except Exception:
                pass
        _serial_down(vbox, vm, sock, log)
        _release_lock(lock_fh)

    return child, cleanup


def main():
    args = parse_args()

    def log(message):
        print(message, file=sys.stderr)

    if args.resolve_backend:
        ## Query-only: print the resolved backend (to stdout) and exit, so the shell
        ## front-ends gate on the SAME decision this resolver makes (no duplicated
        ## auto-logic that could drift). resolve_backend may die_setup (explicit vbox
        ## with VBoxManage absent / wrong arch), which is the correct signal too.
        print(resolve_backend(args, lambda _message: None))
        sys.exit(PASS)

    try:
        import pexpect  # noqa: F401  (both backends need it; fail early + clean)
    except ImportError:
        die_setup("python3-pexpect is required (apt-get install python3-pexpect)")

    backend = resolve_backend(args, log)
    if backend == "vbox":
        child, cleanup = start_vbox_backend(args, log)
    else:
        child, cleanup = start_qemu_backend(args, log)

    try:
        verdict = run_checks(child, args, log)
    finally:
        cleanup()

    ## A ~0-byte serial log on FAIL almost always means the image lacks the
    ## --smbios-reader (or, under vbox, the DMI vendor is not QEMU): the SMBIOS cmdline
    ## injection was a no-op, so the login-free serial shell never bound. Flag it so a
    ## mis-built image is distinguishable from a real boot failure (still FAIL).
    if verdict == FAIL and args.serial_log:
        try:
            empty = os.path.getsize(args.serial_log) == 0
        except OSError:
            empty = False
        if empty:
            log("dm-smbios-reader-image-test: serial log is empty -- the image likely"
                " lacks the --smbios-reader (build with --smbios-reader true), or the"
                " DMI vendor is not QEMU under --backend vbox")

    log("dm-smbios-reader-image-test: exiting (verdict rc=%s)" % verdict)
    sys.exit(verdict)


if __name__ == "__main__":
    main()
