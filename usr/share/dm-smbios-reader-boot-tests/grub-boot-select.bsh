#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Sourceable GRUB boot-mode selection shared by every installed-VM lane
## (dm-calamares-install, vbox-session.bsh / dm-upgrade-regression, dm-whonix-pair).
## ONE deterministic mechanism, no OCR:
##   * select_installed_sysmaint_offline -- with the VM powered OFF, set grubenv next_entry
##     to the SYSMAINT boot entry via the vbox-grub-set-next-boot-mode privleap action
##     (host-side, no boot, no live-menu timing). The action prefers the per-mode menuentry
##     --id (dist-base-files 10_00_linux_dist) and falls back to the exact menuentry title,
##     so it resolves on a patched AND a pre-patch released image alike. Works on an
##     ENCRYPTED install (pass the LUKS passphrase file) and an unencrypted image (omit it);
##     pass the disk format for a non-vdi disk (vmdk for an OVA).
##   * installed_disk_path + disk_format_for -- resolve a VM's attached system disk + its
##     qemu-nbd format; moved to the image-test disk layer (vbox-vm-lib.bsh), shared with the
##     vbox-disk-mount VM wrapper, and sourced below.
##
## Uses the caller's die + FAIL_RC (die-on-failure contract) and VBOXMANAGE (gui-drive.bsh).
# shellcheck disable=SC2154  ## FAIL_RC (+ VBOXMANAGE) are set by the sourcing tool

## VM-disk helpers shared with vbox-disk-mount -- single source, co-located with the
## qemu-image-self-contained probe at the image-test disk layer.
grub_boot_select_dir="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")"
if [ -r "${grub_boot_select_dir}/../../libexec/image-test/vbox-vm-lib.bsh" ]; then
   vbox_vm_lib="${grub_boot_select_dir}/../../libexec/image-test/vbox-vm-lib.bsh"
else
   vbox_vm_lib='/usr/libexec/image-test/vbox-vm-lib.bsh'
fi
# shellcheck source=../../libexec/image-test/vbox-vm-lib.bsh
source "${vbox_vm_lib}"

## Deterministic offline boot-mode selection: set grubenv next_entry to MODE's entry.
## Args: <mode> <disk-path> [<luks-passphrase-file>] <disk-format>.
##   * mode: 'user' / 'persistent-sysmaint' / ... (the per-mode menuentry grub-select resolves).
##   * pass a passphrase file for an ENCRYPTED install; omit (or '') for an unencrypted image.
##   * format is REQUIRED (pinned, never probed) -- use disk_format_for "${disk}"; the privleap
##     action passes it to image-mount, whose --format is mandatory.
## The VM MUST be powered off (image-mount refuses a VM-locked disk). Hands the request to
## the narrow vbox-grub-set-next-boot-mode privleap action in the caller-owned request dir
## (mirrors dm-calamares-install's mok_host_enroll), which sets next_entry so the next power-on
## autoboots MODE. die()s on failure (FAIL_RC contract).
##
## Select for EVERY boot, both roles: on an encrypted disk GRUB cannot write grubenv back
## (no save_env through LUKS), so a one-shot next_entry PERSISTS; selecting the target mode
## explicitly before each boot overwrites any stale prior selection (e.g. a SYSMAINT run
## followed by a USER boot, or a reused --reinstall VM).
select_installed_mode_offline() {
   local mode="$1" disk="$2" pass_file="${3:-}" format="${4:-}" req_dir
   [ -n "${format}" ] \
      || die "${FAIL_RC}" "select_installed_mode_offline: a disk format is required (pinned, never probed; use disk_format_for)"
   req_dir="$(getent passwd "$(id -u)" | cut -d: -f6)/.cache/vbox-grub-set-next-boot-mode"
   # shellcheck disable=SC2174  ## --mode on mkdir --parents applies to the leaf, which is what we want
   mkdir --parents --mode=0700 -- "${req_dir}"
   ## Clear any stale passphrase first: the action treats its PRESENCE as meaningful (passphrase
   ## present -> LUKS unlock), so a leftover from a prior request would wrongly apply to this one.
   ## Remove disk/mode/format too before the writes below: a '>' redirect FOLLOWS a pre-existing
   ## symlink, so a stale (or planted) symlink at one of these request-dir paths would be followed
   ## and its target overwritten + chmodded. rm'ing first makes each '>' create a fresh regular file.
   safe-rm --force -- "${req_dir}/passphrase" "${req_dir}/disk" "${req_dir}/mode" "${req_dir}/format" 2>/dev/null || true
   ## Verify the postcondition rather than trust the removal: the '|| true' above swallows
   ## any safe-rm failure, so a symlink that survived cleanup would still be FOLLOWED by the
   ## '>' writes (overwriting + chmodding its target). Refuse the request if any path remains
   ## a symlink -- the writes below then only ever create fresh regular files.
   local req_path
   for req_path in "${req_dir}/passphrase" "${req_dir}/disk" "${req_dir}/mode" "${req_dir}/format"; do
      if [ -L "${req_path}" ]; then
         die "${FAIL_RC}" "refusing request: '${req_path}' is still a symlink after cleanup (planted or stale link)"
      fi
   done
   printf '%s' "${disk}" > "${req_dir}/disk"
   printf '%s' "${mode}" > "${req_dir}/mode"
   printf '%s' "${format}" > "${req_dir}/format"
   chmod 0600 -- "${req_dir}/disk" "${req_dir}/mode" "${req_dir}/format"
   if [ -n "${pass_file}" ]; then
      ## Abort on a failed copy (e.g. the passphrase file vanished after validation) rather
      ## than invoke the action without a passphrase and surface a misleading mount error.
      cp --force -- "${pass_file}" "${req_dir}/passphrase" \
         || die "${FAIL_RC}" "could not stage the LUKS passphrase from '${pass_file}'"
      chmod 0600 -- "${req_dir}/passphrase"
   fi
   if ! leaprun vbox-grub-set-next-boot-mode; then
      safe-rm --force -- "${req_dir}/disk" "${req_dir}/passphrase" "${req_dir}/mode" "${req_dir}/format" 2>/dev/null || true
      die "${FAIL_RC}" "could not set next_entry=${mode} offline via the 'vbox-grub-set-next-boot-mode' privleap action (installed? runner in vboxusers? disk/passphrase/format correct?)"
   fi
   safe-rm --force -- "${req_dir}/disk" "${req_dir}/passphrase" "${req_dir}/mode" "${req_dir}/format" 2>/dev/null || true
}

## Thin SYSMAINT wrapper (the whonix lane selects only this mode).
## Args: <disk-path> [<luks-passphrase-file>] <disk-format>.
select_installed_sysmaint_offline() {
   select_installed_mode_offline persistent-sysmaint "$@"
}
##
## style-ok: no-strict -- sourced-only fragment; a top-level 'set -o errexit'/
## 'nounset'/'pipefail' would leak into (and could kill) the sourcing shell.
