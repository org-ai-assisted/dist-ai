## AI-Assisted

## Sourceable GRUB boot-mode selection shared by every installed-VM lane
## (dm-calamares-install, vbox-session.bsh / dm-upgrade-regression, dm-whonix-pair).
## ONE deterministic mechanism, no OCR:
##   * select_installed_sysmaint_offline -- with the VM powered OFF, set grubenv next_entry
##     to the SYSMAINT boot entry via the vbox-grub-set-next-boot-mode privleap action
##     (host-side, no boot, no live-menu timing). The action prefers the per-mode menuentry
##     --id (dist-base-files 10_00_linux_dist) and falls back to the exact menuentry title,
##     so it resolves on a patched AND a pre-patch released image alike. Works on an
##     ENCRYPTED install (pass the LUKS passphrase file) and an unencrypted image (omit it);
##     pass the disk format for a non-vdi disk (vmdk for an OVA).
##   * installed_disk_path -- resolve a VM's attached system disk image from VBoxManage, so a
##     lane that only knows the VM name can hand the disk to the selector.
##
## Uses the caller's die + FAIL_RC (die-on-failure contract) and VBOXMANAGE (gui-drive.bsh).
# shellcheck disable=SC2154  ## FAIL_RC (+ VBOXMANAGE) are set by the sourcing tool

## Resolve the first attached writable disk image of VM $1 (skip none/emptydrive and optical
## .iso media), so a lane holding only the VM name can select offline. die()s on no disk.
installed_disk_path() {
   local vm="$1" info line path
   info="$("${VBOXMANAGE:-VBoxManage}" showvminfo "${vm}" --machinereadable)" \
      || die "${FAIL_RC}" "could not read VM info for '${vm}' (installed_disk_path)"
   while IFS= read -r line; do
      ## A storage attachment with an absolute-path value: "<controller>-<p>-<d>"="/path".
      case "${line}" in
         '"'*'"="/'*)
            true
            ;;
         *)
            continue
            ;;
      esac
      path="${line#*=\"}"
      path="${path%\"}"
      case "${path}" in
         *.vdi|*.VDI|*.vmdk|*.VMDK|*.vhd|*.VHD|*.qcow2|*.img|*.raw)
            printf '%s\n' "${path}"
            return 0
            ;;
      esac
   done <<< "${info}"
   die "${FAIL_RC}" "no attached disk image found for VM '${vm}' (installed_disk_path)"
}

## Deterministic offline SYSMAINT selection.
## Args: <disk-path> [<luks-passphrase-file>] [<disk-format>].
##   * pass a passphrase file for an ENCRYPTED install; omit (or '') for an unencrypted image.
##   * pass a format ('vmdk') for a non-vdi disk; omit (or '') for the vdi default.
## The VM MUST be powered off (vbox-disk-mount refuses a VM-locked disk). Hands the request
## to the narrow vbox-grub-set-next-boot-mode privleap action in the caller-owned request dir
## (mirrors dm-calamares-install's mok_host_enroll), which sets next_entry so the next
## power-on autoboots SYSMAINT. die()s on failure (FAIL_RC contract).
select_installed_sysmaint_offline() {
   local disk="$1" pass_file="${2:-}" format="${3:-}" req_dir
   req_dir="$(getent passwd "$(id -u)" | cut -d: -f6)/.cache/vbox-grub-set-next-boot-mode"
   # shellcheck disable=SC2174  ## --mode on mkdir --parents applies to the leaf, which is what we want
   mkdir --parents --mode=0700 -- "${req_dir}"
   ## Clear any stale optional files first: the action treats their PRESENCE as meaningful
   ## (passphrase present -> LUKS unlock; format present -> non-vdi), so a leftover from a
   ## prior request would wrongly apply to this one.
   safe-rm --force -- "${req_dir}/passphrase" "${req_dir}/format" 2>/dev/null || true
   printf '%s' "${disk}" > "${req_dir}/disk"
   printf '%s' 'persistent-sysmaint' > "${req_dir}/mode"
   chmod 0600 -- "${req_dir}/disk" "${req_dir}/mode"
   if [ -n "${pass_file}" ]; then
      cp --force -- "${pass_file}" "${req_dir}/passphrase"
      chmod 0600 -- "${req_dir}/passphrase"
   fi
   if [ -n "${format}" ]; then
      printf '%s' "${format}" > "${req_dir}/format"
      chmod 0600 -- "${req_dir}/format"
   fi
   if ! leaprun vbox-grub-set-next-boot-mode; then
      safe-rm --force -- "${req_dir}/disk" "${req_dir}/passphrase" "${req_dir}/mode" "${req_dir}/format" 2>/dev/null || true
      die "${FAIL_RC}" "could not set SYSMAINT next_entry offline via the 'vbox-grub-set-next-boot-mode' privleap action (installed? runner in vboxusers? disk/passphrase/format correct?)"
   fi
   safe-rm --force -- "${req_dir}/disk" "${req_dir}/passphrase" "${req_dir}/mode" "${req_dir}/format" 2>/dev/null || true
}
##
## style-ok: no-strict -- sourced-only fragment; a top-level 'set -o errexit'/
## 'nounset'/'pipefail' would leak into (and could kill) the sourcing shell.
