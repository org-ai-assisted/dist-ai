## AI-Assisted

## Sourceable VBox boot-role + in-guest-exec helpers for the upgrade-regression
## recipe (dm-upgrade-regression). Reaching a boot role (GRUB menu) and unlocking
## LUKS are pre-OS, so they are unavoidably screenshot+scancode (gui-drive.bsh);
## once the guest is up, commands run via VBoxManage guestcontrol (a shipped VM
## image has Guest Additions / VBoxService -- a Calamares-installed disk does not,
## which is why the Calamares gate uses the OCR terminal instead).
##
## MUST be sourced AFTER gui-drive.bsh (uses gui_ocr/gui_scan + the caller's die).
## Caller globals: vm, VBOXMANAGE, GUESTCTL, FAIL_RC, me, and (optional) passphrase.
##
## select_installed_sysmaint lives in grub-boot-select.bsh -- the single source shared
## with dm-calamares-install -- which the sourcing tool loads before this fragment.
## boot_installed wraps that call so its die() cannot escape (return-nonzero contract).
##
## style-ok: no-strict -- sourced-only fragment; a top-level 'set -o errexit'/
## 'nounset'/'pipefail' would leak into (and could kill) the sourcing shell.
# shellcheck disable=SC2154  ## vm/VBOXMANAGE/GUESTCTL/FAIL_RC/me/passphrase are set by the sourcing tool

## Map a boot ROLE to the guest account that may authenticate in it. In a sysmaint
## boot security-misc block-unsafe-logins rejects `user` (and vice versa), so the
## account MUST match the boot role (task #83).
gc_account_for_role() {
   case "$1" in
      sysmaint)
         printf '%s' 'sysmaint'
         ;;
      *)
         printf '%s' 'user'
         ;;
   esac
}

## Run a shell snippet in-guest as USERNAME (= boot role), delegating to vbox-exec-local --
## the ONE place that builds the guestcontrol argv (empty-password channel task #83, and the
## VBox-7.2 `--exe /bin/bash -- -lc` fix). The guest process exit code propagates. Optional
## TIMEOUT_S bounds the guest process. No argv is rebuilt here, so the two can never drift.
## VBOX_EXEC_LOCAL is overridable so a test can assert the delegated invocation with a stub.
gc_run() {
   local username="$1" snippet="$2" timeout_s="${3:-}"
   local -a argv=( "${VBOX_EXEC_LOCAL:-vbox-exec-local}" "${vm}" --role "${username}" --cmd "${snippet}" )
   if [ -n "${timeout_s}" ]; then
      argv+=( --timeout "${timeout_s}" )
   fi
   "${argv[@]}"
}

## Where gc_gui_launch_snippet redirects the launched GUI's output; gc_gui_launch_log
## reads it back for diagnostics. Single source so the two never drift.
GC_GUI_LAUNCH_LOG='/var/tmp/dm-gui-launch.log'

## Build the in-guest snippet that launches a GUI PROGRAM in the live Wayland session
## via guestcontrol. Separated from gc_launch_gui so a unit test asserts its shape.
## WHY each piece: the guestcontrol env carries XDG_RUNTIME_DIR but NOT WAYLAND_DISPLAY
## (no logind graphical session), so export it (labwc's live-session socket is wayland-0,
## probe-confirmed); setsid + </dev/null + log-redirect detach the GUI from the exec
## channel so it keeps running after the gc_run bash exits (a plain `&` child would be
## SIGHUP'd when the channel closes). EXTRA (optional) is a space-separated VAR=VAL list
## exported alongside. PROGRAM + EXTRA are TRUSTED harness literals interpolated into the
## guest shell -- never pass untrusted data (no escaping is done).
gc_gui_launch_snippet() {
   local program="$1" extra="${2:-}"
   local exports='export WAYLAND_DISPLAY=wayland-0'
   if [ -n "${extra}" ]; then
      exports+=" ${extra}"
   fi
   printf '%s' \
      "${exports}; setsid ${program} >${GC_GUI_LAUNCH_LOG} 2>&1 </dev/null &"
}

## Launch a GUI PROGRAM in-guest as USERNAME (= boot role), backgrounded so gc_run
## returns at once (the program holds its own Wayland window). EXTRA is an optional
## VAR=VAL env list (e.g. MOK_ENROLL=1). The guest must already have a graphical
## session up (compositor) and VBoxService reachable (wait_guestcontrol_ready).
gc_launch_gui() {
   local username="$1" program="$2" extra="${3:-}"
   gc_run "${username}" "$(gc_gui_launch_snippet "${program}" "${extra}")"
}

## Dump the GUI-launch log back to the caller for diagnostics. gc_launch_gui backgrounds
## and returns 0 regardless, so a program that died at once leaves its reason ONLY here.
gc_gui_launch_log() {
   local username="$1"
   gc_run "${username}" "cat ${GC_GUI_LAUNCH_LOG} 2>/dev/null || true"
}

## Confirm a gc_launch_gui'd program actually came up: poll (as USERNAME) for a process
## matching PATTERN via pgrep -f, up to TIMEOUT. 0 = up, 1 = never appeared. WHY: the
## launch is fire-and-forget, so without this a failed program (wrong boot role, missing
## binary, compositor unreachable) would surface only as a downstream OCR timeout minutes
## later with no reason; the caller dumps gc_gui_launch_log on 1. PATTERN is a trusted
## harness literal (interpolated into the guest shell).
gc_wait_gui_started() {
   local username="$1" pattern="$2" timeout="$3" deadline
   deadline=$(( SECONDS + timeout ))
   while [ "${SECONDS}" -lt "${deadline}" ]; do
      if gc_run "${username}" "pgrep -f -- ${pattern} >/dev/null 2>&1"; then
         return 0
      fi
      sleep 5
   done
   return 1
}

## Poll until guestcontrol as USERNAME can run `true` (VBoxService up + account
## loginable in this boot role), or TIMEOUT. 0 ready / 1 timeout (NOT die: a guest
## that never comes back after an upgrade is the gate's signal, not a harness crash --
## the caller routes it to a degraded/blocking result).
wait_guestcontrol_ready() {
   local username="$1" timeout="$2" deadline
   deadline=$(( SECONDS + timeout ))
   while [ "${SECONDS}" -lt "${deadline}" ]; do
      if gc_run "${username}" 'true' >/dev/null 2>&1; then
         return 0
      fi
      sleep 10
   done
   printf '%s\n' "${me}: guestcontrol not ready as '${username}' after ${timeout}s" >&2
   return 1
}

## Shut the guest down CLEANLY (ACPI power button) and wait for it to power off, so a
## just-applied upgrade's filesystem/apt state is flushed -- a hard `controlvm
## poweroff` right after upgrade-nonroot can corrupt the persisted disk. Falls back to
## a hard poweroff only if the guest ignores ACPI within the timeout.
clean_poweroff() {
   local deadline state
   "${VBOXMANAGE}" controlvm "${vm}" acpipowerbutton >/dev/null 2>&1 || true
   deadline=$(( SECONDS + 120 ))
   while [ "${SECONDS}" -lt "${deadline}" ]; do
      state="$("${VBOXMANAGE}" showvminfo "${vm}" --machinereadable 2>/dev/null \
         | sed -n 's/^VMState="\(.*\)"$/\1/p')"
      ## Only a REPORTED off-state counts. An empty result means showvminfo failed
      ## transiently (e.g. lock contention) -- keep polling, never assume "off", so
      ## the hard-poweroff fallback still fires if the guest really is stuck running.
      case "${state}" in
         poweroff|aborted)
            return 0
            ;;
      esac
      sleep 3
   done
   "${VBOXMANAGE}" controlvm "${vm}" poweroff >/dev/null 2>&1 || true
}

## Echo the guest display WIDTH in pixels (0 if unavailable). The desktop-up visual
## signal: a real graphical mode is >=1024 wide, past the 800x600 early framebuffer.
guest_width() {
   local res
   res="$("${GUESTCTL}" "${vm}" res 2>/dev/null || true)"
   res="${res%% *}"
   [[ "${res}" =~ ^[0-9]+$ ]] && printf '%s' "${res}" || printf '%s' '0'
}

## Enter the LUKS passphrase at the boot prompt IF one is set (shipped VM images
## ship unencrypted -> no prompt -> skip). LABEL is for the message only.
unlock_luks() {
   local label="${1:-}"
   [ -n "${passphrase:-}" ] || return 0
   gui_wait_for 'passphrase for disk|please unlock|luks' 120 "LUKS unlock${label:+ (${label})}"
   printf '%s' "${passphrase}" | "${GUESTCTL}" "${vm}" type-stdin >/dev/null
   gui_scan 1c 9c
}

## Power-cycle the installed disk into ROLE (user = default GRUB entry; sysmaint =
## entry 2), unlock LUKS if encrypted, and wait until guestcontrol is reachable as
## the role's account. Returns nonzero (NOT die) if the guest never comes back, so a
## bricked-by-upgrade boot flows to the gate result. No terminal is opened. The
## shutdown is CLEAN (clean_poweroff) to protect the persisted on-disk state.
boot_installed() {
   local role="$1" account
   account="$(gc_account_for_role "${role}")"
   clean_poweroff
   "${VBOXMANAGE}" startvm "${vm}" --type headless >/dev/null
   if [ "${role}" = 'sysmaint' ]; then
      ## select_installed_sysmaint die()s if the GRUB menu never OCRs; a subshell keeps
      ## that exit from escaping boot_installed, honoring the return-nonzero contract (a
      ## GRUB-bricked upgrade flows to the degraded gate result, not a hard exit past
      ## write_report). It only sends scancodes -- no shell-var side effects the rest of
      ## boot_installed reads -- so the subshell is semantically free.
      ( select_installed_sysmaint ) || return 1
   fi
   unlock_luks "${role}"
   wait_guestcontrol_ready "${account}" 300
}
