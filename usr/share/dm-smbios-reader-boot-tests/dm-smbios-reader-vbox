                          memory=args.memory, disk_mb=args.disk_mb)
    except subprocess.CalledProcessError as exc:
        ## A VBoxManage build step failed (bad option, unsupported firmware, disk
        ## already exists) -- a SETUP error, reported cleanly, never a traceback
        ## and never a silent PASS.
        print('dm-smbios-reader-vbox: install VM build failed: %s' % (' '.join(exc.cmd),),
              file=sys.stderr)
        return SETUP_RC
    rc = FAIL_RC
    started = False
    try:
        start_vm(args.vm)
        started = True
        ok, png, ocr = poll_screen_for(
            args.vm, args.expect, timeout=args.timeout, interval=args.interval,
            shot=args.shot)
        print('dm-smbios-reader-vbox: screenshot %s' % (png,))
        if ok:
            print('dm-smbios-reader-vbox: PASS -- ISO booted to live/installer; found: %s'
                  % (', '.join(args.expect),))
            rc = PASS_RC
        else:
            missing = [item for item in args.expect
                       if not ocr_text_contains(ocr, item)]
            print('dm-smbios-reader-vbox: FAIL -- missing after %ds: %s'
                  % (args.timeout, ', '.join(missing)), file=sys.stderr)
    except SetupError as exc:
        print('dm-smbios-reader-vbox: SETUP -- %s' % (exc,), file=sys.stderr)
        rc = SETUP_RC
    except (subprocess.CalledProcessError, FileNotFoundError, RuntimeError) as exc:
        print('dm-smbios-reader-vbox: FAIL -- boot/verify error: %s' % (exc,), file=sys.stderr)
    finally:
        ## power off ONLY the VM this run actually started (see run_boot_test).
        if started and not args.no_poweroff:
            _poweroff_quietly(args.vm)
    return rc


def _teardown_serial_vm(vmname, uart_socket):
    """Best-effort, idempotent teardown: power off, unregister+delete (drops the
    per-VM differencing image a multiattach disk created), remove the UART socket.
    Used by serial-down AND to clean up a serial-up that failed mid-build -- else a
    registered half-built VM blocks the next serial-up at createvm (name in use)."""
    _poweroff_quietly(vmname)
    try:
        _run(build_unregister_argv(vmname))
    except FileNotFoundError:
        ## VBoxManage gone mid-teardown -- nothing more we can do.
        pass
    except subprocess.CalledProcessError as exc:
        ## An already-absent VM is idempotent success; any OTHER unregister failure
        ## means the VM (and its created media) may STILL be registered -- do not mask
        ## it silently (a lingering VM blocks the next createvm). Report it to stderr.
        print('dm-smbios-reader-vbox: WARNING -- unregister of %r may have failed'
              ' (rc=%s); a leftover VM can block the next run'
              % (vmname, exc.returncode), file=sys.stderr)
    if uart_socket:
        try:
            os.unlink(uart_socket)
        except OSError:
            pass
    ## Remove a converted throwaway VDI serial-up may have made for a raw/qcow2 --disk.
    ## Done HERE (not only in serial-down) so a serial-up that fails AFTER converting
    ## but before/at the plan does not leak the copied disk image. basename-safe path.
    try:
        os.unlink(converted_disk_path(vmname))
    except OSError:
        pass


def run_serial_up(args):
    """Real-host: build a VM wired for SERIAL driving, free AMD-V, boot headless and
    PROVE hardware acceleration, leaving it running with COM1 on a host UNIX socket
    for the dm-smbios-reader-image-test battery. exit 0 up / 2 setup / 5 fail.

    --emit-argv prints the VBoxManage build sequence (one command per line) without
    running it, so the plan is unit-testable without a VBox host. On ANY failure the
    half-built VM is torn down so a registered leftover cannot block the next run."""
    convert_argv = None
    attach_disk = args.disk
    if args.disk:
        try:
            attach_disk, convert_argv = disk_conversion(args.disk, args.vm)
        except SetupError as exc:
            print('dm-smbios-reader-vbox: %s' % (exc,), file=sys.stderr)
            return SETUP_RC
    plan = build_serial_vm_plan(
        args.vm, iso=args.iso, disk=attach_disk, firmware=args.firmware,
        memory=args.memory, uart_socket=args.uart_socket,
        dmi_vendor=args.dmi_vendor, dmi_serial=args.smbios_serial)
    if args.emit_argv:
        ## the raw/qcow2 -> VDI conversion is a serial-up-time pre-step, not a pure
        ## VBoxManage plan step; show it first so the emitted sequence is complete.
        if convert_argv:
            print(' '.join(convert_argv))
        for argv in plan:
            print(' '.join(argv))
        return PASS_RC
    try:
        require_vboxmanage()
    except SetupError as exc:
        print('dm-smbios-reader-vbox: %s' % (exc,), file=sys.stderr)
        return SETUP_RC
    try:
        if convert_argv:
            ## convert BEFORE the plan runs -- storageattach references the VDI path.
            _ensure_converted_vdi_dir()  # owner-only 0700 dir (side effect; run path)
            try:
                ## qcow2 only (raw/img use VBoxManage convertfromraw -- no external refs);
                ## validate the ABSOLUTE path qemu-img will read (convert_argv[-2]).
                if convert_argv[0] == QEMU_IMG:
                    _assert_no_external_refs(convert_argv[-2])
                _run(convert_argv)
            except FileNotFoundError:
                raise SetupError(
                    '%s not found -- needed to convert %s to a VBox VDI; install it'
                    ' or pass a VDI/VMDK/VHD --disk'
                    % (convert_argv[0], args.disk))
        for argv in plan:
            _run(argv)
        start_vm(args.vm)
    except SetupError as exc:
        ## AMD-V refused / unload failed / not hardware-accelerated -- a SETUP fault.
        print('dm-smbios-reader-vbox: SETUP -- %s' % (exc,), file=sys.stderr)
        _teardown_serial_vm(args.vm, args.uart_socket)
        return SETUP_RC
    except subprocess.CalledProcessError as exc:
        ## A VBoxManage build step failed (bad option, a RAW disk rejected for
        ## multiattach, ...) -- SETUP; tear the half-built VM down.
        print('dm-smbios-reader-vbox: serial VM build failed: %s'
              % (' '.join(exc.cmd),), file=sys.stderr)
        _teardown_serial_vm(args.vm, args.uart_socket)
        return SETUP_RC
    except (FileNotFoundError, RuntimeError) as exc:
        print('dm-smbios-reader-vbox: FAIL -- serial boot failed: %s'
              % (exc,), file=sys.stderr)
        _teardown_serial_vm(args.vm, args.uart_socket)
        return FAIL_RC
    ## Leave the VM RUNNING -- the caller drives the serial socket, then serial-down.
    print('dm-smbios-reader-vbox: serial-up %s listening on %s'
          % (args.vm, args.uart_socket))
    return PASS_RC


def run_serial_down(args):
    """Tear a serial VM down (power off, unregister+delete, remove the UART socket).
    Best-effort + idempotent -- a VM already gone is not an error."""
    try:
        require_vboxmanage()
    except SetupError as exc:
        print('dm-smbios-reader-vbox: %s' % (exc,), file=sys.stderr)
        return SETUP_RC
    ## _teardown_serial_vm also removes any converted throwaway VDI.
    _teardown_serial_vm(args.vm, args.uart_socket)
    return PASS_RC


## --- CLI --------------------------------------------------------------------

_EMIT_OPS = (
    'import', 'createvm', 'modifyvm', 'createmedium', 'storagectl',
    'storageattach', 'startvm', 'screenshot', 'keyboard', 'poweroff',
)


## Per-op flags that have no default and must be supplied for a usable argv;
## keyboard additionally needs one of --key/--text (handled below). Without
## this a missing flag would emit a literal 'None' into the argv (or crash),
## defeating the point of a byte-exact --emit-argv.
_EMIT_REQUIRED = {
    'import': ('ova',),
    'createmedium': ('medium',),
    'storageattach': ('medium',),
}


def _validate_emit_args(op, args):
    missing = ['--' + name for name in _EMIT_REQUIRED.get(op, ())
               if getattr(args, name) is None]
    if op == 'keyboard' and args.key is None and args.text is None:
        missing.append('--key or --text')
    if missing:
        raise ValueError('op %r needs %s' % (op, ', '.join(missing)))


def _emit_argv(args):
    """Build the argv for one op from CLI flags and return it (no execution)."""
    op = args.op
    _validate_emit_args(op, args)
    if op == 'import':
        return build_import_argv(args.ova, args.vm)
    if op == 'createvm':
        return build_createvm_argv(args.vm, args.ostype,
                                   basefolder=args.basefolder)
    if op == 'modifyvm':
        return build_modifyvm_argv(args.vm, memory=args.memory,
                                   firmware=args.firmware, nic=args.nic,
                                   intnet=args.intnet)
    if op == 'createmedium':
        return build_createmedium_argv(args.medium, args.size, fmt=args.format)
    if op == 'storagectl':
        return build_storagectl_argv(args.vm, args.controller, args.bus,
                                     args.controller_chip)
    if op == 'storageattach':
        return build_storageattach_argv(args.vm, args.controller, args.port,
                                        args.device, args.medium_type,
                                        args.medium)
    if op == 'startvm':
        return build_startvm_argv(args.vm)
    if op == 'screenshot':
        return build_screenshot_argv(args.vm, args.png)
    if op == 'keyboard':
        if args.key is not None:
            codes = encode_key(args.key)
        else:
            codes = encode_scancodes(args.text)
        return build_keyboard_argv(args.vm, codes)
    if op == 'poweroff':
        return build_poweroff_argv(args.vm)
    raise ValueError('unknown op %r' % (op,))


def _build_parser():
    parser = argparse.ArgumentParser(
        prog='dm-smbios-reader-vbox',
        description='VirtualBox backend for the dm-image boot/install harness.')
    sub = parser.add_subparsers(dest='cmd', required=True)

    emit = sub.add_parser(
        'emit-argv',
        help='print the VBoxManage argv for one op, without running it')
    emit.add_argument('--op', required=True, choices=_EMIT_OPS)
    emit.add_argument('--vm', default='dm-smbios-reader-vbox-guest')
    emit.add_argument('--ova')
    emit.add_argument('--ostype', default='Debian_64')
    emit.add_argument('--basefolder')
    emit.add_argument('--memory', type=int)
    emit.add_argument('--firmware', choices=sorted(_FIRMWARE))
    emit.add_argument('--nic')
    emit.add_argument('--intnet')
    emit.add_argument('--medium')
    emit.add_argument('--medium-type', dest='medium_type',
                      choices=('dvddrive', 'hdd'), default='hdd')
    emit.add_argument('--size', type=int, default=20480)
    emit.add_argument('--format', default='VDI')
    emit.add_argument('--controller', default='SATA')
    emit.add_argument('--controller-chip', dest='controller_chip',
                      default='IntelAhci')
    emit.add_argument('--bus', default='sata')
    emit.add_argument('--port', type=int, default=0)
    emit.add_argument('--device', type=int, default=0)
    emit.add_argument('--png', default='screenshot.png')
    emit.add_argument('--text')
    emit.add_argument('--key')

    sub.add_parser(
        'capabilities',
        help='report which optional host tools (VBoxManage, tesseract, '
             'imagehash) are available')

    sub.add_parser(
        'ensure-amd-v',
        help='free AMD-V for VirtualBox: unload + blacklist KVM unless a KVM '
             'VM is running (the VBox boot prerequisite)')

    run = sub.add_parser(
        'run',
        help='real-host end-to-end: [import], boot headless, OCR-verify expected '
             'screen text, power off (exit 0 PASS / 5 FAIL)')
    run.add_argument('--vm', required=True)
    run.add_argument('--ova', help='import this .ova as --vm before booting')
    run.add_argument('--expect', action='append', default=[], required=True,
                     metavar='TEXT',
                     help='text that must appear on screen (repeatable; ALL required)')
    run.add_argument('--timeout', type=int, default=240)
    run.add_argument('--interval', type=int, default=15)
    run.add_argument('--shot', help='write the final screenshot to this path')
    run.add_argument('--no-poweroff', dest='no_poweroff', action='store_true')

    inst = sub.add_parser(
        'install',
        help='real-host: build a fresh EFI VM booting an ISO against an empty '
             'target disk, OCR-verify it reaches the live/installer screen (the '
             'R3 precursor); exit 0 PASS / 5 FAIL')
    inst.add_argument('--vm', required=True)
    inst.add_argument('--iso', required=True, help='bootable ISO to install from')
    inst.add_argument('--disk', help='target disk image path (default TMP/<vm>.vdi)')
    inst.add_argument('--disk-mb', dest='disk_mb', type=int, default=25600,
                      help='target disk size in MiB (default 25600)')
    inst.add_argument('--memory', type=int, default=4096)
    inst.add_argument('--firmware', choices=sorted(_FIRMWARE),
                      default='efi-secureboot',
                      help='ISO gate firmware (default efi-secureboot)')
    inst.add_argument('--expect', action='append', default=[], required=True,
                      metavar='TEXT',
                      help='text that must appear on screen (repeatable; ALL required)')
    inst.add_argument('--timeout', type=int, default=300)
    inst.add_argument('--interval', type=int, default=15)
    inst.add_argument('--shot', help='write the final screenshot to this path')
    inst.add_argument('--no-poweroff', dest='no_poweroff', action='store_true')

    serial_up = sub.add_parser(
        'serial-up',
        help='build + boot a VM wired for SERIAL driving (headless, no network): '
             'COM1 -> host UNIX socket, DMI vendor=QEMU + dm-cmdline serial so the '
             'in-image GRUB reader injects the kernel cmdline. For '
             'dm-smbios-reader-image-test --backend vbox. exit 0 up / 2 setup / 5 fail')
    su_media = serial_up.add_mutually_exclusive_group(required=True)
    su_media.add_argument('--iso', help='boot this ISO live (dvddrive)')
    su_media.add_argument('--disk',
                          help='boot this disk image (SATA hdd, multiattach); '
                               'VDI/VMDK/VHD direct, raw/qcow2 auto-converted to VDI')
    serial_up.add_argument('--vm', required=True)
    serial_up.add_argument('--uart-socket', dest='uart_socket', required=True,
                           help='host UNIX socket path VBox listens on for COM1')
    serial_up.add_argument('--smbios-serial', dest='smbios_serial', required=True,
                           help='DMI system serial (dm-cmdline=<payload> from '
                                'dm-smbios-reader-qemu --emit-cmdline)')
    serial_up.add_argument('--dmi-vendor', dest='dmi_vendor', default='QEMU',
                           help='DMI system vendor; must be QEMU so the in-image '
                                'reader fires (default QEMU)')
    serial_up.add_argument('--firmware', choices=sorted(_FIRMWARE), default='efi')
    serial_up.add_argument('--memory', type=int, default=3072)
    serial_up.add_argument('--emit-argv', dest='emit_argv', action='store_true',
                           help='print the VBoxManage build sequence, do not run it')

    serial_down = sub.add_parser(
        'serial-down',
        help='power off + unregister (delete) a serial VM and remove its socket')
    serial_down.add_argument('--vm', required=True)
    serial_down.add_argument('--uart-socket', dest='uart_socket',
                             help='UART socket path to remove')

    verify = sub.add_parser(
        'verify',
        help='compare a screenshot against a committed render baseline (tolerant '
             'perceptual pixel diff, resize-normalised) and optionally OCR-assert '
             'expected text; exit 0 MATCH / 5 MISMATCH')
    verify.add_argument('--shot', required=True, help='screenshot PNG to check')
    verify.add_argument('--baseline', required=True, help='committed baseline PNG')
    verify.add_argument('--tol', type=float, default=0.05,
                        help='max mean per-channel pixel diff in [0,1] (default 0.05)')
    verify.add_argument('--expect', action='append', default=[], metavar='TEXT',
                        help='text that must also appear on the shot (repeatable, '
                             'ALL required; needs tesseract)')
    return parser


def _cmd_capabilities():
    import importlib.util
    import shutil
    have_vbox = shutil.which(VBOXMANAGE) is not None
    have_tesseract = shutil.which(TESSERACT) is not None
    have_imagehash = importlib.util.find_spec('imagehash') is not None
    print('VBoxManage: %s' % ('yes' if have_vbox else 'no'))
    print('tesseract:  %s' % ('yes' if have_tesseract else 'no'))
    print('imagehash:  %s' % ('yes' if have_imagehash else 'no'))
    return PASS_RC


def _cmd_verify(args):
    from pathlib import Path
    for label, path in (('baseline', args.baseline), ('screenshot', args.shot)):
        if not Path(path).is_file():
            print('dm-smbios-reader-vbox: %s not found: %s' % (label, path), file=sys.stderr)
            return SETUP_RC
    ratio = image_diff_ratio(args.baseline, args.shot)
    matched = ratio <= args.tol
    print('dm-smbios-reader-vbox: render diff %.4f (tol %.4f) vs %s: %s'
          % (ratio, args.tol, Path(args.baseline).name,
             'MATCH' if matched else 'MISMATCH'))
    if not matched:
        return FAIL_RC
    if args.expect:
        text = run_ocr(args.shot)
        if not ocr_text_contains(text, args.expect):
            print('dm-smbios-reader-vbox: expected text missing from shot: %s'
                  % (args.expect,), file=sys.stderr)
            return FAIL_RC
    return PASS_RC


def main(argv=None):
    args = _build_parser().parse_args(argv)
    if args.cmd == 'emit-argv':
        try:
            tokens = _emit_argv(args)
        except ValueError as exc:
            ## Bad/missing CLI input is a SETUP error, not a traceback (exit 1)
            ## and never a silent PASS with 'None' in the argv.
            print('dm-smbios-reader-vbox: %s' % (exc,), file=sys.stderr)
            return SETUP_RC
        for token in tokens:
            print(token)
        return PASS_RC
    if args.cmd == 'capabilities':
        return _cmd_capabilities()
    if args.cmd == 'ensure-amd-v':
        return ensure_amd_v_available()
    if args.cmd == 'run':
        return run_boot_test(args)
    if args.cmd == 'install':
        return run_install_test(args)
    if args.cmd == 'serial-up':
        return run_serial_up(args)
    if args.cmd == 'serial-down':
        return run_serial_down(args)
    if args.cmd == 'verify':
        return _cmd_verify(args)
    return SETUP_RC


if __name__ == '__main__':
    sys.exit(main())
