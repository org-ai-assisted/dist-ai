## --- AMD-V availability (DEFERRED: reads /proc, unloads modules, needs root) --

def _read_text(path):
    with open(path, encoding='utf-8') as handle:
        return handle.read()


def _write_blacklist(euid):
    if euid == 0:
        with open(BLACKLIST_PATH, 'w', encoding='ascii') as handle:
            handle.write(BLACKLIST_CONTENT)
        return
    subprocess.run(sudo_prefix(euid) + ['tee', '--', BLACKLIST_PATH],
                   input=BLACKLIST_CONTENT, text=True, check=True,
                   stdout=subprocess.DEVNULL)


def ensure_amd_v_available():
    """Ensure AMD-V is free for VirtualBox. Idempotent, safe, root-aware.

    - non-AMD host or no KVM loaded -> no-op success;
    - a KVM VM is running -> refuse (never yank AMD-V from a live VM);
    - otherwise unload KVM and blacklist it so it stays out.

    Returns PASS_RC (ensured / no-op), SETUP_RC (refused: VM running) or
    FAIL_RC (unload failed).
    """
    is_amd = cpu_is_amd(_read_text('/proc/cpuinfo'))
    refcounts = parse_module_refcounts(_read_text('/proc/modules'))
    outcome, message = amd_v_plan(is_amd, refcounts)
    if outcome == AMD_V_NOOP:
        print('dm-smbios-reader-vbox: %s' % (message,))
        return PASS_RC
    if outcome == AMD_V_REFUSE:
        print('dm-smbios-reader-vbox: %s' % (message,), file=sys.stderr)
        return SETUP_RC
    euid = os.geteuid()
    try:
        _run(build_modprobe_remove_argv(refcounts, euid))
    except subprocess.CalledProcessError:
        print('dm-smbios-reader-vbox: could not unload KVM; AMD-V not freed for VirtualBox',
              file=sys.stderr)
        return FAIL_RC
    _write_blacklist(euid)
    print('dm-smbios-reader-vbox: %s' % (message,))
    return PASS_RC


## --- Setup faults: VBoxManage absence + no hardware acceleration (both SETUP) ---
## Distinct from a FAIL (the image/boot is bad): these are ENVIRONMENT faults, so
## they map to SETUP_RC, never FAIL and never a skip (there is no VBox backend
## without VBoxManage, and AMD-V is the whole point -- a degraded run is worse than
## a loud stop). The run paths catch SetupError first, before the FAIL-mapped errors.
class SetupError(RuntimeError):
    """A VBox-backend environment/setup fault -> SETUP_RC (never FAIL, never skip)."""


class HwAccelError(SetupError):
    """The VM booted WITHOUT AMD-V/VT-x hardware acceleration."""


def require_vboxmanage():
    """VBoxManage is a HARD dependency of every real run path -- loud SETUP if absent."""
    import shutil
    if shutil.which(VBOXMANAGE) is None:
        raise SetupError(
            'VBoxManage not found on PATH -- the VBox backend requires VirtualBox'
            ' (install it); this is a hard dependency, not a skip')


## Positive hardware-virt markers / fallback markers in a VM's VBox.log (HM subsystem).
## VBox >= 6.1 has NO software VMM: without hardware virt a VM cannot power on at all,
## so a booted-but-unaccelerated VM means AMD-V was lost to KVM or nested virt is off.
_HWACCEL_MARKERS = (
    'using amd-v', 'using vt-x', 'enabled amd-v', 'enabled vt-x', 'amd-v (svm',
    'hardware virtualization: enabled',
)
_HWACCEL_FALLBACK = (
    'falling back to nem', 'using nem', 'raw-mode', 'software virtualization',
    'hardware virtualization: disabled', 'verr_svm', 'verr_vmx',
)


def hwaccel_in_use(log_text):
    """True iff a VM's VBox.log shows HM using AMD-V/VT-x AND no NEM/raw-mode/
    software fallback. Pure; the markers may need tuning against the server's real
    VBox 7.x phrasing (verified in the server integration test)."""
    low = log_text.lower()
    if any(bad in low for bad in _HWACCEL_FALLBACK):
        return False
    return any(good in low for good in _HWACCEL_MARKERS)


def _vm_log_text(vmname, vboxmanage=VBOXMANAGE):
    """Current VBox.log of a running VM via 'showvminfo --log 0' ('' if unreadable)."""
    try:
        result = subprocess.run(
            [vboxmanage, 'showvminfo', vmname, '--log', '0'],
            check=False, capture_output=True, text=True)
    except (OSError, ValueError):
        return ''
    return result.stdout or ''


def assert_hwaccel(vmname, vboxmanage=VBOXMANAGE, timeout=30, interval=3):
    """After power-on, poll the VM log until HM reports its virtualization mode, then
    REQUIRE hardware acceleration -- raise HwAccelError (-> SETUP) if it is not AMD-V/
    VT-x, so a run that silently lost AMD-V can never masquerade as the fast path."""
    import time
    deadline = time.monotonic() + timeout
    log_text = ''
    while True:
        log_text = _vm_log_text(vmname, vboxmanage)
        low = log_text.lower()
        if any(k in low for k in ('hm:', 'nem:', 'hardware virtualization')):
            break
        if time.monotonic() >= deadline:
            break
        time.sleep(interval)
    if not hwaccel_in_use(log_text):
        raise HwAccelError(
            'VBox did not use AMD-V/VT-x hardware acceleration for %r'
            ' (KVM holding AMD-V, or nested virt off) -- refusing a degraded run'
            % (vmname,))


def start_vm(vmname, vboxmanage=VBOXMANAGE):
    """Real-host: free AMD-V for VirtualBox, boot the VM headless, then PROVE the
    boot is hardware-accelerated.

    The AMD-V prerequisite runs first so a loaded KVM never blocks power-on
    (VERR_SVM_IN_USE); a refused or failed prerequisite aborts the boot. After
    power-on assert_hwaccel confirms AMD-V/VT-x is actually in use (HwAccelError
    -> SETUP otherwise).
    """
    prereq_rc = ensure_amd_v_available()
    if prereq_rc != PASS_RC:
        raise RuntimeError(
            'AMD-V prerequisite for VirtualBox not satisfied (rc=%d)'
            % (prereq_rc,))
    _run(build_startvm_argv(vmname, vboxmanage))
    assert_hwaccel(vmname, vboxmanage)


def poll_screen_for(vmname, expect, *, timeout=240, interval=15, shot=None,
                    vboxmanage=VBOXMANAGE, tesseract=TESSERACT):
    """Poll the guest screen via OCR until EVERY expected string appears (PASS) or the
    timeout elapses (FAIL). The VM must ALREADY be running. GUI images have no serial,
    so the screen is the only readable boot signal. Returns (ok, png, ocr)."""
    import os
    import tempfile
    import time
    png = shot or os.path.join(tempfile.gettempdir(), 'dm-smbios-reader-vbox-%s.png' % (vmname,))
    deadline = time.monotonic() + timeout
    ocr = ''
    while time.monotonic() < deadline:
        time.sleep(interval)
        try:
            capture_screen(vmname, png, vboxmanage)
        except subprocess.CalledProcessError:
            ## the display can be briefly uncapturable early in boot -- retry next tick.
            continue
        ocr = run_ocr(png, tesseract)
        if all(ocr_text_contains(ocr, item) for item in expect):
            return True, png, ocr
    return False, png, ocr


def boot_and_verify(vmname, expect, *, timeout=240, interval=15, shot=None,
                    vboxmanage=VBOXMANAGE, tesseract=TESSERACT):
    """Real-host end-to-end: start the VM headless, then poll_screen_for the text."""
    start_vm(vmname, vboxmanage)
    return poll_screen_for(vmname, expect, timeout=timeout, interval=interval,
                           shot=shot, vboxmanage=vboxmanage, tesseract=tesseract)


def _poweroff_quietly(vmname):
    """Best-effort cleanup in a finally."""
    try:
        _run(build_poweroff_argv(vmname))
    except (subprocess.CalledProcessError, FileNotFoundError):
        ## the VM may already be off/gone, or VBoxManage missing -- not a failure.
        pass


def run_boot_test(args):
    """Real-host: optional import, boot, OCR-verify expected screen text, power off.

    The boot + OCR verify is wrapped so a tooling failure (e.g. tesseract missing)
    is a clean FAIL, and the VM is ALWAYS powered off (unless --no-poweroff) rather
    than left running after an exception."""
    try:
        require_vboxmanage()
    except SetupError as exc:
        print('dm-smbios-reader-vbox: %s' % (exc,), file=sys.stderr)
        return SETUP_RC
    if args.ova is not None:
        _run(build_import_argv(args.ova, args.vm))
    rc = FAIL_RC
    started = False
    try:
        start_vm(args.vm)
        started = True
        ok, png, ocr = poll_screen_for(
            args.vm, args.expect, timeout=args.timeout, interval=args.interval,
            shot=args.shot)
        print('dm-smbios-reader-vbox: screenshot %s' % (png,))
        if ok:
            print('dm-smbios-reader-vbox: PASS -- all expected text found: %s'
                  % (', '.join(args.expect),))
            rc = PASS_RC
        else:
            missing = [item for item in args.expect
                       if not ocr_text_contains(ocr, item)]
            print('dm-smbios-reader-vbox: FAIL -- missing after %ds: %s'
                  % (args.timeout, ', '.join(missing)), file=sys.stderr)
    except SetupError as exc:
        print('dm-smbios-reader-vbox: SETUP -- %s' % (exc,), file=sys.stderr)
        rc = SETUP_RC
    except (subprocess.CalledProcessError, FileNotFoundError, RuntimeError) as exc:
        print('dm-smbios-reader-vbox: FAIL -- boot/verify error: %s' % (exc,), file=sys.stderr)
    finally:
        ## power off ONLY the VM this run actually started, so a failed start of an
        ## already-running VM never hard-stops a VM this invocation did not create.
        if started and not args.no_poweroff:
            _poweroff_quietly(args.vm)
    return rc


def create_install_vm(vmname, iso, disk_path, *, firmware, memory, disk_mb,
                      vboxmanage=VBOXMANAGE):
    """Run the build_install_vm_plan argv sequence to register a fresh install VM."""
    for argv in build_install_vm_plan(vmname, iso, disk_path, firmware=firmware,
                                      memory=memory, disk_mb=disk_mb,
                                      vboxmanage=vboxmanage):
        _run(argv)


def run_install_test(args):
    """Real-host: build a fresh EFI VM booting the ISO against an empty target
    disk, then OCR-verify it reaches its live/installer screen. This is the
    runnable R3 precursor -- the unattended Calamares walk-through (drive_calamares
    below) builds on the booted live session it leaves behind."""
    import os
    import tempfile
    try:
        require_vboxmanage()
    except SetupError as exc:
        print('dm-smbios-reader-vbox: %s' % (exc,), file=sys.stderr)
        return SETUP_RC
    disk = args.disk or os.path.join(tempfile.gettempdir(), '%s.vdi' % (args.vm,))
    try:
        create_install_vm(args.vm, args.iso, disk, firmware=args.firmware,
                          memory=args.memory, disk_mb=args.disk_mb)
    except subprocess.CalledProcessError as exc:
        ## A VBoxManage build step failed (bad option, unsupported firmware, disk
        ## already exists) -- a SETUP error, reported cleanly, never a traceback
        ## and never a silent PASS.
        print('dm-smbios-reader-vbox: install VM build failed: %s' % (' '.join(exc.cmd),),
              file=sys.stderr)
        return SETUP_RC
    rc = FAIL_RC
    started = False
    try:
        start_vm(args.vm)
        started = True
        ok, png, ocr = poll_screen_for(
            args.vm, args.expect, timeout=args.timeout, interval=args.interval,
            shot=args.shot)
        print('dm-smbios-reader-vbox: screenshot %s' % (png,))
        if ok:
            print('dm-smbios-reader-vbox: PASS -- ISO booted to live/installer; found: %s'
                  % (', '.join(args.expect),))
            rc = PASS_RC
        else:
            missing = [item for item in args.expect
                       if not ocr_text_contains(ocr, item)]
            print('dm-smbios-reader-vbox: FAIL -- missing after %ds: %s'
                  % (args.timeout, ', '.join(missing)), file=sys.stderr)
    except SetupError as exc:
        print('dm-smbios-reader-vbox: SETUP -- %s' % (exc,), file=sys.stderr)
        rc = SETUP_RC
    except (subprocess.CalledProcessError, FileNotFoundError, RuntimeError) as exc:
        print('dm-smbios-reader-vbox: FAIL -- boot/verify error: %s' % (exc,), file=sys.stderr)
    finally:
        ## power off ONLY the VM this run actually started (see run_boot_test).
        if started and not args.no_poweroff:
            _poweroff_quietly(args.vm)
    return rc


def run_serial_up(args):
    """Real-host: build a VM wired for SERIAL driving, free AMD-V, boot headless and
    PROVE hardware acceleration, leaving it running with COM1 on a host UNIX socket
    for the dm-smbios-reader-image-test battery. exit 0 up / 2 setup / 5 fail.

    --emit-argv prints the VBoxManage build sequence (one command per line) without
    running it, so the plan is unit-testable without a VBox host."""
    plan = build_serial_vm_plan(
        args.vm, iso=args.iso, disk=args.disk, firmware=args.firmware,
        memory=args.memory, uart_socket=args.uart_socket,
        dmi_vendor=args.dmi_vendor, dmi_serial=args.smbios_serial)
    if args.emit_argv:
        for argv in plan:
            print(' '.join(argv))
        return PASS_RC
    try:
        require_vboxmanage()
    except SetupError as exc:
        print('dm-smbios-reader-vbox: %s' % (exc,), file=sys.stderr)
        return SETUP_RC
    try:
        for argv in plan:
            _run(argv)
    except subprocess.CalledProcessError as exc:
        print('dm-smbios-reader-vbox: serial VM build failed: %s'
              % (' '.join(exc.cmd),), file=sys.stderr)
        return SETUP_RC
    try:
        start_vm(args.vm)
    except SetupError as exc:
        print('dm-smbios-reader-vbox: SETUP -- %s' % (exc,), file=sys.stderr)
        _poweroff_quietly(args.vm)
        return SETUP_RC
    except (subprocess.CalledProcessError, FileNotFoundError, RuntimeError) as exc:
        print('dm-smbios-reader-vbox: FAIL -- serial boot failed: %s'
              % (exc,), file=sys.stderr)
        _poweroff_quietly(args.vm)
        return FAIL_RC
    ## Leave the VM RUNNING -- the caller drives the serial socket, then serial-down.
    print('dm-smbios-reader-vbox: serial-up %s listening on %s'
          % (args.vm, args.uart_socket))
    return PASS_RC


def run_serial_down(args):
    """Tear a serial VM down: hard power-off, unregister+delete (drops the per-VM
    differencing image a multiattach disk created), and remove the UART socket.
    Best-effort + idempotent -- a VM already gone is not an error."""
    try:
        require_vboxmanage()
    except SetupError as exc:
        print('dm-smbios-reader-vbox: %s' % (exc,), file=sys.stderr)
        return SETUP_RC
    _poweroff_quietly(args.vm)
    try:
        _run(build_unregister_argv(args.vm))
    except (subprocess.CalledProcessError, FileNotFoundError):
        ## already unregistered / never created / VBoxManage gone mid-teardown.
        pass
    if args.uart_socket:
        try:
            os.unlink(args.uart_socket)
        except OSError:
            pass
    return PASS_RC


## --- CLI --------------------------------------------------------------------

_EMIT_OPS = (
    'import', 'createvm', 'modifyvm', 'createmedium', 'storagectl',
    'storageattach', 'startvm', 'screenshot', 'keyboard', 'poweroff',
)


## Per-op flags that have no default and must be supplied for a usable argv;
## keyboard additionally needs one of --key/--text (handled below). Without
## this a missing flag would emit a literal 'None' into the argv (or crash),
## defeating the point of a byte-exact --emit-argv.
_EMIT_REQUIRED = {
    'import': ('ova',),
    'createmedium': ('medium',),
    'storageattach': ('medium',),
}


def _validate_emit_args(op, args):
    missing = ['--' + name for name in _EMIT_REQUIRED.get(op, ())
               if getattr(args, name) is None]
    if op == 'keyboard' and args.key is None and args.text is None:
        missing.append('--key or --text')
    if missing:
        raise ValueError('op %r needs %s' % (op, ', '.join(missing)))


def _emit_argv(args):
    """Build the argv for one op from CLI flags and return it (no execution)."""
    op = args.op
    _validate_emit_args(op, args)
    if op == 'import':
        return build_import_argv(args.ova, args.vm)
    if op == 'createvm':
        return build_createvm_argv(args.vm, args.ostype,
                                   basefolder=args.basefolder)
    if op == 'modifyvm':
        return build_modifyvm_argv(args.vm, memory=args.memory,
                                   firmware=args.firmware, nic=args.nic,
                                   intnet=args.intnet)
    if op == 'createmedium':
        return build_createmedium_argv(args.medium, args.size, fmt=args.format)
    if op == 'storagectl':
        return build_storagectl_argv(args.vm, args.controller, args.bus,
                                     args.controller_chip)
    if op == 'storageattach':
        return build_storageattach_argv(args.vm, args.controller, args.port,
                                        args.device, args.medium_type,
                                        args.medium)
    if op == 'startvm':
        return build_startvm_argv(args.vm)
    if op == 'screenshot':
        return build_screenshot_argv(args.vm, args.png)
    if op == 'keyboard':
        if args.key is not None:
            codes = encode_key(args.key)
        else:
            codes = encode_scancodes(args.text)
        return build_keyboard_argv(args.vm, codes)
    if op == 'poweroff':
        return build_poweroff_argv(args.vm)
    raise ValueError('unknown op %r' % (op,))


