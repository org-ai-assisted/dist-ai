## --- VBoxManage argv builders (pure) ----------------------------------------
## Each returns the argv list VirtualBox would run. A --emit-argv CLI mode
## prints them without executing, mirroring dm-smbios-reader-qemu --emit-argv, so the RUN
## path stays a thin subprocess.run over a separately-tested argv.

## Harness firmware name -> VBoxManage --firmware value. SecureBoot is NOT a
## --firmware/modifyvm setting in VBox 7.x (modifyvm has no --secure-boot option);
## it is enabled per-VM through the NVRAM UEFI variable store -- see
## build_secureboot_plan, spliced into build_install_vm_plan for efi-secureboot.
_FIRMWARE = {
    'bios': 'bios',
    'efi': 'efi',
    'efi-secureboot': 'efi',
}


def build_import_argv(ova, vmname, vboxmanage=VBOXMANAGE):
    """Import a distributed .ova as a named VM (the what-users-run path)."""
    return [vboxmanage, 'import', ova, '--vsys', '0', '--vmname', vmname]


def build_createvm_argv(vmname, ostype, basefolder=None, vboxmanage=VBOXMANAGE):
    """Register a fresh empty VM (for the ISO -> Calamares -> HDD path)."""
    argv = [vboxmanage, 'createvm', '--name', vmname, '--ostype', ostype,
            '--register']
    if basefolder is not None:
        argv += ['--basefolder', basefolder]
    return argv


def build_modifyvm_argv(vmname, *, memory=None, firmware=None, nic=None,
                        intnet=None, graphicscontroller=None, vram=None,
                        mouse=None, usb=None, vboxmanage=VBOXMANAGE):
    """Set memory, firmware/SecureBoot, networking, graphics and pointer on a VM.

    intnet wins over nic: a per-Linux-user-unique internal network name is how
    the Whonix pair (GW+WS) is isolated without a host-global collision.

    graphicscontroller/vram matter for a GUI guest read headlessly: the stock
    controller + tiny default VRAM starve a desktop session, so it renders only
    a blank wallpaper (no panel, no installer) in the software framebuffer --
    vmsvga + 128 MiB lets the LXQt desktop and Calamares actually draw.

    mouse='usbtablet' + a USB controller (usb='ohci'/'xhci') give the guest an
    ABSOLUTE pointer, which is what the host-side IMouse.putMouseEventAbsolute
    (vboxapi) drive needs to click GUI widgets by screenshot pixel coordinate
    WITHOUT Guest Additions -- the low-mental-load alternative to blind Tab-key
    navigation for form pages (Calamares LUKS passphrase, user creation).
    """
    argv = [vboxmanage, 'modifyvm', vmname]
    if memory is not None:
        argv += ['--memory', str(memory)]
    if firmware is not None:
        argv += ['--firmware', _FIRMWARE[firmware]]
    if graphicscontroller is not None:
        argv += ['--graphicscontroller', graphicscontroller]
    if vram is not None:
        argv += ['--vram', str(vram)]
    if mouse is not None:
        argv += ['--mouse', mouse]
    if usb is not None:
        argv += ['--usb-' + usb, 'on']
    if intnet is not None:
        argv += ['--nic1', 'intnet', '--intnet1', intnet]
    elif nic is not None:
        argv += ['--nic1', nic]
    return argv


def build_createmedium_argv(path, size_mb, fmt='VDI', vboxmanage=VBOXMANAGE):
    """Create an empty virtual disk to install onto."""
    return [vboxmanage, 'createmedium', 'disk', '--filename', path,
            '--size', str(size_mb), '--format', fmt]


def build_storagectl_argv(vmname, name, bus, controller, vboxmanage=VBOXMANAGE):
    """Add a storage controller (e.g. bus 'sata', controller 'IntelAhci')."""
    return [vboxmanage, 'storagectl', vmname, '--name', name, '--add', bus,
            '--controller', controller]


def build_storageattach_argv(vmname, controller, port, device, medium_type,
                             medium, mtype=None, vboxmanage=VBOXMANAGE):
    """Attach a medium (medium_type 'dvddrive' for an ISO, 'hdd' for a disk).

    mtype='multiattach' boots a disk NON-destructively: VBox keeps the base disk
    read-only and writes to a per-VM differencing image -- the VBox equivalent of
    qemu's -snapshot -- so a serial boot test never mutates the source image."""
    argv = [vboxmanage, 'storageattach', vmname, '--storagectl', controller,
            '--port', str(port), '--device', str(device),
            '--type', medium_type, '--medium', medium]
    if mtype is not None:
        argv += ['--mtype', mtype]
    return argv


def build_startvm_argv(vmname, vboxmanage=VBOXMANAGE):
    """Boot the VM headless -- no host display server needed."""
    return [vboxmanage, 'startvm', vmname, '--type', 'headless']


def build_screenshot_argv(vmname, png, vboxmanage=VBOXMANAGE):
    """Capture the guest framebuffer to a PNG."""
    return [vboxmanage, 'controlvm', vmname, 'screenshotpng', png]


def build_keyboard_argv(vmname, codes, vboxmanage=VBOXMANAGE):
    """Inject a scancode sequence (from encode_scancodes / encode_key)."""
    return [vboxmanage, 'controlvm', vmname, 'keyboardputscancode', *codes]


def build_poweroff_argv(vmname, vboxmanage=VBOXMANAGE):
    """Hard power-off the VM."""
    return [vboxmanage, 'controlvm', vmname, 'poweroff']


def build_unregister_argv(vmname, vboxmanage=VBOXMANAGE):
    """Unregister the VM and DELETE its settings + created media (serial-down)."""
    return [vboxmanage, 'unregistervm', vmname, '--delete']


## COM1 at the standard ttyS0 I/O base + IRQ; 'server <path>' makes VBox listen on
## a host UNIX domain socket (Linux) the driver connects to as a client. This is the
## serial console the dm-smbios-reader-image-test serial battery drives, the VBox
## analogue of qemu's -serial -- GUI images have no console, but a UART does.
def build_uart_server_argv(vmname, sock, vboxmanage=VBOXMANAGE):
    """modifyvm argv wiring COM1 to a host UNIX-socket server for serial driving."""
    return [vboxmanage, 'modifyvm', vmname,
            '--uart1', '0x3f8', '4', '--uartmode1', 'server', sock]


## DMI (SMBIOS) overrides via the pcbios extradata keys. The in-image GRUB reader
## appends the Type-1 system serial's 'dm-cmdline=' remainder to the kernel line,
## but ONLY when the Type-1 manufacturer reads 'QEMU' -- so a VBox guest must
## advertise vendor=QEMU for the reader to fire (same cmdline-injection chain the
## qemu backend uses; dm-smbios-reader-qemu --emit-cmdline is the shared payload).
##
## The DMI override DEVICE differs by firmware: the BIOS path builds its SMBIOS via
## the 'pcbios' device, the EFI path via the 'efi' device. This is NOT cosmetic --
## setting pcbios keys on an EFI VM force-instantiates the pcbios device, whose init
## then FAILS querying BootDevice0 (VERR_CFGM_VALUE_NOT_FOUND), so power-on dies
## before DMI ever reaches the guest.
## VERIFIED on VBox 7.2 (server integration): efi-device keys power an EFI/efi-secureboot
## VM on cleanly; pcbios keys refuse it. A wrong/no-op device path surfaces as the
## dm-smbios-reader-image-test 0-byte-serial-log FAIL (reader never fired).
_DMI_DEVICE = {'bios': 'pcbios', 'efi': 'efi', 'efi-secureboot': 'efi'}


def _dmi_keys(firmware):
    """(vendor_key, serial_key) for the DMI override device of FIRMWARE."""
    base = 'VBoxInternal/Devices/%s/0/Config/' % _DMI_DEVICE[firmware]
    return base + 'DmiSystemVendor', base + 'DmiSystemSerial'


def build_dmi_argv(vmname, vendor, serial, firmware='bios', vboxmanage=VBOXMANAGE):
    """Ordered setextradata argv pair setting the Type-1 DMI vendor + serial on the
    firmware-appropriate device (pcbios for BIOS, efi for EFI / efi-secureboot).

    Unlike qemu's -smbios, setextradata takes the value verbatim, so the serial
    carries SINGLE commas (no doubling) -- pass dm-smbios-reader-qemu
    --emit-cmdline output as-is."""
    vendor_key, serial_key = _dmi_keys(firmware)
    return [
        [vboxmanage, 'setextradata', vmname, vendor_key, vendor],
        [vboxmanage, 'setextradata', vmname, serial_key, serial],
    ]


def build_secureboot_plan(vmname, vboxmanage=VBOXMANAGE):
    """Ordered VBoxManage argv to turn SecureBoot ON for an EFI VM (VBox 7.x).

    modifyvm has NO --secure-boot in 7.x; SecureBoot lives in the per-VM NVRAM
    UEFI variable store. Sequence: initialise the var store, enroll the Oracle
    platform key (PK) and the Microsoft KEK+db signatures (a distro's MS-signed
    shim needs the MS db), then enable SecureBoot. The VM must already exist with
    --firmware efi (build_install_vm_plan runs createvm+modifyvm first)."""
    nvram = [vboxmanage, 'modifynvram', vmname]
    return [
        nvram + ['inituefivarstore'],
        nvram + ['enrollorclpk'],
        nvram + ['enrollmssignatures'],
        nvram + ['secureboot', '--enable'],
    ]


def build_install_vm_plan(vmname, iso, disk_path, *, firmware='efi-secureboot',
                          memory=4096, disk_mb=25600, ostype='Debian_64',
                          vboxmanage=VBOXMANAGE):
    """Ordered VBoxManage argv to build a fresh VM that boots an ISO against an
    EMPTY target disk -- the ISO -> Calamares -> HDD path (R3/R4/R7).

    Layout: the target disk on a SATA (AHCI) controller at port 0; the ISO as a
    dvddrive on a separate IDE controller. EFI (optionally SecureBoot) is the
    ISO gate firmware; with an empty target disk the EFI firmware falls through
    to the El Torito DVD, so no explicit boot-order flag is needed. NAT gives the
    live session / installer the network the checks (4: networking) require.

    For firmware='efi-secureboot' the NVRAM SecureBoot-enrollment steps are
    spliced in after the VM exists with EFI firmware but before it boots."""
    plan = [
        build_createvm_argv(vmname, ostype, vboxmanage=vboxmanage),
        build_modifyvm_argv(vmname, memory=memory, firmware=firmware,
                            nic='nat', graphicscontroller='vmsvga', vram=128,
                            mouse='usbtablet', usb='ohci',
                            vboxmanage=vboxmanage),
    ]
    if firmware == 'efi-secureboot':
        plan += build_secureboot_plan(vmname, vboxmanage=vboxmanage)
    plan += [
        build_createmedium_argv(disk_path, disk_mb, vboxmanage=vboxmanage),
        build_storagectl_argv(vmname, 'SATA', 'sata', 'IntelAhci',
                              vboxmanage=vboxmanage),
        build_storagectl_argv(vmname, 'IDE', 'ide', 'PIIX4',
                              vboxmanage=vboxmanage),
        build_storageattach_argv(vmname, 'SATA', 0, 0, 'hdd', disk_path,
                                 vboxmanage=vboxmanage),
        build_storageattach_argv(vmname, 'IDE', 0, 0, 'dvddrive', iso,
                                 vboxmanage=vboxmanage),
    ]
    return plan


## VBox storageattach --type hdd accepts only VBox-native disk formats (VDI/VMDK/VHD);
## a RAW or qcow2 image is rejected (VERR_VD_RAW_INVALID_TYPE / unsupported format).
## derivative-maker builds qcow2/raw, so the serial-disk path CONVERTS to a throwaway
## per-VM VDI first: raw via VBoxManage convertfromraw (native), qcow2 via qemu-img (a
## hard dep for THAT format -- fail loud if absent). The qcow2 convert pins an explicit
## input format (no qemu-img format probe) and the run path REFUSES a qcow2 that points at
## an external file -- a backing chain or a qcow2v3 external data file -- which qemu-img
## convert would otherwise flatten (an operator-only file's bytes) into the output VDI.
## The converted VDI is removed on serial-down. A native VDI/VMDK/VHD is attached as-is
## (multiattach, non-destructive).
_DISK_NATIVE_EXTS = ('.vdi', '.vmdk', '.vhd')


def _converted_vdi_dir():
    """Path of the owner-only directory for converted throwaway VDIs (PURE -- no side
    effect, so --emit-argv and serial-down stay side-effect-free). The create+verify
    is _ensure_converted_vdi_dir, called only on the convert run path."""
    import tempfile
    return os.path.join(tempfile.gettempdir(),
                        'dm-smbios-reader-vbox-%d' % (os.getuid(),))


def _ensure_converted_vdi_dir():
    """Create the converted-VDI dir 0700 and REQUIRE it to be our own owner-only
    directory: NOT world-readable (a converted copy can hold sensitive image data),
    and no other local user can pre-plant a symlink at the predictable per-VM path
    inside it. Side effect -- call on the convert run path, never from the pure plan."""
    import stat
    path = _converted_vdi_dir()
    os.makedirs(path, mode=0o700, exist_ok=True)
    info = os.lstat(path)
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid()
            or stat.S_IMODE(info.st_mode) != 0o700):
        raise SetupError('converted-VDI dir %r is not an owner-only directory'
                         % (path,))
    return path


def converted_disk_path(vmname):
    """Per-VM converted-VDI path inside the owner-only dir (PURE). basename(vmname) so
    an absolute or traversing --vm (e.g. serial-down --vm /home/x/important) cannot
    make os.path.join escape the dir and delete a caller-named file."""
    return os.path.join(_converted_vdi_dir(),
                        '%s.dm-converted.vdi' % (os.path.basename(vmname),))


def _assert_no_external_refs(src):
    """Refuse a qcow2 that points at ANY external file -- a backing chain OR a qcow2v3
    external data file. qemu-img convert reads both INTO the output VDI, so a supplied
    image referencing an operator-only file would copy that file's bytes into the
    converted image. A dm-built image is a self-contained qcow2 (no backing, no external
    data file), so this never rejects a legitimate disk. Reads the header with an explicit
    -f (no format probe); any external reference OR a failure to read the header is
    fail-closed -> SetupError. Side effect: reads src. Run path only.

    An attacker who could atomically swap `src` between this read and the convert is OUT
    of scope (trusted-operator --disk path; the boundary is untrusted image CONTENT, not a
    concurrent local file-swap race)."""
    import json
    try:
        out = subprocess.check_output(
            [QEMU_IMG, 'info', '--output=json', '-f', 'qcow2', src],
            stderr=subprocess.STDOUT)
    except subprocess.CalledProcessError as exc:
        raise SetupError('cannot read qcow2 header of %r (refusing to convert): %s'
                         % (src, exc))
    info = json.loads(out)
    ref = (info.get('backing-filename') or info.get('full-backing-filename')
           or info.get('format-specific', {}).get('data', {}).get('data-file'))
    if ref:
        raise SetupError(
            'refusing to convert %r: it references external file %r; qemu-img convert'
            ' would merge that file into the output VDI' % (src, ref))


def disk_conversion(disk, vmname, vboxmanage=VBOXMANAGE):
    """(attach_path, convert_argv) for attaching DISK to a serial VM. Native
    VDI/VMDK/VHD -> (disk, None). RAW/qcow2 -> (per-VM VDI, the convert command run at
    serial-up time, NOT part of the pure plan). Unknown extension -> SetupError.

    The source path is made ABSOLUTE so a legitimate name beginning with '-'
    (e.g. './-n.qcow2') cannot be parsed as a qemu-img / VBoxManage option."""
    ext = os.path.splitext(disk)[1].lower()
    if ext in _DISK_NATIVE_EXTS:
        return os.path.abspath(disk), None
    src = os.path.abspath(disk)
    dst = converted_disk_path(vmname)
    if ext in ('.raw', '.img'):
        return dst, [vboxmanage, 'convertfromraw', src, dst, '--format', 'VDI']
    if ext == '.qcow2':
        return dst, [QEMU_IMG, 'convert', '-f', 'qcow2', '-O', 'vdi', src, dst]
    raise SetupError(
        'unsupported --disk format %r for the VBox backend: pass VDI/VMDK/VHD, or'
        ' .raw/.img/.qcow2 (auto-converted to VDI)' % (ext or disk,))


def build_serial_vm_plan(vmname, *, iso=None, disk=None, firmware='efi',
                         memory=3072, uart_socket, dmi_vendor, dmi_serial,
                         ostype='Debian_64', vboxmanage=VBOXMANAGE):
    """Ordered VBoxManage argv to build a fresh VM that boots media over a SERIAL
    console for the dm-smbios-reader-image-test battery -- headless + no network,
    like the qemu backend's serial leg (GUI/graphics/NIC are deliberately omitted).

    Exactly one of iso/disk: an ISO boots live off a dvddrive; a disk image boots
    through firmware off a SATA hdd attached --mtype multiattach (non-destructive,
    the -snapshot analogue). DMI advertises vendor=QEMU + the dm-cmdline serial so
    the in-image GRUB reader injects the kernel cmdline, and COM1 is wired to a host
    UNIX socket the driver connects to. SecureBoot is enrolled for efi-secureboot.

    DISK is expected to be a VBox-native format here (VDI/VMDK/VHD) -- storageattach
    --type hdd rejects RAW/qcow2 (VERR_VD_RAW_INVALID_TYPE). run_serial_up converts a
    raw/qcow2 --disk to a throwaway VDI (disk_conversion) BEFORE building this plan and
    passes the VDI path, so a derivative-maker qcow2/raw image is accepted; multiattach
    then keeps that VDI non-destructive."""
    if (iso is None) == (disk is None):
        raise ValueError('build_serial_vm_plan needs exactly one of iso/disk')
    plan = [
        build_createvm_argv(vmname, ostype, vboxmanage=vboxmanage),
        build_modifyvm_argv(vmname, memory=memory, firmware=firmware,
                            vboxmanage=vboxmanage),
    ]
    if firmware == 'efi-secureboot':
        plan += build_secureboot_plan(vmname, vboxmanage=vboxmanage)
    plan += build_dmi_argv(vmname, dmi_vendor, dmi_serial, firmware=firmware,
                           vboxmanage=vboxmanage)
    plan.append(build_uart_server_argv(vmname, uart_socket, vboxmanage=vboxmanage))
    if disk is not None:
        plan += [
            build_storagectl_argv(vmname, 'SATA', 'sata', 'IntelAhci',
                                  vboxmanage=vboxmanage),
            build_storageattach_argv(vmname, 'SATA', 0, 0, 'hdd', disk,
                                     mtype='multiattach', vboxmanage=vboxmanage),
        ]
    else:
        plan += [
            build_storagectl_argv(vmname, 'IDE', 'ide', 'PIIX4',
                                  vboxmanage=vboxmanage),
            build_storageattach_argv(vmname, 'IDE', 0, 0, 'dvddrive', iso,
                                     vboxmanage=vboxmanage),
        ]
    return plan


## --- AMD-V availability for VirtualBox (pure decision) -----------------------
## On an AMD host the KVM modules (kvm_amd + kvm) own AMD-V (SVM) exclusively,
## so VirtualBox cannot power on a VM while they are loaded -- power-on fails
## with VERR_SVM_IN_USE. Freeing AMD-V means unloading + blacklisting KVM, but
## NEVER while a KVM VM is still running. These pure helpers decide the action
## from /proc state; the privileged step is deferred to ensure_amd_v_available.

## Blacklist so KVM stays out across reboots (VirtualBox owns AMD-V here).
BLACKLIST_PATH = '/etc/modprobe.d/blacklist-kvm-for-vbox.conf'
BLACKLIST_CONTENT = (
    '## VirtualBox is the image-test hypervisor here; KVM must not hold AMD-V.\n'
    'blacklist kvm_amd\n'
    'blacklist kvm\n')

## Unload order is vendor-first: kvm_amd depends on kvm.
KVM_MODULES = ('kvm_amd', 'kvm')
## A running VM holds a nonzero refcount on the loaded vendor module.
_VENDOR_MODULES = ('kvm_amd', 'kvm_intel')

## amd_v_plan outcomes.
AMD_V_NOOP = 'noop'
AMD_V_REFUSE = 'refuse'
AMD_V_UNLOAD = 'unload'


def cpu_is_amd(cpuinfo_text):
    """True when /proc/cpuinfo reports an AMD CPU (AMD-V/SVM territory)."""
    for line in cpuinfo_text.splitlines():
        if line.startswith('vendor_id') and 'AuthenticAMD' in line:
            return True
    return False


def parse_module_refcounts(proc_modules_text):
    """Map module name -> reference count from /proc/modules text.

    The third field is the use count -- the same value as
    /sys/module/NAME/refcnt. A nonzero count on a vendor module (kvm_amd) means
    a VM is holding it.
    """
    refcounts = {}
    for line in proc_modules_text.splitlines():
        fields = line.split()
        if len(fields) >= 3:
            try:
                refcounts[fields[0]] = int(fields[2])
            except ValueError:
                ## a non-numeric refcount field is a malformed/header line -- skip it.
                continue
    return refcounts


def kvm_vm_running(refcounts):
    """True when a KVM VM is in use -- refuse to yank AMD-V from under it."""
    vendor = [name for name in _VENDOR_MODULES if name in refcounts]
    if vendor:
        return any(refcounts[name] > 0 for name in vendor)
    return refcounts.get('kvm', 0) > 0


def amd_v_plan(is_amd, refcounts):
    """Decide the AMD-V action from host state. Returns (outcome, message)."""
    if not is_amd:
        return (AMD_V_NOOP,
                'host is not AMD; the KVM/VirtualBox AMD-V conflict does not '
                'apply')
    loaded = [name for name in KVM_MODULES if name in refcounts]
    if not loaded:
        return (AMD_V_NOOP,
                'no KVM module loaded; AMD-V is already free for VirtualBox')
    if kvm_vm_running(refcounts):
        return (AMD_V_REFUSE,
                'a KVM VM is running (nonzero module refcount); refusing to '
                'unload KVM and take AMD-V from it')
    return (AMD_V_UNLOAD,
            'unloading KVM and blacklisting it so VirtualBox owns AMD-V')


def sudo_prefix(euid):
    """Privileged-run prefix: empty when already root, sudo otherwise."""
    if euid == 0:
        return []
    return ['sudo', '--non-interactive']


def build_modprobe_remove_argv(loaded, euid):
    """Privileged argv to remove the loaded KVM modules (vendor first)."""
    modules = [name for name in KVM_MODULES if name in loaded]
    return sudo_prefix(euid) + ['modprobe', '--remove', '--', *modules]


## --- keyboard scancode encoding (pure) --------------------------------------
## US layout, AT/PS-2 scancode set 1 (a.k.a. XT). Each key has a one-byte MAKE
## code (key down); the BREAK code (key up) is make | 0x80. VirtualBox's
## keyboardputscancode consumes these bytes as lowercase hex strings. Extended
## keys (arrows) are prefixed with 0xe0. This is what types a LUKS passphrase.

_MAKE = {
    '`': 0x29, '1': 0x02, '2': 0x03, '3': 0x04, '4': 0x05, '5': 0x06,
    '6': 0x07, '7': 0x08, '8': 0x09, '9': 0x0a, '0': 0x0b, '-': 0x0c,
    '=': 0x0d,
    'q': 0x10, 'w': 0x11, 'e': 0x12, 'r': 0x13, 't': 0x14, 'y': 0x15,
    'u': 0x16, 'i': 0x17, 'o': 0x18, 'p': 0x19, '[': 0x1a, ']': 0x1b,
    '\\': 0x2b,
    'a': 0x1e, 's': 0x1f, 'd': 0x20, 'f': 0x21, 'g': 0x22, 'h': 0x23,
    'j': 0x24, 'k': 0x25, 'l': 0x26, ';': 0x27, "'": 0x28,
    'z': 0x2c, 'x': 0x2d, 'c': 0x2e, 'v': 0x2f, 'b': 0x30, 'n': 0x31,
    'm': 0x32, ',': 0x33, '.': 0x34, '/': 0x35,
    ' ': 0x39,
}

## Shifted printable -> the unshifted key whose scancode yields it with Shift.
_SHIFTED = {
    '~': '`', '!': '1', '@': '2', '#': '3', '$': '4', '%': '5', '^': '6',
    '&': '7', '*': '8', '(': '9', ')': '0', '_': '-', '+': '=',
    '{': '[', '}': ']', '|': '\\',
    ':': ';', '"': "'",
    '<': ',', '>': '.', '?': '/',
}

_LSHIFT = 0x2a

## Named non-printable keys; _NAMED_EXT keys are E0-prefixed (extended).
_NAMED = {
    'enter': 0x1c, 'esc': 0x01, 'backspace': 0x0e, 'tab': 0x0f, 'space': 0x39,
}
_NAMED_EXT = {
    'up': 0x48, 'down': 0x50, 'left': 0x4b, 'right': 0x4d,
}


def _hex(code):
    return format(code, '02x')


def _press(code):
    return [_hex(code), _hex(code | 0x80)]


def _press_shift(code):
    ## Shift down, key down, key up, Shift up.
    return [_hex(_LSHIFT), _hex(code), _hex(code | 0x80), _hex(_LSHIFT | 0x80)]


def encode_char(ch):
    """Scancode bytes (make+break) for a single printable character."""
    if ch in _MAKE:
        return _press(_MAKE[ch])
    if ch.isalpha() and ch.lower() in _MAKE:
        return _press_shift(_MAKE[ch.lower()])
    if ch in _SHIFTED:
        return _press_shift(_MAKE[_SHIFTED[ch]])
    raise ValueError('no scancode for character %r' % (ch,))


def encode_scancodes(text):
    """Scancode bytes to type a literal string (no trailing Enter)."""
    codes = []
    for ch in text:
        codes.extend(encode_char(ch))
    return codes


def encode_key(name):
    """Scancode bytes for a named key (enter, esc, tab, arrows, ...)."""
    key = name.lower()
    if key in _NAMED:
        return _press(_NAMED[key])
    if key in _NAMED_EXT:
        code = _NAMED_EXT[key]
        return ['e0', _hex(code), 'e0', _hex(code | 0x80)]
    raise ValueError('unknown named key %r' % (name,))


def encode_passphrase(passphrase):
    """Type a LUKS/login passphrase and press Enter -- the unlock-prompt step."""
    return encode_scancodes(passphrase) + encode_key('enter')


## --- screen matching (pure; Pillow required, imagehash optional) ------------

def image_diff_ratio(path_a, path_b):
    """Mean per-channel absolute pixel difference, normalised to [0, 1].

    0.0 == identical. Candidate is resized to the baseline when the geometry
    differs, so a resolution change alone does not force a mismatch.
    """
    base = Image.open(path_a).convert('RGB')
    cand = Image.open(path_b).convert('RGB')
    if cand.size != base.size:
        cand = cand.resize(base.size)
    diff = ImageChops.difference(base, cand)
    means = ImageStat.Stat(diff).mean
    return sum(means) / (len(means) * 255.0)


def screen_matches(path, baseline, tol=0.05):
    """True when the screenshot is within tol (default 5%) of the baseline.

    Tolerant on purpose: font anti-aliasing and cursor blink jitter a few
    percent between otherwise-identical desktops.
    """
    return image_diff_ratio(path, baseline) <= tol


def phash_distance(path_a, path_b):
    """Perceptual-hash (pHash) Hamming distance -- layout-shift signal.

    imagehash is an opt-in/pip dependency (not apt-packaged), matching
    mediawiki-dom-snapshot; imported lazily so this module loads without it.
    """
    import imagehash  ## optional dependency -- see docstring
    return imagehash.phash(Image.open(path_a)) - imagehash.phash(
        Image.open(path_b))


## --- OCR decision (pure) + invocation (deferred) ----------------------------

def _normalise_ocr(text):
    return ' '.join(text.lower().split())


def ocr_text_contains(ocr_output, expected):
    """True when every expected marker appears in OCR output (case/space-fuzzy).

    expected is a string or a list of strings. Kept separate from run_ocr so
    the decision is unit-testable without tesseract installed.
    """
    haystack = _normalise_ocr(ocr_output)
    if isinstance(expected, str):
        expected = [expected]
    return all(_normalise_ocr(item) in haystack for item in expected)


def run_ocr(png, tesseract=TESSERACT):
    ## DEFERRED (real host): needs tesseract-ocr. Not exercised by CI.
    result = subprocess.run([tesseract, png, 'stdout'],
                            capture_output=True, text=True, check=True)
    return result.stdout


## --- Calamares step sequencing (pure) ---------------------------------------
## The installer is a fixed page order. The driver walks this sequence: at each
## page it confirms `expect` on screen (OCR) then performs `action`. Only the
## partition page and the optional encryption step differ between an empty-disk
## install and a reinstall-over-existing (R7).

Step = collections.namedtuple('Step', ('name', 'expect', 'action'))

_INSTALL_MODES = ('erase', 'replace')


def calamares_step_sequence(mode, encrypt=False):
    """Ordered (name, expect, action) steps for a Calamares run.

    mode='erase'   -> wipe the whole disk (empty-disk install).
    mode='replace' -> reinstall over an existing install (R7).
    encrypt=True   -> insert the LUKS passphrase-entry step (secure default).
    """
    if mode not in _INSTALL_MODES:
        raise ValueError('install mode must be one of %r, got %r'
                         % (_INSTALL_MODES, mode))
    steps = [
        Step('welcome', 'welcome', 'key:enter'),
        Step('location', 'location', 'key:enter'),
        Step('keyboard', 'keyboard', 'key:enter'),
    ]
    if mode == 'erase':
        steps.append(Step('partition', 'erase disk', 'select:erase'))
    else:
        steps.append(Step('partition', 'replace a partition',
                          'select:replace'))
    if encrypt:
        steps.append(Step('encrypt', 'encrypt system', 'type:passphrase'))
    steps += [
        Step('users', 'user', 'fill:users'),
        Step('summary', 'summary', 'key:enter'),
        Step('install', 'installation', 'wait:install'),
        Step('finish', 'finished', 'key:enter'),
    ]
    return steps


