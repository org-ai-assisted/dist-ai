def _cmd_capabilities():
    import importlib.util
    import shutil
    have_vbox = shutil.which(VBOXMANAGE) is not None
    have_tesseract = shutil.which(TESSERACT) is not None
    have_imagehash = importlib.util.find_spec('imagehash') is not None
    print('VBoxManage: %s' % ('yes' if have_vbox else 'no'))
    print('tesseract:  %s' % ('yes' if have_tesseract else 'no'))
    print('imagehash:  %s' % ('yes' if have_imagehash else 'no'))
    return PASS_RC


def _cmd_verify(args):
    from pathlib import Path
    for label, path in (('baseline', args.baseline), ('screenshot', args.shot)):
        if not Path(path).is_file():
            print('dm-smbios-reader-vbox: %s not found: %s' % (label, path), file=sys.stderr)
            return SETUP_RC
    ratio = image_diff_ratio(args.baseline, args.shot)
    matched = ratio <= args.tol
    print('dm-smbios-reader-vbox: render diff %.4f (tol %.4f) vs %s: %s'
          % (ratio, args.tol, Path(args.baseline).name,
             'MATCH' if matched else 'MISMATCH'))
    if not matched:
        return FAIL_RC
    if args.expect:
        text = run_ocr(args.shot)
        if not ocr_text_contains(text, args.expect):
            print('dm-smbios-reader-vbox: expected text missing from shot: %s'
                  % (args.expect,), file=sys.stderr)
            return FAIL_RC
    return PASS_RC


def main(argv=None):
    args = _build_parser().parse_args(argv)
    if args.cmd == 'emit-argv':
        try:
            tokens = _emit_argv(args)
        except ValueError as exc:
            ## Bad/missing CLI input is a SETUP error, not a traceback (exit 1)
            ## and never a silent PASS with 'None' in the argv.
            print('dm-smbios-reader-vbox: %s' % (exc,), file=sys.stderr)
            return SETUP_RC
        for token in tokens:
            print(token)
        return PASS_RC
    if args.cmd == 'capabilities':
        return _cmd_capabilities()
    if args.cmd == 'ensure-amd-v':
        return ensure_amd_v_available()
    if args.cmd == 'run':
        return run_boot_test(args)
    if args.cmd == 'install':
        return run_install_test(args)
    if args.cmd == 'serial-up':
        return run_serial_up(args)
    if args.cmd == 'serial-down':
        return run_serial_down(args)
    if args.cmd == 'verify':
        return _cmd_verify(args)
    return SETUP_RC


if __name__ == '__main__':
    sys.exit(main())
