## AI-Assisted

## Shared checker: a session script's do_once block must not stop the session
## from starting when HOME is unwritable.
##
## THE BUG: both session scripts create ~/.local/share/kicksecure/do_once to
## mark a COSMETIC one-time speaker-volume tweak. Under errexit an unguarded
## mkdir there aborted BEFORE the session handoff, so a read-only, full or
## wrongly owned home meant the user could not log in at all.
##
## Two components ship such a script, so the logic lives here and each
## component's suite calls it with its own subject. That keeps one copy of the
## reasoning rather than two that drift.
##
## Usage: session-do-once-check <path-to-session-script> <label>
## Exits 77 when the subject does not exist.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

[ -v TMP ] || TMP=/tmp

subject="${1:?usage: session-do-once-check <session-script> <label>}"
label="${2:?usage: session-do-once-check <session-script> <label>}"

if [ ! -r "${subject}" ]; then
   printf '%s\n' "SKIP: ${label}: no session script at '${subject}'" >&2
   exit 77
fi

## The do_once block is lifted out by anchor. If the anchor stops matching, the
## extraction yields NOTHING, the driver runs clean, and both cases below pass
## while testing no code at all.
if ! grep --quiet -- '^do_once_dir=' "${subject}"; then
   printf '%s\n' "FATAL: ${label}: no 'do_once_dir=' block in '${subject}'" >&2
   printf '%s\n' "the extraction anchor no longer matches; this test would pass vacuously" >&2
   exit 1
fi

work_dir="$(mktemp --directory -- "${TMP}/session-do-once.XXXXXX")"

check_cleanup_handler() {
   chmod --recursive u+rwX -- "${work_dir}" 2>/dev/null || true
   safe-rm --recursive --force -- "${work_dir}"
}

trap check_cleanup_handler EXIT

pass_count=0
fail_count=0

## SC2016: the driver body below is LITERAL code written into a file.
# shellcheck disable=SC2016
run_do_once() {
   local home_mode base home output

   home_mode="$1"
   base="${work_dir}/case"
   chmod --recursive u+rwX -- "${base}" 2>/dev/null || true
   safe-rm --recursive --force -- "${base}"
   home="${base}/home"
   mkdir --parents -- "${home}"

   {
      printf '%s\n' '#!/bin/bash'
      printf '%s\n' 'set -o errexit' 'set -o nounset' 'set -o pipefail' \
         'set -o errtrace' 'shopt -s inherit_errexit'
      ## pactl absent -> the inner block is skipped; the mkdir is what matters.
      printf '%s\n' 'has() { [ -n "$(type -t "$1")" ]; }'
      printf '%s\n' 'try_wait_for_audio_ready() { true; }'
      sed -n '/^do_once_dir=/,/^fi$/p' "${subject}"
      ## Stands in for the session handoff that follows the block. Reaching it
      ## is the property: the user logs in.
      printf '%s\n' 'printf "%s\n" "SESSION_HANDOFF_REACHED"'
   } >"${base}/driver"

   chmod "${home_mode}" -- "${home}"
   output="$( HOME="${home}" timeout 20 bash "${base}/driver" 2>&1 )" || true
   chmod 0755 -- "${home}" 2>/dev/null || true
   printf '%s' "${output}"
}

check() {
   local description home_mode output

   description="$1"
   home_mode="$2"
   output="$(run_do_once "${home_mode}")"

   if printf '%s\n' "${output}" | grep --fixed-strings -- 'SESSION_HANDOFF_REACHED' >/dev/null; then
      pass_count=$(( pass_count + 1 ))
      printf '%s\n' "PASS: ${label}: ${description}"
   else
      fail_count=$(( fail_count + 1 ))
      printf '%s\n' "FAIL: ${label}: ${description}: the session handoff was never reached"
      printf '%s\n' "  output: $(printf '%s' "${output}" | tr '\n' '|' | head -c 200)"
   fi
}

## The ordinary case, so a script that never reaches the handoff at all cannot
## pass the case below by accident.
check 'a writable home still reaches the session handoff' 0755
## The case the fix is about.
check 'an UNWRITABLE home still reaches the session handoff' 0555

printf '%s\n' ""
printf '%s\n' "${label}: ${pass_count} pass, ${fail_count} fail"
[ "${fail_count}" -eq 0 ]
