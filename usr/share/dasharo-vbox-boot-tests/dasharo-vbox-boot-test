## AI-Assisted

## End-to-end boot test for the Dasharo-in-VirtualBox port.
##
## Drives a patched VirtualBox (the DevEFI CorebootRom + DevACPI SLP_EN fixes
## from org-ai-assisted/virtualbox) to load a coreboot + UefiPayloadPkg ROM
## (built per org-ai-assisted/dasharo), boot it headless, and assert that:
##   1. it reaches the interactive UEFI shell on COM1, and
##   2. ACPI is functional: `reset -s` at the shell (an ACPI S5 shutdown written
##      WITH SLP_EN) powers the VM off cleanly -- VBox.log logs "Entering S5" and
##      the VM transitions to OFF on its own, not by our poweroff.
##
## The pure helpers (argument building, serial / VBox.log assertions) are unit
## tested by test_dasharo_vbox_boot.py and carry no VirtualBox dependency; the
## orchestration below needs the patched VBox, root (for /dev/vboxdrv on a
## non-hardened source build), and the ROM, so it is gated by the bash entrypoint
## which SKIPs (exit 77) when that environment is absent.
##
## Exit codes: 0 PASS, 1 FAIL, 2 usage/setup, 77 SKIP (environment not bootable).

import argparse
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import uuid

SKIP = 77

## The payload identity-maps the full physical address space; VirtualBox passes
## the host's 48-bit width and masks the 1 GiB-page CPUID bit, so a 48-bit map
## needs ~1 GiB of 2 MiB page tables and wedges. Report 36 physical / 48 virtual
## address bits (CPUID 0x80000008 EAX = 0x00003024) to keep the map small.
CPUID_PHYS36 = ("0x80000008", "0x00003024", "0x791ef257", "0x0000400f", "0x00010000")

EFIROM_KEY = "VBoxInternal/Devices/efi/0/Config/EfiRom"
COREBOOTROM_KEY = "VBoxInternal/Devices/efi/0/Config/CorebootRom"

UEFI_SHELL_MARKER = "UEFI Interactive Shell"
S5_MARKER = "Entering S5 power state"


def build_modifyvm_args(vm, serial_port, memory_mib):
    """VBoxManage modifyvm arguments for a headless coreboot/UEFI boot.

    Keep the five VBox-vs-QEMU tweaks the port needs: EFI firmware, PIIX3
    chipset, HPET enabled, the 36-bit CPUID override, and COM1 to a TCP server
    (so the test can send `reset -s`). Returned as a list (no shell)."""
    return [
        "modifyvm", vm,
        "--firmware", "efi",
        "--chipset", "piix3",
        "--hpet", "on",
        "--memory", str(memory_mib),
        "--cpus", "1",
        "--graphicscontroller", "vmsvga",
        "--uart1", "0x3f8", "4",
        "--uartmode1", "tcpserver", str(serial_port),
        "--boot1", "none", "--boot2", "none",
        "--boot3", "none", "--boot4", "none",
    ]


def cpuid_set_args(vm):
    """VBoxManage modifyvm --cpuid-set arguments (36 physical address bits)."""
    return ["modifyvm", vm, "--cpuid-set", *CPUID_PHYS36]


def uefi_shell_reached(serial_text):
    """True when the serial capture shows the UEFI shell came up."""
    return UEFI_SHELL_MARKER in serial_text


def s5_shutdown_happened(vboxlog_text):
    """True when VBox.log recorded a guest-initiated ACPI S5 power-down."""
    return S5_MARKER in vboxlog_text


def _free_tcp_port():
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        sock.bind(("127.0.0.1", 0))
        return sock.getsockname()[1]
    finally:
        sock.close()


def _vboxmanage(vbox_bin):
    cand = os.path.join(vbox_bin, "VBoxManage")
    return cand if os.path.isfile(cand) else "VBoxManage"


def _run(vbm, env, *args, check=False):
    return subprocess.run([vbm, *args], env=env, check=check,
                          capture_output=True, text=True)


def _read_serial_until(port, marker, deadline):
    """Connect to the VBox TCP serial and read until `marker` or `deadline`.

    Returns (text, sock_or_None). The socket is left open on success so the
    caller can send input (e.g. `reset -s`)."""
    buf = ""
    sock = None
    while time.time() < deadline and sock is None:
        try:
            sock = socket.create_connection(("127.0.0.1", port), timeout=2)
        except OSError:
            time.sleep(1)
    if sock is None:
        return buf, None
    sock.settimeout(2)
    while time.time() < deadline:
        try:
            chunk = sock.recv(4096)
        except socket.timeout:
            continue
        except OSError:
            break
        if not chunk:
            break
        buf += chunk.decode("latin-1")
        if marker in buf:
            break
    return buf, sock


def run_boot_test(vbox_bin, rom, memory_mib, timeout_s, keep, serial_log=None):
    vbm = _vboxmanage(vbox_bin)
    if not os.path.isfile(rom):
        print(f"dasharo-vbox-boot-test: ROM not found: {rom}; cannot boot. SKIP.",
              file=sys.stderr)
        return SKIP

    home = tempfile.mkdtemp(prefix="dasharo-vbox-boot.")
    basefolder = os.path.join(home, "vms")
    os.makedirs(basefolder, exist_ok=True)
    env = dict(os.environ, VBOX_USER_HOME=home)
    vm = "dasharo-boot-" + uuid.uuid4().hex[:8]
    serial_port = _free_tcp_port()
    vboxlog = os.path.join(basefolder, vm, "Logs", "VBox.log")
    rc = 1
    started = False
    try:
        r = _run(vbm, env, "createvm", "--name", vm, "--ostype", "Other_64",
                 "--basefolder", basefolder, "--register")
        if r.returncode != 0:
            ## A non-hardened source build opens /dev/vboxdrv directly and needs
            ## root; an inaccessible driver is an unbootable environment, not a
            ## test failure.
            msg = (r.stderr + r.stdout).strip()
            print(f"dasharo-vbox-boot-test: createvm failed: {msg}", file=sys.stderr)
            return SKIP
        _run(vbm, env, *build_modifyvm_args(vm, serial_port, memory_mib), check=True)
        _run(vbm, env, *cpuid_set_args(vm), check=True)
        _run(vbm, env, "setextradata", vm, EFIROM_KEY, os.path.abspath(rom), check=True)
        _run(vbm, env, "setextradata", vm, COREBOOTROM_KEY, "1", check=True)

        start = _run(vbm, env, "startvm", vm, "--type", "headless")
        if start.returncode != 0:
            msg = (start.stderr + start.stdout).strip()
            ## VERR_VM_DRIVER_NOT_ACCESSIBLE etc. == not a bootable host here.
            print(f"dasharo-vbox-boot-test: startvm failed: {msg}", file=sys.stderr)
            return SKIP
        started = True

        deadline = time.time() + timeout_s
        serial, sock = _read_serial_until(serial_port, UEFI_SHELL_MARKER, deadline)
        if serial_log:
            ## Persist the capture so the caller can attach it to a published
            ## result even on failure.
            try:
                with open(serial_log, "w") as handle:
                    handle.write(serial)
            except OSError:
                pass
        shell_ok = uefi_shell_reached(serial)
        if not shell_ok:
            print("dasharo-vbox-boot-test: UEFI shell not reached. FAIL.", file=sys.stderr)
            print(serial[-1500:], file=sys.stderr)
            return 1
        print("dasharo-vbox-boot-test: reached the UEFI Interactive Shell.")

        ## Functional-ACPI check: ask the shell to ACPI-shutdown.
        if sock is not None:
            try:
                time.sleep(1)
                sock.sendall(b"reset -s\r\n")
            except OSError:
                pass
            finally:
                try:
                    sock.close()
                except OSError:
                    pass

        ## Wait for the guest to power the VM off on its own.
        off_deadline = time.time() + 15
        powered_off = False
        while time.time() < off_deadline:
            running = _run(vbm, env, "list", "runningvms")
            if vm not in running.stdout:
                powered_off = True
                break
            time.sleep(1)

        vboxlog_text = ""
        try:
            with open(vboxlog, "r", errors="replace") as handle:
                vboxlog_text = handle.read()
        except OSError:
            pass
        s5_ok = s5_shutdown_happened(vboxlog_text)

        if powered_off and s5_ok:
            print("dasharo-vbox-boot-test: `reset -s` triggered a clean ACPI S5 "
                  "power-off (functional ACPI). PASS.")
            rc = 0
        else:
            print(f"dasharo-vbox-boot-test: ACPI shutdown check failed "
                  f"(powered_off={powered_off}, s5_logged={s5_ok}). FAIL.",
                  file=sys.stderr)
            rc = 1
        return rc
    finally:
        if started:
            _run(vbm, env, "controlvm", vm, "poweroff")
            time.sleep(1)
        _run(vbm, env, "unregistervm", vm, "--delete")
        if keep:
            print(f"dasharo-vbox-boot-test: kept work dir {home}", file=sys.stderr)
        else:
            shutil.rmtree(home, ignore_errors=True)


def main(argv=None):
    parser = argparse.ArgumentParser(description="Dasharo-in-VBox end-to-end boot test")
    parser.add_argument("--vbox-bin", default=os.environ.get("DASHARO_VBOX_BIN", ""),
                        help="dir holding the patched VBoxManage (else PATH)")
    parser.add_argument("--rom", default=os.environ.get("DASHARO_COREBOOT_ROM", ""),
                        help="coreboot + UefiPayloadPkg ROM to boot")
    parser.add_argument("--memory", type=int, default=2048)
    parser.add_argument("--timeout", type=int, default=90)
    parser.add_argument("--serial-log", default="",
                        help="write the captured COM1 serial here (for publishing)")
    parser.add_argument("--keep", action="store_true")
    args = parser.parse_args(argv)
    if not args.rom:
        print("dasharo-vbox-boot-test: no --rom / DASHARO_COREBOOT_ROM; nothing to "
              "boot. SKIP.", file=sys.stderr)
        return SKIP
    return run_boot_test(args.vbox_bin, args.rom, args.memory, args.timeout,
                         args.keep, args.serial_log or None)


if __name__ == "__main__":
    sys.exit(main())
