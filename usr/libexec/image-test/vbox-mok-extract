## AI-Assisted

## Narrow privleap wrapper: lift the per-machine MOK PUBLIC cert
## (/var/lib/dkms/mok.pub) out of the CALLER'S OWN installed VirtualBox disk,
## read-only, as root -- so `dm-calamares-install --mok-enroll`, run by a
## DELIBERATELY sudo-less dm-release-test image-test runner (vboxusers only,
## never sysmaint -- the isolation invariant that keeps a guest escape off host
## root), can host-enroll the MOK without the account holding host sudo.
##
## Invoked ONLY via privleap (action 'vbox-disk-extract-mok', AuthorizedGroups
## vboxusers), which runs it as root. NARROW BY CONSTRUCTION, so a vboxusers
## member can at most read its OWN VM's PUBLIC MOK cert -- never an arbitrary
## root read:
##   * --source is HARDCODED to /var/lib/dkms/mok.pub (a PUBLIC key).
##   * the disk, after realpath (so a symlink/hardlink cannot escape), MUST be OWNED
##     by the caller -- so a caller can only read a disk IT owns (its own VM .vdi,
##     wherever it lives: '~/VirtualBox VMs/' or the account's own TMPDIR), never a
##     root-owned or another user's disk.
##   * the caller is PRIVLEAP_CALLER_UID (kernel SO_PEERCRED via privleap; not
##     caller-spoofable), NOT a request field.
## The request (disk path + LUKS passphrase) is handed over in the caller-owned
## request dir; even a crafted passphrase-file only feeds a LUKS key, never an
## output, so nothing sensitive can leak.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="$(basename -- "$0")"
tmp_der=""
## Overridable so a unit test can assert stdout stays clean against a stub extractor;
## production is byte-identical (unset -> the real tool).
VBOX_DISK_EXTRACT="${VBOX_DISK_EXTRACT:-/usr/bin/vbox-disk-extract}"

die() {
   printf '%s\n' "${me}: ERROR: $1" >&2
   exit "${2:-1}"
}

cleanup() {
   [ -z "${tmp_der}" ] || safe-rm --force -- "${tmp_der}"
}
trap cleanup EXIT

## Caller identity comes from privleap, not from the request (unspoofable).
[ -n "${PRIVLEAP_CALLER_UID:-}" ] \
   || die "no PRIVLEAP_CALLER_UID in environment -- must be invoked via privleap" 2
case "${PRIVLEAP_CALLER_UID}" in
   ''|*[!0-9]*)
      die "PRIVLEAP_CALLER_UID '${PRIVLEAP_CALLER_UID}' is not numeric" 2
      ;;
esac

caller_pw="$(getent passwd "${PRIVLEAP_CALLER_UID}")" \
   || die "no account for caller uid ${PRIVLEAP_CALLER_UID}" 2
caller_home="$(printf '%s' "${caller_pw}" | cut -d: -f6)"
[ -n "${caller_home}" ] || die "caller uid ${PRIVLEAP_CALLER_UID} has no home directory" 2

req_dir="${caller_home}/.cache/vbox-mok-extract"
disk_file="${req_dir}/disk"
pass_file="${req_dir}/passphrase"
[ -f "${disk_file}" ] || die "no request: '${disk_file}' does not exist" 2
[ -f "${pass_file}" ] || die "no request: '${pass_file}' does not exist" 2

disk="$(cat -- "${disk_file}")"
[ -n "${disk}" ] || die "request disk path is empty" 2

## The disk (after realpath, so a symlink/hardlink cannot escape) MUST be OWNED by
## the caller -- a caller can read only a disk IT owns, never a root-owned/other-user one.
disk_real="$(realpath -- "${disk}")" || die "disk path '${disk}' does not resolve" 2
[ -f "${disk_real}" ] || die "disk '${disk_real}' is not a regular file" 2
disk_owner_uid="$(stat --format='%u' -- "${disk_real}")" \
   || die "cannot stat disk '${disk_real}'" 2
[ "${disk_owner_uid}" = "${PRIVLEAP_CALLER_UID}" ] \
   || die "refused: disk '${disk_real}' is owned by uid ${disk_owner_uid}, not the caller (uid ${PRIVLEAP_CALLER_UID})" 2

tmp_der="$(mktemp)"

## --source is FIXED (a public cert); --dest to a root-owned temp, then streamed
## back to the caller over privleap's stdout channel.
## STDOUT here IS the cert data channel (the caller captures it as the enrolled MOK),
## so nothing but the DER may reach it: the extractor's own stdout is routed to stderr
## so only the final `cat` writes the cert. (A stray diagnostic prepended to the DER
## corrupts the MokListRT enrollment -> kernel rejects the key -> signed modules fail
## under Secure Boot.)
"${VBOX_DISK_EXTRACT}" \
   --disk "${disk_real}" \
   --passphrase-file "${pass_file}" \
   --source /var/lib/dkms/mok.pub \
   --dest "${tmp_der}" >&2 \
   || die "vbox-disk-extract failed -- /var/lib/dkms/mok.pub not readable off the disk (did the MOK module run during the install?)" 3

cat -- "${tmp_der}"
