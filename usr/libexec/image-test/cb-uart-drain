"""Drain a VBox COM1 server UNIX socket for a coreboot+UefiPayload install run.

The coreboot firmware floods the 16550, and a VBox server-socket UART with NO host reader blocks
the guest on the THRE poll -- wedging the boot before the GOP comes up. So dm-calamares-install
launches this as a long-lived background drainer: it CONNECTS to the socket, reads+discards until
the peer disconnects, then RECONNECTS (the socket reappears each time the VM powers on), surviving
the install's power-cycles (live -> install -> reboot -> installed). It is UNIDIRECTIONAL: it only
reads, never writes, so no stray serial input can cancel GRUB autoboot. Killed by the parent.

Usage: cb-uart-drain <unix-socket-path>
"""

import socket
import sys
import time


def drain_once(path):
    """Connect, read+discard until EOF/error. Returns on disconnect; never writes."""
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(path)
    except OSError:
        return
    try:
        while sock.recv(4096):
            pass
    except OSError:
        pass
    finally:
        try:
            sock.close()
        except OSError:
            pass


def main(argv):
    if len(argv) != 2:
        print('usage: cb-uart-drain <unix-socket-path>', file=sys.stderr)
        return 2
    path = argv[1]
    ## Reconnect forever; the parent kills us at run end.
    while True:
        drain_once(path)
        time.sleep(0.5)


if __name__ == '__main__':
    sys.exit(main(sys.argv))
