## AI-Assisted

## Set the installed system's GRUB one-shot next_entry to the boot-mode entry whose
## menuentry --id names MODE, so the next boot selects that mode DETERMINISTICALLY --
## no OCR, no menu interaction, no live-menu timing. Run against a mounted installed
## root (CWD and $MOUNTPOINT = the root), e.g. as the command of image-mount
## (by ABSOLUTE path -- /usr/libexec is not on PATH):
##
##   image-mount run --disk <installed.vdi> --format vdi --passphrase-file <pf> -- \
##     /usr/libexec/image-test/grub-select-next-boot-mode persistent-sysmaint
##
## Assumes /boot/grub is on the mounted root -- true for the Kicksecure Calamares
## single-LUKS-root layout (grubenv lives inside the encrypted root). A separate /boot
## not on the mounted filesystem yields no grub.cfg here -> fail loud, never misselect.
##
## Relies on the per-mode menuentry --id: dist-base-files etc/grub.d/10_00_linux_dist
## scopes the simple-entry id by boot mode (gnulinux-<mode>-<device-id>, where <mode> is
## user / persistent-sysmaint / live-sysmaint / remove-sysmaint). next_entry overrides
## GRUB_DEFAULT for exactly ONE boot via the stock 00_header one-shot block, regardless
## of the shipped GRUB_DEFAULT=0. One-shot BY DESIGN: GRUB clears next_entry after
## reading it; a LUKS grubenv GRUB cannot write back keeps the selection until reset
## offline -- harmless for a throwaway test VM.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"

## Set the global 'confined' to a grubenv path safe to hand grub-editenv, or EXIT the script if
## it escapes the mounted root. grub-editenv opens <path> AND its temp <path>.new (fopen FOLLOWS
## a symlink) then renames .new onto path, so a guest symlink at EITHER -- even a DANGLING one,
## which a bare [ -e ] test misses -- would redirect this root write onto a HOST path. Resolves an
## existing/symlinked path and requires the real target to stay under ${root} (main's local, seen
## via dynamic scope). Must NOT run in a command substitution: 'exit' has to leave the whole
## script. nosymfollow on the image-mount mount is the atomic kernel guard; this keeps the
## selector correct when it is run standalone.
confine_grubenv_path() {
   local path="$1" label="$2"
   confined="${path}"
   if [ -L "${path}" ] || [ -e "${path}" ]; then
      confined="$(realpath -- "${path}")" \
         || { printf '%s\n' "${me}: ERROR: ${label} does not resolve" >&2; exit 1; }
      case "${confined}/" in
         "${root_prefix}"*)
            true
            ;;
         *)
            printf '%s\n' "${me}: ERROR: ${label} resolves outside the mount ('${confined}'); refusing" >&2
            exit 1
            ;;
      esac
      ## A pre-existing ${label} must be a REGULAR file: grub-editenv OPENS it (and a FIFO,
      ## which nosymfollow does not stop, would block this root process forever -> the caller
      ## never reaches its device-teardown trap). grubenv absent is fine (grub-editenv creates
      ## it) -- this block only runs when the path already exists.
      [ -f "${confined}" ] \
         || { printf '%s\n' "${me}: ERROR: ${label} is not a regular file ('${confined}'); refusing" >&2; exit 1; }
   fi
}

main() {
   local mode root root_prefix grubdir grub_cfg grubenv confined
   mode="${1:?usage: ${me} <mode> (e.g. persistent-sysmaint)}"
   ## MODE is interpolated into the ERE below, so constrain it to the id charset
   ## (lowercase + hyphen). Rejects a typo/metachar mode (e.g. 'live.sysmaint', whose
   ## '.' would match a hyphen and select a DIFFERENT mode's entry).
   ## MODE is a TRUSTED INTERNAL token: callers pass a fixed set ('user' / 'persistent-sysmaint'
   ## / ...), never user input. A crafted mode that is a real-mode prefix plus part of the
   ## device-id (e.g. 'user-deadbeef' against gnulinux-user-deadbeef-<uuid>) would still select
   ## the real 'user' entry via the greedy id tail -- a low residual accepted rather than
   ## over-anchoring the device-id to a strict UUID shape (which would false-reject a legit
   ## non-UUID device-id, e.g. under GRUB_DISABLE_UUID, re-opening a fail-closed gap).
   [[ "${mode}" =~ ^[a-z][a-z-]*$ ]] \
      || { printf '%s\n' "${me}: ERROR: invalid mode '${mode}' (expected [a-z-]+)" >&2; exit 1; }

   ## Confine to the MOUNTED root. This runs as root against a guest filesystem, so a
   ## symlinked boot/grub (or grub.cfg/grubenv) inside that filesystem could otherwise
   ## redirect the grub-editenv WRITE onto a HOST path. Resolve the mount root, then require
   ## /boot/grub -- and every file we read/write -- to RESOLVE INSIDE it. grubenv may not
   ## exist yet (grub-editenv creates it in the confined grubdir), so its creation is covered
   ## by confining grubdir; a pre-existing grubenv is re-checked.
   root="$(realpath -- "${MOUNTPOINT:-$(pwd)}")" \
      || { printf '%s\n' "${me}: ERROR: mount root does not resolve" >&2; exit 1; }
   ## Containment prefix. realpath strips a trailing slash, so root='/' would make "${root}/"*
   ## = '//'* and reject every in-mount path (a real FP when MOUNTPOINT=/). '${root%/}/' yields
   ## '/' for root='/' and '/mnt/x/' for root='/mnt/x' -- correct for both, no sibling-prefix match.
   root_prefix="${root%/}/"
   grubdir="$(realpath -- "${root}/boot/grub")" \
      || { printf '%s\n' "${me}: ERROR: no '${root}/boot/grub' (separate /boot not on the mounted root?)" >&2; exit 1; }
   case "${grubdir}/" in
      "${root_prefix}"*)
         true
         ;;
      *)
         printf '%s\n' "${me}: ERROR: boot/grub resolves outside the mount ('${grubdir}'); refusing" >&2
         exit 1
         ;;
   esac
   grub_cfg="$(realpath -- "${grubdir}/grub.cfg" 2>/dev/null || true)"
   ## Require a REGULAR file: a crafted guest can plant grub.cfg as a FIFO (or other special
   ## file), and the grep below would block FOREVER on a writer-less FIFO. nosymfollow on the
   ## image-mount does NOT stop FIFOs, and a hung read here means image-mount never reaches its
   ## EXIT trap -> leaked nbd/LUKS devices. realpath already resolved symlinks, so -f tests the
   ## final target.
   { [ -n "${grub_cfg}" ] && [ -f "${grub_cfg}" ] && [ -r "${grub_cfg}" ]; } \
      || { printf '%s\n' "${me}: ERROR: no readable regular grub.cfg under '${grubdir}'" >&2; exit 1; }
   case "${grub_cfg}/" in
      "${root_prefix}"*)
         true
         ;;
      *)
         printf '%s\n' "${me}: ERROR: grub.cfg resolves outside the mount; refusing" >&2
         exit 1
         ;;
   esac
   grubenv="${grubdir}/grubenv"
   ## Confine the write target AND grub-editenv's temp sibling (<grubenv>.new) -- both are opened
   ## following symlinks. Confine grubenv first (it may itself be an in-mount symlink we resolve),
   ## then confine the .new of the RESOLVED path, since grub-editenv derives .new from the path we
   ## pass it.
   confine_grubenv_path "${grubenv}" "grubenv"
   grubenv="${confined}"
   confine_grubenv_path "${grubenv}.new" "grubenv.new"

   ## Resolve a one-shot next_entry selector for MODE that works on EVERY image, preferring the
   ## robust machine key and falling back to the title so a pre-patch released image is covered
   ## too (both are offline grubenv edits -- no OCR, no live-menu timing). GRUB's next_entry
   ## matches a menuentry by --id OR by exact title.
   ##
   ## 1. The per-mode --id (dist-base-files per-mode --id patch), taken ONLY from a top-level
   ##    menuentry line (so an earlier textual reference cannot be mistaken for the id). The
   ##    advanced submenus are indented and keep the stock gnulinux-advanced-<dev> scheme, so
   ##    this cannot match one. Anchor the id tail to the device-id charset (hex + hyphens):
   ##    MODE is a COMPLETE id field, never a prefix -- a real mode is followed by the hex
   ##    device-id (matches), an invalid prefix like 'persistent' is followed by 'sysmaint'
   ##    (non-hex -> no match -> drops to the title fallback, which also rejects it).
   local selector=''
   selector="$(grep --extended-regexp '^menuentry ' "${grub_cfg}" \
      | grep --only-matching --extended-regexp "gnulinux-${mode}-[0-9a-fA-F][0-9a-fA-F-]*" \
      | head -n 1)" || true
   if [ -z "${selector}" ]; then
      ## 2. Fallback: select by the menuentry TITLE. Part A changed the --id, never the title,
      ##    so the per-mode title is unique on every image, including a pre-patch one that
      ##    shares gnulinux-simple-<dev> across modes. Match STABLE semantic markers (persistence
      ##    mode + session), then use the ACTUAL full title from this grub.cfg verbatim, so a
      ##    reworded title tail still resolves. A mode with no marker mapping (e.g. the bare
      ##    prefix 'persistent'/'live') falls through to the fail-loud below -- never a mis-select.
      local -a markers=()
      case "${mode}" in
         persistent-sysmaint)
            markers=('PERSISTENT Mode' 'SYSMAINT Session')
            ;;
         live-sysmaint)
            markers=('LIVE Mode' 'SYSMAINT Session')
            ;;
         remove-sysmaint)
            markers=('REMOVE user-sysmaint-split')
            ;;
         user)
            markers=('PERSISTENT Mode' 'USER Session')
            ;;
         *)
            markers=()
            ;;
      esac
      if [ "${#markers[@]}" -gt 0 ]; then
         local lines marker
         lines="$(grep --extended-regexp '^menuentry ' "${grub_cfg}")" || lines=''
         for marker in "${markers[@]}"; do
            lines="$(printf '%s\n' "${lines}" | grep --fixed-strings -- "${marker}")" || lines=''
         done
         ## First matching top-level menuentry's title (single- OR double-quoted).
         selector="$(printf '%s\n' "${lines}" | head -n 1 \
            | sed -n -e "s/^menuentry '\\([^']*\\)'.*/\\1/p" -e 's/^menuentry "\([^"]*\)".*/\1/p' \
            | head -n 1)"
      fi
   fi
   [ -n "${selector}" ] || {
      printf '%s\n' "${me}: ERROR: no 'gnulinux-${mode}-*' id and no menuentry titled for mode '${mode}' in '${grub_cfg}'" >&2
      printf '%s\n' "${me}: (image needs the dist-base-files per-mode --id patch, or a per-mode boot menu)" >&2
      exit 1
   }

   grub-editenv "${grubenv}" set "next_entry=${selector}"
   printf '%s\n' "${me}: set next_entry=${selector}"
}

## Sourced (a unit test) -> expose main without running; executed -> run.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
   main "$@"
fi
