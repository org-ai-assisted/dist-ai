## AI-Assisted

## Exit 0 iff the disk image (argv1), interpreted as format (argv2), is SELF-CONTAINED:
## every file qemu would OPEN -- VMDK FLAT/SPARSE extents, a qcow2 backing file -- resolves
## to the disk file itself. Exit 1 otherwise, AND on ANY error (fail-closed).
##
## Rationale: vbox-disk-mount's qemu-nbd opens those referenced files AS ROOT, so a crafted
## descriptor (monolithicFlat `RW 1 FLAT "/etc/shadow"`, or a qcow2 backing /etc/shadow) would
## let a non-root caller read/write a host path as root. vbox-grub-set-next-boot-mode runs this
## as the CALLER (so even the probe cannot open a root-only path as root) before accepting a
## non-vdi format. vdi is always self-contained and never probed.

import json
import os
import subprocess
import sys


def main():
    if len(sys.argv) != 3:
        return 1
    disk = os.path.realpath(sys.argv[1])
    fmt = sys.argv[2]
    disk_dir = os.path.dirname(disk)
    try:
        completed = subprocess.run(
            ["qemu-img", "info", "--output=json", "-f", fmt, "--", disk],
            capture_output=True,
            text=True,
            timeout=30,
        )
    except Exception:
        return 1
    if completed.returncode != 0:
        return 1
    try:
        info = json.loads(completed.stdout)
    except Exception:
        return 1
    refs = []
    backing = info.get("full-backing-filename") or info.get("backing-filename")
    if backing:
        refs.append(backing)
    data = (info.get("format-specific") or {}).get("data") or {}
    for extent in data.get("extents") or []:
        name = extent.get("filename")
        if name:
            refs.append(name)
    for ref in refs:
        resolved = os.path.realpath(ref if os.path.isabs(ref) else os.path.join(disk_dir, ref))
        if resolved != disk:
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
