## AI-Assisted

## Exit 0 iff the disk image (argv1), interpreted as format (argv2), is SELF-CONTAINED:
## EVERY file qemu would OPEN -- VMDK FLAT/SPARSE extents, a qcow2 backing file, a qcow2
## external data-file -- resolves to the disk file itself. Exit 1 otherwise, AND on ANY error
## or if no path at all is found (fail-closed).
##
## Rationale: image-mount's / vbox-disk-extract's qemu-nbd opens those referenced files AS ROOT, so a crafted
## descriptor (monolithicFlat `RW 1 FLAT "/etc/shadow"`, a qcow2 backing /etc/shadow, or a qcow2
## `data_file=/etc/shadow`) would let a non-root caller read/write a host path as root.
## vbox-grub-set-next-boot-mode runs this as the CALLER (so even the probe cannot open a
## root-only path as root) before accepting a non-vdi format. vdi is always self-contained and
## never probed.
##
## Collect the VALUE of every path-bearing key ANYWHERE in the qemu-img info tree, not a fixed
## field list -- a field-specific enumeration already missed `data-file` once, so match by key
## name recursively to also catch any future external-reference key.

import json
import os
import subprocess
import sys

PATH_KEYS = {"filename", "backing-filename", "full-backing-filename", "data-file"}


def collect_paths(obj, out):
    if isinstance(obj, dict):
        for key, value in obj.items():
            if key in PATH_KEYS and isinstance(value, str) and value:
                out.append(value)
            collect_paths(value, out)
    elif isinstance(obj, list):
        for item in obj:
            collect_paths(item, out)


def main():
    if len(sys.argv) != 3:
        return 1
    disk = os.path.realpath(sys.argv[1])
    fmt = sys.argv[2]
    disk_dir = os.path.dirname(disk)
    try:
        completed = subprocess.run(
            ["qemu-img", "info", "--output=json", "-f", fmt, "--", disk],
            capture_output=True,
            text=True,
            timeout=30,
        )
    except Exception:
        return 1
    if completed.returncode != 0:
        return 1
    try:
        info = json.loads(completed.stdout)
    except Exception:
        return 1
    refs: list[str] = []
    collect_paths(info, refs)
    if not refs:
        return 1
    for ref in refs:
        resolved = os.path.realpath(ref if os.path.isabs(ref) else os.path.join(disk_dir, ref))
        if resolved != disk:
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
