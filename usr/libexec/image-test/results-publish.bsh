## AI-Assisted

## Shared results-plane publisher for the image-test tools (image-test-run,
## dm-release-test). A pure library: defines functions only, no top-level
## strict-mode block (which would leak into the sourcing script). The caller
## produces a screenshot (or not) and the test verdict; this writes the JSON
## result + screenshot into the read-only results plane and republishes the
## subtree to the nginx owner.
##
## style-ok: no-strict -- sourced-only fragment; a top-level 'set -o errexit'/
## 'nounset'/'pipefail' would leak into (and could kill) the sourcing shell.

## Map a lane rc to a verdict. 0 = PASS; the reserved SETUP/inconclusive code 2 =
## INCONCLUSIVE (a provisioning/infra gap or an inconclusive probe -- NOT a product
## failure, so neither green nor a leak); any other non-zero = FAIL. Single source so
## the console summary and result.json never drift (dist-ai harness convention: a lane
## exits 2 for setup/inconclusive -- see dm-release-test SETUP_RC / dm-whonix-pair).
## Mirrors dm_test_results.model.verdict_from_rc (the emitter is the JSON writer; this
## stays for the console line a caller prints without shelling out to python).
image_test_verdict_from_rc() {
   case "$1" in
      0)
         printf '%s\n' "PASS"
         ;;
      2)
         printf '%s\n' "INCONCLUSIVE"
         ;;
      *)
         printf '%s\n' "FAIL"
         ;;
   esac
}

## Resolve the result.json writer (dm-test-result/v1 single-source-of-truth). The
## checkout's sibling by default (lib is <root>/usr/libexec/image-test/..., the bin
## is <root>/usr/bin/...), overridable so a suite drives the in-tree tool with
## nothing written to /usr.
image_test_result_emit_bin() {
   local self bin
   if [ -n "${IMAGE_TEST_RESULT_EMIT:-}" ]; then
      printf '%s\n' "${IMAGE_TEST_RESULT_EMIT}"
      return 0
   fi
   self="$(readlink --canonicalize -- "${BASH_SOURCE[0]}")"
   bin="$(dirname -- "$(dirname -- "$(dirname -- "${self}")")")/bin/image-test-result-emit"
   if [ -x "${bin}" ]; then
      printf '%s\n' "${bin}"
   else
      printf '%s\n' '/usr/bin/image-test-result-emit'
   fi
}

## Publish one run's artifacts. Positionals (stable core):
##   results_root owner name test_user mode rc shot_src
## then named options: --lane L --version V --builder B --origin downloaded|built
##   --step-name S [--start-unix N] [--stop-unix N] [--expect TOK]...
## No `pass` arg: the verdict, pass flag, and per-step status all derive from rc in
## ONE place (the emitter / dm_test_results.model), so there is nothing to keep in
## sync and nothing to drift.
##
## shot_src may be empty or a missing file (a run that never powered on is still
## reported); the caller owns and cleans its own screenshot temp. The shot is stored
## as a step-named PNG in the run dir; the site generator produces the normalized
## webp the public page serves (so cwebp is not on this best-effort server path).
## Must run as root: it writes under the web root and chowns the subtree to nginx.
image_test_results_publish() {
   local results_root owner name test_user mode rc shot_src
   results_root="$1"
   owner="$2"
   name="$3"
   test_user="$4"
   mode="$5"
   rc="$6"
   shot_src="$7"
   shift 7

   local lane version builder origin step_name start_unix stop_unix step_stderr_file
   local provenance_artifact_sha256
   local -a expect=()
   lane=""
   version=""
   builder="dm-image-test"
   origin="built"
   step_name="${mode}"
   start_unix=""
   stop_unix=""
   step_stderr_file=""
   provenance_artifact_sha256=""
   while [ "$#" -gt 0 ]; do
      case "$1" in
         --lane)
            lane="$2"
            shift 2
            ;;
         --version)
            version="$2"
            shift 2
            ;;
         --builder)
            builder="$2"
            shift 2
            ;;
         --origin)
            origin="$2"
            shift 2
            ;;
         --step-name)
            step_name="$2"
            shift 2
            ;;
         --start-unix)
            start_unix="$2"
            shift 2
            ;;
         --stop-unix)
            stop_unix="$2"
            shift 2
            ;;
         --expect)
            expect+=( "$2" )
            shift 2
            ;;
         --step-stderr-file)
            step_stderr_file="$2"
            shift 2
            ;;
         --provenance-artifact-sha256)
            provenance_artifact_sha256="$2"
            shift 2
            ;;
         *)
            printf '%s\n' "image_test_results_publish: unknown option: ${1}" >&2
            return 2
            ;;
      esac
   done
   ## lane defaults to the subtree name for the generic runner; dm-release-test
   ## passes the real guest-interface lane.
   if [ -z "${lane}" ]; then
      lane="${name}"
   fi

   ## step_name becomes a filename component written AS ROOT; a '/' or '..' would
   ## escape outdir. Reject anything but a safe component before any write (the
   ## step name is set by our own lane code, so this is a programming-error guard,
   ## not untrusted input -- but it runs as root, so validate anyway).
   case "${step_name}" in
      *[!A-Za-z0-9._-]* | '' | '.' | '..')
         printf '%s\n' "image_test_results_publish: unsafe step name: ${step_name}" >&2
         return 2
         ;;
   esac

   local ts outdir emit
   local -a shot_emit=()
   ts="$(date -u +%Y%m%dT%H%M%SZ)"
   outdir="${results_root}/${name}/${ts}"
   mkdir --parents -- "${outdir}"

   ## The screenshot(s) and the step stderr tail are produced by the unprivileged
   ## TEST_USER but ingested as root by image-test-result-emit, which opens each
   ## O_NOFOLLOW and refuses a symlink / non-regular file atomically. The copy +
   ## reopen happen ONCE, inside the emitter, so there is no check-then-reopen
   ## window here. The publisher only forwards the account-owned paths.
   ##
   ## shot_src is EITHER a single screenshot file (one-shot runs) OR a DIRECTORY of
   ## milestone shots named NN-<milestone>.png (the install "full story"): each is
   ## published as a named attachment, ordered by filename, so the site renders the
   ## whole sequence. Stored step-named so shots never collide.
   if [ -n "${shot_src}" ] && [ -d "${shot_src}" ] && [ ! -L "${shot_src}" ]; then
      local shot_f shot_base shot_milestone
      ## The shot dir is written by the UNPRIVILEGED test account, so a filename here is
      ## account-controlled. Accept only a NON-EMPTY regular *.png whose derived milestone
      ## is a safe label (no leading '-' that argparse would eat, no unsafe char, not
      ## '.'/'..'); SKIP anything else. A stray/crafted file must never make the emit
      ## fail -- that would let the account suppress its own result.json. The emitter
      ## defends the same invariant per-shot; this is the first, cheap filter.
      ## -type f excludes symlinks; the emitter re-checks each O_NOFOLLOW.
      while IFS= read -r -d '' shot_f; do
         [ -s "${shot_f}" ] || continue
         shot_base="${shot_f##*/}"
         shot_milestone="${shot_base%.png}"
         shot_milestone="${shot_milestone#*-}"   ## drop the NN- ordering prefix
         case "${shot_milestone}" in
            '' | '.' | '..' | -* | *[!A-Za-z0-9._-]*)
               printf '%s\n' \
                  "image_test_results_publish: skipping shot with unusable name: ${shot_base}" >&2
               continue
               ;;
         esac
         shot_emit+=( --step-shot "${step_name}-${shot_base}" \
            --step-shot-src "${shot_f}" --step-shot-name "${shot_milestone}" )
      done < <(find "${shot_src}" -maxdepth 1 -type f -name '*.png' -print0 | sort --zero-terminated)
   elif [ -n "${shot_src}" ] && [ -f "${shot_src}" ]; then
      shot_emit+=( --step-shot "${step_name}.png" --step-shot-src "${shot_src}" )
   fi

   emit="$(image_test_result_emit_bin)"
   local -a emit_args=(
      --dest "${outdir}/result.json"
      --run-id "${name}-${ts}"
      --lane "${lane}"
      --version "${version}"
      --builder "${builder}"
      --mode "${mode}"
      --test-user "${test_user}"
      --origin "${origin}"
      --rc "${rc}"
      --step-name "${step_name}"
   )
   if [ -n "${start_unix}" ]; then
      emit_args+=( --start-unix "${start_unix}" )
   fi
   if [ -n "${stop_unix}" ]; then
      emit_args+=( --stop-unix "${stop_unix}" )
   fi
   if [ "${#shot_emit[@]}" -gt 0 ]; then
      emit_args+=( "${shot_emit[@]}" )
   fi
   ## Failed-check output -> the step's stderr tail (why the run failed). The emitter
   ## reads it no-follow (symlink refused), so the account-owned path is forwarded
   ## as-is; an absent file tails to empty.
   if [ -n "${step_stderr_file}" ]; then
      emit_args+=( --step-stderr-file "${step_stderr_file}" )
   fi
   ## The ISO sha256 identifies the EXACT artifact under test (a NULL digest leaves a
   ## downloaded run unidentifiable). It is written into result.json AS ROOT, so validate the
   ## shape and DROP a malformed value rather than corrupt the record. Empty = not provided
   ## (a download failure / no ISO); the field then stays null.
   if [ -n "${provenance_artifact_sha256}" ]; then
      if [ "${#provenance_artifact_sha256}" -eq 64 ] \
         && [ -z "${provenance_artifact_sha256//[0-9a-f]/}" ]; then
         emit_args+=( --provenance-artifact-sha256 "${provenance_artifact_sha256}" )
      else
         printf '%s\n' "image_test_results_publish: ignoring malformed artifact sha256: ${provenance_artifact_sha256}" >&2
      fi
   fi
   local item
   for item in "${expect[@]}"; do
      emit_args+=( --expect "${item}" )
   done

   ## result.json is the critical artifact. If the emitter fails (a malformed
   ## token, argparse rejecting a '-'-leading value, an out-of-range time), the run
   ## dir has NO result.json: do NOT repoint <name>/latest at it and do NOT report
   ## success -- leave latest at the last good run (the site reads the incomplete
   ## dir as NO-DATA, never green) and fail the publish. The caller preserves the
   ## TEST verdict: a publish hiccup must never downgrade or fake a result.
   local emit_rc
   emit_rc=0
   "${emit}" "${emit_args[@]}" || emit_rc="$?"
   if [ "${emit_rc}" -ne 0 ]; then
      printf '%s\n' \
         "image_test_results_publish: result emit FAILED (rc=${emit_rc}) for ${name}; latest left unchanged" >&2
      return 3
   fi

   ## Point <name>/latest at this run and hand the whole subtree to nginx.
   ln --symbolic --force --no-dereference -- "${ts}" "${results_root}/${name}/latest"
   chown --recursive -- "${owner}:${owner}" "${results_root}/${name}"

   printf '%s\n' "${outdir}"
}
