## AI-Assisted

## Narrow privleap wrapper: set the one-shot GRUB next_entry on the CALLER'S OWN
## installed VirtualBox disk to a boot-mode menuentry, as root and with the VM powered
## off, so a DELIBERATELY sudo-less dm-release-test image-test runner (vboxusers only,
## never sysmaint -- the isolation invariant that keeps a guest escape off host root)
## can drive the installed system into a chosen boot mode OFFLINE: deterministic, no OCR,
## no live-menu timing. The writable counterpart of vbox-mok-extract.
##
## Invoked ONLY via privleap (action 'vbox-grub-set-next-boot-mode', AuthorizedGroups
## vboxusers), which runs it as root. NARROW BY CONSTRUCTION, so a vboxusers member can
## at most retarget its OWN VM's one-shot boot selection -- never an arbitrary root write:
##   * the disk, after realpath (so a symlink/hardlink cannot escape), MUST be OWNED by
##     the caller -- so a caller can only touch a disk IT owns.
##   * the only mutation is grubenv next_entry, set to an EXISTING gnulinux-<mode>-<dev>
##     menuentry id in that disk's own grub.cfg (grub-select-next-boot-mode validates the
##     mode as [a-z-]+ and fails loud on a missing id -- never a blind/arbitrary value).
##   * the caller is PRIVLEAP_CALLER_UID (kernel SO_PEERCRED via privleap; not spoofable),
##     NOT a request field.
## The request (disk path + mode, plus an OPTIONAL LUKS passphrase and an OPTIONAL disk
## format) is handed over in the caller-owned request dir; a crafted passphrase-file only
## feeds a LUKS key, and the mode only selects among entries already on the caller's own
## disk, so nothing is leaked or escalated. The passphrase is OPTIONAL so an unencrypted
## image (a Whonix OVA .vmdk) is supported -- absent, the mount skips LUKS; the format is
## OPTIONAL (default vdi), set to 'vmdk' for an OVA disk.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="$(basename -- "$0")"

## Overridable so a unit test can assert the delegated invocation with stubs; production
## is byte-identical (unset -> the real tools).
VBOX_DISK_MOUNT="${VBOX_DISK_MOUNT:-/usr/bin/vbox-disk-mount}"
GRUB_SELECT_NEXT_BOOT_MODE="${GRUB_SELECT_NEXT_BOOT_MODE:-/usr/libexec/image-test/grub-select-next-boot-mode}"

die() {
   printf '%s\n' "${me}: ERROR: $1" >&2
   exit "${2:-1}"
}

## Caller identity comes from privleap, not from the request (unspoofable).
[ -n "${PRIVLEAP_CALLER_UID:-}" ] \
   || die "no PRIVLEAP_CALLER_UID in environment -- must be invoked via privleap" 2
case "${PRIVLEAP_CALLER_UID}" in
   ''|*[!0-9]*)
      die "PRIVLEAP_CALLER_UID '${PRIVLEAP_CALLER_UID}' is not numeric" 2
      ;;
esac

caller_pw="$(getent passwd "${PRIVLEAP_CALLER_UID}")" \
   || die "no account for caller uid ${PRIVLEAP_CALLER_UID}" 2
caller_home="$(printf '%s' "${caller_pw}" | cut -d: -f6)"
[ -n "${caller_home}" ] || die "caller uid ${PRIVLEAP_CALLER_UID} has no home directory" 2
caller_gid="$(printf '%s' "${caller_pw}" | cut -d: -f4)"
[ -n "${caller_gid}" ] || die "caller uid ${PRIVLEAP_CALLER_UID} has no primary group" 2

## Run a command with the CALLER's privileges, never root's. Used to read caller-owned
## request files and to probe the caller-owned disk, so neither a check-then-open symlink
## swap (a caller owning the request dir can swap a file for a symlink AFTER the [ -L ] check)
## nor a crafted disk descriptor can make this root process open a root-only path -- a path
## the caller cannot read is EACCES, so nothing is disclosed or acted on. Only drop when we
## are actually root AND the caller is not root; a non-root run (the unit test) is already the
## caller, so running plain is already unprivileged and safe.
run_as_caller() {
   if [ "$(id -u)" -eq 0 ] && [ "${PRIVLEAP_CALLER_UID}" != '0' ]; then
      setpriv --reuid="${PRIVLEAP_CALLER_UID}" --regid="${caller_gid}" --clear-groups -- "$@"
   else
      "$@"
   fi
}
read_req_as_caller() {
   run_as_caller cat -- "$1"
}

## Root-owned scratch for the passphrase we hand to vbox-disk-mount: it opens --passphrase-file
## as root LATER (a wide TOCTOU window on a caller-owned path), so we copy the passphrase into a
## root-only file NOW, read as the caller, and pass that instead -- the caller cannot swap it.
work_dir=""
cleanup() {
   [ -n "${work_dir}" ] && safe-rm --recursive --force -- "${work_dir}" 2>/dev/null
   return 0
}
trap cleanup EXIT

req_dir="${caller_home}/.cache/vbox-grub-set-next-boot-mode"
disk_file="${req_dir}/disk"
pass_file="${req_dir}/passphrase"
mode_file="${req_dir}/mode"
format_file="${req_dir}/format"
## Each request file must be a REGULAR file, NOT a symlink: the caller owns the request
## dir, so a symlinked request file would redirect this root process's read onto a
## root-only file (leaking its content back via an error, or feeding it as a LUKS key).
## O_NOFOLLOW-equivalent: refuse a symlink outright rather than read through it. disk + mode
## are REQUIRED; passphrase + format are OPTIONAL -- but if present must still be regular
## files (a symlinked optional file is the same redirect attack, so refuse it either way).
for req_file in "${disk_file}" "${mode_file}"; do
   [ -L "${req_file}" ] \
      && die "refused: request file '${req_file}' is a symlink (must be a regular file)" 2
   [ -f "${req_file}" ] || die "no request: '${req_file}' does not exist" 2
done
for req_file in "${pass_file}" "${format_file}"; do
   [ -L "${req_file}" ] \
      && die "refused: request file '${req_file}' is a symlink (must be a regular file)" 2
done

disk="$(read_req_as_caller "${disk_file}")"
[ -n "${disk}" ] || die "request disk path is empty" 2
mode="$(read_req_as_caller "${mode_file}")"
## Constrain mode here too (defence in depth; grub-select-next-boot-mode re-validates).
[[ "${mode}" =~ ^[a-z][a-z-]*$ ]] || die "invalid mode '${mode}' (expected [a-z-]+)" 2

## OPTIONAL disk format (default vdi in vbox-disk-mount). Constrain to a qemu-nbd format
## token so a crafted value cannot smuggle extra argv.
format=""
if [ -f "${format_file}" ]; then
   format="$(read_req_as_caller "${format_file}")"
   [[ "${format}" =~ ^[a-z0-9]+$ ]] || die "invalid format '${format}' (expected [a-z0-9]+)" 2
fi

## OPTIONAL passphrase, copied NOW into a root-owned file (read as the caller) so vbox-disk-mount's
## later root open cannot be redirected by a caller-side swap of the request file.
pass_arg=""
if [ -f "${pass_file}" ]; then
   work_dir="$(mktemp --directory)" || die "cannot create scratch dir" 2
   pass_arg="${work_dir}/passphrase"
   ( umask 077; read_req_as_caller "${pass_file}" > "${pass_arg}"; ) \
      || die "cannot read the request passphrase as the caller (symlinked to an unreadable file?)" 2
   chmod 0600 -- "${pass_arg}" || die "cannot secure the passphrase scratch file" 2
fi

## The disk (after realpath, so a symlink/hardlink cannot escape) MUST be OWNED by the
## caller -- a caller can retarget only a disk IT owns, never root's or another user's.
## NOTE: realpath+stat here then vbox-disk-mount re-opens the path, a check/use race on
## the disk PATH -- identical to the read-only vbox-mok-extract. Closing it fully needs
## fd-passing through vbox-disk-mount; accepted under the same model (the disk is the
## harness's own trusted test install, the runner is a trusted vboxusers account, so this
## is deliberate-misuse-only, not an accident). Symlink escape of the WRITE via the guest
## filesystem is separately confined in grub-select-next-boot-mode (boot/grub within mount).
disk_real="$(realpath -- "${disk}")" || die "disk path '${disk}' does not resolve" 2
[ -f "${disk_real}" ] || die "disk '${disk_real}' is not a regular file" 2
disk_owner_uid="$(stat --format='%u' -- "${disk_real}")" \
   || die "cannot stat disk '${disk_real}'" 2
[ "${disk_owner_uid}" = "${PRIVLEAP_CALLER_UID}" ] \
   || die "refused: disk '${disk_real}' is owned by uid ${disk_owner_uid}, not the caller (uid ${PRIVLEAP_CALLER_UID})" 2

## A non-vdi format (vmdk/qcow2) can reference OTHER files -- a VMDK FLAT/SPARSE extent, a
## qcow2 backing file -- which vbox-disk-mount's qemu-nbd then OPENS AS ROOT. The caller-owns
## check above covers only the disk file, NOT its referenced files, so a caller could craft a
## descriptor (e.g. monolithicFlat `RW 1 FLAT "/etc/shadow"`, or a qcow2 backing /etc/shadow)
## and escalate vboxusers -> arbitrary root read/write. Require a SELF-CONTAINED image: every
## extent/backing path qemu would open must resolve to the disk file itself. vdi is always
## self-contained (skip the probe); the Whonix OVA .vmdk is monolithicSparse (self-referencing).
## Probe as the CALLER (qemu-image-self-contained runs qemu-img), so even the probe never
## opens a root-only path as root. Resolve the checker next to this wrapper (so the checkout
## copy is used in tests, the installed copy in production); overridable for a unit test.
if [ -n "${format}" ] && [ "${format}" != 'vdi' ]; then
   self_contained_check="${QEMU_IMAGE_SELF_CONTAINED:-$(dirname -- "$0")/qemu-image-self-contained}"
   run_as_caller "${self_contained_check}" "${disk_real}" "${format}" \
      || die "refused: disk '${disk_real}' (format ${format}) references external files, or is unreadable as the caller; only a self-contained image is allowed" 2
fi

## rw-mount the caller's own disk and set next_entry. vbox-disk-mount is already root
## here (privleap ran us as root, no sudo), tears the mount down on its own EXIT trap,
## and grub-select-next-boot-mode fails loud if the mode is absent from the disk's menu.
## --passphrase-file is added ONLY for an encrypted disk (its file present); an unencrypted
## image (Whonix OVA .vmdk) omits it so the mount skips LUKS. --format is added when given.
mount_args=(run --disk "${disk_real}")
if [ -n "${pass_arg}" ]; then
   mount_args+=(--passphrase-file "${pass_arg}")
fi
if [ -n "${format}" ]; then
   mount_args+=(--format "${format}")
fi
"${VBOX_DISK_MOUNT}" "${mount_args[@]}" \
   -- "${GRUB_SELECT_NEXT_BOOT_MODE}" "${mode}" \
   || die "could not set next_entry for mode '${mode}' on '${disk_real}'" 3
