#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Sourceable host-side disk plumbing shared by vbox-disk-extract (read-only single-file
## copy) and vbox-disk-mount (generic read-write mount). The qemu-nbd connect, partition
## settle, LUKS unlock, LVM-in-LUKS filesystem enumeration, and reverse-order teardown
## live in ONE place so the two tools cannot drift (dist-ai: no duplication; both ship in
## the same package, so no vendored copy / drift guard).
##
## MUST be sourced by a tool that runs as root with strict mode. Caller globals consumed:
##   die()          -- the sourcing tool's die (printf to stderr + exit nonzero)
##   passphrase_file -- path to the LUKS passphrase file (luks_open only)
## Shared cleanup-state globals the sourcing tool declares (empty) and the functions set,
## torn down in reverse by cleanup(): nbd_dev, luks_name, vg_activated, mnt_dir, fs_list.
##
## style-ok: no-strict -- sourced-only fragment; a top-level 'set -o errexit'/'nounset'/
## 'pipefail' would leak into (and could kill) the sourcing shell.
# shellcheck disable=SC2154  ## die + passphrase_file are set by the sourcing tool

## Cleanup state the plumbing owns: the functions below set these and cleanup() tears them
## down in reverse. Declared here (not in each tool) so a sourcing tool just uses them.
nbd_dev=""
luks_name=""
vg_activated=""
mnt_dir=""
fs_list=""

## Cleanup state, torn down in reverse by the EXIT trap regardless of outcome. Each step is
## best-effort/idempotent so a partial setup still unwinds; the ':-' guards let a tool that
## leaves one state var unset (e.g. no fs_list) still run cleanup under nounset.
cleanup() {
   if [ -n "${mnt_dir:-}" ] && mountpoint --quiet -- "${mnt_dir}"; then
      umount -- "${mnt_dir}" || true
   fi
   if [ -n "${mnt_dir:-}" ]; then
      rmdir -- "${mnt_dir}" 2>/dev/null || true
   fi
   if [ -n "${fs_list:-}" ]; then
      safe-rm --force -- "${fs_list}" 2>/dev/null || true
   fi
   if [ -n "${vg_activated:-}" ]; then
      vgchange --activate n -- "${vg_activated}" >/dev/null 2>&1 || true
   fi
   if [ -n "${luks_name:-}" ] && [ -e "/dev/mapper/${luks_name}" ]; then
      cryptsetup close -- "${luks_name}" || true
   fi
   if [ -n "${nbd_dev:-}" ]; then
      qemu-nbd --disconnect "${nbd_dev}" >/dev/null 2>&1 || true
   fi
}

## Open LUKS volume $1 as mapping $2 with the passphrase file. MODE ($3, default
## 'readonly') adds cryptsetup --readonly; 'rw' opens writable. The file is text: its
## trailing newline is not part of the key, which the installer typed without one. Read it
## as dm-calamares-install does ("$()" drops trailing newlines) and hand cryptsetup the
## bare bytes on stdin -- --key-file PATH would read the file byte for byte, newline
## included, and fail to unlock. Cap the read with head: a LUKS key is tiny, so a
## --passphrase-file mispointed at an endless device (/dev/zero, /dev/urandom) cannot spin
## or OOM this root process; a real key is far under the cap.
luks_open() {
   local luks_target="$1" mapping="$2" mode="${3:-readonly}"
   ## Handle the passphrase in a subshell with xtrace OFF: under 'bash -x' debug a bare
   ## 'passphrase=$(...)' assignment would print '+ passphrase=<secret>' to stderr/logs. The
   ## subshell keeps both the secret AND the 'set +x' off the caller's trace. The $() is still
   ## required -- it strips the trailing newline (not part of the key; see above), which a
   ## direct 'head | cryptsetup' would pass through and fail to unlock.
   ## style-ok: R-011 -- 'set +x' hides a secret from xtrace, not an errexit toggle.
   (
      set +x
      passphrase="$(head --bytes=1048576 -- "${passphrase_file}")"
      [ -n "${passphrase}" ] || die "passphrase file is empty: '${passphrase_file}'"
      if [ "${mode}" = 'rw' ]; then
         printf '%s' "${passphrase}" \
            | cryptsetup open --key-file - -- "${luks_target}" "${mapping}"
      else
         printf '%s' "${passphrase}" \
            | cryptsetup --readonly open --key-file - -- "${luks_target}" "${mapping}"
      fi
   )
}

## Block until the kernel has published the connected disk's partition nodes (the
## partprobe uevents are async). A whole-disk image legitimately has no partitions, so a
## device-level signature counts as settled too. Bounded, so a blank disk still returns
## rather than hanging.
settle_partitions() {
   local dev="$1" i
   partprobe "${dev}" 2>/dev/null || true
   for ((i = 0; i < 40; i++)); do
      udevadm settle 2>/dev/null || true
      if [ -b "${dev}p1" ]; then
         return 0
      fi
      if blkid -- "${dev}" >/dev/null 2>&1; then
         return 0
      fi
      sleep 0.25
   done
}

## First unused /dev/nbdN (size 0 = not connected).
free_nbd() {
   local d
   for d in /sys/class/block/nbd*; do
      if [ "$(cat "${d}/size")" = '0' ]; then
         printf '%s' "/dev/${d##*/}"
         return 0
      fi
   done
   die "no free /dev/nbd device"
}

## Echo the candidate block devices that may hold a filesystem: the LUKS mapping and any
## LVs it exposes, else the disk's own partitions.
candidate_filesystems() {
   if [ -n "${luks_name:-}" ]; then
      local mapped="/dev/mapper/${luks_name}"
      ## LVM inside LUKS: activate the VG and list its LVs; otherwise the mapping itself is
      ## the filesystem. pvs exits non-zero when the mapping is a plain filesystem (not an
      ## LVM PV); that is expected, so tolerate it rather than letting errexit abort.
      local vg
      vg="$(pvs --noheadings --options vg_name -- "${mapped}" 2>/dev/null | tr -d ' ' || true)"
      if [ -n "${vg}" ]; then
         vgchange --activate y -- "${vg}" >/dev/null
         vg_activated="${vg}"
         lvs --noheadings --options lv_path -- "${vg}" 2>/dev/null | tr -d ' '
      else
         printf '%s\n' "${mapped}"
      fi
   else
      ## Plain disk: its partitions, or the whole device for an unpartitioned image.
      local p printed='false'
      for p in "${nbd_dev}"p*; do
         if [ -b "${p}" ]; then
            printf '%s\n' "${p}"
            printed='true'
         fi
      done
      if [ "${printed}" = 'false' ]; then
         printf '%s\n' "${nbd_dev}"
      fi
   fi
}
