## AI-Assisted

## Sourceable host-side disk plumbing shared by vbox-disk-extract (read-only single-file
## copy) and image-mount (generic read-write mount engine). The qemu-nbd connect, partition
## settle, LUKS unlock, LVM-in-LUKS filesystem enumeration, and reverse-order teardown
## live in ONE place so the two tools cannot drift (dist-ai: no duplication; both ship in
## the same package, so no vendored copy / drift guard).
##
## MUST be sourced by a tool that runs as root with strict mode. Caller globals consumed:
##   die()          -- the sourcing tool's die (printf to stderr + exit nonzero)
##   passphrase_file -- path to the LUKS passphrase file (luks_open only)
## Shared cleanup-state globals the sourcing tool declares (empty) and the functions set,
## torn down in reverse by cleanup(): nbd_dev, luks_name, vg_activated, mnt_dir, fs_list.
##
## style-ok: no-strict -- sourced-only fragment; a top-level 'set -o errexit'/'nounset'/
## 'pipefail' would leak into (and could kill) the sourcing shell.
# shellcheck disable=SC2154  ## die + passphrase_file are set by the sourcing tool

## Cleanup state the plumbing owns: the functions below set these and cleanup() tears them
## down in reverse. Declared here (not in each tool) so a sourcing tool just uses them.
nbd_dev=""
luks_name=""
vg_activated=""
vg_dev=""
mnt_dir=""
mnt_base=""
fs_list=""

## Directory this lib lives in, to resolve sibling helpers (qemu-image-self-contained). Captured
## at source time (BASH_SOURCE is the lib's path); the helper is overridable via
## QEMU_IMAGE_SELF_CONTAINED for tests.
vbox_disk_lib_dir="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")"

## Cleanup state, torn down in reverse by the EXIT trap regardless of outcome. Each step is
## best-effort/idempotent so a partial setup still unwinds; the ':-' guards let a tool that
## leaves one state var unset (e.g. no fs_list) still run cleanup under nounset.
cleanup() {
   if [ -n "${mnt_dir:-}" ] && mountpoint --quiet -- "${mnt_dir}"; then
      umount -- "${mnt_dir}" || true
   fi
   if [ -n "${mnt_dir:-}" ]; then
      rmdir -- "${mnt_dir}" 2>/dev/null || true
   fi
   ## mnt_base is the 0700 parent some tools put the mountpoint inside (so the mount taking
   ## the guest root inode's mode cannot expose the tree to other local users); remove it
   ## after its mnt_dir child. Unset for a tool that mounts directly on mnt_dir.
   if [ -n "${mnt_base:-}" ]; then
      rmdir -- "${mnt_base}" 2>/dev/null || true
   fi
   if [ -n "${fs_list:-}" ]; then
      safe-rm --force -- "${fs_list}" 2>/dev/null || true
   fi
   if [ -n "${vg_activated:-}" ]; then
      ## Scope the deactivation to the guest PV (vg_dev, the LUKS mapping -- still open here,
      ## cryptsetup close runs after this), exactly as the activation was: a bare VG NAME could
      ## otherwise deactivate a same-named HOST VG (e.g. ubuntu-vg). See candidate_filesystems.
      vgchange --devices "${vg_dev:-}" --activate n -- "${vg_activated}" >/dev/null 2>&1 || true
   fi
   if [ -n "${luks_name:-}" ] && [ -e "/dev/mapper/${luks_name}" ]; then
      cryptsetup close -- "${luks_name}" || true
   fi
   if [ -n "${nbd_dev:-}" ]; then
      qemu-nbd --disconnect "${nbd_dev}" >/dev/null 2>&1 || true
   fi
}

## Open LUKS volume $1 as mapping $2 with the passphrase file. MODE ($3, default
## 'readonly') adds cryptsetup --readonly; 'rw' opens writable. The file is text: its
## trailing newline is not part of the key, which the installer typed without one. Read it
## as dm-calamares-install does ("$()" drops trailing newlines) and hand cryptsetup the
## bare bytes on stdin -- --key-file PATH would read the file byte for byte, newline
## included, and fail to unlock. Cap the read with head: a LUKS key is tiny, so a
## --passphrase-file mispointed at an endless device (/dev/zero, /dev/urandom) cannot spin
## or OOM this root process; a real key is far under the cap.
luks_open() {
   local luks_target="$1" mapping="$2" mode="${3:-readonly}"
   ## Handle the passphrase in a subshell with xtrace OFF: under 'bash -x' debug a bare
   ## 'passphrase=$(...)' assignment would print '+ passphrase=<secret>' to stderr/logs. The
   ## subshell keeps both the secret AND the 'set +x' off the caller's trace. The $() is still
   ## required -- it strips the trailing newline (not part of the key; see above), which a
   ## direct 'head | cryptsetup' would pass through and fail to unlock.
   ## style-ok: R-011 -- 'set +x' hides a secret from xtrace, not an errexit toggle.
   (
      set +x
      passphrase="$(head --bytes=1048576 -- "${passphrase_file}")"
      [ -n "${passphrase}" ] || die "passphrase file is empty: '${passphrase_file}'"
      if [ "${mode}" = 'rw' ]; then
         printf '%s' "${passphrase}" \
            | cryptsetup open --key-file - -- "${luks_target}" "${mapping}"
      else
         printf '%s' "${passphrase}" \
            | cryptsetup --readonly open --key-file - -- "${luks_target}" "${mapping}"
      fi
   )
}

## Block until the kernel has published the connected disk's partition nodes (the
## partprobe uevents are async). Bounded, so a blank disk still returns rather than hanging.
## A whole-disk image (a filesystem / LUKS signature DIRECTLY on the device, no partition
## table) has no partition nodes to wait for and counts as settled at once. A PARTITIONED
## image is settled ONLY once its first partition node exists: treating a partition-table
## signature (PTTYPE=) as "settled" would return before udev created /dev/<dev>pN, so the
## caller's LUKS/filesystem scan would find no partitions and wrongly die on a valid image.
settle_partitions() {
   local dev="$1" i probe
   partprobe "${dev}" 2>/dev/null || true
   for ((i = 0; i < 40; i++)); do
      udevadm settle 2>/dev/null || true
      if [ -b "${dev}p1" ]; then
         return 0
      fi
      ## Whole-disk signature = a TYPE= line (filesystem/crypto_LUKS) with NO PTTYPE= line
      ## (no partition table). Then there are no partitions to wait for. --probe forces a
      ## LIVE low-level probe of the device: plain blkid serves a ~2s /run/blkid cache, and
      ## free_nbd reuses the same /dev/nbdN, so a stale TYPE= from a prior image on that node
      ## would satisfy this predicate and return before the new image's partition node exists.
      probe="$(blkid --probe --output export -- "${dev}" 2>/dev/null || true)"
      if grep --quiet '^TYPE=' <<< "${probe}" && ! grep --quiet '^PTTYPE=' <<< "${probe}"; then
         return 0
      fi
      sleep 0.25
   done
}

## Connect DISK at /dev/nbd device DEV with an EXPLICIT format (never probed). Probing an
## untrusted image is a footgun: a crafted VMDK descriptor or a qcow2 backing-file reference
## redirects qemu-nbd's reads/writes onto an arbitrary HOST path, so the format is always
## pinned by the caller. MODE 'readonly' adds --read-only; anything else connects writable.
nbd_connect() {
   local dev="$1" disk="$2" format="$3" mode="${4:-rw}"
   ## Defense in depth for EVERY caller AND every format: pinning the format is not enough for a
   ## MULTI-FILE format. A crafted VMDK FLAT/SPARSE extent or a qcow2 backing file ('RW ... FLAT
   ## "/etc/shadow"') points qemu-nbd's ROOT-level open at an arbitrary HOST path -> root
   ## read/write. So require the image to be SELF-CONTAINED (every referenced file resolves to the
   ## disk itself) before opening it -- UNIFORMLY, including vdi: a single-file vdi passes the
   ## check (its only referenced path is the disk itself), so there is no reason to special-case
   ## it, and a uniform gate cannot regress if a future format is wrongly assumed single-file.
   ## vbox-grub-set-next-boot-mode also pre-checks as the unprivileged caller; this guards the
   ## direct image-mount / vbox-disk-extract paths.
   local self_contained="${QEMU_IMAGE_SELF_CONTAINED:-${vbox_disk_lib_dir}/qemu-image-self-contained}"
   "${self_contained}" "${disk}" "${format}" \
      || die "refusing '${disk}': format '${format}' references a file outside the disk (crafted extent/backing -> host-path escalation)"
   ## ACCEPTED-TOCTOU BOUNDARY (do NOT re-fix without operator sign-off): this gate closes crafted
   ## IMAGE CONTENT, not an active swap of the "${disk}" PATH between the caller-side check and the
   ## root-side open below. A path swap is the documented, operator-accepted disk-path TOCTOU
   ## (trusted-vboxusers-runner model); the full fix is fd-passing (open O_NOFOLLOW once, hand the
   ## fd to qemu-nbd) -- a known residual, out of scope here.
   if [ "${mode}" = 'readonly' ]; then
      qemu-nbd --read-only --format "${format}" --connect="${dev}" -- "${disk}"
   else
      qemu-nbd --format "${format}" --connect="${dev}" -- "${disk}"
   fi
}

## First unused WHOLE-DISK /dev/nbdN (size 0 = not connected). Whole-disk only: with
## 'modprobe nbd max_part=16' the kernel also publishes partition nodes nbdNpM. An unused
## partition slot reads size 0 and sorts BEFORE a free whole disk (nbd0p1 < nbd1 under
## LC_ALL=C), so without the nbd[0-9]+ filter free_nbd could hand back a partition of a BUSY
## device: the qemu-nbd connect then fails and the EXIT trap disconnects that partition (not a
## device we hold) while the mount never happens though a whole disk was free. NBD_SYSFS_BASE
## overrides the sysfs root for unit tests (production: /sys/class/block, byte-identical).
free_nbd() {
   local d name base="${NBD_SYSFS_BASE:-/sys/class/block}"
   for d in "${base}"/nbd*; do
      name="${d##*/}"
      [[ "${name}" =~ ^nbd[0-9]+$ ]] || continue
      if [ "$(cat "${d}/size")" = '0' ]; then
         printf '%s' "/dev/${name}"
         return 0
      fi
   done
   die "no free /dev/nbd device"
}

## Create the mountpoint inside a 0700 PARENT. Once a filesystem is mounted, the mountpoint
## inode takes the GUEST root's mode (typically 0755), so other local users could traverse the
## decrypted guest tree while it is mounted; the 0700 parent (not the mountpoint) blocks that.
## Sets mnt_base (the 0700 parent, 'mktemp --directory' is 0700; cleanup removes it after
## mnt_dir) and mnt_dir (the mountpoint inside it). realpath so a caller's realpath-prefix
## confinement holds even when an ancestor of TMPDIR is a symlink. Single source so
## image-mount and vbox-disk-extract cannot drift on this invariant.
make_private_mountpoint() {
   mnt_base="$(realpath -- "$(mktemp --directory)")"
   mnt_dir="${mnt_base}/mnt"
   mkdir -- "${mnt_dir}"
}

## Echo the candidate block devices that may hold a filesystem: the LUKS mapping and any
## LVs it exposes, else the disk's own partitions.
candidate_filesystems() {
   if [ -n "${luks_name:-}" ]; then
      local mapped="/dev/mapper/${luks_name}"
      ## LVM inside LUKS: activate the VG and list its LVs; otherwise the mapping itself is
      ## the filesystem. pvs exits non-zero when the mapping is a plain filesystem (not an
      ## LVM PV); that is expected, so tolerate it rather than letting errexit abort.
      ## SCOPE every LVM op to the guest PV with --devices: a bare VG NAME activates by name
      ## across ALL visible PVs, so a guest VG named like a HOST VG (e.g. ubuntu-vg) would
      ## activate the HOST VG and expose its LVs to the mount. --devices restricts LVM to the
      ## guest mapping only, so only the guest VG is ever seen -- even on a name collision.
      local vg
      vg="$(pvs --devices "${mapped}" --noheadings --options vg_name -- "${mapped}" 2>/dev/null | tr -d ' ' || true)"
      if [ -n "${vg}" ]; then
         ## Record the VG for cleanup BEFORE activating. A vgchange that activates one LV then
         ## returns nonzero (a second LV with an unsupported segment) aborts under errexit
         ## before any post-call assignment, so recording AFTER the call would leave
         ## vg_activated empty and cleanup would skip 'vgchange --activate n' -- leaking the
         ## activated LV + nbd + LUKS mapping. vg and mapped are both known here.
         vg_activated="${vg}"
         vg_dev="${mapped}"
         vgchange --devices "${mapped}" --activate y -- "${vg}" >/dev/null
         lvs --devices "${mapped}" --noheadings --options lv_path -- "${vg}" 2>/dev/null | tr -d ' '
      else
         printf '%s\n' "${mapped}"
      fi
   else
      ## Plain disk: its partitions, or the whole device for an unpartitioned image.
      local p printed='false'
      for p in "${nbd_dev}"p*; do
         if [ -b "${p}" ]; then
            printf '%s\n' "${p}"
            printed='true'
         fi
      done
      if [ "${printed}" = 'false' ]; then
         printf '%s\n' "${nbd_dev}"
      fi
   fi
}
