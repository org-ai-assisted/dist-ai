"""Split an anon-leak-test battery JSON verdict into per-probe story-card records.

dm-whonix-pair's leak lane carded the WHOLE battery JSON as ONE card, so the
published "story" collapsed every per-probe check (enumerate, icmp-clearnet,
udp-clearnet, tor-confirm, gateway-craft, ...) into a single JSON dump. This
reads the battery JSON on stdin and prints one card record per probe PLUS a
leading verdict summary, so the lane can publish a comprehensive, correctly
ordered narrative -- a reader verifies WHICH checks ran and each one's result,
on PASS and on FAIL/INCONCLUSIVE alike.

The battery JSON (anon-leak-test --json) is:
  {"results": [{"probe", "status", "message", "detail"}, ...],
   "leak_detected": bool, "exit_code": int}
Transport (guestcontrol) may wrap it in noise AND emit earlier, irrelevant
objects (e.g. an empty '{"results": []}' warning) before the real verdict.

The verdict is NEVER re-derived here: it is classified by the SAME single-source
classifier (leak-exit-classify) dm-whonix-pair's probe_verdict uses, so the story
can never disagree with the published pass/fail. A per-probe story is emitted ONLY
when the one cardable JSON object matches that authoritative verdict; on ANY
divergence or ambiguity the helper exits 2 and the caller keeps the raw JSON, so a
real leak can never be silently dropped from the published evidence.

Argv: <base-nn> <summary-name>. Output (stdout), one card per line:
  <nn> <name> <b64-title> <b64-body>
where nn = base (summary) then base+1, base+2, ... (runtime order), name is a
publisher-safe label, and title/body are base64 (line-framed, newline-safe).

Exit: 0 one-or-more records emitted; 2 no authoritative battery verdict to card
(the caller falls back to a single raw-JSON card, so the evidence is never lost).
"""

import base64
import json
import os
import string
import subprocess
import sys

## The publisher (results-publish.bsh) drops any card milestone outside ASCII [A-Za-z0-9._-],
## plus a leading '-' and a bare '.' / '..'. Mirror that charset so every per-probe card publishes.
_SAFE_CHARS = frozenset(string.ascii_letters + string.digits + "._-")

## The shared verdict classifier (dm-whonix-pair's probe_verdict uses the same one): checkout
## sibling by default, overridable via LEAK_EXIT_CLASSIFY so a test drives the in-tree copy.
_CLASSIFY = os.environ.get("LEAK_EXIT_CLASSIFY") or os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "leak-exit-classify")


def classify(text):
    """The run's verdict as probe_verdict classifies it: 'clear' / 'leak' / 'inconclusive'.
    Delegated to the SINGLE shared classifier (never a parallel JSON parse), so the story can
    never re-derive a verdict that diverges from the authoritative sed+case."""
    result = subprocess.run([_CLASSIFY], input=text.encode("utf-8"),
                            stdout=subprocess.PIPE, check=True)
    return result.stdout.decode("ascii").strip()


def verdict_objects(text):
    """Every top-level JSON object carrying a STRICT integer 'exit_code'. A JSON boolean is
    excluded (type(True) is not int, though isinstance(True, int) is True), so a boolean decoy
    cannot pose as the verdict. The real anon-leak-test output is exactly one such object; a
    transport warning (e.g. '{"results": []}') carries none."""
    decoder = json.JSONDecoder()
    index = 0
    length = len(text)
    found = []
    while index < length:
        start = text.find("{", index)
        if start == -1:
            break
        try:
            obj, end = decoder.raw_decode(text, start)
        except ValueError:
            index = start + 1
            continue
        if isinstance(obj, dict) and type(obj.get("exit_code")) is int:  # exact int: reject bool
            found.append(obj)
        index = end if end > start else start + 1
    return found


def safe_label(name, fallback):
    """Collapse a probe name to the publisher's EXACT safe-label charset (results-publish.bsh):
    ASCII [A-Za-z0-9._-], every other char (incl. non-ASCII letters) mapped to '_', never a
    leading '-' (argparse-eatable) and never a bare '.' / '..' -- the publisher drops all three,
    so without this a card would parse locally yet vanish from the published story."""
    cleaned = "".join(char if char in _SAFE_CHARS else "_" for char in str(name))
    cleaned = cleaned.lstrip("-")
    if cleaned in ("", ".", ".."):
        return fallback
    return cleaned


def encode(text):
    """base64 one field to a single whitespace-free token (newline-safe framing)."""
    return base64.b64encode(text.encode("utf-8")).decode("ascii")


def emit(nn, name, title, body):
    sys.stdout.write("%d %s %s %s\n" % (nn, name, encode(title), encode(body)))


def main(argv):
    if len(argv) != 2:
        sys.stderr.write("usage: battery-story-cards <base-nn> <summary-name>\n")
        return 2
    base = int(argv[0])
    summary_name = safe_label(argv[1], "leak-battery")

    text = sys.stdin.read()

    ## The authoritative verdict (the SAME one probe_verdict classifies the run from). A per-probe
    ## story is published ONLY when the one cardable object matches it; ANY divergence or ambiguity
    ## falls back (exit 2) to the caller's single raw-JSON card, so a real leak is never dropped.
    authoritative = classify(text)

    ## Exactly one strict-int exit_code object = the one real verdict. Zero (nothing to card) or
    ## more than one (an ambiguous decoy) -> fall back; never guess which object is real.
    objects = verdict_objects(text)
    if len(objects) != 1:
        return 2
    verdict = objects[0]

    ## The carded object's own verdict, by the SAME classifier. A bare decoy line (CR-prefixed,
    ## leading-zero like 01, or a non-ASCII digit) shifts the authoritative exit_code without a
    ## matching JSON object, so these differ -> fall back rather than publish a contradicting story.
    if classify('  "exit_code": %d\n' % verdict["exit_code"]) != authoritative:
        return 2

    results = verdict.get("results")
    ## A non-list / null 'results' is NOT cardable; fall back so its raw evidence survives, never
    ## coerce it to an empty list and publish a probe-less story.
    if not isinstance(results, list):
        return 2

    exit_code = verdict.get("exit_code")
    leak_detected = verdict.get("leak_detected")
    total = len(results)

    ## Verdict summary (headline): the overall exit, the leak flag, and a one-line
    ## roll-up of each probe's status -- the per-probe cards below carry the detail.
    roster = "\n".join(
        "  - %s: %s -- %s" % (result.get("probe", "?"),
                              result.get("status", "?"),
                              result.get("message", ""))
        for result in results)
    summary_title = ("Leak battery verdict: exit_code=%s, leak_detected=%s (%d probe(s))"
                     % (exit_code, leak_detected, total))
    summary_body = ("Per-probe roll-up (each probe is its own card below):\n%s"
                    % roster)
    emit(base, summary_name, summary_title, summary_body)

    ## One card per probe, in the battery's run order, carded on PASS and on
    ## FAIL/ERROR alike so a failing/inconclusive battery still shows WHICH check
    ## failed and why.
    for offset, result in enumerate(results, start=1):
        probe = result.get("probe", "probe%d" % offset)
        status = result.get("status", "UNKNOWN")
        message = result.get("message", "")
        detail = result.get("detail") or {}
        name = safe_label(probe, "probe%d" % offset)
        title = "Leak probe %d/%d: %s -- %s" % (offset, total, probe, status)
        body = message
        if detail:
            body = "%s\n\ndetail:\n%s" % (
                message, json.dumps(detail, indent=2, sort_keys=True))
        emit(base + offset, name, title, body)

    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
