#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Regression suite for sdwdate itself (not sdwdate-gui). Covers the retry
## pacing of SdwdateClass.preparation, the loop that gates time fetching on
## onion-time-pre-script. No Tor, no privleap, no root, no network: the
## pre-script child is stubbed and sleeps are recorded rather than taken.
##
## The subject is resolved by sdwdate_testlib:
##   * SDWDATE_REPO=/path/to/sdwdate -> that checkout, OR
##   * unset -> the installed package (/usr/lib/python3/dist-packages).
##
## Importing sdwdate.sdwdate additionally needs guimessages + sanitize_string
## from helper-scripts on PYTHONPATH, plus python3-sdnotify, python3-dateutil
## and python3-stem.
##
## Any extra arguments are forwarded to "python3 -m unittest".

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/sdwdate-tests" ]; then
   tests_dir="${script_dir}/../share/sdwdate-tests"
else
   tests_dir='/usr/share/sdwdate-tests'
fi

python3 -m unittest discover \
   --start-directory "${tests_dir}" \
   --pattern 'test_*.py' \
   "$@"
