#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## End-to-end handshake suite for sdwdate-gui: chains the REAL maintainer,
## responder, and proxy across simulated server up/down transitions, headless
## and without live qubes (the no-qubes core of E2E-LIVE-TEST-PLAN.md). Works
## installed (/usr/share/sdwdate-gui-tests) and from a git checkout. Driven
## through run-unittest.py so an all-skipped run (the subject module absent)
## surfaces as SKIP, never a green PASS.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## coverage/import side effects: keep the checkout free of .pyc.
export PYTHONDONTWRITEBYTECODE=1

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/sdwdate-gui-tests" ]; then
  tests_dir="${script_dir}/../share/sdwdate-gui-tests"
else
  tests_dir='/usr/share/sdwdate-gui-tests'
fi
e2e_dir="${tests_dir}/e2e"

## The e2e modules import bash_harness_common from the PARENT tests directory,
## while discovery starts in e2e/. Put the parent dir first on PYTHONPATH,
## keeping the sdwdate_gui dist-packages path the orchestrator's wire provides.
export PYTHONPATH="${tests_dir}${PYTHONPATH:+:${PYTHONPATH}}"

run_unittest="${script_dir}/../share/dist-ai-tests-common/run-unittest.py"
[ -r "${run_unittest}" ] || run_unittest='/usr/share/dist-ai-tests-common/run-unittest.py'

## run-unittest.py maps all-skipped / nothing-collected to a surfaced SKIP. Its
## exit code is the suite's -- last command, so errexit propagates it.
"${run_unittest}" --start-directory "${e2e_dir}" --pattern 'test_*.py' "$@"
