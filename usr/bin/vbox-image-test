#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Dev-VM orchestrator for VBox image testing + publishing.
##
## Runs each dm-release-test LANE on the OVH server (via server-exec, as root), then ALWAYS
## publishes the results plane to the public Pages site (test-results-deploy) ONCE, via an EXIT
## trap -- so publishing (the end goal) is never forgotten, even on a lane failure or an interrupt.
##
## WHY a dev-VM orchestrator: dm-release-test runs ON the OVH server (VBox / accounts / AMD-V, and
## writes /var/www/results there); test-results-deploy runs HERE on the dev VM, which holds the
## Pages repo + push credentials (the server has neither, and is push-refused). So the "run test,
## then publish" step spans two machines and belongs in this dev-VM tool, not in dm-release-test.
##
## Lanes run SEQUENTIALLY (one VBox run at a time); the publish is a single batch deploy at the end.
##
## Usage:
##   vbox-image-test [--no-publish] 'GUEST IFACE [dm-release-test args]' ['GUEST IFACE ...' ...]
## Each argument is one dm-release-test invocation's args, e.g.:
##   vbox-image-test \
##     "kicksecure lxqt --iso /home/admin/derivative-binary/<v>/Kicksecure-LXQt-<v>.Intel_AMD64.iso" \
##     "whonix lxqt --lane inst --channel stable" \
##     "whonix lxqt --lane leak --version 18.2.1.9"
##
## A lane runs ~40-50 min, so a multi-lane batch is HOURS -- drive it durably:
##   bgjob-run --name vbox-image-test --progress ~/private-cache/bgjob/vit.log --max-runtime 0 \
##     -- vbox-image-test '<lane>' '<lane>'

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"

publish="true"
local_repo=""
lanes=()
while [ "$#" -ge 1 ]; do
   case "$1" in
      --no-publish)
         publish="false"
         shift
         ;;
      --local-repo)
         [ "$#" -ge 2 ] || { printf '%s\n' "${me}: --local-repo needs kicksecure|whonix" >&2; exit 64; }
         case "$2" in
            kicksecure|whonix)
               local_repo="$2"
               ;;
            *)
               printf '%s\n' "${me}: --local-repo must be kicksecure|whonix, got '$2'" >&2
               exit 64
               ;;
         esac
         shift 2
         ;;
      --)
         shift
         break
         ;;
      -*)
         printf '%s\n' "${me}: unknown option '$1'" >&2
         exit 64
         ;;
      *)
         lanes+=("$1")
         shift
         ;;
   esac
done
[ "$#" -eq 0 ] || lanes+=("$@")
if [ "${#lanes[@]}" -lt 1 ]; then
   printf '%s\n' "usage: ${me} [--no-publish] [--local-repo kicksecure|whonix] 'GUEST IFACE [dm-release-test args]' ..." >&2
   exit 64
fi

## --local-repo appends `--local-repo <deriv>` to each whonix CLI INST lane (the only lane that can
## upgrade from the fast LOCAL apt repo -- repo-add-local needs root, which only the split-free CLI
## edition's user has; dm-release-test rejects it on any other lane). Lanes are opaque strings here,
## so match `whonix cli ` + a `--lane inst` token; leave every other lane untouched.
if [ -n "${local_repo}" ]; then
   for i in "${!lanes[@]}"; do
      ## Two independent matches (one glob cannot do AND without space-overlap bugs): the lane must
      ## START `whonix cli ` AND carry a `--lane inst ` token (subject space-wrapped so the token
      ## matches at the end too). Every other lane is left byte-unchanged.
      case "${lanes[i]}" in
         "whonix cli "*)
            ;;
         *)
            continue
            ;;
      esac
      case " ${lanes[i]} " in
         *" --lane inst "*)
            lanes[i]="${lanes[i]} --local-repo ${local_repo}"
            ;;
      esac
   done
fi

## Defense in depth: each lane is split with `read -r -a <<<`, which TRUNCATES at a newline (so a
## newline-bearing spec would silently drop its tail -- and the dropped args would not reach the
## remote dm-release-test). Every lane field is already whitespace/newline-rejected upstream, so
## this is belt-and-braces; reject a newline-bearing spec loudly here, BEFORE the publish trap is
## armed (so a rejected usage error never triggers a spurious publish).
nl=$'\n'
for spec in "${lanes[@]}"; do
   case "${spec}" in
      *"${nl}"*)
         printf '%s\n' "${me}: lane spec must not contain a newline: '${spec}'" >&2
         exit 64
         ;;
   esac
   ## A lane is whitespace-SPLIT (read -r -a) before each token is %q-quoted for the remote shell, so
   ## a quoted path with spaces cannot survive: read -r -a splits on the space and keeps the quote as
   ## a literal, and dm-release-test then rejects the stray token. Rather than reinvent a shell quote
   ## parser, reject a lane containing a quote -- a clear error here beats a confusing downstream arg
   ## failure. A path in a lane must be space-free (vbox-image-test-default enforces this upstream).
   case "${spec}" in
      *[\"\']*)
         printf '%s\n' "${me}: lane spec must not contain quotes; a path in a lane must be space-free: '${spec}'" >&2
         exit 64
         ;;
   esac
done

## Publish exactly once, on ANY exit (success, a lane failure, or an interrupt) -- the whole point
## is that the operator never has to remember test-results-deploy. A publish failure does NOT
## mask the lanes' verdict (the results stay on the plane for a manual re-run).
published="false"
# shellcheck disable=SC2317  # invoked via the EXIT trap, not inline
do_publish() {
   [ "${publish}" = "true" ] || return 0
   [ "${published}" = "false" ] || return 0
   published="true"
   printf '%s\n' "${me}: publishing results to the Pages site (test-results-deploy) ..." >&2
   if ! test-results-deploy; then
      printf '%s\n' "${me}: WARNING: test-results-deploy FAILED -- results remain on the plane; re-run 'test-results-deploy'" >&2
   fi
}
trap do_publish EXIT

rc=0
for spec in "${lanes[@]}"; do
   printf '%s\n' "${me}: lane: dm-release-test ${spec}" >&2
   ## The lane is a single space-joined string; split it LOCALLY into dm-release-test's args (the
   ## intended split), then rebuild the remote command with each token %q-quoted. server-exec --cmd
   ## runs as a REMOTE bash script AS ROOT, so an unquoted spec would word-split AND interpret shell
   ## metachars THERE; %q neutralizes that (a space-bearing --iso/--coreboot-rom path is already
   ## rejected upstream in vbox-image-test-default). --timeout 0: an install lane runs ~40-50 min;
   ## never let server-exec kill it mid-run.
   # shellcheck disable=SC2086  # the LOCAL word-split of ${spec} into argv is intended
   read -r -a lane_argv <<< "${spec}"
   remote_cmd="$(printf '%q ' dm-release-test "${lane_argv[@]}")"
   server-exec --user root --timeout 0 --cmd "${remote_cmd}" || rc=$?
done
exit "${rc}"
