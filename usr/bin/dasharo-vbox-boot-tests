#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## End-to-end regression lane for the Dasharo-in-VirtualBox port: a patched
## VirtualBox (DevEFI CorebootRom + DevACPI SLP_EN fixes, org-ai-assisted/virtualbox)
## boots a coreboot + UefiPayloadPkg ROM (org-ai-assisted/dasharo). The UefiPayload
## publishes a GOP on VBox's linear framebuffer, so the firmware renders GRAPHICALLY;
## the lane captures a milestone screenshot sequence (NN-<milestone>.png) and verifies
## the interactive UEFI shell on serial + a clean ACPI S5 power-off (reset -s).
##
## Reuses the image-test harness: the VBoxManage plan + verdict come from the shared
## dm-smbios-reader-vbox backend ('firmware' subcommand), and the milestone shots are
## published through the SAME image_test_results_publish directory branch every image
## lane uses -- so the result page renders identically (see AGENTS.md in this dir).
##
## Opt-in: registered in dist-ai-tests-all's e2e_suites (CI runs --core only, so this
## never gates PRs), and SKIPs unless the boot environment is present -- the patched
## non-hardened VBox build (run as root for /dev/vboxdrv) plus the ROM. Provide them:
##   DASHARO_COREBOOT_ROM   path to the coreboot + UefiPayloadPkg ROM (required to boot)
##   DASHARO_VBOX_BIN       dir holding the patched VBoxManage (else PATH)
##
## Exit codes (dist-ai-tests-all contract): 0 PASS, 77 SKIP (no ROM / no bootable VBox
## here / unbootable environment), else FAIL.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

SKIP=77

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/dasharo-vbox-boot-tests" ]; then
   tests_dir="${script_dir}/../share/dasharo-vbox-boot-tests"
else
   tests_dir='/usr/share/dasharo-vbox-boot-tests'
fi

if [ -x "${script_dir}/../share/dm-smbios-reader-boot-tests/dm-smbios-reader-vbox" ]; then
   backend="${script_dir}/../share/dm-smbios-reader-boot-tests/dm-smbios-reader-vbox"
else
   backend='/usr/share/dm-smbios-reader-boot-tests/dm-smbios-reader-vbox'
fi

## Thin smoke test first: it runs on every invocation (CI included) and a failure here
## is a real FAIL, not a SKIP. It only asserts the backend contract this lane depends on
## (the coreboot plan builder + verdict predicates); the backend's full pure-logic suite
## is dm-smbios-reader-vbox-tests. python3-pytest is a hard dependency of this package.
## style-ok: allow-python-interpreter -- python3 -c dep probe
if ! python3 -c 'import pytest' 2>/dev/null; then
   printf '%s\n' "dasharo-vbox-boot-tests: python3-pytest is missing; the unit tests cannot run. FAIL." >&2
   exit 1
fi
python3 -m pytest -q "${tests_dir}"/test_*.py

## SKIP when there is no ROM to boot: this lane only runs on a host that has a built
## coreboot + UefiPayloadPkg ROM, never in the generic trixie-slim CI container.
rom="${DASHARO_COREBOOT_ROM:-}"
if [ -z "${rom}" ]; then
   printf '%s\n' "dasharo-vbox-boot-tests: DASHARO_COREBOOT_ROM unset; no ROM to boot. SKIP." >&2
   ## style-ok: allow-skip: no coreboot ROM supplied -- an opt-in boot target
   exit "${SKIP}"
fi

## The patched VBoxManage is a non-default, opt-in build; its absence means this host
## cannot run the boot test, not that the test failed.
vbox_bin="${DASHARO_VBOX_BIN:-}"
## A DASHARO_VBOX_BIN that holds no VBoxManage falls through to PATH.
if [ -n "${vbox_bin}" ] && [ ! -x "${vbox_bin}/VBoxManage" ]; then
   vbox_bin=''
fi
if [ -z "${vbox_bin}" ] && ! type -P VBoxManage >/dev/null 2>&1; then
   printf '%s\n' "dasharo-vbox-boot-tests: no VBoxManage (set DASHARO_VBOX_BIN to the patched build); cannot boot-test here. SKIP." >&2
   ## style-ok: allow-skip: patched VirtualBox not present -- an opt-in boot target
   exit "${SKIP}"
fi

## A source-built VBoxManage resolves its shared libs from its own bin dir.
vboxmanage='VBoxManage'
if [ -n "${vbox_bin}" ]; then
   vboxmanage="${vbox_bin}/VBoxManage"
   export LD_LIBRARY_PATH="${vbox_bin}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
fi

## Drive the firmware boot test via the shared backend, capturing a milestone shot
## sequence into shot_dir. COM1 is a host UNIX socket the backend creates + removes.
shot_dir="$(mktemp --directory)"
uart_socket="$(mktemp --dry-run --tmpdir dasharo-uart.XXXXXX.sock)"
## The backend writes the captured COM1 firmware serial text here; the firmware-identity step
## below greps it for coreboot's banner as the DETECTED signal.
serial_log="$(mktemp --tmpdir dasharo-serial.XXXXXX.log)"
cleanup() {
   ## Reached only via the EXIT trap, which shellcheck does not trace (SC2317).
   # shellcheck disable=SC2317
   safe-rm --recursive --force -- "${shot_dir}"
   # shellcheck disable=SC2317
   safe-rm --force -- "${uart_socket}"
   # shellcheck disable=SC2317
   safe-rm --force -- "${serial_log}"
}
trap cleanup EXIT

## Serialize the actual VM boot under the shared VM-work lock (class=work): it excludes a
## concurrent leak test and claims a slot so concurrent VM boots cannot oversubscribe the host
## CPUs. Wrapped around the BOOT ONLY, not the whole script -- the pytest smoke above runs in
## the generic CI container where /run/dm-vm-lock does not exist; taking the lock there would
## wrongly die. dm-vm-lock's reentrancy passes through when a caller already holds the lock.
boot_cmd=(
   python3 "${backend}" firmware
   --vm 'dasharo-vbox-boot' --rom "${rom}"
   --uart-socket "${uart_socket}" --shot-dir "${shot_dir}"
   --serial-log "${serial_log}"
   --vboxmanage "${vboxmanage}" "$@"
)
rc=0
dm-vm-lock acquire --class work --ttl "${DASHARO_VBOX_LOCK_TTL:-3600}" -- "${boot_cmd[@]}" || rc=$?

## Any non-zero backend rc is a real FAIL here: the genuinely-optional cases (no ROM,
## no patched VBox) already SKIP above, BEFORE the backend runs. A backend SETUP (2)
## -- no root for /dev/vboxdrv, AMD-V held, a bad "$@" flag (argparse also exits 2) --
## is a misconfiguration of an opt-in boot the operator asked for, not a skip. Never
## map it to SKIP: that would hide an argparse usage error as a clean skip.

## Opt-in: publish the verdict + the milestone shot sequence to the automated-test-results
## plane, so this lane shows on org-ai-assisted.github.io/automated-test-results/ with the
## SAME "full story" screenshots as the image boot lanes (run test-results-deploy from the
## qube afterwards to render the plane). Enabled by DASHARO_VBOX_PUBLISH=1 or by setting
## IMAGE_TEST_RESULTS_ROOT; needs root + the plane dir, and only for a real verdict (0/5),
## never a SKIP. shot_dir is passed as shot_src -- the publisher's DIRECTORY branch
## attaches each NN-<milestone>.png in order, so no second result.json writer is needed.
if { [ "${DASHARO_VBOX_PUBLISH:-}" = '1' ] || [ -n "${IMAGE_TEST_RESULTS_ROOT:-}" ]; } \
   && [ "${rc}" != "${SKIP}" ]; then
   results_root="${IMAGE_TEST_RESULTS_ROOT:-/var/www/results}"
   results_owner="${IMAGE_TEST_RESULTS_OWNER:-www-data}"
   if [ -d "${results_root}" ] && [ "$(id -u)" = '0' ]; then
      publisher="${script_dir}/../libexec/image-test/results-publish.bsh"
      if [ ! -f "${publisher}" ]; then
         publisher='/usr/libexec/image-test/results-publish.bsh'
      fi
      # shellcheck source=../libexec/image-test/results-publish.bsh
      source "${publisher}"
      ## Firmware identity for the results plane: declared dasharo-efi, detected from whether the
      ## captured COM1 log carries coreboot's own DEBUG banner (what stock VBox EFI never prints,
      ## so a fallback to VBox's EFI is a loud MATCH=false, not a silent pass). Classified by the
      ## shared dm-firmware-identity helper. Only when a non-empty serial log was captured (a real
      ## boot) -- a SETUP failure that produced no COM1 output emits no firmware fields.
      fw_args=()
      if [ -s "${serial_log}" ]; then
         fw_coreboot=0
         if grep --quiet -- 'coreboot-' "${serial_log}"; then
            fw_coreboot=1
         fi
         fw_identity="${script_dir}/dm-firmware-identity"
         [ -x "${fw_identity}" ] || fw_identity='dm-firmware-identity'
         fw_detected=''
         fw_match=''
         fw_id_out="$("${fw_identity}" --efi 1 --coreboot "${fw_coreboot}" --secureboot 0 --declared 'dasharo-efi' 2>/dev/null || true)"
         while IFS= read -r fw_line; do
            case "${fw_line}" in
               detected=*)
                  fw_detected="${fw_line#detected=}"
                  ;;
               match=*)
                  fw_match="${fw_line#match=}"
                  ;;
            esac
         done <<< "${fw_id_out}"
         ## Fail CLOSED: a missing/erroring classifier leaves detected/match empty. An empty match
         ## would be dropped -> null -> the results site reads it GREEN. Force detected=unverified
         ## and match to a definite true|false, and ALWAYS pass --env-firmware-match.
         [ -n "${fw_detected}" ] || fw_detected='unverified'
         case "${fw_match}" in
            true|false)
               ;;
            *)
               fw_match='false'
               ;;
         esac
         ## Evidence is free text from the serial log; PREFIX it with a fixed label so the value can
         ## never start with '--' (a 'coreboot-' line could, e.g. '--coreboot...'), which the
         ## publisher/emitter argparse would otherwise treat as a flag and fail the whole publish.
         fw_evidence_raw="$(grep --max-count=3 -- 'coreboot-' "${serial_log}" 2>/dev/null || true)"
         if [ -n "${fw_evidence_raw}" ]; then
            fw_evidence="COM1 coreboot banner: ${fw_evidence_raw}"
         else
            fw_evidence='no coreboot- banner on COM1 (VBox EFI fallback?)'
         fi
         fw_args=(
            --env-firmware-declared 'dasharo-efi'
            --env-firmware-detected "${fw_detected}"
            --env-firmware-evidence "${fw_evidence}"
            --env-firmware-match "${fw_match}"
         )
      fi
      ## lane / step-name must be label-safe ([A-Za-z0-9._-]); the publisher rejects
      ## spaces and punctuation (it writes them as root). shot_dir is the 7th positional
      ## (shot_src) -- a directory of NN-<milestone>.png, published as the "full story".
      image_test_results_publish \
         "${results_root}" "${results_owner}" "dasharo-vbox-boot" \
         "${SUDO_USER:-${USER:-root}}" "dasharo-vbox-boot" "${rc}" "${shot_dir}" \
         --lane "dasharo-coreboot-uefi-vbox" \
         --builder "dasharo-vbox-boot" --origin built \
         --step-name "boot-uefi-shell-and-acpi-s5" \
         "${fw_args[@]}" \
         || printf '%s\n' "dasharo-vbox-boot-tests: WARNING: results publish failed (verdict rc=${rc} preserved)." >&2
   else
      printf '%s\n' "dasharo-vbox-boot-tests: publish requested but no writable results plane / not root; skipping publish (verdict rc=${rc})." >&2
   fi
fi

exit "${rc}"
