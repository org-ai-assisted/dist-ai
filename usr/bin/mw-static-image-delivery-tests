#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Black-box regression for mw-static-generator's image-delivery byte-budget gate
## (tools/check-img-compression.py), which reproduces Google PageSpeed / Lighthouse's
## "Improve image delivery" per-image byte saving. The generator has no GitHub CI and
## the gate runs only in its deploy-time lint-gate.sh lane; this suite adds the missing
## CI coverage by DRIVING the real gate (resolved from MW_STATIC_GENERATOR_REPO) against
## fixtures it generates, copying no production constant. No root, no network.
##
## Target: an mw-static-generator checkout resolved from MW_STATIC_GENERATOR_REPO (or a
## default under the operator's private-sources, or a CI sibling). The gate IS the subject
## under test, so an absent checkout is FATAL (exit 1) -- a bare SKIP reads green -- UNLESS
## the invoking run authorized the skip (DIST_AI_SKIP_AUTHORIZED=1, which dist-ai-tests-all
## sets for a --allow-skip'd or lenient non-strict run), in which case it SKIPs (exit 77).
## The gate/CI env always provides the checkout, so there it simply runs.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/mw-static-image-delivery-tests" ]; then
   tests_dir="${script_dir}/../share/mw-static-image-delivery-tests"
else
   tests_dir='/usr/share/mw-static-image-delivery-tests'
fi

payload="${tests_dir}/test_img_delivery.py"
if [ ! -f "${payload}" ]; then
   printf '%s\n' "mw-static-image-delivery-tests: FATAL: payload not found: ${payload}" >&2
   exit 1
fi

repo=''
[ -v MW_STATIC_GENERATOR_REPO ] || MW_STATIC_GENERATOR_REPO=''
if [ -n "${MW_STATIC_GENERATOR_REPO}" ]; then
   repo="${MW_STATIC_GENERATOR_REPO}"
elif [ -f "${HOME}/private-sources/mw-static-generator/tools/check-img-compression.py" ]; then
   repo="${HOME}/private-sources/mw-static-generator"
elif [ -f "${script_dir}/../../../../mw-static-generator/tools/check-img-compression.py" ]; then
   repo="${script_dir}/../../../../mw-static-generator"
fi

if [ -z "${repo}" ] || [ ! -f "${repo}/tools/check-img-compression.py" ]; then
   if [ "${DIST_AI_SKIP_AUTHORIZED:-}" = '1' ]; then
      printf '%s\n' 'mw-static-image-delivery-tests: SKIP (mw-static-generator not found; set MW_STATIC_GENERATOR_REPO) [authorized]' >&2
      ## style-ok: allow-skip: subject checkout absent AND the skip was authorized by the orchestrator (a bare SKIP would read green otherwise)
      exit 77
   fi
   printf '%s\n' 'mw-static-image-delivery-tests: FATAL: mw-static-generator checkout not found (set MW_STATIC_GENERATOR_REPO)' >&2
   exit 1
fi

export MW_STATIC_GENERATOR_REPO="${repo}"
## Invoke the payload via its own '#!/usr/bin/python3 -Bsu' shebang (R-193: do not
## launch a +x script through the interpreter, which drops the shebang flags). No
## exec (R-103). As the last command its exit status becomes the suite's (0/1).
"${payload}"
