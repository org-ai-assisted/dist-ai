#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## style-ok: no-has -- standalone gate wrapper; does not source helper-scripts.

## Static consistency checks for the project's GitHub Pages sites
## (output-lies.github.io, secure-terminal.github.io, org-ai-assisted.github.io):
## every internal link resolves to a real target (no reliance on redirects; known
## sibling project-Pages paths are allow-listed), the footer carries the uniform
## "family" links, prose capitalizes "Open Source"/"Free Software", and a
## review-status banner never claims a green "working" state. Pure Python, no
## network, no root. Each site checkout is resolved from an env var
## (OUTPUT_LIES_REPO, SECURE_TERMINAL_SITE_REPO, ORG_AI_ASSISTED_REPO) or a
## default under the operator's private-sources; if none is found it SKIPs
## (exit 77) rather than failing.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## Canonical suite exit: a browser lane that cannot run here (no Playwright and no
## sandbox) must surface as SKIP:env-unmet (78), never fold into a green pass --
## site-deploy treats a skip as a publish failure.
suite_exit_helper="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")/../share/dist-ai-tests-common/suite-exit.bash"
[ -r "${suite_exit_helper}" ] || suite_exit_helper='/usr/share/dist-ai-tests-common/suite-exit.bash'
# shellcheck source=../share/dist-ai-tests-common/suite-exit.bash
source "${suite_exit_helper}"

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/website-tests" ]; then
   tests_dir="${script_dir}/../share/website-tests"
else
   tests_dir='/usr/share/website-tests'
fi

run_required_unit_test() {
   ## A co-located, SHIPPED unit-regression test: its absence is a broken install, not an
   ## optional skip. A bare `if [ -f ... ]` guard lets a missing required test read as a
   ## green pass (silent green) -- run it (fail-fast on a real regression), FATAL if absent.
   local name="$1" path="${tests_dir}/$1"
   if [ -f "${path}" ]; then
      "${path}" || exit 1
   else
      printf '%s\n' "website-tests: FATAL: ${name} not found in ${tests_dir} (required test missing)" >&2
      exit 1
   fi
}

## Unit regression for check_site's own logic (the image-format gate + the
## render-source recognition it depends on). Fixture-based, no site checkout or
## image tools needed; a failure here is a real logic regression, so it fails the
## run outright rather than hiding behind the no-checkout SKIP below.
run_required_unit_test check_site_test.py

## Unit regression for check_mobile's browser-free logic (page discovery +
## gate wiring). Playwright is imported inside its main(), so this test runs
## everywhere without a browser; a failure is a real logic regression.
run_required_unit_test check_mobile_test.py

## Unit regression for check_width's browser-free logic (the offender predicate +
## gate wiring). Playwright is imported inside its main(), so this runs everywhere
## without a browser; a failure is a real logic regression.
run_required_unit_test check_width_test.py

## Unit regression for check_footer's browser-free logic (the misalignment
## predicate + gate wiring). Playwright is imported inside its main(), so this runs
## everywhere without a browser; a failure is a real logic regression.
run_required_unit_test check_footer_test.py

## Unit regression for check_seo's logic (host derivation, sitemap/robots
## renderers, the PNG size probe, the drift gate + its main() wiring). Pure
## stdlib, no site checkout; a failure is a real logic regression.
run_required_unit_test check_seo_test.py

## Regression for site-generate's write-safety guards (dirty fail-closed,
## symlink refusal). Uses git in a tempdir; no site checkout. A failure is a
## real logic regression.
run_required_unit_test site_generate_test.py

## Canary for webcheck.svg_safety's detector (every malicious SVG fixture flagged, a
## clean one passes); pure stdlib + defusedxml, no site checkout. A failure is a real
## logic regression.
run_required_unit_test check_svg_safety_test.py

## Unit regression for check_console's browser-free logic (allowlist fail-closed, hit
## classification, off-origin, URL join, retry clamp, page enumeration). Playwright is
## imported inside check(), so this runs everywhere without a browser.
run_required_unit_test check_console_test.py

## Unit regression for the vnu HTML-conformance lane's vnu-free engine (message
## ASCII-normalization, file:url->path mapping, error/info/problem classification, baseline
## round-trip, the accept-baseline comparison incl. missing-baseline-fails-closed). vnu itself
## is sandbox/JRE-only and not invoked by the engine, so this runs everywhere.
run_required_unit_test check_vnu_test.py
run_required_unit_test check_axe_test.py

## Unit regression for the cspell spell-check lane's browser-free logic (issue-line parser,
## baseline round-trip, finding_key, scan_root new-vs-baseline, fail-loud error handling).
## cspell itself is npm/sandbox-only and STUBBED in the test, so this runs everywhere.
run_required_unit_test check_spelling_test.py

## Unit regression for the dom-snapshot lane's browser-free logic (page-slug/list parse, the
## mount-host scrub incl. percent-encoded, the manifest volatile-header normalizer, mode catalog,
## normalize_dir, the capture/traversal hardening, and the wiki-* engine argv mapping). Playwright
## is imported inside capture(), so this runs everywhere.
run_required_unit_test check_domsnapshot_test.py

## Unit regression for the dom-snapshot engine's normalize.py -- the DOM_DIFF_HOST_SCRUB
## cross-host scrub, the prettify DoS cap, mw.user.options balance, all-malformed fail-loud. bs4 +
## lxml only, no browser.
run_required_unit_test ../domsnap-engine/tests/test_host_scrub.py

## Resolve each site root from its env var, else a private-sources default.
[ -v OUTPUT_LIES_REPO ] || OUTPUT_LIES_REPO=''
[ -v SECURE_TERMINAL_SITE_REPO ] || SECURE_TERMINAL_SITE_REPO=''
[ -v ORG_AI_ASSISTED_REPO ] || ORG_AI_ASSISTED_REPO=''
## The journal (computer-security-research) is BUILT by journal-maker; its served tree is
## the build output (_site, with its own index.html + .github/web-tests.yml policies:[journal]),
## NOT the source checkout (which has no index.html). So the default points at .../_site; an
## unset override with no built tree there is simply skipped (add_root), and an explicit
## override must point at a BUILT tree. The journal deploys via its own CI, so site-deploy does
## NOT publish it -- this lane only gates the local build.
[ -v COMPUTER_SECURITY_RESEARCH_REPO ] || COMPUTER_SECURITY_RESEARCH_REPO=''
## The defaults below are rooted at ${HOME}. An unset HOME is an UNEXPECTED, scrubbed
## environment -- NOT the normal "no site checkout on this host" case -- so it must FAIL,
## never be papered over as a SKIP (no unauthorized skips). Record it, then empty HOME so
## the ${HOME}-rooted default paths expand to absent absolute paths under nounset (no raw
## crash); the no-roots branch below turns that into a FATAL when HOME was the cause.
if [ -v HOME ] && [ -n "${HOME}" ]; then
   home_unset=''
else
   home_unset='yes'
   HOME=''
fi

declare -a roots=()
add_root(){
   local given
   local default

   given="$1"
   default="$2"
   ## An EXPLICIT override (env var set non-empty) that is not a real site checkout
   ## (no index.html) must FATAL, not silently fall back to the default -- otherwise the
   ## gate reports PASS on a DIFFERENT site than the operator asked for (silent green).
   ## An UNSET override legitimately falls back to the default.
   if [ -n "${given}" ]; then
      if [ -f "${given}/index.html" ]; then
         roots+=( "${given}" )
      else
         printf '%s\n' "website-tests: FATAL: site override '${given}' has no index.html (explicit-but-invalid checkout; refusing to silently test the default instead)" >&2
         exit 1
      fi
   elif [ -z "${home_unset}" ] && [ -f "${default}/index.html" ]; then
      ## Default fallback ONLY when HOME is set: under unset HOME the ${HOME}-rooted
      ## default is a bogus absolute /private-sources/... path; a root-level checkout
      ## there must NOT silently populate roots and bypass the home_unset FATAL below.
      roots+=( "${default}" )
   fi
}
add_root "${OUTPUT_LIES_REPO}"          "${HOME}/private-sources/output-lies.github.io"
add_root "${SECURE_TERMINAL_SITE_REPO}" "${HOME}/private-sources/secure-terminal.github.io"
add_root "${ORG_AI_ASSISTED_REPO}"      "${HOME}/private-sources/org-ai-assisted.github.io"
add_root "${COMPUTER_SECURITY_RESEARCH_REPO}" "${HOME}/private-sources/computer-security-research.github.io/_site"

## The secure-terminal site alone carries the shot galleries, so resolve its root for the
## shot-inventory guard below (only that site gets the check). Same explicit-but-invalid
## rule as add_root: an EXPLICIT SECURE_TERMINAL_SITE_REPO with no comparison/shots FATALs
## rather than silently checking the default site's shots (silent green). A function so the
## current-shell `exit 1` aborts the run (an `exit` inside $(...) only exits the subshell).
st_site=''
resolve_st_site(){
   local given
   local default

   given="$1"
   default="$2"
   if [ -n "${given}" ]; then
      if [ -d "${given}/comparison/shots" ]; then
         st_site="${given}"
      else
         printf '%s\n' "website-tests: FATAL: SECURE_TERMINAL_SITE_REPO override '${given}' has no comparison/shots (explicit-but-invalid checkout; refusing to silently test the default instead)" >&2
         exit 1
      fi
   elif [ -z "${home_unset}" ] && [ -d "${default}/comparison/shots" ]; then
      ## Default ONLY when HOME is set (same bogus /private-sources/... hazard as add_root).
      st_site="${default}"
   fi
}
resolve_st_site "${SECURE_TERMINAL_SITE_REPO}" "${HOME}/private-sources/secure-terminal.github.io"

if [ "${#roots[@]}" -eq 0 ]; then
   if [ -n "${home_unset}" ]; then
      ## Unset HOME + no explicit site override: a scrubbed/broken environment, not a
      ## legitimate no-checkout host. FAIL loudly rather than silently SKIP (no unauthorized
      ## skips). A valid explicit override would have populated roots above and never reach here.
      printf '%s\n' "website-tests: FATAL: HOME is unset and no site override (OUTPUT_LIES_REPO / SECURE_TERMINAL_SITE_REPO / ORG_AI_ASSISTED_REPO) given -- unexpected scrubbed environment; refusing to silently SKIP" >&2
      exit 1
   fi
   printf '%s\n' 'website-tests: SKIP (no site checkout found; set OUTPUT_LIES_REPO / SECURE_TERMINAL_SITE_REPO / ORG_AI_ASSISTED_REPO)' >&2
   ## style-ok: allow-skip: no site checkout resolved -- there is nothing to verify, and site-deploy already treats this SKIP as a publish failure.
   exit 77
fi

overall=0
env_unmet=0
## install_intact goes false when a shipped REQUIRED checker is missing/unusable: unlike a missing
## required UNIT test (which exits 1 before any of this), a missing lane checker sets overall=1 and
## continues, so without this flag it would still reach the suite-complete marker and look like a
## genuine red. A broken install is NOT a complete red -- suppress the marker so site-deploy's
## --record-and-publish cannot override it.
install_intact='true'
"${tests_dir}/check_site.py" "${roots[@]}" || overall=1

## SVG active-content safety (generic): every committed .svg/.svgz must be safe to serve
## same-origin -- no <script>/on*/javascript:/foreignObject, no remote url()/@import, no
## trojan-source bidi. The family sites' SVGs are first-party favicons, so this runs
## in-process here (defusedxml guards XXE/entity-bomb); mw-static runs the same core
## CONFINED against untrusted wiki SVG. A shipped required check: absence FATALs, not skip.
if [ -f "${tests_dir}/check_svg_safety.py" ]; then
   "${tests_dir}/check_svg_safety.py" "${roots[@]}" || overall=1
else
   printf '%s\n' "website-tests: FATAL: check_svg_safety.py not found in ${tests_dir} (required check missing)" >&2
   overall=1
   install_intact='false'
fi

## Browser lanes -- mobile-overflow ("no sideways scroll at a phone viewport"),
## width-utilization ("no tall text section wasted in a narrow column") and
## footer-alignment ("every footer row shares the same gutter"). All need
## Playwright + chromium.
##
## Prefer a local browser (CI installs one). When none is present we do NOT skip on a
## host that has the review sandbox: a silent SKIP here is a false-green publish gate,
## exactly the failure mode this guard exists to prevent. Instead we run both lanes in
## the sandbox, CONFINED, via website-tests-sandbox -- the safe path is the DEFAULT,
## nothing to remember. Only a context with neither a local browser nor the sandbox
## (e.g. a minimal CI runner) SKIPs, and it says so.

## Probe the local browser once by attempting the mobile lane; its own exit 77 means
## Playwright/chromium is absent (covers both the module and the engine). Capture the
## probe's stderr (FAIL detail + the SKIP notice) into a variable while its stdout
## streams through, and replay it only when the lane genuinely ran (rc != 77) -- so a
## delegated run is not preceded by a misleading "SKIP" line.
mobile_rc=0
if [ -f "${tests_dir}/check_mobile.py" ]; then
   ## fd3 = the real stdout; inside $() the command's stdout goes to fd3 (streams to
   ## the terminal) while its stderr is captured into probe_err. The 3>&1 must wrap the
   ## assignment from OUTSIDE $(), or fd3 would bind to the capture buffer and swallow
   ## stdout too.
   { probe_err="$("${tests_dir}/check_mobile.py" "${roots[@]}" 2>&1 1>&3 3>&-)" || mobile_rc="$?"; } 3>&1
   if [ "${mobile_rc}" != '77' ] && [ -n "${probe_err}" ]; then
      printf '%s\n' "${probe_err}" >&2
   fi
else
   ## check_mobile.py is a co-located, SHIPPED test (usr/share/website-tests/): its absence
   ## is a broken install, not an optional skip. A bare '-f' guard let a missing required
   ## test read as a full PASS (silent green) -- FATAL instead.
   printf '%s\n' "website-mobile-tests: FATAL: check_mobile.py not found in ${tests_dir} (required test missing)" >&2
   overall=1
   install_intact='false'
fi

if [ "${mobile_rc}" = '77' ]; then
   ## No local browser. Delegate BOTH lanes to the sandbox when it is available.
   ## WEBSITE_TESTS_SANDBOX_DRIVER overrides the driver path (used by the regression
   ## test); otherwise prefer the co-located driver, then one on PATH.
   driver="${WEBSITE_TESTS_SANDBOX_DRIVER:-}"
   if [ -z "${driver}" ]; then
      driver="${script_dir}/website-tests-sandbox"
      [ -x "${driver}" ] || driver="$(command -v website-tests-sandbox 2>/dev/null || true)"
   elif [ ! -x "${driver}" ]; then
      ## Same rule as add_root / resolve_st_site: an EXPLICIT override that is not
      ## usable must FATAL, not silently fall into the SKIP branch below -- a
      ## false-green publish gate is exactly what this delegation exists to prevent.
      printf '%s\n' "website-tests: FATAL: WEBSITE_TESTS_SANDBOX_DRIVER '${driver}' is not an executable driver (explicit-but-invalid; refusing to silently SKIP the browser lanes)" >&2
      exit 1
   fi
   if [ "${DIST_AI_IN_SANDBOX:-}" = '1' ]; then
      ## Already INSIDE the sandbox: there is no nested target to delegate into
      ## (`sandbox` needs --target and cannot nest -- it errors "no target"), and the
      ## ambient browser probe came back absent. The browser is provisioned by the
      ## caller (the full-run wrapper / orchestrator), not re-provisioned per suite.
      ## So an absent browser here is an honest env-unmet SKIP -- NEVER a FAIL from a
      ## doomed nested `sandbox provision` call (which flipped a clean run to FAIL(1)).
      printf '%s\n' 'website-mobile-tests: SKIP (no Playwright/chromium; in-sandbox, cannot nest-provision)' >&2
      printf '%s\n' 'website-width-tests: SKIP (no Playwright/chromium; in-sandbox, cannot nest-provision)' >&2
      printf '%s\n' 'website-footer-tests: SKIP (no Playwright/chromium; in-sandbox, cannot nest-provision)' >&2
      printf '%s\n' 'website-console-tests: SKIP (no Playwright/chromium; in-sandbox, cannot nest-provision)' >&2
      env_unmet=1
   elif [ "${WEBSITE_TESTS_NO_SANDBOX:-}" != '1' ] \
      && [ -n "${driver}" ] && [ -x "${driver}" ] && command -v sandbox >/dev/null 2>&1; then
      "${driver}" "${roots[@]}" || overall=1
   else
      printf '%s\n' 'website-mobile-tests: SKIP (no Playwright/chromium; no sandbox)' >&2
      printf '%s\n' 'website-width-tests: SKIP (no Playwright/chromium; no sandbox)' >&2
      printf '%s\n' 'website-footer-tests: SKIP (no Playwright/chromium; no sandbox)' >&2
      printf '%s\n' 'website-console-tests: SKIP (no Playwright/chromium; no sandbox)' >&2
      env_unmet=1
   fi
else
   ## Local browser present -- mobile ran here. Gate it, then run the width lane too.
   [ "${mobile_rc}" = '0' ] || overall=1
   if [ -f "${tests_dir}/check_width.py" ]; then
      width_rc=0
      "${tests_dir}/check_width.py" "${roots[@]}" || width_rc="$?"
      if [ "${width_rc}" = '77' ]; then
         printf '%s\n' 'website-width-tests: SKIP (no Playwright/chromium)' >&2
         env_unmet=1
      elif [ "${width_rc}" != '0' ]; then
         overall=1
      fi
   else
      ## Same as check_mobile.py above: a shipped required test whose absence must FATAL,
      ## not silently skip the width lane to a green pass.
      printf '%s\n' "website-width-tests: FATAL: check_width.py not found in ${tests_dir} (required test missing)" >&2
      overall=1
      install_intact='false'
   fi
   if [ -f "${tests_dir}/check_footer.py" ]; then
      footer_rc=0
      "${tests_dir}/check_footer.py" "${roots[@]}" || footer_rc="$?"
      if [ "${footer_rc}" = '77' ]; then
         printf '%s\n' 'website-footer-tests: SKIP (no Playwright/chromium)' >&2
         env_unmet=1
      elif [ "${footer_rc}" != '0' ]; then
         overall=1
      fi
   else
      ## Same as check_width.py above: a shipped required test whose absence must FATAL,
      ## not silently skip the footer lane to a green pass.
      printf '%s\n' "website-footer-tests: FATAL: check_footer.py not found in ${tests_dir} (required test missing)" >&2
      overall=1
      install_intact='false'
   fi
   if [ -f "${tests_dir}/check_console.py" ]; then
      console_rc=0
      "${tests_dir}/check_console.py" "${roots[@]}" || console_rc="$?"
      if [ "${console_rc}" = '77' ]; then
         printf '%s\n' 'website-console-tests: SKIP (no Playwright/chromium)' >&2
         env_unmet=1
      elif [ "${console_rc}" != '0' ]; then
         overall=1
      fi
   else
      ## Same as check_footer.py above: a shipped required lane whose absence must FATAL,
      ## not silently skip the console-error gate to a green pass.
      printf '%s\n' "website-console-tests: FATAL: check_console.py not found in ${tests_dir} (required test missing)" >&2
      overall=1
      install_intact='false'
   fi
fi

## The sandbox-delegated lanes (lint / vnu / lighthouse / axe) share one delegation rule, so a
## single helper applies it uniformly:
##   - in-sandbox (cannot nest) OR no sandbox on this host -> env-unmet SKIP (never a silent green)
##   - sandbox present but the SHIPPED driver missing/non-executable -> FATAL (broken install),
##     NOT a misleading "no sandbox" SKIP: the webcheck-*-sandbox drivers ship in THIS package
##     (like check_console.py / secure-terminal-shots-inventory above), so their absence is an
##     environment bug, per the dist-ai shell-test convention (a required tool absent = exit 1).
## Sets the globals overall / env_unmet / install_intact. The lint + vnu lanes run CONFINED in
## the sandbox (tools there, no browser/network); lighthouse + axe run UNCONFINED (real chromium +
## loopback). Each lane fails CLOSED on a missing per-site baseline inside its driver.
delegate_sandbox_lane() {
   local label driver_name driver rc
   label="$1"
   driver_name="$2"
   shift 2
   driver="${script_dir}/${driver_name}"
   [ -x "${driver}" ] || driver="$(command -v "${driver_name}" 2>/dev/null || true)"
   if [ -z "${driver}" ] || [ ! -x "${driver}" ]; then
      printf '%s\n' "${label}: FATAL: ${driver_name} not found (required; ships in this package)" >&2
      overall=1
      install_intact='false'
      return
   fi
   ## Each driver is LOCAL-FIRST: it runs its tool DIRECTLY where the tool
   ## resolves (a CI runner with it installed, or in-sandbox-direct where it is
   ## provisioned) and otherwise delegates to the review sandbox -- so a lane is
   ## no longer SKIPped merely because `sandbox` is absent or we are in-sandbox.
   ## The driver exits 77 ONLY when it can neither run locally NOR reach a usable
   ## sandbox: a genuine env-unmet SKIP, never a masked failure. A lane that RAN
   ## and found problems exits non-zero, non-77. So: 77 -> SKIP, 0 -> pass,
   ## anything else -> fail.
   rc=0
   "${driver}" "$@" || rc="$?"
   if [ "${rc}" = '77' ]; then
      printf '%s\n' "${label}: SKIP (tool absent locally and no usable sandbox)" >&2
      env_unmet=1
   elif [ "${rc}" != '0' ]; then
      overall=1
   fi
}

delegate_sandbox_lane 'website-lint-tests (html-tidy/stylelint)' webcheck-lint-sandbox "${roots[@]}"
delegate_sandbox_lane 'website-vnu-tests (vnu conformance)' webcheck-vnu-sandbox "${roots[@]}"
delegate_sandbox_lane 'website-lighthouse-tests (lighthouse)' webcheck-lighthouse-sandbox "${roots[@]}"
delegate_sandbox_lane 'website-axe-tests (axe-core)' webcheck-axe-sandbox "${roots[@]}"

## Shot-inventory guard (secure-terminal site only): every committed shot is a
## page-referenced generator artifact and every gallery reference resolves -- no
## hand-rolled/orphan shot, no dangling reference. Cheap (no Qt, no regen), so it gates
## every push/deploy here as well as in CI. The tool is a sibling in this bin dir.
if [ -n "${st_site}" ]; then
   inv="${script_dir}/secure-terminal-shots-inventory"
   [ -x "${inv}" ] || inv='/usr/bin/secure-terminal-shots-inventory'
   if [ -x "${inv}" ]; then
      "${inv}" "${st_site}" || overall=1
   else
      ## Ships in this same package, so absence is an environment bug, not a skip: FAIL.
      printf '%s\n' 'website-tests: FAIL secure-terminal-shots-inventory not found (required)' >&2
      overall=1
      install_intact='false'
   fi
fi

## Completion signal: emit ONLY when every required checker was present and the run reached here --
## no early FATAL / missing-or-failing required-unit-test abort (those exit 1 BEFORE this point), no
## no-checkout SKIP, and no missing/unusable required LANE checker (install_intact). site-deploy's
## --record-and-publish keys on this marker so it overrides ONLY a COMPLETE red (exit 1 WITH the
## marker) -- never an early abort nor a broken install, where the site checks never fully ran.
if [ "${install_intact}" = 'true' ]; then
   printf '%s\n' 'website-tests: suite-complete' >&2
fi
## fail dominates; a browser lane that could not run here surfaces as SKIP:env-unmet (78).
suite_exit "${overall}" 0 "${env_unmet}"
