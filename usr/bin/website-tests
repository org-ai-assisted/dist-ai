#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Static consistency checks for the project's GitHub Pages sites
## (output-lies.github.io, secure-terminal.github.io, org-ai-assisted.github.io):
## every internal link resolves to a real target (no reliance on redirects; known
## sibling project-Pages paths are allow-listed), the footer carries the uniform
## "family" links, prose capitalizes "Open Source"/"Free Software", and a
## review-status banner never claims a green "working" state. Pure Python, no
## network, no root. Each site checkout is resolved from an env var
## (OUTPUT_LIES_REPO, SECURE_TERMINAL_SITE_REPO, ORG_AI_ASSISTED_REPO) or a
## default under the operator's private-sources; if none is found it SKIPs
## (exit 77) rather than failing.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/website-tests" ]; then
   tests_dir="${script_dir}/../share/website-tests"
else
   tests_dir='/usr/share/website-tests'
fi

## Unit regression for check_site's own logic (the image-format gate + the
## render-source recognition it depends on). Fixture-based, no site checkout or
## image tools needed; a failure here is a real logic regression, so it fails the
## run outright rather than hiding behind the no-checkout SKIP below.
if [ -f "${tests_dir}/check_site_test.py" ]; then
   python3 -Bsu -- "${tests_dir}/check_site_test.py" || exit 1
fi

## Unit regression for check_mobile's browser-free logic (page discovery +
## gate wiring). Playwright is imported inside its main(), so this test runs
## everywhere without a browser; a failure is a real logic regression.
if [ -f "${tests_dir}/check_mobile_test.py" ]; then
   python3 -Bsu -- "${tests_dir}/check_mobile_test.py" || exit 1
fi

## Unit regression for check_width's browser-free logic (the offender predicate +
## gate wiring). Playwright is imported inside its main(), so this runs everywhere
## without a browser; a failure is a real logic regression.
if [ -f "${tests_dir}/check_width_test.py" ]; then
   python3 -Bsu -- "${tests_dir}/check_width_test.py" || exit 1
fi

## Resolve each site root from its env var, else a private-sources default.
[ -v OUTPUT_LIES_REPO ] || OUTPUT_LIES_REPO=''
[ -v SECURE_TERMINAL_SITE_REPO ] || SECURE_TERMINAL_SITE_REPO=''
[ -v ORG_AI_ASSISTED_REPO ] || ORG_AI_ASSISTED_REPO=''

declare -a roots=()
add_root(){
   local given
   local default

   given="$1"
   default="$2"
   if [ -n "${given}" ] && [ -f "${given}/index.html" ]; then
      roots+=( "${given}" )
   elif [ -f "${default}/index.html" ]; then
      roots+=( "${default}" )
   fi
}
add_root "${OUTPUT_LIES_REPO}"          "${HOME}/private-sources/output-lies.github.io"
add_root "${SECURE_TERMINAL_SITE_REPO}" "${HOME}/private-sources/secure-terminal.github.io"
add_root "${ORG_AI_ASSISTED_REPO}"      "${HOME}/private-sources/org-ai-assisted.github.io"

if [ "${#roots[@]}" -eq 0 ]; then
   printf '%s\n' 'website-tests: SKIP (no site checkout found; set OUTPUT_LIES_REPO / SECURE_TERMINAL_SITE_REPO / ORG_AI_ASSISTED_REPO)' >&2
   exit 77
fi

overall=0
python3 -Bsu -- "${tests_dir}/check_site.py" "${roots[@]}" || overall=1

## Mobile-overflow guard: load each page in a headless browser at a phone viewport
## and assert the body never scrolls sideways. Needs Playwright + chromium; SKIPs
## (exit 77) cleanly when the browser is absent, so the static checks above still
## run everywhere.
if [ -f "${tests_dir}/check_mobile.py" ]; then
   mobile_rc=0
   python3 -Bsu -- "${tests_dir}/check_mobile.py" "${roots[@]}" || mobile_rc="$?"
   if [ "${mobile_rc}" = '77' ]; then
      printf '%s\n' 'website-mobile-tests: SKIP (no Playwright/chromium)' >&2
   elif [ "${mobile_rc}" != '0' ]; then
      overall=1
   fi
fi

## Desktop width-utilization guard ("the virtual ruler"): render each page at a
## desktop viewport and assert no tall text section wastes its width in a narrow
## column with a wide empty gutter. Same browser dependency + SKIP semantics as
## the mobile guard, so the static checks above still run everywhere.
if [ -f "${tests_dir}/check_width.py" ]; then
   width_rc=0
   python3 -Bsu -- "${tests_dir}/check_width.py" "${roots[@]}" || width_rc="$?"
   if [ "${width_rc}" = '77' ]; then
      printf '%s\n' 'website-width-tests: SKIP (no Playwright/chromium)' >&2
   elif [ "${width_rc}" != '0' ]; then
      overall=1
   fi
fi

exit "${overall}"
