#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Build ONE image locally in the sandbox qube, mirroring .github/workflows/local-build.yml exactly,
## so the result can be compared against CI's image of the SAME commit.
##
## Faithfulness is the whole point, so every knob is taken from the workflow:
##   dist_build_version   exported from the same 'git describe --exclude' BEFORE
##                        sign-and-tag, because sign-and-tag amends HEAD and a
##                        version derived after the amend would differ between
##                        the two sides for a non-defect reason.
##   flavor/arch          kicksecure-debug / amd64
##   target               DM_REPRO_TARGET=qcow2 or iso -- REQUIRED, no default
##                        (VM image and ISO are equally primary); matches
##                        local-build.yml's qcow2 vs iso lanes exactly
##   --freshness frozen   pins the Debian snapshot; without it two builds diverge
##                        on package versions alone.
##
## PROGRESS SIGNAL: this appends ONLY when the build log actually grows. A line
## per tick would be fabricated liveness -- the stall supervisor watches this
## file, and a dead build that keeps it growing looks healthy forever. That bug
## once hid a build that died in three minutes for eight hours.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

progress="$1"
## The commit under test. Passed explicitly because sign-and-tag AMENDS the
## parent HEAD, so after any attempt the tree no longer sits on it -- a second
## run would silently build a different commit. Observed: attempt two built
## 98c75a32 while claiming to test 96fee033c.
target_sha="${2:?usage: local-repro-build.sh <progress-file> <commit-sha>}"

## Parameterised so the SAME script can build a freshly cloned tree. A fresh
## clone is the discriminator for the mtime differences: rsync preserves this
## host's mtimes, while CI's checkout writes new ones, so a file copied with its
## mtime intact is indistinguishable from a build that fails to normalise it.
remote_tree="${3:-/home/user/derivative-maker}"
remote_log="${4:-/home/user/local-repro-build.log}"

## Target image to build and later compare against CI. REQUIRED, no default:
## the VM image and the ISO are equally primary, so the caller must choose
## rather than silently getting one. qcow2 mirrors local-build.yml's qcow2 lane
## (multi-target list 'qcow2', VM image built); iso mirrors its iso lane (EMPTY
## multi-target list -> ISO only, no VM images). The artifact glob is what the
## DONE check and the listing match. Passed by env (DM_REPRO_TARGET).
target="${DM_REPRO_TARGET:-}"
case "${target}" in
   qcow2)
      multi_target_list='qcow2'
      artifact_glob='*.qcow2.libvirt.xz'
      ;;
   iso)
      multi_target_list=''
      artifact_glob='*.iso'
      ;;
   virtualbox)
      multi_target_list='virtualbox'
      artifact_glob='*.ova'
      ;;
   "")
      printf '%s\n' "dm-local-repro-build: DM_REPRO_TARGET must be set to 'qcow2', 'iso' or 'virtualbox' (no default -- all are equally primary)" >&2
      exit 2
      ;;
   *)
      printf '%s\n' "dm-local-repro-build: unsupported DM_REPRO_TARGET '${target}' (qcow2|iso|virtualbox)" >&2
      exit 2
      ;;
esac

## Optional submodule commit overrides, so a build can reproduce CI's ACTUAL
## source rather than the parent gitlink pins. CI's repro lane checks out moving
## fork-branch TIPS for submodules (ci/checkout-fork-submodule-branches), which
## are recorded ONLY in the image's buildinfo Submodule-State -- not the parent
## gitlink -- so a by-gitlink reproducer builds different source and mismatches.
## Format: space-separated 'submodule/path=sha', taken straight from the
## buildinfo's Submodule-State lines.
submodule_overrides="${DM_REPRO_SUBMODULE_OVERRIDES:-}"

## The value is interpolated into the restore script that runs in the sandbox,
## so constrain it to what a 'path=sha' list can legitimately contain before it
## gets there.
case "${submodule_overrides}" in
   *[!A-Za-z0-9/=_.\ -]*)
      printf '%s\n' 'dm-local-repro-build: DM_REPRO_SUBMODULE_OVERRIDES may contain only [A-Za-z0-9/=_.-] and spaces' >&2
      exit 2
      ;;
esac

note() {
   local stamp
   stamp="$(date --utc +%H:%M:%SZ)"
   printf '%s\n' "${stamp} $*" >> "${progress}"
}

## Restore the exact commit, then the pinned submodules. Both are required
## every run: the amend moves the parent, and a previous build can leave
## submodules checked out elsewhere.
note "restoring the sandbox tree to ${target_sha}"
sandbox exec --raw - <<REMOTE >> "${progress}" 2>&1
cd -- "${remote_tree}"
## FETCH before reset. Without this the reset fails on an object the clone has
## never seen, and the build proceeds on whatever HEAD happened to be -- which
## for a tree that already ran sign-and-tag is an AMENDED commit, i.e. silently
## the wrong thing. Caught only because this script prints HEAD afterwards.
git fetch --quiet origin >/dev/null 2>&1 || true
git reset --hard "${target_sha}" >/dev/null
git submodule update --init --recursive >/dev/null 2>&1 || true
## Apply the submodule overrides AFTER the gitlink checkout above, which would
## otherwise undo them. Every entry must apply EXACTLY or the run aborts:
## continuing on the gitlink after being told to build a specific sha yields an
## image that differs for a reason nobody asked about, and the comparison then
## reports it as a reproducibility defect. A silently unapplied override is the
## worst outcome available here, so none of these use '|| true'.
repro_overrides='${submodule_overrides}'
for override in \${repro_overrides}; do
   sub_path="\${override%%=*}"
   sub_sha="\${override#*=}"
   if [ "\${sub_path}" = "\${override}" ] || [ -z "\${sub_path}" ] || [ -z "\${sub_sha}" ]; then
      printf '%s\n' "FATAL: malformed override '\${override}' (want 'path=sha')" >&2
      exit 2
   fi
   if [ ! -d "\${sub_path}" ]; then
      printf '%s\n' "FATAL: override path '\${sub_path}' is not a directory in this tree" >&2
      exit 2
   fi
   (
      cd -- "\${sub_path}" || exit 1
      ## The sha is a fork-branch tip the clone may never have seen, so fetch
      ## before asking for it. Existence is then checked explicitly, because
      ## 'reset --hard' on an unknown object leaves the checkout untouched.
      git fetch --quiet origin "\${sub_sha}" >/dev/null 2>&1 \
         || git fetch --quiet --all >/dev/null 2>&1 || true
      git cat-file -e "\${sub_sha}^{commit}" >/dev/null 2>&1 || exit 3
      git reset --hard "\${sub_sha}" >/dev/null 2>&1 || exit 4
   )
   override_rc=\$?
   if [ "\${override_rc}" != '0' ]; then
      printf '%s\n' "FATAL: could not apply override \${sub_path}=\${sub_sha} (rc=\${override_rc}); refusing to build different source than asked for" >&2
      exit 2
   fi
   printf '%s\n' "override applied: \${sub_path} -> \$( cd -- "\${sub_path}" && git rev-parse HEAD )"
done
## Remove UNTRACKED and ignored files too. 'reset --hard' leaves them, and this
## sandbox has accumulated __pycache__, .pytest_cache and .mypy_cache from test
## runs. CI checks out fresh and never has them; here dm-check-unicode flagged
## them ("Missing newlines at the end of file") and failed
## 1200_prepare-build-machine. -x is deliberate: ignored build residue is
## exactly what differs from a fresh clone.
git clean -xfd >/dev/null 2>&1 || true
git submodule --quiet foreach --recursive "git clean -xfd >/dev/null 2>&1 || true" 2>/dev/null || true
REMOTE

## Remotes must be https, as CI has them. This host rewrites github https to ssh
## globally (url.insteadOf), so a synced tree carries literal ssh remotes -- and
## the build container has no ssh binary, so derivative-update dies with
## "cannot run ssh: No such file or directory" 18 seconds in.
note "normalising ssh remotes to https (the container has no ssh)"
sandbox exec --raw - <<'REMOTE' >> "${progress}" 2>&1
cd /home/user/derivative-maker
normalise_remotes() {
   for remote_name in $(git remote); do
      url="$(git remote get-url "${remote_name}" 2>/dev/null || true)"
      case "${url}" in
         git@github.com:*)
            git remote set-url "${remote_name}" "https://github.com/${url#git@github.com:}"
            ;;
         ssh://git@github.com/*)
            git remote set-url "${remote_name}" "https://github.com/${url#ssh://git@github.com/}"
            ;;
      esac
   done
}
normalise_remotes
## Iterate submodules HERE rather than running the function inside
## 'git submodule foreach': foreach executes with sh (dash), where an exported
## bash function does not exist -- it fails "command not found" and a '|| true'
## hides it, leaving every submodule with ssh remotes the container cannot use.
while IFS= read -r submodule_path; do
   [ -n "${submodule_path}" ] || continue
   ( cd -- "${submodule_path}" && normalise_remotes ) || true
done < <( git submodule --quiet foreach --recursive 'printf "%s\n" "${PWD}"' 2>/dev/null || true )
origin_now="$(git remote get-url origin 2>/dev/null || true)"
[ -n "${origin_now}" ] || origin_now="none"
printf '%s\n' "origin now: ${origin_now}"
REMOTE

## A reset that did not land on the target must STOP, not build something else.
## Resolve the requested commit to its FULL sha before comparing: reset accepts
## an abbreviated sha, but a raw string compare against HEAD's full sha would
## then falsely report a mismatch for the very commit it just checked out.
## '|| true' because errexit would otherwise abort the script the moment a
## sha does not resolve -- taking out the very diagnostic below that exists to
## report it. '--verify' because a bare rev-parse ECHOES an unresolvable
## argument back on stdout, which would then be reported as the resolved sha
## instead of 'unresolved'. '--end-of-options' so a sha starting with '-' is
## read as a revision rather than a flag.
actual_head="$( sandbox exec --raw -- git -C "${remote_tree}" rev-parse --verify --end-of-options HEAD 2>/dev/null | tr -d '[:space:]' || true )"
target_full="$( sandbox exec --raw -- git -C "${remote_tree}" rev-parse --verify --end-of-options "${target_sha}" 2>/dev/null | tr -d '[:space:]' || true )"
if [ -z "${target_full}" ] || [ ! "${actual_head}" = "${target_full}" ]; then
   note "=== FAILED: tree is at ${actual_head}, not the requested ${target_sha} (${target_full:-unresolved})"
   exit 1
fi

note "confirming the sandbox tree is the commit under test and is CLEAN"
sandbox exec - <<REMOTE >> "${progress}" 2>&1
cd -- "${remote_tree}"
head_now="\$(git rev-parse HEAD)"
printf '%s\n' "HEAD:     \${head_now}"
dirty_now="\$(git status --porcelain | wc -l)"
printf '%s\n' "dirty:    \${dirty_now}"
describe_now="\$(git describe --always --abbrev=1000000000 --exclude '*_*_*')"
printf '%s\n' "describe: \${describe_now}"
REMOTE

## Materialise REAL symlinks before building.
##
## Both this host and the sandbox carry 'core.symlinks = false' from
## /etc/gitconfig (security-misc-shared) -- a deliberate security setting that
## stays. Under it git checks a symlink out as a small REGULAR FILE holding the
## target path, and reports the tree clean because it knows it did that.
##
## The build container has no such gitconfig, so git in there sees mode 120000 in
## the index against a regular file on disk and reports a typechange; the build
## aborts in git_sanity_test. Worse for the comparison: CI's runner checks out
## real symlinks, so a build from the file form would embed DIFFERENT CONTENT and
## could never match CI byte for byte.
##
## Fixing it in the sandbox only keeps the host setting intact. It must live here
## rather than in a runbook: an rsync from the host re-creates the file form every
## time, so any manual step would be forgotten exactly once.
note "materialising real symlinks in the sandbox (host keeps core.symlinks=false)"
sandbox exec --raw - <<REMOTE >> "${progress}" 2>&1
cd -- "${remote_tree}"
git -c core.symlinks=true reset --hard >/dev/null
git submodule --quiet foreach --recursive "git -c core.symlinks=true reset --hard >/dev/null" 2>/dev/null || true
symlink_now="\$(ls -la live-build-data/d-i-branding/logo_installer.png | sed 's/.*-> //')"
printf '%s\n' "symlink check: \${symlink_now}"
REMOTE

note "launching the build DETACHED (mirrors local-build.yml)"
sandbox exec - <<REMOTE
set -o errexit
set -o nounset
cd -- "${remote_tree}"
truncate --size=0 -- "${remote_log}"
## CI=true is REQUIRED, not cosmetic: without it derivative-maker-docker-run
## adds '--interactive', which needs a real host TTY. A detached launch has
## none, so docker refuses with "the input device is not a TTY" and the build
## never starts -- while the log still grows, which is exactly the shape that
## looks like progress. CI sets this itself; a local mirror must too.
setsid nohup env CI=true ./docker/derivative-maker-docker-run -- \
   bash -c "export dist_build_version=\\"\\\$(git describe --always --abbrev=1000000000 --exclude '*_*_*')\\" && \
   export dist_build_sign_and_tag=true && \
   ./help-steps/signing-key-create && ./help-steps/sign-and-tag && \
   env dist_build_target_arch='amd64' flavors_list='kicksecure-debug' \
   dist_build_multi_target_list='${multi_target_list}' \
   ./help-steps/dm-build-official --freshness frozen --package-jobs 2" \
   > "${remote_log}" 2>&1 < /dev/null &
disown
printf '%s\n' "launched"
REMOTE

## Poll the BUILD's own output. Liveness comes from bytes the build produced,
## never from a process being alive: a surviving parent shell once stood in for
## a download that had already died.
idle_ticks=0
last_size=""
while true; do
   sleep 60
   size="$(sandbox exec -- stat --format=%s -- "${remote_log}" 2>/dev/null || printf '0')"
   size="${size//[!0-9]/}"
   ## 'wc -l' always exits 0. 'grep -c' exits 1 on a zero count, which once made
   ## a '|| printf 0' fallback fire TOO and return "0\n0", so the equality test
   ## never matched and the loop never ended.
   running="$(sandbox exec - <<'PROBE'
sudo --non-interactive docker ps --quiet 2>/dev/null | wc -l
PROBE
)"
   running="${running//[!0-9]/}"

   if [ "${size:-0}" != "${last_size}" ]; then
      note "log=${size:-0}B containers=${running:-0}"
      last_size="${size:-0}"
      idle_ticks=0
      continue
   fi

   if [ "${running:-0}" -eq 0 ]; then
      idle_ticks=$(( idle_ticks + 1 ))
      if [ "${idle_ticks}" -ge 2 ]; then
         note "log stopped growing at ${size:-0}B and no container remains"
         break
      fi
   fi
done

## A verdict needs a POSITIVE signal. "no error string in the log" is an ABSENCE,
## which a build killed mid-step (OOM, dead transport, truncated log) also
## satisfies -- that reads as success for a build that produced nothing.
if sandbox exec -- bash -c "grep --quiet -- 'ERROR detected in script' ${remote_log}" 2>/dev/null; then
   note "=== FAILED: the build reported an error"
   sandbox exec -- bash -c "grep -n 'ERROR detected in script' -A 4 ${remote_log} | tail -20" >> "${progress}" 2>&1 || true
   exit 1
fi

## Match the image OR its '.sha512sums': dm-prepare-release CONSUMES the '.iso'
## (leaving only sidecars in binary_mnt), while a '.qcow2.libvirt.xz' persists.
## The checksum file is written on success for BOTH targets, so it is the
## reliable positive signal -- and its hash is exactly what the CI comparison
## needs. Without this an ISO build that fully succeeded reported "no artifact".
image_count="$(sandbox exec - <<COUNT
find /home/user/binary_mnt -maxdepth 3 -type f \( -name '${artifact_glob}' -o -name '${artifact_glob}.sha512sums' \) -newermt '-3 hours' 2>/dev/null | wc -l
COUNT
)"
image_count="${image_count//[!0-9]/}"
if [ "${image_count:-0}" -lt 1 ]; then
   note "=== FAILED: no error marker, but NO artifact was produced"
   sandbox exec -- bash -c "tail -n 15 ${remote_log}" >> "${progress}" 2>&1 || true
   exit 1
fi

note "=== DONE: build finished, ${image_count} fresh image(s)"
## The listing is INFORMATIONAL. As the last statement its exit status became the
## script's, so a successful build whose listing hiccuped reported as a failed
## job -- the verdict said DONE while the supervisor said failed. A report step
## must never be able to overturn a verdict already reached.
sandbox exec - <<LIST >> "${progress}" 2>&1 || true
find /home/user/binary_mnt -maxdepth 3 -type f \( -name '${artifact_glob}' -o -name '${artifact_glob}.sha512sums' \) -newermt '-3 hours' -print
## Surface the image's sha512 from the build's own checksum file: it is the
## CI-vs-local comparison key, and for the ISO it is all that remains after
## dm-prepare-release consumes the '.iso'.
find /home/user/binary_mnt -maxdepth 3 -type f -name '${artifact_glob}.sha512sums' -newermt '-3 hours' -exec cat {} +
LIST
exit 0
