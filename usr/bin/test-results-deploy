#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## style-ok: no-has -- standalone deploy driver; does not source helper-scripts.

## Deploy the image-test results plane to the GitHub Pages site, end to end:
##   1. pull the OVH results plane (world-readable; the ssh login user reads it)
##   2. regenerate the static site into the Pages repo (test-results-site-generate)
##   3. commit the regenerated site + static pages and publish via site-deploy
##
## STANDING DEFAULT: results are ALWAYS deployed to GitHub, unattended -- this is the one
## command that does it (a systemd timer runs it; see the results-plane deploy unit). It does
## NOT approve goldens: new/changed shots render as NEW for the human to review + approve
## (test-results-site-approve), a separate human-mediated step.
##
## Report-only: any failure exits non-zero with a clear message and NEVER leaves a half-published
## state read as success (site-deploy's own pre-push website-tests gate still applies).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"

## Overridable knobs (defaults match the live setup).
target="${TEST_RESULTS_DEPLOY_TARGET:-server-admin}"
results_remote="${TEST_RESULTS_REMOTE:-/var/www/results}"
pages_repo="${TEST_RESULTS_PAGES_REPO:-${HOME}/private-sources/org-ai-assisted.github.io}"
## Stage on DISK by default, NOT the ~2G /tmp tmpfs: the plane pull (16M+ and growing) overruns
## it and sandbox aborts on the staging free-space budget. A disk-backed base under $HOME is the
## default so the safe path needs nothing recalled; override with TEST_RESULTS_STAGING_DIR.
staging_base="${TEST_RESULTS_STAGING_DIR:-${HOME}/.cache/test-results-deploy}"

die() {
   printf '%s\n' "${me}: ERROR: $1" >&2
   exit 1
}

## Resolve the generator as THIS script's SIBLING, not by PATH -- so a checkout run uses the
## checkout generator, never the (possibly stale) installed /usr/bin copy. Falls back to PATH
## only if no sibling exists (e.g. an odd install layout).
script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"
generate="${script_dir}/test-results-site-generate"
[ -x "${generate}" ] || generate="test-results-site-generate"

command -v sandbox >/dev/null 2>&1 || die "sandbox not found"
command -v "${generate}" >/dev/null 2>&1 || die "test-results-site-generate not found"
command -v site-deploy >/dev/null 2>&1 || die "site-deploy not found"
[ -d "${pages_repo}/.git" ] || die "not a git checkout: ${pages_repo}"
[ -d "${pages_repo}/automated-test-results" ] || die "no automated-test-results/ in ${pages_repo}"

## Serialize on the Pages repo. site-generate rewrites the WHOLE tree in ${pages_repo}
## in place, while site-deploy's website-tests then DECODES every image there. Two runs at
## once (the hourly timer overlapping a manual run, or a long run overrunning the next timer
## tick) let one run's regenerate rewrite a file mid-decode in the other's gate -> a partial
## read surfaces as a spurious "undecodable/corrupt image" that falsely blocks publish. Hold
## an exclusive lock, keyed to the repo it protects, on a dedicated fd for the whole run (the
## fd closes only at process exit) -- the safe path is the default, nothing to recall.
lock_file="${pages_repo}/.git/test-results-deploy.lock"
exec {lock_fd}>"${lock_file}" || die "could not open deploy lock: ${lock_file}"
flock --timeout 3600 "${lock_fd}" \
   || die "another test-results-deploy holds the Pages-repo lock (waited 3600s)"

mkdir --parents -- "${staging_base}"
staging="$(mktemp --directory --tmpdir="${staging_base}" deploy.XXXXXX)"
## Registered in the EXIT trap so a failure at any step (read-tree / add / commit) cannot leak
## the private index or the message temp file.
idx=""
msg_file=""
# shellcheck disable=SC2317  ## runs via the EXIT trap
cleanup() {
   safe-rm --recursive --force -- "${staging}" || true
   [ -z "${idx}" ] || safe-rm --force -- "${idx}" || true
   [ -z "${msg_file}" ] || safe-rm --force -- "${msg_file}" || true
}
trap cleanup EXIT

printf '%s\n' "${me}: pulling results plane from ${target}:${results_remote}"
## --allow-system-path: the results plane lives under /var/www (nginx webroot, world-readable)
## by design; sandbox pull refuses a system path unless the read is declared deliberate.
sandbox --target "${target}" pull --allow-system-path "${results_remote}" "${staging}/results" \
   || die "pull of ${results_remote} from ${target} failed"
[ -d "${staging}/results" ] || die "pull produced no results tree"

## --chrome-from the site's own root page: the generated results pages then carry the SITE's
## actual header nav, not the generator's fallback default -- so website-tests' nav-consistency
## check cannot fail on a drift between the two.
chrome_from=()
[ -f "${pages_repo}/index.html" ] && chrome_from=(--chrome-from "${pages_repo}/index.html")

printf '%s\n' "${me}: regenerating the static site into ${pages_repo}"
"${generate}" \
   --results-root "${staging}/results" \
   --site-out "${pages_repo}" \
   --goldens-dir "${pages_repo}/automated-test-results/goldens" \
   --approvals "${pages_repo}/automated-test-results/golden-approvals.json" \
   "${chrome_from[@]}" \
   || die "site generation failed"

cd -- "${pages_repo}"
## Commit via a PRIVATE index: this tree is shared across sessions, so staging into the
## shared index (or a directory pathspec) could sweep a sibling's change. read-tree HEAD +
## add the generated site into an isolated index, then commit only that -- a sibling's
## concurrent staging is never swept. (The whole-index commit of the PRIVATE index is the
## intended full regenerate; GIT_INDEX_COMMIT_GUARD_ALLOW=1 satisfies the shared-index gate.)
idx="$(mktemp)"
GIT_INDEX_FILE="${idx}" git read-tree HEAD
GIT_INDEX_FILE="${idx}" git add -A -- automated-test-results
if GIT_INDEX_FILE="${idx}" git diff --cached --quiet HEAD -- automated-test-results; then
   printf '%s\n' "${me}: no results changes to commit (site already current)"
else
   msg_file="$(mktemp)"
   printf '%s\n' "Deploy image-test results" > "${msg_file}"
   GIT_INDEX_FILE="${idx}" GIT_INDEX_COMMIT_GUARD_ALLOW=1 git commit --quiet -F "${msg_file}" \
      || die "commit failed"
fi

## Publish whenever the local branch is AHEAD of the published tip. This covers BOTH a fresh
## commit just made above AND a prior run that committed but whose push failed, leaving a
## stranded, unpushed backlog -- the exact wedge this recovers. Keyed off the real remote tip so
## a run with nothing new does not pay the website-tests gate; if the tip cannot be read, publish
## anyway rather than risk stranding a commit.
remote_tip="$(git ls-remote origin refs/heads/master 2>/dev/null | cut -f1)" || remote_tip=""
if [ -n "${remote_tip}" ] && [ "${remote_tip}" = "$(git rev-parse HEAD)" ]; then
   printf '%s\n' "${me}: nothing to publish (already pushed)."
   exit 0
fi

printf '%s\n' "${me}: publishing via site-deploy"
site-deploy || die "site-deploy failed (results committed locally; not published)"
printf '%s\n' "${me}: deployed."
