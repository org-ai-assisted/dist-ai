#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## style-ok: no-has -- standalone deploy driver; does not source helper-scripts.

## Deploy the image-test results plane to the GitHub Pages site, end to end:
##   1. pull the OVH results plane (world-readable; the ssh login user reads it)
##   2. regenerate the static site into the Pages repo (test-results-site-generate)
##   3. commit the regenerated site + static pages and publish via site-deploy
##
## RUN AS THE FINAL STEP of a test-run flow (NOT a blind timer -- an hourly oneshot was dropped
## because its runtime cap SIGTERM'd the website-tests gate mid-run so pushes never landed).
## Status is OBJECTIVE (no human approval step): the generator publishes every screenshot and
## a run reads green only on a finished + fresh + PASS verdict on the declared firmware lane.
##
## CONFIRMED publish: after pushing it POLLS the GitHub Pages build API until the live site is
## built AT the pushed commit, and FAILS LOUD otherwise -- a pushed-but-unbuilt, errored, or
## stale publish must never read as success (the silent-stale wedge). Any failure exits non-zero
## and NEVER leaves a half-published state read as success (site-deploy's own pre-push
## website-tests gate still applies).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"

## Overridable knobs (defaults match the live setup).
target="${TEST_RESULTS_DEPLOY_TARGET:-server-admin}"
results_remote="${TEST_RESULTS_REMOTE:-/var/www/results}"
pages_repo="${TEST_RESULTS_PAGES_REPO:-${HOME}/private-sources/org-ai-assisted.github.io}"
## Stage on DISK by default, NOT the ~2G /tmp tmpfs: the plane pull (16M+ and growing) overruns
## it and sandbox aborts on the staging free-space budget. A disk-backed base under $HOME is the
## default so the safe path needs nothing recalled; override with TEST_RESULTS_STAGING_DIR.
staging_base="${TEST_RESULTS_STAGING_DIR:-${HOME}/.cache/test-results-deploy}"
## Confirm-published poll budget (seconds): GitHub Pages builds the pushed branch ASYNCHRONOUSLY,
## so a successful push is not yet a live site. Poll this long for the build to land at our commit.
confirm_timeout="${TEST_RESULTS_CONFIRM_TIMEOUT:-1200}"
## Seconds between build-API polls. Prod keeps 15s; a hermetic test overrides it so the
## multi-poll path (a stale errored build clearing before our commit builds) runs in ~1s.
confirm_poll_interval="${TEST_RESULTS_CONFIRM_POLL_INTERVAL:-15}"

die() {
   printf '%s\n' "${me}: ERROR: $1" >&2
   exit 1
}

## Confirm the pushed commit is LIVE. Pages here is build_type=workflow (dev1306's migration),
## under which the legacy /pages/builds API is FROZEN and never reflects a workflow deploy -- so
## the authoritative "deployed at ${want}" signal is the github-pages DEPLOYMENT for that exact sha
## reaching a 'success' status. A legacy branch build ALSO records a github-pages deployment, so
## this one check covers both models (no build_type branch). Returns 0 on a confirmed success
## deployment; 1 on a failure/error deployment or timeout. A pushed commit is NOT a deployed site
## (Pages deploys async), so this makes "published" mean "actually live", never merely "pushed" --
## no silent stale publish.
confirm_published() {
   local want="$1" url owner_repo deadline deps dep_id state
   if ! command -v github-api >/dev/null 2>&1; then
      printf '%s\n' "${me}: github-api not found -- cannot confirm publish" >&2
      return 1
   fi
   if ! command -v jq >/dev/null 2>&1; then
      printf '%s\n' "${me}: jq not found -- cannot confirm publish" >&2
      return 1
   fi
   ## owner/repo for the Pages API: an explicit override (a non-github mirror, or a test), else
   ## derived from origin's github URL.
   owner_repo="${TEST_RESULTS_PAGES_OWNER_REPO:-}"
   if [ -z "${owner_repo}" ]; then
      url="$(git remote get-url origin 2>/dev/null)" || return 1
      owner_repo="$(printf '%s' "${url}" | sed -E 's#^.*github\.com[:/]+##; s#\.git$##')"
   fi
   if [ -z "${owner_repo}" ]; then
      printf '%s\n' "${me}: cannot derive owner/repo (origin='${url:-}')" >&2
      return 1
   fi
   deadline=$(( $(date +%s) + confirm_timeout ))
   while :; do
      ## The github-pages deployment(s) created for EXACTLY our pushed sha; newest id wins. Empty
      ## until the deploy workflow registers one -- keep polling (not yet an error).
      deps="$(github-api GET "/repos/${owner_repo}/deployments?environment=github-pages&sha=${want}&per_page=20" 2>/dev/null)" || deps=""
      dep_id="$(printf '%s' "${deps}" | jq -r 'map(.id) | max // empty' 2>/dev/null)" || dep_id=""
      if [ -n "${dep_id}" ]; then
         ## Latest status of that deployment (the statuses list is newest-first).
         state="$(github-api GET "/repos/${owner_repo}/deployments/${dep_id}/statuses?per_page=10" 2>/dev/null | jq -r '.[0].state // ""' 2>/dev/null)" || state=""
         if [ "${state}" = "success" ]; then
            return 0
         fi
         ## A terminal failure of OUR deployment is fatal; a transient (pending/in_progress/queued)
         ## or absent status keeps polling until the deadline.
         if [ "${state}" = "failure" ] || [ "${state}" = "error" ]; then
            printf '%s\n' "${me}: GitHub Pages deployment ${dep_id} for ${want} reported '${state}'" >&2
            return 1
         fi
      fi
      [ "$(date +%s)" -lt "${deadline}" ] || return 1
      sleep "${confirm_poll_interval}"
   done
}

## Resolve the generator AND site-deploy as THIS script's SIBLINGS, not by PATH -- so a checkout
## run uses the checkout tools, never the (possibly stale) installed /usr/bin copy. This matters
## for site-deploy too: run unattended (a systemd unit's PATH lacks ~/.local/bin), a bare
## `site-deploy` resolves to a stale /usr/bin copy missing the single-gate push, so its push
## re-triggers the pre-push hook's duplicate website-tests run -- whose minutes hold the push SSH
## open until GitHub idle-closes it, failing the publish. Fall back to PATH only if no sibling.
script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"
generate="${TEST_RESULTS_SITE_GENERATE:-}"
if [ -z "${generate}" ]; then
   generate="${script_dir}/test-results-site-generate"
   [ -x "${generate}" ] || generate="test-results-site-generate"
fi
site_deploy="${TEST_RESULTS_SITE_DEPLOY:-}"
if [ -z "${site_deploy}" ]; then
   site_deploy="${script_dir}/site-deploy"
   [ -x "${site_deploy}" ] || site_deploy="site-deploy"
fi

command -v sandbox >/dev/null 2>&1 || die "sandbox not found"
command -v "${generate}" >/dev/null 2>&1 || die "test-results-site-generate not found"
command -v "${site_deploy}" >/dev/null 2>&1 || die "site-deploy not found"
[ -d "${pages_repo}/.git" ] || die "not a git checkout: ${pages_repo}"
[ -d "${pages_repo}/automated-test-results" ] || die "no automated-test-results/ in ${pages_repo}"

## Serialize on the Pages repo. site-generate rewrites the WHOLE tree in ${pages_repo}
## in place, while site-deploy's website-tests then DECODES every image there. Two runs at
## once (the hourly timer overlapping a manual run, or a long run overrunning the next timer
## tick) let one run's regenerate rewrite a file mid-decode in the other's gate -> a partial
## read surfaces as a spurious "undecodable/corrupt image" that falsely blocks publish. Hold
## an exclusive lock, keyed to the repo it protects, on a dedicated fd for the whole run (the
## fd closes only at process exit) -- the safe path is the default, nothing to recall.
lock_file="${pages_repo}/.git/test-results-deploy.lock"
exec {lock_fd}>"${lock_file}" || die "could not open deploy lock: ${lock_file}"
flock --timeout 3600 "${lock_fd}" \
   || die "another test-results-deploy holds the Pages-repo lock (waited 3600s)"

mkdir --parents -- "${staging_base}"
## Absolutize: a RELATIVE override would make mktemp print a relative staging path, and the later
## `cd` into the Pages repo then points the EXIT-trap cleanup at the wrong directory (a leak).
staging_base="$(cd -- "${staging_base}" && pwd)"
staging="$(mktemp --directory --tmpdir="${staging_base}" deploy.XXXXXX)"
## The sandbox / qube-ctl pull stages the incoming archive on TMPDIR before delivering it to the
## destination, and the default /tmp is the small, near-full tmpfs whose free space the pull's
## budget check rejects. Point TMPDIR + TMP at the disk-backed staging dir so the TRANSPORT's own
## archive staging lands on disk too -- redirecting only the destination is not enough. Cleaned by
## the EXIT trap.
export TMPDIR="${staging}"
export TMP="${staging}"
## Registered in the EXIT trap so a failure at any step (read-tree / add / commit) cannot leak
## the private index or the message temp file.
idx=""
msg_file=""
# shellcheck disable=SC2317  ## runs via the EXIT trap
cleanup() {
   safe-rm --recursive --force -- "${staging}" || true
   [ -z "${idx}" ] || safe-rm --force -- "${idx}" || true
   [ -z "${msg_file}" ] || safe-rm --force -- "${msg_file}" || true
}
trap cleanup EXIT

printf '%s\n' "${me}: pulling results plane from ${target}:${results_remote}"
## --allow-system-path: the results plane lives under /var/www (nginx webroot, world-readable)
## by design; sandbox pull refuses a system path unless the read is declared deliberate.
sandbox --target "${target}" pull --allow-system-path "${results_remote}" "${staging}/results" \
   || die "pull of ${results_remote} from ${target} failed"
[ -d "${staging}/results" ] || die "pull produced no results tree"

## --chrome-from the site's own root page: the generated results pages then carry the SITE's
## actual header nav, not the generator's fallback default -- so website-tests' nav-consistency
## check cannot fail on a drift between the two.
chrome_from=()
[ -f "${pages_repo}/index.html" ] && chrome_from=(--chrome-from "${pages_repo}/index.html")

printf '%s\n' "${me}: regenerating the static site into ${pages_repo}"
"${generate}" \
   --results-root "${staging}/results" \
   --site-out "${pages_repo}" \
   "${chrome_from[@]}" \
   || die "site generation failed"

cd -- "${pages_repo}"
## Commit via a PRIVATE index: this tree is shared across sessions, so staging into the
## shared index (or a directory pathspec) could sweep a sibling's change. read-tree HEAD +
## add the generated site into an isolated index, then commit only that -- a sibling's
## concurrent staging is never swept. (The whole-index commit of the PRIVATE index is the
## intended full regenerate; GIT_INDEX_COMMIT_GUARD_ALLOW=1 satisfies the shared-index gate.)
idx="$(mktemp)"
GIT_INDEX_FILE="${idx}" git read-tree HEAD
GIT_INDEX_FILE="${idx}" git add -A -- automated-test-results
if GIT_INDEX_FILE="${idx}" git diff --cached --quiet HEAD -- automated-test-results; then
   printf '%s\n' "${me}: no results changes to commit (site already current)"
else
   msg_file="$(mktemp)"
   printf '%s\n' "Deploy image-test results" > "${msg_file}"
   GIT_INDEX_FILE="${idx}" GIT_INDEX_COMMIT_GUARD_ALLOW=1 git commit --quiet -F "${msg_file}" \
      || die "commit failed"
fi

## Publish whenever the local branch is AHEAD of the published tip. This covers BOTH a fresh
## commit just made above AND a prior run that committed but whose push failed, leaving a
## stranded, unpushed backlog -- the exact wedge this recovers. Keyed off the real remote tip so
## a run with nothing new does not pay the website-tests gate; if the tip cannot be read, publish
## anyway rather than risk stranding a commit.
remote_tip="$(git ls-remote origin refs/heads/master 2>/dev/null | cut -f1)" || remote_tip=""
if [ -n "${remote_tip}" ] && [ "${remote_tip}" = "$(git rev-parse HEAD)" ]; then
   printf '%s\n' "${me}: already pushed; confirming the live site reflects it."
else
   printf '%s\n' "${me}: publishing via site-deploy"
   "${site_deploy}" || die "site-deploy failed (results committed locally; not published)"
fi

## A pushed commit is not yet a live site (Pages builds async, and can error): confirm the build
## landed AT our commit or FAIL LOUD. This is what stops a stranded/errored/stale publish from
## reading as a successful deploy -- the silent-stale wedge the operator hit.
pushed_head="$(git rev-parse HEAD)"
printf '%s\n' "${me}: confirming GitHub Pages built ${pushed_head} (up to ${confirm_timeout}s)"
confirm_published "${pushed_head}" \
   || die "publish NOT confirmed: GitHub Pages did not report a successful build of ${pushed_head} within ${confirm_timeout}s -- the live site may be stale"
printf '%s\n' "${me}: deployed + confirmed live at ${pushed_head}."
