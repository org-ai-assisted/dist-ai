#!/bin/bash

## Copyright (C) 2025 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Generic boot + functional test entrypoint (CI front-end), invoked as:
##
##   dm-smbios-reader-boot-test --image <path> --arch <amd64|arm64> \
##       --firmware <bios|efi|efi-secureboot> --session <user|sysmaint>
##
## It installs the qemu/OVMF/pexpect runtime, discovers the boot media by image
## kind, then hands the image to the sibling dm-smbios-reader-boot-tests (which bundles
## dm-smbios-reader-qemu + dm-smbios-reader-image-test: boots the image, drives a login-free root serial shell
## and runs 'systemcheck --leak-tests'). The exit code IS the pass/fail signal:
##   0 pass, non-zero booted-but-a-check-failed / no login / setup, 77 SKIP.
##
## All boot tooling lives here in dist-ai; this front-end owns only dependency
## setup, image discovery and dispatch. derivative-maker's CI calls it as
## dist-ai/usr/bin/dm-smbios-reader-boot-test (dist-ai is checked out beside the workspace).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

image=""
arch=""
firmware=""
session="user"
## Empty means "derive from --session": the user session runs the checks as the
## 'user' account, the sysmaint session as the 'sysmaint' account (both exist under
## user-sysmaint-split). An explicit --login-user overrides.
login_user=""
login_pass=""
serial_log=""
backend="auto"
while [ "$#" -gt 0 ]; do
   case "$1" in
      --image)
         [ "$#" -ge 2 ] || { printf '%s\n' "${BASH_SOURCE[0]}: --image requires a value" >&2 ; exit 2 ; }
         image="$2"
         shift 2
         ;;
      --arch)
         [ "$#" -ge 2 ] || { printf '%s\n' "${BASH_SOURCE[0]}: --arch requires a value" >&2 ; exit 2 ; }
         arch="$2"
         shift 2
         ;;
      --firmware)
         [ "$#" -ge 2 ] || { printf '%s\n' "${BASH_SOURCE[0]}: --firmware requires a value" >&2 ; exit 2 ; }
         firmware="$2"
         shift 2
         ;;
      --session)
         [ "$#" -ge 2 ] || { printf '%s\n' "${BASH_SOURCE[0]}: --session requires a value" >&2 ; exit 2 ; }
         session="$2"
         shift 2
         ;;
      --login-user)
         [ "$#" -ge 2 ] || { printf '%s\n' "${BASH_SOURCE[0]}: --login-user requires a value" >&2 ; exit 2 ; }
         login_user="$2"
         shift 2
         ;;
      --login-pass)
         [ "$#" -ge 2 ] || { printf '%s\n' "${BASH_SOURCE[0]}: --login-pass requires a value" >&2 ; exit 2 ; }
         login_pass="$2"
         shift 2
         ;;
      --serial-log)
         [ "$#" -ge 2 ] || { printf '%s\n' "${BASH_SOURCE[0]}: --serial-log requires a value" >&2 ; exit 2 ; }
         serial_log="$2"
         shift 2
         ;;
      --backend)
         [ "$#" -ge 2 ] || { printf '%s\n' "${BASH_SOURCE[0]}: --backend requires a value" >&2 ; exit 2 ; }
         backend="$2"
         shift 2
         ;;
      *)
         printf '%s\n' "${BASH_SOURCE[0]}: unexpected argument: $1" >&2
         exit 2
         ;;
   esac
done

[ -n "${image}" ]    || { printf '%s\n' "${BASH_SOURCE[0]}: --image is required" >&2 ; exit 2 ; }
[ -n "${arch}" ]     || { printf '%s\n' "${BASH_SOURCE[0]}: --arch is required" >&2 ; exit 2 ; }
[ -f "${image}" ]    || { printf '%s\n' "${BASH_SOURCE[0]}: no such image: ${image}" >&2 ; exit 2 ; }

## Runtime dependencies. SeaBIOS ships with qemu-system-x86; ovmf provides both the
## plain and the Secure-Boot OVMF firmware; qemu-efi-aarch64 provides arm64 edk2;
## python3-pexpect drives the login conversation.
##
## Check BEFORE touching apt. 'apt-get update' against a repository this host
## cannot verify fails the whole run even when every package is already present:
## in a sandbox with a signature problem this aborted at exit 100 with a
## zero-byte serial log, which reads as a boot failure and is nothing of the
## kind. Nothing here is version-sensitive, so "already installed" is a complete
## answer and the network round-trip is pure risk.
## Locate package_installed_check.sh: an explicit HELPER_SCRIPTS_PATH wins; else
## the production install under /usr/libexec; else the in-tree checkout. In CI the
## boot harness runs from dist-ai/usr/bin nested in the derivative-maker workspace
## (dist-ai mounted at ./dist-ai) alongside packages/kicksecure/helper-scripts,
## which is checked out but NOT installed -- without this fallback the hardcoded
## /usr/libexec path aborts every boot-test leg before qemu even starts.
dm_boot_test_dir="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
helper_scripts_base="${HELPER_SCRIPTS_PATH:-}"
if [ -z "${helper_scripts_base}" ] && [ ! -e /usr/libexec/helper-scripts/package_installed_check.sh ]; then
   helper_scripts_base="${dm_boot_test_dir}/../../../packages/kicksecure/helper-scripts"
fi
# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/package_installed_check.sh
source "${helper_scripts_base}/usr/libexec/helper-scripts/package_installed_check.sh"

## Only what THIS --arch needs. The list used to be unconditional, so an amd64
## boot test demanded qemu-system-arm and qemu-efi-aarch64 -- emulator and
## firmware for an architecture it never touches. On a host without them that
## forced an apt round-trip (and, where apt cannot verify a repository, an
## outright failure) to install packages the run would not use.
## python3-pexpect drives the serial login conversation (BOTH backends); python3-pytest
## runs the image-free regression suites the wrapper always executes.
boot_test_packages=( python3-pexpect python3-pytest )
if [ "${arch}" != 'amd64' ] && [ "${arch}" != 'arm64' ]; then
   printf '%s\n' "${BASH_SOURCE[0]}: unsupported --arch '${arch}'" >&2
   exit 2
fi
if [ "${backend}" = 'vbox' ]; then
   ## VBox is pre-provisioned on the image-test server (see the vbox-image-testing
   ## skill), never apt-installed here -- require it LOUDLY (hard dependency, not a
   ## skip) and install no qemu runtime.
   if ! type -P VBoxManage >/dev/null 2>&1; then
      printf '%s\n' "${BASH_SOURCE[0]}: --backend vbox needs VBoxManage (install VirtualBox; see the vbox-image-testing skill); a hard dependency, not a skip." >&2
      exit 2
   fi
else
   ## qemu / auto: the qemu runtime. SeaBIOS ships with qemu-system-x86; ovmf gives
   ## the plain + Secure-Boot OVMF firmware; qemu-efi-aarch64 gives arm64 edk2;
   ## xorriso + imagemagick handle ISO/media. Only what THIS --arch needs.
   boot_test_packages+=( qemu-utils xorriso imagemagick )
   case "${arch}" in
      amd64)
         boot_test_packages+=( qemu-system-x86 ovmf )
         ;;
      arm64)
         boot_test_packages+=( qemu-system-arm qemu-efi-aarch64 )
         ;;
   esac
fi
boot_test_missing=()
for boot_test_package in "${boot_test_packages[@]}"; do
   pkg_installed "${boot_test_package}" || boot_test_missing+=( "${boot_test_package}" )
done

if [ "${#boot_test_missing[@]}" -eq 0 ]; then
   printf '%s\n' "${BASH_SOURCE[0]}: all runtime dependencies already installed; skipping apt." >&2
else
   printf '%s\n' "${BASH_SOURCE[0]}: installing missing dependencies: ${boot_test_missing[*]}" >&2
   ## Plain apt-get, not the helper-scripts apt-get-noninteractive wrapper: this
   ## runs in the derivative-maker build container where that wrapper is not on
   ## sudo's PATH (and would itself source helper-scripts libs absent there).
   ## style-ok: allow-apt-get -- deliberate plain apt-get (wrapper unavailable here)
   sudo --non-interactive -- env DEBIAN_FRONTEND=noninteractive apt-get update
   ## style-ok: allow-apt-get -- deliberate plain apt-get (wrapper unavailable here)
   sudo --non-interactive -- env DEBIAN_FRONTEND=noninteractive apt-get install \
      --yes --no-install-recommends -- "${boot_test_missing[@]}"
fi

script_dir="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
## dm-smbios-reader-boot-tests is a sibling in the same bin dir (shipped together); fall
## back to PATH when run from an installed dist-ai package.
boot_tests_bin="${script_dir}/dm-smbios-reader-boot-tests"
[ -x "${boot_tests_bin}" ] || boot_tests_bin="dm-smbios-reader-boot-tests"

## Boot media by kind. Session selection (user/sysmaint) works either way via
## dm-smbios-reader-qemu's SMBIOS kernel-cmdline injection.
##   .iso          -> live image (--iso)
##   .ova          -> a tar container dm-smbios-reader-qemu does not accept; extract its .vmdk
##                    and boot that (--disk)
##   *.libvirt.xz  -> a qcow2/raw disk packed as tar.xz (dm-prepare-release
##                    xz-packs the image and removes the bare disk file); extract
##                    and boot the disk inside (--disk)
##   else          -> a VM disk image (qcow2/raw/vdi/vmdk) booted directly (--disk)
## Temp dir for archive extraction (.ova / .libvirt.xz), removed on exit via a
## function (R-051: no inline trap command). Best-effort; the CI runner is
## ephemeral anyway, and the -snapshot boot reads the extracted disk during the run.
## style-ok: no-safe-rm -- a mktemp scratch dir on the ephemeral CI runner where
## safe-rm (helper-scripts) is not guaranteed present; removed best-effort.
extract_dir=""
# shellcheck disable=SC2317  # invoked indirectly via 'trap ... EXIT'
boot_test_cleanup() {
   [ -n "${extract_dir}" ] && rm --recursive --force -- "${extract_dir}"
   ## Never let the cleanup status become the script's exit code: bash makes a
   ## non-zero EXIT-trap return override an explicit 'exit 0'. With no extract dir
   ## (the ISO path) the '[ -n "" ]' test is false (1), which otherwise fails an
   ## otherwise-passing leg.
   return 0
}
trap boot_test_cleanup EXIT

case "${image}" in
   *.iso)
      test_args=(--iso "${image}")
      ;;
   *.ova)
      extract_dir="$(mktemp --directory)"
      tar --extract --file "${image}" --directory "${extract_dir}"
      ## First .vmdk via parameter expansion, not 'head -1': head would SIGPIPE
      ## find/sort (exit 141 under pipefail) once their output exceeds the buffer.
      ova_vmdk_list="$(find "${extract_dir}" -type f -name '*.vmdk' | LC_ALL=C sort)"
      ova_vmdk="${ova_vmdk_list%%$'\n'*}"
      [ -n "${ova_vmdk}" ] || { printf '%s\n' "${BASH_SOURCE[0]}: no .vmdk inside ${image}" >&2; exit 2; }
      test_args=(--disk "${ova_vmdk}")
      ;;
   *.xz)
      extract_dir="$(mktemp --directory)"
      tar --extract --xz --file "${image}" --directory "${extract_dir}"
      disk_list="$(find "${extract_dir}" -type f \( -name '*.qcow2' -o -name '*.raw' \) | LC_ALL=C sort)"
      disk_img="${disk_list%%$'\n'*}"
      [ -n "${disk_img}" ] || { printf '%s\n' "${BASH_SOURCE[0]}: no .qcow2/.raw inside ${image}" >&2; exit 2; }
      test_args=(--disk "${disk_img}")
      ;;
   *)
      test_args=(--disk "${image}")
      ;;
esac
## Run the checks as the account that owns the selected session unless the caller
## pinned one: user session -> 'user', sysmaint session -> 'sysmaint'.
[ -n "${login_user}" ] || login_user="${session}"
test_args+=(
   --arch "${arch}"
   --backend "${backend}"
   --session "${session}"
   --login-user "${login_user}"
)
[ -n "${firmware}" ]   && test_args+=(--firmware "${firmware}")
[ -n "${login_pass}" ] && test_args+=(--login-pass "${login_pass}")
[ -n "${serial_log}" ] && test_args+=(--serial-log "${serial_log}")

printf '%s\n' "${BASH_SOURCE[0]}: boot-testing ${image} (arch=${arch} firmware=${firmware:-default} session=${session})"
## Run dm-smbios-reader-boot-tests and forward its exit code; avoid 'exec' so any future
## cleanup after this line still runs.
boot_tests_rc=0
"${boot_tests_bin}" "${test_args[@]}" || boot_tests_rc="$?"
exit "${boot_tests_rc}"
