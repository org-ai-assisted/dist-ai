#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## Integration tests for the sdwdate-gui tray menu. Unlike the offscreen
## unit suite (sdwdate-gui-tests), these drive the real tray icon end to
## end on a real display: a headless X11 server with an XEmbed systray host
## (left- and right-click open the menu), and a headless Wayland compositor
## (the menu opt-out under Wayland). They need extra tooling; any phase
## whose tooling is missing is skipped loudly rather than failing.
##
## Works installed (/usr/share/sdwdate-gui-tests/integration) and from a git
## checkout. For a checkout against an uninstalled sdwdate-gui tree, set
## PYTHONPATH to its dist-packages directory before running; it is passed
## through to the harnesses.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/sdwdate-gui-tests/integration" ]; then
  integration_dir="${script_dir}/../share/sdwdate-gui-tests/integration"
else
  integration_dir='/usr/share/sdwdate-gui-tests/integration'
fi

## Shared headless-Wayland bringup (labwc), used by the wayland phase (no private weston). Same
## source the shots capture and the other GUI-test harnesses use.
if [ -f "${script_dir}/../share/dist-ai-tests-common/wl-headless-lib.bash" ]; then
  wl_headless_lib="${script_dir}/../share/dist-ai-tests-common/wl-headless-lib.bash"
else
  wl_headless_lib='/usr/share/dist-ai-tests-common/wl-headless-lib.bash'
fi
# shellcheck source=../share/dist-ai-tests-common/wl-headless-lib.bash
source "${wl_headless_lib}"

## Self-heal an id-squashed /tmp/.X11-unix (Qubes 'sandbox' DEFAULT namespace): re-exec this
## whole run inside a private user+mount+net namespace so BOTH the X11 (Xvfb) and Wayland (labwc)
## phases see a root-owned X socket dir. No-op on CI/host and when already re-exec'd. Guarded so a
## lib stub in a unit test may omit the symbol and skip self-heal.
if declare -F wl_headless_selfheal_reexec >/dev/null 2>&1; then
  wl_headless_selfheal_reexec "$0" "$@"
fi

ran=0
failed=0
bg_pids=()
wl_started=''

# shellcheck disable=SC2317  # body runs only via the EXIT trap
cleanup() {
  local pid
  for pid in "${bg_pids[@]:-}"; do
    if [ -n "${pid}" ]; then
      kill "${pid}" 2>/dev/null || true
    fi
  done
  ## Tear down the labwc compositor if the wayland phase brought one up.
  if [ -n "${wl_started}" ]; then
    wl_headless_stop
  fi
}
trap cleanup EXIT

have_all() {
  ## These are all Debian binaries installed under /usr/bin, so a path
  ## test is used (per the bash style guide, preferred over a 'has'
  ## waiver when the install location is fixed).
  local cmd
  for cmd in "$@"; do
    if [ ! -x "/usr/bin/${cmd}" ]; then
      return 1
    fi
  done
  return 0
}

qt_has_wayland_plugin() {
  ## The Qt wayland platform plugin ships in qtwayland5.
  compgen -G \
    '/usr/lib/*/qt5/plugins/platforms/libqwayland-*.so' >/dev/null 2>&1
}

x11_click_once() {
  ## Args: display-number, X button number, human label. Starts a clean
  ## Xvfb + systray host, runs one click, tears them down. A fresh host per
  ## click avoids racing on icon embedding and on the popup pointer grab.
  local dnum="$1" button="$2" label="$3"
  local display=":${dnum}" xvfb_pid st_pid rc=0

  Xvfb "${display}" -screen 0 1024x768x24 >/dev/null 2>&1 &
  xvfb_pid=$!
  bg_pids+=("${xvfb_pid}")
  sleep 1.5

  DISPLAY="${display}" stalonetray --geometry 1x1+30+30 --icon-size 48 \
    --grow-gravity NW --max-geometry 1x1 --background '#202020' \
    >/dev/null 2>&1 &
  st_pid=$!
  bg_pids+=("${st_pid}")
  sleep 1.5

  printf -- '%s\n' "--- x11 ${label}-click ---"
  if ! DISPLAY="${display}" \
    "${integration_dir}/x11_click_harness.py" "${button}"; then
    rc=1
  fi

  kill "${st_pid}" "${xvfb_pid}" 2>/dev/null || true
  return "${rc}"
}

run_x11_phase() {
  if ! have_all Xvfb stalonetray xdotool xwininfo; then
    printf '%s\n' "SKIP x11: needs Xvfb, stalonetray, xdotool, xwininfo"
    printf '%s\n' \
      "  install: sudo apt-get install --no-install-recommends xvfb stalonetray xdotool x11-utils"
    return 0
  fi

  ran=$((ran + 1))
  if ! x11_click_once 99 1 left; then
    failed=$((failed + 1))
  fi

  ran=$((ran + 1))
  if ! x11_click_once 100 3 right; then
    failed=$((failed + 1))
  fi
}

run_wayland_phase() {
  if ! have_all labwc || ! qt_has_wayland_plugin; then
    printf '%s\n' "SKIP wayland: needs labwc and the Qt wayland plugin"
    printf '%s\n' \
      "  install: sudo apt-get install --no-install-recommends labwc qtwayland5"
    return 0
  fi

  ## Bring up the shared headless labwc (mints its own private runtime dir, exports
  ## WAYLAND_DISPLAY, hides the pointer). The harness only needs a real 'wayland' plugin
  ## target -- no capture -- so no icon theme / output scale.
  # shellcheck disable=SC2119
  if ! wl_headless_start; then
    printf '%s\n' "SKIP wayland: labwc failed to start a compositor"
    return 0
  fi
  wl_started='1'
  export QT_QPA_PLATFORM='wayland'

  ran=$((ran + 1))
  printf -- '%s\n' "--- wayland menu opt-out ---"
  if ! "${integration_dir}/wayland_menu_harness.py"; then
    failed=$((failed + 1))
  fi

  unset QT_QPA_PLATFORM
  wl_headless_stop
  wl_started=''
}

report_result() {
  printf '%s\n' "" "=== integration summary: ${ran} run, ${failed} failed ==="
  ## A real failure trumps everything.
  if [ "${failed}" -ne 0 ]; then
    exit 1
  fi
  ## Every phase skipped for missing tooling -> NOTHING was verified. Per the
  ## 0=PASS / 77=SKIP / else=FAIL orchestrator contract, that is a SKIP, never a
  ## PASS: falling through to 'exit 0' here reported GREEN with zero tests run.
  if [ "${ran}" -eq 0 ]; then
    ## Nothing ran -> NOTHING verified. Per 0=PASS / 77=SKIP / else=FAIL, that is a
    ## SKIP, never a PASS: falling through to 'exit 0' reported GREEN with zero tests
    ## run. This is the OPTIONAL integration lane (dist-ai-tests-all --integration);
    ## its tooling (Xvfb/weston/stalonetray/xdotool/dbus/python3-dbus/gi) is absent on
    ## a generic CI container.
    printf '%s\n' "SKIP: no integration phase ran; install the tooling above."
    ## style-ok: allow-skip: nothing ran -- optional integration tooling absent
    exit 77
  fi
  exit 0
}

run_x11_phase
run_wayland_phase
report_result
