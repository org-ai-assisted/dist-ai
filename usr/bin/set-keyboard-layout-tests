#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Suite runner for helper-scripts' set-keyboard-layout (set-console-keymap /
## set-grub-keymap / set-system-keymap / set-labwc-keymap share one library).
##
## Runs every *_test.sh in usr/share/set-keyboard-layout-tests and fails if any
## of them does. Discovery is a glob so a new lane needs no edit here.
##
## Targets the installed package by default; set SET_KEYBOARD_LAYOUT_REPO (or
## HELPER_SCRIPTS_REPO / HELPER_SCRIPTS_PATH, wired by dist-ai-tests-all) to test
## a checkout. A lane that cannot resolve its subject fails FATAL (exit 1): the
## subject is required, never optional, so its absence is a hard error, not a
## skip. No root, no network, no real GRUB.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/set-keyboard-layout-tests" ]; then
   tests_dir="${script_dir}/../share/set-keyboard-layout-tests"
else
   tests_dir='/usr/share/set-keyboard-layout-tests'
fi

shopt -s nullglob
case_scripts=( "${tests_dir}"/*_test.sh )
shopt -u nullglob

if [ "${#case_scripts[@]}" -eq 0 ]; then
   printf '%s\n' "FATAL: no case scripts found in '${tests_dir}'" >&2
   exit 1
fi

rc=0
failed=0
skipped=0
for case_script in "${case_scripts[@]}"; do
   printf '%s\n' "== $(basename -- "${case_script}") =="
   case_rc=0
   "${case_script}" "$@" || case_rc=$?
   if [ "${case_rc}" -eq 77 ]; then
      skipped=$(( skipped + 1 ))
   elif [ "${case_rc}" -ne 0 ]; then
      failed=$(( failed + 1 ))
      rc=1
   fi
done

printf '%s\n' ""
printf '%s\n' "${#case_scripts[@]} case(s), ${failed} failed, ${skipped} skipped"
exit "${rc}"
