#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Offline regression suite for sdwdate's onion-tester CI wrappers (ci/*.sh in
## the sdwdate checkout): the retry/backoff policy of onion-tester-run.sh, and
## the scratch-file handling of onion-tester-verify-evidence.sh. Everything is
## mocked -- no Tor, no network, no wayback, no privleap, no root -- so it runs
## in the dist-ai container in seconds.
##
## Deliberately NOT covering the live Tor probe, onion-tester-configure-tor.sh
## or onion-tester-wait-bootstrap.sh: those need sudo, systemd and a real tor on
## the runner, which this container does not have. They stay in sdwdate's own
## workflow.
##
## The subject is resolved by each payload:
##   * SDWDATE_REPO=/path/to/sdwdate -> that checkout's ci/ scripts, OR
##   * ONION_TESTER_RUN_BIN / VERIFY_EVIDENCE_BIN -> a specific file.
## An absent subject exits 77 (SKIP), never FAIL.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

export LC_ALL=C

## Canonical suite exit (fail > skip > pass): a per-case skip surfaces as
## SKIP so the orchestrator's --allow-skip governs it, instead of being
## folded into a passing suite.
suite_exit_helper="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")/../share/dist-ai-tests-common/suite-exit.bash"
[ -r "${suite_exit_helper}" ] || suite_exit_helper='/usr/share/dist-ai-tests-common/suite-exit.bash'
# shellcheck source=../share/dist-ai-tests-common/suite-exit.bash
source "${suite_exit_helper}"

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/sdwdate-onion-tester-tests" ]; then
   tests_dir="${script_dir}/../share/sdwdate-onion-tester-tests"
else
   tests_dir='/usr/share/sdwdate-onion-tester-tests'
fi

## Run every *_test.sh. Exit 77 from a payload means SKIP (subject absent) and is
## not a failure; any other non-zero is a failure.
shopt -s nullglob
failures=0
skipped=0
env_unmet=0
ran=0
for test_script in "${tests_dir}"/*_test.sh; do
   ran=$(( ran + 1 ))
   printf '%s\n' "" "########## $(basename -- "${test_script}") ##########"
   rc=0
   bash -- "${test_script}" "$@" || rc=$?
   if [ "${rc}" -eq 77 ]; then
      printf '%s\n' "########## SKIPPED: $(basename -- "${test_script}") ##########"
      skipped=$(( skipped + 1 ))
   elif [ "${rc}" -eq 78 ]; then
      env_unmet=$(( env_unmet + 1 ))
   elif [ "${rc}" -ne 0 ]; then
      printf '%s\n' "########## FAILED (${rc}): $(basename -- "${test_script}") ##########"
      failures=$(( failures + 1 ))
   fi
done

if [ "${ran}" -eq 0 ]; then
   printf '%s\n' "ERROR: no *_test.sh found in ${tests_dir}" >&2
   exit 1
fi
printf '%s\n' '' "${ran} sdwdate-onion-tester case(s): ${failures} failed, ${skipped} skipped, ${env_unmet} env-unmet"
suite_exit "${failures}" "${skipped}" "${env_unmet}"
