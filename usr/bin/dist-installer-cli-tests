#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Regression suite for usability-misc's dist-installer-cli CI glue. Currently
## one payload: the "back to default repository" step must propagate the
## installer's OWN exit code, not the status of the `if` that tested it. Drives
## the shipped ci/vbox-back-to-default-repo.sh with a stubbed installer; no root,
## no network. Works installed (payloads under /usr/share/dist-installer-cli-tests)
## or from a git checkout. Point it at the usability-misc checkout with
## USABILITY_MISC_REPO; otherwise a payload exits 77 (SKIP).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

export LC_ALL=C

## The standalone every payload drives acquires a per-user concurrency lock
## (helper-scripts lockfile.sh) that needs a runtime dir. A CI runner may have no
## /run/user/${EUID} and sudo does not pass XDG_RUNTIME_DIR, so give the whole
## suite a private, owned one; a payload that needs its own still overrides it.
dist_installer_tests_xdg="$(mktemp --directory)"
chmod 0700 -- "${dist_installer_tests_xdg}"
export XDG_RUNTIME_DIR="${dist_installer_tests_xdg}"
# shellcheck disable=SC2317  # reached only via the EXIT trap
dist_installer_tests_cleanup() {
   safe-rm --recursive --force -- "${dist_installer_tests_xdg}" || true
}
trap dist_installer_tests_cleanup EXIT

## Canonical suite exit (fail > skip > pass): a per-case skip surfaces as
## SKIP so the orchestrator's --allow-skip governs it, instead of being
## folded into a passing suite.
suite_exit_helper="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")/../share/dist-ai-tests-common/suite-exit.bash"
[ -r "${suite_exit_helper}" ] || suite_exit_helper='/usr/share/dist-ai-tests-common/suite-exit.bash'
# shellcheck source=../share/dist-ai-tests-common/suite-exit.bash
source "${suite_exit_helper}"

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/dist-installer-cli-tests" ]; then
   tests_dir="${script_dir}/../share/dist-installer-cli-tests"
else
   tests_dir='/usr/share/dist-installer-cli-tests'
fi

## Run every *_test.sh. Exit 77 from a payload means SKIP (checkout absent) and
## does not count as a failure; any other non-zero exit is a failure. A payload
## added to the directory runs without a second edit here (an unrun test is a
## silent green).
shopt -s nullglob
failures=0
ran=0
skipped=0
env_unmet=0
for test_script in "${tests_dir}"/*_test.sh; do
   ran=$(( ran + 1 ))
   name="$(basename -- "${test_script}")"
   printf '%s\n' '' "########## ${name} ##########"
   rc=0
   bash -- "${test_script}" "$@" || rc=$?
   if [ "${rc}" -eq 77 ]; then
      printf '%s\n' "########## SKIPPED: ${name} ##########"
      skipped=$(( skipped + 1 ))
   elif [ "${rc}" -eq 78 ]; then
      env_unmet=$(( env_unmet + 1 ))
   elif [ "${rc}" -ne 0 ]; then
      printf '%s\n' "########## FAILED (${rc}): ${name} ##########"
      failures=$(( failures + 1 ))
   fi
done

if [ "${ran}" -eq 0 ]; then
   printf '%s\n' "ERROR: no *_test.sh found in ${tests_dir}" >&2
   exit 1
fi
printf '%s\n' '' "${ran} dist-installer-cli case(s): ${failures} failed, ${skipped} skipped, ${env_unmet} env-unmet"
suite_exit "${failures}" "${skipped}" "${env_unmet}"
