#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Regression tests for developer-meta-files'
## 'dm-virtualbox-update-local-and-wiki-links'. Each check reproduces the ROOT
## CAUSE of a fixed bug (old-broken) and asserts the current script no longer
## exhibits it (new-fixed).
##
## Usage: dm-virtualbox-wiki-links-tests [/path/to/dm-virtualbox-update-local-and-wiki-links]

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/has.sh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/has.sh

mydir="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" && pwd )"

script="${1:-}"
if [ -z "${script}" ]; then
   for cand in \
      "${mydir}/../../derivative-maker/packages/kicksecure/developer-meta-files/usr/bin/dm-virtualbox-update-local-and-wiki-links" \
      "/usr/bin/dm-virtualbox-update-local-and-wiki-links" ; do
      if [ -r "${cand}" ]; then
         script="${cand}"
         break
      fi
   done
fi
[ -n "${script}" ] && [ -r "${script}" ] || { printf '%s\n' "ERROR: script not found; pass it as arg 1." >&2; exit 2; }

fails=0
pass() { printf '%s\n' "  PASS: $1"; }
fail() { printf '%s\n' "  FAIL: $1" >&2; fails=$((fails + 1)); }

leading_blank_lines() { awk 'NF{exit} {c++} END{print c+0}' "$1"; }

printf '%s\n' "== dm-virtualbox-wiki-links-tests =="
printf '%s\n' "script under test: ${script}"

## ---------------------------------------------------------------------------
## Bug 1: leading blank lines on the uploaded wiki page.
## Root cause: the wiki page is staged into a fresh empty mktemp and handed to
## mw-edit; anything that prepends a newline (or otherwise mangles the content)
## before the write shows up as a blank line at the top of the uploaded page.
## The fix writes the page verbatim with 'overwrite'. Drive the REAL
## save_cached_page_to_wiki from the script, stub the non-subject collaborators
## (page fetch + upload), keep the real write, and assert the file mw-edit
## receives is the content verbatim: no leading blank line, byte-identical.
## ---------------------------------------------------------------------------
printf '%s\n' "" "[1] wiki tmpfile written verbatim (no leading blank line)"
save_src="$(sed -n '/^save_cached_page_to_wiki ()/,/^}/p' "${script}")"
if [ -z "${save_src}" ]; then
   ## Anti-vacuous: the subject was renamed/refactored out from under us.
   fail "could not extract save_cached_page_to_wiki() from the script"
elif ! has overwrite; then
   printf '%s\n' "  SKIP: 'overwrite' not on PATH (cannot drive the real write path)"
else
   eval "${save_src}"
   wiki_capture="$(mktemp)"
   ## content the real write must reproduce verbatim.
   canary_content="CANARY_TOP_LINE
second line
third line"
   ## Collaborator stubs. shellcheck cannot see they are called from the
   ## eval'd save_cached_page_to_wiki, hence SC2317.
   WIKI_URL='https://example.com/w'
   # shellcheck disable=SC2317
   get_wiki_page_cached() { wiki_content="${canary_content}"; }
   # shellcheck disable=SC2317
   mw-edit() { cp -- "$2" "${wiki_capture}"; }
   save_cached_page_to_wiki 'SomePage' >/dev/null
   cap_lead="$(leading_blank_lines "${wiki_capture}")"
   ## Pass requires: the marker actually reached the file (anti-vacuous proof the
   ## real write ran), zero leading blank lines, and byte-identical content
   ## (command substitution strips the single trailing newline 'overwrite' adds).
   if grep --quiet 'CANARY_TOP_LINE' "${wiki_capture}" \
      && [ "${cap_lead}" -eq 0 ] \
      && [ "$(cat -- "${wiki_capture}")" = "${canary_content}" ]; then
      pass "save_cached_page_to_wiki writes the page verbatim (no leading blank line, content intact)"
   else
      fail "wiki page not written verbatim (leading blank lines=${cap_lead}); leading-newline/content regression on the uploaded page"
   fi
   safe-rm -f "${wiki_capture}"
fi

## ---------------------------------------------------------------------------
## Bug 2: extract_url only returned the LAST match, so the multi-URL ambiguity
## warning was dead. Extract the function from the script and verify it now
## emits one line PER match (0 / 1 / many distinguishable).
## ---------------------------------------------------------------------------
printf '%s\n' "" "[2] extract_url emits every match"
## stecho is a stub that the eval'd extract_url (pulled from the script under
## test below) calls; shellcheck cannot see that indirect use.
# shellcheck disable=SC2317
stecho() { printf '%s\n' "$1"; }
## Pull just the extract_url function definition out of the script and eval it.
extract_url_src="$(sed -n '/^extract_url ()/,/^}/p' "${script}")"
if [ -n "${extract_url_src}" ]; then
   eval "${extract_url_src}"
   regex='https:\/\/download.virtualbox.org\/virtualbox\/.*\/VirtualBox-.*Win\.exe'
   two="a https://download.virtualbox.org/virtualbox/7.2.2/VirtualBox-7.2.2-Win.exe a
b https://download.virtualbox.org/virtualbox/7.2.3/VirtualBox-7.2.3-Win.exe b"
   readarray -t got < <(extract_url "${two}" "${regex}")
   [ "${#got[@]}" -eq 2 ] && pass "two matching URLs -> 2 results (ambiguity now detectable)" \
                          || fail "expected 2 results for two matches, got ${#got[@]} (multi-URL warning still dead)"
   readarray -t one < <(extract_url "x https://download.virtualbox.org/virtualbox/7.2.2/VirtualBox-7.2.2-Win.exe y" "${regex}")
   [ "${#one[@]}" -eq 1 ] && pass "one match -> 1 result" || fail "expected 1 result, got ${#one[@]}"
   readarray -t none < <(extract_url "nothing here" "${regex}")
   [ "${#none[@]}" -eq 0 ] && pass "no match -> 0 results" || fail "expected 0 results, got ${#none[@]}"
else
   fail "could not extract extract_url() from the script"
fi

## ---------------------------------------------------------------------------
## Bug 3: an empty scrape ('latest' URL) flowed into the local-file writes and
## corrupted them ('dirname ""' -> '.', download.txt truncated, SHA256SUMS
## clobbered). Drive the REAL main() with the download-page scrape returning
## nothing and assert it FAILS FAST -- dies at the guard before any write.
## Every collaborator is stubbed so that, WITHOUT the guard, main runs to a
## clean exit; a missing/disabled guard is then observable as a non-failure,
## not masked by some unrelated error.
## ---------------------------------------------------------------------------
printf '%s\n' "" "[3] fail-fast on empty scrape"
main_src="$(sed -n '/^main ()/,/^}/p' "${script}")"
if [ -z "${main_src}" ]; then
   ## Anti-vacuous: the subject was renamed/refactored out from under us.
   fail "could not extract main() from the script"
else
   ## Top-level vars main relies on (declared outside main in the script).
   vbox_download_page='https://www.virtualbox.org/wiki/Downloads'
   wiki_vbox_page='Template:VirtualBox_Host_Software_Installation'
   vbox_win_regex='x'; vbox_macos_intel64_regex='x'; vbox_macos_arm64_regex='x'
   wiki_url_list=('https://example.com/w')
   derivative_maker_source_code_dir="$(mktemp -d)"
   ## Collaborator stubs (SC2317: called from the eval'd main). Empty scrape ->
   ## empty 'latest' URLs, which must trip the guard.
   # shellcheck disable=SC2317
   get_url_from_page() { func_result=''; }
   # shellcheck disable=SC2317
   get_url_from_wiki() { func_result=''; }
   # shellcheck disable=SC2317
   replace_wiki_string() { return 0; }
   # shellcheck disable=SC2317
   save_cached_page_to_wiki() { return 0; }
   # shellcheck disable=SC2317
   overwrite() { return 0; }
   # shellcheck disable=SC2317
   scurl() { return 0; }
   # shellcheck disable=SC2317
   stsponge() { cat >/dev/null; }
   # shellcheck disable=SC2317
   stecho() { printf '%s\n' "$*"; }
   ## Faithful stub of the cross-package 'die' collaborator: preserve its
   ## exit-code + message contract so the SUBJECT's guard is what we observe.
   # shellcheck disable=SC2317
   die() { printf '%s\n' "${2}" >&2; exit "${1}"; }
   eval "${main_src}"
   scrape_err="$(mktemp)"
   scrape_rc=0
   ## Left side of '||' runs with errexit disabled, so main runs to its natural
   ## end (guard 'die' exits 1; a mutant with no guard exits 0).
   ( main ) >/dev/null 2>"${scrape_err}" || scrape_rc=$?
   if [ "${scrape_rc}" -ne 0 ] \
      && grep --quiet 'no latest Windows VirtualBox URL scraped' "${scrape_err}"; then
      pass "empty scrape -> main dies at the guard before any local write"
   else
      fail "empty scrape did NOT fail-fast (rc=${scrape_rc}); local files can be corrupted"
   fi
   safe-rm -rf "${scrape_err}" "${derivative_maker_source_code_dir}"
fi

printf '%s\n' "" "==== FAILURES: ${fails} ===="
exit "${fails}"
