#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Formal verification of curl-prgrs' pure decision functions
## (verify_curl_prgrs_formal.py): Z3 SMT proofs of the arithmetic/verdict
## properties, cross-checked by enumeration against the REAL bash, with canaries.
##
## SKIPs (77) ONLY when the curl-prgrs subject is absent (a source-tree / partial
## run). A missing python3-z3 is a HARD FAILURE inside the harness, never a skip
## -- a verification suite must not silently disable itself. Set
## HELPER_SCRIPTS_REPO to a checkout. No root, no network.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/helper-scripts-lib-tests" ]; then
  tests_dir="${script_dir}/../share/helper-scripts-lib-tests"
else
  tests_dir='/usr/share/helper-scripts-lib-tests'
fi

[ -v HELPER_SCRIPTS_REPO ] || HELPER_SCRIPTS_REPO=""
if [ -n "${HELPER_SCRIPTS_REPO}" ]; then
  subject="${HELPER_SCRIPTS_REPO%/}/usr/libexec/helper-scripts/curl-prgrs"
else
  subject='/usr/libexec/helper-scripts/curl-prgrs'
fi
if [ ! -f "${subject}" ]; then
  printf '%s\n' "helper-scripts-lib-tests-verify: SKIP (curl-prgrs not found at '${subject}')" >&2
  printf '%s\n' "set HELPER_SCRIPTS_REPO to a helper-scripts checkout, or install helper-scripts" >&2
  exit 77
fi

rc=0
## style-ok: allow-python-dashdash -- run through the python3 on PATH (venv /
## user-site), where python3-z3 may live.
python3 -- "${tests_dir}/verify_curl_prgrs_formal.py" "$@" || rc=$?
exit "${rc}"
