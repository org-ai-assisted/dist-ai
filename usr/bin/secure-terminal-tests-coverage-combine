## AI-Assisted

## Thin wrapper: the COMBINE entry of the secure-terminal coverage gate. Unions the coverage data
## the -chunk1..-chunk5 entries collected into the shared per-run dir, asserts the WHOLE gate at
## 100% (gated_free + gated_qt + the fuzz-widget self-coverage + the Z3 formal proofs), and cleans
## the shared dir. MUST run AFTER all chunk entries (registered last in dist-ai-tests-all).
## style-ok: R-103 -- a thin wrapper is MEANT to exec the real runner unchanged.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

exec env ST_COV_TIER=combine \
   "$(dirname -- "$(readlink --canonicalize -- "$0")")/secure-terminal-tests-coverage" "$@"
