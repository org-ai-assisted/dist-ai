#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Run ONE dm-smbios-reader-vbox image test as an unprivileged test user and PUBLISH its
## artifacts (screenshot + a JSON result) into the read-only results plane
## (nginx over an onion). The systemd unit image-test@.service invokes this with
## a per-instance config; scheduling (timers) is deliberately out of scope here.
##
## Config file (sourced; a plain key=value + one array): defines
##   NAME       -- results-plane subtree + instance label (safe path segment).
##   TEST_USER  -- the Linux user the VM runs as (VBox state is per-$HOME, so the
##                 user IS the isolation boundary; never root).
##   MODE       -- dm-smbios-reader-vbox subcommand: run (boot an .ova/existing VM) or install
##                 (build an EFI VM booting an ISO vs an empty disk).
##   DM_ARGS    -- bash array of the remaining dm-smbios-reader-vbox args (--vm/--iso/--ova/
##                 --expect/--firmware/...); --shot is appended by this runner.
##
## The runner itself must be root (the unit runs as root): it drops to TEST_USER
## for the VM via sudo, then republishes the artifacts as the nginx owner. The
## test user needs NO sudo -- KVM is blacklisted on this host so dm-smbios-reader-vbox's AMD-V
## prerequisite is already satisfied and never shells out to modprobe.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"

## Overridable so the suite can point them at a scratch tree; production values
## match the results-plane provisioning (results_plane.sh).
RESULTS_ROOT="${IMAGE_TEST_RESULTS_ROOT:-/var/www/results}"
RESULTS_OWNER="${IMAGE_TEST_RESULTS_OWNER:-www-data}"
DM_VBOX="${DM_VBOX:-dm-smbios-reader-vbox}"

## Resolve the shared results-plane publisher from the checkout (sibling
## ../libexec) or the installed path; same source either way.
script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"
if [ -d "${script_dir}/../libexec/image-test" ]; then
   image_test_libexec="${script_dir}/../libexec/image-test"
else
   image_test_libexec='/usr/libexec/image-test'
fi
# shellcheck source=../libexec/image-test/results-publish.bsh
source "${image_test_libexec}/results-publish.bsh"

die() {
   local code="$1"
   shift
   printf '%s: ERROR: %s\n' "${me}" "$*" >&2
   exit "${code}"
}

## Reject anything that is not a single safe path segment: NAME becomes a
## directory under the web root, so '/', '..', empty or leading-dash are refused
## before any mkdir.
validate_name() {
   local value="$1"
   case "${value}" in
      ''|*/*|.|..|-*)
         die 2 "unsafe NAME '${value}' -- must be a single safe path segment"
         ;;
   esac
}

main() {
   local config="${1:-}"
   [ -n "${config}" ] || die 2 "usage: ${me} CONFIG_FILE"
   [ -r "${config}" ] || die 2 "config not readable: '${config}'"

   ## Config-provided; declared here so nounset gives a clear error if omitted.
   NAME=""
   TEST_USER=""
   MODE=""
   local -a DM_ARGS=()
   # shellcheck disable=SC1090  # config path is runtime-provided, not constant
   source "${config}"

   validate_name "${NAME}"
   [ -n "${TEST_USER}" ] || die 2 "config '${config}': TEST_USER is required"
   [ "${TEST_USER}" != 'root' ] || die 2 "TEST_USER must not be root (VBox state per-user is the isolation boundary)"
   id "${TEST_USER}" >/dev/null 2>&1 || die 2 "TEST_USER '${TEST_USER}' does not exist"
   case "${MODE}" in
      run|install)
         true
         ;;
      *)
         die 2 "config '${config}': MODE must be run or install, got '${MODE}'"
         ;;
   esac

   ## Collect the --expect values (for the JSON summary) from DM_ARGS.
   local -a expect=()
   local i
   for (( i = 0; i < ${#DM_ARGS[@]}; i++ )); do
      if [ "${DM_ARGS[i]}" = '--expect' ] && [ $(( i + 1 )) -lt ${#DM_ARGS[@]} ]; then
         expect+=( "${DM_ARGS[i + 1]}" )
      fi
   done

   ## dm-smbios-reader-vbox runs as TEST_USER and writes the screenshot to a path the test user
   ## owns (the web root is not user-writable); the runner (root) then republishes
   ## it via the shared publisher -- root reads the test user's file directly.
   local shot_user rc pass outdir verdict
   shot_user="$(sudo -u "${TEST_USER}" -- mktemp --tmpdir "image-test-${NAME}.XXXXXX.png")"

   ## The VM step may FAIL (that is the signal we publish) -- capture rc, never
   ## let it abort the publish.
   rc=0
   sudo -u "${TEST_USER}" -- "${DM_VBOX}" "${MODE}" "${DM_ARGS[@]}" \
      --shot "${shot_user}" || rc=$?
   if [ "${rc}" -eq 0 ]; then
      pass='true'
   else
      pass='false'
   fi

   outdir="$(image_test_results_publish \
      "${RESULTS_ROOT}" "${RESULTS_OWNER}" "${NAME}" "${TEST_USER}" "${MODE}" \
      "${rc}" "${pass}" "${shot_user}" "${expect[@]}")"
   if [ -f "${shot_user}" ]; then
      safe-rm --force -- "${shot_user}"
   fi

   ## Verdict from the SAME shared helper the publisher uses for result.json, so the
   ## console line and the JSON never disagree (rc 2 = INCONCLUSIVE, not FAIL).
   verdict="$(image_test_verdict_from_rc "${rc}")"
   printf '%s: %s -- %s (rc=%s) -> %s\n' \
      "${me}" "${NAME}" "${verdict}" "${rc}" "${outdir}"
   return "${rc}"
}

## Self-lock: a VBox image test is 'work'-class VM work on the shared OVH server -- it may
## run alongside other work but is mutually exclusive with a leak test. Re-exec under
## dm-vm-lock (class=work, SHARED) on direct execution only; the re-exec'd run sees
## DM_VM_LOCK_HELD and runs through. Runs as root (systemd unit); the lock spans the whole
## test including the dm-smbios-reader-vbox child it sudo-drops into.
if [ "${BASH_SOURCE[0]}" = "${0}" ] && [ -z "${DM_VM_LOCK_HELD:-}" ]; then
   ## style-ok: R-103 -- intentional re-exec: run this VBox image test under the VM-work lock.
   exec dm-vm-lock acquire --class work --ttl "${IMAGE_TEST_LOCK_TTL:-3600}" -- "$0" "$@"
fi
main "$@"
