#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Suite runner for swap-file-creator. Runs every *_test.sh in
## usr/share/swap-file-creator-tests and fails if any of them does. Discovery is
## a glob so a new lane needs no edit here.
##
## Targets the installed package by default; set SWAP_FILE_CREATOR_REPO to a
## checkout. The subject sources check_runtime.bsh at source time, so a lane also
## needs HELPER_SCRIPTS_PATH (checkout) or the installed helper-scripts. A lane
## that cannot resolve a REQUIRED subject FAILS (never a silent skip). No root,
## no network.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## Canonical suite exit (fail > skip > pass).
suite_exit_helper="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")/../share/dist-ai-tests-common/suite-exit.bash"
[ -r "${suite_exit_helper}" ] || suite_exit_helper='/usr/share/dist-ai-tests-common/suite-exit.bash'
# shellcheck source=../share/dist-ai-tests-common/suite-exit.bash
source "${suite_exit_helper}"

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"
suite_name="$(basename -- "$0")"

if [ -d "${script_dir}/../share/${suite_name}" ]; then
   tests_dir="${script_dir}/../share/${suite_name}"
else
   tests_dir="/usr/share/${suite_name}"
fi

shopt -s nullglob
case_scripts=( "${tests_dir}"/*_test.sh )
shopt -u nullglob

if [ "${#case_scripts[@]}" -eq 0 ]; then
   printf '%s\n' "FATAL: no case scripts found in '${tests_dir}'" >&2
   exit 1
fi

failed=0
skipped=0
env_unmet=0
for case_script in "${case_scripts[@]}"; do
   printf '%s\n' "== $(basename -- "${case_script}") =="
   case_rc=0
   "${case_script}" "$@" || case_rc=$?
   if [ "${case_rc}" -eq 77 ]; then
      skipped=$(( skipped + 1 ))
   elif [ "${case_rc}" -eq 78 ]; then
      env_unmet=$(( env_unmet + 1 ))
   elif [ "${case_rc}" -ne 0 ]; then
      failed=$(( failed + 1 ))
   fi
done

printf '%s\n' ""
printf '%s\n' "${#case_scripts[@]} case(s), ${failed} failed, ${skipped} skipped, ${env_unmet} env-unmet"
suite_exit "${failed}" "${skipped}" "${env_unmet}"
