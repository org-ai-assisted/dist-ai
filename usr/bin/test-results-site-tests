#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Suite for the image-test results plane + verification-site tooling: the
## dm-test-result/v1 schema model (no-false-green invariants: unknown-default
## status, summary-vs-steps agreement, honest enum), the golden normalize/compare
## state machine (MATCH/CHANGED/NEW/UNKNOWN, fail-closed), and the deterministic
## static-site generator (buckets never green for stale/new/no-data/inconclusive;
## byte-identical output over identical input). Pure logic -- no root, no network.
## Glob-driven: a new *_test.py / *_test.sh under the share dir auto-registers.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## Canonical suite exit (fail > skip > pass): a per-case skip (77 target-absent /
## 78 env-unmet, e.g. Pillow absent) surfaces per category, not folded into a pass.
suite_exit_helper="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")/../share/dist-ai-tests-common/suite-exit.bash"
[ -r "${suite_exit_helper}" ] || suite_exit_helper='/usr/share/dist-ai-tests-common/suite-exit.bash'
# shellcheck source=../share/dist-ai-tests-common/suite-exit.bash
source "${suite_exit_helper}"

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/test-results-site-tests" ]; then
   tests_dir="${script_dir}/../share/test-results-site-tests"
else
   tests_dir='/usr/share/test-results-site-tests'
fi

shopt -s nullglob
failures=0
skips=0
env_unmet=0
ran=0
for test_script in "${tests_dir}"/*_test.py "${tests_dir}"/*_test.sh; do
   ran=$((ran + 1))
   printf '%s\n' "" "########## $(basename -- "${test_script}") ##########"
   rc=0
   "${test_script}" "$@" || rc=$?
   if [ "${rc}" -eq 77 ]; then
      printf '%s\n' "########## SKIPPED: $(basename -- "${test_script}") ##########"
      skips=$((skips + 1))
   elif [ "${rc}" -eq 78 ]; then
      env_unmet=$(( env_unmet + 1 ))
   elif [ "${rc}" -ne 0 ]; then
      printf '%s\n' "########## FAILED (${rc}): $(basename -- "${test_script}") ##########"
      failures=$((failures + 1))
   fi
done

if [ "${ran}" -eq 0 ]; then
   printf '%s\n' "ERROR: no *_test.py/*_test.sh found in ${tests_dir}" >&2
   exit 1
fi
printf '%s\n' '' "${ran} test-results-site case(s): ${failures} failed, ${skips} skipped, ${env_unmet} env-unmet"
suite_exit "${failures}" "${skips}" "${env_unmet}"
