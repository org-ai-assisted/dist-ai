#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Verify the shipped secure-terminal AppArmor profile actually ENFORCES: it
## DENIES a path it does not grant and ALLOWS one it does. This proves the
## confinement is real, not merely declared -- the check that backs the "AppArmor
## stays enforceable" claims (sound files, terminfo, general read confinement).
##
## Loading a profile is system-wide and needs root + a running AppArmor, so this
## exits 77 (SKIP) anywhere that is not satisfied -- it is meant for the
## AppArmor-capable disposable sandbox / CI, NEVER a dev host (enforcing there
## could confine the running desktop). It restores the prior state on exit.
##
## In the disposable sandbox we WANT it to RUN (not skip): if not root but running
## inside the sandbox with passwordless sudo, re-run under sudo. Guarded to the
## sandbox marker so a dev host still SKIPs rather than enforcing on the desktop.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/has.sh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/has.sh

skip() {
   printf '%s\n' "secure-terminal-tests(apparmor): SKIP -- $1"
   ## style-ok: allow-skip: optional target -- loading a profile is system-wide and needs root + running apparmor; runs in the sandbox/CI, skips on a dev host by design
   exit 77
}

if [ "$( id -u )" -ne 0 ]; then
   in_sandbox=""
   [ "${DIST_AI_IN_SANDBOX:-}" = "1" ] && in_sandbox="yes"
   [ "${POC_CORPUS_IN_SANDBOX:-}" = "1" ] && in_sandbox="yes"
   if [ -n "${in_sandbox}" ] \
      && has apparmor_parser \
      && has aa-exec \
      && sudo -n true >/dev/null 2>&1; then
      rc=0
      sudo -n --preserve-env=SECURE_TERMINAL_REPO bash "$0" "$@" || rc="$?"
      exit "${rc}"
   fi
fi

[ "$( id -u )" -eq 0 ] || skip "needs root (loads a profile system-wide)"
has apparmor_parser \
   && has aa-exec \
   || skip "apparmor tooling (apparmor_parser / aa-exec) not present"
aa-status --enabled >/dev/null 2>&1 || skip "apparmor not enabled in this kernel"

## Locate the profile: an installed copy, or the checkout via SECURE_TERMINAL_REPO.
profile=""
for candidate in \
   "${SECURE_TERMINAL_REPO:-}/etc/apparmor.d/secure-terminal" \
   /etc/apparmor.d/secure-terminal; do
   if [ -n "${candidate}" ] && [ -r "${candidate}" ]; then
      profile="${candidate}"
      break
   fi
done
[ -n "${profile}" ] || skip "profile not found (set SECURE_TERMINAL_REPO)"

apparmor_remove_profile() {
   apparmor_parser --remove "${profile}" >/dev/null 2>&1 || true
   if [ -n "${utag_profile:-}" ]; then
      apparmor_parser --remove "${utag_profile}" >/dev/null 2>&1 || true
   fi
}

apparmor_parser --replace --skip-cache "${profile}"
trap apparmor_remove_profile EXIT

pass=0
fail=0

## ALLOW: a path the profile grants (/usr/share/secure-terminal/{,**} r).
allow_dir=/usr/share/secure-terminal
mkdir --parents "${allow_dir}"
allow_probe="${allow_dir}/aa-enforce-probe"
printf granted > "${allow_probe}"
allow_rc=0
aa-exec -p secure-terminal -- cat "${allow_probe}" >/dev/null 2>&1 || allow_rc=$?
if [ "${allow_rc}" -eq 0 ]; then
   pass=$(( pass + 1 ))
else
   fail=$(( fail + 1 ))
   printf '%s\n' "FAIL: the profile DENIED a granted path (${allow_probe})"
fi

## DENY: a path the profile does not grant (AppArmor is default-deny once loaded).
deny_probe=/root/aa-enforce-deny-probe
printf secret > "${deny_probe}"
deny_rc=0
aa-exec -p secure-terminal -- cat "${deny_probe}" >/dev/null 2>&1 || deny_rc=$?
if [ "${deny_rc}" -ne 0 ]; then
   pass=$(( pass + 1 ))
else
   fail=$(( fail + 1 ))
   printf '%s\n' \
      "FAIL: the profile ALLOWED a non-granted path (${deny_probe}) -- NOT enforcing"
fi

## ALLOW (write): the predefined canary subtree that `secure-terminal
## --test-canary` writes. This proves the profile GRANTS the confined terminal a
## write to exactly that folder -- so the EICAR-style positive control still fires
## under enforcement (a confined WRITE, complementing the read allow/deny above).
## uid 0 here -> /run/user/0; the profile pattern is /run/user/[0-9]*/.
canary_dir="/run/user/$(id --user)/secure-terminal/canary"
mkdir --parents "${canary_dir}"
canary_probe="${canary_dir}/canary"
## Source from a path the profile ALREADY grants read (/usr/share/secure-terminal
## r), so a source-read denial cannot masquerade as a destination-write denial --
## this probe must isolate the canary WRITE grant.
canary_src="${allow_dir}/aa-canary-src"
printf token > "${canary_src}"
canary_rc=0
## cp is the aa-exec target, so it runs CONFINED as secure-terminal; its write to
## the destination is subject to the profile.
aa-exec -p secure-terminal -- cp "${canary_src}" "${canary_probe}" \
   >/dev/null 2>&1 || canary_rc=$?
if [ "${canary_rc}" -eq 0 ] && [ -s "${canary_probe}" ]; then
   pass=$(( pass + 1 ))
else
   fail=$(( fail + 1 ))
   printf '%s\n' \
      "FAIL: the profile DENIED the predefined canary write (${canary_probe})"
fi

safe-rm --force "${allow_probe}" "${deny_probe}" "${canary_src}" "${canary_probe}"
rmdir "${canary_dir}" 2>/dev/null || true

## ALLOW (flock): the clipboard-watch singleton lock file. The daemon opens
## '<runtime>/secure-terminal/*.lock' O_CREAT and takes an flock on it as its
## singleton gate; the profile must grant create+write+lock ('k') or the watcher
## never starts under enforcement (os.open raises PermissionError). uid 0 here ->
## /run/user/0; the profile pattern is /run/user/[0-9]*/.
lock_dir="/run/user/$(id --user)/secure-terminal"
mkdir --parents "${lock_dir}"
lock_probe="${lock_dir}/clipboard-watch.sock.lock"
lock_rc=0
aa-exec -p secure-terminal -- python3 -Bsu -c '
import os, fcntl, sys
fd = os.open(sys.argv[1], os.O_CREAT | os.O_RDWR, 0o600)
fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
' "${lock_probe}" >/dev/null 2>&1 || lock_rc=$?
if [ "${lock_rc}" -eq 0 ]; then
   pass=$(( pass + 1 ))
else
   fail=$(( fail + 1 ))
   printf '%s\n' \
      "FAIL: the profile DENIED the clipboard-watch flock lock (${lock_probe})"
fi
safe-rm --force "${lock_probe}"
rmdir "${lock_dir}" 2>/dev/null || true

## ALLOW (single-instance bind): QLocalServer(UserAccessOption) does NOT bind the
## 0700 group socket in place -- it creates a private 0700 temp SUBDIR, binds the
## socket inside it, renames the socket to <group>.sock, then removes the subdir.
## The profile must grant that transient subdir + its socket
## ('.../secure-terminal/*/' and '.../*/*') or the mkdir is denied -> listen()
## fails EACCES -> no single-instance primary, so every --reuse opens a NEW window
## instead of a tab. Regression guard for that confined-bind denial. uid 0 here ->
## /run/user/0; the profile pattern is /run/user/[0-9]*/.
bind_dir="/run/user/$(id --user)/secure-terminal"
## Only reap the runtime dir if WE created it: a live secure-terminal (or another
## test) may already own it, and rmdir'ing a shared dir we did not make is a
## cross-test hazard even guarded by `|| true`.
bind_dir_created=0
if [ ! -e "${bind_dir}" ]; then
   mkdir --parents "${bind_dir}"
   bind_dir_created=1
fi
bind_probe="${bind_dir}/aa-bind-probe.sock"
bind_rc=0
aa-exec -p secure-terminal -- python3 -Bsu -c '
import sys
from PyQt6.QtCore import QCoreApplication
from PyQt6.QtNetwork import QLocalServer
app = QCoreApplication(sys.argv)
srv = QLocalServer()
srv.setSocketOptions(QLocalServer.SocketOption.UserAccessOption)
QLocalServer.removeServer(sys.argv[1])
sys.exit(0 if srv.listen(sys.argv[1]) else 1)
' "${bind_probe}" >/dev/null 2>&1 || bind_rc=$?
if [ "${bind_rc}" -eq 0 ]; then
   pass=$(( pass + 1 ))
else
   fail=$(( fail + 1 ))
   printf '%s\n' \
      "FAIL: the profile DENIED the single-instance QLocalServer bind (${bind_probe})"
fi
safe-rm --force "${bind_probe}"
if [ "${bind_dir_created}" -eq 1 ]; then
   rmdir "${bind_dir}" 2>/dev/null || true
fi

## --- unicode-tag-stdin: the tight, stdin-only neutralizer profile ---
## Prove the SAME enforcement on it: a granted read ALLOWED, a non-granted read
## DENIED. No write/canary probe -- the profile grants no write by design.
utag_profile=""
for candidate in \
   "${SECURE_TERMINAL_REPO:-}/etc/apparmor.d/unicode-tag-stdin" \
   /etc/apparmor.d/unicode-tag-stdin; do
   if [ -n "${candidate}" ] && [ -r "${candidate}" ]; then
      utag_profile="${candidate}"
      break
   fi
done
if [ -z "${utag_profile}" ]; then
   fail=$(( fail + 1 ))
   printf '%s\n' 'FAIL: unicode-tag-stdin profile not found (set SECURE_TERMINAL_REPO)'
else
   ## apparmor_remove_profile (the EXIT trap) already removes utag_profile now.
   apparmor_parser --replace --skip-cache "${utag_profile}"

   ## ALLOW: a path the profile grants (the secure_terminal package tree).
   utag_allow_dir=/usr/lib/python3/dist-packages/secure_terminal
   mkdir --parents "${utag_allow_dir}"
   utag_allow_probe="${utag_allow_dir}/aa-utag-probe"
   printf granted > "${utag_allow_probe}"
   utag_allow_rc=0
   aa-exec -p unicode-tag-stdin -- cat "${utag_allow_probe}" >/dev/null 2>&1 \
      || utag_allow_rc=$?
   if [ "${utag_allow_rc}" -eq 0 ]; then
      pass=$(( pass + 1 ))
   else
      fail=$(( fail + 1 ))
      printf '%s\n' \
         "FAIL: unicode-tag-stdin DENIED a granted path (${utag_allow_probe})"
   fi

   ## DENY: a path the profile does not grant (default-deny once loaded).
   utag_deny_probe=/root/aa-utag-deny-probe
   printf secret > "${utag_deny_probe}"
   utag_deny_rc=0
   aa-exec -p unicode-tag-stdin -- cat "${utag_deny_probe}" >/dev/null 2>&1 \
      || utag_deny_rc=$?
   if [ "${utag_deny_rc}" -ne 0 ]; then
      pass=$(( pass + 1 ))
   else
      fail=$(( fail + 1 ))
      printf '%s\n' \
         "FAIL: unicode-tag-stdin ALLOWED a non-granted path (${utag_deny_probe}) -- NOT enforcing"
   fi
   safe-rm --force "${utag_allow_probe}" "${utag_deny_probe}"
fi

printf '%s\n' "secure-terminal-tests(apparmor): ${pass} passed, ${fail} failed"
[ "${fail}" -eq 0 ]
