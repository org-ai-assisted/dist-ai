#!/bin/bash

## Copyright (C) 2025 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Convert a bootable raw disk image into a HIGHLY boot-compatible hybrid ISO,
## using only packages.debian.org tools -- the same approach Debian live-build
## uses, reimplemented WITHOUT live-build. The output boots as:
##   - legacy BIOS from optical media (El Torito) and from USB/HDD (hybrid MBR),
##   - UEFI from optical media and from USB/HDD (ESP as El Torito EFI entry AND
##     as a real GPT partition),
##   - UEFI Secure Boot (firmware -> MS-signed shim -> distro-signed GRUB -> kernel),
##   - as a loop-mounted .iso file from another GRUB (loopback.cfg + findiso).
##
## Input is the bootable raw disk image derivative-maker's 3200_create-raw-image
## produces (grml-debootstrap --vmefi: GPT with a root filesystem carrying a full
## Debian/Kicksecure install incl. a kernel and dracut + dracut-live). The rootfs
## is copied out, wrapped as a live squashfs with a freshly built dracut-live
## initramfs, and packed into the ISO. The input image is never modified.
##
## Loop devices, kpartx and chroot require root and a permissive environment; run
## this in a sandbox VM, not on a trusted host.
##
## The full command sequence and the reasoning behind each step are documented in
## usr/share/dm-raw-to-iso/README.md.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${BASH_SOURCE[0]##*/}"

usage() {
   cat <<EOF
Usage: ${me} --raw <image> --output <iso> [options]

Required:
  --raw <image>            bootable raw disk image (from 3200_create-raw-image)
  --output <iso>           output ISO path

Options:
  --arch <amd64|arm64>     target architecture (default: host dpkg architecture)
  --label <volid>          ISO volume label; must match root=live:CDLABEL=<volid>
                           (default: DM_LIVE)
  --bootappend <str>       extra kernel command line appended to the live entry
  --serial-console         bake a serial console (ttyS0,115200) into GRUB and the
                           kernel cmdline and boot the default entry immediately
                           (timeout 0) -- for headless boot testing
  --grub-config-append <f> append file <f> to the ISO's GRUB config.cfg (e.g. an
                           SMBIOS kernel-cmdline reader); consumer-supplied, so this
                           tool ships no such reader of its own
  --source-date-epoch <n>  UNIX timestamp for reproducible output (default: env
                           SOURCE_DATE_EPOCH, else the raw image's mtime)
  --keep-workdir           do not delete the temporary work directory on exit
  --help                   show this help
EOF
}

error() {
   printf '%s: ERROR: %s\n' "${me}" "$*" >&2
   exit 1
}

## Fail loudly on a missing dependency rather than skipping -- a required tool
## that is absent is an environment bug, not an optional feature.
require_cmd() {
   local cmd
   for cmd in "$@" ; do
      if ! type -P "${cmd}" >/dev/null 2>&1 ; then
         error "required command not found: '${cmd}'. Install its Debian package (see debian/control)."
      fi
   done
}

require_file() {
   local f
   for f in "$@" ; do
      if [ ! -e "${f}" ] ; then
         error "required file not found: '${f}'. Install the Debian package that ships it."
      fi
   done
}

## Arguments.
raw=""
output=""
arch=""
label="DM_LIVE"
bootappend=""
serial_console="false"
grub_config_append=""
source_date_epoch="${SOURCE_DATE_EPOCH:-}"
keep_workdir="false"

while [ "$#" -gt 0 ] ; do
   case "$1" in
      --raw)
         [ "$#" -ge 2 ] || error "--raw requires a value"
         raw="$2"
         shift 2
         ;;
      --output)
         [ "$#" -ge 2 ] || error "--output requires a value"
         output="$2"
         shift 2
         ;;
      --arch)
         [ "$#" -ge 2 ] || error "--arch requires a value"
         arch="$2"
         shift 2
         ;;
      --label)
         [ "$#" -ge 2 ] || error "--label requires a value"
         label="$2"
         shift 2
         ;;
      --bootappend)
         [ "$#" -ge 2 ] || error "--bootappend requires a value"
         bootappend="$2"
         shift 2
         ;;
      --serial-console)
         serial_console="true"
         shift
         ;;
      --grub-config-append)
         [ "$#" -ge 2 ] || error "--grub-config-append requires a value"
         grub_config_append="$2"
         shift 2
         ;;
      --source-date-epoch)
         [ "$#" -ge 2 ] || error "--source-date-epoch requires a value"
         source_date_epoch="$2"
         shift 2
         ;;
      --keep-workdir)
         keep_workdir="true"
         shift
         ;;
      --help|-h)
         usage
         exit 0
         ;;
      *)
         error "unknown argument: '$1' (see --help)"
         ;;
   esac
done

[ -n "${raw}" ]    || error "--raw is required (see --help)"
[ -n "${output}" ] || error "--output is required (see --help)"
[ -r "${raw}" ]    || error "raw image not readable: '${raw}'"

if [ -z "${arch}" ] ; then
   require_cmd dpkg
   arch="$(dpkg --print-architecture)"
fi

case "${arch}" in amd64|arm64) true ;; *) error "unsupported --arch '${arch}' (supported: amd64, arm64)" ;; esac

## --label becomes BOTH the ISO9660 volume id and the root=live:CDLABEL= value the
## initramfs searches for; a space would split the kernel cmdline and desync the two,
## and an empty label makes xorriso invent a volume id the cmdline does not match.
case "${label}" in ''|*[!A-Za-z0-9_.-]*) error "--label must be 1-32 chars from [A-Za-z0-9_.-] with no spaces (it is the ISO volume id and the root=live:CDLABEL= value)" ;; esac
[ "${#label}" -le 32 ] || error "--label too long (max 32 characters for an ISO9660 volume id)"

if [ -z "${source_date_epoch}" ] ; then
   source_date_epoch="$(stat -c %Y -- "${raw}")"
fi
case "${source_date_epoch}" in ''|*[!0-9]*) error "--source-date-epoch must be a non-negative integer" ;; esac
export SOURCE_DATE_EPOCH="${source_date_epoch}"

## Per-arch GRUB platform / EFI naming, matching live-build's efi-image mapping.
## bios=true means a legacy-BIOS El Torito image is produced (amd64 only; arm has
## no legacy BIOS). efi_platforms is the ordered list of (grub-platform:efi-name)
## pairs whose loaders go into the shared ESP.
bios="false"
efi_platforms=()
case "${arch}" in
   amd64)
      bios="true"
      ## x64 first so its BOOTX64.EFI is what firmware loads; ia32 adds 32-bit UEFI.
      efi_platforms=( "x86_64-efi:x64" "i386-efi:ia32" )
      ;;
   arm64)
      efi_platforms=( "arm64-efi:aa64" )
      ;;
esac

## Dependency check up front (fail loud).
require_cmd xorriso grub-mkimage mkfs.msdos mmd mcopy mksquashfs cp find touch stat chroot mount umount kpartx losetup safe-rm
if [ "${bios}" = "true" ] ; then
   require_file /usr/lib/grub/i386-pc/cdboot.img /usr/lib/grub/i386-pc/boot_hybrid.img
   require_file /usr/lib/grub/i386-pc/normal.mod
fi
require_file /usr/share/grub/unicode.pf2

## Work directory + teardown. Track loop/kpartx maps and mounts and tear them down
## in reverse on any exit so a failure never leaks a loop device or a bind mount.
workdir="$(mktemp --directory --tmpdir dm-raw-to-iso.XXXXXX)"
kpartx_image=""
mounts=()

cleanup() {
   local rc="$?"
   local m
   ## Unmount in reverse order.
   for (( idx=${#mounts[@]}-1 ; idx>=0 ; idx-- )) ; do
      m="${mounts[idx]}"
      umount -- "${m}" 2>/dev/null || umount --lazy -- "${m}" 2>/dev/null || true
   done
   if [ -n "${kpartx_image}" ] ; then
      kpartx -d -s -- "${kpartx_image}" 2>/dev/null || true
   fi
   if [ "${keep_workdir}" = "true" ] ; then
      printf '%s: keeping work directory: %s\n' "${me}" "${workdir}" >&2
   else
      safe-rm --recursive --force -- "${workdir}" 2>/dev/null || true
   fi
   trap - EXIT
   exit "${rc}"
}
trap cleanup EXIT INT TERM

binary="${workdir}/binary"
rootfs="${workdir}/rootfs"
mkdir -p -- "${binary}/boot/grub" "${binary}/live" "${binary}/.disk" "${rootfs}"

######################################################################
## 1. Mount the raw image's root partition and copy the rootfs out.
######################################################################
## kpartx maps each partition to /dev/mapper/loop<N>p<M>. grml-debootstrap's
## --vmefi layout puts the root filesystem in the last partition; verify the
## mapped partition really looks like a root filesystem before trusting it.
printf '%s: mapping partitions of %s\n' "${me}" "${raw}" >&2
kpartx_image="${raw}"
kpartx_output="$(kpartx -a -s -v -- "${raw}")"
[ -n "${kpartx_output}" ] || error "kpartx produced no partition maps for '${raw}'"

## Pick the last mapped partition (grml --vmefi root), same heuristic mount-raw uses.
mapper_name="$(printf '%s\n' "${kpartx_output}" | sed -n 's/^add map \([^ ]*\) .*/\1/p' | tail -n 1)"
[ -n "${mapper_name}" ] || error "could not parse a partition map from kpartx output"
mapper_dev="/dev/mapper/${mapper_name}"
require_file "${mapper_dev}"

rootfs_mnt="${workdir}/mnt"
mkdir -p -- "${rootfs_mnt}"
mount --read-only -- "${mapper_dev}" "${rootfs_mnt}"
mounts+=( "${rootfs_mnt}" )

marker=""
for marker in etc usr bin sbin var ; do
   [ -e "${rootfs_mnt}/${marker}" ] || error "'${mapper_dev}' does not look like a root filesystem (missing /${marker})"
done

printf '%s: copying rootfs out of the image\n' "${me}" >&2
## --one-file-system: never descend into the read-only mount's sub-mounts.
cp --archive --one-file-system -- "${rootfs_mnt}/." "${rootfs}/"

## Release the input image immediately; the rest operates on the copy only.
umount -- "${rootfs_mnt}"
mounts=()
kpartx -d -s -- "${raw}"
kpartx_image=""

######################################################################
## 2. Build the live (dracut-live) initramfs and stage the kernel.
######################################################################
## Bind the host API filesystems into the rootfs copy so dracut can run there.
for api in /dev /dev/pts /proc /sys /run ; do
   target="${rootfs}${api}"
   mkdir -p -- "${target}"
   mount --bind -- "${api}" "${target}"
   mounts+=( "${target}" )
done

## sort -V (version sort): a plain sort is lexical (5.9 > 5.19), so an image
## carrying more than one kernel would pick the wrong "newest" one.
kernel_img="$(chroot "${rootfs}" sh -c 'ls -1 /boot' | grep '^vmlinuz-' | sort -V | tail -n 1)"
[ -n "${kernel_img}" ] || error "no /boot/vmlinuz-* kernel found in the rootfs"
kernel_ver="${kernel_img#vmlinuz-}"
printf '%s: building dracut-live initramfs for kernel %s\n' "${me}" "${kernel_ver}" >&2

## --no-hostonly: a portable live initramfs, not tied to this build host.
## dmsquash-live comes from the dracut-live package installed in the rootfs; dracut
## adds it automatically. Fail loud if the rootfs lacks dracut OR the live module:
## without 90dmsquash-live the initramfs cannot read root=live:CDLABEL= / rd.live.*
## and the ISO boots to an emergency shell.
chroot "${rootfs}" sh -c 'command -v dracut >/dev/null 2>&1' \
   || error "the rootfs has no 'dracut'; a live ISO needs dracut + dracut-live installed in the image"
[ -e "${rootfs}/usr/lib/dracut/modules.d/90dmsquash-live" ] \
   || error "the rootfs lacks the dracut 'dmsquash-live' module; install 'dracut-live' in the image (the live ISO cannot boot without it)"
## env TMPDIR=/tmp: the caller's TMPDIR (e.g. a per-uid /tmp/user/<uid>) does not
## exist inside the chroot, and dracut aborts on an invalid tmpdir. /tmp always
## exists in a Debian rootfs, so force it rather than leaking the host's path.
chroot "${rootfs}" env TMPDIR=/tmp dracut --no-hostonly --kver "${kernel_ver}" --force --reproducible /boot/initrd.img-live "${kernel_ver}"

## Do NOT --dereference: the copy runs in the HOST namespace, so an absolute
## symlink in the guest /boot would resolve against the host filesystem and pull a
## host file into the ISO. A normal kernel is a regular file; refuse a symlink.
if [ -L "${rootfs}/boot/${kernel_img}" ] ; then
   error "kernel '/boot/${kernel_img}' is a symlink; refusing (it would resolve against the host filesystem, not the guest)"
fi
cp -- "${rootfs}/boot/${kernel_img}" "${binary}/live/vmlinuz"
cp -- "${rootfs}/boot/initrd.img-live" "${binary}/live/initrd.img"
safe-rm --force -- "${rootfs}/boot/initrd.img-live"

## Tear down the API binds before squashing so they are not packed.
for (( idx=${#mounts[@]}-1 ; idx>=0 ; idx-- )) ; do
   umount -- "${mounts[idx]}" 2>/dev/null || umount --lazy -- "${mounts[idx]}" 2>/dev/null || true
done
mounts=()

######################################################################
## 3. Pack the rootfs into a reproducible squashfs.
######################################################################
printf '%s: creating filesystem.squashfs\n' "${me}" >&2
## Exclude runtime-only /dev contents (devtmpfs repopulates at boot) and the
## transient /run and /tmp. Reproducible timestamps come from the exported
## SOURCE_DATE_EPOCH (mksquashfs honors it); do NOT also pass -all-time/-mkfs-time,
## mksquashfs rejects using both at once.
mksquashfs "${rootfs}" "${binary}/live/filesystem.squashfs" \
   -noappend \
   -comp xz \
   -no-progress \
   -wildcards \
   -e "dev/*" "run/*" "tmp/*" "boot/initrd.img-live"

######################################################################
## 4. The boot medium marker the GRUB EFI cores search for.
######################################################################
printf 'Derivative ISO; label=%s; arch=%s\n' "${label}" "${arch}" > "${binary}/.disk/info"

######################################################################
## 5. BIOS GRUB El Torito core (amd64 only).
######################################################################
if [ "${bios}" = "true" ] ; then
   printf '%s: building BIOS GRUB El Torito core\n' "${me}" >&2
   mkdir -p -- "${binary}/boot/grub/i386-pc"
   ## Runtime modules loaded from the ISO by the core.
   cp -a -- /usr/lib/grub/i386-pc/*.mod "${binary}/boot/grub/i386-pc/"
   cp -a -- /usr/lib/grub/i386-pc/*.lst "${binary}/boot/grub/i386-pc/" 2>/dev/null || true
   core_img="${workdir}/core.img"
   ## biosdisk + iso9660 are enough to reach /boot/grub on the CD; the rest load
   ## from i386-pc/ above. cdboot.img prepended makes it El Torito no-emulation.
   grub-mkimage -d /usr/lib/grub/i386-pc -o "${core_img}" -O i386-pc --prefix=/boot/grub biosdisk iso9660
   cat /usr/lib/grub/i386-pc/cdboot.img "${core_img}" > "${binary}/boot/grub/grub_eltorito"
   safe-rm --force -- "${core_img}"
fi

######################################################################
## 6. EFI System Partition: signed shim + signed grub, then pack the FAT ESP.
######################################################################
## Debian-signed loaders only (shim boots UEFI with Secure Boot on OR off), plus
## the FAT ESP xorriso registers as the El Torito EFI entry and as a GPT partition.
## Produces binary/boot/grub/efi.img and a plain-file copy of EFI/boot/*.efi.
printf '%s: installing signed EFI loaders and building the ESP\n' "${me}" >&2
esp_stage="${workdir}/esp"
mkdir -p -- "${esp_stage}/EFI/boot" "${esp_stage}/boot/grub"

## Per EFI platform: install the MS-signed shim (loaded first) + the distro-signed
## grub it chainloads. The signed shim boots UEFI whether Secure Boot is ON or OFF,
## so this single path is EFI AND Secure Boot -- no unsigned core, no embedded
## config. gcd* is the removable-media (CD/USB) signed grub variant.
## The FIRST platform is the SUPPORTED one for the arch (x64 on amd64, aa64 on
## arm64): a missing signed dependency there is a hard error. The rest are OPTIONAL
## (32-bit UEFI): auto-skip them when their signed pair is absent.
for pair in "${efi_platforms[@]}" ; do
   platform="${pair%%:*}"
   efi_name="${pair##*:}"
   signed_grub="/usr/lib/grub/${platform}-signed/gcd${efi_name}.efi.signed"
   signed_shim="/usr/lib/shim/shim${efi_name}.efi.signed"
   mokmanager="/usr/lib/shim/mm${efi_name}.efi.signed"

   if [ -r "${signed_grub}" ] && [ -r "${signed_shim}" ] ; then
      cp -a --dereference -- "${signed_shim}" "${esp_stage}/EFI/boot/boot${efi_name}.efi"
      cp -a -- "${signed_grub}" "${esp_stage}/EFI/boot/grub${efi_name}.efi"
      if [ -r "${mokmanager}" ] ; then
         cp -a -- "${mokmanager}" "${esp_stage}/EFI/boot/mm${efi_name}.efi"
      fi
   elif [ "${pair}" = "${efi_platforms[0]}" ] ; then
      error "missing signed EFI dependency for the supported platform ${efi_name} (${arch}): install shim-signed and grub-efi-${arch}-signed (need ${signed_shim} and ${signed_grub})"
   else
      printf '%s: NOTE: no signed shim+grub for optional EFI platform %s; skipping it.\n' "${me}" "${efi_name}" >&2
   fi
done

## ESP-redirect grub.cfg: some firmware loads the EFI grub with root set to the
## ESP itself, so redirect to the real config on the medium carrying /.disk/info.
cat > "${esp_stage}/boot/grub/grub.cfg" <<EOF
search --set=root --file /.disk/info
set prefix=(\$root)/boot/grub
configfile (\$root)/boot/grub/grub.cfg
EOF

## Pack EFI/boot/*.efi + the redirect grub.cfg into a minimal FAT ESP.
find "${esp_stage}" -exec touch --no-dereference --date="@${SOURCE_DATE_EPOCH}" -- {} +
esp_bytes=0
while IFS= read -r -d '' f ; do
   esp_bytes=$(( esp_bytes + $(stat -c %s -- "${f}") ))
done < <(find "${esp_stage}" -type f -print0)
## + directory slack (EFI, EFI/boot, boot, boot/grub); round the KiB up to 32.
esp_bytes=$(( esp_bytes + 4096 * 4 ))
esp_blocks=$(( (esp_bytes / 1024 + 55) / 32 * 32 ))
efi_img="${binary}/boot/grub/efi.img"
## 32-bit hex volume id derived from SOURCE_DATE_EPOCH for reproducibility.
esp_volid="$(printf '%08x' $(( SOURCE_DATE_EPOCH % 4294967296 )))"
mkfs.msdos -C "${efi_img}" "${esp_blocks}" -i "${esp_volid}" >/dev/null
mmd -i "${efi_img}" ::EFI ::EFI/boot ::boot ::boot/grub
mcopy -m -o -i "${efi_img}" "${esp_stage}/EFI/boot/"*.efi ::EFI/boot
mcopy -m -o -i "${efi_img}" "${esp_stage}/boot/grub/grub.cfg" ::boot/grub
## Plain-file copy of the loaders on the ISO too (USB/loopback reachability).
cp -a -- "${esp_stage}/EFI" "${binary}/EFI"

######################################################################
## 7. Main grub.cfg + config.cfg + loopback.cfg.
######################################################################
printf '%s: writing GRUB configuration\n' "${me}" >&2
cp -a -- /usr/share/grub/unicode.pf2 "${binary}/boot/grub/unicode.pf2"

## Kernel command line for the live entry. findiso/iso-scan let it also boot when
## the .iso is loop-mounted from another GRUB (iso_path is set by loopback there,
## empty on direct boot -- harmless).
live_append="rd.live.overlay.overlayfs=1 boot=live components splash rd.live.image root=live:CDLABEL=${label} rd.live.dir=live rd.live.squashimg=filesystem.squashfs iso-scan/filename=\${iso_path}"
if [ -n "${bootappend}" ] ; then
   live_append="${live_append} ${bootappend}"
fi

grub_timeout="5"
serial_block=""
if [ "${serial_console}" = "true" ] ; then
   live_append="${live_append} console=tty0 console=ttyS0,115200n8"
   grub_timeout="0"
   serial_block="$(cat <<'EOF'
insmod serial
serial --unit=0 --speed=115200 --word=8 --parity=no --stop=1
terminal_output serial console
EOF
)"
fi

## config.cfg: base setup, sourced first by grub.cfg. A consumer may append extra
## config (e.g. an SMBIOS cmdline reader) via --grub-config-append.
cat > "${binary}/boot/grub/config.cfg" <<EOF
set default=0
set timeout=${grub_timeout}
insmod all_video
insmod gfxterm
if loadfont \$prefix/unicode.pf2 ; then
   set gfxmode=auto
   terminal_output gfxterm
fi
${serial_block}
EOF

if [ -n "${grub_config_append}" ] ; then
   [ -r "${grub_config_append}" ] || error "--grub-config-append file not readable: '${grub_config_append}'"
   printf '%s\n' '' >> "${binary}/boot/grub/config.cfg"
   cat -- "${grub_config_append}" >> "${binary}/boot/grub/config.cfg"
fi

## grub.cfg: the menu. Sourced directly (BIOS/EFI) and via loopback.cfg.
cat > "${binary}/boot/grub/grub.cfg" <<EOF
source /boot/grub/config.cfg

menuentry "Live" {
   linux /live/vmlinuz ${live_append}
   initrd /live/initrd.img
}
EOF

## loopback.cfg: booting the .iso as a file from another GRUB.
printf 'source /boot/grub/grub.cfg\n' > "${binary}/boot/grub/loopback.cfg"

######################################################################
## 8. Assemble the hybrid ISO in a single xorriso pass.
######################################################################
printf '%s: assembling ISO %s\n' "${me}" "${output}" >&2
xorriso_opts=(
   -R -r -J -joliet-long -l -cache-inodes -iso-level 3
   -volid "${label}"
   --modification-date="$(date --utc --date="@${SOURCE_DATE_EPOCH}" +%Y%m%d%H%M%S00)"
)

if [ "${bios}" = "true" ] ; then
   ## Legacy BIOS: hybrid MBR from GRUB (USB) + El Torito no-emulation core (CD).
   xorriso_opts+=(
      --grub2-boot-info
      --grub2-mbr /usr/lib/grub/i386-pc/boot_hybrid.img
      -no-emul-boot -boot-load-size 4 -boot-info-table
      -b boot/grub/grub_eltorito
      -eltorito-alt-boot
   )
fi

## UEFI (ALL arches): expose the ESP FAT image as the El Torito EFI entry AND as a
## real GPT partition so USB/HDD firmware ESP-scan finds it. -efi-boot-part must
## apply on arm64 too (it has no BIOS block), or an arm64 ISO has only the optical
## El Torito EFI entry and no partition to boot from as a USB stick.
xorriso_opts+=(
   -efi-boot-part --efi-boot-image
   -e boot/grub/efi.img -no-emul-boot
   -isohybrid-gpt-basdat -isohybrid-apm-hfsplus
)

safe-rm --force -- "${output}"
xorriso -as mkisofs "${xorriso_opts[@]}" -o "${output}" "${binary}"

## Embed an ISO md5 for GRUB/dracut 'rd.live.check' if isomd5sum is present.
if type -P implantisomd5 >/dev/null 2>&1 ; then
   implantisomd5 "${output}"
fi

## Pin the output mtime for reproducibility.
touch --date="@${SOURCE_DATE_EPOCH}" -- "${output}"

printf '%s: done: %s\n' "${me}" "${output}" >&2
