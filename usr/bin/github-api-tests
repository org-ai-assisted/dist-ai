#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Regression test for github-api's REFUSALS, the part whose failure leaks the bot
## token: the bearer header must never be attached to a non-GitHub host, and a
## plaintext http:// URL must be refused outright. Also asserts the token never
## reaches argv, and that an unauthenticated call is still shaped correctly --
## the CI case, where there is no token file.
##
## Offline: no request is made. The transport is stubbed by putting a fake
## 'curl' first on PATH which prints its own argv and its stdin config.
##
## Self-contained: exit 0 pass, non-zero fail.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## style-ok: no-safe-rm -- runs in a bare CI container, where safe-rm, a
## workstation helper, does not exist.

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"
git_api="${script_dir}/github-api"

tmp="$(mktemp --directory)"
cleanup() {
  rm --recursive --force -- "${tmp}"
}
trap cleanup EXIT

fails=0

## Fake transport: records argv and the --config document it is handed.
mkdir -p "${tmp}/bin"
## Mirror curl: with --output FILE (the buffered GET/HEAD path) write the captured
## argv+stdin to FILE so github-api cat-emits it; else to stdout. Quoted heredoc ->
## the body is literal (no expansion here; it expands when the fake runs).
cat > "${tmp}/bin/curl" <<'FAKE_CURL'
#!/bin/bash
out=""; prev=""
for a in "$@"; do [ "$prev" = "--output" ] && out="$a"; prev="$a"; done
[ -n "$out" ] && exec > "$out"
printf "%s\n" "ARGV: $*"
printf "%s" "STDIN: "
cat
FAKE_CURL
chmod 0755 "${tmp}/bin/curl"

## github-api PREFERS scurl when present ('command -v scurl'); on a box that has
## it (Kicksecure), an unstubbed scurl would run a LIVE authenticated request
## with the fixture token and every assertion would fail on real output. Stub
## scurl identically so the platform's transport choice is always CAPTURED,
## never executed.
cp -- "${tmp}/bin/curl" "${tmp}/bin/scurl"

printf '%s\n' 'secret-token-value' > "${tmp}/token"

run_git_api() {
  ## github-api with the stub transport (curl AND scurl both faked) and the
  ## fixture token file.
  PATH="${tmp}/bin:${PATH}" \
  GITHUB_TOKEN_FILE="${tmp}/token" \
    "${git_api}" "$@" 2>&1
}

## The single 'ARGV: ' line (the transport argv) from a captured run.
argv_line_of() {
  local out="$1" line argv=''
  while IFS= read -r line; do
    case "${line}" in
      'ARGV: '*)
        argv="${line}"
        ;;
      *)
        true "INFO: not the argv line"
        ;;
    esac
  done <<< "${out}"
  printf '%s' "${argv}"
}

check_refuses() {
  local label="$1"
  shift
  local rc=0 out
  out="$(run_git_api "$@")" || rc=$?
  if (( rc == 0 )); then
    printf '%s\n' "FAIL: ${label}: expected a refusal, got exit 0" >&2
    fails=$(( fails + 1 ))
    return 0
  fi
  case "${out}" in
    *refusing*)
      printf '%s\n' "ok   ${label}"
      ;;
    *)
      printf '%s\n' "FAIL: ${label}: refused but without a reason: ${out}" >&2
      fails=$(( fails + 1 ))
      ;;
  esac
}

## A full URL on another host must never receive the token.
check_refuses 'non-GitHub host refused' GET 'https://evil.example.com/repos/x'
## Nor a look-alike that only ends in the right string.
check_refuses 'look-alike host refused' GET 'https://github.com.evil.example.com/x'
## Plaintext would put the bearer header on the wire in clear.
check_refuses 'plaintext http refused' GET 'http://api.github.com/x'

## The token must reach curl through the config document, never through argv.
out="$(run_git_api GET /rate_limit)"
## Scoped to the ARGV line alone: a glob over the whole output would match
## 'ARGV: ' on one line and the token on the STDIN line and report a leak that
## is not there.
argv_line=''
while IFS= read -r line; do
  case "${line}" in
    'ARGV: '*)
      argv_line="${line}"
      ;;
    *)
      true "INFO: not the argv line"
      ;;
  esac
done <<< "${out}"
if [ -z "${argv_line}" ]; then
  printf '%s\n' "FAIL: transport was not invoked: ${out}" >&2
  fails=$(( fails + 1 ))
fi
case "${argv_line}" in
  *secret-token-value*)
    printf '%s\n' "FAIL: token appears in the transport argv: ${argv_line}" >&2
    fails=$(( fails + 1 ))
    ;;
  *)
    printf '%s\n' 'ok   token absent from argv'
    ;;
esac
case "${out}" in
  *'STDIN: '*'Authorization: Bearer secret-token-value'*)
    printf '%s\n' 'ok   token passed via the stdin config document'
    ;;
  *)
    printf '%s\n' "FAIL: token not passed via stdin config: ${out}" >&2
    fails=$(( fails + 1 ))
    ;;
esac

## A bare path resolves against the API host.
case "${out}" in
  *'https://api.github.com/rate_limit'*)
    printf '%s\n' 'ok   bare path resolved against api.github.com'
    ;;
  *)
    printf '%s\n' "FAIL: bare path not resolved: ${out}" >&2
    fails=$(( fails + 1 ))
    ;;
esac

## A path without the leading slash must not glue onto the host.
out="$(run_git_api GET repos/x/y)" || true
case "${out}" in
  *'https://api.github.com/repos/x/y'*)
    printf '%s\n' 'ok   slashless path resolved against api.github.com'
    ;;
  *)
    printf '%s\n' "FAIL: slashless path not resolved: ${out}" >&2
    fails=$(( fails + 1 ))
    ;;
esac

## CI shape: no token file and no token env. The call must still be made, just
## without an Authorization header -- the public endpoints work unauthenticated.
out="$(PATH="${tmp}/bin:${PATH}" GITHUB_TOKEN_FILE="${tmp}/absent" \
  env -u GITHUB_TOKEN -u GH_TOKEN "${git_api}" GET /rate_limit 2>&1)"
case "${out}" in
  *Authorization*)
    printf '%s\n' "FAIL: unauthenticated call still sent an Authorization header: ${out}" >&2
    fails=$(( fails + 1 ))
    ;;
  *'https://api.github.com/rate_limit'*)
    printf '%s\n' 'ok   unauthenticated call is still well formed'
    ;;
  *)
    printf '%s\n' "FAIL: unauthenticated call malformed: ${out}" >&2
    fails=$(( fails + 1 ))
    ;;
esac

## GITHUB_TOKEN is used when no token file exists.
out="$(PATH="${tmp}/bin:${PATH}" GITHUB_TOKEN_FILE="${tmp}/absent" \
  GITHUB_TOKEN='env-token-value' "${git_api}" GET /rate_limit 2>&1)"
case "${out}" in
  *'STDIN: '*'Authorization: Bearer env-token-value'*)
    printf '%s\n' 'ok   GITHUB_TOKEN used when no token file exists'
    ;;
  *)
    printf '%s\n' "FAIL: GITHUB_TOKEN not used: ${out}" >&2
    fails=$(( fails + 1 ))
    ;;
esac

## SECURITY (token injection): a token carrying a byte outside [A-Za-z0-9_.-]
## -- here a two-line token file, i.e. an embedded newline -- must be REFUSED
## before the transport runs, or it would break out of the curl --config
## Authorization directive and could redirect the request. Asserted: non-zero
## exit AND the stub transport never invoked.
printf '%s\n' 'goodpart' 'url = "https://evil.example.com"' > "${tmp}/token-newline"
rc=0
out="$(PATH="${tmp}/bin:${PATH}" GITHUB_TOKEN_FILE="${tmp}/token-newline" \
  "${git_api}" GET /rate_limit 2>&1)" || rc=$?
if [ "${rc}" -eq 0 ]; then
  printf '%s\n' "FAIL: a newline-bearing token was accepted (rc 0): ${out}" >&2
  fails=$(( fails + 1 ))
else
  case "${out}" in
    *'ARGV:'*)
      printf '%s\n' "FAIL: transport ran despite a rejected token: ${out}" >&2
      fails=$(( fails + 1 ))
      ;;
    *)
      printf '%s\n' 'ok   newline-bearing token refused before the transport ran'
      ;;
  esac
fi

## A dotted token (a GitHub App JWT, header.payload.signature) must be ACCEPTED
## -- the dots are safe in the config value, and app auth needs them.
out="$(PATH="${tmp}/bin:${PATH}" GITHUB_TOKEN_FILE="${tmp}/absent" \
  GITHUB_TOKEN='eyJhbGci.eyJpc.sig-nature_0' "${git_api}" GET /rate_limit 2>&1)"
case "${out}" in
  *'STDIN: '*'Authorization: Bearer eyJhbGci.eyJpc.sig-nature_0'*)
    printf '%s\n' 'ok   a dotted App-JWT token is accepted'
    ;;
  *)
    printf '%s\n' "FAIL: a dotted App-JWT token was rejected: ${out}" >&2
    fails=$(( fails + 1 ))
    ;;
esac

## gh-CLI muscle memory: 'gh api ... --input <file>' sends a body, but curl (and
## so this passthrough) has no --input. The guard must reject it with exit 2, name
## the curl idiom (--data), and NEVER reach the transport -- asserted on the ARGV
## marker the stub prints only when curl ran. Catches --body-file (a plausible gh
## guess curl also lacks) too.
printf '%s\n' '{}' > "${tmp}/body.json"
rc=0
out="$(run_git_api PATCH /repos/x --input "${tmp}/body.json")" || rc=$?
if [ "${rc}" -ne 2 ]; then
  printf '%s\n' "FAIL: --input not rejected with exit 2 (rc ${rc}): ${out}" >&2
  fails=$(( fails + 1 ))
else
  case "${out}" in
    *ARGV:*)
      printf '%s\n' "FAIL: --input reached the transport: ${out}" >&2
      fails=$(( fails + 1 ))
      ;;
    *--data*)
      printf '%s\n' 'ok   --input rejected (exit 2), transport not run, --data named'
      ;;
    *)
      printf '%s\n' "FAIL: --input rejected but did not name --data: ${out}" >&2
      fails=$(( fails + 1 ))
      ;;
  esac
fi

rc=0
out="$(run_git_api PATCH /repos/x --body-file "${tmp}/body.json")" || rc=$?
if [ "${rc}" -ne 2 ]; then
  printf '%s\n' "FAIL: --body-file not rejected with exit 2 (rc ${rc}): ${out}" >&2
  fails=$(( fails + 1 ))
else
  case "${out}" in
    *ARGV:*)
      printf '%s\n' "FAIL: --body-file reached the transport: ${out}" >&2
      fails=$(( fails + 1 ))
      ;;
    *)
      printf '%s\n' 'ok   --body-file rejected (exit 2), transport not run'
      ;;
  esac
fi

## gh's flags-first order 'github-api --input <file> <endpoint>' (method omitted)
## must be caught too: the scan runs over the WHOLE argv, not just the post-shift
## extras -- else --input lands in the method slot, slips the guard, and fires a
## bogus authenticated request.
rc=0
out="$(run_git_api --input "${tmp}/body.json" repos/x)" || rc=$?
if [ "${rc}" -ne 2 ]; then
  printf '%s\n' "FAIL: flags-first --input not rejected with exit 2 (rc ${rc}): ${out}" >&2
  fails=$(( fails + 1 ))
else
  case "${out}" in
    *ARGV:*)
      printf '%s\n' "FAIL: flags-first --input reached the transport: ${out}" >&2
      fails=$(( fails + 1 ))
      ;;
    *)
      printf '%s\n' 'ok   flags-first --input (method slot) rejected, transport not run'
      ;;
  esac
fi

## Anti-over-match: the documented --data @<file> idiom must still forward to the
## transport untouched.
out="$(run_git_api POST /repos/x --data @"${tmp}/body.json")" || true
argv_line=''
while IFS= read -r line; do
  case "${line}" in
    'ARGV: '*)
      argv_line="${line}"
      ;;
    *)
      true "INFO: not the argv line"
      ;;
  esac
done <<< "${out}"
case "${argv_line}" in
  *'--data'*'@'*)
    printf '%s\n' 'ok   --data @<file> still forwarded to the transport'
    ;;
  *)
    printf '%s\n' "FAIL: --data @<file> not forwarded: ${out}" >&2
    fails=$(( fails + 1 ))
    ;;
esac

## Usage error (too few args) shares the usage exit code 2 with the gh-ism guard.
rc=0
out="$(run_git_api GET)" || rc=$?
if [ "${rc}" -eq 2 ] && [ "${out#*Usage:}" != "${out}" ]; then
  printf '%s\n' 'ok   too-few-args is a usage error (exit 2)'
else
  printf '%s\n' "FAIL: too-few-args not a usage error (rc ${rc}): ${out}" >&2
  fails=$(( fails + 1 ))
fi

## RESILIENT READS: github-api retries a transiently-truncated large response, so
## the retry flags must attach for idempotent reads (GET/HEAD) and NEVER for a
## write (POST/PATCH/DELETE), where retrying a response cut AFTER the server
## applied it would duplicate the created/changed resource.
for method in GET HEAD; do
  argv="$(argv_line_of "$(run_git_api "${method}" /rate_limit)")"
  case "${argv}" in
    *--retry*)
      printf '%s\n' "ok   ${method} carries retry flags"
      ;;
    *)
      printf '%s\n' "FAIL: ${method} missing retry flags: ${argv}" >&2
      fails=$(( fails + 1 ))
      ;;
  esac
done
for method in POST PATCH DELETE; do
  argv="$(argv_line_of "$(run_git_api "${method}" /repos/x/y/issues/1/comments)")"
  case "${argv}" in
    *--retry*)
      printf '%s\n' "FAIL: ${method} must not retry (a cut write would duplicate): ${argv}" >&2
      fails=$(( fails + 1 ))
      ;;
    *)
      printf '%s\n' "ok   ${method} carries no retry flags"
      ;;
  esac
done

## RETRY BUFFERING (dist-ai#849): a retried read must emit from a seekable buffer, never
## append a failed attempt's partial bytes to the complete retry (curl cannot retract
## stdout bytes). The fake writes a PARTIAL then the COMPLETE body: with --output it
## truncates+rewrites the file (-> complete only); without it, it appends to stdout
## (-> partial+complete). A GET must surface ONLY the complete body.
buf_bin="${tmp}/bufbin"
mkdir -p -- "${buf_bin}"
cat > "${buf_bin}/curl" <<'BUF_CURL'
#!/bin/bash
cat >/dev/null   # consume the --config document on stdin
out=""; prev=""
for a in "$@"; do [ "$prev" = "--output" ] && out="$a"; prev="$a"; done
if [ -n "$out" ]; then printf PARTIAL > "$out"; printf COMPLETE_BODY > "$out"
else printf PARTIAL; printf COMPLETE_BODY; fi
BUF_CURL
chmod 0755 -- "${buf_bin}/curl"
cp -- "${buf_bin}/curl" "${buf_bin}/scurl"
out="$(PATH="${buf_bin}:${PATH}" GITHUB_TOKEN_FILE="${tmp}/token" \
  "${git_api}" GET /rate_limit 2>&1)"
case "${out}" in
  COMPLETE_BODY)
    printf '%s\n' 'ok   GET retry emits only the complete body (no partial-append)'
    ;;
  *PARTIAL*)
    printf '%s\n' "FAIL: GET retry leaked a partial attempt to the caller: ${out}" >&2
    fails=$(( fails + 1 ))
    ;;
  *)
    printf '%s\n' "FAIL: GET buffered output unexpected: ${out}" >&2
    fails=$(( fails + 1 ))
    ;;
esac

## HARD-FAILURE BUFFERING: when every retry is cut (curl exits non-zero), the --output file
## holds only a PARTIAL body. github-api must emit NOTHING and exit non-zero -- never hand a
## caller a partial response that ignoring the exit status could parse as though it were whole.
fail_bin="${tmp}/failbin"
mkdir -p -- "${fail_bin}"
cat > "${fail_bin}/curl" <<'FAIL_CURL'
#!/bin/bash
cat >/dev/null   # consume the --config document on stdin
out=""; prev=""
for a in "$@"; do [ "${prev}" = "--output" ] && out="$a"; prev="$a"; done
[ -n "${out}" ] && printf PARTIAL > "${out}"
exit 56
FAIL_CURL
chmod 0755 -- "${fail_bin}/curl"
cp -- "${fail_bin}/curl" "${fail_bin}/scurl"
## errexit is on: a non-zero github-api (the point of this case) would abort the suite via the
## assignment, so capture the status through '|| hard_rc=$?' instead of a bare '$?'.
hard_rc=0
hard_out="$(PATH="${fail_bin}:${PATH}" GITHUB_TOKEN_FILE="${tmp}/token" \
  "${git_api}" GET /rate_limit 2>/dev/null)" || hard_rc="$?"
if [ -z "${hard_out}" ] && [ "${hard_rc}" -ne 0 ]; then
  printf '%s\n' 'ok   GET hard failure emits nothing and exits non-zero (no partial body)'
else
  printf '%s\n' "FAIL: GET hard failure leaked output or exited zero: rc=${hard_rc} out=[${hard_out}]" >&2
  fails=$(( fails + 1 ))
fi

## SECONDARY RATE LIMIT: GitHub returns a 403 (curl sees exit 0, so --retry misses it) with a
## Retry-After header or a "secondary rate limit" body. A GET must back off and retry, not hand
## the caller the error body. The fake returns the 403 on the first attempt, then a 200 on the
## next; github-api must surface the 200 body. Waits are driven to 0 via the env knobs.
rl_bin="${tmp}/rlbin"
mkdir -p -- "${rl_bin}"
cat > "${rl_bin}/curl" <<'RL_CURL'
#!/bin/bash
cat >/dev/null   # consume the --config document on stdin
out=""; hdr=""; prev=""
for a in "$@"; do
  case "${prev}" in --output) out="$a" ;; --dump-header) hdr="$a" ;; esac
  prev="$a"
done
n=0; [ -r "${RL_CTR}" ] && n="$(cat "${RL_CTR}")"; n=$(( n + 1 )); printf '%s' "${n}" > "${RL_CTR}"
if [ "${n}" -lt "${RL_OK_ON}" ]; then
  [ -n "${out}" ] && printf '%s' '{"message":"You have exceeded a secondary rate limit"}' > "${out}"
  [ -n "${hdr}" ] && printf 'HTTP/2 403\r\nRetry-After: 0\r\n\r\n' > "${hdr}"
  printf '403'
else
  [ -n "${out}" ] && printf '%s' 'RL_OK_BODY' > "${out}"
  [ -n "${hdr}" ] && printf 'HTTP/2 200\r\n\r\n' > "${hdr}"
  printf '200'
fi
RL_CURL
chmod 0755 -- "${rl_bin}/curl"
cp -- "${rl_bin}/curl" "${rl_bin}/scurl"
rl_ctr="${tmp}/rl_ctr"; true > "${rl_ctr}"
rl_out="$(PATH="${rl_bin}:${PATH}" GITHUB_TOKEN_FILE="${tmp}/token" \
  RL_CTR="${rl_ctr}" RL_OK_ON=2 \
  GH_SECONDARY_RL_ATTEMPTS=4 GH_SECONDARY_RL_WAIT_CAP=0 GH_SECONDARY_RL_BACKOFF=0 \
  "${git_api}" GET /rate_limit 2>/dev/null)" || rl_out="<rc $?>"
if [ "${rl_out}" = "RL_OK_BODY" ]; then
  printf '%s\n' 'ok   GET backs off a secondary-rate-limit 403 (Retry-After) and retries to success'
else
  printf '%s\n' "FAIL: secondary-RL 403 not retried to success: [${rl_out}]" >&2
  fails=$(( fails + 1 ))
fi

## A PERMISSION 403 (no Retry-After, body not a secondary limit) must NOT be retried -- it is
## emitted once, unchanged. Guards the backoff from swallowing a genuine permanent 403.
perm_bin="${tmp}/permbin"
mkdir -p -- "${perm_bin}"
cat > "${perm_bin}/curl" <<'PERM_CURL'
#!/bin/bash
cat >/dev/null
out=""; hdr=""; prev=""
for a in "$@"; do
  case "${prev}" in --output) out="$a" ;; --dump-header) hdr="$a" ;; esac
  prev="$a"
done
n=0; [ -r "${PERM_CTR}" ] && n="$(cat "${PERM_CTR}")"; n=$(( n + 1 )); printf '%s' "${n}" > "${PERM_CTR}"
[ -n "${out}" ] && printf '%s' '{"message":"Resource not accessible by integration"}' > "${out}"
[ -n "${hdr}" ] && printf 'HTTP/2 403\r\n\r\n' > "${hdr}"
printf '403'
PERM_CURL
chmod 0755 -- "${perm_bin}/curl"
cp -- "${perm_bin}/curl" "${perm_bin}/scurl"
perm_ctr="${tmp}/perm_ctr"; true > "${perm_ctr}"
perm_out="$(PATH="${perm_bin}:${PATH}" GITHUB_TOKEN_FILE="${tmp}/token" \
  PERM_CTR="${perm_ctr}" GH_SECONDARY_RL_ATTEMPTS=4 GH_SECONDARY_RL_WAIT_CAP=0 GH_SECONDARY_RL_BACKOFF=0 \
  "${git_api}" GET /rate_limit 2>/dev/null)" || perm_out="<rc $?>"
perm_calls="$(cat "${perm_ctr}")"
perm_match=0
case "${perm_out}" in
  *'Resource not accessible'*)
    perm_match=1
    ;;
esac
if [ "${perm_calls}" = "1" ] && [ "${perm_match}" -eq 1 ]; then
  printf '%s\n' 'ok   permission 403 (no Retry-After / not secondary) is NOT retried -- emitted once'
else
  printf '%s\n' "FAIL: permission 403 mis-handled: calls=${perm_calls} out=[${perm_out}]" >&2
  fails=$(( fails + 1 ))
fi

if (( fails > 0 )); then
  printf '%s\n' "github-api-tests: ${fails} check(s) FAILED" >&2
  exit 1
fi
printf '%s\n' 'github-api-tests: PASSED (25 checks, 0 failed, 0 skipped)'
