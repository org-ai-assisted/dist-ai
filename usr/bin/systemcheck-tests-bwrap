#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Sub-suite of systemcheck-tests: the scenario cases that need an unprivileged
## bwrap sandbox (usr/share/systemcheck-tests-bwrap). Split out so a CI host
## without user namespaces can authorize skipping THESE cases alone
## (--allow-skip systemcheck-tests-bwrap) while every other systemcheck case
## stays strict. Unauthorized, an unusable sandbox is FATAL (--strict-skips).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## Sourced, not executed: $0 stays this entrypoint, which selects the case dir.
# shellcheck source=./systemcheck-tests
source "$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")/systemcheck-tests"
