#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## style-ok: no-has -- standalone host/sandbox driver; does not source helper-scripts.

## Run the cspell spell-check lane over each site checkout inside the review sandbox, CONFINED
## under bwrap (no network at scan time: cspell's bundled dictionaries + the committed project
## dictionary are all local). cspell is npm-only (not Debian), so it is installed once in the
## sandbox and run there; this trusted VM never runs it.
##
##   webcheck-cspell-sandbox <site-root> [<site-root> ...]            # gate vs baseline
##   webcheck-cspell-sandbox --write-baseline <site-root> [...]       # (re)seed baselines
##
## Baselines live in usr/share/website-tests/cspell-baselines/ (committed, per site); the project
## dictionary + config in usr/share/website-tests/cspell-assets/.
## Exit: 0 all clean (no NEW unknown words), 1 a new word / a cspell error, 77 cspell absent
## locally AND no usable sandbox (env-unmet SKIP, like vnu/axe -- never a masked pass).
##
## cspell is PINNED to the 8.x line: 10.x requires NodeJS >= 22 and refuses to run on the sandbox's
## node 20, so a bare `cspell` install breaks the lane.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## Pinned EXACT (not a floating cspell@8): a float could serve a tampered 8.x, and an exact pin is
## reproducible. --ignore-scripts (below) also stops npm lifecycle scripts running as root during
## the install. CSPELL_VERSION is the single source of truth the version gate enforces.
readonly CSPELL_PKG='cspell@8.19.4'
readonly CSPELL_VERSION="${CSPELL_PKG##*@}"
readonly SANDBOX_WORKDIR="/home/user/webcheck-cspell-sandbox-run.$$"

die(){
   printf '%s\n' "webcheck-cspell-sandbox: $1" >&2
   exit 1
}

write_baseline=0
if [ "${1:-}" = '--write-baseline' ]; then
   write_baseline=1
   shift
fi
[ "$#" -gt 0 ] || die 'usage: webcheck-cspell-sandbox [--write-baseline] <site-root> [...]'

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"
if [ -d "${script_dir}/../share/website-tests" ]; then
   tests_dir="${script_dir}/../share/website-tests"
   core_src="${script_dir}/../lib/python3/dist-packages/dist_ai"
else
   tests_dir='/usr/share/website-tests'
   core_src='/usr/lib/python3/dist-packages/dist_ai'
fi
assets_src="${tests_dir}/cspell-assets"
baselines_src="${tests_dir}/cspell-baselines"
[ -d "${core_src}/webcheck" ] || die "missing webcheck core: ${core_src}/webcheck"
[ -f "${assets_src}/cspell.json" ] || die "missing cspell config: ${assets_src}/cspell.json"

## Reject two site roots that share a basename BEFORE the local/sandbox split, so BOTH paths
## honor it (hoisted so the two cannot drift). Each root maps to cspell-baseline-<basename>.txt,
## and dist_ai.webcheck.spelling keys that baseline on os.path.basename of the ORIGINAL argument
## (abspath, NO symlink resolution -- see _baseline_path). So two args sharing the same ORIGINAL
## basename clobber one baseline even when their symlink targets (canonical paths) differ. Key the
## dedup on that SAME original-arg basename -- NOT the canonicalized path, which would let a
## same-original-basename pair slip through and then clobber.
declare -A seen_base=()
for root in "$@"; do
   base="$(basename -- "${root}")"
   [ -z "${seen_base[${base}]:-}" ] || die "duplicate site-root basename '${base}'"
   seen_base[${base}]=1
done

## Local-first (mirrors webcheck-vnu-sandbox / webcheck-axe-sandbox): run cspell DIRECTLY
## where it resolves (a CI runner with cspell on PATH, or in-sandbox-direct) -- so the lane
## RUNS in CI, not only ever delegate. cspell absent locally -> fall through to the sandbox
## path below. WEBCHECK_NO_LOCAL=1 forces the sandbox path (regression test / orchestrator).
##
## Gate the local cspell on the EXACT pinned version too, mirroring the sandbox provisioning
## guard: a host cspell 10.x (needs node>=22) dies instead of spell-checking, and any other
## unpinned 8.x is non-reproducible. A version MISMATCH (not just absence) FALLS THROUGH to
## the sandbox path, which installs + runs the pinned CSPELL_PKG -- never runs the wrong local
## cspell. `cspell --version` prints just the version string (grep -Fxq: fixed whole-line).
if [ "${WEBCHECK_NO_LOCAL:-}" != '1' ] && command -v cspell >/dev/null 2>&1 \
   && grep --fixed-strings --line-regexp --quiet "${CSPELL_VERSION}" <<< "$(cspell --version 2>/dev/null)"; then
   declare -a local_args=( --baseline-dir "${baselines_src}" --config "${assets_src}/cspell.json" )
   [ "${write_baseline}" = '1' ] && local_args+=( --write-baseline )
   rc=0
   PYTHONPATH="${core_src%/dist_ai}" python3 -Bsu -m dist_ai.webcheck.spelling \
      "${local_args[@]}" "$@" || rc="$?"
   exit "${rc}"
fi

## No local cspell. Reach the review sandbox -- unless we are inside it already (cannot nest),
## it is disabled, or there is none: then the lane is genuinely env-unmet, so exit 77 (the
## launcher's delegate_sandbox_lane maps 77 to SKIP) like the vnu/axe siblings -- NEVER die 1,
## which delegate_sandbox_lane would turn into a FAIL. Never a masked failure: a lane that RAN
## exits 0/non-77 above.
if [ "${DIST_AI_IN_SANDBOX:-}" = '1' ] || [ "${WEBSITE_TESTS_NO_SANDBOX:-}" = '1' ] \
   || ! command -v sandbox >/dev/null 2>&1; then
   printf '%s\n' 'webcheck-cspell-sandbox: cspell absent locally and no usable sandbox -- SKIP (77)' >&2
   ## style-ok: allow-skip: env-unmet -- no local cspell and no usable sandbox; delegate_sandbox_lane maps 77 to SKIP, never a masked pass (a lane that RAN exits 0/non-77 above)
   exit 77
fi
: "${QUBE_CTL_TARGET:=temp-claude}"
export QUBE_CTL_TARGET
sandbox exec --pid-scope private -- type sandbox-confine >/dev/null 2>&1 \
   || die 'sandbox is missing sandbox-confine (bwrap confinement)'

## --- provision cspell (idempotent, forget-proof: the safe path is the DEFAULT) ---------------
## node+npm come with the lighthouse/axe provisioning; ensure them, then install cspell globally.
## sudo + apt + a global npm install need the SHARED pid namespace (sudo is dead in a private one).
## Gate on the EXACT pinned version, not mere presence or just the major line: the install pins
## CSPELL_PKG exactly, so the guard must enforce the SAME version, else a different 8.x already on
## PATH (or a node-20-incompatible 10.x) silently runs the lane on an unpinned cspell. `cspell
## --version` prints just the version string, e.g. "8.19.4" (grep -Fx: fixed-string whole-line).
if ! sandbox exec --pid-scope private -- sh -c "cspell --version 2>/dev/null | grep -Fxq '${CSPELL_VERSION}'"; then
   printf '%s\n' "webcheck-cspell-sandbox: installing pinned ${CSPELL_PKG} in the sandbox (one-time)..." >&2
   if ! sandbox exec --pid-scope private -- sh -c 'command -v npm >/dev/null 2>&1'; then
      printf '%s\n' 'webcheck-cspell-sandbox: installing nodejs + npm in the sandbox (signed apt)...' >&2
      sandbox exec --pid-scope host -- sudo apt-get install --yes nodejs npm >&2 \
         || die 'could not install nodejs/npm in the sandbox'
   fi
   sandbox exec --pid-scope host -- sudo npm install --global --no-fund --no-audit --ignore-scripts "${CSPELL_PKG}" >&2 \
      || die "'npm install -g ${CSPELL_PKG}' failed in the sandbox"
   sandbox exec --pid-scope private -- sh -c "cspell --version 2>/dev/null | grep -Fxq '${CSPELL_VERSION}'" \
      || die "cspell ${CSPELL_VERSION} still absent after install"
fi

## --- stage the webcheck core, the assets, the baselines, and each site root, then run ---------

## Stage on ample persistent disk, not the small /tmp tmpfs -- a large tree overflows it mid-rsync
## (ENOSPC reads as a lane failure). Mirrors webcheck-vnu-sandbox. Override WEBCHECK_CSPELL_TMP.
: "${WEBCHECK_CSPELL_TMP:=${XDG_CACHE_HOME:-${HOME}/.cache}/webcheck-cspell-sandbox-tmp}"
mkdir --parents -- "${WEBCHECK_CSPELL_TMP}"
staging="$(mktemp --directory -- "${WEBCHECK_CSPELL_TMP}/webcheck-cspell-sandbox.XXXXXX")"
synced=0
cleanup(){
   # shellcheck disable=SC2317  # invoked indirectly via the EXIT trap
   safe-rm --recursive --force -- "${staging}" || true
   # shellcheck disable=SC2317
   if [ "${synced}" = '1' ]; then
      sandbox exec --pid-scope private -- safe-rm --recursive --force -- "${SANDBOX_WORKDIR}" >/dev/null 2>&1 || true
   fi
   # shellcheck disable=SC2317
   return 0
}
trap cleanup EXIT

staged_pylib="${staging}/usr/lib/python3/dist-packages"
mkdir --parents -- "${staged_pylib}" "${staging}/cspell-assets" "${staging}/cspell-baselines" "${staging}/roots"
cp --archive -- "${core_src}" "${staged_pylib}/dist_ai"
cp --archive -- "${assets_src}/." "${staging}/cspell-assets/"
if [ -d "${baselines_src}" ]; then
   cp --archive -- "${baselines_src}/." "${staging}/cspell-baselines/"
fi

declare -a remote_roots=()
for root in "$@"; do
   [ -f "${root}/index.html" ] || die "not a site root (no index.html): ${root}"
   root="$(readlink --canonicalize -- "${root}")"
   base="$(basename -- "${root}")"
   ## Duplicate basenames are already rejected before the local/sandbox split.
   ## Only the .html files are checked; rsync them (preserving tree), skip .git (exclude first, so
   ## it is not re-included by '*/').
   ## Keep rsync's DEFAULT safe symlink handling (symlinks staged AS symlinks, never dereferenced):
   ## --copy-links would follow an OUT-OF-TREE symlink (staging a host file like ~/.ssh/id_rsa into
   ## the sandbox) and ABORT the lane (errexit) on a broken symlink. A symlinked-only site then
   ## stages no regular .html, so cspell matches 0 files and FAILS LOUD (the core drops
   ## --no-must-find-files) instead of a false green.
   rsync --archive --prune-empty-dirs --exclude='.git' --include='*/' --include='*.html' \
      --exclude='*' -- "${root}/" "${staging}/roots/${base}/"
   remote_roots+=( "roots/${base}" )
done

sandbox sync --delete "${staging}" "$(basename -- "${SANDBOX_WORKDIR}")" >&2 \
   || die 'failed to sync the staging tree into the sandbox'
synced=1

declare -a mod_args=( --baseline-dir cspell-baselines --config cspell-assets/cspell.json )
[ "${write_baseline}" = '1' ] && mod_args+=( --write-baseline )

## Confined (bwrap): no network needed at scan time. cspell (a global npm bin) + plain python3
## resolve on PATH inside the confine, as c8 does for the jscov lane. cwd = the synced workdir.
rc=0
sandbox exec --pid-scope private -- sandbox-confine --workdir "${SANDBOX_WORKDIR}" -- env \
   "PYTHONPATH=usr/lib/python3/dist-packages" \
   python3 -Bsu -m dist_ai.webcheck.spelling "${mod_args[@]}" "${remote_roots[@]}" || rc="$?"

## Seeded baselines are written inside the sandbox; pull each back byte-faithfully (sandbox exec
## stdout mangles some bytes) so the operator can review + commit the diff.
if [ "${write_baseline}" = '1' ] && [ "${rc}" = '0' ]; then
   mkdir --parents -- "${baselines_src}"
   for root in "$@"; do
      base="$(basename -- "$(readlink --canonicalize -- "${root}")")"
      bfile="cspell-baseline-${base}.txt"
      if sandbox exec --pid-scope private -- test -f "${SANDBOX_WORKDIR}/cspell-baselines/${bfile}"; then
         sandbox pull "${SANDBOX_WORKDIR}/cspell-baselines/${bfile}" "${baselines_src}/" \
            || die "failed to copy back ${bfile}"
         printf '%s\n' "seeded ${baselines_src}/${bfile}" >&2
      fi
   done
fi

exit "${rc}"
