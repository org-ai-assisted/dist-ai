#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Generic, self-contained image optimizer for raster assets.
##
## - default: lossless-minimize each file IN PLACE -- optipng (PNG) / jpegoptim
##   (JPEG), both stripping all metadata. Keeps the SMALLER of before/after, so a
##   file is never grown.
## - --convert: KEEP-SMALLER delivery. After minimizing, also encode a webp AND an
##   avif candidate and REPLACE the source with whichever of {minimized-source,
##   webp, avif} is smallest -- "improvements only", so an image is NEVER grown and
##   each gets whichever format wins for it (avif usually wins on photos, lossless
##   webp usually wins on dense screenshots). PNG -> lossless webp / q90 avif; JPEG
##   -> q82 webp / q60 avif (lossless fallbacks). Prints one
##   "<input-path><TAB><result-path>" line per input (result may have a .webp or
##   .avif extension, or == input when the source itself was smallest), so a caller
##   can rewrite references to the winner.
## - --check: NON-mutating gate. Exit 1 (naming the file + reclaimable bytes) if a
##   file could still be losslessly shrunk beyond the tolerance; exit 0 otherwise.
##   This is the deterministic property the pre-commit image gate enforces.
##
## Self-contained by design: dist-ai is PUBLIC and must not depend on any private
## repo, so the optipng/jpegoptim/cwebp/avifenc pipeline is implemented here
## directly. The --check floor is defined by optipng/jpegoptim alone (deterministic,
## idempotent -- they always run last); no re-encoding metadata stripper (mat2) is
## used, as -strip already removes metadata and a re-encode would make the floor
## version-dependent.
##
## CANONICAL encode flags are the single source of the webp/avif invocation for
## every consumer; mirror these, do not fork a second flag set. avif `-j 1` makes
## the bytes deterministic regardless of host core count (parallelism is across
## images), so a pre-commit encode is byte-identical on every contributor machine.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"

## CANONICAL avif encode knobs. PNG/line-art: q90 + full-quality alpha (visually
## lossless). JPEG/photographic: q60.
avif_codec='aom'
avif_speed='6'
avif_q_png='90'
avif_qalpha_png='100'
avif_q_photo='60'
avif_qalpha_photo='60'

## Guard the source so a missing helper-scripts yields a DISTINCT environment
## exit code (3), never 1 -- the pre-commit image gate reads exit 1 as "not
## optimized" and must not confuse a missing dependency with a real finding.
# shellcheck disable=SC1091
if ! source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/strings.bsh 2>/dev/null; then
   printf '%s\n' "${me}: ERROR: cannot source helper-scripts strings.bsh (set HELPER_SCRIPTS_PATH)" >&2
   exit 3
fi

mode_check='false'
mode_convert='false'
quiet='false'
## A file is flagged by --check only when it can shed MORE than max(tol_floor,
## tol_pct% of its size). Real screenshot bloat is tens of percent; this margin
## just absorbs any harmless run-to-run jitter on an already-optimized file.
tol_pct='1'
tol_floor='32'

usage() {
   printf '%s\n' "Usage: ${me} [--convert] [--check] [--quiet] [--tolerance-pct N] [--tolerance-bytes N] -- FILE..."
}

log() {
   if [ "${quiet}" = 'true' ]; then
      return 0
   fi
   printf '%s\n' "${me}: $*" >&2
   return 0
}

err() {
   printf '%s\n' "${me}: ERROR: $*" >&2
}

files=()
while [ "$#" -gt 0 ]; do
   case "$1" in
      --check)
         mode_check='true'
         shift
         ;;
      --convert)
         mode_convert='true'
         shift
         ;;
      --quiet)
         quiet='true'
         shift
         ;;
      --tolerance-pct)
         if [ "$#" -lt 2 ]; then
            err "--tolerance-pct requires a value"
            exit 2
         fi
         tol_pct="$2"
         shift 2
         ;;
      --tolerance-bytes)
         if [ "$#" -lt 2 ]; then
            err "--tolerance-bytes requires a value"
            exit 2
         fi
         tol_floor="$2"
         shift 2
         ;;
      -h|--help)
         usage
         exit 0
         ;;
      --)
         shift
         files+=( "$@" )
         break
         ;;
      -*)
         err "unknown option: $1"
         usage >&2
         exit 2
         ;;
      *)
         files+=( "$1" )
         shift
         ;;
   esac
done

if [ "${#files[@]}" -eq 0 ]; then
   usage >&2
   exit 2
fi

if ! [[ "${tol_pct}" =~ ^[0-9]+$ ]] || ! [[ "${tol_floor}" =~ ^[0-9]+$ ]]; then
   err "tolerance values must be whole numbers"
   exit 2
fi

## Precondition checks: the minimizers are needed in every mode (--check also
## minimizes into a temp copy); cwebp + avifenc only when converting.
if ! type -P optipng >/dev/null; then
   err "required tool not found: optipng"
   exit 3
fi
if ! type -P jpegoptim >/dev/null; then
   err "required tool not found: jpegoptim"
   exit 3
fi
if ! type -P stat >/dev/null; then
   err "required tool not found: stat"
   exit 3
fi
if [ "${mode_convert}" = 'true' ]; then
   if ! type -P cwebp >/dev/null; then
      err "required tool not found: cwebp (webp)"
      exit 3
   fi
   if ! type -P avifenc >/dev/null; then
      err "required tool not found: avifenc (libavif-bin)"
      exit 3
   fi
fi

lc() {
   printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

## Absolute path (dir canonicalized, basename kept verbatim). Guarantees the path
## never begins with '-', so it is safe as a positional arg to optipng / jpegoptim
## / cwebp / avifenc (none has a '--' end-of-options marker for the input path).
abspath() {
   local input="$1" dir base
   if ! dir="$(dirname -- "${input}")"; then
      return 1
   fi
   if ! dir="$(cd -- "${dir}" && pwd)"; then
      return 1
   fi
   base="${input##*/}"
   printf '%s' "${dir}/${base}"
}

## png | jpeg | skip, by lower-cased extension.
img_kind() {
   local base ext
   base="${1##*/}"
   ext="$(lc "${base##*.}")"
   case "${ext}" in
      png)
         printf '%s' 'png'
         ;;
      jpg|jpeg)
         printf '%s' 'jpeg'
         ;;
      *)
         printf '%s' 'skip'
         ;;
   esac
}

## Make a losslessly-minimized COPY of $1 (same dir, same extension) and print its
## path. Return 1 (leaving nothing behind) on any failure. The optimizer runs last
## and is the sole definition of the floor, so this is idempotent.
make_minimized() {
   local src="$1" dir base ext kind work
   dir="$(dirname -- "${src}")"
   base="${src##*/}"
   ext="$(lc "${base##*.}")"
   kind="$(img_kind "${src}")"
   if ! work="$(mktemp --tmpdir="${dir}" --suffix=".${ext}" imgopt.XXXXXX)"; then
      return 1
   fi
   if ! cp --preserve=timestamps -- "${src}" "${work}"; then
      safe-rm -- "${work}"
      return 1
   fi
   case "${kind}" in
      png)
         if ! optipng -quiet -o7 -zm9 -zc9 -zs3 -f5 -strip all -preserve "${work}" >/dev/null 2>&1; then
            safe-rm -- "${work}"
            return 1
         fi
         ;;
      jpeg)
         if ! jpegoptim --quiet --strip-all -- "${work}" >/dev/null 2>&1; then
            safe-rm -- "${work}"
            return 1
         fi
         ;;
      *)
         safe-rm -- "${work}"
         return 1
         ;;
   esac
   printf '%s' "${work}"
}

## Produce the best webp for the already-minimized source $1 and print its temp
## path IF strictly smaller than the source; otherwise print nothing (and clean
## up). Return 1 on a hard cwebp failure. PNG -> lossless; JPEG -> lossy q82 with a
## lossless fallback when lossy did not beat the source.
make_webp() {
   local src="$1" dir kind cand size_src size_cand
   dir="$(dirname -- "${src}")"
   kind="$(img_kind "${src}")"
   size_src="$(stat -c %s -- "${src}")"
   if ! cand="$(mktemp --tmpdir="${dir}" --suffix='.webp' imgopt.XXXXXX)"; then
      return 1
   fi
   if [ "${kind}" = 'png' ]; then
      if ! cwebp -mt -quiet -lossless -z 9 "${src}" -o "${cand}"; then
         safe-rm -- "${cand}"
         return 1
      fi
   else
      if ! cwebp -mt -quiet -q 82 "${src}" -o "${cand}"; then
         safe-rm -- "${cand}"
         return 1
      fi
      size_cand="$(stat -c %s -- "${cand}")"
      if [ "${size_cand}" -ge "${size_src}" ]; then
         if ! cwebp -mt -quiet -lossless -z 9 "${src}" -o "${cand}"; then
            safe-rm -- "${cand}"
            return 1
         fi
      fi
   fi
   size_cand="$(stat -c %s -- "${cand}")"
   if [ "${size_cand}" -lt "${size_src}" ]; then
      printf '%s' "${cand}"
   else
      safe-rm -- "${cand}"
   fi
}

## avifenc writes progress to stdout; these wrappers redirect it so the caller sees
## only the candidate path.
run_avifenc_png() {
   avifenc -c "${avif_codec}" -s "${avif_speed}" -q "${avif_q_png}" --qalpha "${avif_qalpha_png}" -j 1 "$1" "$2" >/dev/null 2>&1
}
run_avifenc_photo() {
   avifenc -c "${avif_codec}" -s "${avif_speed}" -q "${avif_q_photo}" --qalpha "${avif_qalpha_photo}" -j 1 "$1" "$2" >/dev/null 2>&1
}
run_avifenc_lossless() {
   avifenc -c "${avif_codec}" -s "${avif_speed}" -j 1 --lossless "$1" "$2" >/dev/null 2>&1
}

## Produce the best avif for the already-minimized source $1 and print its temp
## path IF strictly smaller than the source; otherwise print nothing (and clean
## up). Return 1 on a hard avifenc failure.
make_avif() {
   local src="$1" dir kind cand size_src size_cand
   dir="$(dirname -- "${src}")"
   kind="$(img_kind "${src}")"
   size_src="$(stat -c %s -- "${src}")"
   if ! cand="$(mktemp --tmpdir="${dir}" --suffix='.avif' imgopt.XXXXXX)"; then
      return 1
   fi
   if [ "${kind}" = 'png' ]; then
      ## PNG/line-art/screenshots: q90 + full-quality alpha. Visually lossless on
      ## text/edges while far smaller than a lossless avif.
      if ! run_avifenc_png "${src}" "${cand}"; then
         safe-rm -- "${cand}"
         return 1
      fi
   else
      ## JPEG (photographic): lossy first, fall back to lossless when lossy did
      ## not beat the source.
      if ! run_avifenc_photo "${src}" "${cand}"; then
         safe-rm -- "${cand}"
         return 1
      fi
      size_cand="$(stat -c %s -- "${cand}")"
      if [ "${size_cand}" -ge "${size_src}" ]; then
         if ! run_avifenc_lossless "${src}" "${cand}"; then
            safe-rm -- "${cand}"
            return 1
         fi
      fi
   fi
   size_cand="$(stat -c %s -- "${cand}")"
   if [ "${size_cand}" -lt "${size_src}" ]; then
      printf '%s' "${cand}"
   else
      safe-rm -- "${cand}"
   fi
}

## Mutating path: minimize in place, then (in --convert mode) replace with the
## SMALLEST of {minimized-source, webp, avif}. Returns non-zero on a per-file error
## without aborting the batch.
process_one() {
   local input="$1" src base kind size_old size_new work
   local webp_cand avif_cand winner winner_ext best target
   if ! src="$(abspath "${input}")"; then
      err "cannot resolve path: ${input}"
      return 1
   fi
   if [ ! -f "${src}" ]; then
      err "not a file: ${input}"
      return 1
   fi
   if [ ! -w "${src}" ]; then
      err "not writable: ${input}"
      return 1
   fi
   ## 'stat -c %s' does NOT dereference a symlink (it reports the link's own path
   ## length, not the target's size), so a symlinked image reads as tiny and is
   ## silently judged "already minimal" -- or, in --convert mode, the link is
   ## replaced by a regular file. Refuse it; the caller should optimize the target.
   if [ -L "${src}" ]; then
      err "refusing to optimize a symlink (optimize its target instead): ${input}"
      return 1
   fi
   base="${src##*/}"
   if ! validate_safe_filename base; then
      err "unsafe filename: ${input}"
      return 1
   fi
   kind="$(img_kind "${src}")"
   if [ "${kind}" = 'skip' ]; then
      log "skip (unsupported type): ${input}"
      if [ "${mode_convert}" = 'true' ]; then
         printf '%s\n' "${src}"$'\t'"${src}"
      fi
      return 0
   fi

   ## In --convert mode the source is REPLACED by <stem>.webp OR <stem>.avif (the
   ## smaller wins -- which one is not known until both are encoded). If EITHER
   ## target already exists, refuse NOW -- before the in-place minimize -- so a
   ## refused conversion never mutates the source, and a same-stem batch (foo.png
   ## then foo.jpg) cannot clobber the first's output or lose the second's bytes.
   if [ "${mode_convert}" = 'true' ]; then
      if [ -e "${src%.*}.webp" ] || [ -e "${src%.*}.avif" ]; then
         err "a converted target already exists for ${input} (<stem>.webp/.avif); refusing to overwrite it"
         return 1
      fi
   fi

   size_old="$(stat -c %s -- "${src}")"
   work=''
   work="$(make_minimized "${src}")" || work=''
   if [ -z "${work}" ]; then
      err "minimize failed: ${input}"
      return 1
   fi
   size_new="$(stat -c %s -- "${work}")"
   if [ "${size_new}" -lt "${size_old}" ]; then
      ## mktemp created work as 0600; carry the source's own mode onto it before
      ## the replace, so the optimized file is not silently made owner-only. errexit
      ## is suppressed inside process_one (batch '|| rc=1'), so a failed chmod/mv
      ## must not fall through to a "minimized" success log.
      if ! { chmod --reference="${src}" -- "${work}" && mv -f -- "${work}" "${src}"; }; then
         err "replace failed: ${input}"
         safe-rm -- "${work}" 2>/dev/null || true
         return 1
      fi
      log "minimized: ${input} (${size_old} -> ${size_new} bytes)"
   else
      safe-rm -- "${work}"
      log "already minimal: ${input} (${size_old} bytes)"
   fi

   if [ "${mode_convert}" != 'true' ]; then
      return 0
   fi

   ## Encode both candidates. A hard encoder failure is a real error, not "not
   ## smaller" (which yields an empty path and return 0).
   webp_cand=''
   if ! webp_cand="$(make_webp "${src}")"; then
      err "webp conversion failed: ${input}"
      return 1
   fi
   avif_cand=''
   if ! avif_cand="$(make_avif "${src}")"; then
      err "avif conversion failed: ${input}"
      safe-rm -- "${webp_cand}" 2>/dev/null || true
      return 1
   fi

   ## Pick the SMALLEST of {source, webp, avif}. The source is the baseline; a
   ## candidate wins only if strictly smaller (make_* already enforce < source, so
   ## this just breaks the webp-vs-avif tie toward whichever is smaller).
   winner=''
   winner_ext=''
   best="$(stat -c %s -- "${src}")"
   if [ -n "${webp_cand}" ]; then
      if [ "$(stat -c %s -- "${webp_cand}")" -lt "${best}" ]; then
         winner="${webp_cand}"
         winner_ext='webp'
         best="$(stat -c %s -- "${webp_cand}")"
      fi
   fi
   if [ -n "${avif_cand}" ]; then
      if [ "$(stat -c %s -- "${avif_cand}")" -lt "${best}" ]; then
         winner="${avif_cand}"
         winner_ext='avif'
      fi
   fi

   if [ -z "${winner}" ]; then
      ## The optimized source was smallest -- keep it as-is.
      safe-rm -- "${webp_cand}" 2>/dev/null || true
      safe-rm -- "${avif_cand}" 2>/dev/null || true
      log "kept source (smaller than webp/avif): ${input}"
      printf '%s\n' "${src}"$'\t'"${src}"
      return 0
   fi

   target="${src%.*}.${winner_ext}"
   ## Never clobber an existing/racing target (a same-stem batch, or a pre-existing
   ## file). mv -n is a no-clobber rename; on a clash it SKIPS, leaving winner in
   ## place -- detect and refuse rather than destroy data.
   if [ -e "${target}" ] && [ "${target}" != "${src}" ]; then
      err "target already exists: ${target##*/} (from ${input}); refusing to overwrite it"
      safe-rm -- "${webp_cand}" 2>/dev/null || true
      safe-rm -- "${avif_cand}" 2>/dev/null || true
      return 1
   fi
   if ! chmod --reference="${src}" -- "${winner}"; then
      err "winner chmod failed: ${input}"
      safe-rm -- "${webp_cand}" 2>/dev/null || true
      safe-rm -- "${avif_cand}" 2>/dev/null || true
      return 1
   fi
   if ! mv -n -- "${winner}" "${target}"; then
      err "winner move failed: ${input}"
      safe-rm -- "${webp_cand}" 2>/dev/null || true
      safe-rm -- "${avif_cand}" 2>/dev/null || true
      return 1
   fi
   if [ -e "${winner}" ]; then
      err "target already exists: ${target##*/} (from ${input}); refusing to overwrite it"
      safe-rm -- "${winner}" 2>/dev/null || true
      if [ -n "${avif_cand}" ] && [ "${avif_cand}" != "${winner}" ]; then
         safe-rm -- "${avif_cand}" 2>/dev/null || true
      fi
      if [ -n "${webp_cand}" ] && [ "${webp_cand}" != "${winner}" ]; then
         safe-rm -- "${webp_cand}" 2>/dev/null || true
      fi
      return 1
   fi
   ## Clean the losing candidate, then drop the source if the winner is a new file.
   if [ -n "${webp_cand}" ] && [ "${webp_cand}" != "${winner}" ]; then
      safe-rm -- "${webp_cand}" 2>/dev/null || true
   fi
   if [ -n "${avif_cand}" ] && [ "${avif_cand}" != "${winner}" ]; then
      safe-rm -- "${avif_cand}" 2>/dev/null || true
   fi
   if [ "${target}" != "${src}" ]; then
      safe-rm -- "${src}"
   fi
   log "converted: ${input} -> ${target##*/} ($(stat -c %s -- "${target}") bytes)"
   printf '%s\n' "${src}"$'\t'"${target}"
   return 0
}

## Non-mutating gate: exit 1 if the file can shed more than the tolerance.
check_one() {
   local input="$1" src base kind size_old size_new work reclaim threshold
   if ! src="$(abspath "${input}")"; then
      err "cannot resolve path: ${input}"
      return 2
   fi
   if [ ! -f "${src}" ]; then
      err "not a file: ${input}"
      return 2
   fi
   ## Same 'stat -c %s' symlink trap as process_one (it reports the LINK path length,
   ## not the target): for a symlink size_old reads tiny, reclaim goes negative, and the
   ## gate would falsely PASS an unoptimized image. Refuse it, as the mutating path does.
   if [ -L "${src}" ]; then
      err "refusing to check a symlink (check its target instead): ${input}"
      return 2
   fi
   base="${src##*/}"
   if ! validate_safe_filename base; then
      err "unsafe filename: ${input}"
      return 2
   fi
   kind="$(img_kind "${src}")"
   ## Only the raster types this tool minimizes are gated; anything else passes.
   if [ "${kind}" = 'skip' ]; then
      return 0
   fi

   size_old="$(stat -c %s -- "${src}")"
   work=''
   work="$(make_minimized "${src}")" || work=''
   if [ -z "${work}" ]; then
      err "cannot verify (minimize failed): ${input}"
      return 2
   fi
   size_new="$(stat -c %s -- "${work}")"
   safe-rm -- "${work}"

   reclaim=$(( size_old - size_new ))
   if [ "${reclaim}" -le 0 ]; then
      return 0
   fi
   threshold=$(( size_old * tol_pct / 100 ))
   if [ "${threshold}" -lt "${tol_floor}" ]; then
      threshold="${tol_floor}"
   fi
   if [ "${reclaim}" -gt "${threshold}" ]; then
      printf '%s\n' "${me}: NOT optimized: ${input} (reclaimable ${reclaim} of ${size_old} bytes; run image-optimize)" >&2
      return 1
   fi
   return 0
}

rc=0
for file_name in "${files[@]}"; do
   if [ "${mode_check}" = 'true' ]; then
      ## Preserve check_one's distinction: 1 = definitively not optimized
      ## (dominant), 2 = could not verify (missing / unsafe / unprocessable). A
      ## consumer (the pre-commit gate) reads 1 as a finding and any other
      ## non-zero as an environment problem, so the two must not be collapsed.
      crc=0
      check_one "${file_name}" || crc="$?"
      if [ "${crc}" -eq 1 ]; then
         rc=1
      elif [ "${crc}" -ne 0 ] && [ "${rc}" -ne 1 ]; then
         rc="${crc}"
      fi
   else
      process_one "${file_name}" || rc=1
   fi
done

exit "${rc}"
