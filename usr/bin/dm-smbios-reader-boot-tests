#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Boot a built derivative-maker VM disk image (or ISO) headless and run
## functional checks over a login-free ROOT serial shell (dm-smbios-reader-qemu --test-console:
## systemd debug-shell + masked login getty), then report one pass/fail code.
## This is the disk-image successor to iso-boot-tests: dm-smbios-reader-image-test drives the
## boot + checks, dm-smbios-reader-qemu (bundled here) owns qemu/firmware/SecureBoot + the
## SMBIOS kernel-cmdline injection. Self-contained -- needs no derivative-maker
## checkout, only a built image + qemu on the BUILD HOST.
##
## All arguments are forwarded to dm-smbios-reader-image-test, notably:
##   --disk PATH          the VM image to boot (qcow2/raw/vdi/vmdk)
##   --iso PATH           a live ISO instead
##   --firmware bios|efi|efi-secureboot
##   --session user|sysmaint   (sysmaint exists only on GUI/lxqt flavors -- do
##                              NOT run --session sysmaint against a CLI image;
##                              CLI images ship no user-sysmaint-split by design)
##   --run CMD            extra check (default: systemcheck --cli --leak-tests)
##
## Exit codes (dist-ai-tests-all contract):
##   0   PASS (or checks passed)
##   77  SKIP (no image given, or qemu missing -- cannot boot-test here)
##   else FAIL (dm-smbios-reader-image-test FAIL/setup error, propagated)

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

SKIP=77

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/dm-smbios-reader-boot-tests" ]; then
   tests_dir="${script_dir}/../share/dm-smbios-reader-boot-tests"
else
   tests_dir='/usr/share/dm-smbios-reader-boot-tests'
fi

## Image-free regression tests first, so they run on every invocation including
## the SKIP paths below -- a test that only runs on a build host with a fresh
## image to hand is a test that effectively never runs. A failure here is a real
## FAIL, not a SKIP.
##
## python3-pytest is a hard dependency of this package, so an absent pytest is a
## broken install, not a reason to run nothing and still report green. Run it
## through `python3 -m` (the dist-ai convention) so a missing /usr/bin/pytest
## entry point cannot silence the module that IS installed.
## style-ok: allow-python-interpreter -- python3 -c dep probe
if ! python3 -c 'import pytest' 2>/dev/null; then
   printf '%s\n' "dm-smbios-reader-boot-tests: python3-pytest is missing; the image-free regression tests cannot run. FAIL." >&2
   exit 1
fi
## Run every test_*.py in tests_dir (dm-smbios-reader-image-test AND dm-smbios-reader-vbox, plus any future
## peer) so a new image-free suite is picked up by placement alone -- no
## per-file list to keep in sync here.
python3 -m pytest -q "${tests_dir}"/test_*.py

## SKIP when no image is supplied: this suite only runs on a build host that has
## a freshly built image to hand, never in the generic trixie-slim CI container.
image_given='false'
for arg in "$@"; do
   case "${arg}" in
      --disk|--iso|--disk=*|--iso=*)
         image_given='true'
         break
         ;;
   esac
done
if [ "${image_given}" != 'true' ]; then
   printf '%s\n' "dm-smbios-reader-boot-tests: no --disk/--iso given; nothing to boot-test. SKIP." >&2
   ## style-ok: allow-skip: no --disk/--iso image given -- an optional boot target
   exit "${SKIP}"
fi

## Backend availability. dm-smbios-reader-image-test resolves auto -> qemu/vbox itself;
## here we only decide whether a boot test is POSSIBLE on this host. --backend vbox
## REQUIRES VBoxManage (hard dependency -> loud FAIL, never a skip); --backend qemu
## keeps the historical no-qemu SKIP; auto skips only when NEITHER emulator is present.
backend='auto'
backend_prev=''
for arg in "$@"; do
   case "${backend_prev}" in
      --backend)
         backend="${arg}"
         ;;
   esac
   case "${arg}" in
      --backend=*)
         backend="${arg#--backend=}"
         ;;
   esac
   backend_prev="${arg}"
done

have_qemu='false'
if type -P qemu-system-x86_64 >/dev/null 2>&1 \
   || type -P qemu-system-aarch64 >/dev/null 2>&1; then
   have_qemu='true'
fi
have_vbox='false'
if type -P VBoxManage >/dev/null 2>&1; then
   have_vbox='true'
fi

case "${backend}" in
   vbox)
      if [ "${have_vbox}" != 'true' ]; then
         printf '%s\n' "dm-smbios-reader-boot-tests: --backend vbox needs VBoxManage (install VirtualBox); a hard dependency, not a skip. FAIL." >&2
         exit 1
      fi
      ;;
   qemu)
      if [ "${have_qemu}" != 'true' ]; then
         printf '%s\n' "dm-smbios-reader-boot-tests: --backend qemu but no qemu-system-* on PATH; cannot boot-test here. SKIP." >&2
         ## style-ok: allow-skip: no qemu-system-* on PATH -- boot test needs an emulator
         exit "${SKIP}"
      fi
      ;;
   *)
      if [ "${have_qemu}" != 'true' ] && [ "${have_vbox}" != 'true' ]; then
         printf '%s\n' "dm-smbios-reader-boot-tests: no qemu-system-* and no VBoxManage on PATH; cannot boot-test here. SKIP." >&2
         ## style-ok: allow-skip: no emulator (qemu or VirtualBox) available to boot-test
         exit "${SKIP}"
      fi
      ;;
esac

## Drive dm-smbios-reader-image-test, pointing it at the bundled dm-smbios-reader-qemu (both live in tests_dir).
## dm-smbios-reader-image-test returns 0 (PASS) / 5 (FAIL) / 2 (setup); all non-zero propagate
## as FAIL, which is what the aggregate runner wants.
rc=0
"${tests_dir}/dm-smbios-reader-image-test" --dm-smbios-reader-qemu "${tests_dir}/dm-smbios-reader-qemu" "$@" || rc=$?
exit "${rc}"
