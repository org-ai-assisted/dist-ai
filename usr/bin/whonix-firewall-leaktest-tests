#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Runner for the whonix-firewall LEAK-TEST suite: netns models of a
## Non-Qubes-Whonix gateway that load the REAL generated ruleset and prove no
## non-Tor egress across leak vectors (forged-source IPv6, and more as added),
## each with a positive control and a canary.
##
## Needs REAL root (netns + nf_nat); run under sudo. A non-root run reports every
## case SKIPPED (exit 77), never a false pass. Point WHONIX_FIREWALL_REPO at a
## whonix-firewall checkout so the cases can load its generated ruleset:
##   sudo WHONIX_FIREWALL_REPO=/path/to/whonix-firewall whonix-firewall-leaktest-tests
##
## Runs every *_test.sh in usr/share/whonix-firewall-leaktest-tests and fails if
## any of them does. Discovery is a glob so a new case needs no edit here.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## netns + nf_nat need REAL root (unprivileged user namespaces are not faithful
## for the nf_nat reply path). Re-exec under passwordless sudo when not root; if
## sudo is unavailable, fall through and let each case exit 77 (SKIPPED) rather
## than report a false pass.
if [ "$(id -u)" != '0' ]; then
   if sudo --non-interactive true 2>/dev/null; then
      sudo --non-interactive -- \
         env "WHONIX_FIREWALL_REPO=${WHONIX_FIREWALL_REPO:-}" \
         bash "$(readlink --canonicalize -- "$0")" "$@"
      exit "$?"
   fi
fi

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/whonix-firewall-leaktest-tests" ]; then
   tests_dir="${script_dir}/../share/whonix-firewall-leaktest-tests"
else
   tests_dir='/usr/share/whonix-firewall-leaktest-tests'
fi

shopt -s nullglob
case_scripts=( "${tests_dir}"/*_test.sh )
shopt -u nullglob

if [ "${#case_scripts[@]}" -eq 0 ]; then
   printf '%s\n' "FATAL: no case scripts found in '${tests_dir}'" >&2
   exit 1
fi

rc=0
failed=0
skipped=0
for case_script in "${case_scripts[@]}"; do
   printf '%s\n' "== $(basename -- "${case_script}") =="
   case_rc=0
   "${case_script}" "$@" || case_rc=$?
   if [ "${case_rc}" -eq 77 ]; then
      skipped=$(( skipped + 1 ))
   elif [ "${case_rc}" -ne 0 ]; then
      failed=$(( failed + 1 ))
      rc=1
   fi
done

printf '%s\n' ""
printf '%s\n' "${#case_scripts[@]} case(s), ${failed} failed, ${skipped} skipped"
exit "${rc}"
