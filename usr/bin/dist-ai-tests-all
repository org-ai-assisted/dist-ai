   genmkfile-tests
   git-meld-tests
   grep-find-unicode-wrapper-tests
   lockfile-tests
   msgcollector-tests
   onion-grater-tests
   onion-time-pre-script-tests
   open-link-confirmation-tests
   privleap-tests
   pyte-tests
   sanitize-string-tests
   secure-terminal-tests
   secure-terminal-tests-coverage
   sdwdate-gui-tests
   sdwdate-onion-tester-tests
   sdwdate-tests
   setup-wizard-dist-tests
   stcat-family-tests
   stdisplay-tests
   strip-markup-tests
   systemcheck-tests
   tb-updater-tests
   terminal-poc-corpus-tests
   tor-control-panel-tests
   unicode-show-tests
   web-analyzer-tests
   website-tests
)
fuzz_suites=(
   check-ref-commits-for-unicode-tests-fuzz
   private-ai-config-tests-fuzz
   git-meld-tests-fuzz
   grep-find-unicode-wrapper-tests-fuzz
   iso-boot-tests-fuzz
   lockfile-tests-fuzz
   msgcollector-tests-fuzz
   privleap-tests-fuzz
   privleap-tests-fuzz-atheris
   privleap-tests-session-fuzz
   pyte-tests-fuzz
   sanitize-string-tests-fuzz
   sdwdate-gui-tests-fuzz
