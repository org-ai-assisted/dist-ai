)

usage() {
   cat <<'EOF'
Usage:
  dist-ai-tests-all [--core] [--fuzz] [--e2e] [--integration] [--all]
                    [--repo-root DIR]
                    [--component NAME [--component-root DIR]]
                    [--helper-scripts-root DIR]
                    [--progress FILE]
                    [--timeout-core N] [--timeout-fuzz N] [--timeout-heavy N]
                    [--list]

With no category flag, only --core runs.

--repo-root points every suite at a derivative-maker MONOREPO checkout
(packages/<team>/<name>); without it each suite falls back to its installed
/ auto path. A suite that cannot find its target exits 77 and is reported SKIP.

--component NAME restricts the run to the suites owned by ONE component
(privleap, helper-scripts, onion-grater, genmkfile, open-link-confirmation,
sdwdate-gui, sdwdate, developer-meta-files, derivative-maker). --component-root DIR points those suites at
a STANDALONE component checkout -- the repo root itself, not a monorepo subpath
-- which is the per-repo CI entry point. --component-root requires --component.

--helper-scripts-root DIR supplies a helper-scripts checkout for components
whose suites drive a helper-scripts tool (open-link-confirmation ->
sanitize-string), needed in standalone-component mode where no sibling
helper-scripts checkout exists.

--skip NAME drops the suite entrypoint NAME from the run (repeatable), e.g. a
suite temporarily broken or pending a merge, so a component's other suites can
still gate PRs.

--allow-skip NAME authorizes suite NAME to exit 77 (SKIP) without failing the run
(repeatable). Under a --component filter an UNAUTHORIZED skip is a FAILURE, because
a suite that could not resolve its target must not report the same green exit 0 as
one that ran and passed. Authorize a suite only when a human has decided it may
legitimately be absent here -- never to turn a red run green.
EOF
}

## Resolve a package checkout path under --repo-root, or empty when unset.
pkg_dir() {
   local name="$1"
   ## Standalone-component override: the selected component's checkout root is
   ## given directly (the repo root itself), bypassing the monorepo
   ## packages/<team>/<name> join. This is the per-repo CI path.
   if [ -n "${component_root}" ] && [ "${name}" = "${component}" ]; then
      printf '%s' "${component_root}"
      return 0
   fi
   ## Auxiliary helper-scripts checkout: some components' suites drive a
   ## helper-scripts tool (open-link-confirmation -> sanitize-string). In
   ## standalone-component mode there is no sibling helper-scripts, so accept
   ## its root explicitly via --helper-scripts-root.
   if [ -n "${helper_scripts_root}" ] && [ "${name}" = 'helper-scripts' ]; then
      printf '%s' "${helper_scripts_root}"
      return 0
   fi
   [ -n "${repo_root}" ] || return 0
   case "${name}" in
      ## derivative-maker is the monorepo itself, not a packages/ subpath.
      derivative-maker)
         printf '%s' "${repo_root}"
         ;;
      onion-grater)
         printf '%s' "${repo_root}/packages/whonix/onion-grater"
         ;;
      ## Standalone repos with no packages/ subpath at all. Yielding empty (not
      ## a fabricated monorepo path) makes their suites exit 77 SKIP in
      ## --repo-root mode instead of failing to find a directory that was never
      ## going to exist; --component-root above is their real entry point.
      dist-ai|private-ai-config)
         ;;
      *)
         printf '%s' "${repo_root}/packages/kicksecure/${name}"
         ;;
   esac
}

## Given a suite name, populate wire_env (array of VAR=VALUE) and wire_args
## (array of positional args) so the suite targets the checkout. No-op when
## --repo-root is unset.
wire() {
   local suite="$1"
   local base="${suite%%-tests*}"
   wire_env=()
   wire_args=()
   [ -n "${repo_root}" ] || [ -n "${component_root}" ] || return 0

   local hs dmf suite_path
   hs="$( pkg_dir helper-scripts )"
   dmf="$( pkg_dir developer-meta-files )"

   case "${base}" in
      developer-meta-files)
         ## The style-gate test drives the real, shipped pre-push-static
         ## gate (now in dist-ai, resolved from the installed CLI or the
         ## in-tree copy); the dm-review-branch test drives check-ref-*-for-unicode
         ## / unicode-show from helper-scripts (HELPER_SCRIPTS_PATH, put on PATH
         ## by the entrypoint).
         wire_env=( "DMF_REPO=${dmf}" )
         if [ -n "${hs}" ]; then
            wire_env+=( "HELPER_SCRIPTS_PATH=${hs}" )
         fi
         ;;
      github-org-tools)
         ## The mock-API suite drives the dm-github-* / github-org-* tools from
         ## the developer-meta-files checkout: they self-locate their own
         ## libexec via DEVELOPER_META_FILES_PATH and helper-scripts via
         ## HELPER_SCRIPTS_PATH (the entrypoint derives PATH/PYTHONPATH from
         ## these).
         wire_env=( "DEVELOPER_META_FILES_PATH=${dmf}" )
         if [ -n "${hs}" ]; then
            wire_env+=( "HELPER_SCRIPTS_PATH=${hs}" )
         fi
         ;;
      check-ref-commits-for-unicode)
         wire_env=( "CHECK_REF_COMMITS_REPO=${hs}" )
         ;;
      grep-find-unicode-wrapper)
         wire_env=( "GREP_FIND_UNICODE_WRAPPER_REPO=${hs}" )
         ;;
      unicode-show)
         wire_env=( "UNICODE_SHOW_REPO=${hs}" )
         ;;
      stcat-family|stdisplay)
         wire_env=( "STDISPLAY_REPO=${hs}" )
         ;;
      strip-markup)
         wire_env=( "STRIP_MARKUP_REPO=${hs}" )
         ;;
      sanitize-string)
         ## sanitize-string's '#!/usr/bin/python3 -Bsu' excludes the user site,
         ## so from a checkout (not installed) it needs its dist-packages on
         ## PYTHONPATH -- else it dies with ModuleNotFoundError and prints
         ## nothing, which safety checks then pass on trivially (false green).
         ## SANITIZE_ECHO_BIN needs wiring for the same reason its sibling does:
         ## unwired, the suite resolves sanitize-echo through its hardcoded
         ## developer-box fallback path, which never exists in CI, and every [E]
         ## sanitize-echo case degrades to a SKIP that the run still reports as
         ## a clean PASS.
         wire_env=(
            "SANITIZE_STRING_BIN=${hs}/usr/bin/sanitize-string"
            "SANITIZE_ECHO_BIN=${hs}/usr/bin/sanitize-echo"
            "PYTHONPATH=${hs}/usr/lib/python3/dist-packages"
         )
         ;;
      lockfile)
         ## lockfile.sh ships in helper-scripts; the suite takes either a file
         ## (LOCKFILE_SH) or a checkout it resolves the file from.
         wire_env=( "LOCKFILE_SH_REPO=${hs}" )
         ;;
      onion-time-pre-script)
         ## onion-time-pre-script ships in helper-scripts; the suite extracts
         ## and runs individual bash functions from it, so it needs the file,
         ## not the runtime. Wire the file directly: unwired, the payload falls
         ## back to the installed path, which does not exist in CI, and every
         ## case degrades to a SKIP the run would still report as a clean pass.
         wire_env=(
            "ONION_TIME_PRE_SCRIPT_BIN=${hs}/usr/libexec/helper-scripts/onion-time-pre-script"
            "ONION_TIME_PRE_SCRIPT_REPO=${hs}"
         )
         ;;
      iso-boot)
         ## The QMP parser under test (qmp_client) is dist-ai's own payload under
         ## usr/share/iso-boot-tests, not a component checkout, so there is
         ## nothing to point at.
         wire_env=()
         wire_args=()
         ;;
      onion-grater)
         wire_env=( "ONION_GRATER_REPO=$( pkg_dir onion-grater )" )
         ;;
      privleap)
         wire_env=( "PRIVLEAP_REPO=$( pkg_dir privleap )" )
         ;;
      pyte)
         ## pyte lives in its own repo (a --component checkout of the
         ## org-ai-assisted/pyte fork), not a derivative-maker packages/ subpath;
         ## point the suite at it via PYTE_REPO resolved from the component root.
         wire_env=( "PYTE_REPO=$( pkg_dir pyte )" )
         ;;
      genmkfile)
         ## genmkfile's make-helper sources helper-scripts at runtime (has.sh,
         ## trace.bsh) and shells out to its tools; give it the full
         ## helper-scripts runtime (env here; the /usr/libexec/helper-scripts
         ## system path is provided by the CI setup step) when a helper-scripts
         ## checkout is available.
         wire_env=( "GENMKFILE_BIN=$( pkg_dir genmkfile )/usr/bin/genmkfile" )
         if [ -n "${hs}" ]; then
            wire_env+=(
               "HELPER_SCRIPTS_PATH=${hs}"
               "PATH=${hs}/usr/bin:${PATH}"
               "PYTHONPATH=${hs}/usr/lib/python3/dist-packages"
            )
         fi
         ;;
      open-link-confirmation)
         ## PYTHONPATH so the checkout's sanitize-string can import its library
         ## (see the sanitize-string note); without it sanitize-string emits
         ## nothing and the display-safety checks pass vacuously.
         wire_env=(
            "OPEN_LINK_CONFIRMATION_BIN=$( pkg_dir open-link-confirmation )/usr/libexec/open-link-confirmation/open-link-confirmation"
            "SANITIZE_STRING_BIN=${hs}/usr/bin/sanitize-string"
            "PYTHONPATH=${hs}/usr/lib/python3/dist-packages"
         )
         ;;
      sdwdate-gui)
         wire_env=( "PYTHONPATH=$( pkg_dir sdwdate-gui )/usr/lib/python3/dist-packages" )
         ;;
      sdwdate-onion-tester)
         ## The onion-tester CI wrappers are dist-ai's own usr/bin tools, invoked
         ## by sdwdate's workflow from its dist-ai checkout, so the subject is
         ## resolved from THIS repo, not from the component. mydir is usr/bin, so
         ## they sit beside this runner. Still mapped to the sdwdate component so
         ## it gates sdwdate's PRs, where a broken wrapper actually breaks a build.
         wire_env=(
            "ONION_TESTER_RUN_BIN=${mydir}/onion-tester-run"
            "VERIFY_EVIDENCE_BIN=${mydir}/onion-tester-verify-evidence"
         )
         ;;
      sdwdate)
         ## The suite imports sdwdate.sdwdate for real from SDWDATE_REPO. That
         ## import pulls guimessages and sanitize_string from helper-scripts,
         ## so without helper-scripts on PYTHONPATH it cannot load the subject
         ## at all and the suite skips (never a false green).
         wire_env=( "SDWDATE_REPO=$( pkg_dir sdwdate )" )
         if [ -n "${hs}" ]; then
            wire_env+=( "PYTHONPATH=${hs}/usr/lib/python3/dist-packages" )
         fi
         ;;
      setup-wizard-dist)
         ## The wizard imports guimessages from helper-scripts; the test adds
         ## the wizard checkout to sys.path from SETUP_WIZARD_DIST_REPO and needs
         ## helper-scripts on PYTHONPATH for guimessages. Without it the import
         ## fails and the suite skips (never a false green).
         wire_env=( "SETUP_WIZARD_DIST_REPO=$( pkg_dir setup-wizard-dist )" )
         if [ -n "${hs}" ]; then
            wire_env+=( "PYTHONPATH=${hs}/usr/lib/python3/dist-packages" )
         fi
         ;;
      msgcollector)
         ## The fuzzer extracts msgcollector's CLI-rendering bash from the one
         ## script and runs it in isolation; no other runtime needed.
         wire_env=( "MSGCOLLECTOR_REPO=$( pkg_dir msgcollector )" )
         ;;
      tb-updater)
         ## The core suite reads update-torbrowser / desktop-starter-wrapper /
         ## version-validator source from the checkout; the e2e suite installs
         ## the package and drives the installed binaries. Both resolve the
         ## checkout from TB_UPDATER_REPO.
         wire_env=( "TB_UPDATER_REPO=$( pkg_dir tb-updater )" )
         ;;
      systemcheck)
         ## The scenario harness runs the REAL check_*.bsh fragments, several of
         ## which sanitize untrusted output with the bare `sanitize-string`
         ## helper-scripts tool (check_dpkg, check_hostname, ...). Put the
         ## helper-scripts checkout's usr/bin on PATH so that tool resolves, and
         ## its dist-packages on PYTHONPATH (sanitize-string's '-Bsu' shebang
         ## excludes the user site, so from a checkout it needs its library
         ## there -- else it dies with ModuleNotFoundError and emits nothing,
         ## which the display-safety checks then pass on vacuously).
         wire_env=( "SYSTEMCHECK_REPO=$( pkg_dir systemcheck )" )
         if [ -n "${hs}" ]; then
            wire_env+=(
               "PATH=${hs}/usr/bin:${PATH}"
               "PYTHONPATH=${hs}/usr/lib/python3/dist-packages"
            )
         fi
         ;;
      tor-control-panel)
         ## tcp_testlib resolves the package under test from TCP_REPO (the
         ## tor-control-panel checkout root) else the installed package. The
         ## merged anon-connection-wizard imports guimessages from
         ## helper-scripts, so put helper-scripts on PYTHONPATH when available.
         wire_env=( "TCP_REPO=$( pkg_dir tor-control-panel )" )
         if [ -n "${hs}" ]; then
            wire_env+=( "PYTHONPATH=${hs}/usr/lib/python3/dist-packages" )
         fi
         ;;
      git-meld)
         ## git-meld moved from developer-meta-files to helper-scripts; the
         ## suite drives the tool plus the helper-scripts libs it sources.
         wire_args=( "${hs}/usr/bin/git-meld" )
         if [ -n "${hs}" ]; then
            wire_env=(
               "HELPER_SCRIPTS_PATH=${hs}"
               "PATH=${hs}/usr/bin:${PATH}"
               "PYTHONPATH=${hs}/usr/lib/python3/dist-packages"
            )
         fi
         ;;
      dm-virtualbox-wiki-links)
         wire_args=( "${dmf}/usr/bin/dm-virtualbox-update-local-and-wiki-links" )
         ;;
      dm-help-steps)
         wire_env=(
            "UMOUNT_KILL_SH=$( pkg_dir derivative-maker )/help-steps/umount_kill.sh"
            "UNMOUNT_TREE=$( pkg_dir derivative-maker )/help-steps/unmount-tree"
            "DM_HELP_STEPS_PRE=$( pkg_dir derivative-maker )/help-steps/pre"
            "DM_UPLOAD_IMAGES=$( pkg_dir derivative-maker )/packages/kicksecure/developer-meta-files/usr/bin/dm-upload-images"
            "DM_ASSERT_SUBMODULE=$( pkg_dir derivative-maker )/ci/assert-submodule-not-stale"
            ## In the main repo, so these RUN in component CI rather than
            ## skipping: without them the payloads fall back to
            ## '${HOME}/derivative-maker', which no CI runner has, and exit 77
            ## inside a suite that still reports PASS.
            "DM_SANITY_TESTS=$( pkg_dir derivative-maker )/build-steps.d/1100_sanity-tests"
            "DM_BUILD_OFFICIAL_ONE=$( pkg_dir derivative-maker )/help-steps/dm-build-official-one"
            ## Submodules: absent in the dist-ai-tests job (it checks out the
            ## component repo alone), so these payloads SKIP there and run from a
            ## full checkout. Wired anyway so the skip is a checkout fact rather
            ## than a missing variable.
            "KICKSECURE_BASE_FILES_DIR=$( pkg_dir kicksecure-base-files )"
            "LEGACY_DIST_PREINST=$( pkg_dir legacy-dist )/debian/legacy-dist.preinst"
         )
         ;;
      dm-reprepro-tracking)
         wire_env=( "DM_SOURCE_DIR=$( pkg_dir derivative-maker )" )
         ;;
      dm-reproducible-build)
         wire_env=( "DERIVATIVE_MAKER_DIR=$( pkg_dir derivative-maker )" )
         ;;
      dm-grub-smbios)
         ## Compares the two copies of the SMBIOS-reader GRUB block, both inside
         ## the derivative-maker checkout (one of them in a submodule).
         wire_env=( "DERIVATIVE_MAKER_DIR=$( pkg_dir derivative-maker )" )
         ;;
      dm-image-boot)
         ## Self-contained: it bundles dm-qemu + dm-image-test under
         ## usr/share/dm-image-boot-tests and takes the image to boot as an
         ## argument, so there is no checkout to point at. With no --disk/--iso
         ## it exits 77, which is the expected verdict in container CI.
         wire_env=()
         wire_args=()
         ;;
      dm-gitlink-upstream-check)
         ## Self-contained: the suite runs the checker's offline '--self-test'
         ## (stubbed resolver), so there is no checkout to point at and no
         ## network. The real check runs against a derivative-maker tree in that
         ## repo's own push-to-master CI, not here.
         wire_env=()
         wire_args=()
         ;;
      dist-ai-registry)
         ## Lints this repo's own suite registry, so its subject is the dist-ai
         ## checkout itself.
         wire_env=( "DIST_AI_REPO=$( pkg_dir dist-ai )" )
         ;;
      private-ai-config)
         ## The tests live in the private-ai-config checkout, not here; the suite
         ## drives them from PRIVATE_AI_CONFIG_PATH. Several exercise tools that
         ## source helper-scripts, so hand it that runtime when available.
         ##
         ## dist-ai's own usr/bin joins PATH because the git-hooks style-gate test
         ## drives 'pre-push-static', which ships HERE rather than in the component.
         ## Without it that test exits 77 and the lane records a skip -- a gate that
         ## reads as wired while it never ran. Same reason developer-meta-files gets
         ## the real shipped binary above.
         suite_path="${mydir}:${PATH}"
         wire_env=( "PRIVATE_AI_CONFIG_PATH=$( pkg_dir private-ai-config )" )
         if [ -n "${hs}" ]; then
            suite_path="${mydir}:${hs}/usr/bin:${PATH}"
            wire_env+=(
               "HELPER_SCRIPTS_PATH=${hs}"
               "PYTHONPATH=${hs}/usr/lib/python3/dist-packages"
            )
         fi
         wire_env+=( "PATH=${suite_path}" )
         ;;
      web-analyzer)
         ## analyzer.js lives in output-lies.github.io, not a derivative-maker
         ## component, so there is nothing under --repo-root to point at; it is
         ## resolved from OUTPUT_LIES_REPO in the ambient environment instead.
         wire_env=()
         wire_args=()
         ;;
      website)
         ## the Pages sites live in their own repos, not a derivative-maker
         ## component; the suite resolves each from OUTPUT_LIES_REPO /
         ## SECURE_TERMINAL_SITE_REPO / ORG_AI_ASSISTED_REPO in the ambient
         ## environment (or a private-sources default) instead.
         wire_env=()
         wire_args=()
         ;;
      secure-terminal)
         ## secure_terminal lives in its own repo (a --component checkout), not a
         ## derivative-maker packages/ subpath; point the suite at it via
         ## SECURE_TERMINAL_REPO resolved from the component root.
         wire_env=( "SECURE_TERMINAL_REPO=$( pkg_dir secure-terminal )" )
         ## The live-widget fuzzer's cost per iteration climbs as the widget's
         ## retained output grows toward its re-render cap, so its 6000-iteration
         ## default runs for tens of minutes -- past timeout_fuzz, i.e. a
         ## guaranteed TIMEOUT verdict rather than a fuzz run. Bound it to a
         ## count that fits the budget (measured ~130s). A deep run stays
         ## available by hand: secure-terminal-tests-fuzz-gui --iterations N.
         if [ "${suite}" = 'secure-terminal-tests-fuzz-gui' ]; then
            wire_args=( '--iterations' '1200' )
         fi
         ;;
      terminal-poc-corpus)
         ## The corpus harness drives secure-terminal, so it needs BOTH repos.
         ## Neither is a derivative-maker packages/ subpath: secure-terminal is a
         ## --component checkout (pkg_dir), and terminal-poc-corpus resolves from
         ## TERMINAL_POC_CORPUS_REPO in the ambient environment (or a
         ## private-sources / sibling default in the entrypoint).
         wire_env=( "SECURE_TERMINAL_REPO=$( pkg_dir secure-terminal )" )
         ;;
      terminal-resilience)
         ## The opt-in resilience test drives secure-terminal-cli; point it at the
         ## secure-terminal component checkout.
         wire_env=( "SECURE_TERMINAL_REPO=$( pkg_dir secure-terminal )" )
         ;;
      *)
         printf '%s\n' "dist-ai-tests-all: no wiring for suite ${suite}" >&2
         return 1
         ;;
   esac
}

## Map a suite entrypoint to the standalone component (repo) that ships the
## code it tests. Mirrors the base-name grouping in wire(); used by --component
## to restrict the run to one repo's suites. An unrecognized suite yields the
## empty string (matches no component).
suite_component() {
   local base="${1%%-tests*}"
   case "${base}" in
      check-ref-commits-for-unicode|grep-find-unicode-wrapper|unicode-show|stcat-family|stdisplay|strip-markup|sanitize-string|lockfile|git-meld|onion-time-pre-script)
         printf '%s' 'helper-scripts'
         ;;
      developer-meta-files|github-org-tools|dm-virtualbox-wiki-links)
         printf '%s' 'developer-meta-files'
         ;;
      dm-help-steps|dm-reprepro-tracking|dm-reproducible-build|dm-grub-smbios)
         printf '%s' 'derivative-maker'
         ;;
      private-ai-config)
         printf '%s' 'private-ai-config'
         ;;
      dist-ai-registry)
         printf '%s' 'dist-ai'
         ;;
      onion-grater)
         printf '%s' 'onion-grater'
         ;;
      privleap)
         printf '%s' 'privleap'
         ;;
      pyte)
         printf '%s' 'pyte'
         ;;
      genmkfile)
         printf '%s' 'genmkfile'
         ;;
      msgcollector)
         printf '%s' 'msgcollector'
         ;;
      tb-updater)
         printf '%s' 'tb-updater'
         ;;
      open-link-confirmation)
         printf '%s' 'open-link-confirmation'
         ;;
      sdwdate-gui)
         printf '%s' 'sdwdate-gui'
         ;;
      sdwdate|sdwdate-onion-tester)
         printf '%s' 'sdwdate'
         ;;
      setup-wizard-dist)
         printf '%s' 'setup-wizard-dist'
         ;;
      secure-terminal)
         printf '%s' 'secure-terminal'
         ;;
      terminal-resilience|terminal-poc-corpus)
         printf '%s' 'secure-terminal'
         ;;
      systemcheck)
         printf '%s' 'systemcheck'
         ;;
      tor-control-panel)
         printf '%s' 'tor-control-panel'
         ;;
   esac
}

emit() {
   local line="$1"
   printf '%s\n' "${line}"
   if [ -n "${progress_file}" ]; then
      printf '%s\n' "${line}" >> "${progress_file}"
   fi
}

pass_count=0
fail_count=0
skip_count=0

## STANDING POLICY: a skipped test must NOT produce a green exit 0 unless the skip
## was specifically authorized. A suite that exits 77 because its target could not
## be resolved looks identical, in a summary line, to a suite that ran and passed --
## which is how terminal-poc-corpus-tests reported SKIP in CI for weeks while the
## gate read as wired. So an UNAUTHORIZED skip fails the run.
##
## Authorized means named in --allow-skip (which the CI wrapper fills from the
## caller's .github/dm-consumer.yml), i.e. a human decided this suite may be absent
## here. Do not authorize a suite to make a red run green; fix the wiring.
##
## Strictness applies when a --component filter is in force -- the per-repo CI entry
## point, where every suite selected is supposed to have its target provided. A bare
## developer run selects the whole registry, most of which has no checkout on any one
## machine, so it stays lenient (and says so in the summary).
skip_is_fatal() {
   local suite="$1"
   local allowed
   [ "${strict_skips}" = 'true' ] || return 1
   for allowed in "${allow_skip_suites[@]}"; do
      [ "${allowed}" = "${suite}" ] && return 1
   done
   return 0
}

run_suite() {
   local suite="$1" category="$2" tmo="$3"
   local entry="${mydir}/${suite}"
   if [ ! -x "${entry}" ]; then
      ## MISSING is never tolerated: the entrypoint is shipped by THIS repo, so its
      ## absence is a packaging bug, not an environment fact. See skip_is_fatal.
      emit "$( printf '%-38s %-12s MISSING' "${suite}" "[${category}]" )"
      if [ "${strict_skips}" = 'true' ]; then
         fail_count=$(( fail_count + 1 ))
      else
         skip_count=$(( skip_count + 1 ))
      fi
      return 0
   fi
   wire "${suite}"
   local rc=0
   ## --kill-after: a suite that blocks SIGTERM would otherwise never yield the
   ## 124 TIMEOUT verdict and the whole run would wedge with no verdict at all.
   timeout --kill-after=30s "${tmo}" env "${wire_env[@]}" "${entry}" "${wire_args[@]}" \
      >"${log_dir}/dist-ai-tests-all.${suite}.log" 2>&1 || rc=$?
   local verdict log_line
   case "${rc}" in
      0)
         verdict="PASS"
         pass_count=$(( pass_count + 1 ))
         ;;
      77)
         if skip_is_fatal "${suite}"; then
            verdict="SKIP-UNAUTHORIZED"
            fail_count=$(( fail_count + 1 ))
         else
            verdict="SKIP"
            skip_count=$(( skip_count + 1 ))
         fi
         ;;
      124)
         verdict="TIMEOUT"
         fail_count=$(( fail_count + 1 ))
         ;;
      *)
         verdict="FAIL(${rc})"
         fail_count=$(( fail_count + 1 ))
         ;;
   esac
   emit "$( printf '%-38s %-12s %s' "${suite}" "[${category}]" "${verdict}" )"
   ## Surface the failing suite's captured output inline: the per-suite log
   ## lives in /tmp, which CI discards, so a bare FAIL verdict is not
   ## actionable. Echo it on FAIL / TIMEOUT (not on PASS / SKIP).
   ##
   ## A SKIP-UNAUTHORIZED counts as a failure, so it needs its log too: the
   ## reason -- which checkout or dependency was absent -- is only in that file,
   ## and without it the operator sees a bare verdict and cannot act. An
   ## ordinary SKIP stays quiet.
   case "${rc}" in
      0)
         ;;
      77)
         if skip_is_fatal "${suite}"; then
            emit "---- ${suite}: begin captured output (${verdict}) ----"
            while IFS= read -r log_line; do
               emit "${log_line}"
            done < "${log_dir}/dist-ai-tests-all.${suite}.log"
            emit "---- ${suite}: end captured output ----"
         fi
         ;;
      *)
         emit "---- ${suite}: begin captured output (${verdict}) ----"
         while IFS= read -r log_line; do
            emit "${log_line}"
         done < "${log_dir}/dist-ai-tests-all.${suite}.log"
         emit "---- ${suite}: end captured output ----"
         ;;
   esac
}

## Captured before the parse loop shifts them away, so the sandbox gate can echo
## the exact invocation back in its "run it this way instead" hint.
orig_args=( "$@" )

## Every value-taking option needs an arity check. Reading $2 bare dies with
## '$2: unbound variable' under nounset -- an internal bash error a caller cannot
## tell from a suite failure, where the rest of this script reports a usage error
## as exit 2.
require_value() {
   if [ "$#" -lt 2 ] || [ -z "$2" ]; then
      ## Emptiness matters as much as arity: '--component ""' (trivially produced
      ## by CI as --component "${{ matrix.component }}" with an unset var) skipped
      ## the component validation AND the filter AND left strict_skips false, so
      ## the whole registry ran leniently, nearly everything exited 77, and the
      ## run reported exit 0 green while the operator believed one component had
      ## been gated strictly.
      printf '%s\n' "dist-ai-tests-all: $1 requires a non-empty value" >&2
      exit 2
   fi
}

while [ "$#" -gt 0 ]; do
   case "$1" in
      --core)
         run_core="true"
         ;;
      --fuzz)
         run_fuzz="true"
         ;;
      --e2e)
         run_e2e="true"
         ;;
      --integration)
         run_integration="true"
         ;;
      --all)
         run_core="true"
         run_fuzz="true"
         run_e2e="true"
         run_integration="true"
         ;;
      --repo-root)
         require_value "$@"
         repo_root="$2"
         shift
         ;;
      --component)
         require_value "$@"
         component="$2"
         shift
         ;;
      --component-root)
         require_value "$@"
         component_root="$2"
         shift
         ;;
      --helper-scripts-root)
         require_value "$@"
         helper_scripts_root="$2"
         shift
         ;;
      --skip)
         require_value "$@"
         skip_suites+=( "$2" )
         shift
         ;;
      --allow-skip)
         require_value "$@"
         allow_skip_suites+=( "$2" )
         shift
         ;;
      --progress)
         require_value "$@"
         progress_file="$2"
         shift
         ;;
      --timeout-core)
         require_value "$@"
         timeout_core="$2"
         shift
         ;;
      --timeout-fuzz)
         require_value "$@"
         timeout_fuzz="$2"
         shift
         ;;
      --timeout-heavy)
         require_value "$@"
         timeout_heavy="$2"
         shift
         ;;
      --list)
         list_only="true"
         ;;
      --help|-h)
         usage
         exit 0
         ;;
      *)
         printf '%s\n' "dist-ai-tests-all: unknown option: $1" >&2
         exit 2
         ;;
   esac
   shift
done

## Default: core only.
if [ "${run_core}" = "false" ] && [ "${run_fuzz}" = "false" ] \
   && [ "${run_e2e}" = "false" ] && [ "${run_integration}" = "false" ]; then
   run_core="true"
fi

if [ -n "${repo_root}" ] && [ ! -d "${repo_root}" ]; then
   printf '%s\n' "dist-ai-tests-all: --repo-root not a directory: ${repo_root}" >&2
   exit 2
fi

## Validate --component against what suite_component() actually maps, rather
## than a hand-kept second list. A duplicated allowlist silently rejects a
## correctly registered component the moment the two drift, which is exactly
## what happened to private-ai-config.
if [ -n "${component}" ]; then
   component_known='false'
   for known_suite in "${core_suites[@]}" "${fuzz_suites[@]}" \
      "${e2e_suites[@]}" "${integration_suites[@]}"; do
      if [ "$( suite_component "${known_suite}" )" = "${component}" ]; then
         component_known='true'
         break
      fi
   done
   if [ "${component_known}" = 'false' ]; then
      known_list=''
      for known_suite in "${core_suites[@]}" "${fuzz_suites[@]}" \
         "${e2e_suites[@]}" "${integration_suites[@]}"; do
         known_component="$( suite_component "${known_suite}" )"
         [ -n "${known_component}" ] || continue
         case " ${known_list}" in
            *" ${known_component} "*)
               ;;
            *)
               known_list="${known_list}${known_component} "
               ;;
         esac
      done
      printf '%s\n' "dist-ai-tests-all: unknown --component: ${component}" >&2
      printf '%s\n' "dist-ai-tests-all: known components: ${known_list}" >&2
      exit 2
   fi
fi

## See skip_is_fatal: strict only under a --component filter, where every selected
## suite is supposed to have its target provided.
strict_skips='false'
if [ -n "${component}" ]; then
   strict_skips='true'
fi

if [ -n "${component_root}" ]; then
   if [ -z "${component}" ]; then
      printf '%s\n' 'dist-ai-tests-all: --component-root requires --component' >&2
      exit 2
   fi
   if [ ! -d "${component_root}" ]; then
      printf '%s\n' "dist-ai-tests-all: --component-root not a directory: ${component_root}" >&2
      exit 2
   fi
fi

if [ -n "${helper_scripts_root}" ] && [ ! -d "${helper_scripts_root}" ]; then
   printf '%s\n' "dist-ai-tests-all: --helper-scripts-root not a directory: ${helper_scripts_root}" >&2
   exit 2
fi

selected=()
[ "${run_core}" = "true" ]        && selected+=( "${core_suites[@]/#/core:}" )
[ "${run_fuzz}" = "true" ]        && selected+=( "${fuzz_suites[@]/#/fuzz:}" )
[ "${run_e2e}" = "true" ]         && selected+=( "${e2e_suites[@]/#/e2e:}" )
[ "${run_integration}" = "true" ] && selected+=( "${integration_suites[@]/#/integration:}" )

## --component: keep only the suites owned by that component.
if [ -n "${component}" ]; then
   filtered=()
   for item in "${selected[@]}"; do
      if [ "$( suite_component "${item#*:}" )" = "${component}" ]; then
         filtered+=( "${item}" )
      fi
   done
   selected=( "${filtered[@]}" )
fi

## --skip: drop named suite entrypoints (e.g. one temporarily broken / pending a
## merge) so the rest of a component's suites can still gate PRs.
if [ "${#skip_suites[@]}" -gt 0 ]; then
   filtered=()
   for item in "${selected[@]}"; do
      suite="${item#*:}"
      skip_this="false"
      for skip_name in "${skip_suites[@]}"; do
         if [ "${suite}" = "${skip_name}" ]; then
            skip_this="true"
            break
         fi
      done
      if [ "${skip_this}" = "false" ]; then
         filtered+=( "${item}" )
      else
         ## Announce it. A dropped suite that emits no line and no counter makes
         ## the summary byte-identical in shape to a full green run, so two
         ## PR-gating suites could be removed invisibly.
         emit "$( printf '%-38s %-12s %s' "${suite}" "[${item%%:*}]" 'SKIPPED-BY-REQUEST' )"
         requested_skip_count=$(( requested_skip_count + 1 ))
      fi
   done
   selected=( "${filtered[@]}" )
fi

if [ "${list_only}" = "true" ]; then
   ## Guard the empty case: 'printf %s\\n' with a zero-length array still prints
   ## the format once, so a mapfile-based consumer got one bogus empty suite name
   ## and a 'wc -l' saw 1 rather than 0.
   if [ "${#selected[@]}" -eq 0 ]; then
      printf '%s\n' 'dist-ai-tests-all: no suite matched this selection' >&2
      exit 2
   fi
   printf '%s\n' "${selected[@]}"
   exit 0
fi

## Extra-safety gate: OUTSIDE GitHub CI, dist-ai tests must run INSIDE the sandbox
## VM, never directly on a workstation -- a suite may mount, remove files, or need
## root, and the sandbox contains the blast radius. Enforced HERE in code, not left
## to operator discipline. Exempt: GitHub CI (ephemeral, isolated runners) and one
## documented override env var. (--list already exited above, so listing is free.)
enforce_sandbox_only() {
   [ "${GITHUB_ACTIONS:-}" = "true" ] && return 0     # GitHub Actions runner
   [ "${CI:-}" = "true" ] && return 0                 # generic CI (also set by GitHub)
   [ "${DIST_AI_IN_SANDBOX:-}" = "1" ] && return 0    # already routed into the sandbox
   if [ "${DIST_AI_ALLOW_HOST_TESTS:-}" = "1" ]; then
      printf '%s\n' 'dist-ai-tests-all: WARNING: DIST_AI_ALLOW_HOST_TESTS=1 -- running on the host; sandbox safety gate bypassed.' >&2
      return 0
   fi
   {
      printf '%s\n' \
         'dist-ai-tests-all: refusing to run on the host for safety.' \
         '  Outside GitHub CI, dist-ai tests must run inside the sandbox VM (a' \
         '  suite may mount, remove files, or need root). Run them in the sandbox:' \
         "    sandbox-run --dir . -- env DIST_AI_IN_SANDBOX=1 dist-ai-tests-all ${orig_args[*]:-}" \
         '  Or, to deliberately run on THIS host, set DIST_AI_ALLOW_HOST_TESTS=1.'
   } >&2
   exit 3
}
enforce_sandbox_only

emit "== dist-ai-tests-all: $( date --utc '+%Y-%m-%dT%H:%M:%SZ' ) =="
[ -n "${repo_root}" ] && emit "== repo-root: ${repo_root} =="

for item in "${selected[@]}"; do
   category="${item%%:*}"
   suite="${item#*:}"
   case "${category}" in
      core)
         run_suite "${suite}" "${category}" "${timeout_core}"
         ;;
      fuzz)
         run_suite "${suite}" "${category}" "${timeout_fuzz}"
         ;;
      e2e|integration)
         run_suite "${suite}" "${category}" "${timeout_heavy}"
         ;;
   esac
done

if [ "${strict_skips}" = 'true' ]; then
   emit "== summary: ${pass_count} pass, ${fail_count} fail, ${skip_count} authorized skip, ${requested_skip_count} skipped by request =="
else
   emit "== summary: ${pass_count} pass, ${fail_count} fail, ${skip_count} skip/missing, ${requested_skip_count} skipped by request (skips not fatal: no --component filter) =="
fi
emit "== per-suite output: ${log_dir}/dist-ai-tests-all.<suite>.log (removed on exit) =="

## Selecting NOTHING is not a pass. --component validates against the union of
## all four registries, so a component that owns suites in one category but none
## in the selected one (e.g. '--component pyte --e2e') emptied the dispatch loop
## and still exited 0 with '0 pass, 0 fail' -- a CI matrix running each category
## per component reported green for the categories it never covered. Same
## STANDING POLICY as an unauthorized skip: a run that asserted nothing must not
## look like a run that passed.
if [ "${#selected[@]}" -eq 0 ]; then
   emit "== no suite matched this selection -- nothing ran, which is not a pass =="
   exit 2
fi

[ "${fail_count}" -eq 0 ]
