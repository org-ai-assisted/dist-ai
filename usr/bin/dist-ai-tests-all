#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## Orchestrator: run the dist-ai regression/fuzz/e2e/integration suites,
## aggregate PASS / FAIL / SKIP / TIMEOUT, and exit non-zero if any FAILed.
##
## Run 'dist-ai-tests-all --help' for full usage (see usage() below).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

mydir="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" && pwd )"

[ -v TMP ] || TMP=/tmp
## Per-suite logs go in a PRIVATE directory, not a predictable "${TMP}/<name>.log".
## The old path was guessable and opened with truncation, so any local user could
## pre-plant a symlink (ln -s ~/.bashrc /tmp/dist-ai-tests-all.privleap-tests.log)
## and have it truncated and overwritten by suite output -- and the suites are
## documented as possibly needing root.
log_dir="$( mktemp --directory -- "${TMP}/dist-ai-tests-all.XXXXXX" )"
cleanup_log_dir() {
   if [ -n "${log_dir:-}" ] && [ -d "${log_dir}" ]; then
      ## safe-rm ships with private-ai-config and is absent on a CI runner, where
      ## this call runs as the EXIT trap: its 127 became the JOB's exit status, so
      ## a green suite was reported as a hard failure with the real result
      ## scrolled above it. Tolerate the failure rather than falling back to rm
      ## (never rm) -- the target is our own mktemp log dir, so leaving it behind
      ## on a machine without safe-rm costs nothing and cleaning it up is not
      ## worth reporting a passing run as failed.
      safe-rm --recursive --force -- "${log_dir}" || true
   fi
   return 0
}
trap cleanup_log_dir EXIT
repo_root=""
component=""
component_root=""
helper_scripts_root=""
skip_suites=()
allow_skip_suites=()
requested_skip_count=0
progress_file=""
run_core="false"
run_fuzz="false"
run_e2e="false"
run_integration="false"
list_only="false"
timeout_core=300
timeout_fuzz=600
timeout_heavy=600

## Suite registries. Each name is an entrypoint in the same bin dir as this
## script. mediawiki-dom-snapshot is a capture tool, not a pass/fail test, so
## it is deliberately excluded.
core_suites=(
