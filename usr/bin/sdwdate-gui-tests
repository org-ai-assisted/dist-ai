#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## Runs the sdwdate-gui regression test suite. Works both when installed
## (tests under /usr/share/sdwdate-gui-tests) and when run straight from a
## git checkout (tests under usr/share/sdwdate-gui-tests relative to this
## script). Driven through run-unittest.py so an all-skipped run (PyQt5 or the
## subject module absent) surfaces as SKIP (78) instead of a green PASS.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## The Qt offscreen platform plugin lets the PyQt5 test suite run without an
## X server or a system tray.
export QT_QPA_PLATFORM="offscreen"

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/sdwdate-gui-tests" ]; then
  tests_dir="${script_dir}/../share/sdwdate-gui-tests"
else
  tests_dir='/usr/share/sdwdate-gui-tests'
fi

run_unittest="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")/../share/dist-ai-tests-common/run-unittest.py"
[ -r "${run_unittest}" ] || run_unittest='/usr/share/dist-ai-tests-common/run-unittest.py'

## run-unittest.py maps all-skipped (78) / nothing-collected (77) to a surfaced
## SKIP so a run where nothing actually executed cannot read as a green PASS. Its
## exit code is the suite's -- it is the last command, so errexit propagates it.
## "$@" is forwarded so --help and -v work; an unsupported arg fails loudly there
## rather than being silently ignored (the orchestrator calls this with no args).
"${run_unittest}" --start-directory "${tests_dir}" --pattern 'test_*.py' "$@"
