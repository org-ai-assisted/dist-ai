#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Runs msgcollector's core property tests (hypothesis) for the CLI link
## rewriter via pytest, then every *_test.sh shell case in the same directory.
## Works installed (/usr/share/msgcollector-tests) or from a git checkout. The
## msgcollector script under test is resolved by msgcollector_testlib
## (MSGCOLLECTOR_REPO=<checkout> else the installed script); the shell cases
## read MSGCOLLECTOR_REPO directly.
##
## Both lanes run even when the first fails, so one broken lane cannot hide the
## other. A shell case that cannot resolve its subject exits 77 and is counted
## as SKIPPED, never folded into a pass.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/msgcollector-tests" ]; then
   tests_dir="${script_dir}/../share/msgcollector-tests"
else
   tests_dir='/usr/share/msgcollector-tests'
fi

## The GUI helpers under test (generic_gui_message.py, msgdispatcher_dispatch_x.py,
## ...) import helper-scripts' guimessages module. In a checkout run, put that
## repo's modules on PYTHONPATH so both lanes (pytest and the shell cases that
## spawn those helpers) can import it; an installed run uses the system module on
## the default path.
helper_scripts_root=""
if [ -n "${HELPER_SCRIPTS_REPO:-}" ]; then
   helper_scripts_root="${HELPER_SCRIPTS_REPO}"
elif [ -n "${HELPER_SCRIPTS_PATH:-}" ]; then
   helper_scripts_root="${HELPER_SCRIPTS_PATH}"
fi
if [ -n "${helper_scripts_root}" ] \
   && [ -d "${helper_scripts_root%/}/usr/lib/python3/dist-packages" ]; then
   PYTHONPATH="${helper_scripts_root%/}/usr/lib/python3/dist-packages${PYTHONPATH:+:${PYTHONPATH}}"
   export PYTHONPATH
fi

rc=0
python3 -m pytest --import-mode=importlib -q "${tests_dir}" "$@" || rc=$?
## pytest exit 5 = no tests collected. That is a broken environment, not an
## absence: python3-hypothesis is in this consumer's CI apt list, so the only
## way to collect nothing is a suite that is not being run at all. Reporting
## 77 turned that into a green lane testing nothing.
if [ "${rc}" = "5" ]; then
   printf '%s\n' 'FAIL: pytest collected no tests; the suite is not being run.' >&2
   exit 1
fi

shopt -s nullglob
shell_cases=( "${tests_dir}"/*_test.sh )
shopt -u nullglob

shell_failed=0
shell_skipped=0
for shell_case in "${shell_cases[@]}"; do
   printf '%s\n' "== $(basename -- "${shell_case}") =="
   case_rc=0
   "${shell_case}" || case_rc=$?
   if [ "${case_rc}" -eq 77 ]; then
      shell_skipped=$(( shell_skipped + 1 ))
   elif [ "${case_rc}" -ne 0 ]; then
      shell_failed=$(( shell_failed + 1 ))
      rc=1
   fi
done

if [ "${#shell_cases[@]}" -gt 0 ]; then
   printf '%s\n' ""
   printf '%s\n' "${#shell_cases[@]} shell case(s), ${shell_failed} failed, ${shell_skipped} skipped"
fi

exit "${rc}"
