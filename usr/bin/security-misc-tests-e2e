#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Runs the dist-ai END-TO-END tests via pytest: the hard-gating scan of the
## live production SSH servers (kicksecure.com, whonix.org) against the hardened
## ssh-audit server policy bundled in the sibling security-misc-tests suite.
## Network egress to port 22 is required; this is an --e2e-category suite, not
## run by the default --core PR gate. Works installed
## (/usr/share/security-misc-tests-e2e) or from a git checkout. No security-misc
## checkout is needed -- the policy travels with dist-ai.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/security-misc-tests-e2e" ]; then
   tests_dir="${script_dir}/../share/security-misc-tests-e2e"
else
   tests_dir='/usr/share/security-misc-tests-e2e'
fi

rc=0
python3 -m pytest --import-mode=importlib -q "${tests_dir}" "$@" || rc=$?
if [ "${rc}" = "5" ]; then
   printf '%s\n' 'FAIL: pytest collected no tests; the suite is not being run.' >&2
   rc=1
fi

exit "${rc}"
