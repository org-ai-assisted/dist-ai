#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Runs security-misc's dist-ai END-TO-END tests via pytest: the hard-gating
## scan of the live production SSH servers (kicksecure.com, whonix.org) against
## the shipped security-misc ssh-audit server policy. Network egress to port 22
## is required; this is an --e2e-category suite, not run by the default --core
## PR gate. The security-misc checkout is resolved by SECURITY_MISC_REPO (wired
## by dist-ai-tests-all). Works installed (/usr/share/security-misc-tests-e2e)
## or from a git checkout.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/security-misc-tests-e2e" ]; then
   tests_dir="${script_dir}/../share/security-misc-tests-e2e"
else
   tests_dir='/usr/share/security-misc-tests-e2e'
fi

## Resolve the subject: security-misc's ssh-audit server policy + tool, from
## the checkout (SECURITY_MISC_REPO) or the installed package. Absent both, the
## production scan cannot run -- an OPTIONAL target, so skip cleanly rather than
## fail, matching the registry's unresolved-target contract.
subject_present="false"
if [ -n "${SECURITY_MISC_REPO:-}" ] \
   && [ -e "${SECURITY_MISC_REPO}/usr/share/security-misc/ssh-audit/server.policy#security-misc-shared" ]; then
   subject_present="true"
elif [ -e "/usr/share/security-misc/ssh-audit/server.policy" ]; then
   subject_present="true"
fi
if [ "${subject_present}" = "false" ]; then
   printf '%s\n' "${0##*/}: SKIP: security-misc not present (no SECURITY_MISC_REPO checkout, not installed)" >&2
   ## style-ok: allow-skip: security-misc not checked out or installed -- optional target
   exit 77
fi

rc=0
python3 -m pytest --import-mode=importlib -q "${tests_dir}" "$@" || rc=$?
if [ "${rc}" = "5" ]; then
   printf '%s\n' 'FAIL: pytest collected no tests; the suite is not being run.' >&2
   rc=1
fi

exit "${rc}"
