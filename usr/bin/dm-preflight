#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Run every cheap check that can invalidate a derivative-maker build, in
## ascending cost, and stop at the first that fails.
##
## WHY THIS IS A TOOL AND NOT A CHECKLIST: each of these has already been skipped
## once and cost a build cycle. A rule someone has to remember does not run; a
## command does. The one that hurt most: a parent commit pushed with the
## developer-meta-files changes still sitting UNCOMMITTED in the submodule, so CI
## built a tree that did not contain the fix under test and three unrelated tests
## failed against the stale pinned copy.
##
## Usage:
##   dm-preflight [--dir <derivative-maker checkout>] [--quick]
##
## --quick  skip the test suites (the slowest stage); the git-state checks alone.
##
## Exit: 0 everything passed | 1 a check failed | 2 usage / not a dm checkout.
##
## Ordering is the point. A submodule whose work is uncommitted invalidates
## everything downstream, so it is checked before the static gate, which is
## checked before the suites.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

source_dir=""
quick=false

while [ "$#" -gt 0 ]; do
   case "$1" in
      --dir)
         [ "$#" -ge 2 ] || { printf '%s\n' "${0##*/}: --dir requires a value." >&2 ; exit 2 ; }
         source_dir="$2"
         shift 2
         ;;
      --quick)
         quick=true
         shift
         ;;
      -h|--help)
         grep '^##' -- "${BASH_SOURCE[0]}" | sed 's/^## \{0,1\}//'
         exit 0
         ;;
      *)
         printf '%s\n' "${0##*/}: unknown argument: '$1'" >&2
         exit 2
         ;;
   esac
done

[ -n "${source_dir}" ] || source_dir="${PWD}"
if [ ! -d "${source_dir}/build-steps.d" ] || [ ! -d "${source_dir}/help-steps" ]; then
   printf '%s\n' "${0##*/}: '${source_dir}' is not a derivative-maker checkout (no build-steps.d + help-steps)." >&2
   exit 2
fi
source_dir="$( cd -- "${source_dir}" && pwd )"

## Directory markers alone are not a checkout: every check below drives 'git -C',
## which would then fail one confusing message at a time instead of once, here.
## The toplevel must also BE this directory -- a subdirectory of some other repo
## carrying those two names would otherwise pass and be checked against the wrong
## worktree.
worktree_top="$( git -C "${source_dir}" rev-parse --show-toplevel 2>/dev/null || true )"
if [ -z "${worktree_top}" ]; then
   printf '%s\n' "${0##*/}: '${source_dir}' is not inside a git worktree; every check below needs one." >&2
   exit 2
fi
if [ ! "$( readlink -f -- "${worktree_top}" )" = "$( readlink -f -- "${source_dir}" )" ]; then
   printf '%s\n' "${0##*/}: '${source_dir}' is not the worktree ROOT (that is '${worktree_top}'); the checks would read the wrong repository." >&2
   exit 2
fi

failures=0
stage() {
   printf '\n== %s ==\n' "$*"
}
ok() {
   printf '   ok: %s\n' "$*"
}
bad() {
   printf '   FAIL: %s\n' "$*" >&2
   failures=$(( failures + 1 ))
}

## --- 1. submodules with uncommitted work --------------------------------------
## The parent records a POINTER. Work left uncommitted inside a submodule is
## invisible to the parent's commit and therefore to CI, which then builds a tree
## that does not contain it.
stage "submodules: uncommitted work"
## 'git submodule foreach' visits only INITIALIZED submodules, so one that was
## never checked out is invisible to the loop below -- it would report "no
## submodule carries uncommitted changes" for a tree where a whole submodule is
## absent. Name those separately rather than letting them pass silently.
uninitialized_submodules="$( git -C "${source_dir}" submodule status --recursive 2>/dev/null \
   | sed -n -e 's/^-[0-9a-f]* //p' | cut -d' ' -f1 || true )"
if [ -n "${uninitialized_submodules}" ]; then
   printf '%s\n' "   NOTE: not checked out, so NOT inspected below (run 'git submodule update --init --recursive' for full coverage):" >&2
   printf '%s\n' "${uninitialized_submodules}" | sed 's/^/          /' >&2
fi
dirty_submodules="$( git -C "${source_dir}" submodule --quiet foreach --recursive \
   'if [ -n "$(git status --porcelain)" ]; then printf "%s\n" "${sm_path}"; fi' 2>/dev/null || true )"
if [ -z "${dirty_submodules}" ]; then
   ok "no initialized submodule carries uncommitted changes"
else
   bad "these submodules have UNCOMMITTED changes; a parent commit will not carry them:"
   printf '%s\n' "${dirty_submodules}" | sed 's/^/          /' >&2
fi

## --- 2. gitlink vs the submodule's own HEAD -----------------------------------
## A submodule committed and pushed, but the parent's pointer never bumped, means
## CI checks out the OLD commit. REPORTED, not failed: a submodule sitting ahead
## of its pin is the NORMAL state while work is in progress on its branch, and
## ci/checkout-fork-submodule-branches puts it there deliberately. Only the
## author knows whether the change under test lives in one of these. Crying wolf
## on every one of thirty submodules would train everyone to ignore the check
## that matters, which is the uncommitted one above.
stage "submodules: ahead of the pin (report only)"
lagging_gitlinks="$( git -C "${source_dir}" submodule --quiet foreach --recursive \
   'pinned="$(git -C "${toplevel}" ls-tree HEAD -- "${sm_path}" | { read -r _ _ sha _ ; printf "%s" "${sha}" ; })"
    head_sha="$(git rev-parse HEAD)"
    if [ -n "${pinned}" ] && [ "${pinned}" != "${head_sha}" ]; then
       printf "%s (pinned %.12s, HEAD %.12s)\n" "${displaypath}" "${pinned}" "${head_sha}"
    fi' 2>/dev/null || true )"
if [ -z "${lagging_gitlinks}" ]; then
   ok "every gitlink matches its submodule's HEAD"
else
   printf '%s\n' "   NOTE: these submodules are AHEAD of the pin. If your change is in one," \
      "         the parent will not carry it until the gitlink is bumped:" >&2
   printf '%s\n' "${lagging_gitlinks}" | sed 's/^/          /' >&2
fi

## --- 3. can CI actually FETCH every pin? --------------------------------------
## The one gitlink property that breaks a build outright: a pin CI cannot get.
## A submodule commit that exists only in a local clone -- committed but never
## pushed, or pushed to a different remote -- leaves 'git submodule update
## --init' failing in the job, long after the runner was allocated.
##
## "Contained in a remote branch" is the test, not "the remote has this ref":
## servers usually refuse to serve an arbitrary SHA, so reachability from some
## published branch is what makes it fetchable.
##
## This is NOT dm-gitlink-upstream-check, which asks a stricter question (is the
## pin reachable on the CANONICAL upstream master) appropriate to push-to-master.
## On a feature branch a fork-only pin is legitimate; unfetchable never is.
stage "submodules: every pin is fetchable by CI"
## A submodule whose only remote is a LOCAL PATH (a scratch clone of another
## checkout) cannot answer this question: its remote-tracking branches are
## whatever that path had, not what CI would fetch. Report those as UNVERIFIED
## rather than failing them -- a check that cries wolf on every scratch clone is
## a check everyone learns to ignore.
pin_report="$( git -C "${source_dir}" submodule --quiet foreach --recursive \
   'pinned="$(git -C "${toplevel}" ls-tree HEAD -- "${sm_path}" | { read -r _ _ sha _ ; printf "%s" "${sha}" ; })"
    [ -n "${pinned}" ] || exit 0
    network_remote=false
    for remote_name in $(git remote); do
       case "$(git remote get-url "${remote_name}" 2>/dev/null)" in
          *://*|*@*:*)
             network_remote=true
             ;;
       esac
    done
    if [ "${network_remote}" = "false" ]; then
       printf "UNVERIFIED %s (no network remote in this clone)\n" "${displaypath}"
       exit 0
    fi
    if ! git cat-file -e "${pinned}^{commit}" 2>/dev/null; then
       printf "MISSING %s (pinned %.12s: not present locally)\n" "${displaypath}" "${pinned}"
       exit 0
    fi
    if [ -z "$(git branch --remotes --contains "${pinned}" 2>/dev/null)" ]; then
       printf "UNFETCHABLE %s (pinned %.12s: on no remote branch)\n" "${displaypath}" "${pinned}"
       exit 0
    fi
    ## "Reachable from SOME remote in this clone" is not the question a fresh
    ## checkout asks. `git clone --recurse-submodules` uses the URL in
    ## .gitmodules, not whatever extra remotes a working tree happens to carry.
    ## A pin living only on a fork therefore passes the check above and still
    ## breaks a clean recursive checkout -- exactly how a fork-only
    ## grml-debootstrap pin shipped unnoticed. Ask the CONFIGURED url.
    gitmodules_url="$(git -C "${toplevel}" config -f .gitmodules --get "submodule.${name}.url" 2>/dev/null || true)"
    if [ -z "${gitmodules_url}" ]; then
       printf "NO-URL %s (no url in .gitmodules)\n" "${displaypath}"
       exit 0
    fi
    if ! git ls-remote "${gitmodules_url}" 2>/dev/null | grep -qF "${pinned}"; then
       printf "FORK-ONLY %s (pinned %.12s not advertised by %s)\n" "${displaypath}" "${pinned}" "${gitmodules_url}"
    fi' 2>/dev/null || true )"
bad_pins="$( printf '%s\n' "${pin_report}" | grep -E '^(MISSING|UNFETCHABLE) ' || true )"
## FORK-ONLY is reported LOUDLY but does not fail: on the 'ai' branch CI runs
## ci/configure-fork-mirror before submodule init, so a fork-only pin is
## legitimate THERE. It remains a fact the reader must see, because a plain
## `git clone --recurse-submodules` of the same commit will fail on it.
forkonly_pins="$( printf '%s\n' "${pin_report}" | grep -E '^FORK-ONLY ' || true )"
nourl_pins="$( printf '%s\n' "${pin_report}" | grep -E '^NO-URL ' || true )"
if [ -n "${forkonly_pins}" ]; then
   printf '%s\n' "   FORK-ONLY pins: reachable from a fork, NOT from the .gitmodules url." >&2
   printf '%s\n' "   CI rewrites urls first so its checkout works; a plain clone --recurse-submodules will NOT:" >&2
   printf '%s\n' "${forkonly_pins}" | sed 's/^/          /' >&2
fi
if [ -n "${nourl_pins}" ]; then
   printf '%s\n' "   NO url in .gitmodules for these -- fetchability cannot be established at all:" >&2
   printf '%s\n' "${nourl_pins}" | sed 's/^/          /' >&2
fi
unverified_pins="$( printf '%s\n' "${pin_report}" | grep -E '^UNVERIFIED ' || true )"
if [ -n "${unverified_pins}" ]; then
   printf '%s\n' "   NOTE: fetchability NOT established for these (no network remote to ask):" >&2
   printf '%s\n' "${unverified_pins}" | sed 's/^/          /' >&2
fi
if [ -z "${bad_pins}" ]; then
   ok "every pin that could be checked is reachable from a remote branch"
else
   bad "CI cannot fetch these pins; 'git submodule update --init' will fail in the job:"
   printf '%s\n' "${bad_pins}" | sed 's/^/          /' >&2
   printf '%s\n' "          Push the submodule branch that contains each commit." >&2
fi

## --- 3. pin freshness ---------------------------------------------------------
## Reported, not enforced, for the same reason ci/assert-submodule-not-stale
## reports for --all: most dm pins deliberately trail.
stage "submodules: pin freshness (report only)"
if [ -x "${source_dir}/ci/assert-submodule-not-stale" ]; then
   ## Capture the TOOL's status, not the grep's. Piping straight into grep made
   ## the exit status the filter's, so a freshness tool that died still produced
   ## "freshness reported above" -- a check that cannot fail.
   ## '--report-only' means a TRAILING pin exits 0; anything non-zero from it is
   ## the tool itself failing, which is not something to report as a reading.
   freshness_output=""
   freshness_rc=0
   freshness_output="$( cd -- "${source_dir}" && ./ci/assert-submodule-not-stale --all --report-only 2>&1 )" || freshness_rc="$?"
   printf '%s\n' "${freshness_output}" | grep -E 'submodule\(s\):|TRAILS' | sed 's/^/   /' || true
   if [ "${freshness_rc}" -eq 0 ]; then
      ok "freshness reported above"
   else
      bad "ci/assert-submodule-not-stale --all exited ${freshness_rc}; freshness was NOT established"
   fi
else
   printf '%s\n' "   NOTE: ci/assert-submodule-not-stale not present; freshness not checked." >&2
fi

## --- 4. the static gate -------------------------------------------------------
stage "static gate"
if ! type -P pre-push-static >/dev/null; then
   bad "pre-push-static is not on PATH; the gate cannot run and its absence is not a pass"
else
   gate_base="$( git -C "${source_dir}" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true )"
   if [ -z "${gate_base}" ]; then
      printf '%s\n' "   NOTE: no upstream tracking branch; gating the staged changeset instead." >&2
      if ( cd -- "${source_dir}" && pre-push-static --staged >/dev/null 2>&1 ); then
         ok "static gate green (staged)"
      else
         bad "static gate FAILED (staged) -- run 'pre-push-static --staged' for detail"
      fi
   elif ( cd -- "${source_dir}" && pre-push-static "${gate_base}" >/dev/null 2>&1 ); then
      ok "static gate green against ${gate_base}"
   else
      bad "static gate FAILED against ${gate_base} -- run 'pre-push-static ${gate_base}' for detail"
   fi
fi

## --- 5. the suites ------------------------------------------------------------
if [ "${quick}" = "true" ]; then
   ## Named, not silent: '--quick' means the git-state checks passed and the code
   ## was NOT exercised. Anyone reading "all checks passed" should know which
   ## checks those were.
   printf '\n== suites: NOT RUN (--quick); this says nothing about whether the code passes ==\n'
else
   stage "dist-ai suites over this checkout"
   suite_ran=false
   for suite in dm-help-steps-tests dm-grub-smbios-tests; do
      if ! type -P "${suite}" >/dev/null; then
         continue
      fi
      suite_ran=true
      if DERIVATIVE_MAKER_DIR="${source_dir}" "${suite}" >/dev/null 2>&1; then
         ok "${suite}"
      else
         bad "${suite} FAILED -- run 'DERIVATIVE_MAKER_DIR=${source_dir} ${suite}' for detail"
      fi
   done
   if [ "${suite_ran}" = "false" ]; then
      bad "no dist-ai suite is on PATH; missing tooling is a gap to fix, not a pass"
   fi
fi

if [ "${failures}" -ne 0 ]; then
   printf '%s\n' "${0##*/}: ${failures} check(s) failed. Do NOT spend a build on this tree." >&2
   exit 1
fi
printf '%s\n' "${0##*/}: all checks passed."
