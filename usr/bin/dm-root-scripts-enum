#!/usr/bin/python3 -Bsu

## Shell-invocation guard.
"exec" "bash" "-c" "printf '%s\n' '$0: ERROR: Do not execute this script with bash!' >&2; exit 1"

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

"""Enumerate the root-privileged script surface of derivative-maker + submodules.

Machine-readable inventory (JSON) of everything that executes with root
privileges, in these categories:

  maintainer-script  Debian preinst/postinst/prerm/postrm/config. dpkg runs
                     these as root. Matched by path + name, NOT by the +x bit:
                     dpkg sets the mode at build time, so a git copy need not be
                     executable to be a maintainer script.

  systemd-unit       .service units that run as root: system-scope with no
                     User= (root by default) or User=root/0. User-scope units
                     (.../systemd/user/...) and units pinned to a non-root User=
                     are EXCLUDED. Lists the Exec* program targets.

  systemd-dropin     A '<unit>.service.d/*.conf' drop-in that adds Exec*
                     programs. Its effective identity is the BASE unit's (not
                     resolved across packages), so it reports the programs +
                     any User= override; a '+'-prefixed Exec runs as root
                     regardless, captured in root_forced_exec.

  privleap-action    A privleap '[action:...]' in usr/lib/privleap/conf.d/*.conf
                     whose Command= runs as root. privleap defaults to root; an
                     action with a non-root TargetUser= is EXCLUDED (it runs as
                     that user), exactly like systemd User=.

  sudoers            etc/sudoers.d drop-ins that GRANT a command as root. Only
                     ACTIVE rules count; an all-commented file grants nothing.
                     NOPASSWD rules are flagged.

  polkit             polkit action definitions (a pkexec/helper they authorize
                     runs as root). Action ids and <defaults> are listed.

  sudo-call          Every 'sudo' invocation in a shell script anywhere in the
                     tree (all components), found via a REAL bash parser (shfmt
                     AST, dist_ai.bash_ast) -- never a regex. Reports the program
                     sudo runs and its run-as target (root unless -u sets
                     another user). HONEST SCOPE: shell scripts only; a sudo
                     called from Python/other via a library is not in the
                     bash-AST surface.

  build-chroot       derivative-maker's own chroot/pbuilder help-steps, which
                     run as root inside the build chroot.

The bash parsing is delegated whole to shfmt (dist_ai.bash_ast): command
position, quoting, here-docs and strings are the parser's job, so 'sudo' inside
a string ("run as root (sudo)"), 'sudo' as a bare argument (adduser user sudo),
and a program hidden in an expansion are all handled structurally. What remains
here is sudo's OWN option semantics (-u sets the target), applied over parsed
tokens -- not a shell parser.

REPORTS only; exits non-zero solely when it examined nothing (a zero-finding
"clean" report is the failure an empty audit hides) or shfmt is absent.

Usage:  dm-root-scripts-enum [<derivative-maker-root>]
Output: JSON on stdout.
"""

import json
import os
import re
import sys

## dist_ai.bash_ast (shfmt AST) ships beside this tool; self-locate it so the
## tool runs from a checkout with no env wiring, and when installed under /usr.
_LIB = os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
    "lib", "python3", "dist-packages")
if os.path.isdir(_LIB) and _LIB not in sys.path:
    sys.path.insert(0, _LIB)

from dist_ai import bash_ast  # noqa: E402


MAINTAINER_HOOKS = ("preinst", "postinst", "prerm", "postrm", "config")
MAINTAINER_RE = re.compile(r"(?:^|\.)(" + "|".join(MAINTAINER_HOOKS) + r")$")

## Every [Service] directive that names a program run under the unit's identity.
EXEC_KEYS = (
    "ExecStartPre", "ExecCondition", "ExecStart", "ExecStartPost",
    "ExecStop", "ExecStopPost", "ExecReload",
)
EXEC_PREFIX = "+-!@:"
TRUTHY = ("yes", "true", "1", "on")

SHELL_EXT = (".sh", ".bash", ".bsh")
SHELL_SHEBANG_RE = re.compile(r"\b(bash|sh|dash)\b")

## sudo short/long options that take a value; -u/--user sets the run-as target.
SUDO_VALUE_SHORT = frozenset("CDghpRrtTUu")
SUDO_VALUE_LONG = frozenset((
    "close-from", "chdir", "group", "host", "prompt", "chroot",
    "role", "type", "command-timeout", "other-user", "user",
))

CHROOT_SCRIPT_RE = re.compile(r"(chroot|pbuilder)", re.IGNORECASE)

## sudo's OWN 'VAR=value' env-setting syntax before the command; skip these to
## reach the real program. An expansion (contains '$' or a quote) is unresolvable.
SUDO_ENV_ASSIGN_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
EXPANSION_RE = re.compile(r"[$`\"']")


def read_text(path):
    with open(path, "r", encoding="utf-8", errors="replace") as handle:
        return handle.read()


def shebang(path):
    try:
        with open(path, "rb") as handle:
            first = handle.readline(256)
    except OSError:
        return None
    if first.startswith(b"#!"):
        return first[2:].decode("utf-8", "replace").strip()
    return None


def is_shell(abs_path, rel_path):
    if rel_path.endswith(SHELL_EXT):
        return True
    line = shebang(abs_path)
    return bool(line) and bool(SHELL_SHEBANG_RE.search(line))


def submodule_paths(dm_root):
    gitmodules = os.path.join(dm_root, ".gitmodules")
    paths = []
    if os.path.isfile(gitmodules):
        for line in read_text(gitmodules).splitlines():
            line = line.strip()
            if line.startswith("path"):
                _, _, value = line.partition("=")
                value = value.strip()
                if value:
                    paths.append(value.rstrip("/"))
    return sorted(set(paths), key=len, reverse=True)


def component_for(rel_path, submodules):
    for sub in submodules:
        if rel_path == sub or rel_path.startswith(sub + "/"):
            return os.path.basename(sub), sub
    return "derivative-maker", ""


def walk_files(dm_root, walk_errors):
    ## An unreadable directory must be LOUD, not silently skipped -- a security
    ## inventory that quietly omits a subtree reads as clean while blind to it.
    skip_dirs = {".git", ".pytest_cache", "__pycache__"}
    for dirpath, dirnames, filenames in os.walk(
            dm_root, onerror=lambda exc: walk_errors.append(str(exc))):
        dirnames[:] = [d for d in dirnames if d not in skip_dirs]
        for name in filenames:
            abs_path = os.path.join(dirpath, name)
            if os.path.islink(abs_path):
                continue
            yield abs_path, os.path.relpath(abs_path, dm_root)


## --- maintainer scripts -----------------------------------------------------


def scan_maintainer(abs_path, rel_path):
    name = os.path.basename(rel_path)
    match = MAINTAINER_RE.search(name)
    if not match:
        return None
    if "/debian/" not in ("/" + rel_path) and not rel_path.startswith("debian/"):
        return None
    return {"hook": match.group(1), "interpreter": shebang(abs_path)}


## --- systemd units ----------------------------------------------------------


def parse_service(text):
    """(runs_as_root, user_value, exec_targets) for a .service file.

    A bare 'Key=' resets ONLY that key's list (systemd semantics), so each Exec*
    key is tracked separately and merged at the end. DynamicUser= runs the unit
    under a dynamically allocated non-root UID, so it is excluded like a non-root
    User=. Exec prefixes ('+' root, '!'/'-'/'@'/':') are stripped from the path.
    """
    user_value = None
    dynamic_user = False
    exec_by_key = {key: [] for key in EXEC_KEYS}
    section = None
    for raw in text.splitlines():
        line = raw.strip()
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip().lower()
            continue
        if section != "service":
            continue
        if line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        value = value.strip()
        if key == "User":
            user_value = value if value else None
        elif key == "DynamicUser":
            dynamic_user = value.lower() in TRUTHY
        elif key in EXEC_KEYS:
            if not value:
                exec_by_key[key] = []  ## bare reset clears only this key
                continue
            program = value.split()[0].lstrip(EXEC_PREFIX)
            if program:
                exec_by_key[key].append(program)
    exec_targets = [prog for key in EXEC_KEYS for prog in exec_by_key[key]]
    user_is_root = user_value is None or user_value in ("root", "0")
    runs_as_root = user_is_root and not dynamic_user
    return runs_as_root, user_value, exec_targets


def scan_systemd(abs_path, rel_path):
    if not rel_path.endswith(".service"):
        return None
    ## User-scope units run as the user, never root: both the install path and
    ## the debhelper '<pkg>.user.service' source-name convention.
    if "/systemd/user/" in ("/" + rel_path) or rel_path.endswith(".user.service"):
        return None
    runs_as_root, user_value, exec_targets = parse_service(read_text(abs_path))
    if not runs_as_root:
        return None
    return {"scope": "system", "user": user_value or "root", "exec": exec_targets}


def scan_systemd_dropin(abs_path, rel_path):
    """A '<unit>.service.d/*.conf' drop-in that adds Exec* programs.

    HONEST SCOPE: a drop-in's effective identity is the BASE unit's (root unless
    the base or this drop-in sets a non-root User=), which lives in another
    package or in systemd itself and is not resolved here. So this reports the
    programs and any User= override for review, not a decided root verdict --
    except that an Exec* with a '+' prefix runs as root regardless of the base
    user, captured in root_forced_exec.
    """
    if "/systemd/user/" in ("/" + rel_path):
        return None
    if ".service.d/" not in rel_path or not rel_path.endswith(".conf"):
        return None
    text = read_text(abs_path)
    _runs_root, user_value, exec_targets = parse_service(text)
    forced = parse_service_forced_root(text)
    if not exec_targets:
        return None
    parent = os.path.basename(os.path.dirname(rel_path))
    base_unit = parent[:-2] if parent.endswith(".d") else parent
    return {
        "scope": "dropin",
        "base_unit": base_unit,
        "user_override": user_value,
        "exec": exec_targets,
        "root_forced_exec": forced,
    }


def parse_service_forced_root(text):
    """Exec* programs carrying a '+' prefix (run as root ignoring User=)."""
    forced = []
    section = None
    for raw in text.splitlines():
        line = raw.strip()
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip().lower()
            continue
        if section != "service" or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        if key.strip() in EXEC_KEYS and value.strip().startswith("+"):
            program = value.strip().lstrip(EXEC_PREFIX)
            if program:
                forced.append(program)
    return forced


## --- privleap ---------------------------------------------------------------


def scan_privleap(abs_path, rel_path):
    if "/privleap/conf.d/" not in ("/" + rel_path) or not rel_path.endswith(".conf"):
        return None
    actions = []
    section = None
    action_name = None
    command = None
    target_user = None

    def flush():
        if section == "action" and command is not None:
            ## No TargetUser (or root) -> the Command runs as root.
            if target_user is None or target_user in ("root", "0"):
                actions.append({"action": action_name, "command": command})

    for raw in read_text(abs_path).splitlines():
        line = raw.strip()
        if line.startswith("[") and line.endswith("]"):
            flush()
            header = line[1:-1].strip()
            if header.startswith("action:"):
                section = "action"
                action_name = header[len("action:"):]
            else:
                section = "other"
                action_name = None
            command = None
            target_user = None
            continue
        if section != "action" or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        value = value.strip()
        if key == "Command":
            command = value
        elif key == "TargetUser":
            target_user = value or None
    flush()
    if not actions:
        return None
    ## One tool entry per file carrying its root actions.
    return {"actions": actions}


## --- sudoers ----------------------------------------------------------------


SUDOERS_ALIAS = ("Cmnd_Alias", "User_Alias", "Host_Alias", "Runas_Alias")
SUDOERS_RUNAS_RE = re.compile(r"=\s*\(([^)]*)\)")
## A ' # ' comment on a rule line (a lone '#' uid like '#0' has no surrounding
## spaces, so this does not strip it).
SUDOERS_INLINE_COMMENT_RE = re.compile(r"\s#\s.*$")


def sudoers_rule_runs_as_root(rule):
    """True if a sudoers rule grants execution as root: no Runas spec (default
    root), or a spec naming root or ALL. '(sdwdate)' / '(debian-tor)' -> False."""
    match = SUDOERS_RUNAS_RE.search(rule)
    if not match:
        return True
    members = [m.strip() for m in match.group(1).split(":")[0].split(",")]
    return any(m in ("root", "ALL") for m in members)


def sudoers_commands(rule):
    """The command PATHS a rule authorizes, without their arguments. The command
    spec is the comma-separated tail; the first '/'-token of each part is the
    program, the rest are arguments."""
    _, _, tail = rule.partition("=")
    ## Drop the Runas '(...)' and the PASSWD/NOPASSWD/SETENV tags.
    tail = SUDOERS_RUNAS_RE.sub("", "=" + tail)
    tail = re.sub(r"\b(NO)?(PASSWD|SETENV|EXEC|FOLLOW|LOG_INPUT|LOG_OUTPUT):", "", tail)
    commands = []
    for part in tail.split(","):
        for tok in part.split():
            if tok.startswith("/"):
                commands.append(tok)
                break
    return commands


def scan_sudoers(abs_path, rel_path):
    if "/sudoers.d/" not in ("/" + rel_path):
        return None
    rules = []
    defaults = []
    grants_root = False
    nopasswd = False
    commands = set()
    for raw in read_text(abs_path).splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        line = SUDOERS_INLINE_COMMENT_RE.sub("", line).strip()
        if not line:
            continue
        if line.startswith("Defaults"):
            defaults.append(line)
            continue
        if line.startswith(SUDOERS_ALIAS):
            ## An alias definition is not itself a grant.
            continue
        rules.append(line)
        if sudoers_rule_runs_as_root(line):
            grants_root = True
            if "NOPASSWD" in line:
                nopasswd = True
        commands.update(sudoers_commands(line))
    return {
        "grants_root": grants_root,
        "nopasswd": nopasswd,
        "active_rules": rules,
        "defaults": defaults,
        "commands": sorted(commands),
    }


## --- polkit -----------------------------------------------------------------


## id may be single- or double-quoted XML.
POLKIT_ACTION_SPLIT_RE = re.compile(r"""<action\s+id=["']([^"']+)["']""")
POLKIT_ALLOW_RE = re.compile(r"<(allow_[a-z]+)>([^<]+)</allow_[a-z]+>")


def scan_polkit(abs_path, rel_path):
    if not rel_path.endswith(".policy"):
        return None
    if "/polkit-1/actions/" not in ("/" + rel_path):
        return None
    text = read_text(abs_path)
    ## Per-action defaults: split on each <action> so one action's <defaults>
    ## are not collapsed into a file-level dict that hides another's.
    actions = []
    matches = list(POLKIT_ACTION_SPLIT_RE.finditer(text))
    for index, match in enumerate(matches):
        start = match.end()
        end = matches[index + 1].start() if index + 1 < len(matches) else len(text)
        block = text[start:end]
        defaults = {m.group(1): m.group(2) for m in POLKIT_ALLOW_RE.finditer(block)}
        actions.append({"id": match.group(1), "defaults": defaults})
    return {"actions": actions}


## --- sudo calls (shfmt AST) -------------------------------------------------


def analyze_sudo(call, source):
    """(program, runs_as) for a sudo CallExpr, over shfmt-parsed tokens.

    program is the command sudo runs, or None when it is an expansion/absent
    (reported as notify). runs_as is 'root' unless -u/--user names another user
    ('?' when that user is itself an expansion). This reads sudo's OWN option
    semantics; bash parsing (position, quoting) is already done by shfmt.
    """
    runs_as = "root"
    pending_user_value = False
    tokens = bash_ast.command_tokens(
        call, source,
        value_short=SUDO_VALUE_SHORT, value_long=SUDO_VALUE_LONG,
    )
    for kind, word, text in tokens:
        if kind == "opt":
            if text.startswith("--user="):
                value = text.split("=", 1)[1]
                runs_as = "?" if EXPANSION_RE.search(value) else value
            elif text.startswith("--") and "=" not in text \
                    and bash_ast.resolve_long(text[2:], SUDO_VALUE_LONG) == "user":
                pending_user_value = True
            elif text.startswith("-") and not text.startswith("--"):
                cluster = text[1:]
                if "u" in cluster:
                    index = cluster.index("u")
                    if index == len(cluster) - 1:
                        pending_user_value = True
                    else:
                        runs_as = cluster[index + 1:]
        elif kind == "value":
            if pending_user_value:
                value = bash_ast.word_string(word)
                runs_as = value if value is not None else "?"
                pending_user_value = False
        elif kind == "operand":
            ## Skip sudo's own leading 'VAR=value' env settings to reach the
            ## real program; an unresolved expansion program yields notify.
            program = bash_ast.word_string(word)
            if program is not None and SUDO_ENV_ASSIGN_RE.match(program):
                continue
            return program, runs_as
    return None, runs_as


def scan_sudo_calls(source, tree):
    """Yield (line, program, runs_as) for every sudo invocation in TREE."""
    for call in bash_ast.call_exprs(tree):
        if bash_ast.command_basename(call) != "sudo":
            continue
        word = bash_ast.command_word(call)
        line = word.get("Pos", {}).get("Line") if word else None
        program, runs_as = analyze_sudo(call, source)
        yield line, program, runs_as


## --- build-time chroot ------------------------------------------------------


def scan_build_chroot(rel_path, component):
    if component != "derivative-maker":
        return None
    if not rel_path.startswith("help-steps/"):
        return None
    if not CHROOT_SCRIPT_RE.search(os.path.basename(rel_path)):
        return None
    return {"runs_in_chroot_as_root": True}


## --- driver -----------------------------------------------------------------


FILE_SCANNERS = (
    ("maintainer-script", scan_maintainer),
    ("systemd-unit", scan_systemd),
    ("systemd-dropin", scan_systemd_dropin),
    ("privleap-action", scan_privleap),
    ("sudoers", scan_sudoers),
    ("polkit", scan_polkit),
)


def enumerate_root_scripts(dm_root):
    submodules = submodule_paths(dm_root)
    entries = []
    parse_errors = []
    walk_errors = []
    examined = {"files": 0, "shell_files": 0}

    for abs_path, rel_path in walk_files(dm_root, walk_errors):
        examined["files"] += 1
        component, sub_path = component_for(rel_path, submodules)
        base = {"component": component, "submodule": sub_path, "path": rel_path}

        for category, scanner in FILE_SCANNERS:
            details = scanner(abs_path, rel_path)
            if details is not None:
                entries.append({"category": category, **base, **details})

        chroot = scan_build_chroot(rel_path, component)
        if chroot is not None:
            entries.append({"category": "build-chroot", **base, **chroot})

        if is_shell(abs_path, rel_path):
            examined["shell_files"] += 1
            source = read_text(abs_path)
            try:
                tree = bash_ast.parse_normalized(source)
            except bash_ast.BashParseError as exc:
                parse_errors.append({"path": rel_path, "error": str(exc)})
                continue
            for line, program, runs_as in scan_sudo_calls(source, tree):
                entry = {
                    "category": "sudo-call", **base,
                    "line": line, "command": program, "runs_as": runs_as,
                }
                if program is None:
                    entry["note"] = "notify"
                entries.append(entry)

    entries.sort(key=lambda e: (
        e["category"], e["component"], e["path"], e.get("line") or 0))
    summary = {}
    for entry in entries:
        summary[entry["category"]] = summary.get(entry["category"], 0) + 1
    return {
        "schema": "dm-root-scripts-enum/2",
        "dm_root": os.path.abspath(dm_root),
        "submodule_count": len(submodules),
        "examined": examined,
        "summary": summary,
        "parse_errors": parse_errors,
        "walk_errors": walk_errors,
        "entries": entries,
    }


def main(argv):
    dm_root = argv[1] if len(argv) > 1 else os.path.join(
        os.path.expanduser("~"), "derivative-maker")
    if not os.path.isdir(dm_root):
        print(f"ERROR: not a directory: {dm_root}", file=sys.stderr)
        return 1
    if not bash_ast.shfmt_available():
        print("ERROR: shfmt not found -- required to parse shell for sudo calls.",
              file=sys.stderr)
        return 1
    report = enumerate_root_scripts(dm_root)
    print(json.dumps(report, indent=2, sort_keys=False))
    if report["examined"]["files"] == 0:
        print("ERROR: examined zero files -- wrong root?", file=sys.stderr)
        return 1
    if not report["entries"]:
        print("ERROR: found zero root-privileged scripts -- wrong root?",
              file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
