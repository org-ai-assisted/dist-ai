#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Runs the derivative-maker help-steps suite: functional tests for the
## helper scripts under derivative-maker 'help-steps/' (currently
## mount-cleanup, the /proc-based process reaper). The reaper test spawns
## victim and bystander processes in fresh mktemp trees and asserts the
## reaper kills exactly the tree's users; it requires ROOT and therefore
## runs inside CI's throwaway container or a sandbox VM. Invoked unprivileged,
## this runner re-execs itself under passwordless sudo where that is available,
## and warns rather than pretending otherwise where it is not. Works installed (tests
## under /usr/share/dm-help-steps-tests) or from a git checkout. Set
## MOUNT_CLEANUP to pick the script under test; otherwise the suite uses a
## copy staged next to the test, then a derivative-maker checkout under
## ~/derivative-maker.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## Canonical suite exit (fail > skip > pass): a per-case skip surfaces as
## SKIP so the orchestrator's --allow-skip governs it, instead of being
## folded into a passing suite.
suite_exit_helper="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")/../share/dist-ai-tests-common/suite-exit.bash"
[ -r "${suite_exit_helper}" ] || suite_exit_helper='/usr/share/dist-ai-tests-common/suite-exit.bash'
# shellcheck source=../share/dist-ai-tests-common/suite-exit.bash
source "${suite_exit_helper}"

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

## mount_cleanup_test.sh needs root and treats a non-root run as a HARD ERROR, not
## a skip -- correctly, since a test that cannot run has verified nothing. But
## the runner never elevated, so any unprivileged invocation reported
## "FAILED (1): mount_cleanup_test.sh" for a test that passes 16/16 as root. A
## false red is as misleading as a false green, and it trained the failure to be
## ignored.
##
## CI already runs this suite as the container's root, so root-for-all is the
## established mode; this just makes a local sandbox run match it instead of
## requiring the caller to remember. Elevate when we can, and say plainly why we
## could not when we cannot -- never silently continue into a guaranteed failure.
if [ ! "${EUID}" = "0" ] && [ ! "${DM_HELP_STEPS_TESTS_NO_ELEVATE:-}" = "true" ]; then
   if sudo --non-interactive true >/dev/null 2>&1; then
      printf '%s\n' "${0##*/}: re-running as root (mount-cleanup requires it)." >&2
      ## --preserve-env: the suite is configured entirely through environment
      ## (MOUNT_CLEANUP, DERIVATIVE_MAKER_DIR, ...), so dropping it would point
      ## the tests at different subjects than the caller chose.
      sudo --non-interactive --preserve-env -- "$0" "$@"
      exit "$?"
   fi
   printf '%s\n' "${0##*/}: WARNING: not root and passwordless sudo is unavailable;" \
      "  mount_cleanup_test.sh will report a hard error rather than run." \
      "  Run this suite as root (CI does), or in the sandbox VM." >&2
fi

if [ -n "${DM_HELP_STEPS_TESTS_DIR:-}" ]; then
   tests_dir="${DM_HELP_STEPS_TESTS_DIR}"
elif [ -d "${script_dir}/../share/dm-help-steps-tests" ]; then
   tests_dir="${script_dir}/../share/dm-help-steps-tests"
else
   tests_dir='/usr/share/dm-help-steps-tests'
fi

## Host-only cases: a test whose header carries the marker line
##   ## dm-help-steps-tests: host-only: <reason>
## validates against a developer checkout and cannot verify anything in CI (an
## operator-authorized, named exemption). Under CI it is NOT run and is listed by
## name -- neither a pass nor a skip. A skip would turn the whole suite into SKIP,
## and the only CI lever, a suite-wide --allow-skip, would then also hide every
## other case's skip.
under_ci="false"
if [ "${CI:-}" = "true" ] || [ "${GITHUB_ACTIONS:-}" = "true" ]; then
   under_ci="true"
fi

## Run every *_test.sh in the suite. Exit 77 from a test means SKIP (missing
## target / missing tooling) and does not count as a failure; any other non-zero
## exit is a failure. Overall exit is non-zero iff at least one test failed.
##
## "no root" is NOT among the skip reasons: the suite elevates above, and a test
## that still cannot get root reports a hard error. Required privilege is a thing
## to obtain, not to skip around.
## Name the SUBJECT tree and its commit before running anything.
##
## Without this, a suite run says nothing about WHICH derivative-maker it
## inspected. A sandbox carrying a stale clone produced 15 confident assertion
## failures against fixes that had already landed, and the output gave no hint
## that the subject was months behind -- the failures read as real defects. The
## same silence would hide the opposite: a PASS earned by an old tree.
subject_tree="${DERIVATIVE_MAKER_DIR:-${HOME}/derivative-maker}"
if [ -d "${subject_tree}" ]; then
   subject_head="$( git -C "${subject_tree}" rev-parse --short HEAD 2>/dev/null || printf '%s' "unknown" )"
   subject_branch="$( git -C "${subject_tree}" rev-parse --abbrev-ref HEAD 2>/dev/null || printf '%s' "unknown" )"
   ## stderr, not stdout: the tests report on stderr, and stdout is block-buffered
   ## when piped -- so a banner on stdout surfaced BELOW 74 lines of failures,
   ## exactly where nobody reads it. It only does its job if it arrives first.
   printf '%s\n' "subject: ${subject_tree} @ ${subject_head} (${subject_branch})" >&2
else
   printf '%s\n' "subject: ${subject_tree} (NOT PRESENT -- tests will fall back or fail)" >&2
fi

shopt -s nullglob
failures=0
skipped=0
env_unmet=0
ran=0
host_only=()
for test_script in "${tests_dir}"/*_test.sh; do
  if [ "${under_ci}" = "true" ] \
     && grep --quiet -- '^## dm-help-steps-tests: host-only: ' "${test_script}"; then
    host_only+=( "$(basename -- "${test_script}")" )
    continue
  fi
  ran=$(( ran + 1 ))
  printf '%s\n' "" "########## $(basename -- "${test_script}") ##########"
  rc=0
  bash -- "${test_script}" "$@" || rc=$?
  if [ "${rc}" -eq 77 ]; then
    printf '%s\n' "########## SKIPPED: $(basename -- "${test_script}") ##########"
    skipped=$(( skipped + 1 ))
  elif [ "${rc}" -eq 78 ]; then
     env_unmet=$(( env_unmet + 1 ))
  elif [ "${rc}" -ne 0 ]; then
    printf '%s\n' "########## FAILED (${rc}): $(basename -- "${test_script}") ##########"
    failures=$(( failures + 1 ))
  fi
done

if [ "${ran}" -eq 0 ]; then
  printf '%s\n' "ERROR: no *_test.sh found in ${tests_dir}" >&2
  exit 1
fi
printf '%s\n' '' "${ran} dm-help-steps case(s): ${failures} failed, ${skipped} skipped, ${env_unmet} env-unmet"
if [ "${#host_only[@]}" -gt 0 ]; then
  printf '%s\n' "host-only, not run under CI (${#host_only[@]}): ${host_only[*]}"
fi
suite_exit "${failures}" "${skipped}" "${env_unmet}"
