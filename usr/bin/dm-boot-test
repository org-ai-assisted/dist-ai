#!/bin/bash

## Copyright (C) 2025 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Generic boot + functional test entrypoint (CI front-end), invoked as:
##
##   dm-boot-test --image <path> --arch <amd64|arm64> \
##       --firmware <bios|efi|efi-secureboot> --session <user|sysmaint>
##
## It installs the qemu/OVMF/pexpect runtime, discovers the boot media by image
## kind, then hands the image to the sibling dm-image-boot-tests (which bundles
## dm-qemu + dm-image-test: boots the image, drives a login-free root serial shell
## and runs 'systemcheck --leak-tests'). The exit code IS the pass/fail signal:
##   0 pass, non-zero booted-but-a-check-failed / no login / setup, 77 SKIP.
##
## All boot tooling lives here in dist-ai; this front-end owns only dependency
## setup, image discovery and dispatch. derivative-maker's CI calls it as
## dist-ai/usr/bin/dm-boot-test (dist-ai is checked out beside the workspace).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

image=""
arch=""
firmware=""
session="user"
## Empty means "derive from --session": the user session runs the checks as the
## 'user' account, the sysmaint session as the 'sysmaint' account (both exist under
## user-sysmaint-split). An explicit --login-user overrides.
login_user=""
login_pass=""
serial_log=""
while [ "$#" -gt 0 ]; do
   case "$1" in
      --image)
         [ "$#" -ge 2 ] || { printf '%s\n' "${BASH_SOURCE[0]}: --image requires a value" >&2 ; exit 2 ; }
         image="$2"
         shift 2
         ;;
      --arch)
         [ "$#" -ge 2 ] || { printf '%s\n' "${BASH_SOURCE[0]}: --arch requires a value" >&2 ; exit 2 ; }
         arch="$2"
         shift 2
         ;;
      --firmware)
         [ "$#" -ge 2 ] || { printf '%s\n' "${BASH_SOURCE[0]}: --firmware requires a value" >&2 ; exit 2 ; }
         firmware="$2"
         shift 2
         ;;
      --session)
         [ "$#" -ge 2 ] || { printf '%s\n' "${BASH_SOURCE[0]}: --session requires a value" >&2 ; exit 2 ; }
         session="$2"
         shift 2
         ;;
      --login-user)
         [ "$#" -ge 2 ] || { printf '%s\n' "${BASH_SOURCE[0]}: --login-user requires a value" >&2 ; exit 2 ; }
         login_user="$2"
         shift 2
         ;;
      --login-pass)
         [ "$#" -ge 2 ] || { printf '%s\n' "${BASH_SOURCE[0]}: --login-pass requires a value" >&2 ; exit 2 ; }
         login_pass="$2"
         shift 2
         ;;
      --serial-log)
         [ "$#" -ge 2 ] || { printf '%s\n' "${BASH_SOURCE[0]}: --serial-log requires a value" >&2 ; exit 2 ; }
         serial_log="$2"
         shift 2
         ;;
      *)
         printf '%s\n' "${BASH_SOURCE[0]}: unexpected argument: $1" >&2
         exit 2
         ;;
   esac
done

[ -n "${image}" ]    || { printf '%s\n' "${BASH_SOURCE[0]}: --image is required" >&2 ; exit 2 ; }
[ -n "${arch}" ]     || { printf '%s\n' "${BASH_SOURCE[0]}: --arch is required" >&2 ; exit 2 ; }
[ -f "${image}" ]    || { printf '%s\n' "${BASH_SOURCE[0]}: no such image: ${image}" >&2 ; exit 2 ; }

## Runtime dependencies. SeaBIOS ships with qemu-system-x86; ovmf provides both the
## plain and the Secure-Boot OVMF firmware; qemu-efi-aarch64 provides arm64 edk2;
## python3-pexpect drives the login conversation.
sudo --non-interactive -- apt-get update
sudo --non-interactive -- apt-get install --yes --no-install-recommends \
   qemu-system-x86 qemu-system-arm qemu-utils ovmf qemu-efi-aarch64 \
   python3-pexpect xorriso

script_dir="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
## dm-image-boot-tests is a sibling in the same bin dir (shipped together); fall
## back to PATH when run from an installed dist-ai package.
boot_tests_bin="${script_dir}/dm-image-boot-tests"
[ -x "${boot_tests_bin}" ] || boot_tests_bin="dm-image-boot-tests"

## Boot media by kind. Session selection (user/sysmaint) works either way via
## dm-qemu's SMBIOS kernel-cmdline injection.
##   .iso          -> live image (--iso)
##   .ova          -> a tar container dm-qemu does not accept; extract its .vmdk
##                    and boot that (--disk)
##   *.libvirt.xz  -> a qcow2/raw disk packed as tar.xz (dm-prepare-release
##                    xz-packs the image and removes the bare disk file); extract
##                    and boot the disk inside (--disk)
##   else          -> a VM disk image (qcow2/raw/vdi/vmdk) booted directly (--disk)
## Temp dir for archive extraction (.ova / .libvirt.xz), removed on exit via a
## function (R-051: no inline trap command). Best-effort; the CI runner is
## ephemeral anyway, and the -snapshot boot reads the extracted disk during the run.
## style-ok: no-safe-rm -- a mktemp scratch dir on the ephemeral CI runner where
## safe-rm (helper-scripts) is not guaranteed present; removed best-effort.
extract_dir=""
# shellcheck disable=SC2317  # invoked indirectly via 'trap ... EXIT'
boot_test_cleanup() {
   [ -n "${extract_dir}" ] && rm --recursive --force -- "${extract_dir}"
   ## Never let the cleanup status become the script's exit code: bash makes a
   ## non-zero EXIT-trap return override an explicit 'exit 0'. With no extract dir
   ## (the ISO path) the '[ -n "" ]' test is false (1), which otherwise fails an
   ## otherwise-passing leg.
   return 0
}
trap boot_test_cleanup EXIT

case "${image}" in
   *.iso)
      test_args=(--iso "${image}")
      ;;
   *.ova)
      extract_dir="$(mktemp --directory)"
      tar --extract --file "${image}" --directory "${extract_dir}"
      ## First .vmdk via parameter expansion, not 'head -1': head would SIGPIPE
      ## find/sort (exit 141 under pipefail) once their output exceeds the buffer.
      ova_vmdk_list="$(find "${extract_dir}" -type f -name '*.vmdk' | LC_ALL=C sort)"
      ova_vmdk="${ova_vmdk_list%%$'\n'*}"
      [ -n "${ova_vmdk}" ] || { printf '%s\n' "${BASH_SOURCE[0]}: no .vmdk inside ${image}" >&2; exit 2; }
      test_args=(--disk "${ova_vmdk}")
      ;;
   *.xz)
      extract_dir="$(mktemp --directory)"
      tar --extract --xz --file "${image}" --directory "${extract_dir}"
      disk_list="$(find "${extract_dir}" -type f \( -name '*.qcow2' -o -name '*.raw' \) | LC_ALL=C sort)"
      disk_img="${disk_list%%$'\n'*}"
      [ -n "${disk_img}" ] || { printf '%s\n' "${BASH_SOURCE[0]}: no .qcow2/.raw inside ${image}" >&2; exit 2; }
      test_args=(--disk "${disk_img}")
      ;;
   *)
      test_args=(--disk "${image}")
      ;;
esac
## Run the checks as the account that owns the selected session unless the caller
## pinned one: user session -> 'user', sysmaint session -> 'sysmaint'.
[ -n "${login_user}" ] || login_user="${session}"
test_args+=(
   --arch "${arch}"
   --session "${session}"
   --login-user "${login_user}"
)
[ -n "${firmware}" ]   && test_args+=(--firmware "${firmware}")
[ -n "${login_pass}" ] && test_args+=(--login-pass "${login_pass}")
[ -n "${serial_log}" ] && test_args+=(--serial-log "${serial_log}")

printf '%s\n' "${BASH_SOURCE[0]}: boot-testing ${image} (arch=${arch} firmware=${firmware:-default} session=${session})"
## Run dm-image-boot-tests and forward its exit code; avoid 'exec' so any future
## cleanup after this line still runs.
boot_tests_rc=0
"${boot_tests_bin}" "${test_args[@]}" || boot_tests_rc="$?"
exit "${boot_tests_rc}"
