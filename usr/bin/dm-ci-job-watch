#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Wait for the derivative-maker build lane on one ref and report its verdict.
##
## The progress file grows ONLY on real state change. A line per tick would be a
## fabricated liveness signal -- the stall supervisor watches this file, so a
## wedged poller would look healthy forever.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

usage() {
   printf '%s\n' \
      'usage: dm-ci-job-watch <progress-file> <head-sha> [<job-name-substring>]' \
      '' \
      'Wait for the derivative-maker build lane on <head-sha> and report its' \
      'verdict. Appends state CHANGES only to <progress-file>, which is what a' \
      'stall supervisor watches -- a line per poll would be a fabricated' \
      'liveness signal.' \
      '' \
      '  <job-name-substring>  which check-runs to watch (default: uild, i.e.' \
      '                        the build jobs; pass "compare" for the compare job)'
}

## Argument checking BEFORE the assignments: with 'nounset' a bare '$1' aborts
## with "line N: $1: unbound variable", which is what '--help' used to print.
## A tool whose help text is a crash teaches you not to trust its other output.
case "${1:-}" in
   -h|--help)
      usage
      exit 0
      ;;
esac

if [ "$#" -lt 2 ]; then
   usage >&2
   exit 2
fi

progress="$1"
head_sha="$2"
## Which check-run(s) to watch, as a name substring. Parameterised rather than
## duplicated: the same lane produces 'build (a)/(b)' and then 'compare', and a
## second copy of this file would drift from the first.
job_filter="${3:-uild}"
export job_filter

note() {
   local stamp
   stamp="$(date --utc +%H:%M:%SZ)"
   printf '%s\n' "${stamp} $*" >> "${progress}"
}

note "watching '${job_filter}' job(s) for ${head_sha}"

state_helper="$( dirname -- "$( dirname -- "$( readlink -f -- "${BASH_SOURCE[0]}" )" )" )/libexec/dist-ai/dm-ci-job-watch-state.py"
[ -r "${state_helper}" ] || state_helper='/usr/libexec/dist-ai/dm-ci-job-watch-state.py'

last_state=""
unreadable=0
while true; do
   payload="$(github-api GET "/repos/org-ai-assisted/derivative-maker/commits/${head_sha}/check-runs?per_page=100" 2>/dev/null || printf '')"

   state=""
   if [ -n "${payload}" ]; then
      state="$(printf '%s' "${payload}" | "${state_helper}" 2>/dev/null || printf '')"
   fi

   if [ -z "${state}" ]; then
      unreadable=$(( unreadable + 1 ))
      if [ "${unreadable}" = "5" ]; then
         note "WARNING: cannot read the Build state after 5 tries (run may not have registered yet)"
      fi
      sleep 60
      continue
   fi
   unreadable=0

   if [ ! "${state}" = "${last_state}" ]; then
      note "${job_filter} ${state}"
      last_state="${state}"
   fi

   case "${state}" in
      completed:success)
         note "=== DONE: ${job_filter} PASSED on ${head_sha}"
         exit 0
         ;;
      completed:*)
         note "=== FAILED: ${job_filter} concluded ${state#completed:} on ${head_sha}"
         exit 1
         ;;
   esac

   sleep 60
done
