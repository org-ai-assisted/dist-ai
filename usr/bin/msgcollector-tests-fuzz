#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Randomized fuzz run of msgcollector's bash over attacker-influenceable
## content. Two harnesses:
##   * fuzz_cli_rendering.py  -- the --messagecli HTML-to-terminal rewriter;
##     cli_links_to_footnotes must never hang, crash, or leave a URL in the
##     flow text.
##   * fuzz_output_chunking.py -- msgdispatcher_run_check's output_func, which
##     splits a message into <= arg_max_bytes chunks; must never hang, reorder
##     or drop data, or emit an over-sized argument. It does intentionally omit
##     ONE trailing newline on success -- the only byte it may shed.
## See each file for the properties checked. Override the sweep with
## --iterations N and replay a failure with --seed N. The msgcollector script
## under test is resolved by msgcollector_testlib (MSGCOLLECTOR_REPO=<checkout>
## else the installed script).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/msgcollector-tests" ]; then
   tests_dir="${script_dir}/../share/msgcollector-tests"
else
   tests_dir='/usr/share/msgcollector-tests'
fi

## fuzz_cli_rendering drives cli_translate_gui_markup, which shells out to
## helper-scripts str_replace (a python process) several times per message -- so
## each iteration costs ~100ms and a 6000-sweep alone blows timeout_fuzz (600s,
## the measured TIMEOUT). Give the slow HTML-rewrite lane a smaller sweep; the
## output_func lane is pure bash (~3ms/iter) and keeps the big count. The curated
## regressions run every time regardless, and each CI run varies the random seed,
## so randomized coverage still accumulates across runs. Override either with
## --iterations N.
cli_iterations='1500'
chunk_iterations='6000'

rc=0
python3 -- "${tests_dir}/fuzz_cli_rendering.py" --iterations "${cli_iterations}" "$@" || rc=$?
## output_func chunking: the message-splitting bash in msgdispatcher_run_check.
chunk_rc=0
python3 -- "${tests_dir}/fuzz_output_chunking.py" --iterations "${chunk_iterations}" "$@" || chunk_rc=$?
## Aggregate the two lanes. 77 is the SKIP contract, not a failure, so it must
## not mask a real failure in the other lane: a non-zero, non-77 status from
## EITHER lane wins. Exit 77 only when every lane skipped and none failed.
for lane_rc in "${rc}" "${chunk_rc}"; do
   if [ "${lane_rc}" != 0 ] && [ "${lane_rc}" != 77 ]; then
      exit "${lane_rc}"
   fi
done
if [ "${rc}" = 0 ] || [ "${chunk_rc}" = 0 ]; then
   exit 0
fi
exit 77
