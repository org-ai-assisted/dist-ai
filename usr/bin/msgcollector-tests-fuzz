#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Randomized fuzz run of msgcollector's bash over attacker-influenceable
## content. Two harnesses:
##   * fuzz_cli_rendering.py  -- the --messagecli HTML-to-terminal rewriter;
##     cli_links_to_footnotes must never hang, crash, or leave a URL in the
##     flow text.
##   * fuzz_output_chunking.py -- msgdispatcher_run_check's output_func, which
##     splits a message into <= arg_max_bytes chunks; must never hang, lose or
##     reorder data, or emit an over-sized argument.
## See each file for the properties checked. Override the sweep with
## --iterations N and replay a failure with --seed N. The msgcollector script
## under test is resolved by msgcollector_testlib (MSGCOLLECTOR_REPO=<checkout>
## else the installed script).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/msgcollector-tests" ]; then
   tests_dir="${script_dir}/../share/msgcollector-tests"
else
   tests_dir='/usr/share/msgcollector-tests'
fi

iterations='6000'

rc=0
python3 -- "${tests_dir}/fuzz_cli_rendering.py" --iterations "${iterations}" "$@" || rc=$?
## output_func chunking: the message-splitting bash in msgdispatcher_run_check.
chunk_rc=0
python3 -- "${tests_dir}/fuzz_output_chunking.py" --iterations "${iterations}" "$@" || chunk_rc=$?
## Any non-zero from either fuzzer fails the run; keep the first failure.
if [ "${rc}" = 0 ]; then
   rc="${chunk_rc}"
fi
exit "${rc}"
