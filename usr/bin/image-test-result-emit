#!/usr/bin/python3 -Bsu

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Shell-invocation guard.
"exec" "bash" "-c" "printf '%s\n' '$0: ERROR: Do not execute this script with bash!' >&2; exit 1"

"""Deterministic writer for a per-run result.json (dm-test-result/v1).

The single place that serializes the schema: the image-test publisher
(results-publish.bsh) hands it run-envelope flags plus one `--step`, and this
assembles + validates + writes the JSON. Keeping JSON construction here (not in
bash printf) means the schema -- field order, the honest status enum, the summary
that must agree with steps -- is defined and tested ONCE.

A run has at least one functional step (the lane's pass/fail). A text-only step
carries no `--step-shot` (its attachments[] is empty); a GUI step carries one.
Multi-step capture is a later, non-schema-changing extension: it will drop one
per-step record per step and this tool will assemble them; the single-step flags
below are the current surface.

Exit: 0 ok, 2 usage/schema error.
"""

import argparse
import errno
import os
import stat
import sys
import time

_LIB = os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
    "lib", "python3", "dist-packages")
if os.path.isdir(_LIB) and _LIB not in sys.path:
    sys.path.insert(0, _LIB)

from dm_test_results import model  # noqa: E402

## Bound per-step log capture so a runaway log cannot bloat the plane or the page.
TAIL_BYTES = 4000

_MEDIA_BY_EXT = {
    ".webp": "image/webp",
    ".png": "image/png",
    ".txt": "text/plain",
    ".log": "text/plain",
}


## An account-owned screenshot larger than this is not a real test screenshot; cap
## the root-side copy so a planted multi-GB file cannot exhaust memory / fill the plane.
## Overridable for tests (trust the env; a bad value fails loud).
MAX_SHOT_BYTES = int(os.environ.get("IMAGE_TEST_MAX_SHOT_BYTES") or 25 * 1024 * 1024)


class _RefusedInput(Exception):
    """An account-owned input that root must not read as given (a symlink, or a
    non-regular file). Distinct from a missing file."""


def open_regular_nofollow(path):
    """Open an account-owned path as root WITHOUT following a final-component
    symlink and refusing any non-regular file.

    The screenshot and step logs are produced by the unprivileged TEST_USER and
    ingested here as root. A plain open follows a symlink, so an account that
    swaps one in (e.g. -> /etc/shadow) between a caller's `[ ! -L ]` check and
    this reopen makes root read an off-limits target into the world-readable
    results plane (a TOCTOU). O_NOFOLLOW fails the open atomically on a symlink
    (no window); O_NONBLOCK avoids blocking on a FIFO; the fstat rejects a
    FIFO/device/directory. Returns an open fd (caller closes). A missing path
    raises FileNotFoundError; a symlink / non-regular file raises _RefusedInput --
    both are handled as 'no such input' by the callers (the result is still
    published, minus that attachment/tail), so the account cannot suppress its own
    result by planting a symlink, while root still never reads the target.

    O_NOFOLLOW guards only the FINAL component of ONE open, so opening a full path
    (or even just its immediate parent) still resolves every ANCESTOR dir through
    symlinks. The adversary TEST_USER owns the tree, so it could point ANY ancestor
    component at a root-only location (e.g. /tmp/acct/link/etc/shadow with link -> /)
    and redirect root's read. So WALK every path component from a trusted root,
    opening each as a directory with O_DIRECTORY|O_NOFOLLOW relative to the previous
    component's fd (an openat chain), then open the leaf relative to the final dir fd.
    A symlinked ANY component fails the open closed (ELOOP); each fd pins one exact
    inode, so no component can be re-resolved through a symlink after it was opened."""
    ## Reject a lexical '..'/'.' component: our callers only ever pass concrete
    ## result-dir / account-home paths, and resolving '..' against a pinned dir fd
    ## would let a crafted path climb back out of the walked chain.
    parts = [p for p in path.split(os.sep) if p]
    for comp in parts:
        if comp in (os.curdir, os.pardir):
            raise _RefusedInput("unsafe '.'/'..' component in '%s'" % path)
    if not parts:
        raise _RefusedInput("no filename component in '%s'" % path)
    leaf = parts[-1]
    ## Absolute path -> start at '/', which cannot itself be a symlink; a relative
    ## path -> start at the cwd. Open each DIRECTORY component O_PATH (not O_RDONLY):
    ## O_PATH gives a dir fd usable only as an openat anchor and needs just SEARCH (x)
    ## permission on the dir, not READ -- an ancestor like /tmp/user is execute-only
    ## (0711), so O_RDONLY would wrongly EACCES on a path we are allowed to traverse.
    ## O_DIRECTORY|O_NOFOLLOW still rejects a symlinked or non-dir component.
    dir_flags = os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW
    anchor = os.sep if os.path.isabs(path) else os.curdir
    dir_fd = os.open(anchor, dir_flags)
    try:
        for comp in parts[:-1]:
            try:
                next_fd = os.open(comp, dir_flags, dir_fd=dir_fd)
            except FileNotFoundError:
                raise
            except OSError as exc:
                if exc.errno in (errno.ELOOP, errno.ENOTDIR):
                    raise _RefusedInput("symlinked path component '%s' in '%s'" % (comp, path))
                raise
            os.close(dir_fd)
            dir_fd = next_fd
        try:
            fd = os.open(leaf, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd)
        except FileNotFoundError:
            raise
        except OSError as exc:
            if exc.errno == errno.ELOOP:
                raise _RefusedInput("symlinked input '%s'" % path)
            raise
    finally:
        os.close(dir_fd)
    try:
        mode = os.fstat(fd).st_mode
    except OSError:
        os.close(fd)
        raise
    if not stat.S_ISREG(mode):
        os.close(fd)
        raise _RefusedInput("non-regular input '%s'" % path)
    return fd


def _open_account_input(path, kind):
    """open_regular_nofollow, mapping a missing OR refused input to None (with a
    stderr note for the refused case) so the caller continues without it."""
    try:
        return open_regular_nofollow(path)
    except FileNotFoundError:
        return None
    except _RefusedInput as exc:
        sys.stderr.write(
            "image-test-result-emit: refusing %s %s (not read as root); "
            "%s omitted from the result\n" % (kind, exc, kind))
        return None


def read_tail(path):
    """Last TAIL_BYTES of a file as text (utf-8, lossy). A missing or refused
    (symlinked / non-regular) path -> '' (see open_regular_nofollow)."""
    if not path:
        return ""
    fd = _open_account_input(path, "step log")
    if fd is None:
        return ""
    with os.fdopen(fd, "rb") as handle:
        handle.seek(0, os.SEEK_END)
        size = handle.tell()
        handle.seek(max(0, size - TAIL_BYTES), os.SEEK_SET)
        data = handle.read()
    return data.decode("utf-8", errors="replace")


def copy_shot(src, dst):
    """Copy an account-owned screenshot to the root-owned result dir using the same
    no-follow open as read_tail. A missing or refused (symlinked / non-regular)
    source -> skip, return False (normal 'no shot this run'). The copy is streamed
    and bounded to MAX_SHOT_BYTES; an oversized source is dropped (no partial file,
    no attachment). Returns True only when a complete file was copied."""
    fd = _open_account_input(src, "screenshot")
    if fd is None:
        return False
    copied = 0
    with os.fdopen(fd, "rb") as handle, open(dst, "wb") as out:
        while copied <= MAX_SHOT_BYTES:
            chunk = handle.read(65536)
            if not chunk:
                return True
            copied += len(chunk)
            if copied > MAX_SHOT_BYTES:
                break
            out.write(chunk)
    ## Oversized: drop the partial copy and record no attachment.
    os.unlink(dst)
    sys.stderr.write(
        "image-test-result-emit: screenshot '%s' exceeds %d bytes; omitted\n"
        % (src, MAX_SHOT_BYTES))
    return False


def media_type_for(path, override):
    if override:
        return override
    _, ext = os.path.splitext(path)
    media = _MEDIA_BY_EXT.get(ext.lower())
    if media is None:
        raise SystemExit("image-test-result-emit: unknown mediaType for %s" % path)
    return media


def parse_args(argv):
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--dest", required=True)
    parser.add_argument("--run-id", required=True)
    parser.add_argument("--lane", required=True)
    parser.add_argument("--version", default="")
    parser.add_argument("--builder", required=True)
    parser.add_argument("--mode", required=True)
    parser.add_argument("--test-user", default="")
    parser.add_argument("--origin", required=True, choices=model.VALID_ORIGIN)
    parser.add_argument("--rc", required=True, type=int)
    parser.add_argument("--stage", default=model.STAGE_FINISHED, choices=model.VALID_STAGE)
    parser.add_argument("--generated-unix", type=int, default=None)
    parser.add_argument("--start-unix", type=int, default=None)
    parser.add_argument("--stop-unix", type=int, default=None)
    parser.add_argument("--expect", action="append", default=[])
    ## One functional step (defaults its rc to the run rc so a single-step run needs
    ## only --step-name). A screenshot is attached via --step-shot.
    parser.add_argument("--step-name", required=True)
    parser.add_argument("--step-rc", type=int, default=None)
    parser.add_argument("--step-stdout-file", default=None)
    parser.add_argument("--step-stderr-file", default=None)
    ## Screenshots are REPEATABLE: a single GUI step may carry several milestone shots
    ## (the install "full story"). --step-shot/-src/-name/-mediatype are parallel lists
    ## (one per shot); --step-shot-name is the attachment name the site uses to label +
    ## disambiguate the shot (falls back to "screenshot" for a lone shot). A single
    ## --step-shot (no name) reproduces the prior one-shot behaviour exactly.
    parser.add_argument("--step-shot", action="append", default=None)
    ## The account-owned screenshot source. When given, the emitter copies it
    ## into the result dir no-follow (results-publish no longer does the copy,
    ## so the only root reopen of an account path happens here, safely).
    parser.add_argument("--step-shot-src", action="append", default=None)
    parser.add_argument("--step-shot-name", action="append", default=None)
    parser.add_argument("--step-shot-mediatype", action="append", default=None)
    ## provenance (origin is above; these detail it)
    parser.add_argument("--provenance-source-uri", default=None)
    parser.add_argument("--provenance-source-commit", default=None)
    parser.add_argument("--provenance-artifact-sha256", default=None)
    parser.add_argument("--provenance-built-utc", default=None)
    return parser.parse_args(argv)


def main(argv):
    args = parse_args(argv)
    now = int(time.time())
    generated_unix = args.generated_unix if args.generated_unix is not None else now
    stop_unix = args.stop_unix if args.stop_unix is not None else now
    step_rc = args.step_rc if args.step_rc is not None else args.rc

    attachments = []
    shots = args.step_shot or []
    srcs = args.step_shot_src or []
    names = args.step_shot_name or []
    mtypes = args.step_shot_mediatype or []
    ## --step-shot-src must be 1:1 with --step-shot (each shot is copied from its own
    ## account source); name/mediatype may be shorter and default per shot.
    if srcs and len(srcs) != len(shots):
        sys.stderr.write(
            "image-test-result-emit: --step-shot-src count (%d) != --step-shot count (%d)\n"
            % (len(srcs), len(shots))
        )
        return 2
    dest_dir = os.path.dirname(os.path.abspath(args.dest))
    ## A bad individual shot (a crafted/odd filename in an account-owned shot dir, a
    ## duplicate name, an over-long stored basename) SKIPS that one attachment and notes
    ## why -- it must NEVER abort the emit, or an untrusted test account could SUPPRESS
    ## its own result.json by dropping a stray *.png. The verdict is the critical
    ## artifact; a shot is best-effort, exactly like a missing/symlinked source.
    seen_names = set()
    seen_dests = set()
    for i, step_shot in enumerate(shots):
        shot = os.path.basename(step_shot)
        name = names[i] if i < len(names) and names[i] else "screenshot"
        mtype = mtypes[i] if i < len(mtypes) else None
        ## Distinct attachment names so the site can disambiguate + label each milestone;
        ## distinct stored basenames so a second shot never truncates a prior one.
        if name in seen_names:
            sys.stderr.write(
                "image-test-result-emit: skipping duplicate --step-shot-name '%s'\n" % name)
            continue
        if shot in seen_dests:
            sys.stderr.write(
                "image-test-result-emit: skipping duplicate stored shot '%s'\n" % shot)
            continue
        ## Build the attachment FIRST (validates name/mediaType/path); an invalid one
        ## (non-ASCII, control char, '.'/'..', empty) is skipped, never fatal.
        try:
            attachment = model.make_attachment(name, media_type_for(shot, mtype), shot)
        except model.ModelError as exc:
            sys.stderr.write("image-test-result-emit: skipping shot '%s': %s\n" % (shot, exc))
            continue
        shot_present = True
        if srcs:
            ## copy_shot is best-effort; an OSError (e.g. a >255-byte stored basename)
            ## skips this shot rather than aborting the whole result.
            try:
                shot_present = copy_shot(srcs[i], os.path.join(dest_dir, shot))
            except OSError as exc:
                sys.stderr.write("image-test-result-emit: skipping shot '%s': %s\n" % (shot, exc))
                continue
        ## A run that never powered on is published without a shot: an absent
        ## source records no attachment, exactly as before the copy moved here.
        ## Reserve name + dest only once the shot is actually EMITTED: a DROPPED shot
        ## (oversized/missing source) must not reserve its milestone, or a valid
        ## same-stem retake (02-welcome after an oversized 00-welcome, both -> 'welcome'
        ## once results-publish strips the NN- prefix) would be skipped as a dup and the
        ## milestone lost. Reserving dest only on emit still blocks a later same-basename
        ## shot from truncating this one (the seen_dests gate runs before copy_shot).
        if shot_present:
            seen_names.add(name)
            seen_dests.add(shot)
            attachments.append(attachment)

    step = model.make_step(
        name=args.step_name,
        status=model.step_status_from_rc(step_rc),
        exit_code=step_rc,
        start_unix=args.start_unix,
        stop_unix=stop_unix,
        stdout_tail=read_tail(args.step_stdout_file),
        stderr_tail=read_tail(args.step_stderr_file),
        attachments=attachments,
    )

    try:
        result = model.build_result(
            run_id=args.run_id,
            lane=args.lane,
            version=args.version,
            builder=args.builder,
            mode=args.mode,
            test_user=args.test_user,
            origin=args.origin,
            rc=args.rc,
            generated_unix=generated_unix,
            stop_unix=stop_unix,
            start_unix=args.start_unix,
            stage=args.stage,
            expect=args.expect,
            steps=[step],
            provenance={
                "source_uri": args.provenance_source_uri,
                "source_commit": args.provenance_source_commit,
                "artifact_sha256": args.provenance_artifact_sha256,
                "built_utc": args.provenance_built_utc,
            },
        )
    except model.ModelError as exc:
        raise SystemExit("image-test-result-emit: %s" % exc)

    payload = model.dumps(result)
    tmp = args.dest + ".tmp"
    with open(tmp, "w", encoding="ascii") as handle:
        handle.write(payload)
    os.replace(tmp, args.dest)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
