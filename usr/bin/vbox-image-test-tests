#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Suite runner for vbox-image-test: runs every *_test.sh in usr/share/vbox-image-test-tests
## and fails if any fails. No root, no network (server-exec + test-results-deploy are stubbed).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/vbox-image-test-tests" ]; then
   tests_dir="${script_dir}/../share/vbox-image-test-tests"
else
   tests_dir='/usr/share/vbox-image-test-tests'
fi

shopt -s nullglob
case_scripts=( "${tests_dir}"/*_test.sh )
shopt -u nullglob

if [ "${#case_scripts[@]}" -eq 0 ]; then
   printf '%s\n' "FATAL: no case scripts found in '${tests_dir}'" >&2
   exit 1
fi

failed=0
skipped=0
for case_script in "${case_scripts[@]}"; do
   printf '%s\n' "== $(basename -- "${case_script}") =="
   case_rc=0
   VBOX_IMAGE_TEST_BIN="${script_dir}/vbox-image-test" "${case_script}" "$@" || case_rc=$?
   if [ "${case_rc}" -eq 77 ]; then
      skipped=$(( skipped + 1 ))
   elif [ "${case_rc}" -ne 0 ]; then
      failed=$(( failed + 1 ))
   fi
done

printf '%s\n' ""
printf '%s\n' "${#case_scripts[@]} case(s), ${failed} failed, ${skipped} skipped"

if [ "${failed}" -gt 0 ]; then
   exit 1
elif [ "${skipped}" -eq "${#case_scripts[@]}" ]; then
   exit 77  ## style-ok: allow-skip: propagate an all-skip so the orchestrator applies its skip policy
fi
exit 0
