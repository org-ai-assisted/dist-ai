#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Authenticated GitHub REST call, for dist-ai tools that must also run in CI.
##
##   github-api <METHOD> <PATH-or-URL> [extra curl args...]
##     github-api GET /repos/org-ai-assisted/foo/pulls
##     github-api POST /repos/org-ai-assisted/foo/pulls --data @"$f"   # f="$(mktemp --suffix=.json)"
##
## A bare path (leading '/' optional) resolves against https://api.github.com;
## a full https URL is used as-is. Auth and the standard headers go to curl through a --config
## document on STDIN, so the token never reaches argv, where /proc/<pid>/cmdline
## exposes it to every other user for the life of the request.
##
## This is the ONE copy. It lives in dist-ai rather than private-ai-config
## because dist-ai is public and is what CI checks out, and because five public
## dist-ai tools (dm-ci-dispatch, dm-ci-job-watch, dm-boot-local,
## dm-repro-verify-against-ci, dm-gitlink-upstream-check) call it -- a public
## repo must not depend on a private repo's binary. private-ai-config's tools
## reach it from PATH; its package Recommends dist-ai.
##
## The token may come from a file (the operator's) or from GITHUB_TOKEN /
## GH_TOKEN, since Actions provides an env var and no token file; plain curl is
## used when scurl -- Kicksecure usability-misc's 'curl --tlsv1.3 --proto
## =https' -- is absent, as it is in a CI container.
##
## Unauthenticated calls are allowed: the public compare endpoints this is used
## for work without a token, just at a much lower rate limit.
##
## style-ok: no-has -- runs in a bare Debian CI container where helper-scripts,
## and therefore 'has', do not exist.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

[ -v GITHUB_TOKEN_FILE ] || GITHUB_TOKEN_FILE="${HOME:-}/.config/github-token"

if [ "$#" -lt 2 ]; then
  printf '%s\n' 'Usage: github-api <METHOD> <PATH-or-URL> [extra curl args...]' >&2
  exit 2
fi

method="$1"
target="$2"

## gh-CLI muscle memory: 'gh api ... --input <file>' sends a request body, but
## this is a curl passthrough -- curl has no --input and dies with the
## misdirecting 'option --input: is unknown'. Name THIS tool's idiom instead.
## Scan the WHOLE argv (before the shift): gh's flags-first form
## 'github-api --input <file> <endpoint>' would otherwise land --input in the
## method slot, slip past, and fire a bogus authenticated request (exit 0).
## Detect-and-tell only -- a passthrough must not reparse curl's own grammar, so
## the body still rides curl's documented --data @<file> (see the usage header).
## SCOPE: matches the gh flag as a whole token; it does NOT model which curl
## option consumes a value, so a curl value that is literally '--input' is
## rejected too. That is an accident-not-adversary guard (no real GitHub call
## sets a body/header to the bytes '--input'); widening it would mean reparsing
## curl.
for arg in "$@"; do
  case "${arg}" in
    --input|--input=*|--body-file|--body-file=*)
      printf '%s\n' "github-api: '${arg%%=*}' is a gh-CLI flag, not curl; this wrapper forwards curl flags. Send a request body with: github-api <METHOD> <path> --data @<file>" >&2
      exit 2
      ;;
  esac
done

shift 2

case "${target}" in
  https://*)
    url="${target}"
    ;;
  http://*)
    printf '%s\n' 'github-api: refusing a plaintext http:// URL (would leak the token)' >&2
    exit 1
    ;;
  /*)
    url="https://api.github.com${target}"
    ;;
  *)
    ## 'repos/x' would otherwise glue onto the host ('api.github.comrepos').
    url="https://api.github.com/${target}"
    ;;
esac

## The bearer token must only ever be attached to GitHub hosts -- never let a
## full-URL argument, or a caller that interpolated untrusted data, ship it to
## an arbitrary host.
host="${url#https://}"
host="${host%%/*}"
host="${host%%:*}"
case "${host}" in
  github.com|*.github.com)
    true "INFO: GitHub host, the token may be attached"
    ;;
  *)
    printf '%s\n' "github-api: refusing non-GitHub host '${host}' (would leak the token)" >&2
    exit 1
    ;;
esac

## Token file first: on a workstation it is the operator's credential, and the
## environment may hold a weaker CI token.
##
## THREAT MODEL: every source here is OURS -- the operator's token file, or the
## env a trusted caller set. An actor who could point GITHUB_TOKEN / GH_TOKEN /
## GITHUB_TOKEN_FILE at a hostile value already runs as us and can read the token
## directly, so this is NOT a defence against a malicious env or argv -- against
## that actor there is nothing to defend. The host allowlist above and the
## character check below guard our OWN credential and target against an ACCIDENT
## (a stray trailing newline in the token file; interpolated data reaching a URL
## path), the way all our guards do -- they catch an AI accident, not an
## adversary. Do NOT add crafted-input hardening (userinfo / query '@' URLs and
## the like): it defends a boundary the only capable attacker has already crossed.
token=''
if [ -r "${GITHUB_TOKEN_FILE}" ]; then
  token="$(cat -- "${GITHUB_TOKEN_FILE}")"
elif [ -n "${GITHUB_TOKEN:-}" ]; then
  token="${GITHUB_TOKEN}"
elif [ -n "${GH_TOKEN:-}" ]; then
  token="${GH_TOKEN}"
fi

## The token reaches curl inside the --config document as
## header = "Authorization: Bearer <token>". A newline or double-quote in the
## value would END that directive and turn the remainder into further curl
## config (url / proxy / output / insecure) -- so a stray second line in the
## token file, or a CI variable with a trailing newline, could silently
## redirect the request. Refuse anything outside [A-Za-z0-9_.-]: that rejects
## every config-injection byte (newline, quote, space, '=') while still allowing
## PATs ([A-Za-z0-9_]) AND GitHub App JWTs (header.payload.signature -- the dots
## are harmless in the header value). Inline, because this tool must run in a
## bare CI container with no helper-scripts (see the 'no-has' note above).
case "${token}" in
  '')
    ;;
  *[!A-Za-z0-9_.-]*)
    printf '%s\n' 'github-api: refusing a token with characters outside [A-Za-z0-9_.-] (a newline or quote could break out of the curl --config Authorization directive and redirect the request)' >&2
    exit 1
    ;;
esac

curl_program='curl'
curl_args=(--tlsv1.3 --proto '=https')
if command -v scurl >/dev/null 2>&1; then
  ## scurl IS 'curl --tlsv1.3 --proto =https'; prefer it where it exists so the
  ## TLS policy stays in one place.
  curl_program='scurl'
  curl_args=()
fi

config_document="header = \"Accept: application/vnd.github+json\"
header = \"X-GitHub-Api-Version: 2022-11-28\""
if [ -n "${token}" ]; then
  config_document="header = \"Authorization: Bearer ${token}\"
${config_document}"
fi

## Large list responses (e.g. a PR's inline comments with big diff_hunks, >1MB) are
## intermittently truncated mid-transfer by the network path -- curl then exits non-zero
## (56 "unexpected eof" / 92 HTTP/2 CANCEL) with a PARTIAL body, which a caller such as
## pr-comments-fetch correctly rejects as truncated. Retrying the whole transfer recovers
## it. RETRY ONLY IDEMPOTENT READS (GET/HEAD): a write whose response is cut AFTER the
## server already applied it would be re-applied on retry (a duplicate comment/resource),
## so writes are never retried -- a cut write surfaces its error to the caller instead.
##
## A retried read MUST buffer to a file, not stream to stdout: curl cannot retract the
## bytes it already wrote for a FAILED attempt, so retrying straight to stdout would
## append the complete response to the partial one (invalid output). With --output curl
## truncates+rewrites the file on each attempt, so the file holds exactly the final
## attempt; emit it only after a CLEAN curl exit, and discard curl's own stdout.
##
## The caller's args are passed to curl UNCHANGED, so curl owns delivery and keeps every
## native output semantic (-o -, --output-dir, --create-dirs, --no-clobber, a single
## stream straight to the destination disk). When the caller gives its own -o/--output,
## curl writes the body THERE and we never add our own --output; the body-based
## secondary-RL grep then reads that same destination file. We only LEARN that path by a
## best-effort, NON-destructive scan: a misread degrades to header-only RL detection, it
## never corrupts or misdirects the caller's output. Only when the caller gives no output
## destination do we buffer to a private temp and emit it to stdout.
##
## GitHub SECONDARY rate limits return 403 -- and curl treats a 403 as a SUCCESSFUL transfer
## (exit 0), so neither --retry nor --retry-all-errors covers it. They carry a Retry-After
## header or a body naming a "secondary rate limit": transient, so wait the requested time
## (capped) and retry. A PERMISSION 403 and a PRIMARY-quota 403 ("API rate limit exceeded",
## whose reset can be an hour away) carry NEITHER signal, so they fall through to the caller
## unchanged, never slept on. GET/HEAD only (idempotent); 429 is already retried by curl.
retry_args=()
response_file=''
hdr_file=''
caller_out=''
body_file=''
case "${method^^}" in
  GET|HEAD)
    hdr_file="$(mktemp)"
    retry_args=(--retry 5 --retry-all-errors --retry-delay 1)
    ## Learn the caller's output destination WITHOUT touching the args (curl keeps native
    ## output handling). Match only the real/common curl forms; -o/--output take the next
    ## token, --output=VAL and -oVAL attach it. FIRST wins, as curl does, so once caller_out
    ## is set, stop looking (the second case below is guarded too, so -o -out.json records
    ## -out.json, not a doubly-stripped ut.json). SCOPE: this is a GitHub-API wrapper and no
    ## caller passes anything but a plain -o/--output <file>; the wrapper does NOT reimplement
    ## curl's option table, so for exotic inputs no caller emits -- a value that merely looks
    ## like -o (--data-urlencode -o=x), short clusters (-sLo), -O/--remote-name, --output-dir's
    ## prefixing, /dev/stdout -- the learned path may be wrong or absent. The worst case is that
    ## body-based secondary-RL detection falls back to header-only (a body-only secondary limit
    ## is then not retried), or, when the misread hides a body curl actually streamed to stdout,
    ## that body is lost; curl still delivers wherever the caller's real flags point.
    prev=''
    for arg in "$@"; do
      if [ -z "${caller_out}" ]; then
        case "${prev}" in
          -o | --output)
            caller_out="${arg}"
            ;;
        esac
      fi
      if [ -z "${caller_out}" ]; then
        case "${arg}" in
          --output=*)
            caller_out="${arg#--output=}"
            ;;
          -o?*)
            caller_out="${arg#-o}"
            ;;
        esac
      fi
      prev="${arg}"
    done
    ## curl writes '-o -' (and the attached '-o-') to stdout. We deliver stdout ourselves from
    ## the buffer, so the sentinel must be STRIPPED from the args: left in, curl's first-output-
    ## wins would send the body to the stdout we capture for %{http_code} and discard (silent
    ## loss). Strip only the FIRST stdout-sentinel output flag; a real-file -o is left in place.
    if [ "${caller_out}" = '-' ]; then
      caller_out=''
      stripped=()
      dropped=''
      while [ "$#" -gt 0 ]; do
        if [ -z "${dropped}" ]; then
          case "$1" in
            -o | --output)
              if [ "${2:-}" = '-' ]; then
                dropped=1
                shift 2
                continue
              fi
              ;;
            -o- | --output=-)
              dropped=1
              shift
              continue
              ;;
          esac
        fi
        stripped+=("$1")
        shift
      done
      set -- "${stripped[@]}"
    fi
    if [ -n "${caller_out}" ]; then
      ## curl writes the body to the caller's file; grep THAT for the secondary-RL body text.
      body_file="${caller_out}"
    else
      ## No caller destination (or '-' = stdout): buffer to a private temp, grep it, emit to stdout.
      response_file="$(mktemp)"
      body_file="${response_file}"
    fi
    ;;
esac

cleanup_response_file() {
  ## style-ok: no-safe-rm -- github-api also runs in a bare CI container where
  ## safe-rm (a workstation helper) does not exist; these are our own temp files.
  ## Only our own temps -- never the caller's output file.
  [ -n "${response_file}" ] && rm -f -- "${response_file}"
  [ -n "${hdr_file}" ] && rm -f -- "${hdr_file}"
  return 0
}

## Secondary-rate-limit backoff bounds. Env-injectable so the suite drives 0s waits.
[ -v GH_SECONDARY_RL_ATTEMPTS ] || GH_SECONDARY_RL_ATTEMPTS=4
[ -v GH_SECONDARY_RL_WAIT_CAP ] || GH_SECONDARY_RL_WAIT_CAP=60
[ -v GH_SECONDARY_RL_BACKOFF ] || GH_SECONDARY_RL_BACKOFF=10

## Print the seconds to wait for a secondary-rate-limit response (rc 0), or return 1 when this
## is NOT a secondary limit (so the caller stops retrying). Prefer the server's Retry-After
## (capped); else, only when the body NAMES a secondary limit, a bounded linear backoff; a
## primary-quota or permission 403 matches neither and returns 1 (fail fast, no sleep).
secondary_rl_wait() {
  local code="$1" hdr="$2" body="$3" attempt="$4" ra w cap
  case "${code}" in
    403 | 429) ;;
    *)
      return 1
      ;;
  esac
  cap="$(( 10#${GH_SECONDARY_RL_WAIT_CAP} ))"
  ## '--' before the path: body/hdr can be a caller-chosen name starting with '-' (curl
  ## accepts it), which grep would otherwise read as an option -- or, for '--', as no file
  ## at all, hanging on stdin.
  ra="$(grep --ignore-case --max-count=1 '^retry-after:' -- "${hdr}" 2>/dev/null \
        | tr --delete '\r' | sed 's/^[^:]*:[[:space:]]*//')" || ra=''
  case "${ra}" in
    '' | *[!0-9]*)
      ra=''
      ;;
  esac
  if [ -n "${ra}" ]; then
    w="$(( 10#${ra} ))"
    [ "${w}" -le "${cap}" ] || w="${cap}"
    printf '%s' "${w}"
    return 0
  fi
  if grep --quiet --ignore-case 'secondary rate limit' -- "${body}" 2>/dev/null; then
    w="$(( 10#${attempt} * 10#${GH_SECONDARY_RL_BACKOFF} ))"
    [ "${w}" -le "${cap}" ] || w="${cap}"
    printf '%s' "${w}"
    return 0
  fi
  return 1
}

if [ -n "${hdr_file}" ]; then
  trap cleanup_response_file EXIT
  ## Buffer to our own --output only when the caller gave no destination; when it did, curl
  ## writes the body to the caller's file (that -o/--output is already in "$@").
  out_args=()
  [ -n "${response_file}" ] && out_args=(--output "${response_file}")
  rc=0
  attempt=1
  http_code=''
  while :; do
    ## curl truncates --dump-header's target itself each attempt, so no pre-clear is needed.
    rc=0
    http_code="$(printf '%s\n' "${config_document}" \
      | "${curl_program}" "${curl_args[@]}" "${retry_args[@]}" \
          --silent --show-error --config - --request "${method}" "$@" \
          --dump-header "${hdr_file}" "${out_args[@]}" \
          --write-out '%{http_code}' "${url}")" \
      || rc="$?"
    ## Transport error (curl non-zero): curl's own --retry already exhausted -- do not loop.
    [ "${rc}" -ne 0 ] && break
    ## Secondary rate limit -> wait (bounded) and retry the whole request; anything else -> done.
    if wait_s="$(secondary_rl_wait "${http_code}" "${hdr_file}" "${body_file}" "${attempt}")" \
       && [ "${attempt}" -lt "$(( 10#${GH_SECONDARY_RL_ATTEMPTS} ))" ]; then
      [ "$(( 10#${wait_s} ))" -gt 0 ] && sleep "$(( 10#${wait_s} ))"
      attempt=$(( attempt + 1 ))
      continue
    fi
    break
  done
  ## A caller destination already holds curl's body (truncated+rewritten each attempt, so the
  ## final attempt's bytes). On the stdout path, emit the buffered body ONLY on a clean curl
  ## exit; on a hard failure (every retry cut) the temp holds a PARTIAL body and a caller
  ## keying on the exit status already fails closed, so emitting nothing keeps a status-
  ## ignoring caller from parsing a partial response as whole.
  if [ -z "${caller_out}" ] && [ "${rc}" -eq 0 ]; then
    cat -- "${response_file}"
  fi
  exit "${rc}"
fi

printf '%s\n' "${config_document}" \
  | "${curl_program}" "${curl_args[@]}" \
      --silent --show-error --config - --request "${method}" "$@" "${url}"
