#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Coverage gate for secure-terminal. Runs every test suite under coverage.py
## and ENFORCES 100% line coverage on the whole package -- both the Qt-free core
## (sanitizer, CLI wrapper, IPC framing, session persistence, drop-in settings)
## and the Qt GUI (review, terminal, main). A
## failure here means a line became unreachable by the tests -- add a test (do
## not paper over it with a blanket exclusion; the few genuinely-unreachable
## defensive/optional-dependency lines carry a justified `# pragma: no cover` in
## the source instead).
##
## secure_terminal AND python3-coverage are REQUIRED to measure coverage, so their
## absence is FATAL (exit 1), never a skip: a coverage gate that silently exits 77
## is scored green by the orchestrator and the missing measurement reads as success.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## `coverage run` imports every module WITHOUT -B (unlike the -Bsu entry scripts and the
## other runners), and does not set sys.dont_write_bytecode, so it writes .pyc files next
## to the sources under the checkout (PYTHONPATH points into the tree). Export the env knob
## once here: it is inherited by every coverage/python3 child this script spawns, so no lane
## has to remember a per-call -B, and the tree stays clean.
export PYTHONDONTWRITEBYTECODE=1

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/secure-terminal-tests" ]; then
   tests_dir="${script_dir}/../share/secure-terminal-tests"
else
   tests_dir='/usr/share/secure-terminal-tests'
fi

## Resolve the headless-wayland compositor helper. Each parallel coverage suite runs under its
## OWN wl-headless-run (labwc) so the suites use the 'wayland' QPA platform -- the only supported
## platform (no offscreen). A single shared compositor is NOT usable here: each suite needs a
## private XDG_RUNTIME_DIR (its single-instance-socket namespace), and a shared compositor's
## wayland socket lives in the compositor's own runtime dir -- so a per-suite dir cannot reach it
## ("Failed to create wl_display"). A per-suite compositor mints its own runtime dir, giving each
## suite both a working wayland socket AND an isolated socket namespace. REQUIRED tooling -> FATAL
## if absent, never a silent skip.
if [ -x "${script_dir}/../share/dist-ai-tests-common/wl-headless-run" ]; then
   wl_headless_run="${script_dir}/../share/dist-ai-tests-common/wl-headless-run"
elif [ -x /usr/share/dist-ai-tests-common/wl-headless-run ]; then
   wl_headless_run='/usr/share/dist-ai-tests-common/wl-headless-run'
else
   printf '%s\n' 'secure-terminal-tests-coverage: FATAL: wl-headless-run not found (install dist-ai-tests-common); cannot start a headless Wayland compositor' >&2
   exit 1
fi
## Shared parallel-suite dispatch (throttle + core/RAM job cap + concurrent-.pyc-write defense +
## per-suite XDG isolation), also used by the plain secure-terminal-tests runner. REQUIRED.
if [ -f "${script_dir}/../share/dist-ai-tests-common/suite-parallel.bash" ]; then
   suite_parallel_lib="${script_dir}/../share/dist-ai-tests-common/suite-parallel.bash"
elif [ -f /usr/share/dist-ai-tests-common/suite-parallel.bash ]; then
   suite_parallel_lib='/usr/share/dist-ai-tests-common/suite-parallel.bash'
else
   printf '%s\n' 'secure-terminal-tests-coverage: FATAL: suite-parallel.bash not found (install dist-ai-tests-common)' >&2
   exit 1
fi
# shellcheck source=../share/dist-ai-tests-common/suite-parallel.bash
source "${suite_parallel_lib}"

repo=''
[ -v SECURE_TERMINAL_REPO ] || SECURE_TERMINAL_REPO=''
if [ -n "${SECURE_TERMINAL_REPO}" ]; then
   repo="${SECURE_TERMINAL_REPO}"
elif [ -d "${HOME}/private-sources/secure-terminal/usr/lib/python3/dist-packages/secure_terminal" ]; then
   repo="${HOME}/private-sources/secure-terminal"
elif [ -d "${script_dir}/../../../../secure-terminal/usr/lib/python3/dist-packages/secure_terminal" ]; then
   repo="${script_dir}/../../../../secure-terminal"
fi

if [ -z "${repo}" ] || [ ! -d "${repo}/usr/lib/python3/dist-packages/secure_terminal" ]; then
   printf '%s\n' 'secure-terminal-tests-coverage: ERROR (secure_terminal not found; set SECURE_TERMINAL_REPO)' >&2
   exit 1
fi

## style-ok: allow-python-interpreter -- run through PATH python3 for venv/user-site test deps
if ! python3 -c 'import coverage' 2>/dev/null; then
   printf '%s\n' 'secure-terminal-tests-coverage: ERROR (python3-coverage not installed)' >&2
   exit 1
fi

## Select the sys.monitoring core (PEP 669, Python 3.12+) over coverage's default C tracer.
## The C tracer drives sys.settrace PER THREAD; a Qt suite that runs Qt native code + a
## SIGCHLD pty reaper alongside the tracer can race it into an intermittent SIGSEGV (exit
## 139) mid-suite (coveragepy#1316). sys.monitoring does not use sys.settrace and is
## thread-safe, so it makes that crash RARE while measuring identically (same stmt count) --
## but a residual tracer/native race can still SIGSEGV occasionally under sysmon too, so
## run_suite_under_coverage (below) retries a crashed suite. Honour an explicit COVERAGE_CORE
## so a developer can still force a core.
if [ -z "${COVERAGE_CORE:-}" ] \
   && python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)' \
   && python3 -c 'import coverage.sysmon' 2>/dev/null; then
   export COVERAGE_CORE=sysmon
fi

export PYTHONPATH="${repo}/usr/lib/python3/dist-packages${PYTHONPATH:+:${PYTHONPATH}}"
pkg="${repo}/usr/lib/python3/dist-packages/secure_terminal"

work="$(mktemp --directory)"
cleanup() { safe-rm --recursive --force -- "${work}" 2>/dev/null || true; }
trap cleanup EXIT
export COVERAGE_FILE="${work}/.coverage"
## Keep Hypothesis's example database OUT of the (rsync-synced, possibly root-run)
## checkout: as root, a `.hypothesis/` written into tests_dir is root-owned and blocks
## the next sandbox sync (rsync cannot delete it). Default it into the throwaway work
## dir; an explicit external value still wins.
export HYPOTHESIS_STORAGE_DIRECTORY="${HYPOTHESIS_STORAGE_DIRECTORY:-${work}/.hypothesis}"

## Ratchet-gated modules, in two tiers. As a module reaches full coverage it is
## added here so coverage can only go up. Each is genuinely 100% -- the few
## unreachable defensive lines (post-fork/pre-exec, EINTR retries) carry a
## justified `# pragma: no cover` in the source, not a blanket exclusion.
##
## Tier 1 -- covered by the Qt-FREE suites.
gated_free='*/__init__.py,*/sanitize.py,*/clipboard.py,*/cli.py,*/ipc.py,*/session.py,*/settings.py,*/preflight.py,*/unicode_tag.py,*/resource_isolation.py,*/state_dump.py'
## Tier 2 -- covered by the headless-Wayland Qt widget suites, which fail closed
## (exit 1) on a missing PyQt6/pyte rather than skipping, so both tiers are
## always gated.
gated_qt='*/clipboard_watch.py,*/review.py,*/review_standalone.py,*/revealed_editor.py,*/terminal.py,*/main.py'

## Every tier is validated BEFORE the suites run: these checks need only the
## source tree, and a stale gate should cost a second, not a full test run.
##
## `coverage report --include` silently ignores a pattern that matches nothing,
## so a renamed module drops out of the gate with no error and no coverage loss
## on the report. Assert every gated pattern still names a real source file.
assert_gated_globs_resolve() {
   local tier="$1"
   local globs="$2"
   local base_dir="$3"
   local patterns=()
   local pattern
   local module_name
   IFS=',' read -r -a patterns <<< "${globs}"
   for pattern in "${patterns[@]}"; do
      module_name="${pattern##*/}"
      if [ ! -f "${base_dir}/${module_name}" ]; then
         printf '%s\n' "secure-terminal-tests-coverage: gated ${tier} pattern ${pattern} names no file in ${base_dir} -- module renamed or removed; update the gate" >&2
         exit 1
      fi
   done
}

## Every module in the package must appear in a tier, so a NEW module cannot
## slip in ungated -- the gate must be a deliberate decision, not an omission.
assert_every_module_gated() {
   local all_gated=",${gated_free},${gated_qt},"
   local source_file
   local module_name
   for source_file in "${pkg}"/*.py; do
      module_name="${source_file##*/}"
      case "${all_gated}" in
         *",*/${module_name},"*)
            ;;
         *)
            printf '%s\n' "secure-terminal-tests-coverage: module ${module_name} is in NO coverage tier -- add it to gated_free or gated_qt" >&2
            exit 1
            ;;
      esac
   done
}

assert_gated_globs_resolve 'Qt-free' "${gated_free}" "${pkg}"
assert_gated_globs_resolve 'Qt widget' "${gated_qt}" "${pkg}"
assert_every_module_gated

## Run every suite under coverage. --parallel-mode + combine keeps each suite's
## (and any forked child's) data in its own file, then merges them. The Qt suites run on the
## real headless-Wayland platform (each suite is wrapped in its own wl-headless-run inside
## run_suite_under_coverage, which exports QT_QPA_PLATFORM=wayland) and fail closed (exit 1)
## when PyQt6 or pyte is missing -- a security-relevant suite must never silently disable
## itself -- so both tiers below are always gated.
## Pin the font DPI to 72 for every suite process BEFORE Qt starts, so the Qt
## suites' font-metric-derived geometry (the responsive-toolbar tier widths in
## test_mainwin especially) is deterministic under coverage without relying on a
## per-module setdefault. Honour an explicit override so this stays a safe
## default rather than a lock.
export QT_FONT_DPI="${QT_FONT_DPI:-72}"
## A Qt suite under coverage can intermittently SIGSEGV (exit 139) even on the thread-safe
## sysmon core: a residual coverage-tracer/Qt-native race (coveragepy#1316), NOT a test
## verdict (a real failure exits 1; the uninstrumented suite never crashes). coverage combine
## UNIONS per-file line data, so a crashed attempt's partial parallel-mode file can only
## re-add already-covered lines -- it
## cannot inflate or corrupt the measurement. Retry a segfaulting suite so the gate is
## not flaky-red for no code reason; fail loud only if it crashes on EVERY attempt.
## Bounded by COVERAGE_SEGV_RETRIES.
## BEGIN-EXTRACT run_suite_under_coverage (the canary test sources this block by sentinel)
run_suite_under_coverage() {  ## $1 = suite .py path -> returns the final rc
   local suite_path="$1" attempt rc=0 retries
   ## Coerce COVERAGE_SEGV_RETRIES to a positive integer (default 5). An unset/empty/
   ## non-numeric/<1 value would leave the C-style loop unentered, so rc would be unbound
   ## and `return "${rc}"` would abort under nounset; rc is pre-set to 0 for the same
   ## reason -- a defined "nothing crashed" result if the body never runs.
   retries="${COVERAGE_SEGV_RETRIES:-5}"
   case "${retries}" in
      ''|*[!0-9]*)
         retries=5
         ;;
   esac
   ## Force base-10: a leading-zero all-digit value (e.g. 09) is a VALID string but an
   ## INVALID octal literal, so a bare (( )) / [ -ge ] on it errors and -- under errexit --
   ## would skip the retry loop and return rc=0 without running the suite (a false green).
   retries="$(( 10#${retries} ))"
   [ "${retries}" -ge 1 ] || retries=5
   ## Upper clamp: a pathological huge value would otherwise spin the retry loop for a
   ## genuinely-crashing suite far past any sane bound. 20 retries is already generous.
   [ "${retries}" -le 20 ] || retries=20
   for (( attempt=1; attempt<=retries; attempt++ )); do
      rc=0
      ## Each attempt gets its OWN headless-Wayland compositor (wl-headless-run mints a private
      ## XDG_RUNTIME_DIR + wayland socket and tears them down on exit), so parallel suites never
      ## contend for one compositor's socket and a retried suite starts from a fresh compositor.
      "${wl_headless_run}" --no-autoconfirm -- \
         python3 -m coverage run --parallel-mode --source="${pkg}" -- \
            "${suite_path}" || rc="$?"
      [ "${rc}" = '139' ] || return "${rc}"
      printf '%s\n' "secure-terminal-tests-coverage: $(basename -- "${suite_path}" .py) SIGSEGV (attempt ${attempt}/${retries}); known Qt-IPC/SIGCHLD race under coverage, retrying" >&2
   done
   return "${rc}"
}
## END-EXTRACT run_suite_under_coverage

python3 -m coverage erase
## Run every suite under coverage IN PARALLEL via the shared dispatch (run_suites_parallel):
## each suite gets its OWN headless-Wayland compositor + XDG config/state isolation, throttled by
## the core/RAM-aware job cap (COVERAGE_SUITE_JOBS overrides). run_suite_under_coverage is the
## per-suite command (coverage run --parallel-mode, plus the SIGSEGV retry); --parallel-mode has
## each process write its OWN data file, so `coverage combine` below unions them regardless of
## finish order. Per-suite output is replayed in canonical order and the rc judged after the barrier.
suites=(test_mainwin test_mainwin2 test_mainwin3 test_mainwin4 test_mainwin5 \
        test_secure_terminal test_fuzz test_fuzz_harnesses \
        test_corpus test_invariants test_cli test_unicode_tag test_modules \
        test_review test_widget test_widget2 test_alt_reenter test_tabbar_polish \
        test_state_dump test_sclip test_clipboard_watch)
suite_paths=()
for suite in "${suites[@]}"; do
   ## A registered suite MISSING from the checkout is a packaging/rename bug, never a
   ## legitimate skip -- fail closed (as the plain runner does) so a dropped suite cannot
   ## silently shrink the coverage gate and read as a clean pass (the same silent-drop
   ## class assert_gated_globs_resolve already guards for the module globs).
   if [ ! -f "${tests_dir}/${suite}.py" ]; then
      printf '%s\n' "secure-terminal-tests-coverage: FATAL: registered suite missing from checkout: ${suite}.py" >&2
      exit 1
   fi
   suite_paths+=("${tests_dir}/${suite}.py")
done

run_suites_parallel "${work}" "${pkg}" "${COVERAGE_SUITE_JOBS:-}" \
   run_suite_under_coverage "${suite_paths[@]}"

## run_suites_parallel already replayed each suite's output in canonical order; here just fail on
## the FIRST suite whose rc is not 0/77. A MISSING rc file (a job killed before it recorded one)
## counts as FAILURE (fail-closed), never a silent green. exit 77 (SKIP, e.g. Qt absent) is not a
## failure here; the Qt-free gated tier does not depend on those suites.
gate_fail_rc=0
gate_fail_suite=''
for suite in "${suites[@]}"; do
   [ -f "${tests_dir}/${suite}.py" ] || continue
   suite_rc="$(cat "${work}/rc-${suite}" 2>/dev/null || true)"
   [ -n "${suite_rc}" ] || suite_rc='1'
   if [ "${suite_rc}" != '0' ] && [ "${suite_rc}" != '77' ] \
         && [ "${gate_fail_rc}" = '0' ]; then
      gate_fail_rc="${suite_rc}"
      gate_fail_suite="${suite}"
   fi
done
if [ "${gate_fail_rc}" != '0' ]; then
   printf '%s\n' "secure-terminal-tests-coverage: suite ${gate_fail_suite} failed (exit ${gate_fail_rc})" >&2
   exit "${gate_fail_rc}"
fi
## Debug (opt-in, COVERAGE_DEBUG_MISSING=1): `coverage combine` CONSUMES the per-suite parallel
## data files, so copy them aside FIRST. cov-debug-missing.py then cross-checks a MANUAL union
## of them against combine's result -- telling a real gap (no suite recorded the line) from a
## combine/measurement DROP (a suite recorded it, combine lost it) in a SINGLE run -- and its
## greppable DEBUG-MISSING summary, compared across runs, tells a flaky line (varies) from a
## constant gap. Nothing to recall and no cost on a normal run: the block is skipped when unset.
cov_dbg_dir=''
if [ -n "${COVERAGE_DEBUG_MISSING:-}" ]; then
   cov_dbg_dir="${COVERAGE_DEBUG_DIR:-${work}/cov-debug}"
   mkdir --parents -- "${cov_dbg_dir}/raw"
   cp --preserve -- "${work}"/.coverage.* "${cov_dbg_dir}/raw/" 2>/dev/null || true
fi

python3 -m coverage combine

if [ -n "${COVERAGE_DEBUG_MISSING:-}" ]; then
   printf '%s\n' '' '== DEBUG: coverage miss attribution (COVERAGE_DEBUG_MISSING) =='
   ## Runs BEFORE the enforcing reports below, which abort under errexit on <100% -- so the
   ## attribution is printed even (especially) when the gate is about to fail. Best-effort.
   python3 "$(dirname -- "${wl_headless_run}")/cov-debug-missing.py" \
      "${COVERAGE_FILE}" "${cov_dbg_dir}/raw" "${pkg}" || true
fi

printf '%s\n' '' '== gated modules, Qt-free (must be 100%) =='
python3 -m coverage report --include="${gated_free}" --show-missing --fail-under=100

printf '%s\n' '' '== gated modules, Qt widget (must be 100%) =='
python3 -m coverage report --include="${gated_qt}" --show-missing --fail-under=100

## The GUI fuzzer (fuzz_widget.py), driven deterministically by test_fuzz_widget,
## is itself enforced at 100% SELF-coverage -- the live-widget fuzz harness must
## carry no dead code (its --source is the harness, in its own coverage file, not
## the package).
if [ -f "${tests_dir}/test_fuzz_widget.py" ]; then
   printf '%s\n' '' '== GUI fuzzer harness (must be 100%) =='
   fuzz_cov="${work}/.cov-fuzz-gui"
   fuzz_rc=0
   ( cd "${tests_dir}" \
      && COVERAGE_FILE="${fuzz_cov}" "${wl_headless_run}" --no-autoconfirm -- \
            python3 -m coverage run --source=fuzz_widget -- test_fuzz_widget.py ) || fuzz_rc="$?"
   if [ "${fuzz_rc}" != '0' ] && [ "${fuzz_rc}" != '77' ]; then
      printf '%s\n' "secure-terminal-tests-coverage: GUI fuzzer failed (exit ${fuzz_rc})" >&2
      exit "${fuzz_rc}"
   fi
   ## Only report coverage when the fuzzer actually RAN (rc 0). On a SKIP (rc 77, e.g. pyte
   ## absent) there is no data file, so an unconditional --fail-under=100 report would abort
   ## the whole gate under errexit with an opaque "No data to report" instead of a clean skip.
   if [ "${fuzz_rc}" = '0' ]; then
      COVERAGE_FILE="${fuzz_cov}" python3 -m coverage report \
         --include='*fuzz_widget.py' --show-missing --fail-under=100
   fi
fi

## Formal verification (Z3 + exhaustive enumeration) as MUST-PASS. The coverage
## suites above do NOT run it, so a feed_line_edits / sanitizer change that desyncs
## the coupled reference models (test_corpus oracle, verify_formal Z3 model, the
## absint INV) would pass the coverage gate while failing the proofs -- coverage-green
## but formally-red, exactly the false-confidence this closes. Pass/fail only (they
## validate models, they do not drive package coverage). A MISSING proof file is a
## fail-closed FATAL, never a silent skip.
for verify_suite in verify_formal verify_formal_absint; do
   if [ ! -f "${tests_dir}/${verify_suite}.py" ]; then
      printf '%s\n' "secure-terminal-tests-coverage: ${verify_suite}.py missing -- formal proof cannot run (fail closed)" >&2
      exit 1
   fi
   printf '%s\n' '' "== formal proof: ${verify_suite} (must pass) =="
   verify_rc=0
   ( cd "${tests_dir}" && python3 "${verify_suite}.py" ) || verify_rc="$?"
   if [ "${verify_rc}" != '0' ]; then
      printf '%s\n' "secure-terminal-tests-coverage: ${verify_suite} failed (exit ${verify_rc}) -- a coupled reference model is out of sync with feed_line_edits/sanitize" >&2
      exit "${verify_rc}"
   fi
done

printf '%s\n' '' '== whole-package coverage =='
python3 -m coverage report || true
