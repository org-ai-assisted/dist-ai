#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Coverage gate for secure-terminal. Runs every test suite under coverage.py
## and ENFORCES 100% line coverage on the whole package -- both the Qt-free core
## (sanitizer, CLI wrapper, command-hook protocol, IPC framing, session
## persistence, drop-in settings) and the Qt GUI (review, terminal, main). A
## failure here means a line became unreachable by the tests -- add a test (do
## not paper over it with a blanket exclusion; the few genuinely-unreachable
## defensive/optional-dependency lines carry a justified `# pragma: no cover` in
## the source instead).
##
## SKIPs (exit 77) when secure_terminal or python3-coverage is unavailable.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d '/usr/share/secure-terminal-tests' ]; then
   tests_dir='/usr/share/secure-terminal-tests'
else
   tests_dir="${script_dir}/../share/secure-terminal-tests"
fi

repo=''
[ -v SECURE_TERMINAL_REPO ] || SECURE_TERMINAL_REPO=''
if [ -n "${SECURE_TERMINAL_REPO}" ]; then
   repo="${SECURE_TERMINAL_REPO}"
elif [ -d "${HOME}/private-sources/secure-terminal/usr/lib/python3/dist-packages/secure_terminal" ]; then
   repo="${HOME}/private-sources/secure-terminal"
elif [ -d "${script_dir}/../../../../secure-terminal/usr/lib/python3/dist-packages/secure_terminal" ]; then
   repo="${script_dir}/../../../../secure-terminal"
fi

if [ -z "${repo}" ] || [ ! -d "${repo}/usr/lib/python3/dist-packages/secure_terminal" ]; then
   printf 'secure-terminal-tests-coverage: SKIP (secure_terminal not found; set SECURE_TERMINAL_REPO)\n' >&2
   exit 77
fi

if ! python3 -c 'import coverage' 2>/dev/null; then
   printf 'secure-terminal-tests-coverage: SKIP (python3-coverage not installed)\n' >&2
   exit 77
fi

export PYTHONPATH="${repo}/usr/lib/python3/dist-packages${PYTHONPATH:+:${PYTHONPATH}}"
pkg="${repo}/usr/lib/python3/dist-packages/secure_terminal"

work="$(mktemp --directory)"
cleanup() { safe-rm --recursive --force -- "${work}" 2>/dev/null || true; }
trap cleanup EXIT
export COVERAGE_FILE="${work}/.coverage"

## Ratchet-gated modules, in two tiers. As a module reaches full coverage it is
## added here so coverage can only go up. Each is genuinely 100% -- the few
## unreachable defensive lines (post-fork/pre-exec, EINTR retries) carry a
## justified `# pragma: no cover` in the source, not a blanket exclusion.
##
## Tier 1 -- covered by the Qt-FREE suites.
gated_free='*/__init__.py,*/sanitize.py,*/cli.py,*/hook.py,*/ipc.py,*/session.py,*/settings.py,*/preflight.py'
## Tier 2 -- covered by the offscreen Qt widget suites, which fail closed
## (exit 1) on a missing PyQt6/pyte rather than skipping, so both tiers are
## always gated.
gated_qt='*/review.py,*/terminal.py,*/main.py'

## Both tiers are validated BEFORE the suites run: these checks need only the
## source tree, and a stale gate should cost a second, not a full test run.
##
## `coverage report --include` silently ignores a pattern that matches nothing,
## so a renamed module drops out of the gate with no error and no coverage loss
## on the report. Assert every gated pattern still names a real source file.
assert_gated_globs_resolve() {
   local tier="$1"
   local globs="$2"
   local patterns=()
   local pattern
   local module_name
   IFS=',' read -r -a patterns <<< "${globs}"
   for pattern in "${patterns[@]}"; do
      module_name="${pattern##*/}"
      if [ ! -f "${pkg}/${module_name}" ]; then
         printf 'secure-terminal-tests-coverage: gated %s pattern %s names no file in %s -- module renamed or removed; update the gate\n' \
            "${tier}" "${pattern}" "${pkg}" >&2
         exit 1
      fi
   done
}

## Every module in the package must appear in a tier, so a NEW module cannot
## slip in ungated -- the gate must be a deliberate decision, not an omission.
assert_every_module_gated() {
   local all_gated=",${gated_free},${gated_qt},"
   local source_file
   local module_name
   for source_file in "${pkg}"/*.py; do
      module_name="${source_file##*/}"
      case "${all_gated}" in
         *",*/${module_name},"*) ;;
         *)
            printf 'secure-terminal-tests-coverage: module %s is in NO coverage tier -- add it to gated_free or gated_qt\n' \
               "${module_name}" >&2
            exit 1
            ;;
      esac
   done
}

assert_gated_globs_resolve 'Qt-free' "${gated_free}"
assert_gated_globs_resolve 'Qt widget' "${gated_qt}"
assert_every_module_gated

## Run every suite under coverage. --parallel-mode + combine keeps each suite's
## (and any forked child's) data in its own file, then merges them. The Qt
## suites run on the offscreen platform and fail closed (exit 1) when PyQt6 or
## pyte is missing -- a security-relevant suite must never silently disable
## itself -- so both tiers below are always gated.
export QT_QPA_PLATFORM=offscreen
python3 -m coverage erase
for suite in test_secure_terminal test_fuzz test_corpus test_cli test_modules \
             test_review test_mainwin test_widget; do
   [ -f "${tests_dir}/${suite}.py" ] || continue
   rc=0
   python3 -m coverage run --parallel-mode --source="${pkg}" -- \
      "${tests_dir}/${suite}.py" || rc="$?"
   ## exit 77 (SKIP, e.g. Qt absent for a widget suite) is not a failure here;
   ## the Qt-free gated tier does not depend on those suites. Any other non-zero
   ## is fatal.
   if [ "${rc}" != '0' ] && [ "${rc}" != '77' ]; then
      printf 'secure-terminal-tests-coverage: suite %s failed (exit %s)\n' \
         "${suite}" "${rc}" >&2
      exit "${rc}"
   fi
done
python3 -m coverage combine


printf '\n== gated modules, Qt-free (must be 100%%) ==\n'
python3 -m coverage report --include="${gated_free}" --show-missing --fail-under=100

printf '\n== gated modules, Qt widget (must be 100%%) ==\n'
python3 -m coverage report --include="${gated_qt}" --show-missing --fail-under=100

## The GUI fuzzer (fuzz_widget.py), driven deterministically by test_fuzz_widget,
## is itself enforced at 100% SELF-coverage -- the live-widget fuzz harness must
## carry no dead code (its --source is the harness, in its own coverage file, not
## the package).
if [ -f "${tests_dir}/test_fuzz_widget.py" ]; then
   printf '\n== GUI fuzzer harness (must be 100%%) ==\n'
   fuzz_cov="${work}/.cov-fuzz-gui"
   fuzz_rc=0
   ( cd "${tests_dir}" \
      && COVERAGE_FILE="${fuzz_cov}" python3 -m coverage run \
            --source=fuzz_widget -- test_fuzz_widget.py ) || fuzz_rc="$?"
   if [ "${fuzz_rc}" != '0' ] && [ "${fuzz_rc}" != '77' ]; then
      printf 'secure-terminal-tests-coverage: GUI fuzzer failed (exit %s)\n' \
         "${fuzz_rc}" >&2
      exit "${fuzz_rc}"
   fi
   COVERAGE_FILE="${fuzz_cov}" python3 -m coverage report \
      --include='*fuzz_widget.py' --show-missing --fail-under=100
fi

printf '\n== whole-package coverage ==\n'
python3 -m coverage report || true
