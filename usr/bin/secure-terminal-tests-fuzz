#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Heavy randomized fuzz run of secure-terminal's untrusted-input parsers: the
## output renderer and raw-byte decoder, the line-mode logical-cell editor and
## its renderers, the per-cell TUI sanitizer, the SGR colour parser, the paste
## sanitizers/classifiers, the title sanitizer, the config drop-in parser, the
## session loader, the IPC frame reassembler, the hook rules/gate parsers, the hook
## SUBPROCESS protocol (message/suggestion sanitizers + the verdict evaluator, with
## the handler mocked), and the secure-terminal-cli argument parser.
## An ESCAPE-BIASED generator keeps trying to smuggle a dangerous code point
## past the sanitizer; every iteration is checked against an independent
## terminal-safety oracle and per-function invariants. Override with
## --iterations N / --seed N; a failure prints the seed to replay. Same target
## resolution and SECURE_TERMINAL_REPO override as secure-terminal-tests; the
## checkout IS the target under test, so an absent checkout is FATAL (exit 1)
## unless the caller authorized the skip (DIST_AI_SKIP_AUTHORIZED=1), in which
## case it SKIPs (exit 77).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/secure-terminal-tests" ]; then
   tests_dir="${script_dir}/../share/secure-terminal-tests"
else
   tests_dir='/usr/share/secure-terminal-tests'
fi

repo=''
[ -v SECURE_TERMINAL_REPO ] || SECURE_TERMINAL_REPO=''
if [ -n "${SECURE_TERMINAL_REPO}" ]; then
   repo="${SECURE_TERMINAL_REPO}"
elif [ -d "${HOME}/private-sources/secure-terminal/usr/lib/python3/dist-packages/secure_terminal" ]; then
   repo="${HOME}/private-sources/secure-terminal"
elif [ -d "${script_dir}/../../../../secure-terminal/usr/lib/python3/dist-packages/secure_terminal" ]; then
   repo="${script_dir}/../../../../secure-terminal"
fi

if [ -z "${repo}" ] || [ ! -d "${repo}/usr/lib/python3/dist-packages/secure_terminal" ]; then
   ## The secure_terminal checkout IS the target under test. Absent, there is nothing to
   ## test -- but a bare SKIP reads green, so an absent target is FATAL unless the run that
   ## invoked us authorized the skip: DIST_AI_SKIP_AUTHORIZED=1, which dist-ai-tests-all
   ## sets for a --allow-skip'd (or lenient non-strict) run. The gate/CI env always provides
   ## the checkout, so there it simply runs; a standalone or unauthorized run FATALs.
   if [ "${DIST_AI_SKIP_AUTHORIZED:-}" = '1' ]; then
      printf '%s\n' 'secure-terminal-tests-fuzz: SKIP (secure_terminal not found; set SECURE_TERMINAL_REPO) [authorized]' >&2
      ## style-ok: allow-skip: target checkout absent AND the skip was authorized by the orchestrator
      exit 77
   fi
   printf '%s\n' 'secure-terminal-tests-fuzz: FATAL: secure_terminal not found; set SECURE_TERMINAL_REPO (unauthorized absent-target skip)' >&2
   exit 1
fi

export PYTHONPATH="${repo}/usr/lib/python3/dist-packages${PYTHONPATH:+:${PYTHONPATH}}"

iterations='40000'

## Run the fuzzer as a child and forward its exit code (no exec / process
## replacement). errexit propagates a non-zero status as this script's own.
"${tests_dir}/fuzz_secure_terminal.py" \
   --iterations "${iterations}" "$@"
