#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Guards the SMBIOS-reader GRUB block against drift between its two copies.
##
## derivative-maker boots two ways and each has its OWN copy of the reader:
##   disk: packages/kicksecure/vm-config-dist/etc/grub.d/01_smbios-reader
##         (grub-mkconfig emits it into the image's grub.cfg)
##   iso:  live-build-data/grub-config/smbios-reader.cfg
##         (3600_convert-raw-to-iso appends it into config.cfg; grub-mkconfig
##          output never reaches the ISO bootloader, only its 'linux' line is
##          scraped)
##
## They cannot be merged, so they are asserted equal instead. Drift here is not
## cosmetic: without the serial/timeout block a headless boot-tester injecting a
## cmdline via SMBIOS gets a GRUB menu on a dead video console, a 0-byte serial
## log and a timeout.
##
## Also guards the security properties the reader depends on: it is opt-in on both
## boot paths (a released image carries no reader), and where it IS built in, the
## serial number is read only inside the QEMU gate.
##
## Checkout: DERIVATIVE_MAKER_DIR, else ~/derivative-maker. Either file can be
## pointed elsewhere with DM_SMBIOS_DISK_FILE / DM_SMBIOS_ISO_FILE (the disk copy
## lives in a submodule, so a bare worktree does not carry it). A missing checkout
## or file is a FAILURE, not a skip.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

[ -v DERIVATIVE_MAKER_DIR ] || DERIVATIVE_MAKER_DIR="${HOME}/derivative-maker"

[ -v DM_SMBIOS_DISK_FILE ] || DM_SMBIOS_DISK_FILE="${DERIVATIVE_MAKER_DIR}/packages/kicksecure/vm-config-dist/etc/grub.d/01_smbios-reader"
[ -v DM_SMBIOS_ISO_FILE ]  || DM_SMBIOS_ISO_FILE="${DERIVATIVE_MAKER_DIR}/live-build-data/grub-config/smbios-reader.cfg"

[ -v DM_SMBIOS_CMDLINE_FILE ] || DM_SMBIOS_CMDLINE_FILE="${DERIVATIVE_MAKER_DIR}/packages/kicksecure/vm-config-dist/etc/default/grub.d/99_smbios-cmdline.cfg"

disk_file="${DM_SMBIOS_DISK_FILE}"
iso_file="${DM_SMBIOS_ISO_FILE}"
cmdline_file="${DM_SMBIOS_CMDLINE_FILE}"

failures=0
checks=0

check_pass() {
   checks=$(( checks + 1 ))
   printf '%s\n' "PASS  ${1}"
}

check_fail() {
   checks=$(( checks + 1 ))
   failures=$(( failures + 1 ))
   printf '%s\n' "FAIL  ${1}"
   [ "$#" -lt 2 ] || printf '%s\n' "${2}"
}

## The GRUB directives only, so a comment reworded on one side is not drift:
## everything between the sentinel comments, minus comments, blanks and indent.
##
## Delimited by explicit markers rather than by 'first insmod regexp to first fi':
## the reader now nests an 'if' (the QEMU gate) inside the block, so a range ending
## at the first 'fi' silently stops half way and compares a PREFIX of each copy --
## which still reports "identical" while leaving the rest unguarded.
## '|| true': with the markers absent every grep matches nothing, and under
## errexit+pipefail the empty pipeline would abort the whole suite silently rather
## than let the "reader block not found" check below report it.
extract_block() {
   sed -n '/dm-smbios-reader: begin/,/dm-smbios-reader: end/p' -- "$1" \
      | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' \
      | grep -vE '^#' \
      | grep -vE '^$' \
      || true
}

## 77, not 1: dist-ai-tests-all's contract is "a suite that cannot find its
## target exits 77 and is reported SKIP", and an UNAUTHORIZED 77 still fails the
## run -- so this loses no strictness, it just stops reporting "the readers have
## drifted" when the truth is "the reader was never checked out". The disk half
## lives in the vm-config-dist SUBMODULE, and the dist-ai-tests CI job checks out
## the component repo alone, so this is the normal state there.
for f in "${disk_file}" "${iso_file}"; do
   if [ ! -r "${f}" ]; then
      printf '%s\n' "SKIP: missing SMBIOS reader: ${f}" >&2
      printf '%s\n' "set DERIVATIVE_MAKER_DIR if the checkout lives elsewhere, or check out the vm-config-dist submodule" >&2
      exit 77
   fi
done

disk_block="$(extract_block "${disk_file}")"
iso_block="$(extract_block "${iso_file}")"

if [ -z "${disk_block}" ]; then
   check_fail "disk reader block not found in ${disk_file}"
elif [ -z "${iso_block}" ]; then
   check_fail "iso reader block not found in ${iso_file}"
elif [ "${disk_block}" = "${iso_block}" ]; then
   check_pass "disk and iso SMBIOS reader blocks are identical"
else
   check_fail "disk and iso SMBIOS reader blocks have DRIFTED" \
      "$(diff <(printf '%s\n' "${disk_block}") <(printf '%s\n' "${iso_block}") || true)"
fi

## Each directive earns its place, so assert them by name rather than trusting
## that two identical copies are both correct.
##   insmod serial          -- do not rely on command.lst autoloading it
##   set dm_smbios_oem=     -- smbios/regexp leave the vars untouched on no-match
##   set dm_smbios_extra=      and GRUB vars survive load_env
##   serial --unit=0        -- put GRUB's own output on the line the tester reads
##   terminal_output serial -- ...
##   set timeout=0          -- the tester cannot press a key to leave the menu
##   set dm_smbios_vendor=  -- same pre-clearing, for the gate's own variable
##   smbios --type 1 --get-string 4 -- the QEMU gate reads Manufacturer
for required in \
   'insmod serial' \
   'set dm_smbios_vendor=' \
   'set dm_smbios_oem=' \
   'set dm_smbios_extra=' \
   'smbios --type 1 --get-string 4 --set dm_smbios_vendor' \
   'smbios --type 1 --get-string 7 --set dm_smbios_oem' \
   'serial --unit=0' \
   'terminal_output serial' \
   'set timeout=0'
do
   for pair in "disk:${disk_file}" "iso:${iso_file}"; do
      name="${pair%%:*}"
      path="${pair#*:}"
      if grep -qF -- "${required}" "${path}"; then
         check_pass "${name}: has '${required}'"
      else
         check_fail "${name}: MISSING '${required}' in ${path}"
      fi
   done
done

## The gate is conditional on injection; an unconditional serial switch would
## change every normal boot.
for pair in "disk:${disk_file}" "iso:${iso_file}"; do
   name="${pair%%:*}"
   path="${pair#*:}"
   if grep -qE '^[[:space:]]*if \[ -n "\$\{dm_smbios_extra\}" \]; then' -- "${path}"; then
      check_pass "${name}: serial block is gated on dm_smbios_extra"
   else
      check_fail "${name}: serial block is NOT gated on dm_smbios_extra in ${path}"
   fi
done

## ORDER, not mere presence: the serial number must be read INSIDE the QEMU gate.
## Both lines existing proves nothing -- a reader that reads offset 7 first and
## consults the manufacturer afterwards passes every grep above while doing exactly
## what the gate exists to prevent.
gate_precedes_serial_read() {
   local name="${1}"
   local path="${2}"
   local -a block=()
   local line
   local index=0
   local gate_index=-1
   local read_index=-1

   mapfile -t block < <(extract_block "${path}")

   for line in "${block[@]}"; do
      case "${line}" in
         'if [ "${dm_smbios_vendor}" = "QEMU" ]; then')
            [ "${gate_index}" -ge 0 ] || gate_index="${index}"
            ;;
         'smbios --type 1 --get-string 7 --set dm_smbios_oem')
            [ "${read_index}" -ge 0 ] || read_index="${index}"
            ;;
      esac
      index=$(( index + 1 ))
   done

   if [ "${gate_index}" -lt 0 ]; then
      check_fail "${name}: QEMU gate 'if [ \"\${dm_smbios_vendor}\" = \"QEMU\" ]; then' MISSING in ${path}"
   elif [ "${read_index}" -lt 0 ]; then
      check_fail "${name}: serial-number read MISSING in ${path}"
   elif [ "${gate_index}" -lt "${read_index}" ]; then
      check_pass "${name}: serial number is read inside the QEMU gate"
   else
      check_fail "${name}: serial number is read BEFORE the QEMU gate in ${path}" \
         "gate at block line $(( gate_index + 1 )), read at block line $(( read_index + 1 ))"
   fi
}

gate_precedes_serial_read disk "${disk_file}"
gate_precedes_serial_read iso "${iso_file}"

## Opt-in, default OFF, on both boot paths: a RELEASED image must carry no reader
## and no placeholder, so no firmware-supplied string can reach the kernel command
## line. Presence of the gate is the security property; the QEMU check above only
## narrows an image that was deliberately built with the reader.
##
## Each entry is 'description|file|extended regexp'.
optin_checks=(
   "disk reader is guarded by GRUB_ENABLE_DM_SMBIOS_READER|${disk_file}|GRUB_ENABLE_DM_SMBIOS_READER"
   "disk reader exits when not enabled|${disk_file}|^[[:space:]]*exit 0\$"
   "cmdline fragment is guarded|${cmdline_file}|GRUB_ENABLE_DM_SMBIOS_READER:-.*=.*true"
   "cmdline fragment exports the variable to the grub.d helpers|${cmdline_file}|^[[:space:]]*export GRUB_ENABLE_DM_SMBIOS_READER\$"
   "build option --smbios-reader exists|${DERIVATIVE_MAKER_DIR}/help-steps/parse-cmd|--smbios-reader\\)"
   "build option defaults to false|${DERIVATIVE_MAKER_DIR}/help-steps/variables|dist_build_smbios_reader=\"false\""
   "disk build writes the drop-in only when enabled|${DERIVATIVE_MAKER_DIR}/build-steps.d/3500_install-packages|dist_build_smbios_reader:-.*=.*true"
   "iso build gates the reader and the placeholder|${DERIVATIVE_MAKER_DIR}/build-steps.d/3600_convert-raw-to-iso|dist_build_smbios_reader:-.*=.*true"
)

for entry in "${optin_checks[@]}"; do
   description="${entry%%|*}"
   remainder="${entry#*|}"
   target_file="${remainder%%|*}"
   pattern="${remainder#*|}"
   if [ ! -r "${target_file}" ]; then
      check_fail "${description}: unreadable ${target_file}"
   elif grep -qE -- "${pattern}" "${target_file}"; then
      check_pass "${description}"
   else
      check_fail "${description}: pattern not found in ${target_file}" "${pattern}"
   fi
done

## The ISO placeholder must not be unconditional. 3600 builds it into a variable
## that stays empty unless the build opted in, so a bare '${dm_smbios_extra}' left
## inline on the --bootappend-live line would defeat the gate while every check
## above still passed.
iso_build_file="${DERIVATIVE_MAKER_DIR}/build-steps.d/3600_convert-raw-to-iso"
if [ ! -r "${iso_build_file}" ]; then
   check_fail "missing ${iso_build_file}"
elif grep -qE -- '^[[:space:]]*--bootappend-live .*dm_smbios_extra' "${iso_build_file}"; then
   check_fail "iso: --bootappend-live carries the placeholder UNCONDITIONALLY in ${iso_build_file}" \
      "$(grep -nE -- '^[[:space:]]*--bootappend-live ' "${iso_build_file}" || true)"
else
   check_pass "iso: --bootappend-live placeholder is behind the build option"
fi

## The placeholder must trail everything grub-mkconfig emits, or an injected
## parameter loses to the image's own: GRUB emits "${GRUB_CMDLINE_LINUX}
## ${GRUB_CMDLINE_LINUX_DEFAULT}", and the kernel takes the LAST occurrence. From
## GRUB_CMDLINE_LINUX the injection is followed by 'loglevel=0 quiet', which
## silently defeated an injected loglevel.
if [ ! -r "${cmdline_file}" ]; then
   check_fail "missing ${cmdline_file}"
elif grep -qE '^[[:space:]]*GRUB_CMDLINE_LINUX_DEFAULT=.*dm_smbios_extra' -- "${cmdline_file}"; then
   check_pass "placeholder appended to GRUB_CMDLINE_LINUX_DEFAULT (lands last)"
else
   check_fail "placeholder NOT on GRUB_CMDLINE_LINUX_DEFAULT in ${cmdline_file}" \
      "$(grep -nE 'dm_smbios_extra' -- "${cmdline_file}" | tail -2 || true)"
fi

## Same nounset defence its neighbour 30_serial_console.cfg documents.
if grep -qE '^: "\$\{GRUB_CMDLINE_LINUX_DEFAULT:=' -- "${cmdline_file}"; then
   check_pass "cmdline fragment guards GRUB_CMDLINE_LINUX_DEFAULT for nounset"
else
   check_fail "cmdline fragment lacks the nounset guard in ${cmdline_file}"
fi

printf '%s\n' "" "${checks} checks, ${failures} failed"
[ "${failures}" -eq 0 ]
