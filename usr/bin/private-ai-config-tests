#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Core lane of the private-ai-config test surface: the container-safe tests --
## the tmux goal-chip parser, the secret-redactor date-shape gate, the
## safe-pkill and cowbuilder PreToolUse hooks, the git-hooks unicode/PII gates,
## and the injection corpus for the sandbox-run / qube-ctl / container-guard /
## sandbox-view argument parsers. No root, no network, no Qubes.
##
## Targets a private-ai-config checkout via PRIVATE_AI_CONFIG_PATH. Exits 77 (SKIP)
## when the checkout is unavailable. Extra arguments pass through to the tests.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/private-ai-config-tests" ]; then
   share="${script_dir}/../share/private-ai-config-tests"
else
   share='/usr/share/private-ai-config-tests'
fi

rc=0
bash -- "${share}/run-tests.sh" --lane core "$@" || rc=$?
exit "${rc}"
