#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Runs developer-meta-files' functional tests against the checkout:
##   * test_pre_push_static_style_rules.sh -- drives the real, shipped
##     dist-ai-style gate (dist-ai) and asserts its single-grep style checks
##     flag violations and spare compliant files;
##   * test_dm_review_branch.sh -- asserts dm-review-branch aborts on suspicious
##     unicode in a reviewed branch's commits AND in any ref name.
## Both resolve the developer-meta-files checkout from DMF_REPO (wired by
## dist-ai-tests-all via --component developer-meta-files --component-root).
## Every test FAILS CLOSED on a missing prerequisite. A skipped test reports
## green while never having run, which is worse than no test at all, so an
## absent helper (shellcheck, helper-scripts) is an environment defect.
## Works installed (/usr/share/developer-meta-files-tests) or from a checkout.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/developer-meta-files-tests" ]; then
   share="${script_dir}/../share/developer-meta-files-tests"
else
   share='/usr/share/developer-meta-files-tests'
fi

## DMF_REPO is NOT required here. Only test_dm_review_branch.sh has its subject
## in the developer-meta-files checkout; the rest drive tools dist-ai ships
## itself. Skipping the whole suite on an unset DMF_REPO reported green while
## running nothing -- including the style-gate tests that guard dist-ai's
## own gate. Each test decides for itself and self-skips (77) on an absent
## subject; 'ran == 0' below still reports SKIP rather than a pass over zero
## assertions.
if [ -n "${DMF_REPO:-}" ]; then
   export DMF_REPO
fi

## The dm-review-branch test drives helper-scripts' check-ref-*-for-unicode /
## unicode-show. When a helper-scripts checkout is wired, put its usr/bin on
## PATH (and export the var, which those tools use to source their own libs) so
## the test runs instead of skipping.
if [ -n "${HELPER_SCRIPTS_PATH:-}" ]; then
   export HELPER_SCRIPTS_PATH
   export PATH="${HELPER_SCRIPTS_PATH}/usr/bin:${PATH}"
   ## unicode-show (driven by check-ref-*-for-unicode) has a '-Bsu' shebang
   ## that excludes the user site, so from a checkout it needs its library on
   ## PYTHONPATH -- else it dies with ModuleNotFoundError and the review fails.
   export PYTHONPATH="${HELPER_SCRIPTS_PATH}/usr/lib/python3/dist-packages${PYTHONPATH:+:${PYTHONPATH}}"
fi

shopt -s nullglob
tests=( "${share}"/test_*.sh )
if [ "${#tests[@]}" -eq 0 ]; then
   printf '%s\n' "FATAL: developer-meta-files-tests: no test_*.sh under '${share}'." >&2
   exit 1
fi

## 0 = pass, 77 = SKIP, anything else = fail -- the same contract
## dist-ai-tests-all applies to suites, applied here to the tests inside one.
## 77 is reserved for an ABSENT SUBJECT: a test whose target does not exist
## cannot judge it, and failing instead gates unrelated PRs on a tool that was
## never shipped. A missing prerequisite of a subject that IS present stays a
## FATAL, so a broken dependency declaration still fails loudly.
failed=0
ran=0
skipped=0
for test_path in "${tests[@]}"; do
   test_name="$(basename -- "${test_path}")"
   rc=0
   "${test_path}" "$@" || rc="$?"
   case "${rc}" in
      0)
         ran=$(( ran + 1 ))
         printf 'developer-meta-files-tests: PASS %s\n' "${test_name}"
         ;;
      77)
         skipped=$(( skipped + 1 ))
         printf 'developer-meta-files-tests: SKIP %s\n' "${test_name}"
         ;;
      *)
         failed=$(( failed + 1 ))
         printf 'developer-meta-files-tests: FAIL %s (exit %s)\n' "${test_name}" "${rc}" >&2
         ;;
   esac
done

printf 'developer-meta-files-tests: %d passed, %d failed, %d skipped.\n' \
   "${ran}" "${failed}" "${skipped}"

if [ "${failed}" -gt 0 ]; then
   exit 1
fi
## Nothing actually ran: report SKIP rather than a pass over zero assertions.
if [ "${ran}" -eq 0 ]; then
   ## style-ok: allow-skip: no subject present -- absent subjects self-skip, not a pass
   exit 77
fi
exit 0
