#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## safe-pkill: pkill --full without the self-kill trap.
##
## 'pkill --full PATTERN' (and 'pgrep --full PATTERN | xargs kill') match against the WHOLE
## command line. So when the invoking shell's own argv contains PATTERN -- which it always does
## when PATTERN is written literally into the command that runs the kill -- the match includes
## that very shell AND its parents, killing the caller (and, in an agent, the claude process
## that spawned it). The tell is a shell dying with exit code 144 or the whole turn vanishing.
##
## safe-pkill matches other processes exactly like 'pkill --full', but first computes the
## CALLER'S OWN PROCESS ANCESTRY (this process + every ancestor up to PID 1) and refuses to
## signal anything in it. It therefore can never kill the shell -- or the claude -- that ran it.
## It also skips its own transient descendants (the pgrep helper). It protects the caller's
## ancestry ONLY: a genuinely separate process that matches PATTERN is still signalled (that is
## the point).
##
## LIMITATION: the protection is the caller's ancestry AT INVOCATION. If safe-pkill is launched
## DETACHED from the pattern-carrying shell -- via 'systemd-run' / 'bgjob-run' / 'setsid'
## etc. -- that shell is NOT an ancestor and is NOT protected. Run safe-pkill SYNCHRONOUSLY from
## the shell whose command line carries PATTERN. For a self-safe read-only match, 'pgrep --exact
## NAME' (process name, <= 15 chars) also cannot match a pattern buried in a long argv.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

usage() {
   cat -- <<'EOF'
Usage: safe-pkill [--signal SIG] [--name] [--dry-run] PATTERN

  --signal, -s SIG   signal to send (name or number, default TERM)
  --name             match the process NAME (pgrep --exact) instead of the full command line
  --dry-run, -n      list what WOULD be signalled (and what is protected), kill nothing
  --help, -h         this help

PATTERN is matched against the full command line (like 'pkill --full') unless --name is given.
The caller's own process and all its ancestors are ALWAYS excluded (see the LIMITATION about
detached invocation in the script header). Exit: 0 if >= 1 process was signalled, 1 if none
matched (after exclusions), 2 on a usage error or a pgrep pattern error.
EOF
}

## PPid of $1 read from /proc/PID/status (robust: no /proc/PID/stat comm-in-parens parsing).
proc_ppid() {
   local pid="$1" key val
   [ -r "/proc/${pid}/status" ] || return 1
   while IFS=$'\t' read -r key val; do
      if [ "${key}" = "PPid:" ]; then
         printf '%s' "${val}"
         return 0
      fi
   done < "/proc/${pid}/status"
   return 1
}

## True if $1 is this process or one of its descendants (walk its ancestry until $$, or PID
## 1/0). Used to drop safe-pkill's OWN transient children -- notably the pgrep helper, whose
## inherited argv contains PATTERN. Parentage-based, so unlike a process-NAME match it cannot be
## evaded by a rename and never skips an unrelated 'pgrep' / 'safe-pkill'.
is_own_descendant() {
   local p="$1"
   while [ -n "${p}" ] && [ "${p}" != "1" ] && [ "${p}" != "0" ]; do
      if [ "${p}" = "$$" ]; then
         return 0
      fi
      p="$(proc_ppid "${p}")" || return 1
   done
   return 1
}

signal='TERM'
match_mode='full'
dry_run='false'

while [ "$#" -gt 0 ]; do
   case "$1" in
      --signal|-s)
         if [ "$#" -lt 2 ]; then
            printf 'safe-pkill: --signal needs a value\n' >&2
            exit 2
         fi
         signal="$2"
         shift 2
         ;;
      --name)
         match_mode='name'
         shift
         ;;
      --full)
         match_mode='full'
         shift
         ;;
      --dry-run|-n)
         dry_run='true'
         shift
         ;;
      --help|-h)
         usage
         exit 0
         ;;
      --)
         shift
         break
         ;;
      '-'*)
         printf 'safe-pkill: unknown option: %s\n' "$1" >&2
         exit 2
         ;;
      *)
         break
         ;;
   esac
done

if [ "$#" -lt 1 ]; then
   printf 'safe-pkill: PATTERN required\n' >&2
   usage >&2
   exit 2
fi
pattern="$1"
shift
if [ "$#" -gt 0 ]; then
   printf 'safe-pkill: too many arguments -- exactly one PATTERN is allowed (got extra: %s)\n' "$*" >&2
   exit 2
fi

## Protected set: this process plus its whole ancestor chain up to PID 1. A pattern that
## matches the caller's argv (the trap) matches an ANCESTOR of safe-pkill, so excluding the
## ancestry is exactly what prevents the self-kill.
declare -A protected=()
protected["$$"]=1
walk="$$"
while [ "${walk}" != "1" ] && [ "${walk}" != "0" ] && [ -n "${walk}" ]; do
   ppid=''
   ppid="$(proc_ppid "${walk}")" || break
   [ -n "${ppid}" ] || break
   protected["${ppid}"]=1
   walk="${ppid}"
done

## Candidate PIDs. Forgive ONLY pgrep exit 1 (no match); exit 2 (syntax) / 3 (fatal) mean a bad
## pattern and must NOT be silently reported as "nothing matched".
pgrep_cmd=(pgrep --full)
if [ "${match_mode}" = 'name' ]; then
   pgrep_cmd=(pgrep --exact)
fi
pgrep_out=''
pgrep_rc=0
pgrep_out="$("${pgrep_cmd[@]}" -- "${pattern}")" || pgrep_rc="$?"
case "${pgrep_rc}" in
   0 | 1)
      true
      ;;
   *)
      printf 'safe-pkill: pgrep failed (exit %s) for pattern -- bad regex? : %s\n' "${pgrep_rc}" "${pattern}" >&2
      exit 2
      ;;
esac
candidates=()
if [ -n "${pgrep_out}" ]; then
   mapfile -t candidates <<< "${pgrep_out}"
fi

targets=()
skipped=()
for candidate in "${candidates[@]}"; do
   [ -n "${candidate}" ] || continue
   if [ -n "${protected["${candidate}"]:-}" ]; then
      skipped+=("${candidate}")
      continue
   fi
   ## Drop safe-pkill's own descendants (its pgrep helper carries PATTERN in argv).
   if is_own_descendant "${candidate}"; then
      continue
   fi
   targets+=("${candidate}")
done

if [ "${#targets[@]}" -eq 0 ]; then
   if [ "${#skipped[@]}" -gt 0 ]; then
      printf 'safe-pkill: only self/ancestors matched (protected, nothing killed): %s\n' "${skipped[*]}" >&2
   else
      printf 'safe-pkill: no process matched: %s\n' "${pattern}" >&2
   fi
   exit 1
fi

if [ "${dry_run}" = 'true' ]; then
   printf 'safe-pkill: DRY-RUN -- would send %s to: %s\n' "${signal}" "${targets[*]}"
   if [ "${#skipped[@]}" -gt 0 ]; then
      printf 'safe-pkill: protected (self/ancestors), would skip: %s\n' "${skipped[*]}"
   fi
   exit 0
fi

rc=0
signalled=()
for target in "${targets[@]}"; do
   if kill -s "${signal}" "${target}" 2>/dev/null; then
      signalled+=("${target}")
      continue
   fi
   ## kill failed: distinguish "already gone" (fine -- it is dead, which is the goal) from a
   ## real error such as EPERM (a LIVE process we may not signal -> non-zero exit).
   if kill -0 "${target}" 2>/dev/null; then
      printf 'safe-pkill: WARNING: could not signal live process %s (permission?)\n' "${target}" >&2
      rc=1
   fi
done
if [ "${#signalled[@]}" -gt 0 ]; then
   printf 'safe-pkill: sent %s to: %s\n' "${signal}" "${signalled[*]}"
else
   printf 'safe-pkill: no live target remained to signal (all matches had exited)\n' >&2
fi
if [ "${#skipped[@]}" -gt 0 ]; then
   printf 'safe-pkill: protected (self/ancestors), NOT killed: %s\n' "${skipped[*]}"
fi
exit "${rc}"
