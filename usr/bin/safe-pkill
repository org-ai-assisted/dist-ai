#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## safe-pkill: pkill --full without the self-kill trap.
##
## 'pkill --full PATTERN' (and 'pgrep --full PATTERN | xargs kill') match against the WHOLE
## command line. So when the invoking shell's own argv contains PATTERN -- which it always does
## when PATTERN is written literally into the command that runs the kill -- the match includes
## that very shell AND its parents, killing the caller (and, in an agent, the claude process
## that spawned it). The tell is a shell dying with exit code 144 or the whole turn vanishing.
##
## safe-pkill matches other processes exactly like 'pkill --full', but first computes the
## CALLER'S OWN PROCESS ANCESTRY (this process + every ancestor up to PID 1) and refuses to
## signal anything in it. It therefore can never kill the shell -- or the claude -- that ran it.
## It also skips its own transient descendants (the pgrep helper). It protects the caller's
## ancestry ONLY: a genuinely separate process that matches PATTERN is still signalled (that is
## the point).
##
## LIMITATION: the protection is the caller's ancestry AT INVOCATION. If safe-pkill is launched
## DETACHED from the pattern-carrying shell -- via 'systemd-run' / 'bgjob-run' / 'setsid'
## etc. -- that shell is NOT an ancestor and is NOT protected. Run safe-pkill SYNCHRONOUSLY from
## the shell whose command line carries PATTERN. For a self-safe read-only match, 'pgrep --exact
## NAME' (process name, <= 15 chars) also cannot match a pattern buried in a long argv.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## Shared generic-name denylist (refused as a kill target below). Same file used by safe-pgrep and
## the sandbox pkill/pgrep PATH shadow -- single source, no drift. DIST_AI_LIBEXEC_DIR overrides;
## otherwise resolve it RELATIVE to this script (../libexec/dist-ai) so a copy invoked from a
## checkout on PATH finds the checkout helper, not the hardcoded installed path. The installed
## /usr/bin/safe-pkill resolves to /usr/libexec/dist-ai, byte-identical to before.
_safe_libexec="${DIST_AI_LIBEXEC_DIR:-$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]:-$0}")")/../libexec/dist-ai}"
# shellcheck source=../libexec/dist-ai/generic-proc-names.bsh
source "${_safe_libexec}/generic-proc-names.bsh"
unset _safe_libexec

usage() {
   cat -- <<'EOF'
Usage: safe-pkill [--signal SIG] [--name] [--dry-run] PATTERN

  --signal, -s SIG   signal to send (name or number, default TERM)
  --name             match the process NAME (pgrep --exact) instead of the full command line
  --full, -f         match the full command line (default; -f accepted for pkill muscle-memory)
  --dry-run, -n      list what WOULD be signalled (and what is protected), kill nothing
  --help, -h         this help

PATTERN is matched against the full command line (like 'pkill --full') unless --name is given.
The caller's own process and all its ancestors are ALWAYS excluded (see the LIMITATION about
detached invocation in the script header). Exit: 0 if >= 1 process was signalled, 1 if none
matched (after exclusions), 2 on a usage error or a pgrep pattern error.
EOF
}

## PPid of $1 read from /proc/PID/status (robust: no /proc/PID/stat comm-in-parens parsing).
proc_ppid() {
   local pid="$1" key val
   [ -r "/proc/${pid}/status" ] || return 1
   while IFS=$'\t' read -r key val; do
      if [ "${key}" = "PPid:" ]; then
         printf '%s' "${val}"
         return 0
      fi
   done < "/proc/${pid}/status"
   return 1
}

## True if $1 is this process or one of its descendants (walk its ancestry until $$, or PID
## 1/0). Used to drop safe-pkill's OWN transient children -- notably the pgrep helper, whose
## inherited argv contains PATTERN. Parentage-based, so unlike a process-NAME match it cannot be
## evaded by a rename and never skips an unrelated 'pgrep' / 'safe-pkill'.
is_own_descendant() {
   local p="$1"
   while [ -n "${p}" ] && [ "${p}" != "1" ] && [ "${p}" != "0" ]; do
      if [ "${p}" = "$$" ]; then
         return 0
      fi
      p="$(proc_ppid "${p}")" || return 1
   done
   return 1
}

## Classify a FAILED kill so a live/hidden process is never misreported as "gone". Decide by
## kill's OWN errno MESSAGE (stable under the LC_ALL=C set above), NOT by /proc readability: an
## unreadable /proc/PID/stat is not proof the process exited -- under a hidepid /proc mount
## (standard on Kicksecure/Whonix) another UID's live process is invisible AND unsignalable, so
## treating "unreadable" as "gone" would report success while a matched, still-alive process was
## never signalled. Echoes exactly one word:
##   gone   -- ESRCH: the process exited between the pgrep snapshot and the kill (benign)
##   zombie -- dead, awaiting reaping (a foreign zombie can fail kill with EPERM; benign)
##   live   -- alive and unsignalable, OR hidden so we cannot tell -> caller MUST fail closed
## Pure: signals nothing; reads only /proc/PID/stat for the zombie sub-case. State is the first
## token after the LAST ')' (the comm may itself contain spaces and ')').
classify_kill_failure() {  ## $1=kill stderr, $2=target pid
   local kill_err="$1" pid="$2" proc_stat='' proc_state=''
   case "${kill_err}" in
      *'No such process'*)
         printf 'gone\n'
         return 0
         ;;
   esac
   proc_stat="$(cat -- "/proc/${pid}/stat" 2>/dev/null)" || proc_stat=""
   read -r proc_state _ <<<"${proc_stat##*)}"
   if [ "${proc_state}" = 'Z' ]; then
      printf 'zombie\n'
   else
      printf 'live\n'
   fi
}

signal='TERM'
match_mode='full'
name_flag='false'
full_flag='false'
dry_run='false'

while [ "$#" -gt 0 ]; do
   case "$1" in
      --signal|-s)
         if [ "$#" -lt 2 ]; then
            printf 'safe-pkill: --signal needs a value\n' >&2
            exit 2
         fi
         signal="$2"
         shift 2
         ;;
      --name)
         match_mode='name'
         name_flag='true'
         shift
         ;;
      ## -f accepted as an alias for --full: full-match is already the default, so -f is a
      ## no-op, but callers reach for it by reflex (pgrep -f / pkill -f); accepting it keeps that
      ## reflex from failing as an unknown-option usage error -- the trap these wrappers remove.
      -f|--full)
         match_mode='full'
         full_flag='true'
         shift
         ;;
      --dry-run|-n)
         dry_run='true'
         shift
         ;;
      --help|-h)
         usage
         exit 0
         ;;
      --)
         shift
         break
         ;;
      '-'*)
         printf 'safe-pkill: unknown option: %s\n' "$1" >&2
         exit 2
         ;;
      *)
         break
         ;;
   esac
done

## --name (process-name match) and --full/-f (command-line match) are mutually exclusive. Do
## NOT silently last-wins: a caller who picked --name for its narrower, self-safe matching and
## then reflexively appended -f (pkill -f habit) must not be downgraded to full-match without a
## word -- that quietly discards the safety they asked for. Fail closed on the contradiction.
if [ "${name_flag}" = 'true' ] && [ "${full_flag}" = 'true' ]; then
   printf 'safe-pkill: --name and --full/-f are mutually exclusive\n' >&2
   exit 2
fi

if [ "$#" -lt 1 ]; then
   printf 'safe-pkill: PATTERN required\n' >&2
   usage >&2
   exit 2
fi
pattern="$1"
shift
if [ "$#" -gt 0 ]; then
   printf 'safe-pkill: too many arguments -- exactly one PATTERN is allowed (got extra: %s)\n' "$*" >&2
   exit 2
fi
## An EMPTY or WHITESPACE-ONLY pattern matches EVERY process ('pgrep --full -- ""' matches all;
## '-- " "' matches every process whose argv contains a space, i.e. nearly all) -- the exact
## opposite of this tool's purpose. Reject both (a caller that interpolated an unset/blank "$VAR"
## hits this). A whitespace-only pattern also trims to the empty key in the generic-name check --
## caught here before it can reach that lookup.
if [[ "${pattern}" =~ ^[[:space:]]*$ ]]; then
   printf 'safe-pkill: PATTERN must not be empty or whitespace-only (it would match every process)\n' >&2
   exit 2
fi
## Refuse a bare GENERIC process name as the target. Ancestry exclusion does NOT help here: a
## generic name (sleep/cat/python3/...) matches UNRELATED processes in other sessions and the
## system tree, which are not the caller's ancestors -- a `pkill sleep` once killed the
## qubes-session `sleep inf` keepalive and wedged the VM GUI. Kill a specific PID/PGID instead.
if ! safe_proc_generic_override && safe_proc_is_generic "${pattern}"; then
   printf 'safe-pkill: refusing the generic process name "%s" as a target -- it matches OTHER sessions and system processes (this class once wedged the VM GUI by killing qubes-session sleep). Kill a specific process (kill PID; kill -- -PGID), or override with SAFE_PROC_ALLOW_GENERIC=1.\n' "${pattern}" >&2
   exit 2
fi
## Accept the 'kill -9' muscle-memory spelling: a signal is a bare NAME or NUMBER (TERM,
## SIGKILL, 9), never dash-prefixed, so strip a single leading '-' to turn '--signal -9' into
## the valid '9' (and '-KILL' into 'KILL'). Without this, kill rejects '-9' as an invalid
## signal spec even though it is the most common way an operator names SIGKILL.
signal="${signal#-}"
## Validate the (normalised) signal up front so a typo fails as a usage error (exit 2), not
## later as a kill failure misreported as a permission problem. '--' guards against a value
## that still begins with '-' (e.g. an empty result) being read by 'kill -l' as its own option.
if ! kill -l -- "${signal}" >/dev/null 2>&1; then
   printf 'safe-pkill: invalid signal: %s\n' "${signal}" >&2
   exit 2
fi

## Protected set: this process plus its whole ancestor chain up to PID 1. A pattern that
## matches the caller's argv (the trap) matches an ANCESTOR of safe-pkill, so excluding the
## ancestry is exactly what prevents the self-kill.
declare -A protected=()
protected["$$"]=1
walk="$$"
while [ "${walk}" != "1" ] && [ "${walk}" != "0" ] && [ -n "${walk}" ]; do
   ppid=''
   ppid="$(proc_ppid "${walk}")" || break
   [ -n "${ppid}" ] || break
   protected["${ppid}"]=1
   walk="${ppid}"
done

## Candidate PIDs. Forgive ONLY pgrep exit 1 (no match); exit 2 (syntax) / 3 (fatal) mean a bad
## pattern and must NOT be silently reported as "nothing matched".
pgrep_cmd=(pgrep --full)
if [ "${match_mode}" = 'name' ]; then
   pgrep_cmd=(pgrep --exact)
fi
pgrep_out=''
pgrep_rc=0
pgrep_out="$("${pgrep_cmd[@]}" -- "${pattern}")" || pgrep_rc="$?"
case "${pgrep_rc}" in
   0 | 1)
      true
      ;;
   *)
      printf 'safe-pkill: pgrep failed (exit %s) for pattern -- bad regex? : %s\n' "${pgrep_rc}" "${pattern}" >&2
      exit 2
      ;;
esac
candidates=()
if [ -n "${pgrep_out}" ]; then
   mapfile -t candidates <<< "${pgrep_out}"
fi

targets=()
skipped=()
for candidate in "${candidates[@]}"; do
   [ -n "${candidate}" ] || continue
   if [ -n "${protected["${candidate}"]:-}" ]; then
      skipped+=("${candidate}")
      continue
   fi
   ## Drop safe-pkill's own descendants (its pgrep helper carries PATTERN in argv).
   if is_own_descendant "${candidate}"; then
      continue
   fi
   targets+=("${candidate}")
done

if [ "${#targets[@]}" -eq 0 ]; then
   if [ "${#skipped[@]}" -gt 0 ]; then
      printf 'safe-pkill: only self/ancestors matched (protected, nothing killed): %s\n' "${skipped[*]}" >&2
   else
      printf 'safe-pkill: no process matched: %s\n' "${pattern}" >&2
   fi
   exit 1
fi

if [ "${dry_run}" = 'true' ]; then
   printf 'safe-pkill: DRY-RUN -- would send %s to: %s\n' "${signal}" "${targets[*]}"
   if [ "${#skipped[@]}" -gt 0 ]; then
      printf 'safe-pkill: protected (self/ancestors), would skip: %s\n' "${skipped[*]}"
   fi
   exit 0
fi

rc=0
signalled=()
unsignalled_live=()
for target in "${targets[@]}"; do
   kill_err=''
   if kill_err="$(kill -s "${signal}" "${target}" 2>&1)"; then
      signalled+=("${target}")
      continue
   fi
   ## kill failed. 'gone'/'zombie' are dead (the goal -- silent). 'live' is alive-or-hidden:
   ## WARN so a survivor is never hidden (honesty), and remember it for the exit-code decision.
   ## The WARNING -- not the exit code -- is what keeps a survivor from passing silently.
   if [ "$(classify_kill_failure "${kill_err}" "${target}")" = 'live' ]; then
      printf 'safe-pkill: WARNING: could not signal process %s (still alive, or hidden by /proc permissions)\n' "${target}" >&2
      unsignalled_live+=("${target}")
   fi
done
## Exit code follows the DOCUMENTED contract: 0 iff >= 1 process was signalled. A 'live'
## survivor is reported through the WARNING above, NOT the exit code -- so a caller is not driven
## to a broader fallback kill (the cross-session hazard) merely because ONE matched target was
## unsignalable while others were killed. Only when NOTHING was signalled is this a failure.
if [ "${#signalled[@]}" -gt 0 ]; then
   printf 'safe-pkill: sent %s to: %s\n' "${signal}" "${signalled[*]}"
else
   rc=1
   if [ "${#unsignalled_live[@]}" -gt 0 ]; then
      printf 'safe-pkill: could not signal any matched process (still alive, or hidden): %s\n' "${unsignalled_live[*]}" >&2
   else
      printf 'safe-pkill: no live target remained to signal (all matches had exited)\n' >&2
   fi
fi
if [ "${#skipped[@]}" -gt 0 ]; then
   printf 'safe-pkill: protected (self/ancestors), NOT killed: %s\n' "${skipped[*]}"
fi
exit "${rc}"
