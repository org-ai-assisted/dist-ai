#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## Reports how much of privleap the test suites actually reach, across BOTH
## lanes: the in-process suites (no root) and the live-daemon e2e run (root, in
## a private mount namespace). Reporting only the in-process lane would
## understate the result badly -- run_action, the PAM shim, and the daemon's
## whole startup path exist only in a real daemon process -- so the daemon and
## the shim are measured too, via COVERAGE_PROCESS_START and the
## coverage-bootstrap sitecustomize.
##
## Needs sudo (for the e2e lane) and python3-coverage. Run from a NORMAL user
## account. Set PRIVLEAP_REPO to measure a checkout instead of the installed
## package.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/privleap-tests" ]; then
   tests_dir="$(readlink --canonicalize -- "${script_dir}/../share/privleap-tests")"
else
   tests_dir='/usr/share/privleap-tests'
fi

## style-ok: allow-python-interpreter -- run through PATH python3 for venv/user-site test deps
if ! python3 -c 'import coverage' 2>/dev/null; then
   printf '%s\n' 'SKIP: python3-coverage not installed.' >&2
   ## style-ok: allow-skip: python3-coverage optional dep not installed
   exit 77
fi

if [ -v PRIVLEAP_REPO ]; then
   measure_dir="${PRIVLEAP_REPO}/usr/lib/python3/dist-packages/privleap"
   shim_dir="${PRIVLEAP_REPO}/usr/libexec/privleap"
else
   measure_dir='/usr/lib/python3/dist-packages/privleap'
   shim_dir='/usr/libexec/privleap'
fi

work_dir="$(mktemp --directory)"
data_file="${work_dir}/coverage"
rc_file="${work_dir}/coveragerc"

cleanup() {
   # shellcheck disable=SC2317  # reached via the EXIT trap below
   safe-rm --recursive --force -- "${work_dir}"
}
trap cleanup EXIT

## 'parallel' so each measured process writes its own data file: the daemon,
## the shim and the harness all run at once and would otherwise overwrite one
## another's results.
cat > "${rc_file}" <<EOF
[run]
branch = True
parallel = True
data_file = ${data_file}
source =
   ${measure_dir}
   ${shim_dir}
   /usr/libexec/privleap

## The shim executes from the path privleapd hardcodes, which the harness
## bind-mounts the checkout's copy over. Coverage records it under that
## executed path, so without this alias the data would be attributed to a
## file outside 'source' and silently dropped -- reading as an untested shim.
[paths]
shim =
   ${shim_dir}
   /usr/libexec/privleap

[report]
omit =
   */privleap/tests/*
EOF

overall=0
saw_pass=0
shim_skipped=0

run_in_process() {
   local suite
   for suite in "${@}"; do
      printf '%s\n' "---- ${suite} ----"
      local rc=0
      COVERAGE_RCFILE="${rc_file}" python3 -m coverage run \
         -- "${tests_dir}/${suite}.py" >/dev/null 2>&1 || rc=$?
      if [ "${rc}" = '0' ]; then
         saw_pass=1
         continue
      fi
      if [ "${rc}" = '77' ]; then
         ## shim_test's 77 = /usr/libexec/privleap/shim.py missing. shim.py is
         ## the component that performs the privilege change; skipping it is a
         ## PARTIAL install, not "privleap absent". Record it distinctly so it
         ## is not silently dropped from the coverage figure with no trace.
         if [ "${suite}" = 'shim_test' ]; then
            printf '%s\n' \
               "  ${suite}: SKIP -- shim.py missing; shim coverage absent" >&2
            shim_skipped=1
         fi
         continue
      fi
      printf '%s\n' "  ${suite}: exit ${rc}" >&2
      overall=1
   done
}

printf '%s\n' '######## in-process lane ########'
run_in_process parser_fuzz authorizer_test unit_test daemon_test config_test \
   client_test shim_test

## privleap IS present (some in-process suite passed) yet the shim was skipped:
## a partial install whose privilege boundary is NOT in the figure below. Fail
## rather than report an understated coverage number as if it were complete.
if [ "${shim_skipped}" != '0' ] && [ "${saw_pass}" != '0' ]; then
   printf '%s\n' \
      'privleap-tests-coverage: shim.py missing (partial install); the shim' \
      'privilege boundary is NOT covered below.' >&2
   overall=1
fi

printf '%s\n' ''
printf '%s\n' '######## live-daemon lane (needs sudo) ########'
e2e_rc=0
COVERAGE_RCFILE="${rc_file}" COVERAGE_PROCESS_START="${rc_file}" \
   python3 -- "${tests_dir}/e2e.py" >/dev/null 2>&1 || e2e_rc=$?
if [ "${e2e_rc}" = '0' ]; then
   printf '%s\n' 'e2e: PASS'
else
   printf '%s\n' "e2e: exit ${e2e_rc} -- its coverage is NOT in the figure below" >&2
   overall=1
fi

printf '%s\n' ''
printf '%s\n' '######## combined coverage ########'
## privleapd sets a restrictive umask (0o077) at startup, deliberately, so
## every file its processes write -- including the coverage data the daemon
## and the shim produce -- is 0600 root:root. This account cannot read those,
## and combine dies on the first one. Take ownership before combining.
shopt -s nullglob
root_data=( "${work_dir}"/coverage.* )
shopt -u nullglob
if [ "${#root_data[@]}" -gt 0 ]; then
   ## --no-dereference: these paths are glob-matched from a directory that
   ## root-run actions write into, and chown would otherwise follow a symlink
   ## planted there and take ownership of its target instead.
   if ! sudo --non-interactive chown --no-dereference -- \
      "$(id --user):$(id --group)" "${root_data[@]}"; then
      printf '%s\n' \
         'privleap-tests-coverage: could not take ownership of the live-daemon' \
         'coverage data; the figure below covers the in-process lane only.' >&2
      overall=1
   fi
fi

## NOT silenced. A combine that fails leaves the report showing only the
## in-process data, which reads as "the live-daemon lane covered nothing"
## rather than as the tooling error it is. That mistake cost a long
## investigation once already.
combine_rc=0
COVERAGE_RCFILE="${rc_file}" python3 -m coverage combine || combine_rc=$?
if [ "${combine_rc}" != '0' ]; then
   printf '%s\n' \
      "privleap-tests-coverage: coverage combine FAILED (exit ${combine_rc});" \
      'the figure below is missing at least one lane and must not be read' \
      'as coverage.' >&2
   overall=1
fi
COVERAGE_RCFILE="${rc_file}" python3 -m coverage report --show-missing

if [ "${overall}" != '0' ]; then
   printf '%s\n' 'privleap-tests-coverage: a suite FAILED; the figure above is' \
      'from an incomplete run and understates nothing but proves less.' >&2
   exit 1
fi
exit 0
