#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Downloads a published Kicksecure/Whonix ISO and verifies it BEFORE it is
## used -- dist-installer-cli fetches the .ova/KVM VM images but NOT the ISO.
## No manifest: the version is discovered from what the project already
## publishes, and the image URL is derived from the naming convention.
##
## Version discovery (override with --version):
##   --channel stable      -> the wiki Template:VersionNew pin.
##   --channel developers  -> the highest version directory published under
##                            <download-base>/iso/ (== stable when no newer
##                            build is published yet).
##
## Naming convention (derivative-maker variables.d/40_version-paths.bsh):
##   <VMNAME>-<desktop>-<version>.<arch>.iso   e.g.
##   Kicksecure-Xfce-18.4.0.5.Intel_AMD64.iso
## published at <download-base>/iso/<version>/ alongside <image>.sha512sums and
## its OpenPGP signature <image>.sha512sums.asc.
##
## Integrity (fail-closed, both required; the artifact is never modified):
##   SIG  -- OpenPGP verify <image>.sha512sums.asc over the .sha512sums file
##           against --cert (the published derivative signing key).
##   HASH -- the authenticated .sha512sums lists an entry for exactly <image>
##           whose sha512 matches the downloaded bytes. Binding the basename
##           stops an older signed release being served under a newer name.
## Downloads route over a SOCKS5 (Tor) proxy with --socks-proxy.
##
## Trust boundary: the VERSION source is unsigned by design here (the signed
## release manifest was cancelled) -- the wiki pin and directory index are
## trusted over TLS/onion, as dist-installer-cli trusts the wiki VersionNew
## pin. The tool guarantees a genuine key-signed release OF THE RESOLVED
## VERSION; it cannot alone stop a controlled version source selecting an
## older genuine release.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"

## log / die / has / is_whole_number / die_if_not_has. log_run_die.sh sources
## get_colors, strings.bsh and has.bsh itself.
# shellcheck disable=SC1091
if ! source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/log_run_die.sh 2>/dev/null; then
   printf '%s\n' "${me}: ERROR: cannot source helper-scripts log_run_die.sh (set HELPER_SCRIPTS_PATH)" >&2
   exit 3
fi

project=""
vmname=""
desktop=""
arch="Intel_AMD64"
channel="stable"
version_override=""
output_dir=""
cert_path=""
download_base=""
wiki_base=""
socks_proxy=""
onion='false'
print_version_only='false'
resume='false'

## Trap state -- set before the trap is registered (R-051). The image is
## downloaded inside work_dir, so removing it also discards an unverified
## download.
work_dir=""
## The predictable --resume staging dir is kept across runs; every other work_dir
## (ephemeral download dir, print-version temp dir) is removed on exit.
keep_work_dir='false'

print_usage() {
   printf '%s\n' "Usage:
  ${me} --project kicksecure|whonix --vmname NAME --desktop TOKEN
        --output-dir DIR --cert PATH
        [--arch Intel_AMD64] [--channel stable|developers] [--version VER]
        [--download-base URL] [--wiki-base URL]
        [--socks-proxy host:port] [--onion] [--print-version] [--resume]

--print-version resolves the version for the channel and prints it, then exits
WITHOUT downloading (needs only --project, or --version plus both base URLs).
--resume stages the image in a predictable <output-dir>/.iso-download-resume dir
and continues an interrupted download (curl --continue-at); the OpenPGP + sha512
verification still gates before the atomic rename, and a resumed image whose
sha512 does not match is dropped so a re-run restarts clean.

Discovers the version (stable = wiki Template:VersionNew; developers = highest
published under <download-base>/iso/), derives the ISO URL from the naming
convention, downloads the image plus its .asc and .sha512sums, and verifies
BOTH the OpenPGP signature (against --cert) and the sha512 before keeping it.
--socks-proxy routes downloads over SOCKS5 (Tor); --onion permits plaintext
http (onion services carry their own encryption)."
}

cleanup() {
   ## The --resume download dir is kept on purpose (a re-run continues it; a
   ## verification-failed partial is dropped at the check). Every other work_dir
   ## -- including the print-version temp dir, which also sets resume -- is removed.
   if [ "${keep_work_dir}" = 'true' ]; then
      return 0
   fi
   if [ -n "${work_dir}" ] && [ -d "${work_dir}" ]; then
      safe-rm --recursive --force -- "${work_dir}"
   fi
}

guard_not_symlink() {
   if [ -L "$1" ]; then
      die 2 "refusing to write through a symlink: '$1'"
   fi
}

curl_fetch() {
   local url dest resume_this
   local -a opts

   url="$1"
   dest="$2"
   resume_this="${3:-false}"
   opts=( --fail --silent --show-error --location --output "${dest}" )
   if [ "${resume_this}" = 'true' ]; then
      ## Continue a partial transfer from where it stopped (new file -> from 0).
      opts+=( --continue-at - )
   fi
   case "${url}" in
      https://*)
         opts+=( --proto '=https' --tlsv1.3 )
         ;;
   esac
   if [ -n "${socks_proxy}" ]; then
      opts+=( --socks5-hostname "${socks_proxy}" )
   fi
   curl "${opts[@]}" -- "${url}"
}

## Fetch a URL (or copy a local path/file:// location) into dest. Sources are
## only ever READ; dest is a fresh file.
fetch() {
   local location dest resume_this path
   location="$1"
   dest="$2"
   resume_this="${3:-false}"
   case "${location}" in
      https://*)
         curl_fetch "${location}" "${dest}" "${resume_this}"
         ;;
      http://*)
         if [ "${onion}" != 'true' ]; then
            die 2 "refusing plaintext http location without --onion: '${location}'"
         fi
         curl_fetch "${location}" "${dest}" "${resume_this}"
         ;;
      file://*)
         path="${location#file://}"
         cp -- "${path}" "${dest}"
         ;;
      /*)
         cp -- "${location}" "${dest}"
         ;;
      *)
         die 2 "unsupported location (need https/http/file URL or absolute path): '${location}'"
         ;;
   esac
}

## Fetch a URL to stdout (discovery reads: wiki pin, directory index).
fetch_text() {
   local location path
   location="$1"
   case "${location}" in
      https://*|http://*)
         local tmp
         tmp="${work_dir}/fetch_text.tmp"
         ## curl --fail leaves the previous body in --output DEST on an HTTP
         ## error, so a reused tmp would make cat emit a PRIOR fetch's content
         ## when this one fails under a caller's errexit-suppressing '|| true'
         ## (e.g. the developers stable-pin probe). Truncate so a failed fetch
         ## yields empty, not stale.
         true > "${tmp}"
         fetch "${location}" "${tmp}"
         cat -- "${tmp}"
         ;;
      file://*)
         path="${location#file://}"
         cat -- "${path}"
         ;;
      /*)
         cat -- "${location}"
         ;;
      *)
         die 2 "unsupported location: '${location}'"
         ;;
   esac
}

## Reject anything that is not a bare dotted-numeric version (mirrors
## dist-installer-cli get_version's charset + length guard).
validate_version() {
   local candidate
   candidate="$1"
   if [ -z "${candidate}" ]; then
      die 3 "empty version"
   fi
   if [ -n "${candidate%%*[^0-9.]*}" ]; then
      true "version is bare [0-9.] -- ok"
   else
      die 3 "version contains non [0-9.] characters: '${candidate}'"
   fi
   if [ "${#candidate}" -gt 12 ]; then
      die 3 "version implausibly long (>12 chars): '${candidate}'"
   fi
}

## Extract the pinned version from a wiki Template:VersionNew raw body:
## first line, cut at the first '<' (drops the <noinclude> tail). Strip ONLY a
## trailing CR (the CRLF line terminator) so a CRLF body does not leave '\r' on a
## version-only first line (it survives the '<'-cut otherwise). An EMBEDDED CR is
## left in place so a malformed pin is rejected by validate_version rather than
## silently normalized into a different valid version.
sanitize_wiki_version() {
   local raw first cr
   raw="$1"
   cr="$(printf '\r')"
   first="$(printf '%s\n' "${raw}" | head -n 1)"
   first="${first%"${cr}"}"
   first="$(printf '%s' "${first}" | sed 's/<.*//')"
   printf '%s' "${first}"
}

wiki_version_url() {
   printf '%s/w/index.php?title=Template:VersionNew&stable=0&action=raw' "${wiki_base}"
}

fetch_stable_version() {
   local raw url clean
   url="$(wiki_version_url)"
   raw="$(fetch_text "${url}")"
   clean="$(sanitize_wiki_version "${raw}")"
   printf '%s' "${clean}"
}

## Pick the highest version directory from a directory-index HTML body. The
## '|| true' on the non-match keeps an empty result from tripping errexit here
## so the caller can emit its own "no version directories" diagnostic.
pick_highest_version() {
   local html hrefs versions
   html="$1"
   hrefs="$(printf '%s\n' "${html}" | grep -oE 'href="[0-9][0-9.]*/"' || true)"
   versions="$(printf '%s\n' "${hrefs}" | sed -E 's#href="([0-9.]+)/"#\1#')"
   printf '%s\n' "${versions}" | { grep -E '.' || true; } | sort --version-sort | tail -n 1
}

fetch_developers_version() {
   local index_url html highest stable
   index_url="${download_base}/iso/"
   html="$(fetch_text "${index_url}")"
   highest="$(pick_highest_version "${html}")"
   if [ -z "${highest}" ]; then
      die 3 "no version directories found under '${index_url}'"
   fi
   ## The stable pin is fetched only to note the coincidence; its failure must
   ## not abort a developers download whose version is already resolved.
   stable="$(fetch_stable_version 2>/dev/null || true)"
   if [ -n "${stable}" ] && [ "${highest}" = "${stable}" ]; then
      log notice "developers version ${highest} coincides with stable (no newer build published)"
   fi
   printf '%s' "${highest}"
}

resolve_version() {
   local resolved
   if [ -n "${version_override}" ]; then
      resolved="${version_override}"
   else
      case "${channel}" in
         stable)
            resolved="$(fetch_stable_version)"
            ;;
         developers)
            resolved="$(fetch_developers_version)"
            ;;
         *)
            die 2 "unknown --channel '${channel}' (expected stable or developers)"
            ;;
      esac
   fi
   validate_version "${resolved}"
   printf '%s' "${resolved}"
}

verify_openpgp() {
   local file sig cert
   file="$1"
   sig="$2"
   cert="$3"
   if ! sqop verify "${sig}" "${cert}" < "${file}" >/dev/null 2>&1; then
      die 4 "the published .sha512sums OpenPGP signature could NOT be verified against '${cert}' -- refusing the download"
   fi
}

## Compare the image's sha512 against the digest published in its .sha512sums
## (basename-relative, one line per file).
verify_sha512() {
   local file sums image_base expected actual line digest name
   file="$1"
   sums="$2"
   image_base="$3"

   ## sha512sum lines are "<digest><2 sep chars><filename>"; the filename runs
   ## to end of line and MAY contain spaces, so strip the digest and exactly
   ## the two separator chars rather than splitting on the last space.
   expected=""
   while IFS= read -r line; do
      digest="${line%% *}"
      name="${line#"${digest}"}"
      name="${name:2}"
      if [ "${name}" = "${image_base}" ]; then
         expected="${digest}"
         break
      fi
   done < "${sums}"

   if [ -z "${expected}" ]; then
      die 4 "no sha512 entry for '${image_base}' in the published .sha512sums -- refusing the download"
   fi

   actual="$(sha512sum -- "${file}")"
   actual="${actual%% *}"
   expected="${expected,,}"
   actual="${actual,,}"
   if [ "${actual}" != "${expected}" ]; then
      log error "sha512 mismatch for '${image_base}'"
      log error "published: '${expected}'"
      log error "actual:    '${actual}'"
      ## Complete bytes that do not verify are poison for a resume: drop them so
      ## a re-run restarts from zero instead of re-continuing the bad partial.
      if [ "${resume}" = 'true' ]; then
         safe-rm --force -- "${file}"
      fi
      die 4 "artifact sha512 does NOT match the published .sha512sums -- refusing the download"
   fi
}

resolve_download_base() {
   local domain
   if [ -n "${download_base}" ]; then
      return 0
   fi
   case "${project}" in
      kicksecure)
         domain='download.kicksecure.com'
         ;;
      whonix)
         domain='download.whonix.org'
         ;;
      *)
         die 2 "unknown --project '${project}' (expected kicksecure or whonix)"
         ;;
   esac
   download_base="https://${domain}"
}

resolve_wiki_base() {
   if [ -n "${wiki_base}" ]; then
      return 0
   fi
   case "${project}" in
      kicksecure)
         wiki_base='https://www.kicksecure.com'
         ;;
      whonix)
         wiki_base='https://www.whonix.org'
         ;;
      *)
         die 2 "unknown --project '${project}' (expected kicksecure or whonix)"
         ;;
   esac
}

parse_args() {
   while [ "$#" -gt 0 ]; do
      case "$1" in
         --project)
            [ "$#" -ge 2 ] || die 2 "missing value for --project"
            project="$2"
            shift 2
            ;;
         --vmname)
            [ "$#" -ge 2 ] || die 2 "missing value for --vmname"
            vmname="$2"
            shift 2
            ;;
         --desktop)
            [ "$#" -ge 2 ] || die 2 "missing value for --desktop"
            desktop="$2"
            shift 2
            ;;
         --arch)
            [ "$#" -ge 2 ] || die 2 "missing value for --arch"
            arch="$2"
            shift 2
            ;;
         --channel)
            [ "$#" -ge 2 ] || die 2 "missing value for --channel"
            channel="$2"
            shift 2
            ;;
         --version)
            [ "$#" -ge 2 ] || die 2 "missing value for --version"
            version_override="$2"
            shift 2
            ;;
         --output-dir)
            [ "$#" -ge 2 ] || die 2 "missing value for --output-dir"
            output_dir="$2"
            shift 2
            ;;
         --cert)
            [ "$#" -ge 2 ] || die 2 "missing value for --cert"
            cert_path="$2"
            shift 2
            ;;
         --download-base)
            [ "$#" -ge 2 ] || die 2 "missing value for --download-base"
            download_base="${2%/}"
            shift 2
            ;;
         --wiki-base)
            [ "$#" -ge 2 ] || die 2 "missing value for --wiki-base"
            wiki_base="${2%/}"
            shift 2
            ;;
         --socks-proxy)
            [ "$#" -ge 2 ] || die 2 "missing value for --socks-proxy"
            socks_proxy="$2"
            shift 2
            ;;
         --onion)
            onion='true'
            shift
            ;;
         --print-version)
            print_version_only='true'
            shift
            ;;
         --resume)
            resume='true'
            shift
            ;;
         -h|--help)
            print_usage
            exit 0
            ;;
         --)
            shift
            break
            ;;
         -*)
            print_usage >&2
            die 2 "unknown option '$1'"
            ;;
         *)
            print_usage >&2
            die 2 "unexpected positional argument '$1'"
            ;;
      esac
   done
}

main() {
   local version image image_url artifact_final image_work sums_file sig_file

   parse_args "$@"

   ## Version resolution needs only the project (or an explicit version plus
   ## both base URLs); vmname/desktop/output-dir/cert are download-only inputs.
   if [ -z "${version_override}" ] && [ -z "${project}" ] \
      && { [ -z "${download_base}" ] || [ -z "${wiki_base}" ]; }; then
      print_usage >&2
      die 2 "--project is required unless --version and both base URLs are given"
   fi

   if [ "${print_version_only}" = 'true' ]; then
      die_if_not_has curl
      resolve_download_base
      resolve_wiki_base
      ## Discovery reads (wiki pin / directory index) stage through work_dir; no
      ## output-dir is required for a version-only query, so use a temp dir.
      work_dir="$(mktemp --directory --tmpdir iso-download.XXXXXXXX)"
      trap cleanup EXIT
      version="$(resolve_version)"
      printf '%s\n' "${version}"
      return 0
   fi

   [ -n "${vmname}" ]     || { print_usage >&2; die 2 "--vmname is required"; }
   [ -n "${desktop}" ]    || { print_usage >&2; die 2 "--desktop is required"; }
   [ -n "${output_dir}" ] || { print_usage >&2; die 2 "--output-dir is required"; }
   [ -n "${cert_path}" ]  || { print_usage >&2; die 2 "--cert is required"; }

   die_if_not_has curl
   die_if_not_has sqop
   die_if_not_has sha512sum

   [ -r "${cert_path}" ]  || die 3 "signing cert not readable: '${cert_path}'"
   [ -d "${output_dir}" ] || die 2 "output dir does not exist: '${output_dir}'"

   resolve_download_base
   resolve_wiki_base

   ## Stage in a private 0700 subdir OF output_dir, not /tmp: same filesystem,
   ## so the final rename is atomic and can never leave a truncated file under
   ## the trusted name; sized by output_dir (not a smaller tmpfs). A fresh mktemp
   ## dir blocks a pre-planted symlink; --resume instead uses a predictable,
   ## persistent 0700 dir (guarded against being a symlink) to continue a partial.
   if [ "${resume}" = 'true' ]; then
      work_dir="${output_dir}/.iso-download-resume"
      ## A predictable dir in a world-writable output_dir is a root arbitrary-write
      ## vector: an attacker pre-creates it and plants symlinks that root's curl
      ## follows. chmod does NOT change ownership, so REFUSE a pre-existing dir we
      ## do not own, then re-assert owner + 0700 + not-a-symlink after our mkdir --
      ## once the dir is exclusively ours, nothing else can plant inside it.
      if [ -e "${work_dir}" ] && [ ! -O "${work_dir}" ]; then
         die 2 "refusing resume dir not owned by us: '${work_dir}'"
      fi
      guard_not_symlink "${work_dir}"
      ## output_dir pre-exists, so this creates only the leaf; chmod sets its mode
      ## (we own it, default umask keeps others out until the chmod narrows to 0700).
      mkdir --parents -- "${work_dir}"
      chmod 0700 -- "${work_dir}"
      if [ ! -O "${work_dir}" ] || [ ! -d "${work_dir}" ] || [ -L "${work_dir}" ]; then
         die 2 "resume dir is not an exclusively-owned directory: '${work_dir}'"
      fi
      keep_work_dir='true'
   else
      work_dir="$(mktemp --directory -- "${output_dir}/.iso-download.XXXXXXXX")"
   fi
   trap cleanup EXIT

   version="$(resolve_version)"

   image="${vmname}-${desktop}-${version}.${arch}.iso"
   if ! validate_safe_filename image; then
      die 2 "derived image name is not a safe filename: '${image}'"
   fi

   image_url="${download_base}/iso/${version}/${image}"
   artifact_final="${output_dir}/${image}"
   image_work="${work_dir}/${image}"
   sums_file="${work_dir}/${image}.sha512sums"
   sig_file="${work_dir}/${image}.sha512sums.asc"

   log notice "downloading '${image}' (version ${version})"
   if [ "${resume}" = 'true' ]; then
      guard_not_symlink "${image_work}"
      ## sums/sig are tiny; re-fetch fresh each run so --continue-at applies only
      ## to the image (a complete small file would 416 under -C -).
      safe-rm --force -- "${sums_file}" "${sig_file}"
      fetch "${image_url}" "${image_work}" true
   else
      fetch "${image_url}" "${image_work}"
   fi
   fetch "${image_url}.sha512sums" "${sums_file}"
   fetch "${image_url}.sha512sums.asc" "${sig_file}"

   ## Trust chain: the OpenPGP signature authenticates the .sha512sums file;
   ## the authenticated sums then binds the image by BOTH its exact basename
   ## (so an old release cannot be served under a newer version's name) and its
   ## sha512 digest. Both gates must pass or nothing is kept.
   log notice "verifying the published .sha512sums signature and the image digest"
   verify_openpgp "${sums_file}" "${sig_file}" "${cert_path}"
   verify_sha512 "${image_work}" "${sums_file}" "${image}"

   ## --no-target-directory: replace whatever is at the final path (including a
   ## symlink -- rename acts on the link, not its target) and fail closed if it
   ## is a directory, rather than moving the image INSIDE it.
   mv --force --no-target-directory -- "${image_work}" "${artifact_final}"

   log notice "verified OK: '${artifact_final}'"
   printf '%s\n' "${artifact_final}"
}

main "$@"
