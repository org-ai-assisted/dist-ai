#!/usr/bin/python3 -Bsu

## Shell-invocation guard.
"exec" "bash" "-c" "printf '%s\n' '$0: ERROR: Do not execute this script with bash!' >&2; exit 1"

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

"""Audit sudoers policy for command paths that no longer exist.

A sudoers rule naming an absolute command path that is not present on the
filesystem is dead config and a latent grant: if the path is ever (re)created,
the rule silently re-arms. This happens when a binary is removed but its
sudoers.d grant is left behind.

This tool reports every absolute command path referenced by one or more sudoers
sources that does not exist under the chosen root. It is generic: it audits the
running system by default, or any explicit file(s)/dir(s), or a mounted image
root via --root/--find.

Parser reuse: the sudoers grammar is NOT parsed here. Each source is handed to
cvtsudoers (the sudo project's own converter, ships with the 'sudo' package),
which emits JSON; this tool only extracts command strings from that JSON and
stat()s them. It is NOT a reimplementation of, and does not duplicate,
dm-root-scripts-enum (a derivative-maker source-tree LPE-surface enumerator):
different scope (any running system vs the dm tree), different purpose
(existence audit vs privilege-escalation surface), and no hand-rolled parser.

Exit codes:
  0  every referenced command path exists (clean).
  1  at least one referenced command path is missing (findings printed).
  2  the audit could not be completed faithfully -- never reported as clean:
     usage error; cvtsudoers missing; a source cvtsudoers could not parse; a
     coverage warning (e.g. an includedir cvtsudoers skipped); a search tree
     that could not be read in full (--find); or a source that pulls in an
     absolute @include under a non-default --root, which cvtsudoers resolves in
     the HOST namespace, not the image.
"""

import argparse
import json
import os
import re
import subprocess
import sys

CVTSUDOERS = "/usr/bin/cvtsudoers"

## A sudoers @include / @includedir (or the older #include form). We key only on
## PRESENCE, never the target: cvtsudoers' own include resolution -- absolute vs
## relative, %h/%u escapes, line continuation, escaped-space and quoted targets,
## and the SILENT drop of a target it cannot read -- is more than this audit can
## faithfully reproduce, so parsing the target is unreliable. include_coverage_gap
## decides when presence alone forces inconclusive.
INCLUDE_RE = re.compile(r"^[ \t]*[@#]include(?:dir)?\b", re.MULTILINE)

## A full command token in cvtsudoers' -f sudoers output: a run beginning with
## '/' spanning the command PATH and its arguments, up to the unescaped comma or
## newline that ends one command. A literal space in the PATH is backslash-
## escaped (the only way a command path carries one); the boundary between path
## and arguments is the first UNescaped space. De-escaped and trimmed, the run
## equals the JSON command string for the SAME rule -- so it recovers that rule's
## boundary per-rule. The run can be polluted by a '/' earlier on the line (a
## CIDR host spec, a CWD=/CHROOT= option): command_path keys on an EXACT match of
## the full de-escaped run against the JSON string, so a polluted run simply does
## not match and the command falls through to the safe inconclusive path below.
AMBIGUOUS_BOUNDARY = ""  ## sentinel: a path is never the empty string
SUDOERS_TOKEN_RE = re.compile(r"/(?:\\.|[^\s])*")
SUDOERS_COMMAND_RE = re.compile(r"/(?:\\.|[^,\n])*")

## Glob metacharacters sudoers honours in a command path.
GLOB_META = "*?["


def find_cvtsudoers():
    """Locate cvtsudoers. It is a hard dependency (the 'sudo' package); its
    absence is a setup error, not a reason to fall back to a hand parser."""
    if os.access(CVTSUDOERS, os.X_OK):
        return CVTSUDOERS
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        candidate = os.path.join(directory, "cvtsudoers")
        if os.access(candidate, os.X_OK):
            return candidate
    return None


def probe_baseline(cvt):
    """cvtsudoers prints environment advisories on EVERY run (e.g. a mis-owned
    /etc/sudo.conf on the auditing host) that are unrelated to any audited
    source's coverage. Capture them once from an empty parse so they can be
    subtracted, keeping the verdict independent of the host's sudo-config state
    -- otherwise a non-root CI host would turn every audit inconclusive."""
    proc = subprocess.run(
        [cvt, "-f", "json", "-i", "sudoers", os.devnull],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        encoding="utf-8",
        check=False,
    )
    return {line for line in proc.stderr.strip().splitlines() if line}


def dropin_loadable(name):
    """Mirror sudo's includedir rule: a drop-in whose filename contains '.' or
    ends with '~' is ignored. Auditing exactly what sudo would load avoids
    flagging editor backups and disabled '.bak' copies."""
    return "." not in name and not name.endswith("~")


def discover(trees, errors):
    """Yield sudoers source files found under each tree: any regular file named
    'sudoers', and any loadable drop-in inside a 'sudoers.d' directory.

    os.walk silently omits a tree it cannot descend, which would drop part of
    the policy from the audit while a readable sibling still yields sources --
    so a missing grant could read as clean. Every walk error is recorded into
    `errors`; the caller turns a non-empty list into an inconclusive result."""
    seen = set()
    for tree in trees:
        for dirpath, _dirnames, filenames in os.walk(tree, onerror=errors.append):
            in_dropin_dir = os.path.basename(dirpath) == "sudoers.d"
            for name in sorted(filenames):
                full = os.path.join(dirpath, name)
                if not os.path.isfile(full):
                    continue
                if name == "sudoers":
                    pass
                elif in_dropin_dir and dropin_loadable(name):
                    pass
                else:
                    continue
                real = os.path.realpath(full)
                if real not in seen:
                    seen.add(real)
                    yield full


def expand_inputs(paths):
    """Turn the positional paths (files or directories) into a flat file list.
    A directory is treated as a sudoers.d-style drop-in directory."""
    files = []
    for path in paths:
        if os.path.isdir(path):
            for name in sorted(os.listdir(path)):
                full = os.path.join(path, name)
                if os.path.isfile(full) and dropin_loadable(name):
                    files.append(full)
        else:
            files.append(path)
    return files


def _unescape(token):
    """De-escape a cvtsudoers -f sudoers token to its real on-disk form."""
    return re.sub(r"\\(.)", r"\1", token)


def extract_command_map(sudoers_text):
    """Return (mapping, counts) from cvtsudoers' -f sudoers output. mapping takes
    each rule's full de-escaped command string (path + arguments, the exact form
    cvtsudoers' JSON emits) to that rule's command PATH; counts is how many clean
    runs produced each full string. cvtsudoers' JSON collapses the
    command/argument boundary (an escaped-space path and a path+arguments both
    serialise to one space-joined string), but the -f sudoers round-trip keeps
    the escape on the command PATH while de-escaping arguments -- so the first
    UNescaped space in a -f sudoers command run is the real boundary. Keying on
    the FULL de-escaped run (== the JSON string) recovers each rule's boundary
    per-rule, so one rule's escaped-space path is never applied to another rule's
    command string. When two rules collapse to the SAME JSON string but have
    DIFFERENT recovered paths (a spaced PATH vs a path+argument), the key is
    marked AMBIGUOUS_BOUNDARY: the JSON cannot distinguish them, so the audit
    must refuse rather than pick one by text order. counts lets the caller catch
    a rule whose run was polluted (a host spec / option '/' earlier on the line
    consumed its command): that rule produces no clean run for its full string,
    so the string is under-counted versus the JSON pass."""
    mapping: "dict[str, str]" = {}
    counts: "dict[str, int]" = {}
    for run in SUDOERS_COMMAND_RE.findall(sudoers_text):
        full = _unescape(run.rstrip())
        match = SUDOERS_TOKEN_RE.match(run)
        path = _unescape(match.group(0)) if match else full
        counts[full] = counts.get(full, 0) + 1
        if full not in mapping:
            mapping[full] = path
        elif mapping[full] != path:
            mapping[full] = AMBIGUOUS_BOUNDARY
    return mapping, counts


def command_path(command_string, command_map):
    """Return the absolute command path from a cvtsudoers JSON command string,
    AMBIGUOUS_BOUNDARY when the boundary cannot be recovered uniquely, or None
    when the entry is not a stat-able path (ALL, sudoedit, list, a bare word, or
    a relative command). The path is the per-rule boundary from the -f sudoers
    pass (command_map). A command string that carries a space but is NOT a clean
    map hit has an UNKNOWN boundary -- the -f sudoers run was polluted (a CIDR
    host spec or an option path consumed it) -- so it is AMBIGUOUS, never guessed
    via a first-token split (which would be a dead-grant false clean)."""
    recovered = command_map.get(command_string)
    if recovered is not None:
        if recovered == AMBIGUOUS_BOUNDARY:
            return AMBIGUOUS_BOUNDARY
        return recovered if recovered.startswith("/") else None
    if not command_string.startswith("/"):
        ## ALL, sudoedit, list, a bare word or a command+args whose name is not a
        ## path: not a stat-able command path.
        return None
    if " " in command_string:
        ## An absolute path with an unrecoverable boundary (polluted -f sudoers
        ## run): do not guess a first token.
        return AMBIGUOUS_BOUNDARY
    return command_string


def include_coverage_gap(path, root_real):
    """Reason string if a source's @include/@includedir cannot be faithfully
    resolved for this audit, else None. cvtsudoers reports an unfaithful include
    as a clean exit-0 parse with the included commands simply absent, so the
    audit must refuse clean whenever it cannot trust the include was fully
    resolved. An include is trusted ONLY in the fully faithful mode -- the live
    root (root == '/') audited AS root, where cvtsudoers reads every include
    (absolute or relative, every escape form) against the real system as root.
    Otherwise it is a gap:
      - under a non-default --root (offline image), cvtsudoers resolves an
        absolute include in the HOST namespace, not the image, and a relative
        one can still escape the image via '..'/symlinks;
      - run as non-root, an include target this process cannot read is SILENTLY
        dropped (sudo as root would load it).
    Only PRESENCE of an include is examined -- the target's form (absolute vs
    relative, %h/%u, line continuation, escaped space, quoting) is cvtsudoers'
    job to resolve, not this audit's to re-parse."""
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            text = handle.read()
    except OSError:
        ## Unreadable here means cvtsudoers failed too; that surfaces as a parse
        ## error (inconclusive) on the cvtsudoers pass.
        return None
    if INCLUDE_RE.search(text) is None:
        return None
    if root_real != os.sep:
        return "@include present under --root is resolved in the host namespace, not the image"
    if os.geteuid() != 0:
        return "@include present and the audit is not running as root, so an unreadable include is silently skipped"
    return None


def parse_source(cvt, path, root_real, baseline):
    """Run cvtsudoers on one source file. Return
    (commands, command_map, include_gap, warnings, error) where commands is a
    list of (command_string, negated) for entries naming an absolute command,
    command_map is the per-rule boundary map from extract_command_map,
    include_gap is the include_coverage_gap reason (or None), and error is a
    string on a hard parse failure (else None). `baseline` is the
    environment-advisory stderr (probe_baseline) subtracted so only
    source-specific messages count."""
    abs_path = os.path.abspath(path)
    ## abspath so a filename beginning with '-' is never read as an option.
    proc = subprocess.run(
        [cvt, "-f", "json", "-i", "sudoers", abs_path],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        encoding="utf-8",
        check=False,
    )
    stderr_lines = [line for line in proc.stderr.strip().splitlines()
                    if line and line not in baseline]
    if proc.returncode != 0:
        return [], {}, None, [], (
            stderr_lines[0] if stderr_lines
            else "cvtsudoers exited %d" % proc.returncode)
    ## cvtsudoers can warn (e.g. skipping a mis-owned includedir) and still exit
    ## 0; such a warning means reduced coverage, so surface it rather than let a
    ## partial parse read as clean.
    warnings = stderr_lines
    include_gap = include_coverage_gap(abs_path, root_real)
    try:
        data = json.loads(proc.stdout or "{}")
    except json.JSONDecodeError as exc:
        return [], {}, include_gap, warnings, (
            "cvtsudoers emitted unparseable JSON: %s" % exc)

    ## Second pass in sudoers format to recover command/argument boundaries the
    ## JSON loses. A failure here is non-fatal: without it the first-token
    ## reading still applies, which is correct for every path without a literal
    ## space (the overwhelming majority).
    round_trip = subprocess.run(
        [cvt, "-f", "sudoers", "-i", "sudoers", abs_path],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        encoding="utf-8",
        check=False,
    )
    command_map, run_counts = (extract_command_map(round_trip.stdout)
                               if round_trip.returncode == 0 else ({}, {}))

    ## Gather every command entry first, so each JSON command string can be
    ## counted against the clean -f sudoers runs for it.
    raw = []

    def collect(entries):
        for entry in entries or []:
            if not isinstance(entry, dict) or "command" not in entry:
                ## A {"cmndalias": NAME} reference is an alias defined outside
                ## this file (normal for a drop-in); its members are checked
                ## wherever the alias is defined. Nothing to stat here.
                continue
            raw.append((entry["command"], bool(entry.get("negated"))))

    for spec in data.get("User_Specs", []):
        for cmnd_spec in spec.get("Cmnd_Specs", []):
            collect(cmnd_spec.get("Commands"))
    for members in (data.get("Command_Aliases") or {}).values():
        collect(members)

    ## A command string produced by MORE rules than there are clean -f sudoers
    ## runs for it means some rule's run was polluted (its command consumed into
    ## a host spec / option earlier on the line). That rule's boundary must NOT
    ## be taken from a sibling rule that happens to share the JSON string, so the
    ## string is marked ambiguous (inconclusive) rather than resolved via the
    ## sibling's clean entry.
    json_counts: "dict[str, int]" = {}
    for command_string, _negated in raw:
        json_counts[command_string] = json_counts.get(command_string, 0) + 1
    for full, run_count in run_counts.items():
        if (command_map.get(full) != AMBIGUOUS_BOUNDARY
                and json_counts.get(full, 0) != run_count):
            command_map[full] = AMBIGUOUS_BOUNDARY

    commands = [(command_string, negated) for command_string, negated in raw
                if command_path(command_string, command_map) is not None]

    return commands, command_map, include_gap, warnings, None


def resolve_within_root(root_real, abs_path):
    """Resolve abs_path confined to root_real and return the resolved host-side
    path if it names an existing entry, else None. Symlinks are followed with
    their target re-anchored to root (an ABSOLUTE link target is relative to
    root, not the process's real /), so an offline image audit (--root) cannot
    escape to the host filesystem -- the bug that let a dangling grant read as
    present. Bounded against symlink loops."""
    resolved = root_real
    pending = [comp for comp in abs_path.split("/") if comp and comp != "."]
    budget = 40
    while pending:
        comp = pending.pop(0)
        if comp == "..":
            if resolved != root_real:
                resolved = os.path.dirname(resolved)
            continue
        candidate = os.path.join(resolved, comp)
        if not os.path.lexists(candidate):
            return None
        if os.path.islink(candidate):
            budget -= 1
            if budget < 0:
                return None
            link = os.readlink(candidate)
            if os.path.isabs(link):
                resolved = root_real
            parts = [part for part in link.split("/") if part and part != "."]
            pending = parts + pending
        else:
            resolved = candidate
    return resolved if os.path.exists(resolved) else None


def classify(root_real, command_string, command_map, require_executable):
    """Verdict for one cvtsudoers command string plus the command path it was
    judged against: ('missing'|'not-executable'|'inconclusive', path), (None,
    path) when present, or (None, None) when the entry is not a stat-able path.
    The command path is the recovered boundary (not any existing prefix). A path
    whose boundary could not be recovered uniquely (AMBIGUOUS_BOUNDARY) or that
    contains a wildcard is reported INCONCLUSIVE -- in the ambiguous case the
    JSON cannot tell a spaced path from a path+argument; in the wildcard case
    matching sudo's glob(3)+fnmatch AND confining to --root is beyond this audit
    -- so each refuses rather than risk a false clean or a false missing."""
    path = command_path(command_string, command_map)
    if path is None:
        return None, None
    if path == AMBIGUOUS_BOUNDARY:
        return "inconclusive", command_string
    if any(meta in path for meta in GLOB_META):
        return "inconclusive", path
    match = resolve_within_root(root_real, path)
    if match is None:
        return "missing", path
    if require_executable and not os.access(match, os.X_OK):
        return "not-executable", path
    return None, path


def main(argv):
    parser = argparse.ArgumentParser(
        prog="sudoers-command-audit",
        description="Report sudoers command paths that do not exist on disk.",
    )
    parser.add_argument(
        "paths",
        nargs="*",
        help="sudoers file(s) and/or directory(ies) to audit; default: the "
        "running system's /etc/sudoers (its @includedir pulls in "
        "/etc/sudoers.d in the same parse).",
    )
    parser.add_argument(
        "--root",
        default="/",
        help="filesystem root to check command existence against "
        "(default: /). Point at a mounted image to audit it offline.",
    )
    parser.add_argument(
        "--find",
        action="store_true",
        help="treat each path (or --root when none given) as a tree to search "
        "for sudoers files, instead of auditing it directly.",
    )
    parser.add_argument(
        "--require-executable",
        action="store_true",
        help="also report a command that exists but is not executable.",
    )
    args = parser.parse_args(argv[1:])

    cvt = find_cvtsudoers()
    if cvt is None:
        sys.stderr.write("sudoers-command-audit: ERROR: cvtsudoers not found; "
                         "install the 'sudo' package.\n")
        return 2

    baseline = probe_baseline(cvt)

    root = args.root
    root_real = os.path.realpath(root)

    inconclusive = False

    if args.find:
        trees = args.paths if args.paths else [root]
        walk_errors: "list[OSError]" = []
        sources = list(discover(trees, walk_errors))
        for walk_error in walk_errors:
            sys.stderr.write("sudoers-command-audit: WARNING: search tree not "
                             "fully readable: %s\n" % walk_error)
            inconclusive = True
    elif args.paths:
        sources = expand_inputs(args.paths)
    else:
        ## Live-system default: the main sudoers file only. cvtsudoers follows
        ## its @includedir exactly as sudo loads policy, so the /etc/sudoers.d
        ## drop-ins are covered in the SAME parse; feeding them again would
        ## double-report every finding. Their rules are attributed to the main
        ## file here -- to pin a finding to a specific drop-in, name the
        ## directory (sudoers-command-audit /etc/sudoers.d). Note: cvtsudoers
        ## resolves @includedir against absolute paths, ignoring --root, so an
        ## offline image is audited with --find, not this default.
        default_main = os.path.join(root, "etc/sudoers")
        sources = [default_main] if os.path.isfile(default_main) else []

    if not sources:
        sys.stderr.write("sudoers-command-audit: no sudoers sources found.\n")
        return 2

    findings = 0
    for source in sources:
        commands, command_map, include_gap, warnings, error = parse_source(
            cvt, source, root_real, baseline)
        for warning in warnings:
            sys.stderr.write("%s: WARNING: %s\n" % (source, warning))
            inconclusive = True
        if error is not None:
            sys.stderr.write("%s: ERROR: %s\n" % (source, error))
            inconclusive = True
            continue
        if include_gap is not None:
            ## cvtsudoers could not faithfully resolve an include (host-namespace
            ## or silently-skipped): drop this source's findings rather than emit
            ## an incomplete verdict, and refuse clean.
            sys.stderr.write("%s: WARNING: %s; cannot audit faithfully.\n"
                             % (source, include_gap))
            inconclusive = True
            continue
        reported = set()
        for command_string, negated in commands:
            verdict, abs_path = classify(
                root_real, command_string, command_map, args.require_executable)
            if verdict is None:
                continue
            if verdict == "inconclusive":
                ## A wildcard path, or a command whose boundary could not be
                ## uniquely recovered -- not safely resolvable to a single path.
                sys.stderr.write("%s: WARNING: command path not verifiable: %s\n"
                                 % (source, abs_path))
                inconclusive = True
                continue
            key = (abs_path, negated, verdict)
            if key in reported:
                continue
            reported.add(key)
            tags = []
            if verdict == "not-executable":
                tags.append("not executable")
            if negated:
                tags.append("deny rule")
            suffix = (" [%s]" % ", ".join(tags)) if tags else ""
            sys.stdout.write("%s: %s: %s%s\n"
                             % (source, verdict, abs_path, suffix))
            findings += 1

    sys.stderr.write(
        "sudoers-command-audit: %d source(s) audited, %d finding(s)%s.\n"
        % (len(sources), findings, ", INCONCLUSIVE" if inconclusive else ""))

    if inconclusive:
        return 2
    if findings:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
