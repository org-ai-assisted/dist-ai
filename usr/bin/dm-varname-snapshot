#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Regenerate the derivative-maker variable snapshots: for every build command
## (--flavor x --target), the set of variables 'help-steps/variables' introduces,
## with volatile values normalized to placeholders. One '<flavor>__<target>.vars'
## file per combo derivative-maker accepts; combos it rejects are listed (with a
## sanitized reason) in '_rejected.txt'. This is the baseline a large 'variables'
## refactoring is checked against by 'varname_snapshot_test.sh'.
##
## Runs unprivileged: sourcing 'help-steps/variables' to its opt-in dump hook is
## read-only (git/dpkg queries and pure assignment); the sudo/mkdir work lives in
## functions the build steps call later, not at source time.
##
## Usage: dm-varname-snapshot [output-dir]
##   output-dir defaults to the committed 'varname-snapshots/' beside this tool's
##   test library. Set DERIVATIVE_MAKER_DIR to pick the derivative-maker checkout
##   (default ~/derivative-maker).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

## Locate the shared library: installed tree, then a git checkout layout.
for lib_dir in \
   "${script_dir}/../share/dm-help-steps-tests" \
   "/usr/share/dm-help-steps-tests"; do
   if [ -r "${lib_dir}/varname_snapshot_lib.bsh" ]; then
      # shellcheck source=./varname_snapshot_lib.bsh
      source "${lib_dir}/varname_snapshot_lib.bsh"
      lib_found="${lib_dir}"
      break
   fi
done
if [ -z "${lib_found:-}" ]; then
   printf '%s\n' "FATAL: varname_snapshot_lib.bsh not found." >&2
   exit 1
fi

out_dir="${1:-${lib_found}/varname-snapshots}"

dm="$(vs_resolve_dm)"
if [ ! -r "${dm}/help-steps/variables" ]; then
   printf '%s\n' "FATAL: derivative-maker checkout not found at '${dm}' (set DERIVATIVE_MAKER_DIR)." >&2
   exit 1
fi

printf '%s\n' "INFO: derivative-maker checkout: ${dm}"
printf '%s\n' "INFO: output directory:          ${out_dir}"

vs_init_baseline "${dm}"
vs_init_func_baseline "${dm}"

mkdir --parents -- "${out_dir}"
## Regenerate clean: drop stale snapshots so a removed/renamed combo cannot
## linger. Scoped to this tool's own output names only.
safe-rm --force -- "${out_dir}"/*.vars "${out_dir}/_rejected.txt" "${out_dir}/functions.snapshot"

rejected_tmp="$(mktemp)"
valid_count=0
rejected_count=0
first_valid_flavor=""
first_valid_target=""

for flavor in "${vs_flavors[@]}"; do
   for target in "${vs_targets[@]}"; do
      name="${flavor}__${target}"
      ## vs_capture_combo prints the snapshot (rc 0) or the rejection reason
      ## (rc 1) to stdout; 'if' captures either and guards errexit.
      if result="$(vs_capture_combo "${dm}" "${flavor}" "${target}")"; then
         ## Remember the first valid combo to source the function snapshot from
         ## (function definitions are invariant across the flavor/target axes --
         ## no function in 'variables' is defined conditionally on either -- so
         ## one representative valid combo captures them all).
         if [ -z "${first_valid_flavor}" ]; then
            first_valid_flavor="${flavor}"
            first_valid_target="${target}"
         fi
         ## Idempotency self-check: capture once more and require identical
         ## output. A difference means a volatile value slipped past
         ## normalization -- a bug to fix at the root, not to tolerate.
         ## '|| true': if the recapture instead REJECTS (rc 1 -> validity itself
         ## is non-deterministic), errexit would abort here before the diagnostic;
         ## keep the reason so the mismatch branch reports it.
         result_again="$(vs_capture_combo "${dm}" "${flavor}" "${target}")" || true
         if [ "${result}" != "${result_again}" ]; then
            printf '%s\n' "FATAL: non-deterministic capture for '${name}'; normalization is incomplete:" >&2
            diff <(printf '%s\n' "${result}") <(printf '%s\n' "${result_again}") >&2 || true
            safe-rm --force -- "${rejected_tmp}"
            exit 1
         fi
         printf '%s\n' "${result}" > "${out_dir}/${name}.vars"
         valid_count=$((valid_count + 1))
      else
         printf '%s\t%s\n' "${name}" "${result}" >> "${rejected_tmp}"
         rejected_count=$((rejected_count + 1))
      fi
   done
done

{
   printf '%s\n' "## Build commands derivative-maker rejects (flavor x target that is not a"
   printf '%s\n' "## valid combination). Regenerated by dm-varname-snapshot; do not edit."
   printf '%s\n' "## Format: <flavor>__<target><TAB><sanitized reason>"
   LC_ALL=C sort -- "${rejected_tmp}"
} > "${out_dir}/_rejected.txt"
safe-rm --force -- "${rejected_tmp}"

## Function snapshot: the functions 'variables' introduces on top of 'pre',
## captured from one representative valid combo (see first_valid note above).
## The companion to the per-combo '.vars' files -- 'declare -p' cannot see
## functions, so without this a refactoring could silently drop or alter a
## function body and every '.vars' file would still match.
if [ -z "${first_valid_flavor}" ]; then
   printf '%s\n' "FATAL: no valid build combo found; cannot capture the function snapshot." >&2
   ## In a correct tree only genuinely-invalid combos reject, so ALL combos
   ## rejecting means the resolver itself cannot run (a missing build-host tool,
   ## an unwritable path, a failed sourcing) -- not a validity-matrix change.
   ## The per-combo capture suppresses the resolver's own output, so surface it:
   ## the distinct reasons, then ONE full unsuppressed re-run of a known-valid
   ## combo, whose exception-handler block names the failing command. Fatal path
   ## only -- never runs on a healthy tree, so no effect on normal output.
   printf '%s\n' "INFO: distinct rejection reasons (count):" >&2
   tail -n +4 -- "${out_dir}/_rejected.txt" | cut -f2- | LC_ALL=C sort | uniq -c | LC_ALL=C sort -rn >&2 || true
   printf '%s\n' "INFO: full resolver output for the known-valid 'kicksecure-cli --type vm --target raw' combo (unsuppressed):" >&2
   ( cd -- "${dm}" \
        && env "${vs_capture_env[@]}" \
              bash -c 'source help-steps/pre; source help-steps/variables "$@"' _ \
              --flavor kicksecure-cli --type vm --target raw "${vs_fixed_args[@]}" ) >&2 2>&1 || true
   exit 1
fi
funcs="$(vs_capture_functions "${dm}" "${first_valid_flavor}" "${first_valid_target}")" \
   || { printf '%s\n' "FATAL: function capture failed for the '${first_valid_flavor}__${first_valid_target}' combo." >&2; exit 1; }
## Idempotency self-check, matching the per-combo '.vars' guard: a second capture
## must be byte-identical, or a volatile value slipped past normalization.
funcs_again="$(vs_capture_functions "${dm}" "${first_valid_flavor}" "${first_valid_target}")" || true
if [ "${funcs}" != "${funcs_again}" ]; then
   printf '%s\n' "FATAL: non-deterministic function capture; normalization is incomplete:" >&2
   diff <(printf '%s\n' "${funcs}") <(printf '%s\n' "${funcs_again}") >&2 || true
   exit 1
fi
printf '%s\n' "${funcs}" > "${out_dir}/functions.snapshot"

printf '%s\n' "INFO: wrote ${valid_count} snapshot file(s), ${rejected_count} rejected combo(s), 1 function snapshot."
