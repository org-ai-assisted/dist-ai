#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Boot an imported Whonix Gateway + Workstation pair headless on their VirtualBox
## internal network and assert the Workstation egresses to the internet ONLY via the
## Gateway's Tor (the core Whonix guarantee), then tear down.
##
## WS has a single internal-net NIC (no direct route), so its only path out is
## WS -> GW -> Tor by construction. The leak test PROVES that path is live and really
## Tor by running the authoritative anon-leak-test BATTERY inside the WS -- the full
## probe set (enumerate / icmp / udp-123 / ipv6 / tor-confirm / gateway-craft), fail-
## closed, with the AppArmor-confined systemcheck (both SocksPort + TransPort) as the
## live positive control -- NOT a single IsTor grep.
##
## Shipped Whonix images carry VBoxService, so the battery is RUN via guestcontrol
## (vbox-exec-local), NOT OCR. It is DELIVERED via a VBox shared folder (name 'shared',
## pre-attached before boot -> the guest's mnt-shared-vbox.service auto-mounts it at
## /mnt/shared as root, exec bit preserved). The share is the clean channel: guestcontrol
## copyto drops modes + is finicky, and guestcontrol has no host->guest stdin. The battery
## needs root (icmp + gateway-craft), so the WS boots SYSMAINT (user session blocks sudo);
## the GW routes in its default user session.
##
## CANARY (no silent green): the WS gateway-craft probe EMITS deliberate direct-egress
## packets at tagged clearnet IPs while the GW's external NIC is traced to a host pcap
## (VBoxManage --nictrace -- a diagnostic tap, no network/routing change, and the only
## host observation the non-root VM-owner can make). The tagged destinations MUST NOT
## appear leaving the GW (Tor carries no such destination), while the pcap being
## non-empty + tor-confirm passing prove the observation is not blind.
##
## Runs AS the VM-owner fleet user (per-$HOME VBox state); never needs host root.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"
VBOXMANAGE="${VBOXMANAGE:-VBoxManage}"
GUESTCTL="${GUESTCTL:-vbox-ctl-local}"
TESSERACT="${TESSERACT:-tesseract}"
VBOX_EXEC_LOCAL="${VBOX_EXEC_LOCAL:-vbox-exec-local}"
TCPDUMP="${TCPDUMP:-tcpdump}"
## Where a leak's GW-NIC capture is preserved for forensics (see on_exit).
LEAK_ARTIFACT_DIR="${LEAK_ARTIFACT_DIR:-${HOME:-${TMP:-}}}"

PASS_RC=0
FAIL_RC=5
SETUP_RC=2

gw='Whonix-Gateway-LXQt'
ws='Whonix-Workstation-LXQt'
## committed clean-desktop snapshot each VM is restored to before a run.
SNAPSHOT="${SNAPSHOT:-clean-live}"
## anon-leak-test checkout ON THIS HOST, pushed into the WS (the single authoritative
## battery -- no re-embedded copy). Provisioned location; overridable.
ANON_LEAK_TEST_REPO="${ANON_LEAK_TEST_REPO:-/var/lib/image-tests/anon-leak-test}"
## The battery needs root (icmp + gateway-craft). The sysmaint session has passwordless sudo by
## default, so run it under a plain `sudo`. Under guestcontrol there is no tty, so an image that
## ever required a password makes sudo FAIL (non-zero) rather than hang or pass vacuously --
## fail-closed, never a silent green.
## Where the guest auto-mounts the 'shared' folder that carries the battery (fixed by the
## guest's mnt-shared-vbox.service). The host staging dir is made in main.
GUEST_SHARE_MOUNT='/mnt/shared'
share_dir=''

## Clearnet targets the battery aims its direct-egress probes at (anon-leak-test's fixed
## defaults, so the GW-pcap watch list is exactly these). On a CORRECT Whonix the GW drops/
## torifies everything, so nothing reaches them; only a LEAK would send a handful of packets
## to these PUBLIC services (1.1.1.1 welcomes connectivity tests; Cloudflare NTP is public).
CLEARNET_ICMP='1.1.1.1'
CLEARNET_NTP='162.159.200.123'
## gateway-craft's forged SOURCE is RFC 5737 TEST-NET-2 (reserved; routes nowhere).
CRAFT_SRC='198.51.100.99'
## IPv6 emit targets (only reached if the GW uplink carries global IPv6): a public v6
## target and the RFC 3849 doc-range forged v6 source. Defined here so the aim and the
## canary watch list are ONE source. Passed to the battery as --clearnet-ipv6/--craft-src6.
CLEARNET_IPV6='2606:4700:4700::1111'
CRAFT_SRC6='2001:db8:beef::99'

## Pinned Tor entry guards: a small fixed set of high-uptime / high-capacity relays. gw_pin_guards
## forces the GW onto ONLY these (EntryNodes + StrictNodes 1), so the GW's ONLY Tor egress is these
## IPs. Expect Tor-only by DEFAULT: ANY other clearnet dst -- incl. a NON_TOR_GATEWAY host-DNS/LAN
## exception -- is a LEAK, never allowlisted. Refresh from the live consensus if a relay churns;
## fail-closed -- a pin Tor cannot bootstrap on never passes (SETUP).
## Source: onionoo top-consensus-weight Guard relays, 2026-10-04 (nickname / fingerprint / addr:ORPort):
##   magic848relay 616C915B1EA788FA1177EF6194608C0E13B28A96  148.251.33.107:9001
##   0x90          D95A2DF17815BA92E4EA49D2D46EBAEB1DCEBABC  88.99.7.87:9001
##   doraemon      4DD822C2CF4542CDF2EDA22480C4EB0331E7B6DB  185.107.57.64:443
##   setsun        FB54F9C8AE5A3A89FDAFF834DFA9637F22D70C38  94.130.133.51:9001
## v4-only: the VBox NAT uplink is v4, so EntryNodes pins v4 (none of these four publish a v6 ORPort).
GUARD_PIN_IPS4=( '148.251.33.107' '88.99.7.87' '185.107.57.64' '94.130.133.51' )
GUARD_PIN_IPS6=()
## Reserved positive-control guard: allowlisted like the entry guards but DELIBERATELY EXCLUDED from
## EntryNodes, so Tor never connects to it and EVERY packet to this IP is the deterministic canary
## emit -- cleanly separable from genuine Tor guard traffic by HOST (no port heuristics). The emit
## is a legitimate TCP connection to this PUBLIC relay's real ORPort (published in the consensus for
## any client to connect to -- authorized by design, not an unsolicited scan), so it raises no abuse
## complaint. gw_positive_control dials GUARD_PC_IP4:GUARD_PC_PORT as the clearnet user.
##   F3Netze 9454F82D47EBA0CB0C2A4BFE7966181DBF108147  185.220.100.242:9100, [2a0b:f4c0:16c:14::1]:9100
GUARD_PC_IP4='185.220.100.242'
GUARD_PC_IP6='2a0b:f4c0:16c:14::1'
GUARD_PC_PORT='9100'
## Whonix %includes /usr/local/etc/torrc.d/*.conf; a drop-in there is picked up at Tor start.
GW_TORRC_PIN='/usr/local/etc/torrc.d/50_dm-whonix-pair-pin.conf'
## Liveness floor: the trace must contain at least this many GENUINE Tor guard packets (the entry
## guards on their ORPorts), counted SEPARATELY from the reserved-guard positive-control emit so the
## artificial canary packet never inflates it. A real Tor guard TLS+circuit over a run is hundreds;
## a tiny count means an UNDERCOUNTING (dropping) tap or Tor never reached a guard, not a trustworthy
## clean. A floor, not an exact expectation.
GUARD_MIN_PKTS='10'

gw_started='false'
ws_started='false'
nictrace_pcap=''

die() {
   printf '%s: ERROR: %s\n' "${me}" "$2" >&2
   exit "$1"
}

## Current VBox run-state of a VM ('running', 'poweroff', 'aborted', ...); empty if
## showvminfo failed. Single source for the VMState parse used across the harness.
vm_state() {
   "${VBOXMANAGE}" showvminfo "$1" --machinereadable 2>/dev/null \
      | sed -n 's/^VMState="\(.*\)"$/\1/p' || true
}

## Fast-fail guard: a VM that is no longer running (crashed/aborted/powered off) will
## never make progress, so detect it in ONE check instead of waiting out a whole retry
## budget. Call in any wait loop that depends on the VM being up.
assert_vm_running() {
   local vm="$1" label="$2" state
   state="$(vm_state "${vm}")"
   case "${state}" in
      running|paused)
         return 0
         ;;
      *)
         die "${SETUP_RC}" "${label}: VM '${vm}' is not running (state=${state:-unknown}) -- boot crashed/aborted; a provisioning/infra failure, not a WS leak"
         ;;
   esac
}

## Resolve from BASH_SOURCE[0], not $0: this script is source-able (guard at EOF) and
## the canary test sources it, where $0 is the TEST's path -> the wrong lib_base.
lib_base="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")/../share/dm-smbios-reader-boot-tests"
[ -d "${lib_base}" ] || lib_base='/usr/share/dm-smbios-reader-boot-tests'
# shellcheck source=./usr/share/dm-smbios-reader-boot-tests/gui-drive.bsh
source "${lib_base}/gui-drive.bsh"
# shellcheck source=./usr/share/dm-smbios-reader-boot-tests/grub-boot-select.bsh
source "${lib_base}/grub-boot-select.bsh"
# shellcheck source=./usr/share/dm-smbios-reader-boot-tests/vbox-session.bsh
source "${lib_base}/vbox-session.bsh"

usage() {
   printf '%s\n' "usage: ${me} [--gw NAME] [--ws NAME]

--gw   Whonix Gateway VM name (default: ${gw})
--ws   Whonix Workstation VM name (default: ${ws})

Boots both headless, runs the anon-leak-test battery in the Workstation (sysmaint),
and asserts it egresses ONLY through the Gateway's Tor. Exit 0 = PASS."
}

parse_args() {
   while [ "$#" -gt 0 ]; do
      case "$1" in
         --gw)
            gw="$2"
            shift 2
            ;;
         --ws)
            ws="$2"
            shift 2
            ;;
         --print-guards)
            ## Single source of the allowlisted guard IPs (entry guards + the reserved
            ## positive-control guard), consumed by the host-wire oracle (host-wire-leak-capture)
            ## so the two never drift. One IP per line.
            printf '%s\n' "${GUARD_PIN_IPS4[@]}" "${GUARD_PIN_IPS6[@]}" "${GUARD_PC_IP4}" "${GUARD_PC_IP6}"
            exit 0
            ;;
         --print-allow-filter)
            ## Emit the exact deny-by-default allowlist BPF so the host-wire oracle applies the
            ## SAME semantics as the in-VM canary (single source; never a re-derived copy).
            [ "${#GUARD_PIN_IPS4[@]}" -gt 0 ] \
               || die "${SETUP_RC}" "no pinned guards configured -- cannot emit the allowlist filter"
            printf '%s\n' "$(allowlist_bpf)"
            exit 0
            ;;
         --print-pc-filter)
            ## Emit the reserved-guard positive-control discriminator BPF so the host-wire oracle
            ## counts the deliberate canary packet SEPARATELY from genuine Tor guard traffic, with
            ## the SAME definition as the in-VM canary (single source).
            printf '%s\n' "$(pc_bpf)"
            exit 0
            ;;
         -h|--help)
            usage
            exit 0
            ;;
         *)
            usage >&2
            die "${SETUP_RC}" "unknown argument: $1"
            ;;
      esac
   done
}

on_exit() {
   local rc=$?
   if [ "${ws_started}" = 'true' ]; then
      "${VBOXMANAGE}" controlvm "${ws}" poweroff >/dev/null 2>&1 || true
   fi
   if [ "${gw_started}" = 'true' ]; then
      "${VBOXMANAGE}" controlvm "${gw}" poweroff >/dev/null 2>&1 || true
      ## Poweroff is async and the nictrace pcap is not flushed until the GW settles;
      ## wait (bounded) so a preserved capture is complete, not truncated mid-write.
      local _i
      for _i in $(seq 1 15); do
         case "$(vm_state "${gw}")" in poweroff|aborted|'') break ;; esac
         sleep 1
      done
   fi
   ## Leave the NIC trace off so a later run / other use is not silently captured.
   "${VBOXMANAGE}" modifyvm "${gw}" --nictrace1 off >/dev/null 2>&1 || true
   ## The GW-NIC pcap is the leak oracle's evidence. On a clean PASS it is noise -> drop it.
   ## On ANY non-clean exit (a leak, or an inconclusive abort) PRESERVE it plus a tcpdump
   ## decode as a durable artifact: deleting the one capture that matters would make a real
   ## leak unauditable. If the copy FAILS, keep the original in place (never delete the only
   ## evidence on a failure path) and warn.
   if [ -n "${nictrace_pcap}" ] && [ -e "${nictrace_pcap}" ]; then
      if [ "${rc}" -ne "${PASS_RC}" ]; then
         mkdir -p -- "${LEAK_ARTIFACT_DIR}" 2>/dev/null || true
         local keep
         keep="${LEAK_ARTIFACT_DIR}/whonix-pair-leak-$(date +%Y%m%d-%H%M%S)-$$.pcap"
         if cp -- "${nictrace_pcap}" "${keep}" 2>/dev/null; then
            "${TCPDUMP}" -nr "${keep}" >"${keep%.pcap}.txt" 2>/dev/null || true
            printf '%s\n' "${me}: non-clean exit (rc=${rc}); GW capture PRESERVED: ${keep} (decode: ${keep%.pcap}.txt)" >&2
            safe-rm -f -- "${nictrace_pcap}" 2>/dev/null || true
         else
            printf '%s\n' "${me}: WARNING: could not preserve GW capture to ${LEAK_ARTIFACT_DIR}; leaving the only copy at ${nictrace_pcap}" >&2
         fi
      else
         safe-rm -f -- "${nictrace_pcap}" 2>/dev/null || true
      fi
   fi
   ## Drop the battery share (reverted by the next snapshot restore anyway) + its host dir.
   "${VBOXMANAGE}" sharedfolder remove "${ws}" --name shared >/dev/null 2>&1 || true
   if [ -n "${share_dir}" ]; then
      safe-rm --recursive --force -- "${share_dir}" 2>/dev/null || true
   fi
}

## Power off, restore the clean snapshot, then discardstate so the next start is a FRESH
## boot (reaches GRUB) rather than a live-snapshot RESUME -- required to pick a boot role
## and to (re)apply a NIC trace the snapshot would otherwise revert.
restore_fresh() {
   local target="$1"
   "${VBOXMANAGE}" controlvm "${target}" poweroff >/dev/null 2>&1 || true
   for _ in $(seq 1 20); do
      case "$(vm_state "${target}")" in poweroff|aborted|'') break ;; esac
      sleep 2
   done
   "${VBOXMANAGE}" snapshot "${target}" restore "${SNAPSHOT}" >/dev/null 2>&1 \
      || die "${SETUP_RC}" "${target}: cannot restore snapshot '${SNAPSHOT}' -- a provisioning failure, not a WS leak"
   "${VBOXMANAGE}" discardstate "${target}" >/dev/null 2>&1 || true
}

## Boot the Gateway fresh in its default (user) role. TWO boots: the first UNtraced, only to PIN
## the entry guards; then -- after a CLEAN poweroff that flushes the torrc write -- re-boot with
## the EXTERNAL NIC traced to a host pcap (the canary observation point). Pinning BEFORE the trace
## means the capture holds ONLY pinned-guard traffic; the warmed snapshot's own persisted guards
## never pollute the allowlist. (The cost of pinning at runtime rather than in the snapshot.) The
## GW only routes; the sole in-guest command is the one-shot guard pin.
boot_gateway() {
   vm="${gw}"
   restore_fresh "${gw}"
   ## Boot 1 (UNtraced) exists ONLY to write the guard pin -- it must NOT egress. A warmed snapshot
   ## autostarts Tor onto its OWN persisted (non-pinned) guards the moment it boots; on the shared
   ## host wire (a continuous capture that brackets the whole run) that pre-pin traffic would read
   ## as non-pinned-guard clearnet and FALSE-FAIL. So DISCONNECT the external NIC for boot 1:
   ## guestcontrol rides the guest-additions channel (NIC-independent), so the pin still writes,
   ## while Tor has no uplink to reach any guard. Reconnected before the traced boot 2 below.
   "${VBOXMANAGE}" modifyvm "${gw}" --cabledisconnected1 on \
      || die "${SETUP_RC}" "${gw}: cannot disconnect the external NIC for the pin-only boot"
   "${VBOXMANAGE}" startvm "${gw}" --type headless >/dev/null
   gw_started='true'
   wait_guestcontrol_ready user 300 \
      || die "${SETUP_RC}" "${gw}: guestcontrol not ready as user to pin guards -- a provisioning failure, not a WS leak"
   gw_pin_guards
   ## CLEAN poweroff (ACPI) so the torrc write is flushed; a hard poweroff could lose it. NOT
   ## restore_fresh -- that reverts the pin; a plain power-cycle keeps the on-disk drop-in.
   ## gw_pin_guards already `sync`ed the drop-in, so even clean_poweroff's hard fallback cannot
   ## truncate it. Then WAIT for the VM to actually reach poweroff: clean_poweroff's hard-fallback
   ## path returns without waiting, and the next modifyvm needs the VM fully stopped.
   clean_poweroff
   ## Poll for a CONFIRMED off-state before re-tracing. An empty vm_state is transient showvminfo
   ## lock-contention (NOT off), so do not break on it; fail-closed if the VM never settles -- the
   ## next modifyvm needs it fully stopped.
   local _i off='false'
   for _i in $(seq 1 20); do
      case "$(vm_state "${gw}")" in
         poweroff|aborted)
            off='true'
            break
            ;;
      esac
      sleep 2
   done
   [ "${off}" = 'true' ] \
      || die "${SETUP_RC}" "${gw}: did not reach poweroff before re-trace -- a provisioning failure, not a WS leak"
   ## Boot 2 (TRACED): RECONNECT the external NIC, enable the NIC trace offline (-u: just a name,
   ## VBox creates the pcap), then start. Tor autostarts and StrictNodes forces it onto the pinned
   ## guards only -- now the FIRST clearnet egress of the measured boot, so neither the guest trace
   ## nor the host wire sees any pre-pin guard.
   nictrace_pcap="$(mktemp -u -t "whonix-gw-trace.XXXXXX.pcap")"
   "${VBOXMANAGE}" modifyvm "${gw}" --cabledisconnected1 off --nictrace1 on --nictracefile1 "${nictrace_pcap}" \
      || die "${SETUP_RC}" "${gw}: cannot reconnect the external NIC / enable --nictrace1"
   "${VBOXMANAGE}" startvm "${gw}" --type headless >/dev/null
}

## Boot the Workstation fresh into SYSMAINT (root available for the full battery), then
## wait until guestcontrol answers as sysmaint.
boot_workstation_sysmaint() {
   vm="${ws}"
   restore_fresh "${ws}"
   ## Attach the battery share BEFORE boot (name 'shared', read-only) so the guest's
   ## mnt-shared-vbox.service auto-mounts it at /mnt/shared as root. Snapshot restore reverts
   ## it, so (re)attach every run.
   "${VBOXMANAGE}" sharedfolder add "${ws}" --name shared --hostpath "${share_dir}" --readonly \
      || die "${SETUP_RC}" "${ws}: cannot attach the battery shared folder"
   "${VBOXMANAGE}" startvm "${ws}" --type headless >/dev/null
   ws_started='true'
   ## Select "PERSISTENT Mode | SYSMAINT Session" at the GRUB "Choose boot mode" menu
   ## before its ~5s autoboot into USER (single-source selector, shared with the gates).
   select_installed_sysmaint
   wait_guestcontrol_ready sysmaint 300 \
      || die "${SETUP_RC}" "${ws}: guestcontrol not ready as sysmaint -- a provisioning failure, not a WS leak"
}

## Run the battery in the WS as sysmaint via guestcontrol; its exit code is the verdict
## (0 clear / 1 leak / 2 inconclusive). PROBES selects the probe set.
ws_battery() {
   local probes="$1"
   ## Run the battery (on the /mnt/shared mount) as root via plain sudo (sysmaint = passwordless
   ## sudo). The guest exit code IS the verdict; one short command, no inline script.
   "${VBOX_EXEC_LOCAL}" "${ws}" --role sysmaint --timeout 300 \
      --cmd "sudo python3 -Bsu ${GUEST_SHARE_MOUNT}/anon-leak-test ${probes} --json"
}

## Functional positive control: confirm LIVE Tor egress via the AppArmor-confined, hardened
## systemcheck -- a stronger confirmer than a bespoke curl/JSON parse (a subverted control would
## mask a dead link). Confirm BOTH ports: systemcheck's check_tor_socks_or_trans_port is an OR, so
## a single-port pass could ride a HALF-broken Tor; require SocksPort AND TransPort. Runs as
## sysmaint (the booted role), NO sudo: a single --function run skips root_check and the
## connectivity test is user-agnostic, and it avoids the full --leak-tests `systemctl --user
## is-system-running` (no user session under guestcontrol). Each systemcheck exit 0 = that port
## reached Tor; ANY non-zero fails the control -- fail-closed.
ws_tor_confirm() {
   local port
   for port in check_tor_socks_port check_tor_trans_port; do
      "${VBOX_EXEC_LOCAL}" "${ws}" --role sysmaint --timeout 300 \
         --cmd "systemcheck --cli --leak-tests --function ${port}" \
         || return 1
   done
   return 0
}

## Flush the Workstation's OWN nftables firewall before the leak battery. The WS firewall is a
## failsafe; the MAIN Whonix leak protection is the GATEWAY. With the WS firewall up, a leak probe
## can be DROPPED at the WS and never reach the GW external NIC -- a false "clean" that would hide
## a broken Gateway. Flushing it lets every probe flow to the GW, so the GW-NIC / host-wire canary
## measures the GATEWAY's protection (the real boundary). The WS has no direct route (single
## internal NIC via the GW), so this exposes no new egress path; snapshot restore reverts it.
## Fail-closed: if the WS firewall cannot be flushed+confirmed-empty, a leak could be masked at
## the WS -> SETUP, never a vacuous pass. Runs as sysmaint (passwordless sudo).
ws_flush_firewall() {
   ## DUMP the ruleset (shared dumper) -> FLUSH all -> DUMP again (same dumper) -> CHECK empty.
   ## The BEFORE dump is emitted to the host log (forensics: what was flushed); the AFTER dump is
   ## the fail-closed empty check -- a non-empty AFTER means the flush did not take.
   ## Capture the AFTER-dump's rc separately: a failed `nft list` with empty stdout must NOT read
   ## as confirmed-empty (`after=$(dump) || exit 1`), else a broken list vacuously "passes".
   "${VBOX_EXEC_LOCAL}" "${ws}" --role sysmaint --timeout 120 \
      --cmd "dump() { sudo --non-interactive nft list ruleset; }; printf 'ws_flush_firewall: WS nft ruleset BEFORE flush:\n' >&2; dump >&2; sudo --non-interactive nft flush ruleset; after=\"\$(dump)\" || exit 1; [ -z \"\${after}\" ]" \
      || die "${SETUP_RC}" "could not flush+confirm-empty the WS nftables firewall (a leak could be masked at the WS) -- inconclusive, not a leak"
}

## Positive-control EMIT: from the GW, as the `clearnet` user (allowed DIRECT clearnet TCP on the
## GW -- not torified), open ONE TCP connection to the RESERVED guard's real ORPort. Legitimate:
## that ORPort is published in the public consensus for any client to connect to, so a single
## connection attempt is authorized by design and raises no abuse complaint (not an unsolicited
## scan). The reserved guard is allowlisted (no leak) and excluded from EntryNodes (Tor never uses
## it), so this puts a DETERMINISTIC known-good packet on the wire that the canary counts SEPARATELY
## from genuine Tor guard traffic. Wrapped (|| true) so a transient guestcontrol error does not
## abort before the canary runs; canary_gateway_pcap's pc_seen>=1 check is the authoritative gate
## (a truly missing emit surfaces there as SETUP, never a silent pass).
gw_positive_control() {
   "${VBOX_EXEC_LOCAL}" "${gw}" --role user --timeout 60 \
      --cmd "leaprun sudo && sudo --non-interactive -u clearnet timeout 5 bash -c 'exec 3<>/dev/tcp/${GUARD_PC_IP4}/${GUARD_PC_PORT}'; true" \
      || true
}

## Stop Tor on the Gateway to ARM the killswitch, keeping the GW in its USER session so
## forwarding stays intact (a sysmaint boot could sever it). dev-root -- run once in a
## sysmaint session and baked into the clean-live snapshot -- makes `leaprun sudo` grant
## passwordless root in the user session. Fail-closed: if Tor cannot be stopped the
## killswitch is untestable -> SETUP, never a silent pass. A short retry rides out
## guestcontrol/VBoxService settling.
gw_stop_tor() {
   local attempt
   for attempt in $(seq 1 3); do
      ## Positively CONFIRM Tor is down in the same call: stop it, then negate
      ## `is-active --quiet` so the remote command succeeds ONLY when tor@default is no
      ## longer active. This is the fail-closed proof Tor is actually stopped -- it does
      ## not rely on interpreting a later probe's ambiguous exit code.
      if "${VBOX_EXEC_LOCAL}" "${gw}" --role user --timeout 120 \
         --cmd "leaprun sudo && sudo --non-interactive systemctl stop tor@default.service && sleep 5 && ! sudo --non-interactive systemctl is-active --quiet tor@default.service"; then
         return 0
      fi
      printf '%s\n' "${me}: GW Tor-stop attempt ${attempt} failed; retrying" >&2
      sleep 10
   done
   die "${SETUP_RC}" "killswitch: could not stop Tor on the GW (dev-root in the snapshot? leaprun sudo available? tor@default unit name?)"
}

## Restart Tor on the Gateway after the killswitch window, so the STOP is a bracketed,
## reversible operation. Same user-session + leaprun sudo path as gw_stop_tor.
gw_start_tor() {
   "${VBOX_EXEC_LOCAL}" "${gw}" --role user --timeout 120 \
      --cmd "leaprun sudo && sudo --non-interactive systemctl start tor@default.service" \
      || die "${SETUP_RC}" "killswitch recovery: could not restart Tor on the GW"
}

## Pin the GW's Tor to the fixed entry guards (EntryNodes + StrictNodes 1) so its ONLY Tor egress
## is GUARD_PIN_IPS4. The allowlist is a superset -- those entry guards PLUS the reserved
## positive-control guard (GUARD_PC_IP4, deliberately not an EntryNode, so Tor never dials it). Written
## as a torrc.d drop-in (Whonix %includes /usr/local/etc/torrc.d/*.conf) via leaprun sudo in the
## GW USER session (forwarding intact), then read back + synced so a clean poweroff flushes it.
## Done on the UNtraced first boot; boot_gateway then power-cycles into the TRACED boot where Tor
## connects to ONLY these guards. Fail-closed: any failure -> SETUP, never a silent pass (a GW
## that cannot be pinned must not be measured against this allowlist).
gw_pin_guards() {
   local csv
   csv="$(IFS=','; printf '%s' "${GUARD_PIN_IPS4[*]}")"
   "${VBOX_EXEC_LOCAL}" "${gw}" --role user --timeout 120 \
      --cmd "leaprun sudo && printf 'EntryNodes %s\nStrictNodes 1\n' '${csv}' | sudo --non-interactive tee ${GW_TORRC_PIN} >/dev/null && sudo --non-interactive grep -q '^StrictNodes 1' ${GW_TORRC_PIN} && sudo --non-interactive sync" \
      || die "${SETUP_RC}" "could not pin entry guards on the GW (torrc.d writable? leaprun sudo available?)"
}

## Deny-by-default allowlist BPF: permit ONLY the pinned guards + structural link infra; any other
## clearnet packet is a leak. SINGLE source of the allowlist semantics: canary_gateway_pcap uses
## it, and --print-allow-filter emits it verbatim for the host-wire oracle (host-wire-leak-capture),
## so the in-VM and on-the-wire oracles never drift.
##
## Every infra exclusion is scoped so a clearnet dst can NEVER hide behind an infra-looking
## endpoint, AND so VBox slirp's surprising routing is not mistaken for unroutable:
##   - DHCP is `port 67 AND port 68 AND dst 255.255.255.255` (the real broadcast exchange slirp
##     consumes) -- not the ports alone (else `:68 -> 8.8.8.8:67` would be exempt), and not a bare
##     `dst 255.255.255.255` (slirp rewrites that to the host's 127.0.0.1, so a non-DHCP packet
##     there IS a leak path).
##   - multicast is `dst net 224.0.0.0/4` (not tcpdump's `ip multicast`, which is a bare `>= 224`
##     with no upper bound, so 240.0.0.0/4 and 255.0.0.0/8 would leak).
##   - link-local dst only (slirp does not route it off-link); NO loopback exclusion -- slirp
##     delivers 127.0.0.1 / ::1 to the HOST, so those are leaks, not local.
## Guards match EITHER direction (`host`): a nictrace/host tap also sees the guard's REPLIES (whose
## dst is the local NAT/host IP, not a guard) and the self IP differs per observation point, so a
## dst-only guard match would flag every legit reply. Accepted + documented limitations (the
## denylist and the live run backstop these): a packet FORGING a guard IP as its SOURCE to a
## clearnet dst is allowed (no exfil value, and the tested forged-source vector uses CRAFT_SRC,
## which the denylist catches); EntryNodes pins IPs not fingerprints (a deliberate single-source
## choice -- traffic to any relay at a pinned IP is still Tor egress, which is what a leak test
## proves); and a COLD snapshot could bootstrap via non-pinned fallback dirs -- the harness
## requires a WARMED clean-live snapshot so Tor fetches through the pinned guards.
## ALL allowlisted guards (entry guards + the reserved positive-control guard) as a BPF host-match
## (EITHER direction), the single "permitted" set the allowlist is built from. Empty string if none.
guard_hosts_bpf() {
   local allow='' guard
   for guard in "${GUARD_PIN_IPS4[@]}" "${GUARD_PIN_IPS6[@]}" "${GUARD_PC_IP4}" "${GUARD_PC_IP6}"; do
      allow="${allow:+${allow} or }host ${guard}"
   done
   printf '%s' "${allow}"
}

## The reserved positive-control guard ONLY (EITHER direction). Tor never connects here (not an
## EntryNode), so every captured packet to this IP is the deliberate canary emit -- the discriminator
## that counts the positive control SEPARATELY from genuine Tor guard traffic. Both oracles derive
## `genuine Tor guard traffic` as `guard_hosts_bpf AND NOT pc_bpf` (identical semantics, no drift).
pc_bpf() {
   local allow='' guard
   for guard in "${GUARD_PC_IP4}" "${GUARD_PC_IP6}"; do
      allow="${allow:+${allow} or }host ${guard}"
   done
   printf '%s' "${allow}"
}

allowlist_bpf() {
   local infra allow
   infra='(udp port 67 and udp port 68 and dst host 255.255.255.255) or dst net 224.0.0.0/4 or dst net 169.254.0.0/16 or (ip6 and (dst net ff00::/8 or dst net fe80::/10))'
   allow="$(guard_hosts_bpf)"
   printf '%s' "(ip or ip6) and not ( ${infra} ) and not ( ${allow} )"
}

## PASS only if NONE of the battery's tagged clearnet targets appear leaving the GW's
## external NIC (Tor carries no such destination), AND the trace actually captured
## traffic (non-blind). tcpdump -r reads the pcap -- no root. Fail-closed: a missing /
## unreadable pcap is treated as a blind capture, never a pass.
canary_gateway_pcap() {
   local total deny_filter hits_out hits leaks_out leaks tor_out tor_seen pc_out pc_seen rc
   [ -s "${nictrace_pcap}" ] || die "${SETUP_RC}" "canary: GW nictrace pcap empty/missing (blind capture -- inconclusive, not a leak)"
   total="$("${TCPDUMP}" -nr "${nictrace_pcap}" 2>/dev/null | wc -l)"
   [ "${total}" -gt 0 ] || die "${SETUP_RC}" "canary: GW emitted nothing on its external NIC (blind -- inconclusive, not a leak)"
   ## A FILTERED run that is piped to `wc -l` hides tcpdump's exit status: a filter that fails to
   ## COMPILE (libpcap lacking a primitive, a malformed BPF) prints nothing -> count 0 -> a false
   ## "no leak" in any caller where errexit is suppressed. Capture tcpdump's rc DIRECTLY (no pipe)
   ## and die SETUP on failure, so a bad filter is inconclusive, never a clean pass. Counts here
   ## are the leak matches only (0 on a clean run), so holding the output in a var is cheap.
   ## Watch the clearnet targets as DESTINATION and the forged sources as SOURCE (a forged-source
   ## leak egresses with CRAFT_SRC/CRAFT_SRC6 as SOURCE to any dst; the un-NAT'd redirect reply
   ## with dst=CRAFT_SRC is still caught by the dst match).
   deny_filter="dst host ${CLEARNET_ICMP} or dst host ${CLEARNET_NTP} or dst host ${CLEARNET_IPV6} or host ${CRAFT_SRC} or host ${CRAFT_SRC6}"
   rc=0
   hits_out="$("${TCPDUMP}" -nr "${nictrace_pcap}" "${deny_filter}" 2>/dev/null)" || rc=$?
   [ "${rc}" -eq 0 ] \
      || die "${SETUP_RC}" "canary: denylist filter failed to run (unreadable pcap / non-compiling filter) -- inconclusive, not a leak verdict"
   hits=0
   [ -z "${hits_out}" ] || hits="$(printf '%s\n' "${hits_out}" | wc -l)"
   [ "${hits}" -eq 0 ] \
      || die "${FAIL_RC}" "LEAK: a WS probe target reached clearnet via the GW (${hits} pkt(s)) -- NOT Tor-only"
   ## Allowlist (deny-by-default): permit ONLY the allowlisted guards -- entry guards + the reserved
   ## positive-control guard -- (either direction) + link infra; EVERY other clearnet packet is a
   ## LEAK -- Tor-only by default, NO carve-out for host-DNS / a NON_TOR_GATEWAY exception. Catches a
   ## GW-originated non-Tor egress the fixed denylist above never names. Fail-closed: an empty guard
   ## set cannot form an allowlist.
   [ "${#GUARD_PIN_IPS4[@]}" -gt 0 ] \
      || die "${SETUP_RC}" "canary: no pinned guards configured -- cannot build the allowlist (inconclusive, not a leak)"
   ## Liveness floor -- GENUINE Tor guard traffic (entry guards on their ORPorts), i.e. all
   ## allowlisted guards EXCEPT the reserved positive-control guard (`guard_hosts_bpf AND NOT
   ## pc_bpf`). The GW's Tor MUST have reached an entry guard, so this MUST be non-trivial; a tiny
   ## count => blind/undercounting tap (wrong NIC / died / over-tight filter) OR Tor never connected
   ## => inconclusive, never a pass. Counted separately from the pc emit so the artificial canary
   ## packet can never satisfy this floor.
   rc=0
   tor_out="$("${TCPDUMP}" -nr "${nictrace_pcap}" "$(guard_hosts_bpf) and not ( $(pc_bpf) )" 2>/dev/null)" || rc=$?
   [ "${rc}" -eq 0 ] || die "${SETUP_RC}" "canary: Tor guard-traffic read failed -- inconclusive, not a leak verdict"
   tor_seen=0
   [ -z "${tor_out}" ] || tor_seen="$(printf '%s\n' "${tor_out}" | wc -l)"
   [ "${tor_seen}" -ge "${GUARD_MIN_PKTS}" ] \
      || die "${SETUP_RC}" "canary: GW NIC trace shows only ${tor_seen} genuine Tor guard pkt(s) (< ${GUARD_MIN_PKTS}) -- blind/undercounting capture or Tor never reached a guard (inconclusive, not a pass)"
   ## Positive control -- the deliberate capture canary: the clearnet user's TCP connection to the
   ## reserved guard's real ORPort MUST appear, proving the tap catches a known-good packet. Counted
   ## on its own (pc_bpf) so it neither masks nor is masked by the Tor floor. Zero => the capture is
   ## blind to the reserved-guard flow or the emit failed => inconclusive, never a pass.
   rc=0
   pc_out="$("${TCPDUMP}" -nr "${nictrace_pcap}" "$(pc_bpf)" 2>/dev/null)" || rc=$?
   [ "${rc}" -eq 0 ] || die "${SETUP_RC}" "canary: positive-control read failed -- inconclusive, not a leak verdict"
   pc_seen=0
   [ -z "${pc_out}" ] || pc_seen="$(printf '%s\n' "${pc_out}" | wc -l)"
   [ "${pc_seen}" -ge 1 ] \
      || die "${SETUP_RC}" "canary: positive-control emit (clearnet user -> reserved guard ${GUARD_PC_IP4}:${GUARD_PC_PORT}) not observed (${pc_seen} pkt) -- capture blind to the deliberate canary or emit failed (inconclusive, not a pass)"
   rc=0
   leaks_out="$("${TCPDUMP}" -nr "${nictrace_pcap}" "$(allowlist_bpf)" 2>/dev/null)" || rc=$?
   [ "${rc}" -eq 0 ] \
      || die "${SETUP_RC}" "canary: allowlist filter failed to run (non-compiling filter?) -- inconclusive, not a leak verdict"
   leaks=0
   [ -z "${leaks_out}" ] || leaks="$(printf '%s\n' "${leaks_out}" | wc -l)"
   [ "${leaks}" -eq 0 ] \
      || die "${FAIL_RC}" "LEAK: ${leaks} non-guard clearnet pkt(s) on the GW NIC -- NOT Tor-only (allowlist; see preserved pcap decode)"
   printf '%s\n' "${me}: canary OK (GW emitted ${total} pkt(s); ${tor_seen} genuine Tor guard pkt(s), ${pc_seen} positive-control pkt(s); 0 probe-target, 0 non-guard clearnet)"
}

main() {
   parse_args "$@"
   [ -x "${ANON_LEAK_TEST_REPO}/usr/bin/anon-leak-test" ] \
      || die "${SETUP_RC}" "anon-leak-test checkout not found at ${ANON_LEAK_TEST_REPO} (set ANON_LEAK_TEST_REPO)"
   [ -r "${ANON_LEAK_TEST_REPO}/usr/bin/anon-leak-inject" ] \
      || die "${SETUP_RC}" "anon-leak-inject (the shared L2 crafter) not found beside anon-leak-test in ${ANON_LEAK_TEST_REPO}"
   trap on_exit EXIT
   ## Stage the REAL battery + its sibling injector (read live, no drift) in a host dir
   ## shared read-only into the WS. gateway-craft finds anon-leak-inject beside itself on
   ## /mnt/shared and drives it (the single shared crafter -- no re-embedded copy).
   share_dir="$(mktemp -d -t whonix-battery.XXXXXX)"
   cp -- "${ANON_LEAK_TEST_REPO}/usr/bin/anon-leak-test" "${share_dir}/anon-leak-test"
   cp -- "${ANON_LEAK_TEST_REPO}/usr/bin/anon-leak-inject" "${share_dir}/anon-leak-inject"
   ## Opt-in app/browser layer: stage the WebRTC harness beside the battery (anon-leak-test's
   ## find_harness looks beside itself on /mnt/shared).
   if [ "${DM_WHONIX_PAIR_BROWSER:-0}" = '1' ]; then
      [ -r "${ANON_LEAK_TEST_REPO}/usr/share/anon-leak-test/anon-leak-webrtc.html" ] \
         || die "${SETUP_RC}" "DM_WHONIX_PAIR_BROWSER=1 but the WebRTC harness is missing in ${ANON_LEAK_TEST_REPO}/usr/share/anon-leak-test"
      cp -- "${ANON_LEAK_TEST_REPO}/usr/share/anon-leak-test/anon-leak-webrtc.html" "${share_dir}/anon-leak-webrtc.html"
   fi

   printf '%s\n' "${me}: boot Gateway (${gw}) with external-NIC trace"
   boot_gateway

   printf '%s\n' "${me}: boot Workstation (${ws}) into sysmaint (battery on /mnt/shared)"
   boot_workstation_sysmaint

   ## Phase 1: gate on the GW's Tor bootstrap -- retry the systemcheck positive control
   ## (SocksPort + TransPort) until it passes, so a clean battery later is meaningful, not
   ## a dead link.
   printf '%s\n' "${me}: wait for Tor egress (systemcheck SocksPort + TransPort) to come up"
   ## NOTE: clean-live must be a WARMED snapshot (booted once so first-boot provisioning
   ## ran and Tor cached its consensus on disk); a never-booted import does a cold Tor
   ## bootstrap that can exceed this budget (seen on a fresh dev-version import).
   local attempt tor_ok='false'
   for attempt in $(seq 1 15); do
      ## Fast-fail: a crashed/aborted GW will never bootstrap -- do not burn the whole
      ## retry budget on a dead VM.
      assert_vm_running "${gw}" 'phase 1 (wait Tor)'
      if ws_tor_confirm; then
         tor_ok='true'
         break
      fi
      printf '%s\n' "${me}: Tor not confirmed yet (attempt ${attempt}); retrying"
      sleep 20
   done
   ## Budget exhausted = the positive control never confirmed Tor. INCONCLUSIVE (GW Tor did
   ## not bootstrap, a provisioning gap, or a persistent leak that systemcheck's binary exit
   ## cannot tell apart from "not up") -> SETUP: fail-closed, never a PASS and never a false
   ## leak verdict. The authoritative leak oracle (Phase 2 battery + GW-NIC canary) runs ONLY
   ## after Tor is confirmed here; if it never is, the run is reported inconclusive, not clean.
   [ "${tor_ok}" = 'true' ] || die "${SETUP_RC}" "Tor egress never confirmed (GW Tor did not bootstrap / provisioning gap) -- inconclusive, NOT a leak"

   ## Flush the WS's OWN firewall before the battery: the MAIN leak protection is the GATEWAY, and
   ## a WS-firewall drop would stop a leak probe at the WS so it never reaches the GW NIC -- a
   ## false "clean" that hides a broken GW. Removing it lets every probe flow to the GW so the
   ## canary measures the GATEWAY's protection. Reverted by the next snapshot restore.
   ws_flush_firewall

   ## Craft aim + watch list in ONE place: the gateway-craft matrix aims here and the
   ## canary (canary_gateway_pcap) watches exactly these. clearnet-ipv4 = CLEARNET_ICMP.
   local craft_flags="--clearnet-ipv4 ${CLEARNET_ICMP} --craft-src ${CRAFT_SRC} --clearnet-ipv6 ${CLEARNET_IPV6} --craft-src6 ${CRAFT_SRC6}"

   ## Phase 2: the FULL battery incl the comprehensive gateway-craft emit matrix (the
   ## deliberate direct-egress vectors the canary watches for). Exit 0 = Tor-only;
   ## anything else = leak/inconclusive.
   ## NOTE: ipv6-clearnet (the reply-based IPv6 Tor-confirm) is deliberately NOT in this
   ## battery. It is built for the Qubes anon-whonix context where Tor's DNS path serves
   ## check.torproject.org over IPv6; on a standard Whonix-Workstation with no global IPv6
   ## it ERRORs by design (curl --ipv6 cannot reach the A-only host), which would fail the
   ## run on a non-leak. The WS's IPv6 egress IS covered here -- by the gateway-craft v6
   ## matrix (emit + GW-NIC canary), which is gated on a live v6 path and recorded honestly.
   printf '%s\n' "${me}: run the full leak-test battery in the Workstation (sysmaint)"
   ## Battery exit: 0 clean | 1 a probe FAILed (proven non-Tor egress = LEAK) | 2 a probe
   ## could not run (inconclusive). Only a PROVEN leak is FAIL_RC; inconclusive is SETUP_RC
   ## -- a provisioning/transient probe error must never record as a leak verdict.
   local battery_rc=0
   ws_battery "--probe enumerate --probe icmp-clearnet --probe udp-clearnet --probe tor-confirm --probe gateway-craft ${craft_flags}" \
      || battery_rc=$?
   if [ "${battery_rc}" = '1' ]; then
      die "${FAIL_RC}" "LEAK: the battery proved non-Tor egress (a probe FAILed)"
   elif [ "${battery_rc}" != '0' ]; then
      die "${SETUP_RC}" "leak test INCONCLUSIVE: a probe could not run (battery rc=${battery_rc}) -- not a proven leak"
   fi

   ## Phase 2b: APP/BROWSER layer -- OPT-IN (DM_WHONIX_PAIR_BROWSER=1). Drives the WS browser
   ## (headless) via anon-leak-test's browser-webrtc probe: asserts WebRTC exposes no host IP
   ## and the browser's exit is Tor. Same 0/1/other exit contract as Phase 2. Run WITHOUT sudo
   ## (Tor Browser refuses to run as root); the probe auto-discovers the browser, or honour
   ## ANON_LEAK_BROWSER / DISPLAY injected via DM_WHONIX_PAIR_BROWSER_ENV. If no browser is
   ## found the probe is inconclusive (SETUP), never a vacuous pass.
   if [ "${DM_WHONIX_PAIR_BROWSER:-0}" = '1' ]; then
      printf '%s\n' "${me}: app/browser layer -- run the browser-webrtc probe in the Workstation"
      local browser_rc=0
      "${VBOX_EXEC_LOCAL}" "${ws}" --role sysmaint --timeout 300 \
         --cmd "${DM_WHONIX_PAIR_BROWSER_ENV:+env ${DM_WHONIX_PAIR_BROWSER_ENV} }python3 -Bsu ${GUEST_SHARE_MOUNT}/anon-leak-test --probe browser-webrtc --json" \
         || browser_rc=$?
      if [ "${browser_rc}" = '1' ]; then
         die "${FAIL_RC}" "LEAK: the browser layer proved non-Tor egress / a WebRTC host-IP exposure"
      elif [ "${browser_rc}" != '0' ]; then
         die "${SETUP_RC}" "app/browser layer INCONCLUSIVE: browser-webrtc could not run (rc=${browser_rc}; no browser in the WS?) -- not a proven leak"
      fi
   fi

   ## Phase 3+4: KILLSWITCH -- OPT-IN only (DM_WHONIX_PAIR_KILLSWITCH=1). Stopping Tor on
   ## the GW needs root there, and the only no-sysmaint route (dev-root -> leaprun sudo)
   ## MUTATES the Gateway, which can falsify the very leak result this harness measures.
   ## So the DEFAULT run is the pure leak test (Phase 1+2 + canary, GW untouched); the
   ## fail-closed/killswitch behavior is covered by the netns fail_closed_test. Enable this
   ## phase only in a DEDICATED leak-test lane where mutating the GW is acceptable.
   if [ "${DM_WHONIX_PAIR_KILLSWITCH:-0}" = '1' ]; then
      ## gw_stop_tor POSITIVELY confirms tor@default is inactive on the GW -- the fail-closed
      ## proof Tor is down, independent of any WS probe exit code. Then re-emit the craft
      ## matrix: with Tor down the firewall must DROP, so the final canary must still show
      ## zero target hits across the WHOLE capture (both Tor-up and Tor-down windows).
      printf '%s\n' "${me}: killswitch -- stop + confirm Tor down on the Gateway, then re-emit"
      gw_stop_tor
      ## Same battery-exit contract as Phase 2: 1 = a probe proved non-Tor egress (LEAK),
      ## any other non-zero = the emit could not run (inconclusive/infra). Classify identically
      ## so a proven leak with Tor down is never downgraded to SETUP.
      local ks_rc=0
      ws_battery "--probe gateway-craft ${craft_flags}" || ks_rc=$?
      if [ "${ks_rc}" = '1' ]; then
         die "${FAIL_RC}" "killswitch LEAK: a crafted probe proved non-Tor egress with Tor down"
      elif [ "${ks_rc}" != '0' ]; then
         die "${SETUP_RC}" "killswitch: craft emit could not run with Tor down (battery rc=${ks_rc}) -- an infra failure, not a WS leak"
      fi

      ## RECOVERY. Restart Tor and prove egress is restored -- so the killswitch STOP was a
      ## bracketed, reversible operation (the GW is not wedged) and a dead Tor can never
      ## silently carry into anything added after this phase.
      printf '%s\n' "${me}: killswitch recovery -- restart Tor, confirm egress restored"
      gw_start_tor
      local attempt2 restored='false'
      for attempt2 in $(seq 1 15); do
         assert_vm_running "${gw}" 'killswitch recovery'
         if ws_tor_confirm; then
            restored='true'
            break
         fi
         printf '%s\n' "${me}: Tor egress not back yet (attempt ${attempt2}); retrying"
         sleep 20
      done
      [ "${restored}" = 'true' ] \
         || die "${SETUP_RC}" "killswitch recovery: Tor egress NOT restored after restart (stop not cleanly reversible) -- an infra failure, not a WS leak"
   fi

   ## Positive control: emit one deterministic known-good packet to a pinned guard (best-effort),
   ## so the canary's guard-packet floor has a controlled contributor, not only Tor's traffic.
   gw_positive_control
   ## Settle BEFORE powering off: a probe's packet may be in flight (WS -> GW -> wire) when the
   ## battery returns; let it egress + land in the trace first, so a late leak is not raced out of
   ## the capture window.
   sleep 5
   ## Canary: stop the GW so its nictrace pcap is flushed, then assert NO probe target
   ## reached clearnet through it -- across every capture window.
   "${VBOXMANAGE}" controlvm "${gw}" poweroff >/dev/null 2>&1 || true
   sleep 3
   canary_gateway_pcap

   printf '%s\n' "${me}: PASS -- Workstation egresses ONLY via the Gateway's Tor (full battery + GW-trace canary)"
   return "${PASS_RC}"
}

## Sourced (dm-whonix-pair-tests) -> expose the functions without running; executed -> run.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
   main "$@"
fi
