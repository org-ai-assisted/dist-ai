#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Boot an imported Whonix Gateway + Workstation pair headless on their VirtualBox
## internal network and assert the Workstation egresses to the internet ONLY via the
## Gateway's Tor (the core Whonix guarantee), then tear down.
##
## WS has a single internal-net NIC (no direct route), so its only path out is
## WS -> GW -> Tor by construction. The leak test PROVES that path is live and really
## Tor by running the authoritative anon-leak-test BATTERY inside the WS -- the full
## probe set (enumerate / icmp / udp-123 / ipv6 / tor-confirm / gateway-craft), fail-
## closed, with the AppArmor-confined systemcheck (both SocksPort + TransPort) as the
## live positive control -- NOT a single IsTor grep.
##
## Shipped Whonix images carry VBoxService, so the battery is RUN via guestcontrol
## (vbox-exec-local), NOT OCR. It is DELIVERED via a VBox shared folder (name 'shared',
## pre-attached before boot -> the guest's mnt-shared-vbox.service auto-mounts it at
## /mnt/shared as root, exec bit preserved). The share is the clean channel: guestcontrol
## copyto drops modes + is finicky, and guestcontrol has no host->guest stdin. The battery
## needs root (icmp + gateway-craft), so the WS boots SYSMAINT (user session blocks sudo);
## the GW routes in its default user session.
##
## CANARY (no silent green): the WS gateway-craft probe EMITS deliberate direct-egress
## packets at tagged clearnet IPs while the GW's external NIC is traced to a host pcap
## (VBoxManage --nictrace -- a diagnostic tap, no network/routing change, and the only
## host observation the non-root VM-owner can make). The tagged destinations MUST NOT
## appear leaving the GW (Tor carries no such destination), while the pcap being
## non-empty + tor-confirm passing prove the observation is not blind.
##
## Runs AS the VM-owner fleet user (per-$HOME VBox state); never needs host root.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"
VBOXMANAGE="${VBOXMANAGE:-VBoxManage}"
GUESTCTL="${GUESTCTL:-vbox-ctl-local}"
TESSERACT="${TESSERACT:-tesseract}"
VBOX_EXEC_LOCAL="${VBOX_EXEC_LOCAL:-vbox-exec-local}"
## Delivers the fast LOCAL apt repo over the 'shared' vboxsf (functional CLI/inst lane only).
## Overridable so a test asserts the delegated attach with a stub.
DM_SHARED_APT_REPO="${DM_SHARED_APT_REPO:-dm-shared-apt-repo}"
TCPDUMP="${TCPDUMP:-tcpdump}"
## Splits the anon-leak-test battery JSON into per-probe story cards. Checkout sibling by
## default (bin is <root>/usr/bin, helper is <root>/usr/libexec/dm-whonix-pair); overridable so
## a test drives the in-tree helper with nothing written to /usr. BASH_SOURCE, not $0: the suite
## sources this file define-only, where $0 is the test's path.
BATTERY_STORY_CARDS="${BATTERY_STORY_CARDS:-$(
   dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")"
)/../libexec/dm-whonix-pair/battery-story-cards}"
[ -x "${BATTERY_STORY_CARDS}" ] \
   || BATTERY_STORY_CARDS='/usr/libexec/dm-whonix-pair/battery-story-cards'
## Single source of the leak-battery verdict classification (clear/leak/inconclusive), shared by
## probe_verdict and battery-story-cards so the story can never disagree with the classified run.
## Same checkout-sibling resolution + override as BATTERY_STORY_CARDS.
LEAK_EXIT_CLASSIFY="${LEAK_EXIT_CLASSIFY:-$(
   dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")"
)/../libexec/dm-whonix-pair/leak-exit-classify}"
[ -x "${LEAK_EXIT_CLASSIFY}" ] \
   || LEAK_EXIT_CLASSIFY='/usr/libexec/dm-whonix-pair/leak-exit-classify'
export LEAK_EXIT_CLASSIFY
## Where a leak's GW-NIC capture is preserved for forensics (see on_exit).
LEAK_ARTIFACT_DIR="${LEAK_ARTIFACT_DIR:-${HOME:-${TMP:-}}}"

PASS_RC=0
FAIL_RC=5
SETUP_RC=2

gw='Whonix-Gateway-LXQt'
ws='Whonix-Workstation-LXQt'
## committed clean-desktop snapshot each VM is restored to before a run.
SNAPSHOT="${SNAPSHOT:-clean-live}"
## Whonix is bios-only (an imported OVA's firmware cannot be cleanly re-applied), so a RESTORED
## snapshot must present BIOS firmware. A VBox snapshot captures the firmware TYPE, so a restore
## REVERTS it -- restore_fresh verifies the restored firmware here, catching a stale EFI-baked
## snapshot that would otherwise run under a mislabeled -bios result. Overridable for a future lane.
EXPECT_FIRMWARE="${EXPECT_FIRMWARE:-BIOS}"
## Run mode: leak (the anon-leak-test battery, default) | functional (the numbered
## release-check battery on the WS, parallel to the kicksecure install gate). Set by --mode.
mode='leak'
## functional mode edition: gui (default; the OCR real-session battery) | cli (a CLI edition
## has no desktop, so the battery runs headless over guestcontrol). Set by --interface. Only
## functional mode branches on it; leak mode ignores it.
interface='gui'
## functional mode: host file capturing a FAILED release check's in-guest output (consumed
## by ocr-session.bsh's run_check_report_failure). Empty in leak mode.
check_log=""
## Account-owned milestone "story" dir (--shot-dir): the leak run drops an ordered visual +
## textual record here (NN-<name>.png guest-framebuffer shots, NN-<name>.card.txt text cards),
## which image_test_results_publish renders as the lane's "full story" -- the same mechanism the
## Calamares install lane uses. Empty => every story_snap/story_card call is a no-op, so a run
## without --shot-dir is byte-unchanged.
shot_dir=""
## functional CLI/inst lane only (--local-repo kicksecure|whonix): deliver the fast LOCAL apt repo
## over the 'shared' vboxsf and enable it in the WS, so check 3 (upgrade-nonroot) upgrades the
## derivative packages from it, AND the Debian base from the local mirror exposed under the share
## (check 3 reads the dedicated local sources only -- fully offline, no Tor). Empty => disabled (byte-unchanged;
## the lane upgrades from the published repos). Rejected in main outside --mode functional
## --interface cli: repo-add-local needs root, which only the split-free CLI edition's `user` has.
local_repo=""
## The local apt repo's SHARE HOST PATH (dm-shared-apt-repo's repo_parent), resolved by the
## orchestrator (dm-release-test, as root where dist_build_slot is known) and passed via
## --local-repo-base. The attach below runs as the test ACCOUNT, whose env lacks dist_build_slot,
## so a re-derivation there would map a DIFFERENT (slot-less) repo than the root-side provenance
## records -- a false signal. Empty => dm-shared-apt-repo derives it from the env (non-slotted case).
local_repo_base=""
## Active CLI-check capture temp (set by ws_func_cli_exec); on_exit removes it so a signal or
## lock-timeout mid-check cannot leave the host mktemp file behind across repeated interruptions.
cli_capture_tmp=""
## Captured anon-leak-test battery JSON (set by ws_battery), carded by main as the battery stage.
battery_json_last=""
## anon-leak-test checkout ON THIS HOST, pushed into the WS (the single authoritative
## battery -- no re-embedded copy). Provisioned location; overridable.
ANON_LEAK_TEST_REPO="${ANON_LEAK_TEST_REPO:-/var/lib/image-tests/anon-leak-test}"
## The battery needs root (icmp + gateway-craft). Kicksecure accounts ship with an EMPTY password
## (NOT NOPASSWD), so a bare `sudo -n`/`--non-interactive` is REFUSED -- the empty password still
## has to be SUBMITTED, and guestcontrol has no tty. Use `dsudo` (dist-base-files): its SUDO_ASKPASS
## submits the empty password headlessly (the no-tty equivalent of pressing Enter at the prompt). A
## genuinely password-protected account makes dsudo FAIL (non-zero) -- fail-closed, never a vacuous
## pass. ws_assert_root confirms root up front so a mis-set account fails EARLY and clearly.
## Where the guest auto-mounts the 'shared' folder that carries the battery (fixed by the
## guest's mnt-shared-vbox.service). The host staging dir is made in main.
GUEST_SHARE_MOUNT='/mnt/shared'

## Dedicated apt sources dir in the WS for the --local-repo lane: holds the derivative 'local' repo
## + the Debian base mirror sources, GENERATED HOST-SIDE (the released image's repo-add-local lacks
## the base block). check 3 -- and the enable/verify apt ops -- read ONLY this dir
## (Dir::Etc::sourceparts + sourcelist=/dev/null), so the full upgrade resolves entirely from the
## local file: sources (offline, no Tor) with NO apt pin and WITHOUT touching the guest's own apt
## config (so the other checks are unaffected).
LOCAL_TEST_SOURCES_DIR='/etc/apt/sources.list.d.localtest'
## APT::Sandbox::User=root: the local sources are a vboxsf mount the unprivileged _apt sandbox user
## cannot read (vboxsf perms come from the mount umask 0007, not the inode), so a sandboxed fetch
## hits 'Permission denied' on the compressed index -- and the mirror keeps NO uncompressed Packages
## / by-hash to fall back to, so apt fails outright. Reading as root (which CAN read the mount)
## resolves it; safe here -- a disposable test VM pulling a local, signed/trusted file: tree.
LOCAL_TEST_APT_OPTS="-o Dir::Etc::sourceparts=${LOCAL_TEST_SOURCES_DIR} -o Dir::Etc::sourcelist=/dev/null -o APT::Sandbox::User=root"
## The mirror (private-ai-config debian-mirror-sync) is binary-only amd64; the base sources emit
## 'Architectures: amd64' so a multi-arch guest never asks for an absent foreign-arch index.
LOCAL_MIRROR_ARCH='amd64'
share_dir=''
## World-readable guest-local stage for the browser probe. /mnt/shared is a root-only, read-only
## vboxsf mount, so the NON-root browser probe (Tor Browser refuses root) cannot read its CLI +
## harness off it -- copy them here as root first, then run the probe from here (tmpfs; a
## snapshot restore reverts it anyway).
GUEST_PROBE_LOCAL='/run/anon-leak-probe'

## Clearnet targets the battery aims its direct-egress probes at (anon-leak-test's fixed
## defaults, so the GW-pcap watch list is exactly these). On a CORRECT Whonix the GW drops/
## torifies everything, so nothing reaches them; only a LEAK would send a handful of packets
## to these PUBLIC services (1.1.1.1 welcomes connectivity tests; Cloudflare NTP is public).
CLEARNET_ICMP='1.1.1.1'
CLEARNET_NTP='162.159.200.123'
## gateway-craft's forged SOURCE is RFC 5737 TEST-NET-2 (reserved; routes nowhere).
CRAFT_SRC='198.51.100.99'
## IPv6 emit targets (only reached if the GW uplink carries global IPv6): a public v6
## target and the RFC 3849 doc-range forged v6 source. Defined here so the aim and the
## canary watch list are ONE source. Passed to the battery as --clearnet-ipv6/--craft-src6.
CLEARNET_IPV6='2606:4700:4700::1111'
CRAFT_SRC6='2001:db8:beef::99'
## The GW's own address on its external (VBox NAT) NIC -- VBox NAT deterministically assigns
## 10.0.2.15 to a guest's first adapter. It is the DESTINATION of every INBOUND reply on the
## nictrace, so it must be excluded from the allowlist's leak-dst set (an inbound packet's dst is
## the GW itself, never an egress leak); a real GW-originated leak keeps its clearnet dst.
GW_NAT_IP4='10.0.2.15'

## Pinned Tor entry guards: a small fixed set of high-uptime / high-capacity relays. gw_pin_guards
## forces the GW onto ONLY these (EntryNodes + StrictNodes 1), so the GW's ONLY Tor egress is these
## IPs. Expect Tor-only by DEFAULT: ANY other clearnet dst -- incl. a NON_TOR_GATEWAY host-DNS/LAN
## exception -- is a LEAK, never allowlisted. Refresh from the live consensus if a relay churns;
## fail-closed -- a pin Tor cannot bootstrap on never passes (SETUP).
## Source: onionoo top-consensus-weight Guard relays, 2026-10-04 (nickname / fingerprint / addr:ORPort):
##   magic848relay 616C915B1EA788FA1177EF6194608C0E13B28A96  148.251.33.107:9001
##   0x90          D95A2DF17815BA92E4EA49D2D46EBAEB1DCEBABC  88.99.7.87:9001
##   doraemon      4DD822C2CF4542CDF2EDA22480C4EB0331E7B6DB  185.107.57.64:443
##   setsun        FB54F9C8AE5A3A89FDAFF834DFA9637F22D70C38  94.130.133.51:9001
## v4-only: the VBox NAT uplink is v4, so EntryNodes pins v4 (none of these four publish a v6 ORPort).
GUARD_PIN_IPS4=( '148.251.33.107' '88.99.7.87' '185.107.57.64' '94.130.133.51' )
GUARD_PIN_IPS6=()
## Reserved positive-control guard: allowlisted like the entry guards but DELIBERATELY EXCLUDED from
## EntryNodes, so Tor never connects to it and EVERY packet to this IP is the deterministic canary
## emit -- cleanly separable from genuine Tor guard traffic by HOST (no port heuristics). The emit
## is a legitimate TCP connection to this PUBLIC relay's real ORPort (published in the consensus for
## any client to connect to -- authorized by design, not an unsolicited scan), so it raises no abuse
## complaint. gw_positive_control dials GUARD_PC_IP4:GUARD_PC_PORT as the clearnet user.
##   F3Netze 9454F82D47EBA0CB0C2A4BFE7966181DBF108147  185.220.100.242:9100, [2a0b:f4c0:16c:14::1]:9100
GUARD_PC_IP4='185.220.100.242'
GUARD_PC_IP6='2a0b:f4c0:16c:14::1'
GUARD_PC_PORT='9100'
## Whonix %includes /usr/local/etc/torrc.d/*.conf; a drop-in there is picked up at Tor start.
GW_TORRC_PIN='/usr/local/etc/torrc.d/50_dm-whonix-pair-pin.conf'
## Liveness floor: the trace must contain at least this many GENUINE Tor guard packets (the entry
## guards on their ORPorts), counted SEPARATELY from the reserved-guard positive-control emit so the
## artificial canary packet never inflates it. A real Tor guard TLS+circuit over a run is hundreds;
## a tiny count means an UNDERCOUNTING (dropping) tap or Tor never reached a guard, not a trustworthy
## clean. A floor, not an exact expectation.
GUARD_MIN_PKTS='10'

gw_started='false'
ws_started='false'
nictrace_pcap=''
## The GW's consensus relay set, captured WHILE the GW is up (the canary runs after the GW
## poweroff that flushes the nictrace pcap, when guestcontrol can no longer reach the GW).
gw_relay_cache=''

die() {
   printf '%s\n' "${me}: ERROR: ${2}" >&2
   ## Publish WHY the run failed as the final story card, so a FAIL/INCONCLUSIVE run still
   ## carries a readable verdict in the results plane (mirrors the install lane's failure card).
   ## No-op without --shot-dir. story_card is defined below; die is only ever CALLED at runtime
   ## (after the whole file is parsed), so forward-reference is fine.
   story_card 98 failure "Run failed (rc=${1})" "${2}"
   exit "$1"
}

## --- leak-lane screenshot "story" --------------------------------------------------------------
## Mirror of dm-calamares-install's story: an ordered record of the leak run, published from the
## account-owned ${shot_dir}. Two kinds, exactly as the install lane: PNG screenshots for the
## visually-meaningful, known-up frames (GW/WS desktop), and TEXT state cards for points with no
## distinct screen -- the leak battery runs NON-interactively over guestcontrol, so each probe's
## evidence is its anon-leak-test JSON verdict, not a photo (the install lane made the same call:
## state cards are text, not images). ALL calls are BEST-EFFORT: a grab/write failure NEVER changes
## the leak verdict -- the authoritative oracle is the battery exit + the GW-NIC canary, never a
## frame. Empty shot_dir => no-op (a --shot-dir-less run is unchanged).

## Guest-framebuffer screenshot into ${shot_dir}/NN-<name>.png via vbox-ctl-local (vboxapi, no
## Guest Additions -- the SAME grab gui_ocr uses). $3 picks the VM (default: the current ${vm});
## the leak flow interleaves GW and WS, so callers name it explicitly.
story_snap() {
   local nn="$1" name="$2" snap_vm="${3:-${vm}}"
   [ -n "${shot_dir}" ] || return 0
   "${GUESTCTL}" "${snap_vm}" shot "${shot_dir}/${nn}-${name}.png" >/dev/null 2>&1 || true
}

## Text "state card" (NN-<name>.card.txt) for a point with no framebuffer worth a photo. $3=title,
## $4=body (newlines preserved). The publisher renders it as a labelled text panel -- no PNG, no
## OCR round-trip, no golden; the text is authoritative.
story_card() {
   local nn="$1" name="$2" title="$3" body="$4" card
   [ -n "${shot_dir}" ] || return 0
   card="${shot_dir}/${nn}-${name}.card.txt"
   printf '%s\n' "[state card -- rendered text, not a screenshot]" "${title}" "" "${body}" \
      > "${card}" 2>/dev/null || true
}

## Comprehensive leak-battery story: ONE card per anon-leak-test probe (enumerate / icmp /
## udp / tor-confirm / gateway-craft / ...) plus a leading verdict summary, so the published
## story lets a reader verify EACH check and its result -- not one collapsed JSON dump. Parse
## is delegated to battery-story-cards (robust JSON extraction + line-framed base64 records);
## story_card stays the single card writer. $1=base NN, $2=summary card name, $3=battery JSON.
## Best-effort: empty shot_dir => no-op; a parse failure NEVER loses the evidence -- it falls
## back to the single raw-JSON card. Carded identically on PASS and on FAIL/INCONCLUSIVE.
story_battery_cards() {
   local base="$1" summary_name="$2" json="$3" records nn name b64title b64body
   [ -n "${shot_dir}" ] || return 0
   records="$(printf '%s' "${json}" | "${BATTERY_STORY_CARDS}" "${base}" "${summary_name}")" \
      || records=''
   if [ -z "${records}" ]; then
      story_card "${base}" "${summary_name}" \
         "anon-leak-test battery output (raw JSON -- per-probe split unavailable)" "${json}"
      return 0
   fi
   while read -r nn name b64title b64body; do
      story_card "${nn}" "${name}" \
         "$(printf '%s' "${b64title}" | base64 --decode)" \
         "$(printf '%s' "${b64body}" | base64 --decode)"
   done <<< "${records}"
}

## Per-check story card callback for run_release_check_battery (story_fn RESULT NUM): ONE card
## per numbered release check, emitted from the SHARED battery loop so the gui and cli functional
## editions record an identical per-check story (unify cli vs gui). RESULT = routed|pass|fail. NN
## runs from a counter so the cards sort in execution order under the publisher's NN-prefix sort.
## Best-effort via story_card (no-op without --shot-dir); never changes a check verdict.
STORY_CHECK_NN=60
wp_story_check() {
   local result="$1" num="$2" nn desc body safe_name
   STORY_CHECK_NN=$(( STORY_CHECK_NN + 1 ))
   nn="${STORY_CHECK_NN}"
   desc="${RELEASE_CHECK_DESC[${num}]:-check ${num}}"
   case "${result}" in
      routed)
         body="ROUTED -- not run over this gate's transport: ${RELEASE_CHECK_SKIP_REASON[${num}]:-(routed elsewhere)}"
         ;;
      pass)
         body="PASS -- in-guest command: ${RELEASE_CHECK_CMD[${num}]:-}"
         ;;
      fail)
         body="FAILED -- see the verdict/failure card for the reason"
         ;;
      *)
         body="${result}"
         ;;
   esac
   safe_name="$(printf '%s' "${desc}" | tr ' ' '-')"
   story_card "${nn}" "check${num}-${safe_name}" "Release check ${num}: ${desc} (${result})" "${body}"
}

## Pre-boot story card (NN 10): the exact pair under test as VBoxManage facts (not a photo).
## Shared by every mode (leak + functional gui/cli) so the story opens identically.
story_pair_defined() {
   story_card 10 pair-defined "Whonix pair under test (pre-boot)" "$(
      printf '%s\n' "Gateway VM: ${gw}"
      "${VBOXMANAGE}" showvminfo "${gw}" --machinereadable 2>/dev/null \
         | grep -iE '^(VMState|firmware|memory|vram|nic1|"SATA|"IDE)=' | head -10
      printf '%s\n' "" "Workstation VM: ${ws}"
      "${VBOXMANAGE}" showvminfo "${ws}" --machinereadable 2>/dev/null \
         | grep -iE '^(VMState|firmware|memory|vram|nic1|"SATA|"IDE)=' | head -10
   )"
}

## Current VBox run-state of a VM ('running', 'poweroff', 'aborted', ...); empty if
## showvminfo failed. Single source for the VMState parse used across the harness.
vm_state() {
   "${VBOXMANAGE}" showvminfo "$1" --machinereadable 2>/dev/null \
      | sed -n 's/^VMState="\(.*\)"$/\1/p' || true
}

## Bounded fail-closed wait for a CONFIRMED off-state before the next modifyvm/startvm. An
## empty vm_state is transient showvminfo lock-contention (NOT off) -> keep polling; return
## nonzero if it never settles (the caller dies with a context-specific message/RC).
## $1=vm $2=iterations (default 20, 2s each).
wait_vm_off() {
   local vm="$1" iterations="${2:-20}" _i
   for _i in $(seq 1 "${iterations}"); do
      case "$(vm_state "${vm}")" in
         poweroff|aborted)
            return 0
            ;;
      esac
      sleep 2
   done
   return 1
}

## Fast-fail guard: a VM that is no longer running (crashed/aborted/powered off) will
## never make progress, so detect it in ONE check instead of waiting out a whole retry
## budget. Call in any wait loop that depends on the VM being up.
assert_vm_running() {
   local vm="$1" label="$2" state
   state="$(vm_state "${vm}")"
   case "${state}" in
      running|paused)
         return 0
         ;;
      *)
         die "${SETUP_RC}" "${label}: VM '${vm}' is not running (state=${state:-unknown}) -- boot crashed/aborted; a provisioning/infra failure, not a WS leak"
         ;;
   esac
}

## Resolve from BASH_SOURCE[0], not $0: this script is source-able (guard at EOF) and
## the canary test sources it, where $0 is the TEST's path -> the wrong lib_base.
lib_base="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")/../share/dm-smbios-reader-boot-tests"
[ -d "${lib_base}" ] || lib_base='/usr/share/dm-smbios-reader-boot-tests'
# shellcheck source=./usr/share/dm-smbios-reader-boot-tests/gui-drive.bsh
source "${lib_base}/gui-drive.bsh"
# shellcheck source=./usr/share/dm-smbios-reader-boot-tests/grub-boot-select.bsh
source "${lib_base}/grub-boot-select.bsh"
# shellcheck source=./usr/share/dm-smbios-reader-boot-tests/vbox-session.bsh
source "${lib_base}/vbox-session.bsh"
## functional mode: the shared numbered release-check battery + its OCR real-session
## executor (so a full `systemcheck --cli --ci` runs with a logind user session). Sourced
## after gui-drive.bsh + vbox-session.bsh (ocr-session.bsh uses gui_* + gc_run +
## RELEASE_CHECK_*). Leak mode does not use them, but sourcing is define-only + cheap.
# shellcheck source=./usr/share/dm-smbios-reader-boot-tests/release-checks.bsh
source "${lib_base}/release-checks.bsh"
# shellcheck source=./usr/share/dm-smbios-reader-boot-tests/ocr-session.bsh
source "${lib_base}/ocr-session.bsh"
## helper-scripts: the single generator of the local apt sources deb822 stanzas (derivative 'local'
## repo + Debian base mirror). Sourced host-side ONLY for the --local-repo lane; define-only. Made
## non-fatal so a missing/old lib fails ONLY that lane (enable guards on the functions), never the
## leak or non-local-repo lanes that do not use it.
# shellcheck disable=SC1090,SC1091
source "${HELPER_SCRIPTS_PATH:-}/usr/libexec/helper-scripts/local-apt-repo-sources.bsh" 2>/dev/null || true

usage() {
   printf '%s\n' "usage: ${me} [--gw NAME] [--ws NAME] [--mode leak|functional] [--interface gui|cli] [--local-repo kicksecure|whonix]

--gw   Whonix Gateway VM name (default: ${gw})
--ws   Whonix Workstation VM name (default: ${ws})
--mode leak (default): boot both, run the anon-leak-test battery in the Workstation
       (sysmaint), assert it egresses ONLY through the Gateway's Tor.
       functional: boot both, gate on Tor bootstrap, then run the numbered release-check
       battery (release-checks.bsh, >= the kicksecure install coverage incl. the full
       systemcheck) in the Workstation via an OCR real-session executor.
--interface (functional mode) gui (default): the OCR real-session battery (needs a desktop).
       cli: a CLI edition has no desktop, so run the battery headless over guestcontrol. The
       GUI-login check (needs a compositor) is genuinely N/A and routed-skipped with a loud
       reason. systemcheck (check 8) needs a logind user session guestcontrol cannot provide, so
       it is run SEPARATELY via a real console login and IS REQUIRED for a pass -- not skipped.
--local-repo (--mode functional --interface cli ONLY) kicksecure|whonix: attach + enable the fast
       LOCAL apt repo (delivered over the 'shared' vboxsf, codename 'local') in the Workstation so
       check 3 (upgrade-nonroot) upgrades the derivative packages AND the Debian base from local
       file: sources only (the mirror exposed under the share) -- fully offline, no Tor.
       Rejected in any other mode/interface (the apt ops need root, which only the split-free
       CLI edition's user has). Populate the repo first: derivative-maker --skip-published-packages.

Exit 0 = PASS."
}

parse_args() {
   while [ "$#" -gt 0 ]; do
      case "$1" in
         --gw)
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "--gw needs a value"
            gw="$2"
            shift 2
            ;;
         --ws)
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "--ws needs a value"
            ws="$2"
            shift 2
            ;;
         --mode)
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "--mode needs a value"
            case "$2" in
               leak|functional)
                  mode="$2"
                  ;;
               *)
                  die "${SETUP_RC}" "--mode must be leak|functional, got '$2'"
                  ;;
            esac
            shift 2
            ;;
         --interface)
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "--interface needs a value"
            case "$2" in
               gui|cli)
                  interface="$2"
                  ;;
               *)
                  die "${SETUP_RC}" "--interface must be gui|cli, got '$2'"
                  ;;
            esac
            shift 2
            ;;
         --check-log)
            ## functional mode: a CALLER-owned file for a failed release check's in-guest
            ## output (the caller creates, reads + reclaims it; ocr-session writes it).
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "--check-log needs a value"
            check_log="$2"
            shift 2
            ;;
         --shot-dir)
            ## CALLER-owned dir for the leak run's milestone story (NN-<name>.png / .card.txt).
            ## The caller creates, publishes + reclaims it; empty/unset => no story captured.
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "--shot-dir needs a value"
            shot_dir="$2"
            shift 2
            ;;
         --local-repo)
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "--local-repo needs a value"
            case "$2" in
               kicksecure|whonix)
                  local_repo="$2"
                  ;;
               *)
                  die "${SETUP_RC}" "--local-repo must be kicksecure|whonix, got '$2'"
                  ;;
            esac
            shift 2
            ;;
         --local-repo-base)
            ## The resolved SHARE HOST PATH for --local-repo, passed by dm-release-test (root). Pins
            ## the attach's --hostpath so the account-run attach does not re-derive a slot-less path.
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "--local-repo-base needs a value"
            local_repo_base="$2"
            shift 2
            ;;
         --print-guards)
            ## Single source of the ENTRY guard IPs (the genuine-Tor-guard set), consumed by the
            ## host-wire oracle (host-wire-leak-capture) to count Tor egress -- so the two never
            ## drift. One IP per line. The reserved positive-control guard is NOT here (it is its
            ## own count, via --print-pc-filter); the full allowlist is via --print-allow-filter.
            printf '%s\n' "${GUARD_PIN_IPS4[@]}" "${GUARD_PIN_IPS6[@]}"
            exit 0
            ;;
         --print-allow-filter)
            ## Emit the exact deny-by-default allowlist BPF so the host-wire oracle applies the
            ## SAME semantics as the in-VM canary (single source; never a re-derived copy).
            [ "${#GUARD_PIN_IPS4[@]}" -gt 0 ] \
               || die "${SETUP_RC}" "no pinned guards configured -- cannot emit the allowlist filter"
            printf '%s\n' "$(allowlist_bpf)"
            exit 0
            ;;
         --print-pc-filter)
            ## Emit the reserved-guard positive-control discriminator BPF so the host-wire oracle
            ## counts the deliberate canary packet SEPARATELY from genuine Tor guard traffic, with
            ## the SAME definition as the in-VM canary (single source).
            printf '%s\n' "$(pc_bpf)"
            exit 0
            ;;
         -h|--help)
            usage
            exit 0
            ;;
         *)
            usage >&2
            die "${SETUP_RC}" "unknown argument: $1"
            ;;
      esac
   done
}

on_exit() {
   local rc=$?
   if [ "${ws_started}" = 'true' ]; then
      "${VBOXMANAGE}" controlvm "${ws}" poweroff >/dev/null 2>&1 || true
   fi
   if [ "${gw_started}" = 'true' ]; then
      "${VBOXMANAGE}" controlvm "${gw}" poweroff >/dev/null 2>&1 || true
      ## Poweroff is async and the nictrace pcap is not flushed until the GW settles;
      ## wait (bounded) so a preserved capture is complete, not truncated mid-write.
      local _i
      for _i in $(seq 1 15); do
         case "$(vm_state "${gw}")" in poweroff|aborted|'') break ;; esac
         sleep 1
      done
   fi
   ## Story: final teardown milestone -- the pair reached poweroff. Only when a VM was actually
   ## started (a pre-boot SETUP abort has nothing to show). Best-effort; no-op without --shot-dir.
   if [ "${ws_started}" = 'true' ] || [ "${gw_started}" = 'true' ]; then
      story_card 96 pair-poweroff "Pair powered off (teardown)" "$(
         printf '%s\n' "Gateway ${gw}: $(vm_state "${gw}")" "Workstation ${ws}: $(vm_state "${ws}")"
      )"
   fi
   ## Drop the consensus-relay cache (transient classifier input; the pcap is the evidence).
   if [ -n "${gw_relay_cache}" ]; then
      safe-rm --force -- "${gw_relay_cache}" 2>/dev/null || true
   fi
   ## Remove a CLI-check capture still in flight (ws_func_cli_exec interrupted by a signal / lock
   ## timeout before its own cleanup) so repeated interruptions cannot accumulate host temp files.
   if [ -n "${cli_capture_tmp}" ]; then
      safe-rm --force -- "${cli_capture_tmp}" 2>/dev/null || true
   fi
   ## Leave the NIC trace off so a later run / other use is not silently captured.
   "${VBOXMANAGE}" modifyvm "${gw}" --nictrace1 off >/dev/null 2>&1 || true
   ## The GW-NIC pcap is the leak oracle's evidence. On a clean PASS it is noise -> drop it.
   ## On ANY non-clean exit (a leak, or an inconclusive abort) PRESERVE it plus a tcpdump
   ## decode as a durable artifact: deleting the one capture that matters would make a real
   ## leak unauditable. If the copy FAILS, keep the original in place (never delete the only
   ## evidence on a failure path) and warn.
   if [ -n "${nictrace_pcap}" ] && [ -e "${nictrace_pcap}" ]; then
      if [ "${rc}" -ne "${PASS_RC}" ]; then
         mkdir -p -- "${LEAK_ARTIFACT_DIR}" 2>/dev/null || true
         local keep
         keep="${LEAK_ARTIFACT_DIR}/whonix-pair-leak-$(date +%Y%m%d-%H%M%S)-$$.pcap"
         if cp -- "${nictrace_pcap}" "${keep}" 2>/dev/null; then
            "${TCPDUMP}" -nr "${keep}" >"${keep%.pcap}.txt" 2>/dev/null || true
            printf '%s\n' "${me}: non-clean exit (rc=${rc}); GW capture PRESERVED: ${keep} (decode: ${keep%.pcap}.txt)" >&2
            safe-rm -f -- "${nictrace_pcap}" 2>/dev/null || true
         else
            printf '%s\n' "${me}: WARNING: could not preserve GW capture to ${LEAK_ARTIFACT_DIR}; leaving the only copy at ${nictrace_pcap}" >&2
         fi
      else
         safe-rm -f -- "${nictrace_pcap}" 2>/dev/null || true
      fi
   fi
   ## Drop the battery share (reverted by the next snapshot restore anyway) + its host dir.
   "${VBOXMANAGE}" sharedfolder remove "${ws}" --name shared >/dev/null 2>&1 || true
   if [ -n "${share_dir}" ]; then
      safe-rm --recursive --force -- "${share_dir}" 2>/dev/null || true
   fi
}

## Power off, restore the clean snapshot, then discardstate so the next start is a FRESH
## boot (reaches GRUB) rather than a live-snapshot RESUME -- required to pick a boot role
## and to (re)apply a NIC trace the snapshot would otherwise revert.
restore_fresh() {
   local target="$1"
   "${VBOXMANAGE}" controlvm "${target}" poweroff >/dev/null 2>&1 || true
   for _ in $(seq 1 20); do
      case "$(vm_state "${target}")" in poweroff|aborted|'') break ;; esac
      sleep 2
   done
   "${VBOXMANAGE}" snapshot "${target}" restore "${SNAPSHOT}" >/dev/null 2>&1 \
      || die "${SETUP_RC}" "${target}: cannot restore snapshot '${SNAPSHOT}' -- a provisioning failure, not a WS leak"
   "${VBOXMANAGE}" discardstate "${target}" >/dev/null 2>&1 || true
   ## Verify the RESTORED firmware (the authoritative run-time state, AFTER the restore reverted it)
   ## -- a stale pair snapshotted as EFI would otherwise run as EFI under a -bios cell. A mismatch is
   ## a provisioning/snapshot-staleness bug (firmware must be applied BEFORE the clean-live snapshot)
   ## -> INCONCLUSIVE (SETUP_RC), never a mislabeled firmware result.
   ## A showvminfo FAILURE here yields an EMPTY fw_actual (a command-sub assignment does not trip
   ## errexit; the pipeline's tail sed exits 0): the equality check below then fails (EXPECT_FIRMWARE
   ## is never empty -- ':-BIOS') and dies SETUP_RC. So a read failure is already INCONCLUSIVE, never
   ## a mislabeled leak FAIL. Do NOT "fix" this with a '|| die' guard -- it is redundant.
   local fw_actual
   fw_actual="$("${VBOXMANAGE}" showvminfo "${target}" --machinereadable 2>/dev/null | sed -n 's/^firmware="\(.*\)"$/\1/p')"
   [ "${fw_actual}" = "${EXPECT_FIRMWARE}" ] \
      || die "${SETUP_RC}" "${target}: restored snapshot firmware='${fw_actual}', expected '${EXPECT_FIRMWARE}' -- re-provision the pair (apply firmware before the clean-live snapshot); not running a mislabeled firmware lane"
}

## Boot the Gateway fresh in its default (user) role. TWO boots: the first UNtraced, only to PIN
## the entry guards; then -- after a CLEAN poweroff that flushes the torrc write -- re-boot with
## the EXTERNAL NIC traced to a host pcap (the canary observation point). Pinning BEFORE the trace
## means the capture holds ONLY pinned-guard traffic; the warmed snapshot's own persisted guards
## never pollute the allowlist. (The cost of pinning at runtime rather than in the snapshot.) The
## GW only routes; the sole in-guest command is the one-shot guard pin.
boot_gateway() {
   vm="${gw}"
   restore_fresh "${gw}"
   ## Boot 1 (UNtraced) exists ONLY to write the guard pin -- it must NOT egress. A warmed snapshot
   ## autostarts Tor onto its OWN persisted (non-pinned) guards the moment it boots; on the shared
   ## host wire (a continuous capture that brackets the whole run) that pre-pin traffic would read
   ## as non-pinned-guard clearnet and FALSE-FAIL. So DISCONNECT the external NIC for boot 1:
   ## guestcontrol rides the guest-additions channel (NIC-independent), so the pin still writes,
   ## while Tor has no uplink to reach any guard. Reconnected before the traced boot 2 below.
   "${VBOXMANAGE}" modifyvm "${gw}" --cableconnected1 off \
      || die "${SETUP_RC}" "${gw}: cannot disconnect the external NIC for the pin-only boot"
   "${VBOXMANAGE}" startvm "${gw}" --type headless >/dev/null
   gw_started='true'
   wait_guestcontrol_ready user 300 \
      || die "${SETUP_RC}" "${gw}: guestcontrol not ready as user to pin guards -- a provisioning failure, not a WS leak"
   ## Story: the Gateway desktop is up (guestcontrol confirmed) -- capture the "gateway booted to
   ## desktop" frame. Same desktop renders on the traced boot 2; the guard-pin boot is the first
   ## point the GW is reliably rendered, so grab it here.
   story_snap 20 gateway-desktop "${gw}"
   gw_pin_guards
   ## CLEAN poweroff (ACPI) so the torrc write is flushed; a hard poweroff could lose it. NOT
   ## restore_fresh -- that reverts the pin; a plain power-cycle keeps the on-disk drop-in.
   ## gw_pin_guards already `sync`ed the drop-in, so even clean_poweroff's hard fallback cannot
   ## truncate it. Then WAIT for the VM to actually reach poweroff: clean_poweroff's hard-fallback
   ## path returns without waiting, and the next modifyvm needs the VM fully stopped.
   ## Best-effort: a failed clean_poweroff must NOT abort this errexit function into a LEAK FAIL --
   ## wait_vm_off below is the authority and maps a stuck VM to SETUP (inconclusive), not a leak.
   clean_poweroff || true
   ## Confirm a settled off-state before re-tracing (the next modifyvm needs it fully stopped).
   wait_vm_off "${gw}" 20 \
      || die "${SETUP_RC}" "${gw}: did not reach poweroff before re-trace -- a provisioning failure, not a WS leak"
   ## Boot 2 (TRACED): RECONNECT the external NIC, enable the NIC trace offline (-u: just a name,
   ## VBox creates the pcap), then start. Tor autostarts and StrictNodes forces it onto the pinned
   ## guards only -- now the FIRST clearnet egress of the measured boot, so neither the guest trace
   ## nor the host wire sees any pre-pin guard.
   nictrace_pcap="$(mktemp -u -t "whonix-gw-trace.XXXXXX.pcap")"
   "${VBOXMANAGE}" modifyvm "${gw}" --cableconnected1 on --nictrace1 on --nictracefile1 "${nictrace_pcap}" \
      || die "${SETUP_RC}" "${gw}: cannot reconnect the external NIC / enable --nictrace1"
   "${VBOXMANAGE}" startvm "${gw}" --type headless >/dev/null
}

## Boot the Workstation fresh into SYSMAINT (root available for the full battery), then
## wait until guestcontrol answers as sysmaint.
boot_workstation_sysmaint() {
   vm="${ws}"
   restore_fresh "${ws}"
   ## Attach the battery share BEFORE boot (name 'shared', read-only) so the guest's
   ## mnt-shared-vbox.service auto-mounts it at /mnt/shared as root. Snapshot restore reverts
   ## it, so (re)attach every run.
   "${VBOXMANAGE}" sharedfolder add "${ws}" --name shared --hostpath "${share_dir}" --readonly \
      || die "${SETUP_RC}" "${ws}: cannot attach the battery shared folder"
   ## Select "PERSISTENT Mode | SYSMAINT Session" DETERMINISTICALLY offline (grubenv next_entry)
   ## BEFORE power-on -- no OCR, no ~5s live-menu race into USER. The Workstation OVA disk is an
   ## UNENCRYPTED .vmdk (no passphrase; format vmdk); restore_fresh left the VM powered off, so
   ## the current disk is unlocked for the offline mount.
   local ws_disk
   ws_disk="$(installed_disk_path "${ws}")" \
      || die "${SETUP_RC}" "${ws}: cannot resolve the system disk for offline SYSMAINT selection"
   select_installed_sysmaint_offline "${ws_disk}" "" vmdk
   "${VBOXMANAGE}" startvm "${ws}" --type headless >/dev/null
   ws_started='true'
   wait_guestcontrol_ready sysmaint 300 \
      || die "${SETUP_RC}" "${ws}: guestcontrol not ready as sysmaint -- a provisioning failure, not a WS leak"
   ## Story: the Workstation sysmaint desktop is up -- capture the "workstation booted to desktop"
   ## frame before any probe runs.
   story_snap 25 workstation-desktop "${ws}"
}

## Classify a guest probe run from its captured stdout by anon-leak-test's OWN JSON verdict, never
## the process exit. anon-leak-test (--json) emits one top-level object with an integer "exit_code"
## (0 clear / 1 leak / 2 inconclusive): immune to guestcontrol's exit-code mangling (a guest 2
## reaches the host as 34), and PRESENT only when the probe ran to completion. A guest-side infra
## failure (dsudo failure, python traceback, missing file) exits 1 with NO such verdict object, and
## a transport cut yields none -- both -> SETUP, never a false leak. leak-exit-classify reads the
## object's TOP-LEVEL integer exit_code via a real JSON parse (a nested detail exit_code and decoy
## objects cannot flip it); any ambiguity is inconclusive -> SETUP, fail-closed.
probe_verdict() {
   local out="$1"
   case "$(printf '%s\n' "${out}" | "${LEAK_EXIT_CLASSIFY}")" in
      clear)
         return 0
         ;;
      leak)
         ## a probe proved non-Tor egress (LEAK)
         return 1
         ;;
      *)
         ## inconclusive: exit_code 2, or no JSON verdict at all (infra/transport failure)
         return "${SETUP_RC}"
         ;;
   esac
}

## Run the battery in the WS as sysmaint via guestcontrol; probe_verdict reads anon-leak-test's
## JSON "exit_code" (0 clear / 1 leak / 2 inconclusive). PROBES selects the probe set.
ws_battery() {
   local probes="$1" out
   ## Run the battery (on the /mnt/shared mount) as root via dsudo (empty-password submit); one
   ## short command, no inline script. The CLI runs by its own shebang + exec bit (/mnt/shared is
   ## vboxsf with exec, root-readable). Capture stdout (the JSON verdict + logs) and classify on it;
   ## the host-side process exit is discarded (guestcontrol does not preserve it).
   out="$("${VBOX_EXEC_LOCAL}" "${ws}" --role sysmaint --timeout 300 \
      --cmd "dsudo ${GUEST_SHARE_MOUNT}/anon-leak-test ${probes} --json")" || true
   printf '%s\n' "${out}"
   ## Expose the raw JSON for the story: main cards the battery verdict (per-probe results +
   ## exit_code) from the last battery output -- one authoritative stage card, not a re-run.
   battery_json_last="${out}"
   probe_verdict "${out}"
}

## Run the app/browser-layer webrtc probe. STAGE as root (sysmaint + dsudo): /mnt/shared is a
## root-only read-only mount, so copy the CLI + harness into a world-readable guest-local dir
## (explicit 0755, umask-independent), in a SEPARATE call so a staging/transport failure returns
## SETUP_RC, never a false exit-1 LEAK. Then RUN the probe in the sysmaint session (the WS boots
## sysmaint for the battery's root ops; `user` is not logon-able over guestcontrol there). Tor
## Browser refuses a sysmaint-booted session (boot_session is read from the kernel cmdline, not the
## uid) unless tb_allow_start_in_sysmaint=true -- the documented override -- so inject it. Classify
## the JSON verdict via probe_verdict: a probe-run infra failure (no JSON) is SETUP, never a leak.
## Headless env for the torbrowser wrapper: tb_allow_start_in_sysmaint=true (sysmaint-booted WS)
## and open_link_confirmation_skip=true (skip the GUI link-confirmation dialog). The WS sysmaint
## session already runs a native Wayland desktop (wayland-0 under /run/user/<uid>), but guestcontrol
## does NOT inherit the session env, so firefox has no display and never loads the harness. Attach
## to the LIVE Wayland session -- WAYLAND_DISPLAY=wayland-0 + XDG_RUNTIME_DIR=/run/user/<uid> (the
## probe runs as the session owner sysmaint) + MOZ_ENABLE_WAYLAND=1 so Tor Browser runs as a native
## Wayland client. Wayland-only: no X11/Xwayland, no xvfb/compositor to install.
ws_browser_probe() {
   local out
   "${VBOX_EXEC_LOCAL}" "${ws}" --role sysmaint --timeout 120 \
      --cmd "dsudo install -d -m 0755 ${GUEST_PROBE_LOCAL} && dsudo install -m 0755 ${GUEST_SHARE_MOUNT}/anon-leak-test ${GUEST_PROBE_LOCAL}/anon-leak-test && dsudo install -m 0644 ${GUEST_SHARE_MOUNT}/anon-leak-webrtc.js ${GUEST_PROBE_LOCAL}/anon-leak-webrtc.js" \
      || return "${SETUP_RC}"
   out="$("${VBOX_EXEC_LOCAL}" "${ws}" --role sysmaint --timeout 300 \
      --cmd "env tb_allow_start_in_sysmaint=true open_link_confirmation_skip=true WAYLAND_DISPLAY=wayland-0 MOZ_ENABLE_WAYLAND=1 XDG_RUNTIME_DIR=/run/user/\$(id -u) ${DM_WHONIX_PAIR_BROWSER_ENV:+${DM_WHONIX_PAIR_BROWSER_ENV} }${GUEST_PROBE_LOCAL}/anon-leak-test --probe browser-webrtc --json")" || true
   printf '%s\n' "${out}"
   probe_verdict "${out}"
}

## Preflight (run once the WS is up in sysmaint, BEFORE any root step): confirm the guest session
## is the expected account AND can actually obtain root via dsudo, so a mis-set account fails HERE
## with a clear message instead of a confusing mid-run "sudo: a password is required". Same
## guestcontrol mechanism the battery/flush use.
ws_assert_root() {
   local out
   ## The \$(...) run IN THE GUEST (double-quoted + escaped \$, the file's guestcontrol convention).
   ## Assert the account (whoami=sysmaint), that dsudo YIELDS root (whoami=root), and that dsudo can
   ## RUN a command as root (`test -d /usr`, dev-root's own check). Plain dsudo -- NOT
   ## `dsudo --non-interactive` (that passes `sudo -n`, which refuses the empty-password submit the
   ## askpass makes; dsudo is already non-interactive, no tty, fail-closed).
   out="$("${VBOX_EXEC_LOCAL}" "${ws}" --role sysmaint --timeout 60 \
      --cmd "[ \"\$(whoami)\" = sysmaint ] || { printf 'WRONGUSER=%s\n' \"\$(whoami)\"; exit 10; }; [ \"\$(dsudo whoami)\" = root ] || { printf 'NOROOT\n'; exit 11; }; dsudo test -d /usr || { printf 'DSUDO_RUN_FAIL\n'; exit 12; }; printf 'ROOT_OK\n'" 2>&1)" \
      || die "${SETUP_RC}" "WS sysmaint session cannot obtain root via dsudo (empty-password submit failed; account state?): ${out}"
   [ "${out}" != "${out#*ROOT_OK}" ] \
      || die "${SETUP_RC}" "WS root preflight did not confirm uid 0 via dsudo: ${out}"
}

## Functional positive control: confirm LIVE Tor egress via the AppArmor-confined, hardened
## systemcheck -- a stronger confirmer than a bespoke curl/JSON parse (a subverted control would
## mask a dead link). Confirm BOTH ports: systemcheck's check_tor_socks_or_trans_port is an OR, so
## a single-port pass could ride a HALF-broken Tor; require SocksPort AND TransPort. Runs as
## sysmaint (the booted role), NO sudo: a single --function run skips root_check and the
## connectivity test is user-agnostic, and it avoids the full --leak-tests `systemctl --user
## is-system-running` (no user session under guestcontrol). Each systemcheck exit 0 = that port
## reached Tor; ANY non-zero fails the control -- fail-closed.
ws_tor_confirm() {
   local port
   for port in check_tor_socks_port check_tor_trans_port; do
      "${VBOX_EXEC_LOCAL}" "${ws}" --role sysmaint --timeout 300 \
         --cmd "systemcheck --cli --leak-tests --function ${port}" \
         || return "${SETUP_RC}"
   done
   return 0
}

## Flush the Workstation's OWN nftables firewall before the leak battery. The WS firewall is a
## failsafe; the MAIN Whonix leak protection is the GATEWAY. With the WS firewall up, a leak probe
## can be DROPPED at the WS and never reach the GW external NIC -- a false "clean" that would hide
## a broken Gateway. Flushing it lets every probe flow to the GW, so the GW-NIC / host-wire canary
## measures the GATEWAY's protection (the real boundary). The WS has no direct route (single
## internal NIC via the GW), so this exposes no new egress path; snapshot restore reverts it.
## Fail-closed: if the WS firewall cannot be flushed+confirmed-empty, a leak could be masked at
## the WS -> SETUP, never a vacuous pass. Root via dsudo (empty-password submit).
ws_flush_firewall() {
   ## DUMP the ruleset (shared dumper) -> FLUSH all -> DUMP again (same dumper) -> CHECK empty.
   ## The BEFORE dump is emitted to the host log (forensics: what was flushed); the AFTER dump is
   ## the fail-closed empty check -- a non-empty AFTER means the flush did not take.
   ## Capture the AFTER-dump's rc separately: a failed `nft list` with empty stdout must NOT read
   ## as confirmed-empty (`after=$(dump) || exit 1`), else a broken list vacuously "passes".
   "${VBOX_EXEC_LOCAL}" "${ws}" --role sysmaint --timeout 120 \
      --cmd "dump() { dsudo nft list ruleset; }; printf 'ws_flush_firewall: WS nft ruleset BEFORE flush:\n' >&2; dump >&2; dsudo nft flush ruleset; after=\"\$(dump)\" || exit 1; [ -z \"\${after}\" ]" \
      || die "${SETUP_RC}" "could not flush+confirm-empty the WS nftables firewall (a leak could be masked at the WS) -- inconclusive, not a leak"
}

## Positive-control EMIT: from the GW, as the `clearnet` user (allowed DIRECT clearnet TCP on the
## GW -- not torified), open ONE TCP connection to the RESERVED guard's real ORPort. Legitimate:
## that ORPort is published in the public consensus for any client to connect to, so a single
## connection attempt is authorized by design and raises no abuse complaint (not an unsolicited
## scan). The reserved guard is allowlisted (no leak) and excluded from EntryNodes (Tor never uses
## it), so this puts a DETERMINISTIC known-good packet on the wire that the canary counts SEPARATELY
## from genuine Tor guard traffic. Wrapped (|| true) so a transient guestcontrol error does not
## abort before the canary runs; canary_gateway_pcap's pc_seen>=1 check is the authoritative gate
## (a truly missing emit surfaces there as SETUP, never a silent pass).
gw_positive_control() {
   "${VBOX_EXEC_LOCAL}" "${gw}" --role user --timeout 60 \
      --cmd "leaprun sudo && sudo --non-interactive -u clearnet timeout 5 bash -c 'exec 3<>/dev/tcp/${GUARD_PC_IP4}/${GUARD_PC_PORT}'; true" \
      || true
}

## Stop Tor on the Gateway to ARM the killswitch, keeping the GW in its USER session so
## forwarding stays intact (a sysmaint boot could sever it). dev-root -- run once in a
## sysmaint session and baked into the clean-live snapshot -- makes `leaprun sudo` grant
## passwordless root in the user session. Fail-closed: if Tor cannot be stopped the
## killswitch is untestable -> SETUP, never a silent pass. A short retry rides out
## guestcontrol/VBoxService settling.
gw_stop_tor() {
   local attempt
   for attempt in $(seq 1 3); do
      ## Positively CONFIRM Tor is down in the same call: stop it, then negate
      ## `is-active --quiet` so the remote command succeeds ONLY when tor@default is no
      ## longer active. This is the fail-closed proof Tor is actually stopped -- it does
      ## not rely on interpreting a later probe's ambiguous exit code.
      if "${VBOX_EXEC_LOCAL}" "${gw}" --role user --timeout 120 \
         --cmd "leaprun sudo && sudo --non-interactive systemctl stop tor@default.service && sleep 5 && ! sudo --non-interactive systemctl is-active --quiet tor@default.service"; then
         return 0
      fi
      printf '%s\n' "${me}: GW Tor-stop attempt ${attempt} failed; retrying" >&2
      sleep 10
   done
   die "${SETUP_RC}" "killswitch: could not stop Tor on the GW (dev-root in the snapshot? leaprun sudo available? tor@default unit name?)"
}

## Restart Tor on the Gateway after the killswitch window, so the STOP is a bracketed,
## reversible operation. Same user-session + leaprun sudo path as gw_stop_tor.
gw_start_tor() {
   "${VBOX_EXEC_LOCAL}" "${gw}" --role user --timeout 120 \
      --cmd "leaprun sudo && sudo --non-interactive systemctl start tor@default.service" \
      || die "${SETUP_RC}" "killswitch recovery: could not restart Tor on the GW"
}

## Pin the GW's Tor to the fixed entry guards (EntryNodes + StrictNodes 1) so its ONLY Tor egress
## is GUARD_PIN_IPS4. The allowlist is a superset -- those entry guards PLUS the reserved
## positive-control guard (GUARD_PC_IP4, deliberately not an EntryNode, so Tor never dials it). Written
## as a torrc.d drop-in (Whonix %includes /usr/local/etc/torrc.d/*.conf) via leaprun sudo in the
## GW USER session (forwarding intact), then read back + synced so a clean poweroff flushes it.
## Done on the UNtraced first boot; boot_gateway then power-cycles into the TRACED boot where Tor
## connects to ONLY these guards. Fail-closed: any failure -> SETUP, never a silent pass (a GW
## that cannot be pinned must not be measured against this allowlist).
gw_pin_guards() {
   local csv
   csv="$(IFS=','; printf '%s' "${GUARD_PIN_IPS4[*]}")"
   "${VBOX_EXEC_LOCAL}" "${gw}" --role user --timeout 120 \
      --cmd "leaprun sudo && printf 'EntryNodes %s\nStrictNodes 1\n' '${csv}' | sudo --non-interactive tee ${GW_TORRC_PIN} >/dev/null && sudo --non-interactive grep -q '^StrictNodes 1' ${GW_TORRC_PIN} && sudo --non-interactive sync" \
      || die "${SETUP_RC}" "could not pin entry guards on the GW (torrc.d writable? leaprun sudo available?)"
}

## Deny-by-default allowlist BPF: permit ONLY the pinned guards + structural link infra; any other
## clearnet packet is a leak. SINGLE source of the allowlist semantics: canary_gateway_pcap uses
## it, and --print-allow-filter emits it verbatim for the host-wire oracle (host-wire-leak-capture),
## so the in-VM and on-the-wire oracles never drift.
##
## Every infra exclusion is scoped so a clearnet dst can NEVER hide behind an infra-looking
## endpoint, AND so VBox slirp's surprising routing is not mistaken for unroutable:
##   - DHCP is `port 67 AND port 68 AND dst 255.255.255.255` (the real broadcast exchange slirp
##     consumes) -- not the ports alone (else `:68 -> 8.8.8.8:67` would be exempt), and not a bare
##     `dst 255.255.255.255` (slirp rewrites that to the host's 127.0.0.1, so a non-DHCP packet
##     there IS a leak path).
##   - multicast is `dst net 224.0.0.0/4` (not tcpdump's `ip multicast`, which is a bare `>= 224`
##     with no upper bound, so 240.0.0.0/4 and 255.0.0.0/8 would leak).
##   - link-local dst only (slirp does not route it off-link); NO loopback exclusion -- slirp
##     delivers 127.0.0.1 / ::1 to the HOST, so those are leaks, not local.
## Guards match EITHER direction (`host`): a nictrace/host tap also sees the guard's REPLIES (whose
## dst is the local NAT/host IP, not a guard) and the self IP differs per observation point, so a
## dst-only guard match would flag every legit reply. Accepted + documented limitations (the
## denylist and the live run backstop these): a packet FORGING a guard IP as its SOURCE to a
## clearnet dst is allowed (no exfil value, and the tested forged-source vector uses CRAFT_SRC,
## which the denylist catches); EntryNodes pins IPs not fingerprints (a deliberate single-source
## choice -- traffic to any relay at a pinned IP is still Tor egress, which is what a leak test
## proves); and a COLD snapshot could bootstrap via non-pinned fallback dirs -- the harness
## requires a WARMED clean-live snapshot so Tor fetches through the pinned guards.
## The ENTRY guards as a BPF host-match (EITHER direction). Tor egresses to these on their ORPorts;
## they are permitted on ANY port (the forged-source / reply accepted-limitation above). This is the
## genuine-Tor-guard liveness count AND one arm of the allowlist. Does NOT include the reserved
## positive-control guard -- that is permitted ONLY on its ORPort via pc_bpf, so a non-Tor packet to
## it is still a leak. Empty string if no entry guards are pinned.
guard_hosts_bpf() {
   local allow='' guard
   for guard in "${GUARD_PIN_IPS4[@]}" "${GUARD_PIN_IPS6[@]}"; do
      allow="${allow:+${allow} or }host ${guard}"
   done
   printf '%s' "${allow}"
}

## The reserved positive-control flow ONLY: the reserved guard on its real ORPort (GUARD_PC_PORT),
## EITHER direction (the SYN out + any reply). Scoped to the PORT, not just the host: the reserved
## guard is NOT an EntryNode, so its ONLY legitimate traffic is this deliberate dial -- a packet to
## that IP on any OTHER port/proto (e.g. UDP/53) is a LEAK, never the positive control and never
## allowlisted. This is both the positive-control count and the reserved guard's allowlist arm.
pc_bpf() {
   local dsthosts='' srchosts='' guard
   for guard in "${GUARD_PC_IP4}" "${GUARD_PC_IP6}"; do
      dsthosts="${dsthosts:+${dsthosts} or }dst host ${guard}"
      srchosts="${srchosts:+${srchosts} or }src host ${guard}"
   done
   ## Match ONLY the legit flow: the GW dials OUT to the reserved guard's ORPort (dst side) and its
   ## reply comes back FROM that ORPort (src side). Scope the ORPort to the reserved-guard side
   ## (not a bare `tcp port`, which also matches a packet whose OTHER endpoint happens to use 9100)
   ## so the allowlist exempts nothing beyond this one connection + its reply. A dst-only match would
   ## wrongly flag the reply (src=guard:9100 -> local:ephemeral) as a leak.
   printf '%s' \
      "(tcp dst port ${GUARD_PC_PORT} and ( ${dsthosts} )) or (tcp src port ${GUARD_PC_PORT} and ( ${srchosts} ))"
}

## Deny-by-default: permit ONLY link infra, the entry guards (any port), and the reserved guard on
## its ORPort (pc_bpf). EVERY other clearnet packet -- incl. any non-ORPort traffic to the reserved
## guard -- is a leak.
## Link infra that is never a leak: DHCP, multicast, link-local (v4+v6).
infra_bpf() {
   printf '%s' '(udp port 67 and udp port 68 and dst host 255.255.255.255) or dst net 224.0.0.0/4 or dst net 169.254.0.0/16 or (ip6 and (dst net ff00::/8 or dst net fe80::/10))'
}

## Guard-only allowlist BPF -- retained for --print-allow-filter / the host-wire oracle.
allowlist_bpf() {
   printf '%s' "(ip or ip6) and not ( $(infra_bpf) ) and not ( $(guard_hosts_bpf) ) and not ( $(pc_bpf) )"
}

## Every IP the GW's Tor may legitimately dial, from TWO sources (read in the GW user session):
##  1. the GW's OWN cached consensus -- entry guards for CIRCUITS + V2Dir/directory relays and
##     authorities for descriptor/consensus fetches (EntryNodes/StrictNodes pins circuit ENTRY,
##     NOT directory connections). Greps EVERY IPv4 / bracketed-IPv6 token (root read -> leaprun
##     sudo), which also sweeps in a few non-address tokens (e.g. a `v Tor 0.4.8.10` version line);
##     those parse as non-routable 0.x junk and never appear as a real egress dst -- a benign
##     over-allow, not worth line-type parsing.
##  2. the tor binary's HARDCODED dir IPs -- the fallback directories + authorities Tor contacts
##     on a COLD bootstrap, BEFORE it has a consensus (so they are absent from source 1). v4 only:
##     the uplink is v4 and a v6 regex over a binary matches too much hex noise. World-readable
##     binary, no sudo. Over-allowing Tor's own dir infra (plus a few embedded constants like
##     127.0.0.1 / 0.0.0.0, none of them routable egress dsts) is safe; the denylist (checked FIRST
##     in the canary) still catches a probe target even if one coincided with a hardcoded IP.
gw_tor_relay_ips() {
   "${VBOX_EXEC_LOCAL}" "${gw}" --role user --timeout 60 \
      --cmd "leaprun sudo && { sudo --non-interactive grep -hoE '([0-9]{1,3}[.]){3}[0-9]{1,3}' /var/lib/tor/cached-microdesc-consensus /var/lib/tor/cached-consensus 2>/dev/null; sudo --non-interactive grep -hoE '\[[0-9a-fA-F:]+\]' /var/lib/tor/cached-microdesc-consensus /var/lib/tor/cached-consensus 2>/dev/null | tr -d '[]'; grep -aoE '([0-9]{1,3}[.]){3}[0-9]{1,3}' \"\$(command -v tor)\" 2>/dev/null; }"
}

## PASS only if NONE of the battery's tagged clearnet targets appear leaving the GW's
## external NIC (Tor carries no such destination), AND the trace actually captured
## traffic (non-blind). tcpdump -r reads the pcap -- no root. Fail-closed: a missing /
## unreadable pcap is treated as a blind capture, never a pass.
canary_gateway_pcap() {
   local total deny_filter hits_out hits leaks_out leak_dsts d tor_out tor_seen pc_out pc_seen rc
   [ -s "${nictrace_pcap}" ] || die "${SETUP_RC}" "canary: GW nictrace pcap empty/missing (blind capture -- inconclusive, not a leak)"
   total="$("${TCPDUMP}" -nr "${nictrace_pcap}" 2>/dev/null | wc -l)"
   [ "${total}" -gt 0 ] || die "${SETUP_RC}" "canary: GW emitted nothing on its external NIC (blind -- inconclusive, not a leak)"
   ## A FILTERED run that is piped to `wc -l` hides tcpdump's exit status: a filter that fails to
   ## COMPILE (libpcap lacking a primitive, a malformed BPF) prints nothing -> count 0 -> a false
   ## "no leak" in any caller where errexit is suppressed. Capture tcpdump's rc DIRECTLY (no pipe)
   ## and die SETUP on failure, so a bad filter is inconclusive, never a clean pass. Counts here
   ## are the leak matches only (0 on a clean run), so holding the output in a var is cheap.
   ## Watch the clearnet targets as DESTINATION and the forged sources as SOURCE (a forged-source
   ## leak egresses with CRAFT_SRC/CRAFT_SRC6 as SOURCE to any dst; the un-NAT'd redirect reply
   ## with dst=CRAFT_SRC is still caught by the dst match).
   deny_filter="dst host ${CLEARNET_ICMP} or dst host ${CLEARNET_NTP} or dst host ${CLEARNET_IPV6} or host ${CRAFT_SRC} or host ${CRAFT_SRC6}"
   rc=0
   hits_out="$("${TCPDUMP}" -nr "${nictrace_pcap}" "${deny_filter}" 2>/dev/null)" || rc=$?
   [ "${rc}" -eq 0 ] \
      || die "${SETUP_RC}" "canary: denylist filter failed to run (unreadable pcap / non-compiling filter) -- inconclusive, not a leak verdict"
   hits=0
   [ -z "${hits_out}" ] || hits="$(printf '%s\n' "${hits_out}" | wc -l)"
   [ "${hits}" -eq 0 ] \
      || die "${FAIL_RC}" "LEAK: a WS probe target reached clearnet via the GW (${hits} pkt(s)) -- NOT Tor-only"
   ## Allowlist (deny-by-default) = any current Tor relay/authority (the GW's OWN consensus) + link
   ## infra. A packet to a Tor relay -- a pinned guard, another guard, or a V2Dir/directory relay
   ## for a descriptor/consensus fetch (EntryNodes/StrictNodes pins CIRCUIT entry, not directory
   ## connections) -- is Tor, not a leak; only a clearnet dst that is NOT a Tor relay (and not
   ## infra) is a leak. NO carve-out for host-DNS / a NON_TOR_GATEWAY exception. The pinned +
   ## reserved guards ARE relays, so they are covered here; they stay the liveness signals below.
   ## Checked BEFORE the liveness floors: a DETECTED leak is definitive (FAIL), never downgraded.
   [ -s "${gw_relay_cache}" ] \
      || die "${SETUP_RC}" "canary: GW Tor consensus relay set was not captured before poweroff -- cannot classify egress (inconclusive, not a leak)"
   rc=0
   leaks_out="$("${TCPDUMP}" -nr "${nictrace_pcap}" "(ip or ip6) and not dst host ${GW_NAT_IP4} and not ( $(infra_bpf) )" 2>/dev/null)" || rc=$?
   [ "${rc}" -eq 0 ] \
      || die "${SETUP_RC}" "canary: egress read failed (non-compiling filter / unreadable pcap) -- inconclusive, not a leak verdict"
   ## Each distinct clearnet dst IP that is NOT in the allowed set is a leak -- for EVERY protocol,
   ## not only ported TCP/UDP. The dst is the token after tcpdump's `> `. IPv4: a bare `([0-9.]){4}`
   ## match stops at the 4th octet, so `A.B.C.D.port` yields `A.B.C.D` and a PORTLESS `A.B.C.D`
   ## (ICMP / GRE / ESP / raw-IP, no port) is captured identically -- no port-strip sed (which would
   ## mis-truncate a portless IPv4). IPv6: require a colon so an IPv4 line never matches; the hex/
   ## colon class stops at the `.port`, and a trailing `:` (the portless `> dst: descr` separator) is
   ## stripped. A portless egress is never Tor (Tor is TCP ORPort), so a portless non-relay dst is a
   ## strong leak signal -- the deny-by-default must see it, not only the fixed denylist.
   leak_dsts=''
   while read -r d; do
      [ -n "${d}" ] || continue
      grep --fixed-strings --line-regexp --quiet -- "${d}" "${gw_relay_cache}" || leak_dsts="${leak_dsts:+${leak_dsts} }${d}"
   done < <( { printf '%s\n' "${leaks_out}" | grep -oE '> ([0-9]{1,3}[.]){3}[0-9]{1,3}'
               printf '%s\n' "${leaks_out}" | grep -oiE '> [0-9a-f:]*:[0-9a-f:]+'; } \
            | sed 's/^> //; s/:$//' | sort -u )
   [ -z "${leak_dsts}" ] \
      || die "${FAIL_RC}" "LEAK: clearnet dst(s) that are NOT Tor relays on the GW NIC: ${leak_dsts} -- NOT Tor-only (see preserved pcap decode)"
   ## Liveness floor -- GENUINE Tor guard traffic (the entry guards). The GW's Tor MUST have reached
   ## an entry guard, so this MUST be non-trivial; a tiny count => blind/undercounting tap (wrong NIC
   ## / died / over-tight filter) OR Tor never connected => inconclusive, never a pass. Counted apart
   ## from the pc emit (the reserved guard is not an entry guard) so neither masks the other.
   rc=0
   tor_out="$("${TCPDUMP}" -nr "${nictrace_pcap}" "$(guard_hosts_bpf)" 2>/dev/null)" || rc=$?
   [ "${rc}" -eq 0 ] || die "${SETUP_RC}" "canary: Tor guard-traffic read failed -- inconclusive, not a leak verdict"
   tor_seen=0
   [ -z "${tor_out}" ] || tor_seen="$(printf '%s\n' "${tor_out}" | wc -l)"
   [ "${tor_seen}" -ge "${GUARD_MIN_PKTS}" ] \
      || die "${SETUP_RC}" "canary: GW NIC trace shows only ${tor_seen} genuine Tor guard pkt(s) (< ${GUARD_MIN_PKTS}) -- blind/undercounting capture or Tor never reached a guard (inconclusive, not a pass)"
   ## Positive control -- the deliberate capture canary: the clearnet user's TCP connection to the
   ## reserved guard's real ORPort (pc_bpf, port-scoped) MUST appear, proving the tap catches a
   ## known-good packet. Counted on its own so it neither masks nor is masked by the Tor floor. Zero
   ## => the capture is blind to the reserved-guard flow or the emit failed => inconclusive, not a pass.
   rc=0
   pc_out="$("${TCPDUMP}" -nr "${nictrace_pcap}" "$(pc_bpf)" 2>/dev/null)" || rc=$?
   [ "${rc}" -eq 0 ] || die "${SETUP_RC}" "canary: positive-control read failed -- inconclusive, not a leak verdict"
   pc_seen=0
   [ -z "${pc_out}" ] || pc_seen="$(printf '%s\n' "${pc_out}" | wc -l)"
   [ "${pc_seen}" -ge 1 ] \
      || die "${SETUP_RC}" "canary: positive-control emit (clearnet user -> reserved guard ${GUARD_PC_IP4}:${GUARD_PC_PORT}) not observed (${pc_seen} pkt) -- capture blind to the deliberate canary or emit failed (inconclusive, not a pass)"
   printf '%s\n' "${me}: canary OK (GW emitted ${total} pkt(s); ${tor_seen} genuine Tor guard pkt(s), ${pc_seen} positive-control pkt(s); 0 probe-target, 0 non-guard clearnet)"
}

## ---------------------------------------------------------------------------
## functional mode (the numbered release-check battery on the Workstation)
## ---------------------------------------------------------------------------

## Boot the Gateway fresh in its default (user) role so it routes Tor for the WS. Unlike
## the leak lane's boot_gateway there is NO guard-pin / NIC-trace / canary -- functional
## mode does not measure egress, it just needs a live Tor uplink.
boot_gateway_functional() {
   vm="${gw}"
   restore_fresh "${gw}"
   "${VBOXMANAGE}" startvm "${gw}" --type headless >/dev/null
   gw_started='true'
   wait_guestcontrol_ready user 300 \
      || die "${SETUP_RC}" "${gw}: guestcontrol not ready -- a provisioning failure, not a release FAIL"
   ## Story: the Gateway booted (guestcontrol confirmed). A CLI edition grabs the text console,
   ## a desktop edition the compositor -- same framebuffer primitive either way.
   story_snap 20 gateway-booted "${gw}"
}

## Boot the Workstation fresh into its DEFAULT (user) session -- the battery's first checks
## (user-session boot, CLI/GUI login, networking, systemcheck) are user-session checks, so
## do NOT select the sysmaint GRUB entry (the ~5s autoboot lands on the user entry). No
## battery share: the release checks run from the guest's own PATH.
boot_workstation_user() {
   vm="${ws}"
   restore_fresh "${ws}"
   ## CLI/inst lane with --local-repo: attach the LOCAL apt repo as the 'shared' vboxsf while the
   ## VM is powered off (permanent attach; the guest auto-mounts it at /mnt/shared via
   ## mnt-shared-vbox.service on boot). Reuse dm-shared-apt-repo -- the single source of the repo
   ## path -- and let on_exit drop the 'shared' mapping. Fail-closed: a failed attach is a
   ## provisioning gap (SETUP_RC), not a release FAIL.
   if [ -n "${local_repo}" ]; then
      ## Pin the repo's share host path when the orchestrator resolved it (--local-repo-base): this
      ## attach runs as the test account, whose env lacks dist_build_slot, so re-deriving the path
      ## here would map the wrong (slot-less) repo -- the delivery would then disagree with the
      ## root-side provenance. LOCAL_APT_REPOSITORY_BASE overrides dm-shared-apt-repo's path outright.
      ## Empty base => derive from the env (the non-slotted single-session case). Fail-closed: a
      ## failed attach is a provisioning gap (SETUP_RC), not a release FAIL.
      if [ -n "${local_repo_base}" ]; then
         LOCAL_APT_REPOSITORY_BASE="${local_repo_base}" "${DM_SHARED_APT_REPO}" attach "${ws}" \
            || die "${SETUP_RC}" "${ws}: could not attach the local apt repo share (${local_repo_base}) -- provisioning gap, not a release FAIL"
      else
         "${DM_SHARED_APT_REPO}" attach "${ws}" \
            || die "${SETUP_RC}" "${ws}: could not attach the local apt repo share -- provisioning gap, not a release FAIL"
      fi
   fi
   "${VBOXMANAGE}" startvm "${ws}" --type headless >/dev/null
   ws_started='true'
   wait_guestcontrol_ready user 300 \
      || die "${SETUP_RC}" "${ws}: guestcontrol not ready as user -- a provisioning failure, not a release FAIL"
   ## Story: the Workstation booted into the user session (guestcontrol confirmed).
   story_snap 25 workstation-booted "${ws}"
}

## Gate on the Gateway's Tor bootstrap from the WS USER session (functional mode boots the
## WS as user), so the battery's networking check is meaningful and not a cold-bootstrap
## flake. The single-function systemcheck run is user-agnostic (skips root_check), so it
## works as the user role. Both SocksPort AND TransPort must confirm (an OR would pass a
## half-broken Tor). Fail CLOSED (SETUP_RC) if Tor never confirms: a provisioning/bootstrap
## gap, not a release FAIL.
ws_func_tor_gate() {
   local attempt port ok
   for attempt in $(seq 1 15); do
      assert_vm_running "${gw}" 'functional phase (wait Tor)'
      ok='true'
      for port in check_tor_socks_port check_tor_trans_port; do
         "${VBOX_EXEC_LOCAL}" "${ws}" --role user --timeout 300 \
            --cmd "systemcheck --cli --leak-tests --function ${port}" || ok='false'
      done
      if [ "${ok}" = 'true' ]; then
         ## Story: Tor bootstrap gate passed. The Gateway state is TEXTUAL (systemcheck positive
         ## control) so card it; the Workstation that just proved egress is the visual frame.
         story_card 30 gateway-tor-bootstrap "Gateway Tor bootstrapped" "Workstation systemcheck confirmed the Gateway's Tor SocksPort + TransPort are up (positive control). The egress path Workstation -> Gateway -> Tor is live; the battery runs only now."
         story_snap 50 workstation-tor-confirmed "${ws}"
         return 0
      fi
      printf '%s\n' "${me}: Tor not confirmed yet (attempt ${attempt}); retrying"
      sleep 20
   done
   die "${SETUP_RC}" "Tor egress never confirmed from the WS user session (GW Tor did not bootstrap / provisioning gap) -- inconclusive, NOT a release FAIL"
}

## Battery executor callback (exec_fn NUM SESSION CMD TIMEOUT): the boot role already implies
## the session (user for 1/5/6/4/8, sysmaint after the reboot for 2/3), so drop SESSION and
## type the command into the REAL on-screen terminal via run_check -- which runs it in a live
## logind session (so `systemcheck --cli --ci` has a user manager) and reads a deterministic
## .rc verdict over guestcontrol.
ws_func_exec() {
   run_check "$1" "$3" "$4"
}

## Battery reboot callback (reboot_sysmaint_fn): the user->sysmaint transition for checks 2,3.
## Clean-reboot the WS into sysmaint (the GW stays up for Tor egress) and reach an input-ready
## terminal again for the OCR executor. clean_poweroff/startvm act on ${vm} (= ws here).
ws_func_reboot_sysmaint() {
   ## Runs as the battery's reboot_sysmaint_fn: it MUST return nonzero (never exit) on ANY
   ## reboot-stage failure, so run_release_check_battery records check 2's reboot failure
   ## (number + reason) and main_functional's `if ! run_release_check_battery` reports it. Every
   ## stage here dies on failure (wait_vm_off, the offline SYSMAINT selection, wait_ready /
   ## open_terminal), so run the whole sequence in a SUBSHELL and convert any exit into
   ## `return 1` -- the dying stage's own stderr still names what failed.
   (
      ## Best-effort: let wait_vm_off below be the single off-state authority (with its specific
      ## message) rather than clean_poweroff's errexit abort pre-empting it.
      clean_poweroff || true
      ## Confirm the WS actually powered off before restarting it -- clean_poweroff (ACPI) is
      ## async and its hard fallback returns without waiting, so an immediate startvm can race a
      ## still-running VM (the slow-poweroff case seen at bake time).
      wait_vm_off "${ws}" 20 \
         || die "${FAIL_RC}" "${ws}: did not power off before the sysmaint reboot -- cannot restart the Workstation"
      ## Deterministic OFFLINE SYSMAINT selection (grubenv next_entry) with the WS powered off,
      ## BEFORE restart -- no OCR, no live-menu race. Unencrypted .vmdk (no passphrase; vmdk).
      ws_disk="$(installed_disk_path "${ws}")" \
         || die "${FAIL_RC}" "${ws}: cannot resolve the system disk for offline SYSMAINT selection on reboot"
      select_installed_sysmaint_offline "${ws_disk}" "" vmdk
      "${VBOXMANAGE}" startvm "${ws}" --type headless >/dev/null
      wait_guestcontrol_ready sysmaint 300 \
         || die "${FAIL_RC}" "${ws}: guestcontrol not ready as sysmaint after reboot -- cannot run the sysmaint checks"
      wait_ready 300
      open_terminal
   ) || return 1
}

## functional mode end to end: boot the pair, gate on Tor, reach an input-ready WS user
## terminal, then drive the numbered release-check battery (>= the kicksecure coverage,
## incl. the full systemcheck via a real user session) and tear down.
main_functional() {
   trap on_exit EXIT
   ## Story: open with the pre-boot pair facts (shared with the leak + cli lanes).
   story_pair_defined
   printf '%s\n' "${me}: [functional] boot Gateway (${gw})"
   boot_gateway_functional
   printf '%s\n' "${me}: [functional] boot Workstation (${ws}) into the user session"
   boot_workstation_user
   printf '%s\n' "${me}: [functional] wait for Tor egress (systemcheck SocksPort + TransPort)"
   ws_func_tor_gate
   printf '%s\n' "${me}: [functional] reach an input-ready terminal in the WS user session"
   wait_ready 300
   open_terminal
   ## Story: the WS desktop with an input-ready terminal, just before the battery runs (the
   ## gui parallel of the cli console-login frame at the same NN slot).
   story_snap 58 workstation-terminal "${ws}"
   ## check_log (ocr-session's run_check_report_failure sink for a failed check's in-guest
   ## output) is CALLER-provided via --check-log; the caller creates, reads + reclaims it
   ## (like the kicksecure lane). Empty on a standalone run -> that sink's
   ## [ -n "${check_log:-}" ] guard skips it.
   printf '%s\n' "${me}: [functional] run the release-check battery in the Workstation"
   ## No verify_fn ('' skips the optional OCR render pre-check): the authoritative signal is
   ## each check's exit code (the .rc file), which run_check reads deterministically.
   ## `if !` both reports WHICH check failed (the battery records the number + reason) and
   ## disarms errexit, so a failure surfaces the reason + FAIL_RC instead of a bare rc=1 abort
   ## (matches dm-upgrade-regression / dm-calamares-install).
   ## wp_story_check (the optional per-check story_fn) cards EACH numbered check pass/fail/routed
   ## from the shared battery loop -- the SAME hook the cli edition passes, so the per-check story
   ## is identical across editions.
   if ! run_release_check_battery ws_func_exec ws_func_reboot_sysmaint '' wp_story_check; then
      die "${FAIL_RC}" "release check ${RELEASE_CHECK_FAILED_NUM:-?} (${RELEASE_CHECK_FAILED_REASON:-unknown}) FAILED"
   fi
   printf '%s\n' "${me}: [functional] PASS -- Workstation passed the full release-check battery"
   story_card 90 functional-verdict "PASS -- full release-check battery" "The Workstation passed the full numbered release-check battery (user + sysmaint sessions) over the Gateway's Tor. Per-check cards above carry each result."
   story_snap 95 workstation-final "${ws}"
   return "${PASS_RC}"
}

## CLI battery executor (exec_fn NUM SESSION CMD TIMEOUT). A CLI edition has NO graphical
## terminal, so -- unlike the GUI ws_func_exec, which types into a real on-screen terminal via
## run_check -- run the check directly over guestcontrol as the boot role's account (SESSION =
## user|sysmaint, which gc_run maps to --role). No OCR, no desktop. gc_run propagates the
## in-guest exit code; print the single "check N PASS" line only on success (matching the GUI
## executor's contract, which owns that green line).
ws_func_cli_exec() {
   vm="${ws}"
   ## check 3 (upgrade-nonroot) over guestcontrol self-severs: the apt upgrade can pull a newer
   ## virtualbox-guest-additions-iso whose reinstall RESTARTS VBoxService, killing the guestcontrol
   ## session running the command (VERR_TIMEOUT). Run it DETACHED and poll its result over fresh
   ## sessions that reconnect once VBoxService returns.
   if [ "$1" = 3 ]; then
      local cli_upgrade_cmd="$3"
      ## --local-repo: run apt-get DIRECTLY, not via upgrade-nonroot. upgrade-nonroot is a usability
      ## wrapper for interactive users and deliberately does NOT forward apt options (passing -o to a
      ## root apt-get is a privilege-escalation vector), so it cannot be pointed at the local sources
      ## -- the wrong tool for a local-repo upgrade. apt-get direct takes the options (sourceparts +
      ## sourcelist=/dev/null + Sandbox::User=root), so the SAME '--update full-upgrade' resolves
      ## offline from the local file: mirror + derivative repo (no Tor). local_repo is enum-validated.
      [ -n "${local_repo}" ] && cli_upgrade_cmd="dsudo apt-get ${LOCAL_TEST_APT_OPTS} --update full-upgrade --yes"
      ws_func_cli_upgrade_detached "$2" "${cli_upgrade_cmd}" "$4"
      return "$?"
   fi
   local tmp rc=0
   tmp="$(mktemp)"
   cli_capture_tmp="${tmp}"   ## track for on_exit: a signal/lock-timeout mid-check must not leak it
   ## Capture to a FILE, not through a pipe: piping gc_run into `head` SIGPIPE-kills the external
   ## writer (vbox-exec-local, not a shell builtin) the instant the cap is hit, so a verbose but
   ## PASSING check (e.g. upgrade-nonroot's ~200 KiB apt output) would be misreported rc 141. A
   ## plain redirect preserves gc_run's REAL exit code; the output is bounded only when READ into
   ## the check-log below (a release check's output is bounded in practice, and ${tmp} is removed
   ## right after, so there is no lingering disk growth).
   gc_run "$2" "$3" "$4" > "${tmp}" 2>&1 || rc=$?
   if [ "${rc}" -eq 0 ]; then
      safe-rm --force -- "${tmp}"; cli_capture_tmp=""
      printf '%s\n' "${me}: check $1 PASS"
      return 0
   fi
   ## Capture the FAILED check's in-guest output (bounded to 64 KiB for the record) to the
   ## caller-owned --check-log (the headless parallel of the GUI run_check_report_failure) so
   ## dm-release-test can publish the failure tail. Empty check_log (standalone) -> skip. Also stderr.
   if [ -n "${check_log:-}" ]; then
      {
         printf '%s\n' "=== check $1 ($3) FAILED rc=${rc} ==="
         head --bytes 65536 -- "${tmp}"
      } >> "${check_log}"
   fi
   head --bytes 65536 -- "${tmp}" >&2
   safe-rm --force -- "${tmp}"; cli_capture_tmp=""
   return "${rc}"
}

## Run the CLI upgrade check (check 3) DETACHED so a VBoxService restart cannot sever it, then poll
## its rc over fresh guestcontrol sessions. $1=role, $2=cmd, $3=timeout(s). Prints the PASS line on
## rc 0 (executor contract); on failure appends the upgrade tail to check_log + returns the rc.
ws_func_cli_upgrade_detached() {
   local role="$1" cmd="$2" timeout="${3:-1800}"
   ## GUEST temp files under the role's home (writable, no host /tmp), nonce'd so a late write from
   ## a prior run cannot be read as this run's result.
   local home nonce out_f rc_f
   # shellcheck disable=SC2016  ## $HOME is evaluated by the GUEST shell, so it must stay literal
   home="$(gc_run "${role}" 'printf %s "$HOME"' 30 2>/dev/null)"
   [ -n "${home}" ] || home="/home/${role}"
   nonce="$(date +%s)-$$-${RANDOM}"
   out_f="${home}/.dm-cli-upgrade-${nonce}.out"
   rc_f="${home}/.dm-cli-upgrade-${nonce}.rc"
   ## setsid detaches the upgrade from the guestcontrol session's process group, so VBoxService's
   ## restart (triggered by the GA reinstall the upgrade pulls) leaves it running; its rc lands in
   ## rc_f. The launching run returns at once (the child is fully redirected off the run's pipes).
   local launch="rm --force -- ${rc_f} ${out_f}; setsid bash -lc '${cmd} > ${out_f} 2>&1; printf %s \$? > ${rc_f}' >/dev/null 2>&1 < /dev/null &"
   gc_run "${role}" "${launch}" 60 >/dev/null 2>&1 || true
   ## Poll rc_f over FRESH sessions: a poll during the VBoxService restart fails transiently (empty);
   ## keep polling to the upgrade budget until the rc (all-digits) is written.
   local deadline=$(( SECONDS + timeout )) rc_val=''
   while [ "${SECONDS}" -lt "${deadline}" ]; do
      rc_val="$(gc_run "${role}" "cat ${rc_f} 2>/dev/null" 30 2>/dev/null)"
      case "${rc_val}" in
         '' | *[!0-9]*)
            sleep 15
            ;;
         *)
            break
            ;;
      esac
   done
   if [ "${rc_val}" = 0 ]; then
      ## Label the mechanism honestly: the local-repo path runs apt-get DIRECTLY (upgrade-nonroot
      ## cannot forward the local-sources options), the default path runs upgrade-nonroot.
      local how='upgrade-nonroot'
      [ -n "${local_repo}" ] && how='apt-get full-upgrade from local repo'
      printf '%s\n' "${me}: check 3 PASS (${how}, detached over guestcontrol)"
      return 0
   fi
   local tail_out
   tail_out="$(gc_run "${role}" "tail --bytes 65536 -- ${out_f} 2>/dev/null" 60 2>/dev/null)"
   if [ -n "${check_log:-}" ]; then
      {
         printf '%s\n' "=== check 3 (${cmd}, detached) FAILED rc=${rc_val:-timeout} ==="
         printf '%s\n' "${tail_out}"
      } >> "${check_log}"
   fi
   printf '%s\n' "${tail_out}" >&2
   return "${rc_val:-1}"
}

## CLI edition has NO user/sysmaint split (wiki/sysmaint): the functional battery runs ENTIRELY in
## the `user` session -- check 2 (the boot-role=sysmaint assertion the CLI never satisfies) is
## route-skipped and check 3 (upgrade-nonroot) is reassigned to the user session, so the battery
## never transitions to sysmaint. This guard is the reboot_sysmaint_fn the battery takes; it fails
## loud if a future sysmaint-session check ever reintroduces a reboot the CLI edition cannot do
## (no boot-role=sysmaint in the cmdline, no sysmaint account to guestcontrol into).
cli_no_sysmaint_reboot() {
   die "${FAIL_RC}" "CLI functional battery must not reboot to sysmaint -- the CLI edition has no user/sysmaint split"
}

## Run check 8 (systemcheck --cli --ci) in a REAL logind user session on the CLI Workstation.
## systemcheck queries `systemctl --user`, which has NO user manager under a VBoxService-spawned
## guestcontrol process, so instead drive a genuine getty CONSOLE LOGIN via host-side scancode
## injection (GUESTCTL type-stdin + chord, the same primitives as dm-calamares-install's VT lane;
## Whonix console login is passwordless `user`), run systemcheck in that session redirecting its
## exit code to a HOME file, and read that file back over guestcontrol (a file read needs no user
## session). Writing to ABSOLUTE /home/${acct} (not /tmp) dodges libpam-tmpdir's per-session
## private tmp, which the guestcontrol reader cannot see. A failed login / drive leaves NO rc file
## -> INCONCLUSIVE (SETUP_RC), never a false green; a non-zero rc -> FAIL with the captured log.
ws_cli_console_systemcheck() {
   vm="${ws}"
   local acct='user' home nonce rc_file log_file who_file attempt tries retry_sleep deadline sc_rc sc_who log_tail
   home="/home/${acct}"
   ## Reuse check 8's shared retry policy (release-checks.bsh) -- running it here must not lose the
   ## battery's retry-across-the-just-booted-transient-window behavior.
   tries="${RELEASE_CHECK_RETRIES[8]:-1}"
   retry_sleep="${RELEASE_CHECK_RETRY_SLEEP[8]:-0}"
   printf '%s\n' "${me}: [functional-cli] check 8: console login + systemcheck (real logind session)"
   for (( attempt = 1; attempt <= tries; attempt++ )); do
      ## PER-ATTEMPT sink names (nonce + attempt index): a timed-out systemcheck from an EARLIER
      ## attempt can still be running and write its rc AFTER this attempt's cleanup, so distinct
      ## files per attempt are what stop this attempt reading a PRIOR attempt's late result (a stale
      ## FAIL masking a passing retry). The nonce also defeats a STALE file, or one a hostile/odd
      ## ~/.profile recreates after cleanup, being mistaken for THIS run's result (false pass).
      nonce="$(date +%s)-$$-${RANDOM}-a${attempt}"
      rc_file="${home}/.dm-cli-systemcheck-${nonce}.rc"
      log_file="${home}/.dm-cli-systemcheck-${nonce}.log"
      who_file="${home}/.dm-cli-systemcheck-${nonce}.who"
      gc_run "${acct}" "rm -f ${rc_file} ${log_file} ${who_file}" 60 >/dev/null 2>&1 || true
      ## Restore a KNOWN console state before (re)login: a PRIOR attempt's systemcheck may still be
      ## running (it timed out), so interrupt it (Ctrl-C) and settle -- otherwise this attempt's
      ## keystrokes interleave with the running command instead of driving a fresh login + run.
      "${GUESTCTL}" "${ws}" chord ctrl c >/dev/null 2>&1 || true
      sleep 2
      ## Dismiss any pending getty prompt, log in (passwordless), then run systemcheck in that
      ## session. Robust to a getty-login OR an auto-login console: a stray 'user' line simply
      ## errors in an already-logged-in shell. whoami records the ACTUAL account (an autologin-root
      ## console must not be credited as 'user'). The result capture is detailed at the command below.
      "${GUESTCTL}" "${ws}" chord enter >/dev/null 2>&1 || true
      sleep 2
      printf '%s' "${acct}" | "${GUESTCTL}" "${ws}" type-stdin >/dev/null 2>&1 || true
      "${GUESTCTL}" "${ws}" chord enter >/dev/null 2>&1 || true
      sleep 5
      ## Redirect systemcheck to a FILE in-guest (NOT piped into head): a pipe would SIGPIPE-kill
      ## systemcheck on a >1 MiB write, recording rc 141 instead of its real exit (a verbose-but-
      ## passing systemcheck would deterministically FAIL every retry). echo $? captures the REAL
      ## exit; the output is bounded only on the read-back below. $? expands IN-GUEST (single-quoted
      ## on the host); the in-guest log lives on the disposable (restore_fresh'd) WS disk.
      # shellcheck disable=SC2016
      printf '%s' "whoami > ${who_file}; systemcheck --cli --ci > ${log_file} 2>&1; echo \$? > ${rc_file}" \
         | "${GUESTCTL}" "${ws}" type-stdin >/dev/null 2>&1 || true
      "${GUESTCTL}" "${ws}" chord enter >/dev/null 2>&1 || true
      ## Story: the WS text console showing the real logind login + systemcheck running (the
      ## evidence that check 8 ran in a genuine user session, not over guestcontrol). Last
      ## attempt's frame wins on overwrite -- best-effort, never changes the verdict.
      story_snap 58 console-login "${ws}"
      ## Poll (over guestcontrol -- a file read needs no user session) for the rc file; read it.
      deadline=$(( SECONDS + 420 ))
      sc_rc=""
      while [ "${SECONDS}" -lt "${deadline}" ]; do
         if gc_run "${acct}" "test -f ${rc_file}" 60 >/dev/null 2>&1; then
            sc_rc="$(gc_run "${acct}" "cat ${rc_file}" 60 2>/dev/null)" || sc_rc=""
            break
         fi
         sleep 10
      done
      sc_who="$(gc_run "${acct}" "cat ${who_file} 2>/dev/null" 60 2>/dev/null)" || sc_who=""
      ## Log out of the console (back to the getty).
      printf '%s' 'exit' | "${GUESTCTL}" "${ws}" type-stdin >/dev/null 2>&1 || true
      "${GUESTCTL}" "${ws}" chord enter >/dev/null 2>&1 || true
      ## No rc read (file never appeared, or the cat failed mid-channel) = a drive/transport
      ## failure, NOT a release verdict -> INCONCLUSIVE (retry if attempts remain).
      if [ -z "${sc_rc}" ]; then
         if [ "${attempt}" -lt "${tries}" ]; then
            printf '%s\n' "${me}: check 8 produced no result (attempt ${attempt}); retrying" >&2
            sleep "${retry_sleep}"
            continue
         fi
         die "${SETUP_RC}" "check 8: no systemcheck result after the console login -- could not drive the getty login / read the result (INCONCLUSIVE, not a release FAIL)"
      fi
      ## The session MUST have run as 'user' -- an autologin-root (or other) console cannot be
      ## credited as a user-session systemcheck pass.
      if [ "${sc_who}" != "${acct}" ]; then
         if [ "${attempt}" -lt "${tries}" ]; then
            printf '%s\n' "${me}: check 8 console ran as '${sc_who:-?}' not '${acct}' (attempt ${attempt}); retrying" >&2
            sleep "${retry_sleep}"
            continue
         fi
         die "${SETUP_RC}" "check 8: console session ran as '${sc_who:-unknown}', not '${acct}' -- cannot attribute the result (INCONCLUSIVE)"
      fi
      if [ "${sc_rc}" = '0' ]; then
         printf '%s\n' "${me}: check 8 PASS (systemcheck --cli --ci via real console login as ${acct})"
         story_card 59 check8-systemcheck "Release check 8: systemcheck (pass)" "PASS -- systemcheck --cli --ci ran in a real getty logind session as '${acct}' and exited 0 (a CLI edition has no logind user manager over guestcontrol, so it is driven via a genuine console login, not the headless battery)."
         return 0
      fi
      ## A genuine non-zero result: retry across the just-booted transient window, else FAIL.
      if [ "${attempt}" -lt "${tries}" ]; then
         printf '%s\n' "${me}: check 8 rc=${sc_rc} (attempt ${attempt}); retrying" >&2
         sleep "${retry_sleep}"
         continue
      fi
      ## Capture the failed systemcheck output to --check-log, bounded to 64 KiB ON THE READ-BACK
      ## (the in-guest log is unbounded by design -- a file redirect, no SIGPIPE -- so bound here).
      if [ -n "${check_log:-}" ]; then
         log_tail="$(gc_run "${acct}" "head --bytes 65536 ${log_file} 2>/dev/null || true" 120 2>/dev/null)" || log_tail=""
         {
            printf '%s\n' "=== check 8 (systemcheck --cli --ci via console login) FAILED rc=${sc_rc} ==="
            if [ -n "${log_tail}" ]; then
               printf '%s\n' "${log_tail}"
            else
               ## A suppressed empty read would leave only the header, with no hint WHY; say so.
               printf '%s\n' "(check 8 log ${log_file} was empty or unreadable over guestcontrol -- no in-guest output captured; the guest may have been mid-write or the session wedged)"
            fi
         } >> "${check_log}"
      fi
      die "${FAIL_RC}" "check 8 (systemcheck --cli --ci via real console login) FAILED (rc=${sc_rc})"
   done
}

## functional mode, CLI edition: the SAME pair boot + Tor gate as the GUI path, but the numbered
## battery runs headless over guestcontrol (no desktop, no OCR), plus check 8 via a real console
## login. Two checks cannot run over the guestcontrol battery and are routed-skipped there with a
## loud reason (printed as ROUTED, never a green PASS -- release-checks.bsh's
## RELEASE_CHECK_SKIP_REASON):
##   - check 6 (GUI login = pgrep labwc): a CLI edition has no compositor -- legitimately N/A.
##   - check 8 (systemcheck --cli --ci): needs a logind user manager, absent over guestcontrol, so
##     it is run SEPARATELY via ws_cli_console_systemcheck (a genuine getty login) -- NOT skipped.
## Enable the fast LOCAL apt repo in the WS (functional CLI/inst lane, --local-repo set). The
## 'shared' vboxsf was host-attached in boot_workstation_user and auto-mounts at /mnt/shared;
## here the in-guest helper writes its [trusted=yes] 'Suites: local' source and refreshes apt, so
## the EXISTING check 3 (upgrade-nonroot = apt-get --update full-upgrade) pulls the derivative
## packages AND the Debian base from the local file: sources only (dedicated dir, sourceparts
## override) -- fully offline, no Tor. Runs as the boot `user`: the CLI edition has NO user/sysmaint
## split, so `user` has sudo and dsudo submits the empty password.
## apt-cache policy confirms the local source is actually live (not silently dropped) so the
## fail-closed check is meaningful. ANY failure -> SETUP_RC (INCONCLUSIVE, not a release FAIL):
## the lane must never claim a local-repo upgrade it did not enable.
ws_func_enable_local_repo() {
   vm="${ws}"
   ## Generate the local apt sources HOST-SIDE (a released image's repo-add-local has no base block):
   ## the derivative 'local' repo + each Debian base suite, carrying the GUEST file: URIs. Residency
   ## is READ from the host-side mirror bind-mount; the emitted URI is the guest mount path. All
   ## inputs are trusted (local_repo is enum-validated, the paths come from dm-shared-apt-repo), and
   ## the stanzas reach the guest base64-encoded, so nothing untrusted hits the guest shell.
   local host_cache guest_cache guest_repo sources_content emitted_suites b64 nick suite spec base_stanza
   if [ "$(type -t local_apt_repo_base_stanza)" != 'function' ] || [ "$(type -t local_apt_repo_sources_stanza)" != 'function' ]; then
      die "${SETUP_RC}" "${ws}: helper-scripts local-apt-repo-sources.bsh not loaded (set HELPER_SCRIPTS_PATH / install helper-scripts) -- cannot generate the local apt sources (INCONCLUSIVE)"
   fi
   ## Resolve the HOST mirror path under the SAME base the orchestrator exposed + the attach used:
   ## this runs as the account (no dist_build_slot in env), so without the pinned --local-repo-base
   ## cache-path would re-derive the slot-less /srv/derivative-maker/aptcache and miss a slotted
   ## expose. The guest path (/mnt/shared/aptcache) is slot-independent, so it needs no base.
   host_cache="$(LOCAL_APT_REPOSITORY_BASE="${local_repo_base}" "${DM_SHARED_APT_REPO}" cache-path)"
   guest_cache="$("${DM_SHARED_APT_REPO}" guest-cache-path)"
   guest_repo="${GUEST_SHARE_MOUNT}/aptrepo_local/${local_repo}"
   [ -d "${host_cache}" ] \
      || die "${SETUP_RC}" "${ws}: Debian mirror not exposed at ${host_cache} (host: run 'dm-shared-apt-repo expose' before the lane) -- cannot source the base locally (INCONCLUSIVE)"
   ## Build the sources in a plain variable (derivative 'local' repo + each RESIDENT Debian base
   ## suite), tracking which base suites resolved. deb822 separates stanzas by a blank line.
   sources_content="$(local_apt_repo_sources_stanza "file:${guest_repo}" local)"
   emitted_suites=""
   for spec in debian:trixie debian:trixie-updates debian-security:trixie-security; do
      nick="${spec%%:*}"
      suite="${spec#*:}"
      if base_stanza="$(local_apt_repo_base_stanza "${host_cache}" "${nick}" "${suite}" "${LOCAL_MIRROR_ARCH}" "${guest_cache}")"; then
         sources_content="${sources_content}"$'\n\n'"${base_stanza}"
         emitted_suites="${emitted_suites} ${suite}"
      fi
   done
   ## Check 3 upgrades from the local-ONLY sources with no remote fallback, so EVERY expected base
   ## suite must resolve -- an incomplete mirror missing e.g. trixie-security would otherwise pass
   ## this lane while SILENTLY excluding security + point updates from the offline upgrade. Require
   ## all three; a missing one is a provisioning gap (INCONCLUSIVE), never a release PASS.
   for spec in debian:trixie debian:trixie-updates debian-security:trixie-security; do
      suite="${spec#*:}"
      case " ${emitted_suites} " in
         *" ${suite} "*)
            ;;
         *)
            die "${SETUP_RC}" "${ws}: Debian base suite '${suite}' not resolvable from the mirror at ${host_cache} -- incomplete mirror, refusing a partial offline upgrade (INCONCLUSIVE)"
            ;;
      esac
   done
   b64="$(printf '%s\n' "${sources_content}" | base64 --wrap=0)"
   ## Write the sources into the DEDICATED guest dir, then update + policy-check reading ONLY that
   ## dir -- so check 3 upgrades offline from the local file: sources with no pin and no edit to the
   ## guest's own apt config.
   gc_run user "dsudo install -d -m 0755 ${LOCAL_TEST_SOURCES_DIR} && printf %s '${b64}' | base64 --decode | dsudo tee ${LOCAL_TEST_SOURCES_DIR}/local-apt-repo.sources >/dev/null && dsudo apt-get ${LOCAL_TEST_APT_OPTS} --quiet update && apt-cache ${LOCAL_TEST_APT_OPTS} policy | grep --quiet --fixed-strings 'aptrepo_local/${local_repo}'" 600 \
      || die "${SETUP_RC}" "${ws}: could not enable the local apt sources in the WS (generate/write/update/policy failed) -- INCONCLUSIVE, not a release FAIL"
   story_card 55 local-repo-enabled "Local apt repo enabled in the Workstation" "The derivative 'local' apt source plus the Debian base suites (${emitted_suites# }) are live -- apt-cache policy shows aptrepo_local/${local_repo}. Check 3 upgrades offline from these file: sources, no Tor."
}

## Verify the local build payloads were ACTUALLY installed, not merely AVAILABLE. apt-cache policy
## (ws_func_enable_local_repo) proves the SOURCE is live; it proves nothing about installed content.
## check 3 (upgrade-nonroot = apt-get full-upgrade) is a NO-OP for a package whose local build equals
## the already-installed version -- and dm "replaces content at the same version string" on a rebuild
## -- so the battery could pass on the IMAGE's payload while the run reports THIS build: a false
## local-build verdict. Force the local payload onto the system for every local-repo package that is
## already installed (--reinstall --allow-downgrades pins the exact local version regardless of
## version equality or ordering) and assert the installed version matches the local build. ANY
## mismatch, or no local package installed at all -> SETUP_RC (INCONCLUSIVE), never a release PASS:
## the lane must never claim a local-build upgrade it did not install. local_repo is enum-validated
## (kicksecure|whonix) and GUEST_SHARE_MOUNT is a fixed constant, so both are safe to interpolate;
## the guest-side $-vars stay literal (escaped in the heredoc), evaluated in the WS.
ws_func_verify_local_repo_installed() {
   vm="${ws}"
   local pkgs_path verify_cmd
   pkgs_path="${GUEST_SHARE_MOUNT}/aptrepo_local/${local_repo}/dists/local/main/binary-amd64/Packages"
   read -r -d '' verify_cmd <<GUEST || true
set -eu
pkgs='${pkgs_path}'
[ -r "\$pkgs" ] || { echo "local Packages index not readable in the guest: \$pkgs" >&2; exit 1; }
specs=\$(awk '/^Package: /{p=\$2} /^Version: /{if(p!=""){print p"="\$2; p=""}}' "\$pkgs")
[ -n "\$specs" ] || { echo 'local repo lists no packages' >&2; exit 1; }
installed=''
for s in \$specs; do
  n=\${s%%=*}
  if dpkg-query -W -f='\${Status}' "\$n" 2>/dev/null | grep -q 'install ok installed'; then
    installed="\$installed \$s"
  fi
done
[ -n "\$installed" ] || { echo 'no local-repo package is installed in the guest -- this build was not exercised' >&2; exit 1; }
dsudo apt-get ${LOCAL_TEST_APT_OPTS} install --reinstall --yes --allow-downgrades -t local \$installed
for s in \$installed; do
  n=\${s%%=*}; v=\${s#*=}
  got=\$(dpkg-query -W -f='\${Version}' "\$n")
  [ "\$got" = "\$v" ] || { echo "local payload NOT installed: \$n want \$v got \${got:-<none>}" >&2; exit 1; }
done
GUEST
   gc_run user "${verify_cmd}" 600 \
      || die "${SETUP_RC}" "${ws}: local payload verification failed -- the locally-built packages were not actually installed (INCONCLUSIVE, not a release FAIL)"
   story_card 56 local-build-installed "Local build payloads installed" "Every locally-built package already installed was reinstalled from the local repo and its installed version matches the local build, so check 3's verdict applies to THIS build, not the image's same-version payload."
}

## Everything else runs faithfully headless: user/sysmaint boot-role (checks 1, 2), CLI login
## (5, whoami), networking over the Gateway's Tor (4), and upgrade-nonroot (3).
main_functional_cli() {
   trap on_exit EXIT
   ## Story: open with the pre-boot pair facts (shared with the leak + gui lanes).
   story_pair_defined
   printf '%s\n' "${me}: [functional-cli] boot Gateway (${gw})"
   boot_gateway_functional
   printf '%s\n' "${me}: [functional-cli] boot Workstation (${ws}) into the user session"
   boot_workstation_user
   printf '%s\n' "${me}: [functional-cli] wait for Tor egress (systemcheck SocksPort + TransPort)"
   ws_func_tor_gate
   ## Enable the LOCAL apt repo AFTER Tor is confirmed (its apt-get update refreshes the Debian
   ## base over Tor too, so it must not race a cold bootstrap). No-op unless --local-repo was set.
   if [ -n "${local_repo}" ]; then
      printf '%s\n' "${me}: [functional-cli] enable the local apt repo (${local_repo}) in the Workstation"
      ws_func_enable_local_repo
      ## Before the battery: prove the local payloads are actually INSTALLED (not just available), so
      ## check 3's verdict genuinely applies to THIS build and not the image's same-version payload.
      printf '%s\n' "${me}: [functional-cli] verify the local build payloads are installed in the Workstation"
      ws_func_verify_local_repo_installed
   fi
   ## check 8 in the user phase (before the sysmaint reboot), via a real console login.
   ws_cli_console_systemcheck
   RELEASE_CHECK_SKIP_REASON[6]='CLI edition has no graphical session (no labwc compositor)'
   RELEASE_CHECK_SKIP_REASON[8]='run separately via a real console login (ws_cli_console_systemcheck); guestcontrol has no logind user manager'
   ## CLI edition has NO user/sysmaint split (wiki/sysmaint): route-skip check 2 (the
   ## boot-role=sysmaint assertion the CLI never sets) and run check 3 (upgrade-nonroot) in the
   ## single `user` session, so the battery stays in the user session and never reboots to sysmaint.
   RELEASE_CHECK_SKIP_REASON[2]='CLI edition has no user/sysmaint boot-role split (wiki/sysmaint)'
   RELEASE_CHECK_SESSION[3]='user'
   printf '%s\n' "${me}: [functional-cli] run the release-check battery over guestcontrol (no OCR)"
   ## No verify_fn ('' skips the OCR render pre-check -- there is no desktop to cross-check); the
   ## authoritative signal is each check's in-guest exit code over guestcontrol.
   ## wp_story_check (the optional per-check story_fn) cards EACH numbered check pass/fail/routed
   ## from the shared battery loop -- the SAME hook the gui edition passes (unify cli vs gui). The
   ## routed checks (2/6/8) card their skip reason here; check 8's real run is carded by
   ## ws_cli_console_systemcheck (NN 58/59) above.
   if ! run_release_check_battery ws_func_cli_exec cli_no_sysmaint_reboot '' wp_story_check; then
      die "${FAIL_RC}" "release check ${RELEASE_CHECK_FAILED_NUM:-?} (${RELEASE_CHECK_FAILED_REASON:-unknown}) FAILED"
   fi
   printf '%s\n' "${me}: [functional-cli] PASS -- Workstation passed the CLI release-check battery + console-login systemcheck"
   story_card 90 functional-verdict "PASS -- CLI release-check battery + console systemcheck" "The Workstation passed the CLI numbered release-check battery over the Gateway's Tor, plus systemcheck via a real console login (check 8). Per-check cards above carry each result."
   story_snap 95 workstation-final "${ws}"
   return "${PASS_RC}"
}

## functional stacks Tor bootstrap + two VM boots + a sysmaint reboot + the full numbered
## battery (per-check budgets sum to ~2430s, check 3 alone is 1800s), so the 2400s leak TTL
## can expire mid-run. Default = battery budget + setup headroom (robust to battery changes --
## RELEASE_CHECK_TIMEOUT is sourced from release-checks.bsh); leak keeps the lighter 2400s.
## DM_WHONIX_PAIR_LOCK_TTL still overrides either.
FUNCTIONAL_SETUP_HEADROOM=1800
lock_ttl_default() {
   local m="$1" sum=0 t
   if [ "${m}" = 'functional' ]; then
      for t in "${RELEASE_CHECK_TIMEOUT[@]}"; do
         sum=$(( sum + t ))
      done
      printf '%s' "$(( sum + FUNCTIONAL_SETUP_HEADROOM ))"
   else
      printf '%s' 2400
   fi
}

main() {
   parse_args "$@"
   ## --local-repo is the CLI/inst lane's fast local-upgrade seam: repo-add-local needs root, and
   ## only the split-free CLI edition's boot `user` can obtain it (the GUI lxqt lane's user cannot
   ## -- user-sysmaint-split -- and its check 3 runs in a sysmaint session). Reject any other
   ## combination fail-closed (SETUP_RC) rather than silently skip, so a misdirected flag never
   ## reads as a local-repo run it was not.
   if [ -n "${local_repo}" ] \
      && { [ "${mode}" != 'functional' ] || [ "${interface}" != 'cli' ]; }; then
      die "${SETUP_RC}" "--local-repo is valid only with --mode functional --interface cli (the CLI/inst lane); got --mode ${mode} --interface ${interface}"
   fi
   ## Self-lock AFTER parse_args, so informational flags (--print-guards/-filter, --help) that
   ## exit in parse_args never take a VM lock. A leak test is mutually exclusive with ALL
   ## other VM work on the shared OVH server (foreign VM traffic confounds a leak measurement;
   ## the fleet VMs collide). Re-exec under dm-vm-lock (class=leak, EXCLUSIVE) so the mutex is
   ## acquired INSIDE the script and cannot be bypassed; the re-exec'd run sees DM_VM_LOCK_HELD
   ## and runs through (staging below then happens once, under the lock). Fail-closed: a
   ## missing dm-vm-lock aborts rather than running a leak test unlocked.
   if [ -z "${DM_VM_LOCK_HELD:-}" ]; then
      ## style-ok: R-103 -- intentional re-exec: run this VM test under the VM-work lock
      ## (class=leak serializes ALL fleet VM work; the functional battery needs the same
      ## exclusivity on the shared host).
      exec dm-vm-lock acquire --class leak --ttl "${DM_WHONIX_PAIR_LOCK_TTL:-$(lock_ttl_default "${mode}")}" -- "$0" "$@"
   fi

   ## functional mode: the numbered release-check battery on the WS -- no anon-leak-test
   ## checkout, no battery share, no GW nictrace/canary. Branch before the leak-only setup.
   if [ "${mode}" = 'functional' ]; then
      if [ "${interface}" = 'cli' ]; then
         main_functional_cli
      else
         main_functional
      fi
      return "$?"
   fi

   [ -x "${ANON_LEAK_TEST_REPO}/usr/bin/anon-leak-test" ] \
      || die "${SETUP_RC}" "anon-leak-test checkout not found at ${ANON_LEAK_TEST_REPO} (set ANON_LEAK_TEST_REPO)"
   [ -r "${ANON_LEAK_TEST_REPO}/usr/bin/anon-leak-inject" ] \
      || die "${SETUP_RC}" "anon-leak-inject (the shared L2 crafter) not found beside anon-leak-test in ${ANON_LEAK_TEST_REPO}"
   trap on_exit EXIT
   ## Stage the REAL battery + its sibling injector (read live, no drift) in a host dir
   ## shared read-only into the WS. gateway-craft finds anon-leak-inject beside itself on
   ## /mnt/shared and drives it (the single shared crafter -- no re-embedded copy).
   share_dir="$(mktemp -d -t whonix-battery.XXXXXX)"
   cp -- "${ANON_LEAK_TEST_REPO}/usr/bin/anon-leak-test" "${share_dir}/anon-leak-test"
   cp -- "${ANON_LEAK_TEST_REPO}/usr/bin/anon-leak-inject" "${share_dir}/anon-leak-inject"
   ## Opt-in app/browser layer: stage the WebRTC harness beside the battery (anon-leak-test's
   ## find_harness looks beside itself on /mnt/shared).
   if [ "${DM_WHONIX_PAIR_BROWSER:-0}" = '1' ]; then
      [ -r "${ANON_LEAK_TEST_REPO}/usr/share/anon-leak-test/anon-leak-webrtc.js" ] \
         || die "${SETUP_RC}" "DM_WHONIX_PAIR_BROWSER=1 but the WebRTC harness is missing in ${ANON_LEAK_TEST_REPO}/usr/share/anon-leak-test"
      cp -- "${ANON_LEAK_TEST_REPO}/usr/share/anon-leak-test/anon-leak-webrtc.js" "${share_dir}/anon-leak-webrtc.js"
   fi

   ## Story: pre-boot evidence of the exact pair under test (VBoxManage facts, not a photo).
   story_pair_defined

   printf '%s\n' "${me}: boot Gateway (${gw}) with external-NIC trace"
   boot_gateway

   printf '%s\n' "${me}: boot Workstation (${ws}) into sysmaint (battery on /mnt/shared)"
   boot_workstation_sysmaint
   ## Fail EARLY + clearly if the WS session cannot obtain root (before any root-needing step).
   ws_assert_root

   ## Phase 1: gate on the GW's Tor bootstrap -- retry the systemcheck positive control
   ## (SocksPort + TransPort) until it passes, so a clean battery later is meaningful, not
   ## a dead link.
   printf '%s\n' "${me}: wait for Tor egress (systemcheck SocksPort + TransPort) to come up"
   ## NOTE: clean-live must be a WARMED snapshot (booted once so first-boot provisioning
   ## ran and Tor cached its consensus on disk); a never-booted import does a cold Tor
   ## bootstrap that can exceed this budget (seen on a fresh dev-version import).
   local attempt tor_ok='false'
   for attempt in $(seq 1 15); do
      ## Fast-fail: a crashed/aborted GW will never bootstrap -- do not burn the whole
      ## retry budget on a dead VM.
      assert_vm_running "${gw}" 'phase 1 (wait Tor)'
      if ws_tor_confirm; then
         tor_ok='true'
         break
      fi
      printf '%s\n' "${me}: Tor not confirmed yet (attempt ${attempt}); retrying"
      sleep 20
   done
   ## Budget exhausted = the positive control never confirmed Tor. INCONCLUSIVE (GW Tor did
   ## not bootstrap, a provisioning gap, or a persistent leak that systemcheck's binary exit
   ## cannot tell apart from "not up") -> SETUP: fail-closed, never a PASS and never a false
   ## leak verdict. The authoritative leak oracle (Phase 2 battery + GW-NIC canary) runs ONLY
   ## after Tor is confirmed here; if it never is, the run is reported inconclusive, not clean.
   [ "${tor_ok}" = 'true' ] || die "${SETUP_RC}" "Tor egress never confirmed (GW Tor did not bootstrap / provisioning gap) -- inconclusive, NOT a leak"

   ## Story: Tor bootstrap gate passed. The Gateway state is TEXTUAL (systemcheck positive
   ## control), so card it; the Workstation desktop that just proved egress is the visual frame.
   story_card 30 gateway-tor-bootstrap "Gateway Tor bootstrapped" "Workstation systemcheck confirmed the Gateway's Tor SocksPort + TransPort are up (Phase 1 positive control). The egress path Workstation -> Gateway -> Tor is live; the leak oracle below runs only now."
   story_snap 50 workstation-tor-confirmed "${ws}"

   ## Flush the WS's OWN firewall before the battery: the MAIN leak protection is the GATEWAY, and
   ## a WS-firewall drop would stop a leak probe at the WS so it never reaches the GW NIC -- a
   ## false "clean" that hides a broken GW. Removing it lets every probe flow to the GW so the
   ## canary measures the GATEWAY's protection. Reverted by the next snapshot restore.
   ws_flush_firewall
   ## Story: the WS's own failsafe firewall is flushed + confirmed empty, so every probe flows to
   ## the Gateway NIC and the canary measures the GATEWAY's protection, not a WS-side drop.
   ## Key 55 (not 45): this fires AFTER the Tor-confirm snap (50) at runtime; the results site sorts
   ## attachments by NN, so a <50 key would display the flush BEFORE the Tor confirmation it follows.
   story_card 55 ws-firewall-flushed "Workstation firewall flushed" "The Workstation's own nftables failsafe was flushed and confirmed empty before the battery, so no WS-side drop can mask a leak -- the main Whonix protection (the Gateway) is what the battery + GW-NIC canary now measure."

   ## Craft aim + watch list in ONE place: the gateway-craft matrix aims here and the
   ## canary (canary_gateway_pcap) watches exactly these. clearnet-ipv4 = CLEARNET_ICMP.
   local craft_flags="--clearnet-ipv4 ${CLEARNET_ICMP} --craft-src ${CRAFT_SRC} --clearnet-ipv6 ${CLEARNET_IPV6} --craft-src6 ${CRAFT_SRC6}"

   ## Phase 2: the FULL battery incl the comprehensive gateway-craft emit matrix (the
   ## deliberate direct-egress vectors the canary watches for). Exit 0 = Tor-only;
   ## anything else = leak/inconclusive.
   ## NOTE: ipv6-clearnet (the reply-based IPv6 Tor-confirm) is deliberately NOT in this
   ## battery. It is built for the Qubes anon-whonix context where Tor's DNS path serves
   ## check.torproject.org over IPv6; on a standard Whonix-Workstation with no global IPv6
   ## it ERRORs by design (curl --ipv6 cannot reach the A-only host), which would fail the
   ## run on a non-leak. The WS's IPv6 egress IS covered here -- by the gateway-craft v6
   ## matrix (emit + GW-NIC canary), which is gated on a live v6 path and recorded honestly.
   printf '%s\n' "${me}: run the full leak-test battery in the Workstation (sysmaint)"
   ## Battery exit: 0 clean | 1 a probe FAILed (proven non-Tor egress = LEAK) | 2 a probe
   ## could not run (inconclusive). Only a PROVEN leak is FAIL_RC; inconclusive is SETUP_RC
   ## -- a provisioning/transient probe error must never record as a leak verdict.
   local battery_rc=0
   ws_battery "--probe enumerate --probe icmp-clearnet --probe udp-clearnet --probe tor-confirm --probe gateway-craft ${craft_flags}" \
      || battery_rc=$?
   ## Story: ONE card per battery probe (enumerate / icmp / udp / tor-confirm / gateway-craft)
   ## plus a verdict summary, written BEFORE the classification below -- so a FAILED/inconclusive
   ## run (which dies next) still shows WHICH probe failed and why, not just the generic failure
   ## card. Neutral per-probe titles: the recorded battery OUTPUT, not a pass claim (the final
   ## verdict card states PASS). Keys 60-69; browser (70) and killswitch (72+) sort after.
   story_battery_cards 60 leak-battery "${battery_json_last}"
   if [ "${battery_rc}" = '1' ]; then
      die "${FAIL_RC}" "LEAK: the battery proved non-Tor egress (a probe FAILed)"
   elif [ "${battery_rc}" != '0' ]; then
      die "${SETUP_RC}" "leak test INCONCLUSIVE: a probe could not run (battery rc=${battery_rc}) -- not a proven leak"
   fi

   ## Phase 2b: APP/BROWSER layer -- OPT-IN (DM_WHONIX_PAIR_BROWSER=1). Drives the WS browser
   ## (headless) via anon-leak-test's browser-webrtc probe: asserts WebRTC exposes no host IP
   ## and the browser's exit is Tor. Verdict via probe_verdict (ws_browser_probe stages as root,
   ## runs the probe in the sysmaint session with tb_allow_start_in_sysmaint=true). The probe
   ## auto-discovers the browser, or honours ANON_LEAK_BROWSER / DISPLAY injected via
   ## DM_WHONIX_PAIR_BROWSER_ENV. If no browser is found the probe is inconclusive (SETUP),
   ## never a vacuous pass.
   if [ "${DM_WHONIX_PAIR_BROWSER:-0}" = '1' ]; then
      printf '%s\n' "${me}: app/browser layer -- run the browser-webrtc probe in the Workstation"
      local browser_rc=0
      ws_browser_probe || browser_rc=$?
      if [ "${browser_rc}" = '1' ]; then
         die "${FAIL_RC}" "LEAK: the browser layer proved non-Tor egress / a WebRTC host-IP exposure"
      elif [ "${browser_rc}" != '0' ]; then
         die "${SETUP_RC}" "app/browser layer INCONCLUSIVE: the browser-webrtc probe exited ${browser_rc} (see the guest output above) -- not a proven leak"
      fi
      ## Story: the opt-in app/browser layer passed (WebRTC exposed no host IP; browser egress Tor).
      story_card 70 browser-webrtc "App/browser layer: WebRTC leak probe" "anon-leak-test browser-webrtc probe PASSED in the Workstation: the browser's WebRTC path exposed no host IP and its egress was Tor-only."
   fi

   ## Phase 3+4: KILLSWITCH -- OPT-IN only (DM_WHONIX_PAIR_KILLSWITCH=1). Stopping Tor on
   ## the GW needs root there, and the only no-sysmaint route (dev-root -> leaprun sudo)
   ## MUTATES the Gateway, which can falsify the very leak result this harness measures.
   ## So the DEFAULT run is the pure leak test (Phase 1+2 + canary, GW untouched); the
   ## fail-closed/killswitch behavior is covered by the netns fail_closed_test. Enable this
   ## phase only in a DEDICATED leak-test lane where mutating the GW is acceptable.
   if [ "${DM_WHONIX_PAIR_KILLSWITCH:-0}" = '1' ]; then
      ## gw_stop_tor POSITIVELY confirms tor@default is inactive on the GW -- the fail-closed
      ## proof Tor is down, independent of any WS probe exit code. Then re-emit the craft
      ## matrix: with Tor down the firewall must DROP, so the final canary must still show
      ## zero target hits across the WHOLE capture (both Tor-up and Tor-down windows).
      printf '%s\n' "${me}: killswitch -- stop + confirm Tor down on the Gateway, then re-emit"
      gw_stop_tor
      ## Same battery-exit contract as Phase 2: 1 = a probe proved non-Tor egress (LEAK),
      ## any other non-zero = the emit could not run (inconclusive/infra). Classify identically
      ## so a proven leak with Tor down is never downgraded to SETUP.
      local ks_rc=0
      ws_battery "--probe gateway-craft ${craft_flags}" || ks_rc=$?
      ## Story: per-probe cards for the Tor-down re-emit, BEFORE the classification below (so a
      ## FAIL/inconclusive re-emit still carries its evidence). Keys 72-73; the verdict card is 74.
      story_battery_cards 72 killswitch-reemit "${battery_json_last}"
      if [ "${ks_rc}" = '1' ]; then
         die "${FAIL_RC}" "killswitch LEAK: a crafted probe proved non-Tor egress with Tor down"
      elif [ "${ks_rc}" != '0' ]; then
         die "${SETUP_RC}" "killswitch: craft emit could not run with Tor down (battery rc=${ks_rc}) -- an infra failure, not a WS leak"
      fi

      ## RECOVERY. Restart Tor and prove egress is restored -- so the killswitch STOP was a
      ## bracketed, reversible operation (the GW is not wedged) and a dead Tor can never
      ## silently carry into anything added after this phase.
      printf '%s\n' "${me}: killswitch recovery -- restart Tor, confirm egress restored"
      gw_start_tor
      local attempt2 restored='false'
      for attempt2 in $(seq 1 15); do
         assert_vm_running "${gw}" 'killswitch recovery'
         if ws_tor_confirm; then
            restored='true'
            break
         fi
         printf '%s\n' "${me}: Tor egress not back yet (attempt ${attempt2}); retrying"
         sleep 20
      done
      [ "${restored}" = 'true' ] \
         || die "${SETUP_RC}" "killswitch recovery: Tor egress NOT restored after restart (stop not cleanly reversible) -- an infra failure, not a WS leak"
      ## Story: the opt-in killswitch phase. State only what is ESTABLISHED HERE -- Tor positively
      ## confirmed down on the GW, the crafted re-emit probe completed without itself proving a
      ## WS-side leak, and Tor egress recovered after restart. Whether any crafted packet reached
      ## clearnet in the Tor-down window is decided by the Gateway-NIC canary below (card 80), which
      ## covers the WHOLE capture -- do NOT claim zero-clearnet here, before the canary verifies it.
      story_card 74 killswitch "Fail-closed killswitch (Tor stopped on the Gateway)" "Tor was positively confirmed DOWN on the Gateway, the crafted direct-egress re-emit probe completed without itself proving a WS-side leak, and Tor egress was restored after restart -- a bracketed, reversible stop. The zero-clearnet verdict for the Tor-down window is established by the Gateway-NIC canary (below)."
   fi

   ## Positive control: emit one deterministic known-good packet to a pinned guard (best-effort),
   ## so the canary's guard-packet floor has a controlled contributor, not only Tor's traffic.
   gw_positive_control
   ## Settle BEFORE powering off: a probe's packet may be in flight (WS -> GW -> wire) when the
   ## battery returns; let it egress + land in the trace first, so a late leak is not raced out of
   ## the capture window.
   sleep 5
   ## Capture the GW's consensus relay set NOW, while the GW is still up: the canary classifies
   ## egress against it but runs AFTER the poweroff below (needed to flush the nictrace pcap),
   ## when guestcontrol can no longer reach the GW. Fail-closed is the canary's empty-cache check.
   gw_relay_cache="$(mktemp)"
   gw_tor_relay_ips > "${gw_relay_cache}" 2>/dev/null || true
   ## Canary: stop the GW so its nictrace pcap is flushed, then assert NO probe target
   ## reached clearnet through it -- across every capture window.
   "${VBOXMANAGE}" controlvm "${gw}" poweroff >/dev/null 2>&1 || true
   sleep 3
   canary_gateway_pcap
   ## Story: the GW-NIC canary passed -- the external-NIC trace classified zero clearnet
   ## probe-target packets, with genuine Tor guard traffic + the deliberate positive-control
   ## packet both present (so the capture was not blind). Exact counts are on the canary line
   ## in the run log.
   story_card 80 gw-canary "Gateway-NIC canary (external-NIC pcap)" "The Gateway's external-NIC trace showed 0 probe-target clearnet packets across every capture window, while carrying genuine Tor guard traffic and the deliberate positive-control packet -- proof the capture was live, not blind, and that nothing egressed to clearnet via the Gateway."

   ## Story: the final leak verdict.
   story_card 90 leak-verdict "LEAK TEST PASS" "Workstation egresses ONLY via the Gateway's Tor: the full anon-leak-test battery was clean and the Gateway-NIC canary confirmed no clearnet probe-target egress."
   printf '%s\n' "${me}: PASS -- Workstation egresses ONLY via the Gateway's Tor (full battery + GW-trace canary)"
   return "${PASS_RC}"
}

## Sourced (dm-whonix-pair-tests) -> expose the functions without running; executed -> run.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
   main "$@"
fi
