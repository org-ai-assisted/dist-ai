#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Fetch each derivative-maker submodule's fork remote and bring its local 'ai'
## to the published fork tip -- the fetch + re-attach + fast-forward that dm-tidy
## steps 1-2 need and no existing tool does (dm-git-sync assumes submodules are
## already sitting on their published tips).
##
## Only ai-workflow submodules (those with a published '${FORK_REMOTE}/ai' tip)
## are touched. A submodule OFF 'ai' with no fork 'ai' is upstream-only (pinned to
## an upstream commit, no 'ai' work) and is LEFT EXACTLY AS FOUND.
##
## Also corrects a dangerous 'ai' UPSTREAM (parent + each submodule): an 'ai' that
## tracks a non-ai branch (e.g. master) is a trap -- a 'git pull' would merge that
## INTO 'ai'. It is repointed at the fork's 'ai' (or the upstream cleared). Config
## only; an unset upstream is benign and left alone.
##
## The fast-forward runs with signature verification disabled: the fork 'ai' tips
## are bot-published and unsigned, and advancing local 'ai' to our own published
## fork tip is a trusted ref-advance (the org account is the trust boundary; the
## pin points there regardless).
##
## HAPPY-PATH ONLY. Auto-handles the two states we actually hit:
##   - local 'ai' strictly BEHIND the fork tip  -> fast-forward.
##   - detached / off 'ai' (clean, has fork 'ai') -> re-attach to 'ai', then
##                                                  fast-forward if behind.
## Everything else STOPS and is surfaced for a human -- never auto-fixed, forced,
## reset, or published:
##   - dirty working tree (uncommitted / a sibling session's work)
##   - local 'ai' AHEAD of or DIVERGED from the fork tip (unpushed work)
##   - detached HEAD not contained in the fork tip (re-attach would orphan it)
##   - ON 'ai' but no fork remote / fetch fails / no fork 'ai' tip (anomaly)
##   - a checkout or fast-forward that fails
##   - a '.gitmodules' path that resolves outside -- or at -- the superproject
## A STOP makes the tool exit 1 so the caller halts before the pin/mirror steps;
## a human resolves the stopped submodules by hand. Do NOT extend this to
## auto-resolve those cases.
##
## NEVER 'git submodule update' / 'checkout --recurse-submodules': that detaches
## submodules off 'ai' -- the exact mess this undoes. Works per submodule via git -C.
##
## Usage: dm-submodule-ai-sync [--dir <derivative-maker checkout>] [--dry-run]
##   --dry-run  still FETCHES (the only way to classify accurately) but performs
##              no checkout, fast-forward, or branch creation.
##
## Exit: 0 all current/advanced | 1 one or more STOPped | 2 usage / not a checkout.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## An inherited git-location env var (e.g. from a 'git submodule foreach' parent)
## would redirect every 'git -C <sub>' -- repo, index, or object store -- at
## another repo, silently fast-forwarding the wrong tree or writing objects into
## the wrong store. Clear the whole set; this tool addresses each submodule by path.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
   GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR

## Hooks are deliberately NOT disabled here. The re-attach/create checkouts below judge
## success by 'git checkout' rc, and a 'post-checkout' hook exiting non-zero DOES propagate
## into that rc (git makes the hook's status the checkout's status) -- which would misread a
## completed checkout as a re-attach failure and STOP a submodule that is in fact on 'ai'.
## Not guarded on purpose: within scope (happy path / AI accident; no exotic-local-hooks
## defense) the effective hooks path has no such hook -- the supported environment's global
## core.hooksPath carries only commit/push gates and SHADOWS any per-repo post-checkout.
## Forcing core.hooksPath=/dev/null for a condition that does not occur would be over-design
## (and would itself trip the hooks-path guard). Revisit only if a post-checkout/post-merge
## hook ever becomes effective for these mechanical ref ops.

AI_BRANCH="ai"
## The published fork that carries 'ai' work and that CI fetches (git skill).
FORK_REMOTE="org-ai-assisted"
## Bot-writable fork MIRRORS that 'git push' fans 'ai' out to besides FORK_REMOTE
## (git skill: git-push resolves push targets by URL owner). Consulted ONLY to make
## the "no ${FORK_REMOTE}/ai tip" STOP truthful: an 'ai' that reached only a mirror
## IS published (just not on the CI remote), so the STOP must say "publish it to
## ${FORK_REMOTE}" -- never the false "never published", which reads as "this repo
## has no 'ai' at all" and is the exact confusion this avoids. Trusted set only (our
## own bot remotes), so a foreign remote's coincidental 'ai' is never mistaken for ours.
MIRROR_REMOTES=( "assisted-by-ai" "gitlab-adrelanos" )

source_dir=""
dry_run="false"

while [ "$#" -gt 0 ]; do
   case "$1" in
      --dir)
         [ "$#" -ge 2 ] || { printf '%s\n' "${0##*/}: --dir requires a value." >&2 ; exit 2 ; }
         ## Reject an EMPTY value (e.g. '--dir "$UNSET"'): distinct from omitting
         ## --dir (which defaults to cwd) -- silently acting on cwd would sync an
         ## unintended checkout with exit 0.
         [ -n "$2" ] || { printf '%s\n' "${0##*/}: --dir requires a non-empty value." >&2 ; exit 2 ; }
         source_dir="$2"
         shift 2
         ;;
      --dry-run)
         dry_run="true"
         shift
         ;;
      -h|--help)
         printf '%s\n' \
            "Fetch each derivative-maker submodule's ${FORK_REMOTE} remote and bring its" \
            "local '${AI_BRANCH}' to the published fork tip (fast-forward / re-attach only)." \
            "" \
            "Usage: ${0##*/} [--dir <derivative-maker checkout>] [--dry-run]" \
            "" \
            "  --dir      the derivative-maker checkout to operate on (default: cwd)" \
            "  --dry-run  fetch + classify + report; make no checkout / fast-forward" \
            "" \
            "Submodule fork fetches run bounded-parallel (default 4 concurrent; the cap bounds" \
            "peak memory). Override with DM_SUBMODULE_AI_SYNC_FETCH_JOBS=<n> (set 1 to serialize)." \
            "" \
            "Happy-path only: behind -> fast-forward, detached -> re-attach. Ahead/" \
            "diverged/dirty/unpublished/fetch-failure STOP and are surfaced for a human." \
            "" \
            "Exit: 0 all current/advanced | 1 one or more STOPped | 2 usage/not a checkout."
         exit 0
         ;;
      *)
         printf '%s\n' "${0##*/}: unknown argument: '$1'" >&2
         exit 2
         ;;
   esac
done

[ -n "${source_dir}" ] || source_dir="${PWD}"

log() {
   printf '%s\n' "${0##*/}: $*"
}

die() {
   local code="$1" ; shift
   printf '%s\n' "${0##*/}: $*" >&2
   exit "${code}"
}

is_dm_superproject() {
   [ -d "$1/build-steps.d" ] && [ -d "$1/help-steps" ]
}

## Correct a dangerous 'ai' upstream. Dangerous = 'ai' tracking anything OTHER than
## the fork's own 'ai': a NON-ai branch (e.g. master) is a trap (`git status` reports
## a misleading ai-vs-master divergence and a `git pull` would merge master's
## file-mirror commits straight INTO ai), and so is the fork's ai published by a
## DIFFERENT remote -- a `git pull` would then merge an UNTRUSTED remote's 'ai' into
## ours, defeating the org-account trust boundary this tool exists to hold. Both the
## tracked REMOTE and the tracked BRANCH must match the fork. 'ai' must track the
## fork's ai (set it there if that tip exists, else clear the upstream). An UNSET
## upstream is benign and left alone. Config-only.
ensure_ai_upstream() {
   local dir="$1" name="$2" ref remote merge fork_ai was
   ref="$( git -C "${dir}" symbolic-ref --quiet HEAD 2>/dev/null || true )"
   [ "${ref}" = "refs/heads/${AI_BRANCH}" ] || return 0
   remote="$( git -C "${dir}" config "branch.${AI_BRANCH}.remote" 2>/dev/null || true )"
   merge="$( git -C "${dir}" config "branch.${AI_BRANCH}.merge" 2>/dev/null || true )"
   ## No upstream at all is benign.
   [ -n "${remote}" ] || [ -n "${merge}" ] || return 0
   ## Already correct: tracks the fork's own 'ai'.
   [ "${remote}" = "${FORK_REMOTE}" ] && [ "${merge}" = "refs/heads/${AI_BRANCH}" ] \
      && return 0
   was="${remote:-<none>}/${merge#refs/heads/}"
   fork_ai="$( git -C "${dir}" rev-parse --verify --quiet "refs/remotes/${FORK_REMOTE}/${AI_BRANCH}" 2>/dev/null || true )"
   if [ "${dry_run}" = "true" ]; then
      log "[dry-run] ${name}: would correct '${AI_BRANCH}' upstream (tracks '${was}')"
   elif [ -n "${fork_ai}" ]; then
      git -C "${dir}" branch --set-upstream-to="${FORK_REMOTE}/${AI_BRANCH}" "${AI_BRANCH}" >/dev/null 2>&1 || return 0
   else
      git -C "${dir}" branch --unset-upstream "${AI_BRANCH}" >/dev/null 2>&1 || return 0
   fi
   upstream_fixed+=( "${name} (was tracking '${was}')" )
}

top="$( git -C "${source_dir}" rev-parse --show-toplevel 2>/dev/null || true )"
[ -n "${top}" ] || die 2 "'${source_dir}' is not inside a git worktree."
is_dm_superproject "${top}" \
   || die 2 "'${top}' is not a derivative-maker checkout (no build-steps.d + help-steps)."

## Direct submodule paths from .gitmodules (relative to the superproject root).
## Read the config, NOT 'git submodule foreach': foreach aborts at the first
## broken/absent submodule and hides every one after it. Uninitialised paths are
## filtered per-iteration below.
## '-z': NUL-separated records, each "<key>\n<value>"; take the value. A lone 'sed'
## split on the first space garbles any submodule whose name/path contains whitespace.
sub_paths=()
while IFS= read -r -d '' record; do
   path="${record#*$'\n'}"
   [ -n "${path}" ] && sub_paths+=( "${path}" )
done < <( git -C "${top}" config -z --file "${top}/.gitmodules" \
   --get-regexp '^submodule\..*\.path$' 2>/dev/null )

[ "${#sub_paths[@]}" -gt 0 ] || die 2 "'${top}' has no submodules in .gitmodules."

## Result buckets. 'stopped' entries are "path :: reason".
advanced=()
reattached=()
current=()
uninit=()
skipped_upstream=()
upstream_fixed=()
stopped=()
## Paths the tool actually MUTATED (real, non-dry): re-verified clean + on 'ai' at
## the end, so a mutation that left an unexpected state is caught, not reported OK.
mutated_paths=()

## The superproject's OWN 'ai' upstream (the case the operator hit: parent 'ai'
## tracking org-ai-assisted/master). Fetch the parent fork 'ai' first so the
## set-vs-clear decision reads a fresh remote-tracking ref (best-effort).
git -C "${top}" fetch --quiet "${FORK_REMOTE}" "${AI_BRANCH}" 2>/dev/null || true
ensure_ai_upstream "${top}" "(parent)"

top_real="$( realpath -m -- "${top}" )"

## The bounded-parallel pre-fetch below uses 'wait -n -p' (reap a SPECIFIC finished job), which
## needs bash >= 5.1. Assert it loudly: on older bash '-p' is an invalid option that fails WITHOUT
## setting the pid, so the running-counter is never decremented and the concurrency cap is lost
## (unbounded fetches -- the exact OOM this guards against). The supported OS (trixie) ships 5.2.
if [ "${BASH_VERSINFO[0]}" -lt 5 ] \
   || { [ "${BASH_VERSINFO[0]}" -eq 5 ] && [ "${BASH_VERSINFO[1]}" -lt 1 ]; }; then
   die 2 "bash >= 5.1 required for the bounded-parallel fetch (found ${BASH_VERSINFO[0]}.${BASH_VERSINFO[1]})"
fi

## --- Bounded-parallel pre-fetch ------------------------------------------------
## The per-submodule fork fetch is the slow part -- a network round-trip each -- so run them
## CONCURRENTLY, capped, instead of one-at-a-time in the loop below (a ~30-submodule sync was ~30
## serial round-trips). The CAP is the safe bounded default the operator used to hand-set: it
## bounds PEAK MEMORY to a handful of concurrent fetches (not all at once), so no external
## MemoryMax scope is needed; DM_SUBMODULE_AI_SYNC_FETCH_JOBS overrides it. Classification +
## fast-forward in the loop stays SERIAL (local, fast). Each fetch targets a DISTINCT submodule
## repo, so concurrent fetches never contend. Results are recorded per path in 'prefetch_rc'; the
## loop consumes them instead of fetching inline (falling back to an inline fetch only if a path
## was somehow not pre-fetched). Runs in --dry-run too (fetch is the only way to classify).
fetch_jobs="${DM_SUBMODULE_AI_SYNC_FETCH_JOBS:-4}"
case "${fetch_jobs}" in
   '' | *[!0-9]* | 0 )
      fetch_jobs=4
      ;;
esac
declare -A prefetch_rc=()
prefetch_paths=()
for path in "${sub_paths[@]}"; do
   [ -n "${path}" ] || continue
   sub="${top}/${path}"
   ## CONTAINMENT FIRST -- identical to the loop's check below, and it MUST precede any fetch here:
   ## a crafted '.gitmodules' path ('..', '.', a symlink) that escapes or equals the superproject
   ## would otherwise have its fork remote fetched (contacting a repo-controlled URL, pruning the
   ## wrong repo's refs) before the loop ever rejects it. realpath -m resolves symlinks too. Skip
   ## (not STOP) here; the loop surfaces the STOP with the right reason.
   sub_real="$( realpath -m -- "${sub}" )"
   [ "${sub_real}" = "${top_real}" ] && continue
   case "${sub_real}/" in
      "${top_real}"/* )
         ;;
      * )
         continue
         ;;
   esac
   ## Only initialized, readable submodules that actually have the fork remote -- the exact set the
   ## loop fetches. (Uninitialised / unreadable / no-fork-remote submodules are handled in the loop
   ## before any fetch, so pre-fetching them would be wasted or wrong.)
   { [ -d "${sub}/.git" ] || [ -f "${sub}/.git" ]; } || continue
   git -C "${sub}" rev-parse --git-dir >/dev/null 2>&1 || continue
   git -C "${sub}" remote get-url -- "${FORK_REMOTE}" &>/dev/null || continue
   prefetch_paths+=( "${path}" )
done
declare -A prefetch_pid=()
prefetch_running=0
for path in "${prefetch_paths[@]}"; do
   ## Same fetch the loop would run (quiet, prune -- prune is load-bearing: a deleted fork 'ai'
   ## must not leave a stale remote-tracking ref). errexit is kept off this background job via the
   ## reap below; a failure is recorded as its rc, handled by the loop.
   git -C "${top}/${path}" fetch --quiet --prune "${FORK_REMOTE}" 2>/dev/null &
   prefetch_pid["$!"]="${path}"
   prefetch_running=$(( prefetch_running + 1 ))
   if [ "${prefetch_running}" -ge "${fetch_jobs}" ]; then
      reaped_pid=""
      reaped_rc=0
      wait -n -p reaped_pid || reaped_rc=$?
      if [ -n "${reaped_pid}" ]; then
         prefetch_rc["${prefetch_pid[${reaped_pid}]}"]="${reaped_rc}"
         unset "prefetch_pid[${reaped_pid}]"
         prefetch_running=$(( prefetch_running - 1 ))
      fi
   fi
done
## Drain the remaining in-flight fetches.
for reaped_pid in "${!prefetch_pid[@]}"; do
   reaped_rc=0
   wait "${reaped_pid}" || reaped_rc=$?
   prefetch_rc["${prefetch_pid[${reaped_pid}]}"]="${reaped_rc}"
done

for path in "${sub_paths[@]}"; do
   [ -n "${path}" ] || continue
   sub="${top}/${path}"

   ## Containment: a '.gitmodules' path is trusted content, but a stray '..' or '.'
   ## (a bad edit, or a crafted entry) would point 'sub' outside -- or AT -- the
   ## superproject and mutate the wrong repo. Require a PROPER descendant of 'top':
   ## reject both a path that escapes 'top' and one that resolves to 'top' itself
   ## (e.g. '.', 'help-steps/..').
   sub_real="$( realpath -m -- "${sub}" )"
   if [ "${sub_real}" = "${top_real}" ]; then
      stopped+=( "${path} :: resolves to the superproject itself, not a submodule" )
      continue
   fi
   case "${sub_real}/" in
      "${top_real}"/*)
         ;;
      *)
         stopped+=( "${path} :: resolves outside the superproject ('${sub_real}')" )
         continue
         ;;
   esac

   ## Uninitialised submodule: nothing to sync. Not a STOP (it gets no pin bump
   ## either); note it and move on.
   if [ ! -d "${sub}/.git" ] && [ ! -f "${sub}/.git" ]; then
      uninit+=( "${path}" )
      continue
   fi

   ## Readability probe: a '.git' that exists but points at a missing/broken gitdir
   ## makes every later 'git -C' fail -- and a swallowed 'symbolic-ref' failure
   ## would then read as "not on ai" and be mis-skipped. A genuinely uninitialised
   ## submodule is already filtered above, so an unreadable one here is an anomaly.
   if ! git -C "${sub}" rev-parse --git-dir >/dev/null 2>&1; then
      stopped+=( "${path} :: unreadable submodule gitdir (broken .git)" )
      continue
   fi

   ## Branch state (no network). This is an ai-workflow submodule if it is ON 'ai'
   ## OR has a local 'ai' branch (detached off 'ai' is the normal post-'submodule
   ## update' shape this tool re-attaches). If NEITHER, it is upstream-only (pinned
   ## to an upstream commit, no 'ai' work): a "no ai here" condition (no fork remote
   ## / fetch fails / no fork 'ai' tip) means leave it exactly as found. On an
   ## ai-workflow submodule the same condition is an anomaly to surface.
   ref="$( git -C "${sub}" symbolic-ref --quiet HEAD 2>/dev/null || true )"
   on_ai="false"
   [ "${ref}" = "refs/heads/${AI_BRANCH}" ] && on_ai="true"
   have_ai="false"
   git -C "${sub}" show-ref --verify --quiet "refs/heads/${AI_BRANCH}" && have_ai="true"
   is_ai_workflow="false"
   { [ "${on_ai}" = "true" ] || [ "${have_ai}" = "true" ]; } && is_ai_workflow="true"

   if ! git -C "${sub}" remote get-url -- "${FORK_REMOTE}" &>/dev/null; then
      if [ "${is_ai_workflow}" = "true" ]; then
         stopped+=( "${path} :: ai-workflow submodule but no '${FORK_REMOTE}' remote" )
      else
         skipped_upstream+=( "${path}" )
      fi
      continue
   fi

   ## Fetch result from the bounded-parallel pre-fetch above (also populated in --dry-run: fetch is
   ## the only way to classify accurately). Fetch only, never 'submodule update'. '--prune' there
   ## is load-bearing: without it a deleted fork 'ai' leaves a stale
   ## refs/remotes/${FORK_REMOTE}/${AI_BRANCH} and the missing-tip check below would treat the
   ## unpublished branch as published against an obsolete tip. Fall back to an inline fetch only if
   ## this path was somehow not pre-fetched (defensive -- the pre-fetch set is the same one this
   ## line is reached for). Fetch-failure handling (STOP for ai-workflow, skip otherwise) unchanged.
   fetch_rc=0
   ## Subscript quoted: a submodule path is trusted .gitmodules content but may contain characters
   ## (']', spaces) that an UNquoted associative-array subscript would misparse under nounset.
   if [ -n "${prefetch_rc["${path}"]+set}" ]; then
      fetch_rc="${prefetch_rc["${path}"]}"
   else
      git -C "${sub}" fetch --quiet --prune "${FORK_REMOTE}" 2>/dev/null || fetch_rc=$?
   fi
   if [ "${fetch_rc}" -ne 0 ]; then
      if [ "${is_ai_workflow}" = "true" ]; then
         stopped+=( "${path} :: ai-workflow submodule but fetch from '${FORK_REMOTE}' failed" )
      else
         skipped_upstream+=( "${path}" )
      fi
      continue
   fi

   ## Correct a dangerous 'ai' upstream (tracking master) if present. AFTER the
   ## fetch: only now is 'refs/remotes/${FORK_REMOTE}/${AI_BRANCH}' fresh, so the
   ## set-vs-clear decision is correct (pre-fetch it would clear when it should set).
   ensure_ai_upstream "${sub}" "${path}"

   fork_tip="$( git -C "${sub}" rev-parse --verify --quiet "refs/remotes/${FORK_REMOTE}/${AI_BRANCH}" 2>/dev/null || true )"
   if [ -z "${fork_tip}" ]; then
      if [ "${is_ai_workflow}" = "true" ]; then
         ## FORK_REMOTE/ai (the CI remote) is absent. But 'ai' may already be
         ## published on a bot MIRROR -- git-push fans 'ai' out to all of them, and a
         ## repo whose 'ai' reached only a mirror reads as unpublished HERE though it
         ## is not. ls-remote the trusted mirrors (STOP path only, so the network cost
         ## is rare) to make the STOP truthful and actionable ("publish it to
         ## FORK_REMOTE") instead of the false "never published".
         mirror_hit=""
         mirror_probe_failed=""
         for mirror in "${MIRROR_REMOTES[@]}"; do
            git -C "${sub}" remote get-url -- "${mirror}" &>/dev/null || continue
            ## Distinguish a reachable-but-absent mirror (ls-remote exit 0, no ref ->
            ## real evidence 'ai' is not on it) from a probe FAILURE (unreachable /
            ## timed out, non-zero -> NO evidence, must never read as "never
            ## published"). The if-condition captures ls-remote's OWN status (no pipe
            ## to mask it, and it is exempt from errexit); awk runs only on success.
            ## 'timeout' still bounds the probe: these mirrors are backups that may be
            ## down/firewalled, and a bare ls-remote would block the single-threaded
            ## loop on the TCP/SSH connect for minutes.
            if mtip="$( timeout --kill-after=30 30 git -C "${sub}" ls-remote --heads -- "${mirror}" "${AI_BRANCH}" 2>/dev/null )"; then
               mtip="$( printf '%s\n' "${mtip}" | awk 'NR==1 { print $1 }' )"
               [ -n "${mtip}" ] && mirror_hit="${mirror_hit} ${mirror}(${mtip:0:12})"
            else
               mirror_probe_failed="${mirror_probe_failed} ${mirror}"
            fi
         done
         if [ -n "${mirror_hit}" ]; then
            ## Remediation checks out 'ai' FIRST: is_ai_workflow is true even when HEAD
            ## is detached or on another branch (a local 'ai' merely exists), and
            ## 'git-push' pushes the CURRENTLY checked-out branch -- so a bare
            ## 'git-push' here could publish 'master' (or abort on a detached HEAD)
            ## instead of 'ai'. Checking out 'ai' first makes the hint always publish 'ai'.
            stopped+=( "${path} :: '${AI_BRANCH}' is published on mirror(s)${mirror_hit} but NOT on '${FORK_REMOTE}' (the CI remote); publish it: 'git -C ${path} checkout ${AI_BRANCH} && git-push --repo ${path}', then re-run" )
         elif [ -n "${mirror_probe_failed}" ]; then
            ## No FORK_REMOTE tip AND every mirror probe FAILED (unreachable): we could
            ## not confirm whether 'ai' exists. Say so -- never the false "never
            ## published", which the probe did not establish.
            stopped+=( "${path} :: ai-workflow submodule but '${FORK_REMOTE}/${AI_BRANCH}' has no tip; could NOT confirm on mirror(s) (mirror probe failed:${mirror_probe_failed}) -- may be published there but unreachable; re-run when reachable, or publish: 'git -C ${path} checkout ${AI_BRANCH} && git-push --repo ${path}'" )
         else
            stopped+=( "${path} :: ai-workflow submodule but '${FORK_REMOTE}/${AI_BRANCH}' has no tip ('${AI_BRANCH}' never published)" )
         fi
      else
         skipped_upstream+=( "${path}" )
      fi
      continue
   fi

   ## Dirty check BEFORE any mutation. A FAILED 'git status' yields empty stdout;
   ## a failure is NOT clean -- STOP rather than act on a repo we could not read.
   ## '--untracked-files=no' is DELIBERATE: an untracked file is non-destructive to
   ## the only mutations here (a FF or a re-attach never deletes untracked files),
   ## and git itself refuses a checkout/FF that WOULD overwrite one -- that collision
   ## is caught and surfaced downstream as its own STOP. Counting untracked here
   ## would instead STOP on every benign stray file (editor scratch, a build artifact
   ## a sibling left) and block every re-run, for no safety gain.
   ## '--ignore-submodules=all': a NESTED submodule pin diff (' M nested', normal
   ## after a non-recursive FF) is not dirt this tool cares about -- flagging it
   ## would falsely STOP and, worse, block every re-run.
   if ! sub_status="$( git -C "${sub}" status --porcelain --untracked-files=no --ignore-submodules=all 2>/dev/null )"; then
      stopped+=( "${path} :: 'git status' failed (unreadable repo)" )
      continue
   fi
   if [ -n "${sub_status}" ]; then
      stopped+=( "${path} :: dirty working tree (uncommitted / sibling work)" )
      continue
   fi

   ## Detached HEAD: re-attaching to 'ai' would orphan any commit not already
   ## contained in the fork tip. Refuse unless the detached commit is an ancestor
   ## of the fork tip (then re-attach + fast-forward loses nothing). An on-another-
   ## branch HEAD is safe -- that branch ref persists after checkout.
   if [ -z "${ref}" ]; then
      head_sha="$( git -C "${sub}" rev-parse --verify HEAD 2>/dev/null || true )"
      if [ -n "${head_sha}" ] \
         && ! git -C "${sub}" merge-base --is-ancestor "${head_sha}" "${fork_tip}" 2>/dev/null; then
         stopped+=( "${path} :: detached HEAD ${head_sha:0:12} not contained in ${FORK_REMOTE}/${AI_BRANCH} (unpushed work)" )
         continue
      fi
   fi

   ## No local 'ai' at all (and not on it): create it at the fork tip. A detached
   ## HEAD reaching here is an ancestor of the fork tip, so nothing is orphaned.
   if [ "${have_ai}" = "false" ]; then
      if [ "${dry_run}" = "true" ]; then
         log "[dry-run] ${path}: would create '${AI_BRANCH}' at ${FORK_REMOTE}/${AI_BRANCH} (${fork_tip:0:12})"
      elif ! git -C "${sub}" checkout --quiet -b "${AI_BRANCH}" "${fork_tip}"; then
         stopped+=( "${path} :: could not create '${AI_BRANCH}' at the fork tip" )
         continue
      fi
      [ "${dry_run}" = "true" ] || mutated_paths+=( "${path}" )
      reattached+=( "${path} (created '${AI_BRANCH}' at tip)" )
      continue
   fi

   local_ai="$( git -C "${sub}" rev-parse --verify "refs/heads/${AI_BRANCH}" 2>/dev/null || true )"
   if [ -z "${local_ai}" ]; then
      stopped+=( "${path} :: cannot resolve local '${AI_BRANCH}'" )
      continue
   fi

   ## Classify local 'ai' against the fork tip.
   if [ "${local_ai}" = "${fork_tip}" ]; then
      ## Already at the tip. Re-attach if detached; otherwise a no-op.
      if [ "${on_ai}" = "true" ]; then
         current+=( "${path}" )
      elif [ "${dry_run}" = "true" ]; then
         log "[dry-run] ${path}: would re-attach to '${AI_BRANCH}' (already at tip)"
         reattached+=( "${path} (already at tip)" )
      elif git -C "${sub}" checkout --quiet "${AI_BRANCH}"; then
         mutated_paths+=( "${path}" )
         reattached+=( "${path} (already at tip)" )
      else
         stopped+=( "${path} :: could not re-attach to '${AI_BRANCH}'" )
      fi
      continue
   fi

   if git -C "${sub}" merge-base --is-ancestor "${local_ai}" "${fork_tip}" 2>/dev/null; then
      ## Strictly BEHIND -> fast-forward (re-attaching first if detached). Guard
      ## the mutations: a failure (e.g. an untracked file the incoming commit also
      ## adds) becomes a STOP for this submodule, never an errexit crash that
      ## abandons the rest of the loop with no summary.
      if [ "${dry_run}" = "true" ]; then
         if [ "${on_ai}" = "true" ]; then
            log "[dry-run] ${path}: would fast-forward '${AI_BRANCH}' ${local_ai:0:12} -> ${fork_tip:0:12}"
         else
            log "[dry-run] ${path}: would re-attach '${AI_BRANCH}' + fast-forward ${local_ai:0:12} -> ${fork_tip:0:12}"
         fi
      else
         ## Capture HEAD before re-attaching so a later FF failure can restore it
         ## EXACTLY as found (a STOP must not surprise the human resolving it): the
         ## symbolic ref if HEAD was on a named branch, else the detached commit.
         pre_head=""
         pre_ref=""
         if [ "${on_ai}" != "true" ]; then
            pre_ref="$( git -C "${sub}" symbolic-ref --quiet HEAD 2>/dev/null || true )"
            pre_head="$( git -C "${sub}" rev-parse HEAD 2>/dev/null || true )"
            if ! git -C "${sub}" checkout --quiet "${AI_BRANCH}"; then
               stopped+=( "${path} :: could not re-attach to '${AI_BRANCH}' before fast-forward" )
               continue
            fi
         fi
         ## Disable signature verification for the fast-forward: the fork 'ai' tips
         ## are bot-published and unsigned, and the operator's global
         ## merge.verifySignatures=true would otherwise reject every FF. Advancing
         ## local 'ai' to our own published fork tip is a trusted ref-advance (the
         ## org account is the trust boundary; the pin points there regardless).
         if ! git -C "${sub}" -c merge.verifySignatures=false merge --quiet --ff-only "${fork_tip}"; then
            ## Re-attached but the FF failed -> roll back to the ORIGINAL state so
            ## nothing changed on this STOP: the named branch if it was on one,
            ## else the detached commit (never leave a formerly-attached sub detached).
            if [ -n "${pre_ref}" ]; then
               git -C "${sub}" checkout --quiet "${pre_ref#refs/heads/}" 2>/dev/null || true
            elif [ -n "${pre_head}" ]; then
               git -C "${sub}" checkout --quiet --detach "${pre_head}" 2>/dev/null || true
            fi
            stopped+=( "${path} :: fast-forward to ${FORK_REMOTE}/${AI_BRANCH} failed (untracked-file collision or unreadable object)" )
            continue
         fi
      fi
      [ "${dry_run}" = "true" ] || mutated_paths+=( "${path}" )
      if [ "${on_ai}" = "true" ]; then
         advanced+=( "${path} (${local_ai:0:12} -> ${fork_tip:0:12})" )
      else
         advanced+=( "${path} (re-attached + ${local_ai:0:12} -> ${fork_tip:0:12})" )
      fi
      continue
   fi

   ## Ahead of or diverged from the fork tip: unpushed work. STOP.
   stopped+=( "${path} :: local '${AI_BRANCH}' ${local_ai:0:12} ahead of / diverged from ${FORK_REMOTE}/${AI_BRANCH} ${fork_tip:0:12} (unpushed work)" )
done

## End invariant: every submodule we actually MUTATED must now be on 'ai' and
## tracked-clean. A fast-forward / checkout cannot normally leave tracked changes,
## so a failure here means something went wrong -- surface it as a STOP instead of
## reporting success. 'git status' exit is checked (a failure is not "clean"), and
## non-empty output = unexpected dirt.
for path in "${mutated_paths[@]}"; do
   sub="${top}/${path}"
   post_ref="$( git -C "${sub}" symbolic-ref --quiet HEAD 2>/dev/null || true )"
   if [ "${post_ref}" != "refs/heads/${AI_BRANCH}" ]; then
      stopped+=( "${path} :: after sync, not on '${AI_BRANCH}' (got '${post_ref:-DETACHED}')" )
      continue
   fi
   if ! post_status="$( git -C "${sub}" status --porcelain=v1 --untracked-files=no --ignore-submodules=all 2>/dev/null )" \
      || [ -n "${post_status}" ]; then
      stopped+=( "${path} :: after sync, working tree unexpectedly not clean" )
   fi
done

## --- Summary --------------------------------------------------------------------
print_bucket() {
   local title="$1" ; shift
   [ "$#" -gt 0 ] || return 0
   printf '%s (%d):\n' "${title}" "$#"
   printf '   %s\n' "$@"
}

## Dry-run must never read like completed work: the action buckets become
## "would ..." and the closing line says nothing was changed.
if [ "${dry_run}" = "true" ]; then
   mode_label="dry-run against"
   adv_title="would advance"
   reatt_title="would re-attach"
   up_title="would correct ai upstream"
else
   mode_label="against"
   adv_title="advanced"
   reatt_title="re-attached"
   up_title="ai upstream corrected"
fi
printf '%s\n' "${0##*/}: submodule '${AI_BRANCH}' sync summary (${mode_label} ${FORK_REMOTE}/${AI_BRANCH}):"
print_bucket "${adv_title}"   "${advanced[@]}"
print_bucket "${reatt_title}" "${reattached[@]}"
print_bucket "already current" "${current[@]}"
print_bucket "${up_title}" "${upstream_fixed[@]}"
print_bucket "uninitialised (skipped)" "${uninit[@]}"
## Upstream-only submodules (no 'ai' workflow) are non-actionable; a count keeps
## the summary scannable.
[ "${#skipped_upstream[@]}" -eq 0 ] || printf 'upstream-only, left alone (%d)\n' "${#skipped_upstream[@]}"

if [ "${#stopped[@]}" -gt 0 ]; then
   printf '\n%s\n' "STOPPED -- resolve by hand, then re-run:" >&2
   printf '   %s\n' "${stopped[@]}" >&2
   die 1 "${#stopped[@]} submodule(s) STOPPED; not safe to pin/mirror until resolved."
fi

if [ "${dry_run}" = "true" ]; then
   log "dry-run complete; no changes made."
else
   log "every ai-workflow submodule is on '${AI_BRANCH}' at the published fork tip."
fi
exit 0
