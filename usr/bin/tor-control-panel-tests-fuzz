#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Randomized fuzz run of tor-control-panel's untrusted-input logic in
## tor_control_panel_lib (torrc parsing, config normalisation, bridge-line
## prefix conversion, default-port lookup). See fuzz_torrc.py for the properties
## checked. Override the sweep length with --iterations N and reproduce a
## failure with --seed N. The tor_control_panel package under test is resolved
## by tcp_testlib (TCP_REPO=<checkout> else the installed package).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## tcp_testlib brings up an offscreen QApplication (PyQt6); the offscreen
## platform plugin lets it import without an X server or display.
export QT_QPA_PLATFORM="offscreen"

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/tor-control-panel-tests" ]; then
   tests_dir="${script_dir}/../share/tor-control-panel-tests"
else
   tests_dir='/usr/share/tor-control-panel-tests'
fi

iterations='30000'

rc=0
## style-ok: allow-python-interpreter -- run through PATH python3 for venv/user-site test deps
python3 -- "${tests_dir}/fuzz_torrc.py" --iterations "${iterations}" "$@" || rc=$?
exit "${rc}"
