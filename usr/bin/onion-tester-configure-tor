#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Append CI torrc directives and restart tor@default.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

if [ "${CI:-}" != "true" ] && [ "${ALLOW_LOCAL:-}" != "true" ]; then
   printf '%s\n' \
      "${BASH_SOURCE[0]}: refusing to run outside CI. Set ALLOW_LOCAL=true to override." >&2
   exit 1
fi

## Overridable so the regression suite drives the REAL script offline -- no sudo, no
## systemd, no tor: the torrc path, the privilege prefix for the torrc ops, the tor
## restart, and the serialization lock. Unset -> production (sudo, /etc/tor/torrc,
## systemctl restart tor@default, /run/lock).
torrc="${ONION_TESTER_TORRC:-/etc/tor/torrc}"
# shellcheck disable=SC2206  ## intentional word-split of an optional multi-word priv prefix; empty -> none
priv=( ${ONION_TESTER_PRIV_CMD-sudo} )
restart_bin="${ONION_TESTER_TOR_RESTART_BIN:-}"
lock_file="${ONION_TESTER_CONFIGURE_LOCK:-/run/lock/onion-tester-configure-tor.lock}"

restart_tor() {
   if [ -n "${restart_bin}" ]; then
      "${restart_bin}"
   else
      "${priv[@]}" systemctl restart tor@default
   fi
}

main() {
   ## ControlPort + CookieAuth* are load-bearing: sdwdate's timesanitycheck uses
   ## stem.connection.connect(); without a reachable control connection every
   ## probed URL falls back to REACHABLE-but-INVALID. Cookie group-readable +
   ## chmod o+r in onion-tester-wait-bootstrap make it usable by the
   ## non-debian-tor runner. Log notice file is read by that script's grep.
   ##
   ## Idempotent + concurrency-safe. Key the skip on the load-bearing
   ## `ControlPort 9051` directive, NOT the marker comment: a torrc that kept the
   ## marker but lost ControlPort (a hand edit) must RE-heal, not read as already
   ## configured and then restart tor without the port. A re-append is safe -- tor
   ## accepts repeated directives (it does NOT refuse to start on a duplicate
   ## ControlPort). The flock serializes two overlapping runs (the onion-tester-run
   ## self-heal racing an operator re-run) so the grep-check and the append cannot
   ## interleave into a doubled block.
   local lock_fd
   exec {lock_fd}>"${lock_file}" \
      || { printf '%s\n' "onion-tester-configure-tor: cannot open lock ${lock_file}" >&2; exit 1; }
   flock --timeout 60 "${lock_fd}" \
      || { printf '%s\n' "onion-tester-configure-tor: another run holds ${lock_file} (waited 60s)" >&2; exit 1; }

   if "${priv[@]}" grep --quiet --extended-regexp -- \
      '^[[:space:]]*ControlPort[[:space:]]+9051([[:space:]]|$)' "${torrc}" 2>/dev/null; then
      printf '%s\n' "torrc already has ControlPort 9051; not appending again"
   else
      "${priv[@]}" tee --append "${torrc}" > /dev/null <<'TORRC_EOF'

## Added by local-onion-tester.yml
ControlPort 9051
CookieAuthentication 1
CookieAuthFileGroupReadable 1
Log notice file /var/log/tor/notice.log
## Entry guards are a per-run single point of failure here: a cold CI client
## picks its guards once, and NEWNYM gives new circuits but keeps the SAME
## guard, so one slow guard degrades every attempt in the run alike. This is a
## reachability probe of public services from a throwaway runner, with no
## anonymity property to protect, so pin nothing and let each circuit pick a
## fresh entry.
UseEntryGuards 0
TORRC_EOF
      printf '%s\n' "torrc appended"
   fi
   ## Always (re)start: the preflight calls this precisely when the control port
   ## is unreachable, which a restart heals whether torrc was just written or a
   ## prior tor died.
   restart_tor
   printf '%s\n' "tor@default restarted"
}

main "${@}"
