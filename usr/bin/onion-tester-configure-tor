#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Append CI torrc directives and restart tor@default.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

if [ "${CI:-}" != "true" ] && [ "${ALLOW_LOCAL:-}" != "true" ]; then
   printf '%s\n' \
      "${BASH_SOURCE[0]}: refusing to run outside CI. Set ALLOW_LOCAL=true to override." >&2
   exit 1
fi

## Overridable so the regression suite drives the REAL script offline -- no sudo, no
## systemd, no tor: the torrc path, the privilege prefix for the torrc ops, the tor
## restart, and the serialization lock. Unset -> production (sudo, /etc/tor/torrc,
## systemctl restart tor@default, /run/lock).
torrc="${ONION_TESTER_TORRC:-/etc/tor/torrc}"
# shellcheck disable=SC2206  ## intentional word-split of an optional multi-word priv prefix; empty -> none
priv=( ${ONION_TESTER_PRIV_CMD-sudo} )
restart_bin="${ONION_TESTER_TOR_RESTART_BIN:-}"
lock_file="${ONION_TESTER_CONFIGURE_LOCK:-/run/lock/onion-tester-configure-tor.lock}"

## grep a load-bearing directive (uncommented, exact value) in the torrc. A missing
## torrc greps as absent (not an error). Returns 0 when present.
torrc_has() { ## $1 = extended regex
   "${priv[@]}" grep --quiet --extended-regexp -- "$1" "${torrc}" 2>/dev/null
}

restart_tor() {
   if [ -n "${restart_bin}" ]; then
      "${restart_bin}"
   else
      "${priv[@]}" systemctl restart tor@default
   fi
}

main() {
   ## ControlPort + CookieAuth* are load-bearing: sdwdate's timesanitycheck uses
   ## stem.connection.connect(), which AUTHENTICATES via the cookie file; without
   ## the cookie directives every probed URL falls back to REACHABLE-but-INVALID.
   ## Cookie group-readable + chmod o+r in onion-tester-wait-bootstrap make the
   ## cookie usable by the non-debian-tor runner. Log notice file is read by that
   ## script's grep.
   ##
   ## Idempotent, concurrency-safe, and it NEVER writes a second `ControlPort 9051`:
   ## tor PARSES a duplicate ControlPort but FAILS the runtime bind ("Address already
   ## in use") and does not start (verified, tor 0.4.9), so a restart after a naive
   ## re-append would leave the port DOWN. Skip only when ALL load-bearing directives
   ## are already present; otherwise append the block, emitting `ControlPort 9051`
   ## ONLY when it is absent (a repeated cookie/log line is harmless -- tor takes the
   ## last). This heals both a torrc that lost ControlPort (marker kept) and one that
   ## has ControlPort but no cookie auth. The flock serializes an overlapping
   ## self-heal + operator re-run (each would otherwise add its own ControlPort); the
   ## lock is opened append-only (no O_TRUNC) so a symlink planted at the lock path in
   ## world-writable /run/lock cannot truncate its target.
   local lock_fd
   exec {lock_fd}>>"${lock_file}" \
      || { printf '%s\n' "onion-tester-configure-tor: cannot open lock ${lock_file}" >&2; exit 1; }
   flock --timeout 60 "${lock_fd}" \
      || { printf '%s\n' "onion-tester-configure-tor: another run holds ${lock_file} (waited 60s)" >&2; exit 1; }

   local have_controlport=0
   if torrc_has '^[[:space:]]*ControlPort[[:space:]]+9051([[:space:]]|$)'; then
      have_controlport=1
   fi
   if [ "${have_controlport}" = 1 ] \
      && torrc_has '^[[:space:]]*CookieAuthentication[[:space:]]+1([[:space:]]|$)' \
      && torrc_has '^[[:space:]]*CookieAuthFileGroupReadable[[:space:]]+1([[:space:]]|$)'; then
      printf '%s\n' "torrc already has the onion-tester control + cookie directives; not appending again"
   else
      {
         printf '%s\n' '' '## Added by local-onion-tester.yml'
         ## Emit ControlPort only when absent -- a duplicate breaks tor's bind.
         if [ "${have_controlport}" = 0 ]; then
            printf '%s\n' 'ControlPort 9051'
         fi
         cat <<'TORRC_EOF'
CookieAuthentication 1
CookieAuthFileGroupReadable 1
Log notice file /var/log/tor/notice.log
## Entry guards are a per-run single point of failure here: a cold CI client
## picks its guards once, and NEWNYM gives new circuits but keeps the SAME
## guard, so one slow guard degrades every attempt in the run alike. This is a
## reachability probe of public services from a throwaway runner, with no
## anonymity property to protect, so pin nothing and let each circuit pick a
## fresh entry.
UseEntryGuards 0
TORRC_EOF
      } | "${priv[@]}" tee --append "${torrc}" > /dev/null
      printf '%s\n' "torrc onion-tester directives appended"
   fi
   ## Always (re)start: the preflight calls this precisely when the control port
   ## is unreachable, which a restart heals whether torrc was just written or a
   ## prior tor died.
   restart_tor
   printf '%s\n' "tor@default restarted"
}

main "${@}"
