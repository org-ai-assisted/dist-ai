#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Read one file out of a VirtualBox disk image on the HOST, read-only, without
## booting the VM. Optionally unlocks a single LUKS volume on the disk (the harness
## already holds the install passphrase). Handles a plain filesystem or an LVM
## layout inside LUKS by probing the candidate filesystems for the requested path.
##
## Reusable host-side inspection tool: e.g. dm-calamares-install --mok-enroll lifts
## the installed system's /var/lib/dkms/mok.pub for host-side 'VBoxManage modifynvram
## enrollmok', and it is equally useful to pull any file out of an installed image
## for debugging.
##
## Non-destructive: qemu-nbd, the LUKS mapping, and every mount are READ-ONLY. Must
## run as root (qemu-nbd / cryptsetup / mount); callers invoke it via sudo.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"

disk=""
passphrase_file=""
source_path=""
dest_path=""
format=""

usage() {
   printf '%s\n' "usage: ${me} --disk PATH --source IN-DISK-PATH --dest HOST-PATH [--passphrase-file PATH] [--format FMT]

--disk             disk image (see --format).
--source           absolute path of the file to read, inside the disk's filesystem.
--dest             host path to write the extracted file to.
--passphrase-file  0600 file with the LUKS passphrase; given -> the disk's single
                   LUKS volume is opened read-only before the filesystem search.
--format           qemu-nbd disk format, pinned (never probed); REQUIRED (no default). A
                   probed format lets a crafted image redirect reads onto a host path.

Read-only throughout. Run as root (via sudo)." >&2
}

die() {
   printf '%s\n' "${me}: ERROR: ${1}" >&2
   exit 1
}

## Shared host-side disk plumbing (cleanup, luks_open, settle_partitions, free_nbd,
## candidate_filesystems) + its cleanup-state globals -- single source with image-mount.
lib_dir="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")"
if [ -r "${lib_dir}/../libexec/image-test/vbox-disk-lib.bsh" ]; then
   vbox_disk_lib="${lib_dir}/../libexec/image-test/vbox-disk-lib.bsh"
else
   vbox_disk_lib='/usr/libexec/image-test/vbox-disk-lib.bsh'
fi
# shellcheck source=../libexec/image-test/vbox-disk-lib.bsh
source "${vbox_disk_lib}"

parse_args() {
   while [ "$#" -gt 0 ]; do
      case "$1" in
         --disk)
            disk="$2"
            shift 2
            ;;
         --source)
            source_path="$2"
            shift 2
            ;;
         --dest)
            dest_path="$2"
            shift 2
            ;;
         --passphrase-file)
            passphrase_file="$2"
            shift 2
            ;;
         --format)
            format="$2"
            shift 2
            ;;
         -h|--help)
            usage
            exit 0
            ;;
         *)
            usage
            die "unexpected argument '$1'"
            ;;
      esac
   done
   [ -n "${disk}" ]        || { usage; die "--disk required"; }
   [ -n "${format}" ]      || { usage; die "--format required (pinned, never probed; no default)"; }
   [ -n "${source_path}" ] || { usage; die "--source required"; }
   [ -n "${dest_path}" ]   || { usage; die "--dest required"; }
   [ -r "${disk}" ]        || die "disk not readable: '${disk}'"
   [ -z "${passphrase_file}" ] || [ -r "${passphrase_file}" ] \
      || die "passphrase file not readable: '${passphrase_file}'"
   [ "$(id -u)" = '0' ]    || die "must run as root (invoke via sudo)"
}

main() {
   trap cleanup EXIT
   parse_args "$@"

   modprobe nbd max_part=16 2>/dev/null || true
   nbd_dev="$(free_nbd)"
   nbd_connect "${nbd_dev}" "${disk}" "${format}" readonly
   settle_partitions "${nbd_dev}"

   if [ -n "${passphrase_file}" ]; then
      ## The LUKS volume is a partition, or the whole disk for an unpartitioned image.
      local target luks_target=""
      for target in "${nbd_dev}" "${nbd_dev}"p*; do
         [ -b "${target}" ] || continue
         if cryptsetup isLuks -- "${target}" 2>/dev/null; then
            luks_target="${target}"
            break
         fi
      done
      [ -n "${luks_target}" ] || die "no LUKS volume found on '${disk}'"
      luks_name="vde-$$-luks"
      luks_open "${luks_target}" "${luks_name}"
   fi

   ## Mountpoint inside a 0700 parent (shared helper): once mounted, the mountpoint takes the
   ## guest root's 0755 mode, so without a 0700 parent other local users could traverse the
   ## decrypted guest tree. The helper's realpath also keeps the confinement prefix test below
   ## holding when an ancestor of TMPDIR is a symlink.
   make_private_mountpoint
   local fs found='false' resolved
   ## Run candidate_filesystems in THIS shell via a file (NOT a '< <()' process
   ## substitution): a procsub subshell would discard its vg_activated assignment, so
   ## cleanup would never deactivate the VG it turned on (leaking the VG + its dm nodes).
   fs_list="$(mktemp)"
   candidate_filesystems > "${fs_list}"
   while read -r fs; do
      [ -n "${fs}" ] || continue
      ## A hard-powered-off VM leaves an unclean ext journal; ext* cannot replay it
      ## on a read-only device and refuses a plain '-o ro' mount, so fall back to
      ## 'noload' (skip journal replay -- safe for a read-only inspection).
      # shellcheck disable=SC2154  ## mnt_dir is set by make_private_mountpoint (sourced vbox-disk-lib.bsh)
      if ! mount --read-only --options nodev,nosuid,noexec,nosymfollow -- "${fs}" "${mnt_dir}" 2>/dev/null \
         && ! mount --read-only --options nodev,nosuid,noexec,nosymfollow,noload -- "${fs}" "${mnt_dir}" 2>/dev/null; then
         continue
      fi
      ## Confine to the mounted guest fs: fully resolve symlinks and require the REAL
      ## path to stay under mnt_dir, so a guest absolute symlink (e.g. -> /etc/shadow)
      ## cannot make install copy a HOST file out (CWE-59 defense-in-depth). A guest
      ## ABSOLUTE symlink resolves against the host root and is therefore (safely) NOT
      ## followed -- the extract targets (e.g. /var/lib/dkms/mok.pub) are regular files;
      ## do NOT "fix" this by chrooting into the guest to follow absolute links out.
      resolved="$(realpath --canonicalize-existing -- "${mnt_dir}/${source_path#/}" 2>/dev/null || true)"
      if [ -n "${resolved}" ] && [ -f "${resolved}" ] \
         && [ "${resolved#"${mnt_dir}/"}" != "${resolved}" ]; then
         install --mode=0644 -- "${resolved}" "${dest_path}"
         ## Hand the file back to the invoking (sudo) user, not root.
         if [ -n "${SUDO_UID:-}" ] && [ -n "${SUDO_GID:-}" ]; then
            chown -- "${SUDO_UID}:${SUDO_GID}" "${dest_path}"
         fi
         found='true'
      fi
      umount -- "${mnt_dir}"
      [ "${found}" = 'true' ] && break
   done < "${fs_list}"

   [ "${found}" = 'true' ] || die "'${source_path}' not found in any filesystem on '${disk}'"
   ## Diagnostic to STDERR only: stdout is a DATA channel (a caller may stream the
   ## extracted bytes from it, or capture a wrapper's stdout as the extracted cert).
   ## A line on stdout here prepends garbage to that data -- e.g. it corrupted the MOK
   ## DER enrolled into the UEFI MokListRT, so the kernel rejected the cert (-EBADMSG)
   ## and every module signed by it failed "Key was rejected by service" under Secure Boot.
   printf '%s\n' "${me}: extracted ${source_path} -> ${dest_path}" >&2
}

## Sourced (dm-release-test-tests) -> expose the functions without running;
## executed -> run.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
   main "$@"
fi
