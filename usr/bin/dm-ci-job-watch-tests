#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Runs the dm-ci-job-watch regression suite. dm-ci-job-watch reduces a commit's
## GitHub check-runs to one build-lane verdict; the suite drives the REAL state
## reducer (dm-ci-job-watch-state.py) with crafted check-runs JSON and asserts the
## newest check-suite decides -- so a stale prior run on the same head-sha cannot
## report a fresh, still-running build as already failed. No network, no root.
## Works installed (tests under /usr/share/dm-ci-job-watch-tests) or from a git
## checkout.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## Canonical suite exit (fail > skip > pass): a per-case skip surfaces as
## SKIP so the orchestrator's --allow-skip governs it, instead of being
## folded into a passing suite.
suite_exit_helper="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")/../share/dist-ai-tests-common/suite-exit.bash"
[ -r "${suite_exit_helper}" ] || suite_exit_helper='/usr/share/dist-ai-tests-common/suite-exit.bash'
# shellcheck source=../share/dist-ai-tests-common/suite-exit.bash
source "${suite_exit_helper}"

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/dm-ci-job-watch-tests" ]; then
   tests_dir="${script_dir}/../share/dm-ci-job-watch-tests"
else
   tests_dir='/usr/share/dm-ci-job-watch-tests'
fi

## Run every *_test.sh in the suite. Exit 77 means SKIP (missing tooling) and does
## not count as a failure; any other non-zero exit is a failure. Overall exit is
## non-zero iff at least one test failed.
shopt -s nullglob
failures=0
skipped=0
env_unmet=0
ran=0
for test_script in "${tests_dir}"/*_test.sh; do
  ran=$(( ran + 1 ))
  printf '\n########## %s ##########\n' "$(basename -- "${test_script}")"
  rc=0
  bash -- "${test_script}" "$@" || rc=$?
  if [ "${rc}" -eq 77 ]; then
    printf '########## SKIPPED: %s ##########\n' "$(basename -- "${test_script}")"
    skipped=$(( skipped + 1 ))
  elif [ "${rc}" -eq 78 ]; then
    env_unmet=$(( env_unmet + 1 ))
  elif [ "${rc}" -ne 0 ]; then
    printf '########## FAILED (%s): %s ##########\n' "${rc}" "$(basename -- "${test_script}")"
    failures=$(( failures + 1 ))
  fi
done

if [ "${ran}" -eq 0 ]; then
  printf 'ERROR: no *_test.sh found in %s\n' "${tests_dir}" >&2
  exit 1
fi
printf '%s\n' '' "${ran} dm-ci-job-watch case(s): ${failures} failed, ${skipped} skipped, ${env_unmet} env-unmet"
suite_exit "${failures}" "${skipped}" "${env_unmet}"
