#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Publish a GitHub Pages site: run the consistency suite, then push.
##
## The sites used to deploy from a workflow that ran website-tests first
## and published only on green. That workflow cannot survive the CI gate
## -- an <owner>.github.io site publishes only from a repo in that
## owner's org, so a copy gated to org-ai-assisted could never deploy --
## so Pages moved to a legacy branch build (publish whatever is on the
## branch) and the test gate moved HERE.
##
## That trade is only safe if this script is actually the way the site
## gets pushed. Hence the pre-push hook in each site repo, which runs the
## same check: a plain `git push` must not be able to publish an untested
## site.
##
## website-tests exits 77 (SKIP) when it resolves no site checkout at
## all. That is treated as FAILURE here, deliberately: a skip means
## nothing was verified, and publishing on the strength of a suite that
## never ran is exactly the false green this gate exists to prevent.
##
## --record-and-publish is the operator-authorized override: run the FULL suite as always, and
## when it reports a COMPLETE red (exit 1 -- the suite ran and found real consistency failures)
## publish anyway after a loud WARNING that reprints the suite output, so the deploy log carries an
## honest record of what was overridden. It is a FLAG, never an env toggle, so it is always a
## deliberate per-invocation act and cannot leak into the automated test-results-deploy path (which
## stays strict). Distinct from SITE_DEPLOY_SKIP (a blind pre-push-hook bypass that runs NOTHING
## and records nothing -- discouraged). Only a complete red is overridable: a SKIP (77), env-unmet
## (78), killed, or any other incomplete result is NOT -- nothing was fully verified, the false
## green this gate prevents.
##
## Scope boundary (deliberate): website-tests collapses its lanes into one exit (suite-exit.bash),
## so a check_site family-SKIP or an early FATAL also surface as 1. The override does NOT parse the
## output to tell a genuine consistency failure from such a collapsed 1 -- that is the operator's
## call, which is why it is a manual flag with the FULL suite output reprinted in front of them,
## not an env toggle or an automated behaviour. For a family site (the real deploy target) exit 1
## means real failures. Re-deriving the distinction by scraping lane lines is the brittle-parser
## trap and is deliberately not attempted.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"

die() {
   local code
   code="$1"
   shift
   printf '%s\n' "${me}: ERROR: $*" >&2
   exit "${code}"
}

usage() {
   printf '%s\n' "${me} -- test a Pages site, then publish it.

  ${me} [--repo DIR] [--remote NAME] [--check-only] [--record-and-publish]

  --repo DIR             site checkout (default: current directory)
  --remote NAME          git remote to push to (default: origin)
  --check-only           run the suite, do not push
  --record-and-publish   operator override: when the suite reports a COMPLETE red result
                         (exit 1), print a loud WARNING with the suite output and publish
                         anyway. A skip/env-unmet/incomplete run (nothing fully verified)
                         still refuses, as does --check-only. Default off.
  -h, --help             show this help

Exit 0 = tested and pushed (or tested, with --check-only).
Non-zero = nothing was published."
}

repo_dir=''
remote='origin'
check_only='false'
## Operator override, off by default. FLAG-ONLY by design: a per-invocation --record-and-publish is
## a conscious act that CANNOT leak into the automated test-results-deploy path (which calls
## site-deploy with no flag), so that path stays strict. An exported env toggle would silently
## turn the automated path non-strict, so there is none.
record_and_publish='false'

while [ "$#" -gt 0 ]; do
   case "$1" in
      '--repo')
         [ "$#" -ge 2 ] || die 64 '--repo requires a value'
         repo_dir="$2"
         shift 2
         ;;
      '--repo='*)
         repo_dir="${1#*=}"
         shift
         ;;
      '--remote')
         [ "$#" -ge 2 ] || die 64 '--remote requires a value'
         remote="$2"
         shift 2
         ;;
      '--remote='*)
         remote="${1#*=}"
         shift
         ;;
      '--check-only')
         check_only='true'
         shift
         ;;
      '--record-and-publish')
         record_and_publish='true'
         shift
         ;;
      '-h'|'--help')
         usage
         exit 0
         ;;
      *)
         die 64 "unknown argument '$1' (see --help)"
         ;;
   esac
done

[ -n "${repo_dir}" ] || repo_dir="${PWD}"
repo_dir="$(readlink --canonicalize -- "${repo_dir}")" \
   || die 66 "cannot resolve --repo path"
[ -d "${repo_dir}" ] || die 66 "not a directory: '${repo_dir}'"

git -C "${repo_dir}" rev-parse --is-inside-work-tree > /dev/null 2>&1 \
   || die 66 "not a git repository: '${repo_dir}'"

## Resolve website-tests from the same tree as this script when running from a checkout, else
## the installed path. SITE_DEPLOY_WEBSITE_TESTS overrides the binary (a test seam, in the
## overridable-base convention) so a suite can exercise the real push path without the browser
## gate -- strictly LESS permissive than the existing SITE_DEPLOY_SKIP, which skips the gate
## entirely; this only swaps which gate binary runs, defaulting to the real one.
self_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"
website_tests="${SITE_DEPLOY_WEBSITE_TESTS:-}"
if [ -z "${website_tests}" ]; then
   website_tests="${self_dir}/website-tests"
   if [ ! -x "${website_tests}" ]; then
      website_tests='/usr/bin/website-tests'
   fi
fi
[ -x "${website_tests}" ] \
   || die 69 "website-tests not found (SITE_DEPLOY_WEBSITE_TESTS / '${self_dir}' / /usr/bin)"

## Point the suite at THIS checkout. The variable name is per-site;
## an unrecognized directory is refused rather than silently testing
## whatever else happens to be under ~/private-sources.
site_name="$(basename -- "${repo_dir}")"
case "${site_name}" in
   'output-lies.github.io')
      site_var='OUTPUT_LIES_REPO'
      ;;
   'secure-terminal.github.io')
      site_var='SECURE_TERMINAL_SITE_REPO'
      ;;
   'org-ai-assisted.github.io')
      site_var='ORG_AI_ASSISTED_REPO'
      ;;
   *)
      die 64 "'${site_name}' is not a known Pages site checkout (expected one of: output-lies.github.io, secure-terminal.github.io, org-ai-assisted.github.io)"
      ;;
esac

printf '%s\n' "${me}: testing ${repo_dir}" >&2

test_rc=0
suite_out=''
if [ "${record_and_publish}" = 'true' ]; then
   ## Capture the suite output into a variable so the override WARNING can name the failed
   ## check(s) even after a long suite's output has scrolled, while `tee /dev/stderr` still streams
   ## it live. The subshell exits with website-tests' OWN status (PIPESTATUS[0]), not the
   ## pipeline's, so a tee write hiccup cannot mask a 0/77/78 as a "1" (a green or a
   ## nothing-verified run must never be taken for an overridable red). The pipe is TESTED by
   ## `&& ... || ...`, so a failing suite does not trip errexit, and PIPESTATUS survives into the
   ## `||` branch (an assignment does not reset it). Nothing is persisted.
   suite_out="$(
      env "${site_var}=${repo_dir}" "${website_tests}" 2>&1 | tee /dev/stderr \
         && wt_rc=0 || wt_rc="${PIPESTATUS[0]}"
      exit "${wt_rc}"
   )" || test_rc="$?"
else
   env "${site_var}=${repo_dir}" "${website_tests}" || test_rc="$?"
fi

## Decide from the suite result:
##  0  -> green: publish (or report, with --check-only).
##  1 + the 'suite-complete' marker -> the suite ran EVERY lane to the end and found real
##        consistency failures: a KNOWN complete red. Refuse, UNLESS --record-and-publish is set
##        AND we are actually publishing. The override never applies under --check-only, so a gate
##        caller -- the pre-push hook runs `site-deploy --check-only` -- still refuses a red (and
##        the flag is per-invocation, never ambient).
##  else -> nothing was verified to completion: a SKIP (77), env-unmet (78), killed, OR an exit 1
##        WITHOUT the marker (website-tests aborted early -- a missing/failing required unit test,
##        BEFORE the site checks ran). NEVER overridable: publishing on it is the false green this
##        gate exists to prevent.
## Match the marker as a WHOLE LINE, not an unanchored substring: an early-FATAL message echoes the
## checkout path, so a path CONTAINING the marker text would otherwise forge completion.
## website-tests prints the marker on its own line, so a whole-line (grep -Fxq) match cannot be
## spoofed by the marker text appearing as a substring inside another line.
suite_complete='false'
if grep --fixed-strings --line-regexp --quiet 'website-tests: suite-complete' <<< "${suite_out}"; then
   suite_complete='true'
fi
if [ "${test_rc}" -eq 0 ]; then
   printf '%s\n' "${me}: suite green" >&2
elif [ "${test_rc}" -eq 1 ] && [ "${suite_complete}" = 'true' ] \
      && [ "${record_and_publish}" = 'true' ] && [ "${check_only}" != 'true' ]; then
   ## Publish past a KNOWN, COMPLETE red result, loudly. The full captured suite output is
   ## reprinted under the banner so the deploy record names exactly which checks were overridden.
   {
      printf '%s\n' "${me}: ============================================================"
      printf '%s\n' "${me}: WARNING: --record-and-publish: publishing PAST a FAILED gate"
      printf '%s\n' "${me}: website-tests exited ${test_rc}. Full suite output follows:"
      printf '%s\n' "${suite_out}"
      printf '%s\n' "${me}: operator authorized this publish despite the above"
      printf '%s\n' "${me}: ============================================================"
   } >&2
elif [ "${test_rc}" -eq 77 ]; then
   die 1 "website-tests SKIPPED (exit 77): it resolved no site checkout, so nothing was verified. Refusing to publish."
else
   die 1 "website-tests failed (exit ${test_rc}). Refusing to publish."
fi

if [ "${check_only}" = 'true' ]; then
   printf '%s\n' "${me}: --check-only, not pushing" >&2
   exit 0
fi

branch="$(git -C "${repo_dir}" rev-parse --abbrev-ref HEAD)"
[ "${branch}" != 'HEAD' ] \
   || die 1 'detached HEAD: check out the publishing branch first'

printf '%s\n' "${me}: pushing ${branch} -> ${remote}/${branch}" >&2
## The pre-push hook in each site repo re-runs website-tests via `site-deploy --check-only` on the
## publishing remote. This push IS that publish, and the identical suite just ran GREEN above on
## this same checkout, moments ago -- letting the hook re-run it would gate TWICE (doubling a
## ~15-20min browser suite, the deploy's dominant cost). Suppress the hook for THIS push only; a
## bare `git push` by anyone else is unaffected and still gates.
SITE_DEPLOY_SKIP=1 git -C "${repo_dir}" push -- "${remote}" "${branch}"
printf '%s\n' "${me}: published" >&2
