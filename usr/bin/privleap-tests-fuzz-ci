#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## Provision and run the WHOLE privleap fuzz category inside an EPHEMERAL,
## single-purpose CI container (invoked as root). Owns everything the fuzz
## workflow needs beyond the two git checkouts, so the workflow stays a thin
## caller and the "how to run privleap fuzz in CI" recipe lives with the suite:
##   - container prerequisites (sudo, adduser, python3)
##   - the privleap runtime (group / PAM policy / shim) via
##     privleap-tests-session-fuzz-setup (which owns the pam / sdnotify deps)
##   - the run itself, delegated to the shared CI wrapper dist-ai-tests-ci-run.sh
##
## The wrapper is what runs EVERY dist-ai lane in CI: it drops root to the
## dm-ci-build user (passwordless sudo -- which the live-daemon session fuzzer
## needs to start privleapd; refusing to attribute requests to root is the whole
## authorization surface), chowns the workspace to it, and runs dist-ai-tests-all
## via 'runuser --preserve-environment' so the GITHUB_* CI signal survives (else
## dist-ai-tests-all refuses as an unsafe on-host run) along with the
## PRIVLEAP_TEST_DISPOSABLE_ENV we export. So one lane runs every privleap fuzz
## suite -- the in-process wire/config/authz parser fuzzers AND the live-daemon
## session fuzzer -- as one non-root user; atheris is allow-skipped (no Debian
## package -- coverage-guided fuzzing runs via ClusterFuzzLite).
##
## SAFE ONLY in a throwaway CI container: it apt-installs packages and (via the
## setup script) overwrites the system-wide /etc/pam.d/privleapd and shim with
## unverified checkout content. Do NOT run on a machine you care about. This is a
## CI runtime PROVISIONER + runner, not a dist-ai suite (it needs root + a
## checkout arg no orchestrator lane passes), so it is listed in
## dist-ai-registry-tests allowed_unregistered.
##
## Usage: privleap-tests-fuzz-ci <privleap-checkout-root> [--timeout-fuzz SECONDS]
## Needs root; runs inside the fuzz container, not a VM.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

repo="$(readlink --canonicalize -- "${1:?privleap checkout root required}")"
shift

## Per-fuzzer wall-clock cap handed to dist-ai-tests-all. The session fuzzer is
## the long pole; 1200s matches its historical standalone budget so its default
## iteration count still fits. The in-process parser fuzzers finish well within.
timeout_fuzz='1200'
while [ "$#" -gt 0 ]; do
  case "$1" in
    --timeout-fuzz)
      timeout_fuzz="${2:?--timeout-fuzz needs a value}"
      shift 2
      ;;
    *)
      printf '%s\n' "FATAL: unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

## A non-positive / non-numeric timeout would silently mis-budget the run.
case "${timeout_fuzz}" in
  '' | *[!0-9]*)
    printf '%s\n' "FATAL: --timeout-fuzz must be a positive integer: ${timeout_fuzz}" >&2
    exit 1
    ;;
esac
if [ "${timeout_fuzz}" -eq 0 ]; then
  printf '%s\n' "FATAL: --timeout-fuzz must be greater than 0" >&2
  exit 1
fi

## Container prerequisites. python3-pam / python3-sdnotify (the privleap runtime
## deps) are installed by the setup script below, which owns them. sudo: the
## wrapper's dm-ci-build sudoers drop + the session fuzzer's daemon escalation.
## adduser: the wrapper's useradd needs it on a minimal image.
apt-get update
apt-get install --yes --no-install-recommends sudo adduser python3

## privleap runtime: group, PAM policy, shim (installed from the checkout).
"${script_dir}/privleap-tests-session-fuzz-setup" "${repo}"

## Delegate the non-root drop + run to the shared CI wrapper (see the header).
## PRIVLEAP_TEST_DISPOSABLE_ENV=1 keeps the session fuzzer out of the mount
## namespace (no CAP_SYS_ADMIN in an ordinary container); the wrapper's
## 'runuser --preserve-environment' carries it and the GITHUB_* CI env through.
export PRIVLEAP_TEST_DISPOSABLE_ENV=1
## style-ok: R-103 -- a thin CI wrapper is MEANT to replace itself with the runner.
exec "${script_dir}/../../ci/dist-ai-tests-ci-run.sh" --fuzz \
  --component privleap \
  --component-root "${repo}" \
  --timeout-fuzz "${timeout_fuzz}" \
  --allow-skip privleap-tests-fuzz-atheris
