#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Runs mediawiki-shell's offline *_test.sh cases (no live wiki). The subject is
## resolved from MEDIAWIKI_SHELL_REPO (a checkout root); each case self-skips
## (77) when it is absent, so 'ran == 0' below reports SKIP, never a pass over
## zero assertions. Works installed (/usr/share/mediawiki-shell-tests) or from a
## dist-ai checkout.

set -o errexit
set -o nounset
set -o errtrace
set -o pipefail
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/mediawiki-shell-tests" ]; then
   tests_dir="${script_dir}/../share/mediawiki-shell-tests"
else
   tests_dir='/usr/share/mediawiki-shell-tests'
fi

## Export the subject root for the cases (each resolves its own paths from it).
if [ -n "${MEDIAWIKI_SHELL_REPO:-}" ]; then
   export MEDIAWIKI_SHELL_REPO
fi

## common sources helper-scripts '.bsh' by HELPER_SCRIPTS_PATH and runs
## collect_reqs over str_replace/stprint (both helper-scripts '#!/usr/bin/python3
## -Bsu' tools). When a helper-scripts checkout is wired, put its usr/bin on PATH
## and its dist-packages on PYTHONPATH so those tools resolve their own libs;
## otherwise the common-sourcing cases die instead of running.
if [ -n "${HELPER_SCRIPTS_PATH:-}" ]; then
   export HELPER_SCRIPTS_PATH
   export PATH="${HELPER_SCRIPTS_PATH}/usr/bin:${PATH}"
   export PYTHONPATH="${HELPER_SCRIPTS_PATH}/usr/lib/python3/dist-packages${PYTHONPATH:+:${PYTHONPATH}}"
fi

shopt -s nullglob
shell_cases=( "${tests_dir}"/*_test.sh )
shopt -u nullglob

if [ "${#shell_cases[@]}" -eq 0 ]; then
   printf '%s\n' "mediawiki-shell-tests: no *_test.sh cases in '${tests_dir}'" >&2
   exit 1
fi

ran=0
failed=0
skipped=0
for shell_case in "${shell_cases[@]}"; do
   printf '%s\n' "== $(basename -- "${shell_case}") =="
   case_rc=0
   "${shell_case}" || case_rc=$?
   if [ "${case_rc}" -eq 77 ]; then
      skipped=$(( skipped + 1 ))
   elif [ "${case_rc}" -ne 0 ]; then
      failed=$(( failed + 1 ))
   else
      ran=$(( ran + 1 ))
   fi
done

if [ "${failed}" -ne 0 ]; then
   printf '%s\n' "mediawiki-shell-tests: ${failed} case(s) FAILED (${ran} passed, ${skipped} skipped)." >&2
   exit 1
fi
if [ "${ran}" -eq 0 ]; then
   printf '%s\n' "mediawiki-shell-tests: all ${skipped} case(s) skipped (subject absent); nothing asserted." >&2
   ## style-ok: allow-skip: mediawiki-shell is an optional target -- absent in a --repo-root run without this submodule; a wired run always resolves it.
   exit 77
fi
printf '%s\n' "mediawiki-shell-tests: ${ran} case(s) passed, ${skipped} skipped."
