#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## style-ok: no-has -- standalone test harness; does not source helper-scripts.

## Regression for the website-tests browser-lane DELEGATION, i.e. the fix for the
## silent-SKIP false green: on a host with no local browser but with the review
## sandbox, website-tests must run the mobile/width lanes via website-tests-sandbox
## and GATE on their result -- never print a SKIP and exit green.
##
## Drives the REAL usr/bin/website-tests wrapper (no copy) with a STUB driver injected
## via WEBSITE_TESTS_SANDBOX_DRIVER and a stub `sandbox` on PATH, so the delegation
## branch is exercised without a real sandbox. Asserts, against the actual sites:
##   - a delegated FAILURE propagates (wrapper exits non-zero), not swallowed to green
##   - a delegated SUCCESS passes and the driver was actually invoked
##   - with the sandbox disabled, the wrapper SKIPs and does NOT invoke the driver
##
## Runs only where the delegation branch is reachable: it needs at least one site
## checkout AND no local Playwright (so the mobile probe returns 77). Absent either,
## it SKIPs (exit 77) -- an authorized, environmental skip, not a masked failure.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"
website_tests="${script_dir}/website-tests"
if [ -d "${script_dir}/../share/website-tests" ]; then
   tests_dir="${script_dir}/../share/website-tests"
else
   tests_dir='/usr/share/website-tests'
fi

[ -x "${website_tests}" ] || website_tests="$(command -v website-tests)"

pass_count=0
fail_count=0
pass(){ printf '%s\n' "website-tests-delegation-test: pass $1"; pass_count=$(( pass_count + 1 )); }
fail(){ printf '%s\n' "website-tests-delegation-test: FAIL $1" >&2; fail_count=$(( fail_count + 1 )); }
## style-ok: allow-skip: delegation branch unreachable without a site checkout and no local Playwright -- environmental skip
skip(){ printf '%s\n' "website-tests-delegation-test: SKIP ($1)" >&2; exit 77; }

## Resolve the site roots the same way website-tests does; export the ones present so
## the wrapper (and the local probe) see the same set.
[ -v OUTPUT_LIES_REPO ]         || OUTPUT_LIES_REPO=''
[ -v SECURE_TERMINAL_SITE_REPO ] || SECURE_TERMINAL_SITE_REPO=''
[ -v ORG_AI_ASSISTED_REPO ]     || ORG_AI_ASSISTED_REPO=''
declare -a roots=()
resolve(){
   local given
   local default
   given="$1"
   default="$2"
   if [ -n "${given}" ] && [ -f "${given}/index.html" ]; then
      roots+=( "${given}" )
   elif [ -f "${default}/index.html" ]; then
      roots+=( "${default}" )
   fi
}
resolve "${OUTPUT_LIES_REPO}"          "${HOME}/private-sources/output-lies.github.io"
resolve "${SECURE_TERMINAL_SITE_REPO}" "${HOME}/private-sources/secure-terminal.github.io"
resolve "${ORG_AI_ASSISTED_REPO}"      "${HOME}/private-sources/org-ai-assisted.github.io"
[ "${#roots[@]}" -ge 1 ] || skip 'no site checkout found'

## cspell-lane delegation contract (F11): webcheck-cspell-sandbox must honor the 77
## env-unmet contract like its vnu/axe siblings -- when cspell is absent locally AND the
## sandbox is unusable (WEBSITE_TESTS_NO_SANDBOX=1 / DIST_AI_IN_SANDBOX=1 / no `sandbox`),
## it must exit 77 (delegate_sandbox_lane maps 77 to SKIP), NEVER die 1 (which becomes a
## FAIL). WEBCHECK_NO_LOCAL=1 forces the no-local-cspell path so the assertion is
## deterministic regardless of whether cspell happens to be on PATH here. Runs independent
## of Playwright (this contract has nothing to do with the browser lanes).
cspell_driver="${script_dir}/webcheck-cspell-sandbox"
[ -x "${cspell_driver}" ] || cspell_driver="$(command -v webcheck-cspell-sandbox 2>/dev/null || true)"
if [ -x "${cspell_driver}" ]; then
   crc=0
   env --unset=DIST_AI_IN_SANDBOX WEBCHECK_NO_LOCAL=1 WEBSITE_TESTS_NO_SANDBOX=1 \
      "${cspell_driver}" "${roots[0]}" >/dev/null 2>&1 || crc="$?"
   if [ "${crc}" = '77' ]; then pass 'cspell driver: WEBSITE_TESTS_NO_SANDBOX=1 -> 77 SKIP (not 1 FAIL)'; else fail "cspell driver no-sandbox rc=${crc}, want 77 (env-unmet SKIP like vnu/axe)"; fi
   crc=0
   env WEBCHECK_NO_LOCAL=1 DIST_AI_IN_SANDBOX=1 \
      "${cspell_driver}" "${roots[0]}" >/dev/null 2>&1 || crc="$?"
   if [ "${crc}" = '77' ]; then pass 'cspell driver: DIST_AI_IN_SANDBOX=1 -> 77 SKIP (cannot nest)'; else fail "cspell driver in-sandbox rc=${crc}, want 77"; fi

   ## R2-3: two site roots sharing a BASENAME must be rejected BEFORE the local/sandbox split
   ## (both map to cspell-baseline-<basename>.txt; a collision clobbers one). The check is hoisted
   ## ahead of the split, so it fires with no sandbox and no local cspell -- deterministic here.
   ## Pre-fix the rejection lived only in the sandbox staging loop, unreached on the local path.
   dup_a="$(mktemp --directory)"
   dup_b="$(mktemp --directory)"
   mkdir --parents -- "${dup_a}/site" "${dup_b}/site"
   printf '%s\n' '<html></html>' > "${dup_a}/site/index.html"
   printf '%s\n' '<html></html>' > "${dup_b}/site/index.html"
   drc=0
   dout="$(env WEBCHECK_NO_LOCAL=1 WEBSITE_TESTS_NO_SANDBOX=1 \
      "${cspell_driver}" "${dup_a}/site" "${dup_b}/site" 2>&1)" || drc="$?"
   if [ "${drc}" != '0' ] && grep --quiet 'duplicate site-root basename' <<< "${dout}"; then
      pass 'cspell driver: duplicate site-root basename rejected before the local/sandbox split'
   else
      fail "cspell driver duplicate-basename not rejected (rc=${drc}): ${dout}"
   fi
   safe-rm --recursive --force -- "${dup_a}" "${dup_b}"

   ## R2-2: a local cspell whose version is NOT the pinned 8.19.4 must NOT be run directly -- the
   ## driver falls through to the sandbox path. With WEBSITE_TESTS_NO_SANDBOX=1 that path is
   ## env-unmet -> exit 77. Pre-fix the local branch gated on mere presence, so a wrong-version
   ## (node-22-only 10.x) cspell was run instead of delegating -> rc != 77.
   vstub="$(mktemp --directory)"
   printf '%s\n' '#!/bin/bash' 'echo 10.1.0' > "${vstub}/cspell"
   chmod +x -- "${vstub}/cspell"
   vrc=0
   env --unset=WEBCHECK_NO_LOCAL --unset=DIST_AI_IN_SANDBOX \
      PATH="${vstub}:${PATH}" WEBSITE_TESTS_NO_SANDBOX=1 \
      "${cspell_driver}" "${roots[0]}" >/dev/null 2>&1 || vrc="$?"
   if [ "${vrc}" = '77' ]; then
      pass 'cspell driver: unpinned-version local cspell falls through to sandbox (77, not run)'
   else
      fail "cspell driver ran an unpinned local cspell instead of delegating (rc=${vrc}, want 77)"
   fi
   safe-rm --recursive --force -- "${vstub}"
else
   fail 'webcheck-cspell-sandbox not found for the delegation-contract check'
fi

## The delegation branch fires only when the local mobile probe returns 77 (no local
## Playwright). If a local browser is present the branch is unreachable here.
probe_rc=0
"${tests_dir}/check_mobile.py" "${roots[@]}" >/dev/null 2>&1 || probe_rc="$?"
[ "${probe_rc}" = '77' ] || skip 'local Playwright present; delegation path not reachable'

## Sandbox stubs: a `sandbox` on PATH (only its existence is probed by the wrapper)
## and a driver stub that records its invocation and returns a configurable code.
stub_dir="$(mktemp --directory)"
marker="${stub_dir}/driver-invoked"
cleanup(){ safe-rm --recursive --force -- "${stub_dir}"; }
trap cleanup EXIT
printf '%s\n' '#!/bin/bash' 'exit 0' > "${stub_dir}/sandbox"
cat > "${stub_dir}/driver" <<'STUB'
#!/bin/bash
touch -- "${DRIVER_MARKER}"
exit "${DRIVER_RC:-0}"
STUB
## `provision` stub on PATH for EVERY scenario: the driver's auto-provision branch now calls
## the SEPARATE `provision` tool, so a scenario that makes the venv probe fail (e.g. Scenario 5)
## would otherwise run the REAL provision and touch a real sandbox. Record argv when a capture
## file is set (Scenario 6 asserts it); otherwise just succeed harmlessly.
cat > "${stub_dir}/provision" <<'STUB'
#!/bin/bash
[ -n "${PROVISION_ARGV_CAPTURE:-}" ] && printf '%s\n' "$*" >> "${PROVISION_ARGV_CAPTURE}"
exit 0
STUB
chmod +x -- "${stub_dir}/sandbox" "${stub_dir}/driver" "${stub_dir}/provision"

out="${stub_dir}/out.log"

## Run the real wrapper with the stubs; $1.. = extra env assignments; output -> $out.
## --unset=DIST_AI_IN_SANDBOX: these scenarios simulate a HOST context (stub `sandbox`
## + stub driver on PATH), so the HOST delegation branch must be reachable. When this
## test itself runs INSIDE the sandbox, DIST_AI_IN_SANDBOX=1 is inherited and would
## short-circuit the wrapper to its in-sandbox SKIP branch, hiding the delegation path.
## A scenario that WANTS the in-sandbox branch passes 'DIST_AI_IN_SANDBOX=1' itself (a
## later NAME=VALUE operand overrides the --unset).
run_wrapper(){
   local rc
   rc=0
   env --unset=DIST_AI_IN_SANDBOX \
       PATH="${stub_dir}:${PATH}" \
       OUTPUT_LIES_REPO="${OUTPUT_LIES_REPO}" \
       SECURE_TERMINAL_SITE_REPO="${SECURE_TERMINAL_SITE_REPO}" \
       ORG_AI_ASSISTED_REPO="${ORG_AI_ASSISTED_REPO}" \
       DRIVER_MARKER="${marker}" \
       "$@" \
       "${website_tests}" > "${out}" 2>&1 || rc="$?"
   printf '%s' "${rc}"
}

driver_env="WEBSITE_TESTS_SANDBOX_DRIVER=${stub_dir}/driver"

## Scenario 1: delegated FAILURE must propagate (the core regression). Pass each
## NAME=VALUE as its own arg -- never a space-joined string -- so a stub_dir path
## containing a space cannot split mid-value.
safe-rm --force -- "${marker}"
rc="$(run_wrapper "${driver_env}" 'DRIVER_RC=1')"
if [ "${rc}" != '0' ]; then pass 'delegated failure -> wrapper non-zero'; else fail "delegated failure swallowed to green (rc=${rc})"; fi
if [ -f "${marker}" ]; then pass 'driver invoked on delegation'; else fail 'driver not invoked (no delegation happened)'; fi
if ! grep --quiet 'no sandbox' -- "${out}"; then pass 'no false SKIP emitted while delegating'; else fail 'wrapper printed the no-sandbox SKIP while a driver was available'; fi

## Scenario 2: delegated SUCCESS must pass (and confirms check_site passes on these
## roots, so scenario 1's non-zero came from the driver).
safe-rm --force -- "${marker}"
rc="$(run_wrapper "${driver_env}" 'DRIVER_RC=0')"
if [ "${rc}" = '0' ]; then pass 'delegated success -> wrapper zero'; else fail "delegated success not green (rc=${rc}); see ${out}"; fi
if [ -f "${marker}" ]; then pass 'driver invoked on success path'; else fail 'driver not invoked on success path'; fi

## Scenario 3: with the sandbox disabled, the wrapper does NOT delegate and surfaces
## the browser lanes as env-unmet SKIP (exit 78) for the orchestrator's --allow-skip
## to govern -- NOT a silent green 0 (that false green is exactly what the suite-exit
## contract closes). Only the static lane actually gated.
safe-rm --force -- "${marker}"
rc="$(run_wrapper "${driver_env}" 'DRIVER_RC=1' 'WEBSITE_TESTS_NO_SANDBOX=1')"
if [ "${rc}" = '78' ]; then pass 'no-sandbox path -> env-unmet SKIP (78), not silent green'; else fail "no-sandbox path rc=${rc}, want 78 (env-unmet)"; fi
if grep --quiet 'website-mobile-tests: SKIP (no Playwright/chromium; no sandbox)' -- "${out}"; then pass 'no-sandbox context SKIPs explicitly'; else fail 'no-sandbox context did not emit the SKIP notice'; fi
if [ ! -f "${marker}" ]; then pass 'driver not invoked when sandbox disabled'; else fail 'driver invoked despite sandbox disabled'; fi

## Scenario 4: INSIDE the sandbox (DIST_AI_IN_SANDBOX=1) with no local browser, the
## wrapper must NOT delegate to a nested `sandbox` call (it has no --target and cannot
## nest -- that doomed call flipped a clean run to FAIL(1)). It surfaces env-unmet SKIP
## (78) instead and never invokes the driver. The stub `sandbox` is STILL on PATH and
## DRIVER_RC=1, so without the guard this path would delegate and FAIL(1); the in-sandbox
## branch must win regardless, proving the guard (not merely an absent sandbox) is what
## prevents the nested call.
safe-rm --force -- "${marker}"
rc="$(run_wrapper "${driver_env}" 'DRIVER_RC=1' 'DIST_AI_IN_SANDBOX=1')"
if [ "${rc}" = '78' ]; then pass 'in-sandbox path -> env-unmet SKIP (78), not a nested-sandbox FAIL'; else fail "in-sandbox path rc=${rc}, want 78 (env-unmet)"; fi
if grep --quiet 'in-sandbox, cannot nest-provision' -- "${out}"; then pass 'in-sandbox context SKIPs with the nest-provision notice'; else fail 'in-sandbox context did not emit the in-sandbox SKIP notice'; fi
if [ ! -f "${marker}" ]; then pass 'driver not invoked inside the sandbox'; else fail 'driver invoked inside the sandbox (nested delegation attempted)'; fi

## Scenario 5: website-tests-sandbox must DEFAULT the sandbox target so the host publish
## gate is forget-proof -- with QUBE_CTL_TARGET UNSET it must still resolve the local
## review sandbox (temp-claude) rather than let every `sandbox` call die "no target" and
## block the gate. Drive the REAL driver with a `sandbox` stub that records QUBE_CTL_TARGET
## on its first call and exits 1; the driver then dies at the provision check, but the
## recorded value proves the default was applied before any sandbox call.
wts="${script_dir}/website-tests-sandbox"
[ -x "${wts}" ] || wts="$(command -v website-tests-sandbox 2>/dev/null || true)"
if [ -x "${wts}" ]; then
   tgt_cap="${stub_dir}/qube-target"
   safe-rm --force -- "${tgt_cap}"
   cat > "${stub_dir}/sandbox" <<'SBSTUB'
#!/bin/bash
printf '%s\n' "${QUBE_CTL_TARGET-UNSET}" >> "${QUBE_TARGET_CAPTURE}"
exit 1
SBSTUB
   chmod +x -- "${stub_dir}/sandbox"
   env --unset=QUBE_CTL_TARGET \
       PATH="${stub_dir}:${PATH}" \
       QUBE_TARGET_CAPTURE="${tgt_cap}" \
       "${wts}" "${roots[0]}" >/dev/null 2>&1 || true
   if [ -f "${tgt_cap}" ] && [ "$(head -n 1 -- "${tgt_cap}")" = 'temp-claude' ]; then
      pass 'website-tests-sandbox defaults QUBE_CTL_TARGET to temp-claude (forget-proof gate)'
   else
      fail "website-tests-sandbox did not default the sandbox target (got '$(head -n 1 -- "${tgt_cap}" 2>/dev/null)')"
   fi
   ## Restore the plain exit-0 stub (keep the fixture state clean for any future scenario).
   printf '%s\n' '#!/bin/bash' 'exit 0' > "${stub_dir}/sandbox"
   chmod +x -- "${stub_dir}/sandbox"

   ## Scenario 6: the Playwright auto-provision invokes the SEPARATE `provision` tool as
   ## `provision --target <tgt> playwright` -- NOT `sandbox provision playwright` (not a valid
   ## sandbox subcommand; the broken form silently failed the gate's auto-provision). Make the
   ## venv probe fail so the driver enters the provision branch, stub `provision` to record its
   ## argv, and assert the real invocation. Fails on the pre-fix `sandbox provision playwright`
   ## (the `provision` tool is never called, so the capture stays empty).
   prov_cap="${stub_dir}/provision-argv"
   safe-rm --force -- "${prov_cap}"
   ## `sandbox exec -- test -x <venv>` must return non-zero so the driver provisions; keep it
   ## failing on the re-check too (driver then dies, but provision was already recorded). The
   ## global `provision` stub records argv when PROVISION_ARGV_CAPTURE is set.
   printf '%s\n' '#!/bin/bash' 'exit 1' > "${stub_dir}/sandbox"
   chmod +x -- "${stub_dir}/sandbox"
   env PATH="${stub_dir}:${PATH}" \
       QUBE_CTL_TARGET='temp-claude' \
       PROVISION_ARGV_CAPTURE="${prov_cap}" \
       "${wts}" "${roots[0]}" >/dev/null 2>&1 || true
   if [ -f "${prov_cap}" ] && [ "$(head -n 1 -- "${prov_cap}")" = '--target temp-claude playwright' ]; then
      pass 'auto-provision invokes provision --target <tgt> playwright (separate tool, not a sandbox subcommand)'
   else
      fail "auto-provision used the wrong invocation (got '$(head -n 1 -- "${prov_cap}" 2>/dev/null)', want '--target temp-claude playwright')"
   fi
   ## Restore clean fixtures.
   printf '%s\n' '#!/bin/bash' 'exit 0' > "${stub_dir}/sandbox"
   chmod +x -- "${stub_dir}/sandbox"

   ## Scenario 7: WEBCHECK_BROWSERS is ALLOWLISTED + comma-normalized at ingress. An
   ## injection / unknown token must die LOUD ("invalid engine") BEFORE any sandbox call
   ## -- so a '$(...)' token never reaches the remote `bash -lc` compgen glob -- and must
   ## NOT execute. A comma-separated value must be ACCEPTED (mobile.py accepts commas; the
   ## driver must too, else a false "missing engine" provisioning failure). Fails on the
   ## pre-allowlist driver (the '*' case embedded the raw token; split was space-only).
   pwn="${stub_dir}/pwned"
   safe-rm --force -- "${pwn}"
   badout="${stub_dir}/bad.log"
   env PATH="${stub_dir}:${PATH}" QUBE_CTL_TARGET='temp-claude' \
       WEBCHECK_BROWSERS="\$(touch ${pwn})" \
       "${wts}" "${roots[0]}" > "${badout}" 2>&1 || true
   if grep --quiet 'invalid engine' -- "${badout}" && [ ! -e "${pwn}" ]; then
      pass 'WEBCHECK_BROWSERS injection token rejected loud before any sandbox call'
   else
      fail 'WEBCHECK_BROWSERS injection token not rejected (allowlist missing / token executed)'
   fi
   commaout="${stub_dir}/comma.log"
   env PATH="${stub_dir}:${PATH}" QUBE_CTL_TARGET='temp-claude' \
       WEBCHECK_BROWSERS='chromium,firefox' \
       "${wts}" "${roots[0]}" > "${commaout}" 2>&1 || true
   if ! grep --quiet 'invalid engine' -- "${commaout}"; then
      pass 'WEBCHECK_BROWSERS comma-separated value accepted (normalized, not a false failure)'
   else
      fail 'WEBCHECK_BROWSERS comma value wrongly rejected as an invalid engine'
   fi

   ## Scenario 8: the staging tree must be sync-safe regardless of TMPDIR. `sandbox sync`
   ## refuses a /var/tmp path as a system dir, and the ambient TMPDIR here IS /var/tmp, so
   ## a mktemp-default staging dir lands there and the gate dies at the sync. The driver
   ## must anchor staging under $HOME instead. Drive the REAL driver (exit-0 stub so it
   ## reaches the sync step) with a tiny synthetic root under TMPDIR=/var/tmp, capture the
   ## local path handed to `sync`, and assert it is under $HOME. Fails on the pre-fix
   ## `mktemp --directory` (TMPDIR-honored -> a /var/tmp staging path).
   sync_cap="${stub_dir}/sync-path"
   safe-rm --force -- "${sync_cap}"
   mini_root="${stub_dir}/miniroot"
   mkdir --parents -- "${mini_root}"
   printf '%s\n' '<!doctype html><html><head><title>t</title></head><body><h1>ok</h1></body></html>' > "${mini_root}/index.html"
   cat > "${stub_dir}/sandbox" <<'SBSTUB'
#!/bin/bash
## Record the LOCAL tree handed to `sync` (sandbox sync --delete <local> <remote>); exit 0
## for every verb so the real driver reaches and passes the sync step.
if [ "$1" = 'sync' ]; then
   for a in "$@"; do
      case "${a}" in
         sync|--delete) ;;
         *) printf '%s\n' "${a}" >> "${SYNC_PATH_CAPTURE}"; break ;;
      esac
   done
fi
exit 0
SBSTUB
   chmod +x -- "${stub_dir}/sandbox"
   env PATH="${stub_dir}:${PATH}" QUBE_CTL_TARGET='temp-claude' \
       TMPDIR='/var/tmp' SYNC_PATH_CAPTURE="${sync_cap}" \
       "${wts}" "${mini_root}" >/dev/null 2>&1 || true
   staged_path="$(head -n 1 -- "${sync_cap}" 2>/dev/null || true)"
   ## Assert the staging path did NOT land under the system TMPDIR we injected (/var/tmp) --
   ## the precise regression, independent of $HOME's value. Old code (mktemp honoring TMPDIR)
   ## yields /var/tmp/... which the sandbox-sync guard refuses; the fix must ignore TMPDIR.
   if [ -n "${staged_path}" ] && [ "${staged_path#/var/tmp}" = "${staged_path}" ]; then
      pass 'staging tree not under the system TMPDIR (sync-safe; TMPDIR ignored)'
   else
      fail "staging tree under the system TMPDIR (got '${staged_path:-<none>}'; a /var/tmp path trips the sandbox-sync guard)"
   fi
   ## Restore the clean exit-0 stub.
   printf '%s\n' '#!/bin/bash' 'exit 0' > "${stub_dir}/sandbox"
   chmod +x -- "${stub_dir}/sandbox"
else
   fail 'website-tests-sandbox not found for the target-default check'
fi

printf '%s\n' "website-tests-delegation-test: ${pass_count} pass, ${fail_count} fail, 0 skip"
[ "${fail_count}" -eq 0 ]
