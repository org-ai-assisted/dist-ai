#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## Runs the in-process privleap security suite (no root, no network, no live
## privleapd): the server-side wire-protocol parser fuzzer and the
## authorization-engine property test, both with a fixed seed for reproducible
## CI. These exercise exactly the code an unprivileged local user can reach
## over their comm socket, the surface where a bug could become arbitrary code
## execution. For randomized fuzzing with a coverage report use
## privleap-tests-fuzz; for the live-daemon integration test use
## privleap-tests-e2e. Targets the installed privleap by default; set
## PRIVLEAP_REPO to a derivative-maker checkout to test that tree instead.
## Works installed (/usr/share/privleap-tests) or from a git checkout.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/privleap-tests" ]; then
  tests_dir="${script_dir}/../share/privleap-tests"
else
  tests_dir='/usr/share/privleap-tests'
fi

overall=0
saw_pass=0
core_pass=0
shim_skipped=0

## style-ok: allow-python-interpreter -- run through PATH python3 for venv/user-site test deps
run_one() {
  local rc=0
  python3 -- "$@" || rc=$?
  if [ "${rc}" = '77' ]; then
    ## TAP/automake "skipped"; only fatal if nothing else passed.
    return 0
  fi
  if [ "${rc}" != '0' ]; then
    overall=1
  else
    saw_pass=1
    ## A core in-process suite passed, so the privleap library IS present.
    ## The pytest lane cannot prove this (its module-level skip still exits 0),
    ## so it is the authority for "partial install vs privleap absent" below.
    core_pass=1
  fi
  return 0
}

## shim_test.py owns an INDEPENDENT skip: its 77 means /usr/libexec/privleap/
## shim.py is missing -- a PARTIAL install, not "privleap absent". shim.py is
## the component that performs the privilege change, so that skip is a real
## coverage hole, NOT the same benign "privleap not found" the other suites
## report. Record it separately: if privleap is otherwise present (saw_pass),
## a shim skip must surface as a FAIL rather than being absorbed as a normal
## skip and passing the run.
## style-ok: allow-python-interpreter -- run through PATH python3 for venv/user-site test deps
run_shim_suite() {
  local rc=0
  python3 -- "$@" || rc=$?
  if [ "${rc}" = '77' ]; then
    printf '%s\n' \
      'shim_test: SKIP -- shim.py missing; privilege-boundary tests did not run'
    shim_skipped=1
    return 0
  fi
  if [ "${rc}" != '0' ]; then
    overall=1
  else
    saw_pass=1
  fi
  return 0
}

run_pytest() {
  ## Run a Hypothesis property-test file via pytest. python3-pytest and
  ## python3-hypothesis are REQUIRED, not optional: both are in the CI apt
  ## list, so absence is a broken environment. Treating it as a skip let the
  ## whole suite report PASS with the property layer having run nothing --
  ## and pytest exits 0 for an all-skipped run, so the exit code alone does
  ## not distinguish "13 properties held" from "13 properties never ran".
  if ! python3 -c 'import pytest' 2>/dev/null; then
    printf '%s\n' 'FAIL: python3-pytest is required by this suite and is not installed.'
    overall=1
    return 0
  fi
  local rc=0
  python3 -m pytest --import-mode=importlib -q "$@" || rc=$?
  if [ "${rc}" = '0' ]; then
    saw_pass=1
  elif [ "${rc}" = '5' ]; then
    printf '%s\n' 'FAIL: pytest collected no tests; the property file is not being run.'
    overall=1
  else
    overall=1
  fi
  return 0
}

printf '%s\n' '################ parser fuzzer (in-process) ################'
run_one "${tests_dir}/parser_fuzz.py" --seed 1 --iterations 4000
printf '%s\n' ''
printf '%s\n' '############ authorization-engine property test ###########'
run_one "${tests_dir}/authorizer_test.py" --seed 1 --iterations 3000
printf '%s\n' ''
printf '%s\n' '############# daemon liveness regressions #################'
run_one "${tests_dir}/unit_test.py"
printf '%s\n' ''
printf '%s\n' '########## daemon control and lifecycle tests ##############'
run_one "${tests_dir}/daemon_test.py"
printf '%s\n' ''
printf '%s\n' '################ config parser tests ######################'
run_one "${tests_dir}/config_test.py"
printf '%s\n' ''
printf '%s\n' '################# client tool tests #######################'
run_one "${tests_dir}/client_test.py"
printf '%s\n' ''
printf '%s\n' '################### PAM shim tests ########################'
run_shim_suite "${tests_dir}/shim_test.py"
printf '%s\n' ''
printf '%s\n' '############### Hypothesis property tests ##################'
run_pytest "${tests_dir}/test_property.py"

printf '%s\n' ''
if [ "${overall}" != '0' ]; then
  printf '%s\n' 'privleap-tests: OVERALL RESULT: FAIL'
  exit 1
fi
if [ "${saw_pass}" = '0' ]; then
  printf '%s\n' 'privleap-tests: OVERALL RESULT: SKIPPED (privleap not found)'
  ## style-ok: allow-skip: privleap not found -- optional target absent
  exit 77
fi
if [ "${shim_skipped}" != '0' ] && [ "${core_pass}" != '0' ]; then
  ## privleap IS present (a core suite passed) yet the shim tests skipped: a
  ## partial install whose privilege-boundary suite never ran. Not a pass.
  ## When privleap is wholly absent (no core pass) the shim skip is the same
  ## benign "privleap not found" the SKIPPED path above reports, so it is only
  ## a failure when the library is present.
  printf '%s\n' \
    'privleap-tests: OVERALL RESULT: FAIL (shim.py missing; PAM shim tests did not run)'
  exit 1
fi
printf '%s\n' 'privleap-tests: OVERALL RESULT: PASS'
exit 0
