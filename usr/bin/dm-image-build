#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Build a derivative-maker image on the OVH host WITHOUT docker, in ONE command -- the proper
## entry point so the build invocation is never hand-rolled. Runs dm-build-official DIRECTLY
## (never docker/derivative-maker-docker-run): the docker wrapper's headless paths fail on
## container-only gaps (in-container ~/.ssh test; an in-container git smudge on
## qubes-template-whonix that git_sanity_test rejects), while a direct build sees the clean host
## tree. Runs as the invoking NON-root user (root_check refuses root, probes sudo); the
## build-steps sudo internally for root operations.
##
## Multi-user by design: every path is derived from the invoking user's HOME, and the
## cowbuilder base is per-user, so two users can build concurrently on the same host without
## colliding. Nothing is hardcoded to 'admin'.
##
## CI is deliberately UNSET. CI=true would run derivative-update -> git_sanity_test, which
## fails on a benign qubes-template-whonix submodule-merge smudge; and it is NOT needed here --
## the non-CI ~/.ssh precheck passes because this runs directly with HOME=the invoking user's
## home (which has ~/.ssh), and a non-CI native build is a REAL image (not a dry-run). The
## persistent-checkout cascade (configure pending dpkg, drop ephemeral signing tags, deep clean,
## submodule sync) leaves a clean pinned tree to build from.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"

flavor="kicksecure-lxqt"
target="iso"
freshness="current"
## amd64 ISO builds REQUIRE an explicit firmware choice (help-steps/parse-cmd: no default).
## false = include non-free firmware -> broadly bootable (real HW + VBox), the right default for
## a test/install ISO; true = Free-Software-only firmware.
freedom="false"
## Default false = a REAL image. --dry-run true forwards to dm-build-official (dummy images,
## ~35 min) -- the fast validation of the ref-landing + submodule + build spine before a ~1 h
## real build. Independent of the upload axis (which stays SIMULATED; --upload is never passed).
dry_run="false"
dir="${DM_IMAGE_BUILD_DIR:-${HOME}/derivative-maker}"

usage() {
   printf '%s\n' "usage: ${me} [--flavor F] [--target T] [--freshness frozen|current] [--freedom true|false] [--dry-run true|false] [--dir DIR]

Build a derivative-maker image on the OVH host, NO docker, from DIR (default
\${HOME}/derivative-maker). Defaults: --flavor kicksecure-lxqt --target iso
--freshness current --freedom false --dry-run false. --dry-run true builds dummy
images (fast pipeline check). Run as a sudo-capable NON-root user."
}

## Release loop/kpartx devices THIS user's own prior failed build leaked: grml-debootstrap's
## end-of-image `kpartx -d` exits 1 against a stale partition mapping, failing the whole build.
## Scoped to the invoking user's OWN build-output tree ($1 = "${HOME}/derivative-binary/"),
## NEVER a global '/derivative-binary/' match: on a shared host a CONCURRENT build by another
## user owns loops backing files under ITS OWN home, and releasing those would corrupt that
## peer's in-flight build. losetup -a lists every loop system-wide; we release only the ones
## whose backing file is under this build's own folder.
release_leaked_build_loops() {
   local prefix="$1" ld
   for ld in $(sudo --non-interactive losetup -a 2>/dev/null | grep -F -- "${prefix}" | cut -d: -f1 || true); do
      printf '%s\n' "${me}:   releasing ${ld}"
      sudo --non-interactive kpartx -d "${ld}" >/dev/null 2>&1 || true
      sudo --non-interactive losetup -d "${ld}" >/dev/null 2>&1 || true
   done
}

main() {
   while [ "$#" -ge 1 ]; do
      case "$1" in
         --flavor)
            flavor="$2"
            shift 2
            ;;
         --target)
            target="$2"
            shift 2
            ;;
         --freshness)
            freshness="$2"
            shift 2
            ;;
         --freedom)
            freedom="$2"
            shift 2
            ;;
         --dry-run)
            case "$2" in
               true | false)
                  dry_run="$2"
                  ;;
               *)
                  printf '%s\n' "${me}: ERROR: --dry-run must be true or false (got '$2')" >&2
                  exit 2
                  ;;
            esac
            shift 2
            ;;
         --dir)
            dir="$2"
            shift 2
            ;;
         --help|-h)
            usage
            exit 0
            ;;
         *)
            printf '%s\n' "${me}: ERROR: unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
      esac
   done

   if [ "${EUID}" = "0" ]; then
      printf '%s\n' "${me}: ERROR: do NOT run as root -- dm's root_check refuses it; run as a sudo-capable NON-root user." >&2
      exit 2
   fi
   [ -d "${dir}/.git" ] || { printf '%s\n' "${me}: ERROR: not a derivative-maker checkout: ${dir}" >&2; exit 2; }

   cd -- "${dir}"
   printf '%s\n' "${me}: build start $(date -u +%Y-%m-%dT%H:%M:%SZ) in ${dir}"
   printf '%s\n' "${me}: HEAD $(git rev-parse HEAD)"

   ## --- persistent-checkout cascade: leave a tree git_sanity_test + dm-check-unicode accept ---
   printf '%s\n' "${me}: cascade: configure pending dpkg"
   sudo --non-interactive dpkg-noninteractive --configure -a || true

   printf '%s\n' "${me}: cascade: release leaked build loop/kpartx devices (this user's tree only)"
   release_leaked_build_loops "${HOME}/derivative-binary/"

   ## Line-ending normalization FIRST: a stray core.autocrlf=true on the checkout CRLF-smudges text
   ## files on checkout, so git_sanity_test (1100_sanity-tests AND derivative-update) sees them
   ## "modified" and fails exit 3 (observed on qubes-template-whonix). Force it off (parent +
   ## submodules) BEFORE the reset/re-checkout below, which then lands clean LF content.
   printf '%s\n' "${me}: cascade: force core.autocrlf=false (avoid CRLF git_sanity_test smudge)"
   git config core.autocrlf false || true
   git submodule foreach --recursive 'git config core.autocrlf false || true' || true

   printf '%s\n' "${me}: cascade: drop ephemeral signing tags (parent + submodules)"
   git tag | grep -E '_[0-9a-f]{40}_|-developers-only' | xargs -r git tag -d || true
   git submodule foreach --recursive 'git tag | grep -E "_[0-9a-f]{40}_|-developers-only" | xargs -r git tag -d || true' || true

   printf '%s\n' "${me}: cascade: deep clean + submodule sync to pins"
   git clean -dfx || true
   git submodule foreach --recursive 'git reset --hard >/dev/null 2>&1 || true; git clean -dfx >/dev/null 2>&1 || true' || true
   git submodule update --init --recursive --force || true
   printf '%s\n' "${me}: tree status (expect empty):"
   git status --porcelain=v1 | head

   ## --- build: DIRECT (no docker), NATIVE arch (so a non-CI native build is a real image) ---
   local native_arch
   native_arch="$(dpkg --print-architecture)"
   printf '%s\n' "${me}: build: flavor=${flavor} target=${target} freshness=${freshness} freedom=${freedom} dry-run=${dry_run} arch=${native_arch} (direct, no docker, non-CI)"
   unset CI || true
   export dist_build_sign_and_tag=true
   export dist_build_target_arch="${native_arch}"
   export flavors_list="${flavor}"
   export dist_build_multi_target_list=""
   ## Per-user cowbuilder base so two users building concurrently do not collide on the shared
   ## default /var/cache/pbuilder base.cow (one build would clobber the other's chroot). Set the
   ## cache dir explicitly (honored verbatim by variables.d/70_cowbuilder.bsh) -- NOT --build-slot,
   ## which would also redirect the OUTPUT path that dm-release-test + the result harness read.
   local build_user
   build_user="$(id -un)"
   export cowbuilder_cache_dir="/var/cache/pbuilder/${build_user}"
   ## This is a test/install build on a host with NO release-server credentials; a failed
   ## dm-upload-images connection retries with linear backoff for ~7h. A real upload is an
   ## explicit opt-in ('--upload true'); the DEFAULT (not passed below) runs the FULL upload
   ## path (file-list build, target derivation, dm-prepare-release) with the transfer mocked,
   ## so the upload code is exercised yet nothing is sent to the release server. No
   ## credential is needed.

   ## Forward --dry-run only when true, so the default real-build invocation stays byte-identical.
   local -a build_args=(--target "${target}" --freshness "${freshness}" --freedom "${freedom}")
   [ "${dry_run}" != "true" ] || build_args+=(--dry-run true)

   local build_rc=0
   {
      ./help-steps/signing-key-create \
      && ./help-steps/sign-and-tag \
      && ./help-steps/dm-build-official "${build_args[@]}"
   } || build_rc=$?

   printf '%s\n' "${me}: build finished rc=${build_rc} $(date -u +%Y-%m-%dT%H:%M:%SZ)"
   printf '%s\n' "${me}: resulting images (newest first):"
   # shellcheck disable=SC2012  ## display-only newest-first listing; build-controlled filenames
   ls -t "${HOME}/derivative-binary/"*/*.iso 2>/dev/null | head -5 || printf '%s\n' "${me}: (no .iso found -- inspect the log)"
   printf '%s\n' "DM-IMAGE-BUILD-DONE rc=${build_rc}"
   exit "${build_rc}"
}

## Sourced (dm-image-build-tests) -> expose the functions without running; executed -> run.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
   main "$@"
fi
