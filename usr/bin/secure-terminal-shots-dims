#!/usr/bin/python3 -Bsu
## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Shell-invocation guard: under bash/sh the shebang is ignored and the `import`
## lines below would run as shell commands (`import` is ImageMagick -> XGrabServer,
## which freezes X). Re-exec under python3; inert as a string literal in python3.
"exec" "python3" "-Bsu" "$0" "$@"

## Dimension guard for the secure-terminal.github.io shot galleries: every <img> that
## references a gallery asset AND pins width/height in pixels must declare the asset's
## TRUE intrinsic dimensions. The shots are rendered at 2x device pixels and the page pins
## the full intrinsic size (the browser downscales for 1x) -- so a stale pin after a
## re-capture (a window/board/chrome size change) silently ships wrong-aspect, layout-
## shifting <img> tags. The sibling secure-terminal-shots-inventory checks that references
## RESOLVE (orphan/dangling); this checks that the pinned PIXELS match. Neither re-renders.
##
## Flags, per gallery <img>:
##   - a MISMATCH: declared width/height != the referenced asset's intrinsic pixels;
##   - a PARTIAL pin: exactly one of width/height in pixels (a half-pin still shifts layout
##     and blinds this guard to the other axis).
## It skips: non-gallery <img> (logos, favicons); a gallery <img> with NO width/height
## (unpinned -- deliberate responsive use is legitimate; inventory still guards existence);
## a non-integer dimension ('100%' etc. -- not a pixel pin); a dangling ref (inventory's job).
##
## --fix rewrites every drifted/partial gallery pin to the asset's intrinsic dimensions
## in place (a raw-text edit of the width/height values only; everything else byte-identical).
## This is what the capture driver runs right after pulling fresh shots into the site, so a
## re-capture that changes a shot's size can never silently leave a stale pin behind -- the
## exact drift this guard otherwise only reports. The READ-ONLY guard (no --fix) is the
## default and is what CI runs.
##
## Usage: secure-terminal-shots-dims [--fix] [SITE_DIR]
##   SITE_DIR defaults to ~/private-sources/secure-terminal.github.io (override with
##   SECURE_TERMINAL_SITE_REPO). Exit 0 = clean (or --fix applied), 1 = drift found (no --fix),
##   2 = usage/environment.

import os
import re
import shutil
import subprocess
import sys
from html.parser import HTMLParser

## width/height WITHIN a single <img> tag's own source text (which HTMLParser hands us via
## get_starttag_text(), so there is no comment / <script> / other-tag contamination). The
## boundary `(?<![-\w])` excludes data-width / data-height look-alikes; case-insensitive and
## either quote style; the FIRST match is the attribute the browser lays out with (HTML5).
_TAG_WIDTH = re.compile(r'(?i)(?<![-\w])width\s*=\s*(["\'])(\d+)\1')
_TAG_HEIGHT = re.compile(r'(?i)(?<![-\w])height\s*=\s*(["\'])(\d+)\1')

## A gallery shot is a terminal window / program output -- hundreds of px. A referenced asset
## smaller than this in either axis is a FAILED capture (a nothing-mapped grab trims to ~1x1),
## not a real shot: flag it, and never pin/re-pin to its bogus size (which would let a broken
## shot pass the guard, as a shipped 1x1 xterm.escape.webp once did). Matches the compositor
## capture's own degenerate threshold in wl-headless-lib.bash.
_MIN_SANE_PX = 20

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.realpath(__file__)), os.pardir, 'share', 'secure-terminal-shots'))
import shots_site_refs as ssr  # noqa: E402  (path set above so both install + checkout resolve)


def _pixels(raw):
    """The RAW width/height attribute as an integer pixel count, or None if it is absent or
    not a bare integer (so '100%'/'auto' are treated as 'not a pixel pin', not a partial one).
    Caps the digit count: a real pixel dimension is small, and CPython raises ValueError
    converting a >4300-digit string -- so a pathological huge-digit attribute is 'not a pixel
    pin' rather than an uncaught crash of the whole tool."""
    if raw is None:
        return None
    raw = raw.strip()
    if not raw.isdigit() or len(raw) > 6:
        return None
    return int(raw)


def _intrinsic(path):
    """(width, height) of the image via ImageMagick identify, or None if it cannot be read.
    '%w %h' on the first frame; a bad/corrupt asset -> None (reported as a failure)."""
    try:
        result = subprocess.run(
            ['identify', '-format', '%w %h', path + '[0]'],
            capture_output=True, text=True, check=False)
    except OSError:
        return None
    if result.returncode != 0:
        return None
    parts = result.stdout.split()
    if len(parts) < 2 or not (parts[0].isdigit() and parts[1].isdigit()):
        return None
    return int(parts[0]), int(parts[1])


class _ImgFixCollector(HTMLParser):
    """Locate each <img> tag for --fix using the SAME parser as the read-only guard, so the two
    never disagree. Records the tag's source position + exact source text (get_starttag_text)
    + its FIRST src/width/height (HTML5 first-wins). HTMLParser does not emit tags inside
    comments or <script>/<style>, so --fix cannot rewrite an <img> in a JS string or comment."""

    def __init__(self):
        super().__init__(convert_charrefs=False)
        self.hits = []

    def _record(self, tag, attrs):
        if tag != 'img':
            return
        src = width = height = None
        for name, value in attrs:
            if name == 'src' and src is None:
                src = value
            elif name == 'width' and width is None:
                width = value
            elif name == 'height' and height is None:
                height = value
        if src is None:
            return
        self.hits.append((self.getpos(), self.get_starttag_text(), src, width, height))

    def handle_starttag(self, tag, attrs):
        self._record(tag, attrs)

    def handle_startendtag(self, tag, attrs):
        self._record(tag, attrs)


def _rewrite_dims(raw, cw, ch):
    """Rewrite the FIRST real width/height value in one <img> tag's source to cw x ch, inserting
    a missing axis next to the present one. Operates only within the tag's own text, so no other
    tag/comment/script is touched. Returns the tag unchanged if neither axis is present."""
    have_w = _TAG_WIDTH.search(raw)
    have_h = _TAG_HEIGHT.search(raw)
    if have_w and have_h:
        raw = _TAG_WIDTH.sub(lambda m: 'width=%s%d%s' % (m.group(1), cw, m.group(1)), raw, count=1)
        raw = _TAG_HEIGHT.sub(lambda m: 'height=%s%d%s' % (m.group(1), ch, m.group(1)), raw, count=1)
    elif have_w:
        raw = _TAG_WIDTH.sub(
            lambda m: 'width=%s%d%s height="%d"' % (m.group(1), cw, m.group(1), ch), raw, count=1)
    elif have_h:
        raw = _TAG_HEIGHT.sub(
            lambda m: 'width="%d" height=%s%d%s' % (cw, m.group(1), ch, m.group(1)), raw, count=1)
    return raw


def _line_offsets(text):
    offsets = [0]
    for line in text.splitlines(keepends=True):
        offsets.append(offsets[-1] + len(line))
    return offsets


def _fix_page(html_path, site):
    """Rewrite drifted/partial gallery <img> pins in one page to intrinsic dimensions, using
    HTMLParser to locate each tag (so --fix and the read-only guard parse identically). Returns
    a list of (rel, 'WxH->WxH') change descriptions in document order; writes only if changed."""
    with open(html_path, encoding='utf-8') as handle:
        text = handle.read()
    collector = _ImgFixCollector()
    collector.feed(text)
    offsets = _line_offsets(text)
    edits = []
    for (line, col), raw, src, w_raw, h_raw in collector.hits:
        rel = ssr.resolve_ref(src, html_path, site)
        if rel is None or not ssr.in_gallery(rel):
            continue
        fpath = os.path.join(site, rel)
        if not os.path.isfile(fpath):
            continue  ## dangling reference -- secure-terminal-shots-inventory owns that
        w = _pixels(w_raw)
        h = _pixels(h_raw)
        ## a present-but-non-integer axis is not a pixel pin -- leave the tag alone
        if (w_raw is not None and w is None) or (h_raw is not None and h is None):
            continue
        if w_raw is None and h_raw is None:
            continue  ## unpinned -- leave responsive layout alone
        intrinsic = _intrinsic(fpath)
        if intrinsic is None:
            continue  ## unreadable -- the guard reports it; do not fabricate a pin
        cw, ch = intrinsic
        if cw < _MIN_SANE_PX or ch < _MIN_SANE_PX:
            continue  ## degenerate/broken asset -- do NOT pin to its bogus size; the guard flags it
        if w is not None and h is not None and (w, h) == (cw, ch):
            continue  ## already correct
        new_raw = _rewrite_dims(raw, cw, ch)
        if new_raw == raw:
            continue
        start = offsets[line - 1] + col
        if text[start:start + len(raw)] != raw:
            continue  ## defensive: only edit a span that really is this tag
        old = '%sx%s' % (w_raw if w_raw is not None else '-', h_raw if h_raw is not None else '-')
        edits.append((start, start + len(raw), new_raw, rel, '%s->%dx%d' % (old, cw, ch)))
    changes = []
    ## apply back-to-front so earlier offsets stay valid
    for start, end, new_raw, rel, delta in sorted(edits, key=lambda e: e[0], reverse=True):
        text = text[:start] + new_raw + text[end:]
        changes.append((rel, delta))
    if changes:
        with open(html_path, 'w', encoding='utf-8') as handle:
            handle.write(text)
    changes.reverse()  ## report in document order
    return changes


def main():
    fix = False
    positional = []
    for arg in sys.argv[1:]:
        if arg == '--fix':
            fix = True
        else:
            positional.append(arg)
    if len(positional) > 1:
        sys.stderr.write('usage: secure-terminal-shots-dims [--fix] [SITE_DIR]\n')
        return 2
    if shutil.which('identify') is None:
        sys.stderr.write("FATAL: ImageMagick 'identify' is required to read intrinsic dimensions\n")
        return 2
    try:
        site, _present = ssr.resolve_site(positional[0] if positional else None)
    except ssr.SiteError as exc:
        sys.stderr.write('FATAL: %s\n' % exc)
        return 2

    if fix:
        total = 0
        for html_path in ssr.iter_html_paths(site):
            for rel, delta in _fix_page(html_path, site):
                print('repinned %s: %s' % (rel, delta))
                total += 1
        print('ok: repinned %d gallery <img> dimension(s) to match their assets' % total)
        return 0

    try:
        pages = ssr.collect_from_pages(site, ssr.ImgDimCollector)
    except ssr.SiteError as exc:
        sys.stderr.write('FATAL: %s\n' % exc)
        return 2

    failures = []
    checked = 0
    seen = set()
    for html_path, collector in pages:
        for src, w_raw, h_raw in collector.images:
            rel = ssr.resolve_ref(src, html_path, site)
            if rel is None or not ssr.in_gallery(rel):
                continue
            fpath = os.path.join(site, rel)
            if not os.path.isfile(fpath):
                continue  ## dangling reference -- secure-terminal-shots-inventory owns that
            w = _pixels(w_raw)
            h = _pixels(h_raw)
            ## A present-but-non-integer dimension is not a pixel pin -- skip the whole <img>.
            if (w_raw is not None and w is None) or (h_raw is not None and h is None):
                continue
            if w_raw is None and h_raw is None:
                continue  ## unpinned -- legitimate; not this guard's concern
            key = (rel, w_raw, h_raw)
            if key in seen:
                continue
            seen.add(key)
            if w is None or h is None:
                failures.append('partial dimension pin (need both width+height in px): %s '
                                '(width=%r height=%r)' % (rel, w_raw, h_raw))
                continue
            intrinsic = _intrinsic(fpath)
            if intrinsic is None:
                failures.append('cannot read intrinsic dimensions (corrupt/unreadable): %s' % rel)
                continue
            if intrinsic[0] < _MIN_SANE_PX or intrinsic[1] < _MIN_SANE_PX:
                failures.append('degenerate/broken shot (%dx%d -- a failed capture, not a real shot): %s'
                                % (intrinsic[0], intrinsic[1], rel))
                continue
            checked += 1
            if (w, h) != intrinsic:
                failures.append('dimension mismatch: %s declares %dx%d but asset is %dx%d'
                                % (rel, w, h, intrinsic[0], intrinsic[1]))

    if failures:
        sys.stderr.write('secure-terminal-shots-dims: FAIL (%d)\n' % len(failures))
        for line in failures:
            sys.stderr.write('  ' + line + '\n')
        return 1
    print('ok: %d pinned gallery <img> dimensions match their assets' % checked)
    return 0


if __name__ == '__main__':
    sys.exit(main())
