#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Runs the open-link-confirmation security + unit test suite: drives the real
## sanitize-string over a hostile battery and asserts the confirmation dialog
## input stays display-safe (ASCII, length-capped, no control/ANSI), parses the
## sanitized output with the real Qt rich-text engine to catch markup-injection
## bypasses, statically audits the script, and unit-tests the env-over-config
## precedence of source_config(). No root, no network, no real browser; Qt runs
## offscreen and is skipped if PyQt5 is absent. Works installed (tests under
## /usr/share/open-link-confirmation-tests) or from a git checkout. Override the
## components under test with OPEN_LINK_CONFIRMATION_BIN and SANITIZE_STRING_BIN.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## Canonical suite exit: a lane that skips (PyQt5 absent -> env-unmet 78, or the
## subject predates a feature -> target-absent 77) surfaces per category instead
## of being counted as a failure or folded into a pass.
suite_exit_helper="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")/../share/dist-ai-tests-common/suite-exit.bash"
[ -r "${suite_exit_helper}" ] || suite_exit_helper='/usr/share/dist-ai-tests-common/suite-exit.bash'
# shellcheck source=../share/dist-ai-tests-common/suite-exit.bash
source "${suite_exit_helper}"

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/open-link-confirmation-tests" ]; then
   tests_dir="${script_dir}/../share/open-link-confirmation-tests"
else
   tests_dir='/usr/share/open-link-confirmation-tests'
fi

failed=0
target_absent=0
env_unmet=0
run_lane() {
   local rc=0
   "$@" || rc=$?
   case "${rc}" in
      0)
         ;;
      77)
         target_absent=$(( target_absent + 1 ))
         ;;
      78)
         env_unmet=$(( env_unmet + 1 ))
         ;;
      *)
         failed=$(( failed + 1 ))
         ;;
   esac
}

printf '%s\n' "=== open-link-confirmation security tests (python/Qt) ==="
run_lane "${tests_dir}/open_link_confirmation_test.py" "$@"

printf '%s\n' "=== open-link-confirmation env-override unit test (bash) ==="
run_lane "${tests_dir}/env_override_test.sh" "$@"

printf '%s\n' "=== open-link-confirmation error_handler dialog-failure unit test (bash) ==="
run_lane "${tests_dir}/error_handler_dialog_failure_test.sh" "$@"

suite_exit "${failed}" "${target_absent}" "${env_unmet}"
