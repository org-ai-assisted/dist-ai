#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Regression test for dm-gitlink-upstream-check's evaluator: runs its offline
## '--self-test' (stubbed resolver, no network, no derivative-maker checkout),
## which asserts a fork-only pin is reported and fails the run, a clean set
## passes, and a transient-error pin does not fail. Guards the check that closes
## the "fork-only gitlink lands on master via a GitHub PR merge" hole.
##
## Self-contained: exit 0 pass, non-zero fail. No source tree, no network.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

## errexit forwards a non-zero self-test result as this suite's failure.
"${script_dir}/dm-gitlink-upstream-check" --self-test
