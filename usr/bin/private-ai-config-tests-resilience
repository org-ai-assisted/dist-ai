#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Resilience lane of the private-ai-config test surface: failure injection against
## the durable background-work stack -- SIGKILL, OOM, API-down, stall detection
## via SIGSTOP, supervisor kill, and the wake-handler cgroup-detach property
## that keeps a wake from dying with the supervisor that raised it.
##
## Integration-only: every test drives transient 'systemd --user' units and
## reads the user journal, so it exits 77 (SKIP) in a container with no user
## manager. Targets a private-ai-config checkout via PRIVATE_AI_CONFIG_PATH.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/private-ai-config-tests" ]; then
   share="${script_dir}/../share/private-ai-config-tests"
else
   share='/usr/share/private-ai-config-tests'
fi

rc=0
bash -- "${share}/run-tests.sh" --lane resilience "$@" || rc=$?
exit "${rc}"
