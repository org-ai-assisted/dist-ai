#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Unattended Calamares LUKS install of a Kicksecure ISO, driven HOST-SIDE via
## vbox-guestctl (vboxapi IMouse/IKeyboard/IDisplay -- real mouse + screenshot in
## one pixel space, no guest agent). Boots the ISO in the UNRESTRICTED install
## session, drives Calamares to a full encrypted (LUKS) erase-disk install, boots
## the installed disk, unlocks LUKS, and verifies the installed system booted.
## Exit 0 = R3 (install completes + LUKS unlock) and R4 (boot installed) PASS; 5 = FAIL.
##
## Run as the per-VM test user (VBox state is per-$HOME): the account IS the
## isolation boundary. The GUI is driven by OCR text location (gui-drive.bsh), so it
## is resolution-independent -- a BIOS session at 1280x800 and an EFI/EFI+SB one at
## the GOP's 1920x1080 are both handled without fixed coordinates.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"
VBOXMANAGE="${VBOXMANAGE:-VBoxManage}"
GUESTCTL="${GUESTCTL:-vbox-guestctl}"
TESSERACT="${TESSERACT:-tesseract}"
PASS_RC=0
FAIL_RC=5
SETUP_RC=2

vm=""
iso=""
disk=""
passphrase=""
passphrase_file=""
firmware="efi"
reinstall="false"
checks="false"
## Set true once THIS run starts the VM, so the exit trap powers off only our VM.
vm_started="false"

die() {
   printf '%s: ERROR: %s\n' "${me}" "$2" >&2
   exit "$1"
}

## Power off the VM this run started, on ANY exit (incl. a die/timeout), so a
## failure never leaks a running headless VM. Preserves the exit status.
on_exit() {
   local rc=$?
   if [ "${vm_started}" = 'true' ]; then
      "${VBOXMANAGE}" controlvm "${vm}" poweroff >/dev/null 2>&1 || true
   fi
   exit "${rc}"
}

usage() {
   printf '%s\n' "usage: ${me} --vm NAME --iso PATH --passphrase-file PATH [--disk PATH]
       [--firmware bios|efi|efi-secureboot] [--reinstall]

--passphrase-file  0600 file holding the LUKS passphrase (read via the shell, never
                   passed on argv -- keeps it out of /proc/PID/cmdline; CWE-214).
--firmware   VM boot firmware (default efi; efi-secureboot enrolls PK+MS keys).
--reinstall  reuse the existing VM + disk (do not recreate) and install OVER it,
             switching to --firmware -- the R7 chain (BIOS install, then
             EFI+SB reinstall-over-LUKS: run once plain, once --reinstall).
--checks     after the installed boot, run the release-critical check battery
             in-guest (check 8: systemcheck --leak-tests) and fail on a non-pass."
}

## Shared headless-GUI driver (OCR + scancode + resolution-independent click): the
## same gui_scan/gui_ocr/gui_wait_for/gui_locate_word/gui_click_word used by the
## Whonix pair orchestrator, so the subtle OCR logic lives in ONE place.
lib_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"
if [ -f "${lib_dir}/../share/dm-image-boot-tests/gui-drive.bsh" ]; then
   gui_drive_lib="${lib_dir}/../share/dm-image-boot-tests/gui-drive.bsh"
else
   gui_drive_lib='/usr/share/dm-image-boot-tests/gui-drive.bsh'
fi
# shellcheck source=./usr/share/dm-image-boot-tests/gui-drive.bsh
source "${gui_drive_lib}"

## Wait for the GRUB menu (OCR), then select "UNRESTRICTED Session | ... install"
## (entry 3: 2x Down + Enter). A fixed early keypress races the ~14s autoboot and
## lands on the default USER session, where install-host refuses (wrong boot role).
select_install_boot_entry() {
   local deadline text
   deadline=$(( SECONDS + 40 ))
   while [ "${SECONDS}" -lt "${deadline}" ]; do
      text="$(gui_ocr)"
      if [[ "${text,,}" =~ unrestricted|"live iso"|"kicksecure live" ]]; then
         gui_scan e0 50 e0 d0
         gui_scan e0 50 e0 d0
         sleep 1
         gui_scan 1c 9c
         return 0
      fi
      sleep 2
   done
   die "${FAIL_RC}" "GRUB menu not detected"
}

## Wait for the INSTALLED system's GRUB "Choose boot mode" menu, then select entry 2
## (PERSISTENT Mode | SYSMAINT Session): 1x Down + Enter before the ~5s autoboot into
## the default USER entry. Sets boot-role=sysmaint for checks 2 + 3.
select_installed_sysmaint() {
   local deadline text
   deadline=$(( SECONDS + 60 ))
   while [ "${SECONDS}" -lt "${deadline}" ]; do
      text="$(gui_ocr)"
      if [[ "${text,,}" =~ choose[[:space:]]boot[[:space:]]mode|persistent[[:space:]]mode|sysmaint[[:space:]]session ]]; then
         gui_scan e0 50 e0 d0
         sleep 1
         gui_scan 1c 9c
         return 0
      fi
      sleep 2
   done
   die "${FAIL_RC}" "installed GRUB menu not detected (sysmaint select)"
}

## Poll until the LXQt desktop is up at a full resolution (>=1024 wide), i.e. past
## the 800x600 early-boot framebuffer. The exact mode does not matter -- the GUI is
## driven by OCR text location, not fixed coords. A Shift tap each round wakes a
## DPMS-blanked display (a long idle boot leaves it black at 800x600).
wait_ready() {
   local timeout="$1" deadline res width
   deadline=$(( SECONDS + timeout ))
   while [ "${SECONDS}" -lt "${deadline}" ]; do
      gui_scan 2a aa
      res="$("${GUESTCTL}" "${vm}" res 2>/dev/null || true)"
      width="${res% *}"
      if [[ "${width}" =~ ^[0-9]+$ ]] && [ "${width}" -ge 1024 ]; then
         return 0
      fi
      sleep 10
   done
   die "${FAIL_RC}" "desktop not ready (no full-resolution mode) after ${timeout}s"
}

## Open a terminal via the Ctrl+Alt+T global shortcut, RETRYING: the shortcut
## daemon (and the updatecheck popup) settle a few seconds after the desktop hits
## full resolution, so a single early keypress opens nothing.
open_terminal() {
   local deadline text last_fire=0
   ## The global-shortcut daemon settles ~20-30s AFTER the desktop hits full
   ## resolution, so a lone early Ctrl+Alt+T opens nothing; re-fire on a long
   ## interval (not every poll -- that spawns a stack of terminals).
   deadline=$(( SECONDS + 150 ))
   while [ "${SECONDS}" -lt "${deadline}" ]; do
      if [ "$(( SECONDS - last_fire ))" -ge 20 ]; then
         gui_scan 2a aa
         gui_scan 1d 38 14 94 b8 9d
         last_fire="${SECONDS}"
      fi
      sleep 5
      text="$(gui_ocr)"
      if [[ "${text,,}" =~ localhost|pts/|'[user' ]]; then
         return 0
      fi
   done
   die "${FAIL_RC}" "terminal did not open (Ctrl+Alt+T)"
}

## Run one release-critical check in-guest via the terminal and classify by an
## OCR marker. 0 PASS / 1 FAIL. Marker design (learned the hard way):
##  - ALL LETTERS, no digit: tesseract flakily misreads digits in the terminal font
##    (a '5' reads as 'S'), so a per-number marker like DMCHKPASS5 never matches.
##  - built from a shell var (DM${M}...) so the typed command ECHO does not itself
##    contain the literal marker -- else a poll matches before the command even runs.
##  - `clear` first so a PRIOR check's marker cannot cross-match this one.
run_check() {
   local num="$1" cmd="$2" timeout="$3" deadline text
   printf '%s' "clear; M=CHK; ${cmd} && echo DM\${M}PASSMARK || echo DM\${M}FAILMARK" \
      | "${GUESTCTL}" "${vm}" type-stdin >/dev/null
   gui_scan 1c 9c
   ## let `clear` + the command run before the first OCR (so the command echo, which
   ## holds the literal-var marker, is gone and only real output is on screen).
   sleep 3
   deadline=$(( SECONDS + timeout ))
   while [ "${SECONDS}" -lt "${deadline}" ]; do
      gui_scan 2a aa
      text="$(gui_ocr)"
      if [[ "${text,,}" =~ dmchkpassmark ]]; then
         printf '%s\n' "${me}: check ${num} PASS"
         return 0
      fi
      if [[ "${text,,}" =~ dmchkfailmark ]]; then
         printf '%s\n' "${me}: check ${num} FAIL"
         return 1
      fi
      sleep 10
   done
   die "${FAIL_RC}" "check ${num} did not complete in ${timeout}s"
}

parse_args() {
   while [ "$#" -gt 0 ]; do
      case "$1" in
         --vm)
            vm="$2"
            shift 2
            ;;
         --iso)
            iso="$2"
            shift 2
            ;;
         --disk)
            disk="$2"
            shift 2
            ;;
         --passphrase-file)
            passphrase_file="$2"
            shift 2
            ;;
         --firmware)
            firmware="$2"
            shift 2
            ;;
         --reinstall)
            reinstall="true"
            shift
            ;;
         --checks)
            checks="true"
            shift
            ;;
         -h|--help)
            usage
            exit 0
            ;;
         *)
            usage >&2
            die "${SETUP_RC}" "unexpected argument '$1'"
            ;;
      esac
   done
   [ -n "${vm}" ]         || { usage >&2; die "${SETUP_RC}" "--vm required"; }
   [ -n "${iso}" ]        || { usage >&2; die "${SETUP_RC}" "--iso required"; }
   [ -n "${passphrase_file}" ] || { usage >&2; die "${SETUP_RC}" "--passphrase-file required"; }
   [ -r "${passphrase_file}" ] || die "${SETUP_RC}" "passphrase file not readable: '${passphrase_file}'"
   ## read via the shell (no process argv exposure); command-subst strips trailing newlines.
   passphrase="$(< "${passphrase_file}")"
   [ -n "${passphrase}" ] || die "${SETUP_RC}" "passphrase file is empty: '${passphrase_file}'"
   case "${firmware}" in
      bios|efi|efi-secureboot)
         true
         ;;
      *)
         usage >&2
         die "${SETUP_RC}" "--firmware must be bios|efi|efi-secureboot, got '${firmware}'"
         ;;
   esac
   ## --reinstall reuses an existing VM+disk; a fresh install needs a disk path.
   [ -n "${disk}" ] || [ "${reinstall}" = 'true' ] \
      || disk="$(mktemp --tmpdir --dry-run "${vm}.XXXXXX.vdi")"
}

## Set the VM firmware; efi-secureboot also enrolls the platform + MS keys in the
## NVRAM store (VBox 7.x has no modifyvm --secure-boot). Done while powered off.
apply_firmware() {
   local fw
   case "${firmware}" in
      bios)
         fw='bios'
         ;;
      *)
         fw='efi'
         ;;
   esac
   "${VBOXMANAGE}" modifyvm "${vm}" --firmware "${fw}" >/dev/null
   if [ "${firmware}" = 'efi-secureboot' ]; then
      "${VBOXMANAGE}" modifynvram "${vm}" inituefivarstore >/dev/null
      "${VBOXMANAGE}" modifynvram "${vm}" enrollorclpk >/dev/null
      "${VBOXMANAGE}" modifynvram "${vm}" enrollmssignatures >/dev/null
      "${VBOXMANAGE}" modifynvram "${vm}" secureboot --enable >/dev/null
   elif [ "${firmware}" = 'efi' ]; then
      ## A plain-EFI --reinstall over a VM that was previously efi-secureboot would
      ## otherwise inherit Secure Boot ENABLED (firmware mode != VM state); disable
      ## it so plain EFI really is plain. Preserves the other NVRAM boot variables.
      ## Tolerated on a fresh VM whose varstore is not yet initialized (no-op there).
      "${VBOXMANAGE}" modifynvram "${vm}" secureboot --disable >/dev/null 2>&1 || true
   fi
}

build_vm() {
   "${VBOXMANAGE}" controlvm "${vm}" poweroff 2>/dev/null || true
   sleep 2
   if [ "${reinstall}" = 'true' ]; then
      ## R7 reinstall-over: keep the existing VM + its installed disk, switch
      ## firmware, and re-attach the ISO (the prior run detached it) so Calamares
      ## erase-reinstalls over the disk under the new firmware.
      apply_firmware
      "${VBOXMANAGE}" storageattach "${vm}" --storagectl IDE --port 0 --device 0 \
         --type dvddrive --medium "${iso}" >/dev/null
      return 0
   fi
   "${VBOXMANAGE}" unregistervm "${vm}" --delete 2>/dev/null || true
   safe-rm --force -- "${disk}"
   "${VBOXMANAGE}" createvm --name "${vm}" --ostype Debian_64 --register >/dev/null
   ## vmsvga+128 VRAM: else the desktop never draws headless. usbtablet+USB: give
   ## an absolute pointer so vbox-guestctl clicks land pre-Guest-Additions.
   "${VBOXMANAGE}" modifyvm "${vm}" --memory 4096 \
      --graphicscontroller vmsvga --vram 128 --mouse usbtablet --usb-ohci on \
      --nic1 nat >/dev/null
   apply_firmware
   "${VBOXMANAGE}" createmedium disk --filename "${disk}" --size 25600 \
      --format VDI >/dev/null 2>&1
   "${VBOXMANAGE}" storagectl "${vm}" --name SATA --add sata \
      --controller IntelAhci >/dev/null
   "${VBOXMANAGE}" storagectl "${vm}" --name IDE --add ide \
      --controller PIIX4 >/dev/null
   "${VBOXMANAGE}" storageattach "${vm}" --storagectl SATA --port 0 --device 0 \
      --type hdd --medium "${disk}" >/dev/null
   "${VBOXMANAGE}" storageattach "${vm}" --storagectl IDE --port 0 --device 0 \
      --type dvddrive --medium "${iso}" >/dev/null
}

main() {
   parse_args "$@"
   trap on_exit EXIT

   printf '%s\n' "${me}: build + boot install session"
   build_vm
   "${VBOXMANAGE}" startvm "${vm}" --type headless >/dev/null
   vm_started="true"
   ## Select the install boot entry once GRUB is actually on screen (poll, not a
   ## fixed sleep that races the autoboot into the wrong session).
   select_install_boot_entry

   printf '%s\n' "${me}: wait for the live desktop, then launch Calamares"
   ## Poll for the desktop instead of a blind sleep (keeps the display awake too).
   wait_ready 480
   open_terminal
   ## open_terminal already confirmed a terminal is up + focused; give it a moment
   ## to accept input, clear any partial line, type the launch command (paced ->
   ## reliable) and run it. No OCR-verify of the typed line: a fullscreen terminal
   ## (green-on-black, one line atop a large black screen) OCRs unreliably, which
   ## caused false "could not type" failures; the paced type is proven reliable.
   sleep 6
   gui_scan 1d 16 96 9d
   "${GUESTCTL}" "${vm}" type 'install-host' >/dev/null
   sleep 1
   ## foreground: install-host holds the terminal, Calamares opens as its own window.
   gui_scan 1c 9c
   gui_wait_for 'welcome to the calamares' 180 'Calamares Welcome page'

   printf '%s\n' "${me}: drive Calamares to a LUKS erase-disk install (OCR-located)"
   ## Each page is confirmed by its own CONTENT text (never a sidebar label -- those
   ## are always visible, so a sidebar match would falsely "pass" a page we never
   ## reached), then advanced by clicking the OCR-located Next/Install button. Every
   ## click target is found by text, so the whole drive is resolution-independent.
   gui_click_word 'next' 45 bottom 'Welcome Next'
   gui_wait_for 'region|system language' 60 'Location page'
   gui_click_word 'next' 45 bottom 'Location Next'
   gui_wait_for 'keyboard model|physical keyboard|default keyboard' 60 'Keyboard page'
   gui_click_word 'next' 45 bottom 'Keyboard Next'
   gui_wait_for 'erase disk' 60 'Partitions page'
   ## Erase disk is a clickable card; selecting it auto-enables Encrypt system
   ## (Kicksecure default), revealing the two LUKS fields. Locate each field by its
   ## placeholder text ("Passphrase" = 1st, "Confirm passphrase" = the Confirm one).
   gui_click_word 'erase' 30 1 'Erase disk option'
   ## The empty first "Passphrase" field is grey placeholder text that OCRs as
   ## garbage (conf 0), but the "Confirm passphrase" caption reads cleanly. So
   ## focus Confirm, then Shift+Tab to the adjacent Passphrase field (reliable tab
   ## order: Passphrase immediately precedes Confirm) -- no pixel coords, keeping
   ## the field entry resolution-independent like the rest of the drive.
   gui_click_word 'confirm' 45 1 'Confirm passphrase field'
   gui_scan 2a 0f 8f aa
   printf '%s' "${passphrase}" | "${GUESTCTL}" "${vm}" type-stdin >/dev/null
   sleep 1
   gui_scan 0f 8f
   printf '%s' "${passphrase}" | "${GUESTCTL}" "${vm}" type-stdin >/dev/null
   sleep 1
   gui_click_word 'next' 45 bottom 'Partitions Next'
   gui_wait_for 'overview|erase disk /dev|the following changes' 60 'Summary page'
   gui_click_word 'install' 45 bottom 'Summary Install'
   printf '%s\n' "${me}: installing (encrypted) -- polling for completion"
   gui_wait_for 'all done|has been installed|restart now' 1200 'install completion (check 0)'

   printf '%s\n' "${me}: reboot into the installed disk (detach ISO)"
   ## Install is finished at the "all done" page; we power off + detach the ISO +
   ## reboot ourselves, so no need to click the Finish/Done button first.
   "${VBOXMANAGE}" controlvm "${vm}" poweroff 2>/dev/null || true
   sleep 3
   "${VBOXMANAGE}" storageattach "${vm}" --storagectl IDE --port 0 --device 0 \
      --type dvddrive --medium none >/dev/null
   "${VBOXMANAGE}" startvm "${vm}" --type headless >/dev/null

   printf '%s\n' "${me}: unlock LUKS at boot (check 7)"
   gui_wait_for 'passphrase for disk|please unlock|luks' 120 'LUKS unlock prompt'
   printf '%s' "${passphrase}" | "${GUESTCTL}" "${vm}" type-stdin >/dev/null
   gui_scan 1c 9c

   printf '%s\n' "${me}: verify the installed system booted (R4)"
   gui_wait_for 'setup wizard|setup-wizard-dist|systemcheck' 180 'installed system first boot'

   if [ "${checks}" = 'true' ]; then
      printf '%s\n' "${me}: release-critical checks on the installed system (USER session)"
      wait_ready 300
      open_terminal
      ## check 1: the USER session booted -- past GRUB's default entry, so the sysmaint
      ## boot-role is ABSENT (the sysmaint reboot below asserts the positive case).
      run_check 1 '! grep -q boot-role=sysmaint /proc/cmdline' 60 \
         || die "${FAIL_RC}" "check 1 (user session boot) FAILED"
      ## check 5: CLI login works -- a shell responds with the logged-in account
      ## (pipe-free: a typed '|' proved unreliable through the guest keyboard).
      run_check 5 'whoami' 60 \
         || die "${FAIL_RC}" "check 5 (CLI login) FAILED"
      ## check 6: GUI login works -- the wlroots (labwc) compositor is running.
      run_check 6 'pgrep labwc' 60 \
         || die "${FAIL_RC}" "check 6 (GUI login) FAILED"
      ## check 4: networking -- reach the Debian mirror over the system route.
      run_check 4 'curl --silent --fail --max-time 30 --output /dev/null https://deb.debian.org' 90 \
         || die "${FAIL_RC}" "check 4 (networking) FAILED"
      ## check 8: systemcheck --leak-tests -- the core catastrophic-regression gate
      ## (exit 0 Success / 1 Error / 2 Warning; only a clean 0 passes). RETRY: on a
      ## fresh first boot sdwdate has not synced yet ("system-ready-check degraded"),
      ## a transient state systemcheck reports non-zero; let it settle. A persistent
      ## failure still dies loudly after the retries.
      local sc_ok='false' sc_try
      for sc_try in 1 2 3 4 5 6; do
         if run_check 8 'systemcheck --cli --leak-tests --verbose' 300; then
            sc_ok='true'
            break
         fi
         printf '%s\n' "${me}: check 8 not clean yet (attempt ${sc_try}); waiting for system-ready"
         sleep 60
      done
      [ "${sc_ok}" = 'true' ] \
         || die "${FAIL_RC}" "check 8 (systemcheck --leak-tests) FAILED after retries"

      ## checks 2 + 3 need the SYSMAINT session -- reboot + pick GRUB entry 2.
      printf '%s\n' "${me}: reboot into SYSMAINT session (checks 2, 3)"
      "${VBOXMANAGE}" controlvm "${vm}" poweroff 2>/dev/null || true
      sleep 3
      "${VBOXMANAGE}" startvm "${vm}" --type headless >/dev/null
      select_installed_sysmaint
      gui_wait_for 'passphrase for disk|please unlock|luks' 120 'LUKS unlock (sysmaint)'
      printf '%s' "${passphrase}" | "${GUESTCTL}" "${vm}" type-stdin >/dev/null
      gui_scan 1c 9c
      gui_wait_for 'setup wizard|setup-wizard-dist|systemcheck|sysmaint' 180 'sysmaint session boot'
      wait_ready 300
      open_terminal
      ## check 2: the SYSMAINT session booted (boot-role=sysmaint present in cmdline).
      run_check 2 'grep -q boot-role=sysmaint /proc/cmdline' 60 \
         || die "${FAIL_RC}" "check 2 (sysmaint session boot) FAILED"
      ## check 3: upgrade-nonroot works -- a broken updater = permanent stranding, so
      ## this is the second catastrophic-regression gate after check 8.
      run_check 3 'upgrade-nonroot' 1200 \
         || die "${FAIL_RC}" "check 3 (upgrade-nonroot) FAILED"
   fi

   printf '%s\n' "${me}: PASS -- R3 (install completes + LUKS unlock) and R4 (boot installed)"
   return "${PASS_RC}"
}

main "$@"
