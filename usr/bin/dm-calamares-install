#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Unattended Calamares LUKS install of a Kicksecure ISO, driven HOST-SIDE via
## vbox-ctl-local (vboxapi IMouse/IKeyboard/IDisplay -- real mouse + screenshot in
## one pixel space, no guest agent). Boots the ISO in the UNRESTRICTED install
## session, drives Calamares to a full encrypted (LUKS) erase-disk install, boots
## the installed disk, unlocks LUKS, and verifies the installed system booted.
## Exit 0 = R3 (install completes + LUKS unlock) and R4 (boot installed) PASS; 5 = FAIL.
##
## Run as the per-VM test user (VBox state is per-$HOME): the account IS the
## isolation boundary. The GUI is driven by OCR text location (gui-drive.bsh), so it
## is resolution-independent -- a BIOS session at 1280x800 and an EFI/EFI+SB one at
## the GOP's 1920x1080 are both handled without fixed coordinates.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"
VBOXMANAGE="${VBOXMANAGE:-VBoxManage}"
GUESTCTL="${GUESTCTL:-vbox-ctl-local}"
TESSERACT="${TESSERACT:-tesseract}"
PASS_RC=0
FAIL_RC=5
SETUP_RC=2

vm=""
iso=""
disk=""
passphrase=""
passphrase_file=""
firmware="efi"
## Opt-in experimental: boot via the coreboot+UefiPayload ROM (a generic EFI firmware, a
## drop-in for VBox's OVMF) instead of VBox's EFI. Set by --coreboot-rom; needs the patched
## CorebootRom-aware VBOXMANAGE. Default empty -> every default (bios/efi/efi-secureboot) lane
## is byte-unchanged. See ../share/dm-smbios-reader-boot-tests/dasharo-vbox-firmware-port.md.
coreboot_rom=""
## coreboot COM1 drain: VBox exposes a server-socket UART, drained by a bg client for the whole
## run (the firmware wedges on the 16550 THRE poll without a reader; it also reconnects across
## the install's power-cycles). PID + socket, reaped in on_exit.
cb_uart_sock=""
cb_drain_pid=""
## coreboot cpuid leaf 0x80000008 (phys/virt address sizes): advertise a sane 36-bit phys-addr
## width the UefiPayload needs. 5-tuple (leaf eax ebx ecx edx) for VBoxManage --cpuid-set.
## Mirrors dm-smbios-reader-vbox's CB_CPUIDSET (the reusable coreboot argv template).
cb_cpuidset=(0x80000008 0x00003024 0x791ef257 0x0000400f 0x00010000)
reinstall="false"
checks="false"
mok_enroll="false"
shot=""
## When set, milestone screenshots are dropped here as NN-<milestone>.png (the install
## "full story" the results plane publishes as an ordered sequence). Best-effort, like --shot.
shot_dir=""
## When set, the failing release check's own in-guest output is written here so the
## caller can publish it as the result step's stderr tail (why the run failed).
check_log=""
## When set, the firmware-lane evidence (DETECTED=, MATCH=, then the probe command/output) is
## written here for the results plane -- proof of the boot lane the guest actually ran.
firmware_evidence_file=""
## When true, a FAILED run leaves its VM running for post-mortem inspection instead of
## powering it off. The caller owns reclaiming it (dm-release-test does, next run).
keep_failed="false"
## Set true once THIS run starts the VM, so the exit trap powers off only our VM.
vm_started="false"
## Which LIVE GRUB entry to install from. Both provide install-host root; only
## these two can install (USER Session refuses -- no root). GRUB live menu order:
## USER(0), SYSMAINT(1), UNRESTRICTED(2) -> Down-count from the top.
live_session="unrestricted"
## Derived from live_session by parse_args: guestcontrol account the live session
## autologs in as, and Down-presses to its GRUB entry.
live_account="user"
live_downs=2
## Account quiesce_notifications/snap authenticate as: the LIVE session account
## during the Calamares drive, but the INSTALLED session's account (default 'user')
## for the post-reboot first-boot snapshot. Set at each phase boundary.
snap_account="user"
## Developer/test opt-in, all empty by default (no-op for a normal run):
## --launch-env VAR=VAL   extra env injected into install-host's Calamares launch
##                        (carried through its 'sudo --preserve-env'); repeatable.
## --pre-install-push L:G push host file/dir L into the live guest at absolute G
##                        BEFORE Calamares launches (so it lands in the overlayfs
##                        upperdir); repeatable.
## --pre-install-cmd CMD  run shell snippet CMD in the live guest as the live-session
##                        account BEFORE Calamares launches; repeatable.
launch_env=()
pre_install_push=()
pre_install_cmd=()

## The installer command, launched the way a user's click does: it must equal the Exec=
## line of live-config-dist's install-host.desktop, so the test drives the same entry
## point users do (pinned by live-config-dist-tests install_host_exec_pin_test.sh).
INSTALL_HOST_CMD='install-host'

## Last die() reason, read by on_exit to put the REAL cause (not a bare "FAILED (rc=N)") into
## the published check-log when a failure happens BEFORE the check battery (install/boot/launch).
die_reason=''
die() {
   die_reason="${2}"
   printf '%s\n' "${me}: ERROR: ${2}" >&2
   exit "$1"
}

## Indices of VM $1's configured NICs (nicN not "none"), one per line. The NIC count
## depends on the chipset (8 on PIIX3, 36 on ICH9), so read it instead of assuming.
vm_nic_indices() {
   "${VBOXMANAGE}" showvminfo "$1" --machinereadable \
      | sed --quiet --regexp-extended 's/^nic([0-9]+)="([^"]*)"$/\1 \2/p' \
      | awk '$2 != "none" { print $1 }'
}

## Power off the VM this run started, on ANY exit (incl. a die/timeout), so a
## failure never leaks a running headless VM. Preserves the exit status.
on_exit() {
   local rc=$?
   local stuck launch_out
   ## Reap the coreboot COM1 drain FIRST (best-effort; preserves rc). A no-op without --coreboot-rom.
   cb_drain_stop
   ## Final frame on a SUCCESSFUL run: the installed system's last on-screen state, captured
   ## while the VM is still alive (before the poweroff below). On a failure the stuck/99 frame
   ## below is the closing frame instead.
   if [ "${rc}" -eq 0 ] && [ "${vm_started}" = 'true' ]; then
      story_snap 70 final-last-frame
   fi
   ## On a FAILED run, surface WHY for the results plane: a gui_wait_for abort/timeout
   ## (install or boot failure, BEFORE the check battery) already saved the on-screen error
   ## to ${HOME}/${me}-stuck.png. Publish it as --shot (when no success shot was captured) and
   ## leave a reason in --check-log, so the page shows the Calamares error instead of a bare
   ## FAIL with no evidence. Best-effort: never let capture change the exit status.
   if [ "${rc}" -ne 0 ]; then
      stuck="${HOME}/${me}-stuck.png"
      ## Last-resort frame: if nothing captured a stuck shot (a failure BEFORE any
      ## gui_wait_for ran one -- e.g. guestcontrol never came up because Secure Boot
      ## blocked the live Guest Additions modules), grab the host-side framebuffer NOW,
      ## while the VM is still alive (before the poweroff below). GUESTCTL shot is the VBox
      ## IDisplay API, so it needs NO guest additions and works at any boot stage -- so
      ## EVERY failure publishes what was on screen, never an empty results page. Best-effort.
      if [ "${vm_started}" = 'true' ] && [ ! -s "${stuck}" ]; then
         capture_frame "${stuck}" >/dev/null 2>&1 || true
      fi
      ## State card at failure time (which VM state died) -- complements the 99 failure frame.
      if [ "${vm_started}" = 'true' ]; then
         story_card 98 failure-vm-state "FAILED (rc=${rc}): ${die_reason:-no reason recorded}"
      fi
      if [ -n "${shot}" ] && [ ! -s "${shot}" ] && [ -s "${stuck}" ]; then
         cp -- "${stuck}" "${shot}" 2>/dev/null || true
      fi
      ## Add the failure screen as the LAST milestone (99-) so the full-story sequence
      ## ends on the on-screen error, not a missing final frame. Best-effort.
      if [ -n "${shot_dir}" ] && [ -s "${stuck}" ] && [ ! -e "${shot_dir}/99-failure.png" ]; then
         cp -- "${stuck}" "${shot_dir}/99-failure.png" 2>/dev/null || true
      fi
      if [ -n "${check_log}" ] && [ ! -s "${check_log}" ]; then
         ## Lead with the REAL die() reason (why the install/boot/launch failed) so the page
         ## names the cause, not a bare rc. Only point at a screenshot ACTUALLY published (a
         ## non-empty ${shot} after the copy above) -- never a false 'see the published
         ## screenshot' when none was captured.
         local note="${me} FAILED (rc=${rc})"
         [ -n "${die_reason}" ] && note="${note}: ${die_reason}"
         if [ -n "${shot}" ] && [ -s "${shot}" ]; then
            note="${note} -- see the published screenshot for the on-screen error."
         else
            note="${note}."
         fi
         printf '%s\n' "${note}" > "${check_log}" 2>/dev/null || true
      fi
      ## install-host / Calamares launch log: the ONLY place a GUI that STARTED but never
      ## showed a window leaves its reason -- gc_wait_gui_started passes on the bare process,
      ## so the downstream OCR just times out with no cause. Fetch it while the VM is still
      ## alive (before the poweroff below) and surface it on BOTH the install log and the
      ## published check-log. Best-effort: a pre-guestcontrol failure has no log -> no-op.
      if [ "${vm_started}" = 'true' ]; then
         launch_out="$(gc_gui_launch_log "${live_account}" 2>/dev/null || true)"
         if [ -n "${launch_out}" ]; then
            printf '%s\n' \
               "${me}: install-host launch log (${GC_GUI_LAUNCH_LOG}):" \
               "${launch_out}" >&2
            if [ -n "${check_log}" ]; then
               printf '%s\n' "" "install-host launch log:" "${launch_out}" >> "${check_log}" 2>/dev/null || true
            fi
         fi
      fi
   fi
   if [ "${vm_started}" = 'true' ]; then
      if [ "${rc}" -ne 0 ] && [ "${keep_failed}" = 'true' ]; then
         ## Unplug every NIC: the shared dm-vm-lock is released on our exit, and a kept
         ## VM with live NAT would break the leak lanes' one-networked-VM exclusivity.
         ## Inspection uses guestcontrol (host channel), not the network.
         ## Fail safe: unless EVERY configured NIC is unplugged, power off instead.
         local nic unplugged='true' nic_rc=0 nic_out=''
         local -a nics=()
         ## Capture discovery's EXIT STATUS, do NOT discard it: showvminfo can emit PARTIAL
         ## output then die (pipefail makes vm_nic_indices return nonzero). A `|| true` would
         ## accept the truncated list as complete and leave an undiscovered NIC CONNECTED while
         ## claiming "unplugged" -- a leak. On any discovery failure, fail CLOSED (power off).
         nic_out="$(vm_nic_indices "${vm}" 2>/dev/null)" || nic_rc=$?
         if [ "${nic_rc}" -ne 0 ]; then
            unplugged='false'
         else
            [ -z "${nic_out}" ] || mapfile -t nics <<< "${nic_out}"
            [ "${#nics[@]}" -gt 0 ] || unplugged='false'
            for nic in "${nics[@]}"; do
               "${VBOXMANAGE}" controlvm "${vm}" "setlinkstate${nic}" off >/dev/null 2>&1 \
                  || unplugged='false'
            done
         fi
         if [ "${unplugged}" = 'true' ]; then
            printf '%s\n' "${me}: kept FAILED VM '${vm}' running for inspection, network unplugged (--keep-failed)" >&2
         elif "${VBOXMANAGE}" controlvm "${vm}" poweroff >/dev/null 2>&1; then
            printf '%s\n' "${me}: could not unplug every NIC of FAILED VM '${vm}'; powered it off instead" >&2
         else
            printf '%s\n' "${me}: ERROR: could not unplug every NIC of FAILED VM '${vm}' and its poweroff FAILED -- it may still be networked; power it off by hand: ${VBOXMANAGE} controlvm ${vm} poweroff" >&2
         fi
      else
         "${VBOXMANAGE}" controlvm "${vm}" poweroff >/dev/null 2>&1 || true
      fi
      ## Closing state card on a SUCCESSFUL run: the VM powered off (stands in for "back to the
      ## VirtualBox GUI" -- the server is headless, so there is no manager window to photograph).
      if [ "${rc}" -eq 0 ]; then
         story_card 71 vm-stopped-final "VM powered off (run complete)"
         ## Real VirtualBox Manager screenshot (end-of-story). The VM stays registered after
         ## poweroff, so it is still listed. NON-fatal: on_exit runs in the EXIT trap, where
         ## die() would skip the result publishing below; the begin-of-story call already
         ## proved the vbox-host-shot pipeline works this run, so a flaky final grab only warns.
         if ! story_vbox_manager 74 vbox-manager-final; then
            printf '%s\n' "${me}: WARNING: vbox-host-shot could not capture the final VirtualBox Manager" >&2
            if [ -n "${check_log}" ]; then
               printf '%s\n' "vbox-host-shot: final Manager capture failed" >> "${check_log}" 2>/dev/null || true
            fi
         fi
      fi
   fi
   ## Drop best-effort transient frames that came back uniform (success path). The skip-class
   ## grabs (firmware logo window, GRUB flashes, post-unlock/boot transitions, the final
   ## pre-poweroff frame) have NO guaranteed content: a quiet hardened boot is legitimately black
   ## between milestones. So a uniform skip frame is DROPPED -- never published as a black
   ## rectangle (the honesty concern), and never FAILING a correct run (the false-fail a blanket
   ## floor caused). image-blank-check runs on EVERY frame here (operator's "always check"), but
   ## the verdict is drop-vs-keep, not pass-vs-fail. The MUST-render milestones are a different
   ## matter: rich/sparse are gated IN main() above and FAIL on a degenerate frame, so a real
   ## render failure (black desktop / GUI / LUKS prompt) still fails the run there.
   if [ "${rc}" -eq 0 ] && [ -n "${shot_dir}" ]; then
      local blank_f blank_name
      for blank_f in "${shot_dir}"/*.png; do
         [ -f "${blank_f}" ] || continue
         blank_name="${blank_f##*/}"
         blank_name="${blank_name%.png}"
         blank_name="${blank_name#*-}"
         [ "$(milestone_blank_mode "${blank_name}")" = 'skip' ] || continue
         ## image-blank-check exits NONZERO when the frame is degenerate (uniform).
         if ! "${IMAGE_BLANK_CHECK:-image-blank-check}" --uniform-only "${blank_f}" >/dev/null 2>&1; then
            printf '%s\n' "${me}: NOTICE: dropping uniform transient frame ${blank_f##*/} (no content to publish)" >&2
            safe-rm --force -- "${blank_f}" 2>/dev/null || true
         fi
      done
   fi
   ## tear down the persistent GUI compositor last -- every capture_frame above needs labwc + the
   ## VirtualBoxVM window alive to grim-grab; restores global GUI/SuppressMessages, reaps pids/dirs.
   gui_compositor_stop
   exit "${rc}"
}

## Clear transient desktop notifications in the LIVE session before a milestone frame.
## The live desktop raises expected-but-racy notify-send passive popups that otherwise land
## nondeterministically in the shot and push the golden-screenshot diff past tolerance. Killing
## the LXQt notification daemon destroys its popup surfaces at once (it is D-Bus-activated, so it
## respawns clean for any later notification); the shot's own settle lets the compositor repaint
## without them. Best-effort in the 'user' session over guestcontrol (a GA-less installed disk,
## e.g. the first-boot milestone, simply no-ops) and SHORT-bounded so a guestcontrol hiccup can
## never stall or fail a passing install.
quiesce_notifications() {
   ## pkill --exact matches /proc/<pid>/comm, which the kernel truncates to 15 bytes
   ## (TASK_COMM_LEN), so the live daemon's comm is 'lxqt-notificati' -- NOT the full 18-char
   ## 'lxqt-notificationd'. Matching the full name kills NOTHING (the flake it fixes returns).
   ## Match the truncated comm; a plain-name match also cannot self-kill the gc_run bash (comm
   ## 'bash'), unlike a 'pkill -f lxqt-notificationd' which would match its own command line.
   gc_run "${snap_account}" 'pkill --exact lxqt-notificati >/dev/null 2>&1; true' 5 >/dev/null 2>&1 || true
}

## Capture a milestone screenshot into ${shot_dir} as NN-<name>.png when --shot-dir is set
## (the install "full story"). NN orders the sequence on the results page; <name> becomes the
## milestone caption (results-publish derives it from the filename). Best-effort: a capture
## failure (display 0x0, a transient guestcontrol hiccup) NEVER fails a passing install.
snap() {
   local nn="$1" name="$2"
   [ -n "${shot_dir}" ] || return 0
   quiesce_notifications
   local out="${shot_dir}/${nn}-${name}.png" mode tries i
   mode="$(milestone_blank_mode "${name}")"
   ## A rich (must-render) milestone can be captured uniform-black if the live display blanked
   ## during a long no-input wait -- notably the up-to-300s coreboot guestcontrol wait before
   ## live-guestcontrol-ready. A single key tap does NOT reliably wake the compositor, so WAKE
   ## (absolute mouse nudge via the usbtablet, inert without a click, plus a Shift tap) and RETRY
   ## until the frame carries content (same near-black gate main applies to rich shots) or a bounded
   ## number of tries. Non-rich milestones keep the single best-effort capture. A truly-off display
   ## still exhausts the retries and leaves a blank frame for main's gate to fail -- no false green.
   tries=1
   [ "${mode}" = 'rich' ] && tries=6
   for (( i = 1; i <= tries; i++ )); do
      "${GUESTCTL}" "${vm}" move 450 350 >/dev/null 2>&1 || true
      "${GUESTCTL}" "${vm}" key 2a aa >/dev/null 2>&1 || true
      ## Settle: let the compositor repaint the cleared surfaces (and the wake) before the frame.
      sleep 1
      capture_frame "${out}" >/dev/null 2>&1 || true
      [ "${mode}" = 'rich' ] || return 0
      "${IMAGE_BLANK_CHECK:-image-blank-check}" "${out}" >/dev/null 2>&1 && return 0
      sleep 2
   done
}

## Blank disposition for a milestone SCREENSHOT, by its <name>. Three dispositions; every frame
## is run through image-blank-check (operator's "always check"), but what a uniform frame MEANS
## differs: a must-render milestone that is blank is a real FAILURE, a best-effort transient that
## is blank just has nothing to show.
##   rich   -- the SETTLED post-quiesce snap() captures (desktop / Calamares GUI / first boot /
##             checks) + the restored graphical desktop; a near-black frame there means the GUI did
##             NOT render -> DEFAULT near-blank check (gated in main, FAILS the run). This is where
##             a blank-desktop false-green is caught. New must-be-rich milestones are added here.
##   sparse -- legitimately near-black but non-blank (the LUKS passphrase prompts) -> UNIFORM-ONLY
##             (gated in main; only a 1-colour truly-blank frame FAILS, the 2+ colour prompt passes).
##   skip   -- everything else: best-effort transient host-side grabs (firmware logo / GRUB /
##             post-unlock + boot transitions / installed first-frame / the final pre-poweroff
##             frame) with NO guaranteed content, legitimately uniform-black between milestones on
##             a quiet hardened boot. on_exit DROPS a uniform skip frame (not published, not
##             failed); a skip frame WITH content is published. vt-* (gated uniform-only by
##             require_vt_captures) and the dm-text-to-png cards (gated by the card gate) are
##             checked on their own paths in main and so are never black here.
milestone_blank_mode() {
   case "$1" in
      live-guestcontrol-ready|welcome|location|keyboard|partitions|partitions-luks-filled|summary|install-started|install-done|installed-grub-menu|first-boot|mok-reboot-desktop|terminal-open|sysmaint-terminal|check-6-gui-rendered|checks-complete|vt-graphical-restored)
         ## installed-grub-menu is hundreds of colours when the menu rendered (only a blank fails);
         ## sysmaint-terminal is captured right AFTER open_terminal OCR-confirms the terminal came
         ## up, so a black frame there is a real failure (symmetric with the user terminal-open).
         printf '%s' rich
         ;;
      luks-prompt|luks-passphrase-typed|sysmaint-luks-prompt)
         ## The LUKS passphrase PROMPT is on screen (captured right after gui_wait_for / the typed
         ## passphrase), so it is reliably non-uniform -> uniform-only catches a totally-blank
         ## prompt. (luks-unlocked is NOT here: it is a post-unlock transition captured on a fixed
         ## sleep and can be transient uniform-black, so it falls to skip -- unlock success is
         ## proven by the subsequent boot milestones, not by that frame.)
         printf '%s' sparse
         ;;
      *)
         printf '%s' skip
         ;;
   esac
}

## Capture a milestone FRAME host-side (VBox IDisplay, no guest additions) into
## ${shot_dir}/NN-name.png, WITHOUT snap()'s notification quiesce + settle. For boot / firmware /
## LUKS / transient screens: there is no live desktop to quiesce, and the quiesce's guestcontrol
## round-trip + settle would miss a short on-screen window (a ~5s GRUB autoboot, a firmware
## logo). Best-effort: a capture failure (display 0x0, no shot_dir) NEVER fails a passing run.
story_snap() {
   local nn="$1" name="$2"
   [ -n "${shot_dir}" ] || return 0
   capture_frame "${shot_dir}/${nn}-${name}.png" >/dev/null 2>&1 || true
}

## Poll the host framebuffer until it carries content (not a uniform near-black/white frame),
## then store it as the milestone frame; give up after a bounded window. For a SHORT-LIVED
## content frame whose moment is hard to time -- the VBox EFI firmware logo renders ~1s after
## power-on, then blacks out ~1s later for the GRUB mode switch -- a blind single shot races the
## window and usually grabs black. Polling at ${cadence} catches the frame while it is up and
## stores the FIRST non-uniform one. On timeout it leaves the last (blank) frame in place, so
## the universal floor still decides. Best-effort on shot_dir (no dir -> no-op).
##   nn name [timeout-seconds] [cadence-seconds]
story_snap_nonblank() {
   local nn="$1" name="$2"
   local timeout="${3:-${DM_CALAMARES_NONBLANK_TIMEOUT:-45}}"
   local cadence="${4:-2}"
   [ -n "${shot_dir}" ] || return 0
   local dest="${shot_dir}/${nn}-${name}.png" start="${SECONDS}"
   while : ; do
      capture_frame "${dest}" >/dev/null 2>&1 || true
      ## image-blank-check exits 0 when the frame is NOT degenerate (content present).
      if [ -s "${dest}" ] \
         && "${IMAGE_BLANK_CHECK:-image-blank-check}" --uniform-only "${dest}" >/dev/null 2>&1; then
         return 0
      fi
      [ "$(( SECONDS - start ))" -lt "${timeout}" ] || return 1
      sleep "${cadence}"
   done
}

## --- #18: full-VM-window story capture --------------------------------------------------------
## story_capture=window (default, operator "maximum faithful"): the VM runs in a maximized
## VirtualBoxVM GUI window inside a private headless labwc compositor the lane owns; every milestone
## frame is a grim grab of that window (full guest desktop + the real VirtualBox chrome). Driving +
## OCR stay on vbox-ctl-local (vboxapi, frontend-agnostic). story_capture=framebuffer: the legacy
## bare-guest-framebuffer grab (vbox-ctl-local shot) -- an escape hatch (STORY_CAPTURE=framebuffer).
## coreboot: the fork has no GUI frontend, so main() re-execs the whole lane inside a private mount
## namespace with the fork VBoxDD bind-mounted over /usr/lib/virtualbox and switches to STOCK tools
## (which then load the CorebootRom-aware device) -- no system mutation, auto-cleanup.
story_capture="${STORY_CAPTURE:-window}"
VBOX_VM_BIN="${VBOX_VM_BIN:-VirtualBoxVM}"
gui_labwc_pid=""
gui_vm_pid=""
gui_xdg_dir=""
gui_cfg_dir=""
gui_supmsg_was_set=""
gui_supmsg_saved=""

## coreboot + window: re-exec the lane in a private mount namespace with the fork VBoxDD bind-mounted
## (root-owned staged copies -- the hardened loader rejects a non-root app-priv lib), then run with
## STOCK VBOXMANAGE/GUESTCTL so the stock VirtualBoxVM/vboxapi/grim all load the coreboot device.
## Guarded by DM_GUI_NS_HELD so it re-execs once. No-op for stock lanes or framebuffer mode.
cb_gui_ns_reexec() {
   { [ "${story_capture}" = 'window' ] && [ -n "${coreboot_rom}" ] && [ -z "${DM_GUI_NS_HELD:-}" ]; } || return 0
   local forkbin stage l
   ## The coreboot fork's VBoxManage is given as an ABSOLUTE path (VBOXMANAGE=/.../bin/VBoxManage);
   ## its sibling fork .so files live in that same dir. A bare PATH name cannot locate them.
   if [ "${VBOXMANAGE#/}" = "${VBOXMANAGE}" ]; then
      die "${FAIL_RC}" "coreboot window capture needs VBOXMANAGE set to the fork's absolute VBoxManage path (got '${VBOXMANAGE}')"
   fi
   forkbin="$(cd -- "$(dirname -- "${VBOXMANAGE}")" && pwd)"
   stage="$(mktemp --directory --tmpdir "${me}-forklibs.XXXXXX")"
   for l in VBoxDD.so VBoxDD2.so VBoxVMM.so; do
      cp -p "${forkbin}/${l}" "${stage}/${l}"
      chown root:root "${stage}/${l}" 2>/dev/null || true
      chmod 0644 "${stage}/${l}"
   done
   export DM_GUI_NS_HELD=1 DM_GUI_NS_STAGE="${stage}"
   ## Inside the ns the stock tools are coreboot-capable, so drive the lane with them.
   export VBOXMANAGE=/usr/bin/VBoxManage VBOX_EXEC_VBOXMANAGE=/usr/bin/VBoxManage
   # style-ok: R-103 -- intentional re-exec into a mount namespace for the coreboot GUI display.
   ## DM_GUI_NS_STAGE must expand in the INNER namespace shell (exported above), not here.
   # shellcheck disable=SC2016
   exec unshare --mount -- bash -c '
      mount --make-rprivate / 2>/dev/null || true
      for lib in VBoxDD.so VBoxDD2.so VBoxVMM.so; do
         mount --bind "${DM_GUI_NS_STAGE}/${lib}" "/usr/lib/virtualbox/${lib}"
      done
      exec "$@"
   ' -- "$0" "$@"
}

## Start the private headless labwc compositor (maximize-on-map) the VM window renders in, and set
## WAYLAND_DISPLAY so grim + the launched GUI target it. window mode only. FATAL on failure -- a
## broken GUI pipeline must surface before the ~40min install, not as silent blank milestones.
gui_compositor_start() {
   [ "${story_capture}" = 'window' ] || return 0
   gui_xdg_dir="$(mktemp --directory --tmpdir "${me}-gui-xdg.XXXXXX")"
   chmod 0700 -- "${gui_xdg_dir}"
   export XDG_RUNTIME_DIR="${gui_xdg_dir}"
   gui_cfg_dir="$(mktemp --directory --tmpdir "${me}-gui-cfg.XXXXXX")"
   cat > "${gui_cfg_dir}/rc.xml" <<'RCXML'
<?xml version="1.0"?>
<labwc_config><windowRules><windowRule identifier="*"><action name="Maximize"/></windowRule></windowRules></labwc_config>
RCXML
   WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1 WLR_HEADLESS_OUTPUTS=1 \
      labwc --config-dir "${gui_cfg_dir}" >/dev/null 2>&1 &
   gui_labwc_pid="$!"
   local sock="" _ cand
   for _ in $(seq 1 40); do
      for cand in "${gui_xdg_dir}"/wayland-*; do
         [ "${cand}" = "${cand%.lock}" ] || continue
         [ -S "${cand}" ] || continue
         sock="${cand}"
         break
      done
      [ -n "${sock}" ] && break
      kill -0 "${gui_labwc_pid}" 2>/dev/null || die "${FAIL_RC}" "story GUI: labwc exited before creating a socket"
      sleep 0.25
   done
   [ -n "${sock}" ] || die "${FAIL_RC}" "story GUI: labwc did not create a wayland socket"
   export WAYLAND_DISPLAY="${sock##*/}"
   wlr-randr --output HEADLESS-1 --custom-mode 1920x1080 >/dev/null 2>&1 || true
   ## suppress VBox hint popups (e.g. "auto capture keyboard") so they are not in the frame; save
   ## the global value first and restore it in gui_compositor_stop.
   local cur
   cur="$("${VBOXMANAGE}" getextradata global GUI/SuppressMessages 2>/dev/null || true)"
   case "${cur}" in
      "Value: "*)
         gui_supmsg_was_set="yes"
         gui_supmsg_saved="${cur#Value: }"
         ;;
      *)
         gui_supmsg_was_set="no"
         gui_supmsg_saved=""
         ;;
   esac
   "${VBOXMANAGE}" setextradata global GUI/SuppressMessages \
      "remindAboutAutoCapture,remindAboutMouseIntegration,remindAboutInputCapture,confirmInputCapture,remindAboutGoingFullscreen,remindAboutGoingSeamless,remindAboutPausedVMInput,remindAboutInaccessibleMedia,remindAboutGuestAdditionsAreNotActive" \
      >/dev/null 2>&1 || true
}

## Launch (or re-launch after a power-cycle) the VM in a maximized VirtualBoxVM GUI window in our
## compositor. The window frontend runs the VM; the lane keeps driving it via vbox-ctl-local.
gui_vm_launch() {
   local uuid
   uuid="$("${VBOXMANAGE}" showvminfo "${vm}" --machinereadable 2>/dev/null | sed -n 's/^UUID="\(.*\)"$/\1/p' | head -1)" || true
   [ -n "${uuid}" ] || die "${FAIL_RC}" "story GUI: could not resolve a UUID for VM '${vm}'"
   "${VBOXMANAGE}" setextradata "${uuid}" GUI/LastGuestSizeHint "1920,1040" >/dev/null 2>&1 || true
   QT_QPA_PLATFORM="wayland" "${VBOX_VM_BIN}" --startvm "${uuid}" >/dev/null 2>&1 &
   gui_vm_pid="$!"
}

## Start the VM for a (re)boot: a maximized GUI window (window mode) or headless (framebuffer mode).
## Replaces the bare `startvm --type headless`; re-launches the GUI window after a power-cycle.
start_vm_frontend() {
   if [ "${story_capture}" = 'window' ]; then
      [ -z "${gui_vm_pid}" ] || kill "${gui_vm_pid}" 2>/dev/null || true
      gui_vm_pid=""
      gui_vm_launch
   else
      "${VBOXMANAGE}" startvm "${vm}" --type headless >/dev/null
   fi
}

## Capture the current milestone frame to $1: the full VBox VM window (grim grab of our compositor,
## window mode) or the bare guest framebuffer (vbox-ctl-local, framebuffer mode). Best-effort at the
## call sites (|| true), matching the prior ${GUESTCTL} shot contract.
capture_frame() {
   if [ "${story_capture}" = 'window' ]; then
      grim "$1"
   else
      "${GUESTCTL}" "${vm}" shot "$1"
   fi
}

## Tear down the story GUI compositor + restore the global SuppressMessages. The VM itself is powered
## off by on_exit's existing controlvm poweroff; this reaps the frontend + compositor we started.
gui_compositor_stop() {
   [ "${story_capture}" = 'window' ] || return 0
   if [ "${gui_supmsg_was_set}" = 'yes' ]; then
      "${VBOXMANAGE}" setextradata global GUI/SuppressMessages "${gui_supmsg_saved}" >/dev/null 2>&1 || true
   elif [ "${gui_supmsg_was_set}" = 'no' ]; then
      "${VBOXMANAGE}" setextradata global GUI/SuppressMessages >/dev/null 2>&1 || true
   fi
   [ -z "${gui_vm_pid}" ] || kill "${gui_vm_pid}" 2>/dev/null || true
   [ -z "${gui_labwc_pid}" ] || kill "${gui_labwc_pid}" 2>/dev/null || true
   sleep 1
   [ -z "${gui_vm_pid}" ] || kill -KILL "${gui_vm_pid}" 2>/dev/null || true
   [ -z "${gui_labwc_pid}" ] || kill -KILL "${gui_labwc_pid}" 2>/dev/null || true
   [ -z "${gui_xdg_dir}" ] || safe-rm --recursive --force -- "${gui_xdg_dir}" 2>/dev/null || true
   [ -z "${gui_cfg_dir}" ] || safe-rm --recursive --force -- "${gui_cfg_dir}" 2>/dev/null || true
   [ -z "${DM_GUI_NS_STAGE:-}" ] || safe-rm --recursive --force -- "${DM_GUI_NS_STAGE}" 2>/dev/null || true
}

## Redact non-deterministic tokens (a kernel console timestamp like [    3.755312], a per-install
## LUKS UUID like luks-<uuid>) from a boot-console milestone frame, so the published screenshot is
## REPRODUCIBLE for golden comparison. Masks the matching OCR word boxes (the WHOLE word that
## matched, not the line), so the prompt stays legible and the frame stays non-uniform. The UUID
## pattern keys on the distinctive 'luks-' prefix ONLY, not the hex body: OCR garbles UUID hex
## (a 'S' for a '5', a '?' for a 'b'), so requiring N clean hex chars would miss the token it
## must mask -- but 'luks-' is deterministic boot-prompt text that OCRs reliably, and masking its
## whole word box covers the garbled UUID regardless. Best-effort: a missing tool / OCR hiccup
## leaves the frame unchanged and never fails a passing run. ${1} is the NN-name.png basename.
redact_boot_tokens() {
   local shot="${shot_dir}/$1"
   [ -n "${shot_dir}" ] && [ -s "${shot}" ] || return 0
   "${IMAGE_REDACT_TOKENS:-image-redact-tokens}" \
      --pattern '[0-9]+\.[0-9]{6}' --pattern 'luks-' \
      -- "${shot}" >/dev/null 2>&1 || true
}

## Render a host-side "state card" for a point with no framebuffer worth a photo (the VM defined
## but not booted, the VM powered off, a Secure Boot / MOK state that has no on-screen UI). The
## card is a small PNG of selected `VBoxManage showvminfo` fields, captioned so it is never
## mistaken for a screenshot. Uses dm-text-to-png (ImageMagick-backed). Best-effort: if the
## renderer or VBoxManage data is unavailable, no card is written and the run is unaffected.
story_card() {
   local nn="$1" name="$2" title="$3"
   local info card
   [ -n "${shot_dir}" ] || return 0
   info="$("${VBOXMANAGE}" showvminfo "${vm}" --machinereadable 2>/dev/null \
      | grep -iE '^(VMState|firmware|chipset|memory|vram|SecureBoot|nvram|"SATA|"IDE|nic1)=' \
      | head -20)" || true
   [ -n "${info}" ] || return 0
   card="${shot_dir}/${nn}-${name}.png"
   printf '%s\n' "[state card -- rendered from VBoxManage showvminfo, not a screenshot]" \
      "${title}" "" "${info}" \
      | "${DM_TEXT_TO_PNG:-dm-text-to-png}" "${card}" >/dev/null 2>&1 || true
}

## Host / hypervisor evidence card. The OVH server is headless (an onboard BMC VGA chip, no
## desktop GPU, no display server), so there is NO VirtualBox Manager window to photograph. The
## honest substitute is the host + hypervisor facts rendered as a card, clearly labelled as
## rendered facts (not a screenshot). Only STABLE fields are shown -- the volatile "Host time",
## "Memory available", processor speed are excluded so the card is reproducible (no wall-clock /
## fluctuating value in the published frame). Best-effort: no shot_dir / no data -> no-op.
story_card_host() {
   local nn="$1" name="$2"
   local card ver host
   [ -n "${shot_dir}" ] || return 0
   ver="$("${VBOXMANAGE}" --version 2>/dev/null)" || true
   host="$("${VBOXMANAGE}" list hostinfo 2>/dev/null \
      | grep -iE 'Processor (online count|core count|description)|Memory size|Operating system' \
      | head -10)" || true
   [ -n "${ver}${host}" ] || return 0
   card="${shot_dir}/${nn}-${name}.png"
   printf '%s\n' "[host evidence -- rendered from VBoxManage, not a screenshot]" \
      "VirtualBox host software" "" "VBoxManage version: ${ver}" "" "${host}" \
      | "${DM_TEXT_TO_PNG:-dm-text-to-png}" "${card}" >/dev/null 2>&1 || true
}

## Real host-side screenshot of the VirtualBox Manager (machine list + Details pane, our VM
## selected) via vbox-host-shot (headless labwc + grim; no X11, no GPU, no login session). The
## begin-of-story call is FATAL (a black/blank/no-grab Manager shot means the GUI pipeline is
## broken -- surface it before the ~30-50min install, never publish a silent blank); the
## end-of-story caller keeps it non-fatal (EXIT trap). A no-op without --shot-dir.
story_vbox_manager() {
   local nn="$1" name="$2"
   [ -n "${shot_dir}" ] || return 0
   vbox-host-shot manager --vm "${vm}" --vboxmanage "${VBOXMANAGE}" \
      --out "${shot_dir}/${nn}-${name}.png"
}

usage() {
   printf '%s\n' "usage: ${me} --vm NAME --iso PATH --passphrase-file PATH [--disk PATH]
       [--firmware bios|efi|efi-secureboot] [--reinstall] [--mok-enroll]

--passphrase-file  0600 file holding the LUKS passphrase (read via the shell, never
                   passed on argv -- keeps it out of /proc/PID/cmdline; CWE-214).
--firmware   VM boot firmware (default efi; efi-secureboot enrolls PK+MS keys).
--reinstall  reuse the existing VM + disk (do not recreate) and install OVER it,
             switching to --firmware -- the R7 chain (BIOS install, then
             EFI+SB reinstall-over-LUKS: run once plain, once --reinstall).
--mok-enroll run the Calamares opt-in Secure Boot MOK setup (MOK_ENROLL=1): the
             installed system generates a per-machine MOK and DKMS-signs tirdad;
             the harness then reads the public cert off the installed disk on the
             HOST (vbox-disk-extract, read-only) and enrolls it ('VBoxManage
             modifynvram enrollmok'), then reboots so tirdad loads under Secure
             Boot. Requires EFI firmware, and a sudo-capable user (host disk mount).
--checks     after the installed boot, run the release-critical check battery
             in-guest (check 8: systemcheck) and fail on a non-pass.
--shot PATH  capture a screenshot of the installed system's first boot (R4) to PATH
             (for the results plane); best-effort, never fails the install.
--shot-dir D capture milestone screenshots as D/NN-<milestone>.png across the install
             (welcome, partitions, summary, install-done, first-boot) -- the 'full story'
             the results plane renders as an ordered sequence; best-effort like --shot.
--keep-failed on a FAILED run leave the VM running for post-mortem inspection
             (default: power it off). The caller reclaims it.
--live-session sysmaint|unrestricted  which LIVE boot entry to install from
             (default unrestricted). Both grant install-host root; USER Session
             cannot install.
--launch-env VAR=VAL   inject extra env into install-host's Calamares launch
             (carried through its 'sudo --preserve-env'), e.g. DEVOVERLAY=true for
             the opt-in overlay-squashfs pack. Repeatable.
--pre-install-push LOCAL:GUEST  push host file/dir LOCAL into the live guest at
             absolute GUEST BEFORE Calamares launches (lands in the overlayfs
             upperdir; copyto restores a script's +x). Repeatable.
--pre-install-cmd CMD  run shell snippet CMD in the live guest as the live-session
             account BEFORE Calamares launches. Repeatable."
}

## Shared headless-GUI driver (OCR + scancode + resolution-independent click): the
## same gui_scan/gui_ocr/gui_wait_for/gui_locate_word/gui_click_word used by the
## Whonix pair orchestrator, so the subtle OCR logic lives in ONE place.
lib_dir="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")"
if [ -f "${lib_dir}/../share/dm-smbios-reader-boot-tests/gui-drive.bsh" ]; then
   gui_drive_lib="${lib_dir}/../share/dm-smbios-reader-boot-tests/gui-drive.bsh"
else
   gui_drive_lib='/usr/share/dm-smbios-reader-boot-tests/gui-drive.bsh'
fi
# shellcheck source=./usr/share/dm-smbios-reader-boot-tests/gui-drive.bsh
source "${gui_drive_lib}"

## The SINGLE source of truth for the numbered release-critical checks, shared with
## dm-upgrade-regression's R6 upgrade gate. The --checks battery iterates this table
## with run_check as the OCR executor, so the install gate and the upgrade gate can
## never disagree about what a release-critical check IS.
if [ -f "${lib_dir}/../share/dm-smbios-reader-boot-tests/release-checks.bsh" ]; then
   release_checks_lib="${lib_dir}/../share/dm-smbios-reader-boot-tests/release-checks.bsh"
else
   release_checks_lib='/usr/share/dm-smbios-reader-boot-tests/release-checks.bsh'
fi
# shellcheck source=./usr/share/dm-smbios-reader-boot-tests/release-checks.bsh
source "${release_checks_lib}"

## select_installed_sysmaint: the single-source GRUB boot-mode selector, shared with
## dm-upgrade-regression's vbox-session.bsh so the install gate and the upgrade gate
## drive the installed system's boot menu identically (one source, no drift copy).
if [ -f "${lib_dir}/../share/dm-smbios-reader-boot-tests/grub-boot-select.bsh" ]; then
   grub_boot_select_lib="${lib_dir}/../share/dm-smbios-reader-boot-tests/grub-boot-select.bsh"
else
   grub_boot_select_lib='/usr/share/dm-smbios-reader-boot-tests/grub-boot-select.bsh'
fi
# shellcheck source=./usr/share/dm-smbios-reader-boot-tests/grub-boot-select.bsh
source "${grub_boot_select_lib}"

## guestcontrol layer (gc_run/gc_launch_gui/wait_guestcontrol_ready), shared with
## dm-upgrade-regression. The live ISO squashfs ships VBoxService (Guest Additions
## installed from the bundled virtualbox-guest-additions-iso at build), so install-host
## launches DIRECTLY via guestcontrol -- no fragile OCR terminal + blind-typed line.
## Sourced after gui-drive.bsh + grub-boot-select.bsh (it uses gui_* + select_installed_sysmaint).
if [ -f "${lib_dir}/../share/dm-smbios-reader-boot-tests/vbox-session.bsh" ]; then
   vbox_session_lib="${lib_dir}/../share/dm-smbios-reader-boot-tests/vbox-session.bsh"
else
   vbox_session_lib='/usr/share/dm-smbios-reader-boot-tests/vbox-session.bsh'
fi
# shellcheck source=./usr/share/dm-smbios-reader-boot-tests/vbox-session.bsh
source "${vbox_session_lib}"

## Wait for the GRUB menu (OCR), then select "UNRESTRICTED Session | ... install"
## (entry 3: 2x Down + Enter). A fixed early keypress races the ~14s autoboot and
## lands on the default USER session, where install-host refuses (wrong boot role).
select_install_boot_entry() {
   local deadline text i
   deadline=$(( SECONDS + 40 ))
   while [ "${SECONDS}" -lt "${deadline}" ]; do
      text="$(gui_ocr)"
      if [[ "${text,,}" =~ unrestricted|"live iso"|"kicksecure live" ]]; then
         ## The GRUB menu is on screen now (matched this poll) -- capture it, then the
         ## highlighted entry after the Down presses, before committing with Enter.
         story_snap 20 live-grub-menu
         for (( i = 0; i < live_downs; i++ )); do
            gui_scan e0 50 e0 d0
         done
         sleep 1
         story_snap 21 live-grub-entry-selected
         gui_scan 1c 9c
         printf '%s\n' "${me}: selected LIVE '${live_session}' install entry (${live_downs} down)" >&2
         return 0
      fi
      sleep 2
   done
   die "${FAIL_RC}" "GRUB menu not detected"
}

## coreboot writes its UEFI varstore to the VM .nvram in coreboot FMAP format, which VBox's
## NVRAM store CANNOT reload on a later power-on (fails VERR_TAR_BAD_CHKSUM_FIELD -> the VM won't
## start at all). The coreboot UefiPayload boot manager boots the installed disk by SCANNING the
## ESP -- it needs no persistent UEFI varstore -- so drop the stale .nvram before a restart and
## let VBox regenerate a fresh default. No-op without --coreboot-rom (VBox's own OVMF reloads its
## tar-format nvram fine). EFI-only: a coreboot Secure Boot / MOK varstore would need persistence,
## but the coreboot lane is plain --firmware efi.
cb_reset_nvram() {
   [ -n "${coreboot_rom}" ] || return 0
   local cfg vmdir nvram
   cfg="$("${VBOXMANAGE}" showvminfo "${vm}" --machinereadable 2>/dev/null \
      | sed -n 's/^CfgFile="\(.*\)"$/\1/p')"
   ## A registered VM always has a CfgFile; its absence means the reset cannot run, which would
   ## leave the un-reloadable FMAP nvram in place -> fail at the source, not cryptically at startvm.
   [ -n "${cfg}" ] || die "${FAIL_RC}" "cb_reset_nvram: no CfgFile for VM '${vm}' -- cannot drop the coreboot FMAP nvram"
   vmdir="$(dirname -- "${cfg}")"
   ## Remove each .nvram; no file yet (first boot) is fine, a failed removal is NOT -- the stale
   ## nvram would then fail the next startvm (VERR_TAR_BAD_CHKSUM_FIELD), so report it here.
   for nvram in "${vmdir}"/*.nvram; do
      [ -e "${nvram}" ] || continue
      safe-rm --force -- "${nvram}" \
         || die "${FAIL_RC}" "cb_reset_nvram: failed to remove stale coreboot nvram '${nvram}'"
   done
}

## Reboot the installed disk into ROLE (user = default GRUB entry; sysmaint = entry 2),
## unlock LUKS, wait for the desktop, and open a terminal ready for checks.
reboot_installed() {
   local role="$1"
   "${VBOXMANAGE}" controlvm "${vm}" poweroff 2>/dev/null || true
   sleep 3
   cb_reset_nvram
   start_vm_frontend
   if [ "${role}" = 'sysmaint' ]; then
      select_installed_sysmaint
   fi
   gui_wait_for 'passphrase for disk|please unlock|luks' 120 "LUKS unlock (${role})"
   if [ "${role}" = 'sysmaint' ]; then
      story_snap 63 sysmaint-luks-prompt
      redact_boot_tokens 63-sysmaint-luks-prompt.png
   fi
   printf '%s' "${passphrase}" | "${GUESTCTL}" "${vm}" type-stdin >/dev/null
   gui_scan 1c 9c
   wait_ready 300
   open_terminal
   if [ "${role}" = 'sysmaint' ]; then
      story_snap 64 sysmaint-terminal
   fi
}

## --mok-enroll: read the installed system's per-machine MOK public cert off the
## disk ON THE HOST and enroll it into the VM's UEFI varstore, so Secure Boot trusts
## the DKMS-signed modules (tirdad) on the next boot. The VM is powered off, so
## vbox-disk-extract mounts the (LUKS) disk read-only with the install passphrase --
## no guest cooperation, no Guest Additions, no in-guest scripting. Needs root for
## the host mount, hence a sudo-capable user. enrollmok only adds a key, so Secure
## Boot stays enabled; the final reboot lands a correctly-booted system for checks.
mok_host_enroll() {
   printf '%s\n' "${me}: --mok-enroll: read MOK cert off the installed disk (host) + enroll"
   "${VBOXMANAGE}" controlvm "${vm}" poweroff 2>/dev/null || true
   sleep 3
   local der uuid req_dir
   der="$(mktemp --tmpdir "${vm}.XXXXXX.der")"
   ## Read the MOK PUBLIC cert off the installed disk as root WITHOUT host sudo: a
   ## dm-release-test runner is deliberately sudo-less (vboxusers only, never sysmaint),
   ## so escalate ONLY this one read via the narrow privleap action 'vbox-disk-extract-mok'
   ## -- its arg-scoped wrapper reads ONLY this caller's own VM disk and ONLY the public
   ## /var/lib/dkms/mok.pub. The request (disk path + LUKS passphrase) is handed over in the
   ## caller-owned request dir (0700, under the account's CANONICAL home so it matches the
   ## wrapper's getent-derived path); privleap identifies the caller by SO_PEERCRED.
   req_dir="$(getent passwd "$(id -u)" | cut -d: -f6)/.cache/vbox-mok-extract"
   # shellcheck disable=SC2174
   mkdir --parents --mode=0700 -- "${req_dir}"
   printf '%s' "${disk}" > "${req_dir}/disk"
   cp --force -- "${passphrase_file}" "${req_dir}/passphrase"
   chmod 0600 -- "${req_dir}/disk" "${req_dir}/passphrase"
   leaprun vbox-disk-extract-mok > "${der}" \
      || { safe-rm --force -- "${req_dir}/disk" "${req_dir}/passphrase" 2>/dev/null || true
           die "${FAIL_RC}" "could not read /var/lib/dkms/mok.pub off the installed disk via the 'vbox-disk-extract-mok' privleap action (did the MOK module run during install? is the action installed and the runner in vboxusers?)"; }
   safe-rm --force -- "${req_dir}/disk" "${req_dir}/passphrase" 2>/dev/null || true
   [ -s "${der}" ] || die "${FAIL_RC}" "extracted MOK cert '${der}' is empty"
   uuid="$(uuidgen)"
   "${VBOXMANAGE}" modifynvram "${vm}" enrollmok --mok="${der}" --owner-uuid="${uuid}" >/dev/null \
      || die "${FAIL_RC}" "VBoxManage modifynvram enrollmok failed"
   safe-rm --force -- "${der}"
   printf '%s\n' "${me}: MOK enrolled into the UEFI varstore (owner-uuid=${uuid})"
   ## Boot with the MOK now trusted so tirdad loads under Secure Boot.
   reboot_installed user
}

## Poll until the LXQt desktop is up at a full resolution (>=1024 wide), i.e. past
## the 800x600 early-boot framebuffer. The exact mode does not matter -- the GUI is
## driven by OCR text location, not fixed coords. A Shift tap each round wakes a
## DPMS-blanked display (a long idle boot leaves it black at 800x600).
##
## Resize-nudge fallback: GA's cooperative auto-resize (VBoxDRMClient driving vmwgfx) is
## the normal path and gets the first stretch untouched. Only if the desktop is STILL at
## the 800x600 framebuffer past the threshold is a one-shot host setvideomodehint issued --
## a nudge, NOT a forced pass: a guest whose resize is genuinely dead ignores it and this
## still dies at the deadline, and the downstream non-degenerate full-res shot gate
## (image-blank-check) still decides. Writes a RESIZE-NUDGE-USED marker when the nudge was
## needed, so a green that required it says so. Kills the post-reboot-churn resize flake.
wait_ready() {
   local timeout="$1" deadline res width start nudge_after nudged=0
   start="${SECONDS}"
   nudge_after="${DM_CALAMARES_RESIZE_NUDGE_AFTER:-$(( timeout / 3 ))}"
   deadline=$(( start + timeout ))
   while [ "${SECONDS}" -lt "${deadline}" ]; do
      gui_scan 2a aa
      res="$("${GUESTCTL}" "${vm}" res 2>/dev/null || true)"
      width="${res% *}"
      if [[ "${width}" =~ ^[0-9]+$ ]] && [ "${width}" -ge 1024 ]; then
         return 0
      fi
      ## One-shot on SUCCESS only: if the host rejects the hint (VM transiently locked / not
      ## running) leave nudged=0 so the next poll retries, and do NOT write the marker -- it
      ## must record a nudge that actually fired, never a failed attempt (no fabricated signal).
      if [ "${nudged}" -eq 0 ] && [ "$(( SECONDS - start ))" -ge "${nudge_after}" ]; then
         printf '%s\n' "${me}: NOTICE: full-res auto-resize not reached after ${nudge_after}s -- issuing one-shot setvideomodehint 1280x800 fallback nudge (GA must still honour it; the non-degenerate full-res shot gate still decides)"
         if "${VBOXMANAGE}" controlvm "${vm}" setvideomodehint 1280 800 32 >/dev/null 2>&1; then
            nudged=1
            if [ -n "${shot_dir}" ]; then
               printf '%s\n' "setvideomodehint 1280x800 fallback nudge issued after ${nudge_after}s (GA cooperative auto-resize did not reach full-res in time)" \
                  > "${shot_dir}/RESIZE-NUDGE-USED" 2>/dev/null || true
            fi
         fi
      fi
      sleep 10
   done
   die "${FAIL_RC}" "desktop not ready (no full-resolution mode) after ${timeout}s"
}

## Open a terminal via the Ctrl+Alt+T global shortcut, RETRYING: the shortcut
## daemon (and the updatecheck popup) settle a few seconds after the desktop hits
## full resolution, so a single early keypress opens nothing.
open_terminal() {
   local deadline text last_fire=0
   ## The global-shortcut daemon settles ~20-30s AFTER the desktop hits full
   ## resolution, so a lone early Ctrl+Alt+T opens nothing; re-fire on a long
   ## interval (not every poll -- that spawns a stack of terminals).
   deadline=$(( SECONDS + 150 ))
   while [ "${SECONDS}" -lt "${deadline}" ]; do
      if [ "$(( SECONDS - last_fire ))" -ge 20 ]; then
         gui_scan 2a aa
         gui_scan 1d 38 14 94 b8 9d
         last_fire="${SECONDS}"
      fi
      sleep 5
      text="$(gui_ocr)"
      if [[ "${text,,}" =~ localhost|pts/|'[user' ]]; then
         return 0
      fi
   done
   die "${FAIL_RC}" "terminal did not open (Ctrl+Alt+T)"
}

## Surface a failed check's OWN identity + in-guest output (otherwise lost on power-off): the
## exact command run, its exit code, and the captured output -- to stderr + the check log, so a
## failure is diagnosable (and the results page names the command + exit, not just an opaque
## "exit 5" install rc) without a re-run. The command + exit are ALWAYS known, so the check log
## is written even when the guest produced no output. Best-effort output read (a GA-less guest
## has no exec channel). Shared by both detect paths; the OCR fallback passes an empty rc.
run_check_report_failure() {
   local num="$1" session="$2" cmd="$3" rc="$4" out rc_label
   out="$(gc_run "${session}" "cat /var/tmp/dmcheck-${num}.out 2>/dev/null" 2>/dev/null || true)"
   case "${rc}" in
      ''|*[!0-9]*)
         rc_label='unknown (OCR fallback)'
         ;;
      *)
         rc_label="${rc}"
         ;;
   esac
   printf '%s\n' \
      "${me}: check ${num} (${RELEASE_CHECK_DESC[${num}]:-}) FAILED" \
      "${me}: command: ${cmd}" \
      "${me}: exit: ${rc_label}" >&2
   [ -n "${out}" ] && printf '%s\n' "${me}: check ${num} output (why it failed):" "${out}" >&2
   if [ -n "${check_log}" ]; then
      {
         printf '%s\n' "check ${num} (${RELEASE_CHECK_DESC[${num}]:-}) FAILED:"
         printf '%s\n' "command: ${cmd}"
         printf '%s\n' "exit: ${rc_label}"
         [ -n "${out}" ] && printf '%s\n' "" "output:" "${out}"
      } > "${check_log}"
   fi
}

## Run one release-critical check in-guest via the terminal and classify by its EXIT CODE.
## 0 PASS / 1 FAIL. Completion is detected PRIMARILY by polling an exit-code FILE over the
## guestcontrol exec channel -- deterministic, no OCR (tesseract flaked on the on-screen
## marker, timing a completed check out as "did not complete"). The LXQt Calamares-installed
## disk ships Guest Additions, so gc_run works here (confirmed live). It FALLS BACK to an OCR
## screen marker when the guestcontrol channel is unavailable (a GA-less image), so the gate
## never depends on Guest Additions. Marker design (learned the hard way): ALL LETTERS, no
## digit (tesseract misreads digits); built from a shell var so the typed command's own echo
## does not self-match before it runs; `clear` first so a prior check's marker cannot cross
## match. The '.rc' file is removed FIRST so a stale value from a prior attempt (check 8
## retries) can never be read as this attempt's verdict.
run_check() {
   local num="$1" cmd="$2" timeout="$3" deadline text session rc_raw rc_str
   session="${RELEASE_CHECK_SESSION[${num}]}"
   printf '%s' "clear; M=CHK; rm -f /var/tmp/dmcheck-${num}.rc; ${cmd} > /var/tmp/dmcheck-${num}.out 2>&1; rc=\$?; echo \${rc} > /var/tmp/dmcheck-${num}.rc; sync; if [ \${rc} -eq 0 ]; then echo DM\${M}PASSMARK; else echo DM\${M}FAILMARK; fi" \
      | "${GUESTCTL}" "${vm}" type-stdin >/dev/null
   gui_scan 1c 9c
   ## let `clear` + the rm + the command start before the first poll (so the command echo,
   ## which holds the literal-var marker, is gone and the stale .rc is already removed).
   sleep 3
   deadline=$(( SECONDS + timeout ))
   while [ "${SECONDS}" -lt "${deadline}" ]; do
      ## PRIMARY: the exit-code file over guestcontrol. Only a clean integer counts; a missing
      ## file (check still running) or a torn read is ignored and retried, never a verdict.
      rc_raw="$(gc_run "${session}" "cat /var/tmp/dmcheck-${num}.rc 2>/dev/null" 2>/dev/null || true)"
      read -r rc_str <<< "${rc_raw}" || true
      if [[ "${rc_str}" =~ ^[0-9]+$ ]]; then
         if [ "${rc_str}" = "0" ]; then
            printf '%s\n' "${me}: check ${num} PASS"
            return 0
         fi
         printf '%s\n' "${me}: check ${num} FAIL (rc=${rc_str})"
         run_check_report_failure "${num}" "${session}" "${cmd}" "${rc_str}"
         return 1
      fi
      ## FALLBACK: OCR the marker, for a GA-less image where gc_run cannot reach the guest.
      gui_scan 2a aa
      text="$(gui_ocr)"
      if [[ "${text,,}" =~ dmchkpassmark ]]; then
         printf '%s\n' "${me}: check ${num} PASS"
         return 0
      fi
      if [[ "${text,,}" =~ dmchkfailmark ]]; then
         printf '%s\n' "${me}: check ${num} FAIL"
         run_check_report_failure "${num}" "${session}" "${cmd}" ""
         return 1
      fi
      sleep 10
   done
   die "${FAIL_RC}" "check ${num} did not complete in ${timeout}s"
}

## On a fully-PASSING run, record the release-critical check roster to ${check_log} so the
## PUBLISHED result surfaces WHICH authoritative checks ran and passed -- check 8 (systemcheck
## --cli --ci) above all. Without this the record keeps only a FAILURE tail, so a green run shows
## NO evidence the checks ran at all (a reviewer cannot see that systemcheck passed). Honest by
## construction: the battery is fail-fast + FATAL (a failed check die()s before this runs), so
## reaching here means every listed check passed. dm-release-test threads a non-empty check_log
## into the published step's stderr tail -> result.json -> the results page.
write_pass_roster() {
   [ -n "${check_log}" ] || return 0
   local num
   {
      printf '%s\n' "release-critical checks -- all PASS (fatal battery: a failed check aborts the run):"
      for num in "${RELEASE_CHECK_ORDER[@]}"; do
         printf '%s\n' "check ${num} (${RELEASE_CHECK_DESC[${num}]:-}): ${RELEASE_CHECK_CMD[${num}]:-} -- PASS"
      done
   } > "${check_log}" 2>/dev/null || true
}

## --- callbacks for the shared release-check battery (release-checks.bsh) ---------

## verify_fn (render-first). Only check 6 has a host-side visual pre-check on this
## Guest-Additions-less Calamares disk; the other checks are OCR-functional via
## run_check. check 6 (GUI login works -- screenshot-verified), two signals:
##  6b (host-side): a screenshot OCRs the rendered desktop/terminal, proving the
##     graphical session actually PAINTED readable UI. Catches a blank/black screen
##     or a desktop that never drew (login failed to render), where the 6a process
##     probe alone would still pass. Does NOT catch a compositor that FROZE after a
##     valid frame already rendered (the stale frame still OCRs); a true compositor
##     CRASH is caught by 6a. Tokens are open_terminal's proven set ('[user@...',
##     localhost, pts/); '[[]user' matches a literal '[' (bare '[user' is an invalid
##     ERE for the [[ =~ ]] gui_wait_for uses).
##  6a (in-guest): the labwc compositor process running (run_check 6 'pgrep labwc').
## 6b runs FIRST so the single 'check 6 PASS' (emitted by run_check) prints only
## after BOTH hold -- never a premature green.
## Firmware-lane EVIDENCE: probe the INSTALLED guest (the LXQt disk ships Guest Additions, so
## gc_run works) for the boot lane it ACTUALLY runs, cross-check vs the declared --firmware, and
## write detected + match + the command/output to --firmware-evidence-file for the results plane
## (so a detail page proves the lane, not just the label). Best-effort: a probe hiccup leaves the
## file empty (-> no firmware panel), never failing a passing install.
capture_firmware_lane() {
   [ -n "${firmware_evidence_file}" ] || return 0
   local out efi sb coreboot declared id_out detected match line fw_identity
   local declared_arg=()
   ## Probe the installed guest, computing EACH axis IN the guest and emitting one TRUSTED
   ## key=value per line -- EFI/SB/COREBOOT -- plus the raw BIOS_VENDOR (evidence only, LAST).
   ## The host then reads each axis from its OWN key: a firmware-controlled bios_vendor cannot
   ## forge another axis (the guest does the exact 'bios_vendor = coreboot' test, not a host-side
   ## substring glob of the whole blob -- which earlier let a crafted vendor spoof efi/sb).
   ## The snippet is single-quoted ON PURPOSE: its $(...) must expand IN THE GUEST, not host-side.
   # shellcheck disable=SC2016
   out="$(gc_run "${live_account}" '
      [ -d /sys/firmware/efi ] && printf "EFI=1\n" || printf "EFI=0\n"
      if mokutil --sb-state 2>&1 | grep --quiet --ignore-case "secureboot enabled"; then printf "SB=1\n"; else printf "SB=0\n"; fi
      if [ "$(cat /sys/class/dmi/id/bios_vendor 2>/dev/null)" = "coreboot" ]; then printf "COREBOOT=1\n"; else printf "COREBOOT=0\n"; fi
      printf "BIOS_VENDOR=%s\n" "$(cat /sys/class/dmi/id/bios_vendor 2>/dev/null)"
   ' 10 2>/dev/null || true)"
   ## Read each axis from its OWN key line, FIRST occurrence wins (the guest emits EFI/SB/COREBOOT
   ## before the untrusted BIOS_VENDOR, so a newline injected into the vendor cannot override one).
   efi=''
   sb=''
   coreboot=''
   while IFS= read -r line; do
      case "${line}" in
         EFI=0)
            [ -n "${efi}" ] || efi=0
            ;;
         EFI=1)
            [ -n "${efi}" ] || efi=1
            ;;
         SB=0)
            [ -n "${sb}" ] || sb=0
            ;;
         SB=1)
            [ -n "${sb}" ] || sb=1
            ;;
         COREBOOT=0)
            [ -n "${coreboot}" ] || coreboot=0
            ;;
         COREBOOT=1)
            [ -n "${coreboot}" ] || coreboot=1
            ;;
      esac
   done <<< "${out}"
   ## Fail CLOSED: a probe that did not emit all three axes captured nothing (gc_run failed /
   ## timed out). Record UNVERIFIED + MATCH=false rather than defaulting to an identity that could
   ## spuriously MATCH a lane. An unconfirmed boot is never green.
   if [ -z "${efi}" ] || [ -z "${sb}" ] || [ -z "${coreboot}" ]; then
      {
         printf '%s\n' "DETECTED=unverified"
         printf '%s\n' "MATCH=false"
         printf '%s\n' "${out}"
      } > "${firmware_evidence_file}" 2>/dev/null || true
      return 0
   fi
   ## Declared identity from --firmware. The calamares path boots VBox's own EFI, never coreboot,
   ## so efi* declares vbox-efi*; the classifier decides detected + match in the same vocabulary.
   case "${firmware}" in
      bios)
         declared='bios'
         ;;
      efi)
         declared='vbox-efi'
         ;;
      efi-secureboot)
         declared='vbox-efi-secureboot'
         ;;
      *)
         declared=''
         ;;
   esac
   ## coreboot boots as a generic EFI firmware whose DMI bios_vendor is "coreboot";
   ## dm-firmware-identity classifies that as dasharo-efi, not vbox-efi (--coreboot-rom
   ## enforces --firmware efi). Declare it so a SUCCESSFUL coreboot install matches instead
   ## of being reported a firmware mismatch (which would mark the whole run FAIL).
   if [ -n "${coreboot_rom}" ] && [ "${firmware}" = 'efi' ]; then
      declared='dasharo-efi'
   fi
   [ -z "${declared}" ] || declared_arg=(--declared "${declared}")
   ## Shared classifier (sibling dist-ai tool): the SINGLE identity-decision source for every VBox
   ## lane. Prefer the checkout sibling, fall back to PATH (installed).
   fw_identity="${lib_dir}/dm-firmware-identity"
   [ -x "${fw_identity}" ] || fw_identity='dm-firmware-identity'
   id_out="$("${fw_identity}" --efi "${efi}" --coreboot "${coreboot}" --secureboot "${sb}" "${declared_arg[@]}" 2>/dev/null || true)"
   detected=''
   match=''
   while IFS= read -r line; do
      case "${line}" in
         detected=*)
            detected="${line#detected=}"
            ;;
         match=*)
            match="${line#match=}"
            ;;
      esac
   done <<< "${id_out}"
   ## Fail CLOSED on a missing / errored / partial / out-of-order classifier result. MATCH must be
   ## a definite true|false (dm-release-test forwards only true|false; anything else becomes a null
   ## the results site reads as GREEN). An empty OR 'unverified' detected can NEVER be a pass, so it
   ## forces MATCH=false even if a stray 'match=true' was printed without a detected line.
   [ -n "${detected}" ] || detected='unverified'
   case "${match}" in
      true|false)
         ;;
      *)
         match='false'
         ;;
   esac
   [ "${detected}" = 'unverified' ] && match='false'
   {
      printf '%s\n' "DETECTED=${detected}"
      printf '%s\n' "MATCH=${match}"
      printf '%s\n' "${out}"
   } > "${firmware_evidence_file}" 2>/dev/null || true
}

# shellcheck disable=SC2317  ## dispatched indirectly by run_release_check_battery
cal_verify() {
   case "$1" in
      6)
         gui_wait_for 'localhost|pts/|[[]user' 60 'check 6 GUI render (desktop painted)'
         snap 61 check-6-gui-rendered
         ## User session is up -> capture the firmware-lane evidence while gc_run is reliable.
         capture_firmware_lane
         ;;
   esac
}

## exec_fn: run_check is the OCR executor (types the command, polls an OCR marker)
## and emits the single 'check N PASS'. The boot role implies the session, so the
## battery's SESSION argument ($2) is not needed here.
# shellcheck disable=SC2317  ## dispatched indirectly by run_release_check_battery
cal_exec() {
   run_check "$1" "$3" "$4"
}

## reboot callback: into a ready sysmaint session (desktop + terminal) for checks 2, 3.
# shellcheck disable=SC2317  ## dispatched indirectly by run_release_check_battery
cal_reboot_sysmaint() {
   reboot_installed sysmaint
}

## VT (virtual terminal) console lane: on the booted installed desktop, switch to a text
## console, log in at the getty, log out, and switch back to the graphical VT -- a milestone
## screenshot at each step. Keyboard driven via vbox-ctl-local's `chord` (Ctrl+Alt+Fn) +
## type-stdin. BEST-EFFORT per step (a VT hiccup must never fail a passing install); the grabs
## are gated UNIFORM-ONLY in main -- a real console (sparse text on black) is legitimate, only a
## VT that never rendered (a uniform frame) is a failure, so a sparse login is never false-flagged.
vt_console_lane() {
   [ -n "${shot_dir}" ] || return 0
   clear_stale_vt_captures "${shot_dir}"
   local tty_user="${VT_LOGIN_USER:-user}"
   printf '%s\n' "${me}: VT console lane (tty switch / login / logout / back to graphical)"
   ## Ctrl+Alt+F2 -> a text-console getty. The LXQt graphical session is on tty7 (verified on
   ## a live Kicksecure guest: tty1/3/5 are gettys, tty7 is X), so F2 reaches a text console.
   "${GUESTCTL}" "${vm}" chord ctrl alt f2 >/dev/null 2>&1 || true
   sleep 3
   story_snap 70 vt-switched
   ## Kicksecure's console login is PASSWORDLESS by default: type the username + Enter, no
   ## password prompt (verified on a live guest). VT_LOGIN_USER overrides the default account.
   printf '%s' "${tty_user}" | "${GUESTCTL}" "${vm}" type-stdin >/dev/null 2>&1 || true
   "${GUESTCTL}" "${vm}" chord enter >/dev/null 2>&1 || true
   sleep 3
   story_snap 71 vt-logged-in
   ## Log out of the console shell (back to the getty login prompt).
   printf '%s' "exit" | "${GUESTCTL}" "${vm}" type-stdin >/dev/null 2>&1 || true
   "${GUESTCTL}" "${vm}" chord enter >/dev/null 2>&1 || true
   sleep 2
   story_snap 72 vt-logged-out
   ## Ctrl+Alt+F7 -> back to the graphical VT (where the LXQt desktop runs).
   "${GUESTCTL}" "${vm}" chord ctrl alt f7 >/dev/null 2>&1 || true
   sleep 3
   story_snap 73 vt-graphical-restored
}

clear_stale_vt_captures() {
   ## Clear stale VT grabs so a REUSED shot_dir cannot satisfy the post-lane gate with a
   ## prior run's files -- the gate requires each capture to come from THIS run.
   safe-rm --force -- "$1"/*-vt-*.png 2>/dev/null || true
}

## REQUIRE each expected VT capture in shot_dir ($1) -- story_snap is best-effort, so an
## empty/partial set must not silently SKIP the gate (a false green). Match is THIS run's file
## (clear_stale_vt_captures ran first). Then gate UNIFORM-ONLY: a sparse console login is never a
## false-positive all-black, yet a truly-blank VT grab (the terminal never rendered) fails the run.
require_vt_captures() {
   local shot_dir="$1" vt_name vt_cand vt_shot vt_shots=()
   for vt_name in vt-switched vt-logged-in vt-logged-out vt-graphical-restored; do
      vt_shot=""
      for vt_cand in "${shot_dir}"/*-"${vt_name}".png; do
         ## -f, not -e: a capture is a regular file. A literal non-match drops here, and a
         ## directory named like a grab cannot masquerade as one (story_snap writes only files).
         [ -f "${vt_cand}" ] && vt_shot="${vt_cand}"
      done
      [ -n "${vt_shot}" ] \
         || die "${FAIL_RC}" "VT console capture '${vt_name}' is missing (the virtual-terminal lane failed to screenshot)"
      vt_shots+=("${vt_shot}")
   done
   "${IMAGE_BLANK_CHECK:-image-blank-check}" --uniform-only "${vt_shots[@]}" \
      || die "${FAIL_RC}" "a VT console grab was blank (the virtual terminal never rendered); see image-blank-check output"
}

parse_args() {
   while [ "$#" -gt 0 ]; do
      case "$1" in
         --vm)
            vm="$2"
            shift 2
            ;;
         --iso)
            iso="$2"
            shift 2
            ;;
         --disk)
            disk="$2"
            shift 2
            ;;
         --passphrase-file)
            passphrase_file="$2"
            shift 2
            ;;
         --firmware)
            firmware="$2"
            shift 2
            ;;
         --coreboot-rom)
            coreboot_rom="$2"
            shift 2
            ;;
         --reinstall)
            reinstall="true"
            shift
            ;;
         --checks)
            checks="true"
            shift
            ;;
         --mok-enroll)
            mok_enroll="true"
            shift
            ;;
         --shot)
            shot="$2"
            shift 2
            ;;
         --shot-dir)
            shot_dir="$2"
            shift 2
            ;;
         --check-log)
            check_log="$2"
            shift 2
            ;;
         --firmware-evidence-file)
            firmware_evidence_file="$2"
            shift 2
            ;;
         --keep-failed)
            keep_failed="true"
            shift
            ;;
         --live-session)
            live_session="$2"
            shift 2
            ;;
         --launch-env)
            launch_env+=( "$2" )
            shift 2
            ;;
         --pre-install-push)
            pre_install_push+=( "$2" )
            shift 2
            ;;
         --pre-install-cmd)
            pre_install_cmd+=( "$2" )
            shift 2
            ;;
         -h|--help)
            usage
            exit 0
            ;;
         *)
            usage >&2
            die "${SETUP_RC}" "unexpected argument '$1'"
            ;;
      esac
   done
   [ -n "${vm}" ]         || { usage >&2; die "${SETUP_RC}" "--vm required"; }
   [ -n "${iso}" ]        || { usage >&2; die "${SETUP_RC}" "--iso required"; }
   [ -n "${passphrase_file}" ] || { usage >&2; die "${SETUP_RC}" "--passphrase-file required"; }
   [ -r "${passphrase_file}" ] || die "${SETUP_RC}" "passphrase file not readable: '${passphrase_file}'"
   ## read via the shell (no process argv exposure); command-subst strips trailing newlines.
   passphrase="$(< "${passphrase_file}")"
   [ -n "${passphrase}" ] || die "${SETUP_RC}" "passphrase file is empty: '${passphrase_file}'"
   case "${firmware}" in
      bios|efi|efi-secureboot)
         true
         ;;
      *)
         usage >&2
         die "${SETUP_RC}" "--firmware must be bios|efi|efi-secureboot, got '${firmware}'"
         ;;
   esac
   ## coreboot layers on the EFI device (a generic EFI firmware), so it needs --firmware efi.
   if [ -n "${coreboot_rom}" ]; then
      [ "${firmware}" = 'efi' ] || { usage >&2; die "${SETUP_RC}" "--coreboot-rom requires --firmware efi"; }
      local cb_in="${coreboot_rom}"
      coreboot_rom="$(readlink --canonicalize -- "${cb_in}")" \
         || die "${SETUP_RC}" "--coreboot-rom path invalid: '${cb_in}'"
      [ -r "${coreboot_rom}" ] || die "${SETUP_RC}" "coreboot ROM not readable: '${coreboot_rom}'"
   fi
   ## MOK enrollment is only meaningful under EFI (the opt-in module no-ops on
   ## non-EFI, and modifynvram enrollmok needs a UEFI varstore). It is the point
   ## only under Secure Boot, but a plain-EFI run is a valid dry pass.
   if [ "${mok_enroll}" = 'true' ] && [ "${firmware}" = 'bios' ]; then
      usage >&2
      die "${SETUP_RC}" "--mok-enroll requires EFI firmware (got --firmware bios)"
   fi
   ## --reinstall reuses an existing VM+disk; a fresh install needs a disk path.
   [ -n "${disk}" ] || [ "${reinstall}" = 'true' ] \
      || disk="$(mktemp --tmpdir --dry-run "${vm}.XXXXXX.vdi")"
   ## --reinstall leaves disk empty unless --disk is given; mok_host_enroll then reads
   ## the host-side MOK cert from that disk path, so --mok-enroll needs an explicit
   ## --disk here or the post-install enroll dies "--disk required" in vbox-disk-extract.
   if [ "${mok_enroll}" = 'true' ] && [ -z "${disk}" ]; then
      usage >&2
      die "${SETUP_RC}" "--mok-enroll requires --disk (the host-side cert read needs the disk path)"
   fi
   ## --mok-enroll's post-install mok_host_enroll reads the MOK cert off the disk via the
   ## narrow privleap action 'vbox-disk-extract-mok' (so a deliberately sudo-less image-test
   ## runner escalates ONLY that one arg-scoped read, never general host sudo) -- the only
   ## privileged step, reached only AFTER the ~30 min install. Preflight the privleap plumbing
   ## NOW so a missing client / uninstalled action fails FAST with the reason, not after the
   ## whole install.
   if [ "${mok_enroll}" = 'true' ]; then
      type -P leaprun >/dev/null 2>&1 \
         || die "${SETUP_RC}" "--mok-enroll needs privleap's 'leaprun' (not found): the host-side MOK read escalates via the 'vbox-disk-extract-mok' privleap action"
      grep -rlE '^\[action:vbox-disk-extract-mok\]' /usr/lib/privleap/conf.d/ /etc/privleap/conf.d/ >/dev/null 2>&1 \
         || die "${SETUP_RC}" "--mok-enroll needs the 'vbox-disk-extract-mok' privleap action installed (dist-ai usr/lib/privleap/conf.d/vbox-disk-extract-mok.conf + usr/libexec/image-test/vbox-mok-extract) and the runner in group vboxusers -- action config not found"
   fi
   ## Resolve the live install session: the GRUB entry to pick (down-count from the
   ## top USER entry) AND the guestcontrol account the live session autologs in as
   ## (sysmaint session autologs in as 'sysmaint', not 'user').
   case "${live_session}" in
      unrestricted)
         live_account='user'
         live_downs=2
         ;;
      sysmaint)
         live_account='sysmaint'
         live_downs=1
         ;;
      *)
         usage >&2
         die "${SETUP_RC}" "--live-session must be sysmaint|unrestricted, got '${live_session}'"
         ;;
   esac
}

## Set the VM firmware; efi-secureboot also enrolls the platform + MS keys in the
## NVRAM store (VBox 7.x has no modifyvm --secure-boot). Done while powered off.
apply_firmware() {
   local fw
   case "${firmware}" in
      bios)
         fw='bios'
         ;;
      *)
         fw='efi'
         ;;
   esac
   "${VBOXMANAGE}" modifyvm "${vm}" --firmware "${fw}" >/dev/null
   if [ "${firmware}" = 'efi-secureboot' ]; then
      ## Initialize the varstore and enroll the platform + MS keys now, but keep Secure Boot
      ## DISABLED for the live/install phase. The live ISO's VirtualBox Guest Additions kernel
      ## modules are NOT signed, so under enforced Secure Boot they would be rejected and
      ## VBoxService never starts -> guestcontrol never comes up -> the install cannot be
      ## driven. Secure Boot is turned ON only just before the installed-system first boot
      ## (enable_secureboot_installed), where the GA is DKMS-signed and the MOK enrolled. The
      ## keys are enrolled here (not at the transition) because inituefivarstore would wipe the
      ## boot entries Calamares writes during the install; enabling enforcement later does not.
      "${VBOXMANAGE}" modifynvram "${vm}" inituefivarstore >/dev/null
      "${VBOXMANAGE}" modifynvram "${vm}" enrollorclpk >/dev/null
      "${VBOXMANAGE}" modifynvram "${vm}" enrollmssignatures >/dev/null
      "${VBOXMANAGE}" modifynvram "${vm}" secureboot --disable >/dev/null
   elif [ "${firmware}" = 'efi' ]; then
      ## A plain-EFI --reinstall over a VM that was previously efi-secureboot would
      ## otherwise inherit Secure Boot ENABLED (firmware mode != VM state); disable
      ## it so plain EFI really is plain. Preserves the other NVRAM boot variables.
      ## Tolerated on a fresh VM whose varstore is not yet initialized (no-op there).
      "${VBOXMANAGE}" modifynvram "${vm}" secureboot --disable >/dev/null 2>&1 || true
   fi
   ## coreboot layers ON the efi device (a generic EFI firmware, NOT a 4th --firmware token):
   ## the patched CorebootRom-aware VBoxManage loads EfiRom as a coreboot image instead of OVMF.
   ## Same VBoxInternal/Devices/efi/0/Config/ namespace as the EFI DMI overrides. Set here so the
   ## reinstall branch (which also calls apply_firmware) carries the extradata too.
   if [ -n "${coreboot_rom}" ]; then
      "${VBOXMANAGE}" setextradata "${vm}" VBoxInternal/Devices/efi/0/Config/EfiRom "${coreboot_rom}" >/dev/null
      "${VBOXMANAGE}" setextradata "${vm}" VBoxInternal/Devices/efi/0/Config/CorebootRom 1 >/dev/null
   fi
}

## Turn Secure Boot ON for the installed-system boot (efi-secureboot lane only). Runs while the
## VM is powered off, between the live-session poweroff and the installed-disk start. The
## varstore + PK/MS keys were enrolled by apply_firmware and the install wrote its boot entries
## into that varstore; this only flips enforcement, so nothing Calamares created is lost. A
## no-op on every other lane.
enable_secureboot_installed() {
   [ "${firmware}" = 'efi-secureboot' ] || return 0
   "${VBOXMANAGE}" modifynvram "${vm}" secureboot --enable >/dev/null
   printf '%s\n' "${me}: Secure Boot enabled for the installed-system boot"
}

build_vm() {
   "${VBOXMANAGE}" controlvm "${vm}" poweroff 2>/dev/null || true
   sleep 2
   if [ "${reinstall}" = 'true' ]; then
      ## R7 reinstall-over: keep the existing VM + its installed disk, switch
      ## firmware, and re-attach the ISO (the prior run detached it) so Calamares
      ## erase-reinstalls over the disk under the new firmware.
      apply_firmware
      ## The reused VM keeps its coreboot board + COM1-server config from the first build;
      ## re-arm the drain (cb_drain_start no-ops on an empty cb_uart_sock, leaving the 16550
      ## undrained -> the THRE-poll boot wedge). The socket path is deterministic, matching
      ## the persisted --uartmode1 server target.
      if [ -n "${coreboot_rom}" ]; then
         cb_uart_sock="${HOME}/${me}-cb-uart.sock"
         safe-rm --force -- "${cb_uart_sock}"
      fi
      "${VBOXMANAGE}" storageattach "${vm}" --storagectl IDE --port 0 --device 0 \
         --type dvddrive --medium "${iso}" >/dev/null
      return 0
   fi
   "${VBOXMANAGE}" unregistervm "${vm}" --delete 2>/dev/null || true
   safe-rm --force -- "${disk}"
   "${VBOXMANAGE}" createvm --name "${vm}" --ostype Debian_64 --register >/dev/null
   ## vCPUs = online host CPUs minus one (shared dm-vbox-vcpus helper): a single-vCPU VM runs
   ## the hardened boot's Guest Additions setup so slowly that under host-CPU contention it
   ## exceeds the GA service timeout and wedges (no dynamic resize). Give it ~all cores.
   vcpus="$("${lib_dir}/dm-vbox-vcpus" 2>/dev/null || dm-vbox-vcpus)"
   ## vmsvga+128 VRAM: else the desktop never draws headless. usbtablet+USB: give
   ## an absolute pointer so vbox-ctl-local clicks land pre-Guest-Additions.
   ## coreboot swaps the graphics recipe for the proven-working board the UefiPayload needs
   ## (vboxvga, piix3/HPET/IOAPIC, the 36-bit-phys cpuid leaf) and wires COM1 to a host server
   ## socket the drain reads. WITHOUT --coreboot-rom the argv is byte-unchanged (additive only):
   ## the --memory/--cpus head and the --mouse/--usb/--nic tail are shared by both paths.
   local -a modify_args=( --memory 4096 --cpus "${vcpus}" )
   if [ -n "${coreboot_rom}" ]; then
      cb_uart_sock="${HOME}/${me}-cb-uart.sock"
      safe-rm --force -- "${cb_uart_sock}"
      modify_args+=( --chipset piix3 --ioapic on --hpet on \
         --graphicscontroller vboxvga --vram 128 --cpuid-set "${cb_cpuidset[@]}" \
         --uart1 0x3f8 4 --uartmode1 server "${cb_uart_sock}" )
   else
      modify_args+=( --graphicscontroller vmsvga --vram 128 )
   fi
   modify_args+=( --mouse usbtablet --usb-ohci on --nic1 nat )
   "${VBOXMANAGE}" modifyvm "${vm}" "${modify_args[@]}" >/dev/null
   apply_firmware
   "${VBOXMANAGE}" createmedium disk --filename "${disk}" --size 25600 \
      --format VDI >/dev/null 2>&1
   "${VBOXMANAGE}" storagectl "${vm}" --name SATA --add sata \
      --controller IntelAhci >/dev/null
   "${VBOXMANAGE}" storagectl "${vm}" --name IDE --add ide \
      --controller PIIX4 >/dev/null
   "${VBOXMANAGE}" storageattach "${vm}" --storagectl SATA --port 0 --device 0 \
      --type hdd --medium "${disk}" >/dev/null
   "${VBOXMANAGE}" storageattach "${vm}" --storagectl IDE --port 0 --device 0 \
      --type dvddrive --medium "${iso}" >/dev/null
}

## coreboot COM1 drain (only with --coreboot-rom). The UefiPayload floods the 16550, and a VBox
## server-socket UART with NO host reader blocks the guest on the THRE poll -- wedging the boot
## before the GOP comes up; stray serial INPUT would also cancel GRUB autoboot. So the standalone
## cb-uart-drain helper reads+discards COM1 for the whole run and RECONNECTS across the install's
## power-cycles (live -> install -> reboot -> installed). Started once after the first startvm; its
## PID goes in cb_drain_pid, reaped by cb_drain_stop. The helper is unidirectional (recv-only).
cb_drain_start() {
   [ -n "${coreboot_rom}" ] || return 0
   [ -n "${cb_uart_sock}" ] || return 0
   local helper="${lib_dir}/../libexec/image-test/cb-uart-drain"
   [ -x "${helper}" ] || helper='/usr/libexec/image-test/cb-uart-drain'
   "${helper}" "${cb_uart_sock}" >/dev/null 2>&1 &
   cb_drain_pid="$!"
   printf '%s\n' "${me}: coreboot COM1 drain started (pid ${cb_drain_pid}, socket ${cb_uart_sock})" >&2
}

## Stop the coreboot COM1 drain and remove its socket. Best-effort, never changes the exit
## status. We hold the PID, so kill it directly -- no pkill -f (which would self-match this shell).
cb_drain_stop() {
   if [ -n "${cb_drain_pid}" ]; then
      kill "${cb_drain_pid}" 2>/dev/null || true
      cb_drain_pid=""
   fi
   if [ -n "${cb_uart_sock}" ]; then
      safe-rm --force -- "${cb_uart_sock}" 2>/dev/null || true
   fi
}

main() {
   parse_args "$@"
   ## Self-lock AFTER parse_args, so --help (which exits in parse_args) never takes a VM lock.
   ## A VBox install test is 'work'-class VM work on the shared OVH server -- it may run
   ## alongside other work but is mutually exclusive with a leak test. Re-exec under
   ## dm-vm-lock (class=work, SHARED); the re-exec'd run sees DM_VM_LOCK_HELD and runs through.
   if [ -z "${DM_VM_LOCK_HELD:-}" ]; then
      ## style-ok: R-103 -- intentional re-exec: run this VBox install test under the VM-work lock.
      exec dm-vm-lock acquire --class work --ttl "${DM_CALAMARES_LOCK_TTL:-3600}" -- "$0" "$@"
   fi
   ## coreboot + window story capture: re-exec inside a private mount namespace with the fork VBoxDD
   ## bind-mounted over /usr/lib/virtualbox, so the stock VirtualBoxVM loads the CorebootRom device.
   ## No-op for stock lanes / framebuffer mode (and after it has re-exec'd once).
   cb_gui_ns_reexec "$@"
   trap on_exit EXIT
   ## Clear any stale stuck screenshot left by a PRIOR run of this account, so on_exit can
   ## only ever publish THIS run's failure screen -- never a previous run's error.
   safe-rm --force -- "${HOME}/${me}-stuck.png" 2>/dev/null || true
   ## Milestone "full story" dir: ensure it exists (best-effort, like the shots themselves).
   if [ -n "${shot_dir}" ]; then
      mkdir --parents -- "${shot_dir}" 2>/dev/null || true
   fi
   ## Start the story GUI compositor (window mode) so every milestone is a full VBox VM window.
   gui_compositor_start

   printf '%s\n' "${me}: build + boot install session"
   build_vm
   ## Pre-boot state cards (no framebuffer yet): the defined VM, and the firmware / Secure Boot
   ## varstore state (there is no SB screen to photograph on a normal boot).
   story_card 10 vm-defined "VM defined (pre-boot)"
   ## Real VirtualBox Manager screenshot (begin-of-story). FATAL: a broken GUI-grab pipeline
   ## must surface NOW, before the ~30-50min install, not as a silent blank milestone.
   story_vbox_manager 14 vbox-manager \
      || die "${FAIL_RC}" "vbox-host-shot could not capture the VirtualBox Manager (vbox-manager)"
   story_card_host 12 vbox-host
   story_card 13 firmware-state "Firmware / Secure Boot varstore state"
   start_vm_frontend
   vm_started="true"
   ## Start the coreboot COM1 drain as soon as the VM is up (a no-op without --coreboot-rom). One
   ## reconnecting drainer survives every later power-cycle (reboot_installed / mok_host_enroll).
   cb_drain_start
   ## Firmware logo: the VBox EFI firmware DOES draw a splash (a ~1024x768 VirtualBox logo) about
   ## a second after power-on in both efi and efi-secureboot, then blacks out ~1s later for the
   ## GRUB mode switch. A blind single shot races that short window and usually grabs black, so
   ## POLL fast over the first few seconds and keep the frame that actually rendered. `|| true`:
   ## the universal floor owns the verdict (and keeps errexit off the timeout path).
   story_snap_nonblank 11 firmware-logo 6 0.4 || true
   ## No "live-kernel-boot" capture: Kicksecure boots SILENTLY (security-misc; no plymouth, no
   ## console), so the whole window between the GRUB menu and the painted desktop is black BY
   ## DESIGN -- there is no non-black kernel-boot frame to publish. The boot is evidenced by the
   ## GRUB captures (20/21) and the live-desktop milestones (24+), not a black rectangle.
   ## Select the install boot entry once GRUB is actually on screen (poll, not a
   ## fixed sleep that races the autoboot into the wrong session). The menu capture (20/21)
   ## is taken inside select_install_boot_entry, where the menu is known to be on screen.
   select_install_boot_entry

   printf '%s\n' "${me}: wait for the live desktop + guestcontrol, then launch Calamares"
   ## Poll for the compositor (desktop >=1024 wide, keeps the display awake) AND for
   ## VBoxService in the live session, so install-host can be launched DIRECTLY via
   ## guestcontrol -- a real launch signal, no OCR terminal + blind-typed line (the
   ## single most fragile step: a fullscreen terminal OCRs unreliably, so the old
   ## blind type had no verification at all).
   ## Raised from 480s + overridable: the live desktop reaches full resolution only once the
   ## Guest Additions resize client is up, and a hardened boot's GA setup can be slow under
   ## residual host-CPU contention. The online-1 vCPU sizing + the vboxadd self-heal drop-in
   ## make this margin rarely needed, but a genuinely-slow boot should not false-fail at 480s.
   wait_ready "${DM_CALAMARES_FULLRES_TIMEOUT:-720}"
   ## No pre-paint 'live-desktop-ready' capture here: wait_ready returns when the compositor is up
   ## but BEFORE the first paint, so that host-side frame was near-black and had to be allow-listed
   ## in the blank gate (a silent false-green). The settled 'live-guestcontrol-ready' (24) below --
   ## taken via guestcontrol after quiesce -- is the real painted-desktop proof.
   wait_guestcontrol_ready "${live_account}" 300 \
      || die "${FAIL_RC}" "guestcontrol (VBoxService) never came up in the live session"
   ## Guestcontrol is up -> the live desktop can be quiesced; capture the clean live session.
   snap_account="${live_account}"
   snap 24 live-guestcontrol-ready
   ## Pre-install hooks (opt-in; empty -> no-op): guestcontrol is confirmed up, so
   ## push host files into the live guest and/or run setup snippets as live_account
   ## BEFORE Calamares launches. Used to swap in a patched helper or seed a
   ## verification marker that must land in the live overlayfs upperdir.
   local push_spec push_local push_dest cmd_snippet launch_var
   for push_spec in "${pre_install_push[@]}"; do
      push_local="${push_spec%%:*}"
      push_dest="${push_spec#*:}"
      { [ "${push_local}" != "${push_spec}" ] && [ -n "${push_local}" ] && [ -n "${push_dest}" ]; } \
         || die "${SETUP_RC}" "--pre-install-push needs LOCAL:GUEST (both non-empty), got '${push_spec}'"
      printf '%s\n' "${me}: pre-install push: '${push_local}' -> guest '${push_dest}'"
      ## '--' so a LOCAL/GUEST that looks like an option (e.g. '--help') is a path,
      ## not a flag argparse would consume + exit 0 on (leaving the copy undone).
      "${VBOX_EXEC_LOCAL:-vbox-exec-local}" "${vm}" push --role "${live_account}" -- "${push_local}" "${push_dest}" \
         || die "${FAIL_RC}" "pre-install push failed: '${push_spec}'"
   done
   for cmd_snippet in "${pre_install_cmd[@]}"; do
      printf '%s\n' "${me}: pre-install cmd (${live_account}): ${cmd_snippet}"
      gc_run "${live_account}" "${cmd_snippet}" 120 \
         || die "${FAIL_RC}" "pre-install cmd failed: ${cmd_snippet}"
   done
   ## Env injected into install-host's Calamares launch; its 'sudo --preserve-env'
   ## (sudoers SETENV) carries each VAR=VAL into Calamares (and modules read it
   ## across the target chroot). --mok-enroll adds MOK_ENROLL=1 (shellprocess_mok_enroll);
   ## --launch-env adds arbitrary vars (e.g. DEVOVERLAY=true for the overlay pack).
   local -a launch_extra=()
   if [ "${mok_enroll}" = 'true' ]; then
      launch_extra+=( 'MOK_ENROLL=1' )
   fi
   ## gc_launch_gui interpolates the extra VAR=VAL list into the guest shell
   ## UNESCAPED (trusted-literal contract), so a value with whitespace would
   ## word-split and a '$(...)'/';' would execute in-guest. Constrain each
   ## --launch-env entry to NAME=shell-safe-value; reject anything else.
   for launch_var in "${launch_env[@]}"; do
      if ! [[ "${launch_var}" =~ ^[A-Za-z_][A-Za-z0-9_]*=[A-Za-z0-9_.,:=/+-]*$ ]]; then
         die "${SETUP_RC}" "--launch-env must be NAME=VALUE with a shell-safe value (no spaces or metacharacters), got '${launch_var}'"
      fi
      launch_extra+=( "${launch_var}" )
   done
   ## install-host opens Calamares as its own Wayland window; gc_launch_gui sets
   ## WAYLAND_DISPLAY (absent in the guestcontrol env) and backgrounds via setsid so
   ## the GUI survives the exec channel closing. Launched as live_account -- the account
   ## the chosen live session autologs in as (user by default; sysmaint under
   ## --live-session sysmaint) -- which is orthogonal to the live boot entry GRUB selects
   ## (select_install_boot_entry), the entry that grants install-host the root it needs.
   gc_launch_gui "${live_account}" "${INSTALL_HOST_CMD}" "${launch_extra[*]}"
   ## Best-effort frame of whatever install-host presents before the Calamares window appears
   ## (it may wait on the unrestricted-admin unlock first); captures the launch transition.
   story_snap 30 install-host-launched
   ## gc_launch_gui is fire-and-forget (returns 0 even if install-host dies at once), so
   ## confirm Calamares actually started; on failure dump the launch log and fail with a
   ## real reason instead of a silent wait to the downstream OCR timeout.
   ## install-host waits (up to ~180s) for the unrestricted-admin unlock to finish before it
   ## launches Calamares, so allow for that window plus Calamares startup.
   if ! gc_wait_gui_started "${live_account}" 'calamares' 240; then
      printf '%s\n' "${me}: install-host launch log:" "$(gc_gui_launch_log "${live_account}")" >&2
      die "${FAIL_RC}" "install-host did not start Calamares in the live session"
   fi
   gui_wait_for 'welcome to the calamares' 180 'Calamares Welcome page'
   ## Live-session snapshots (01-04) quiesce as the live account.
   snap_account="${live_account}"
   snap 31 welcome

   printf '%s\n' "${me}: drive Calamares to a LUKS erase-disk install (OCR-located)"
   ## Each page is confirmed by its own CONTENT text (never a sidebar label -- those
   ## are always visible, so a sidebar match would falsely "pass" a page we never
   ## reached), then advanced by clicking the OCR-located Next/Install button. Every
   ## click target is found by text, so the whole drive is resolution-independent.
   gui_click_word 'next' 45 bottom 'Welcome Next'
   gui_wait_for 'region|system language' 60 'Location page'
   snap 32 location
   gui_click_word 'next' 45 bottom 'Location Next'
   gui_wait_for 'keyboard model|physical keyboard|default keyboard' 60 'Keyboard page'
   snap 33 keyboard
   gui_click_word 'next' 45 bottom 'Keyboard Next'
   gui_wait_for 'erase disk' 60 'Partitions page'
   snap 34 partitions
   ## Erase disk is a clickable card; selecting it auto-enables Encrypt system
   ## (Kicksecure default), revealing the two LUKS fields. Locate each field by its
   ## placeholder text ("Passphrase" = 1st, "Confirm passphrase" = the Confirm one).
   gui_click_word 'erase' 30 1 'Erase disk option'
   ## The empty first "Passphrase" field is grey placeholder text that OCRs as
   ## garbage (conf 0), but the "Confirm passphrase" caption reads cleanly. So
   ## focus Confirm, then Shift+Tab to the adjacent Passphrase field (reliable tab
   ## order: Passphrase immediately precedes Confirm) -- no pixel coords, keeping
   ## the field entry resolution-independent like the rest of the drive.
   gui_click_word 'confirm' 45 1 'Confirm passphrase field'
   gui_scan 2a 0f 8f aa
   printf '%s' "${passphrase}" | "${GUESTCTL}" "${vm}" type-stdin >/dev/null
   sleep 1
   gui_scan 0f 8f
   printf '%s' "${passphrase}" | "${GUESTCTL}" "${vm}" type-stdin >/dev/null
   sleep 1
   ## Both LUKS fields now filled (masked dots); capture before advancing.
   snap 35 partitions-luks-filled
   gui_click_word 'next' 45 bottom 'Partitions Next'
   gui_wait_for 'overview|erase disk /dev|the following changes' 60 'Summary page'
   snap 36 summary
   ## Trigger Install via its Alt+I accelerator, NOT an OCR-located click: the Summary
   ## "Install" BUTTON caption OCRs unreliably (grey-on-grey, low confidence), so a
   ## 'bottom' match falls through to the body text "Install Kicksecure on new ext4..."
   ## and the click no-ops -- calamares sits on Summary until the completion poll times
   ## out (verified: Alt+I advances to the exec page; the OCR click does not).
   gui_scan 38 17 97 b8
   ## Settle onto the exec/slideshow page, then capture the install in progress.
   sleep 5
   snap 37 install-started
   printf '%s\n' "${me}: installing (encrypted) -- polling for completion"
   ## Abort fast on a Calamares failure dialog (e.g. a shellprocess exiting non-zero)
   ## instead of waiting out the full 1200s for a completion marker that will never come.
   gui_wait_for 'all done|has been installed|restart now' 1200 'install completion (check 0)' \
      'installation failed|external command finished with errors'
   snap 39 install-done

   printf '%s\n' "${me}: reboot into the installed disk (detach ISO)"
   ## Install is finished at the "all done" page; we power off + detach the ISO +
   ## reboot ourselves, so no need to click the Finish/Done button first.
   "${VBOXMANAGE}" controlvm "${vm}" poweroff 2>/dev/null || true
   sleep 3
   "${VBOXMANAGE}" storageattach "${vm}" --storagectl IDE --port 0 --device 0 \
      --type dvddrive --medium none >/dev/null
   story_card 41 vm-stopped-iso-detached "Live session powered off, install ISO detached"
   ## efi-secureboot: the live/install phase ran with Secure Boot OFF (unsigned live GA);
   ## enforce it now, for the installed-system boot, while still powered off.
   enable_secureboot_installed
   ## coreboot: drop the FMAP-format .nvram the coreboot firmware wrote on the live boot, which
   ## VBox cannot reload (VERR_TAR_BAD_CHKSUM_FIELD -> this startvm fails). coreboot boots the
   ## installed disk by scanning the ESP, so no persistent varstore is needed. No-op otherwise.
   cb_reset_nvram
   start_vm_frontend
   story_snap 42 installed-first-frame
   ## ~5s for the autoboot before the installed GRUB menu. No 'installed-firmware-logo' capture:
   ## the headless VM's firmware draws no splash, so that frame was ALWAYS dark (a guaranteed
   ## blank-gate false-positive); the installed system's firmware identity is recorded explicitly
   ## in environment.firmware (dm-firmware-identity), not a logo screenshot.
   sleep 5
   story_snap 45 installed-grub-menu

   printf '%s\n' "${me}: unlock LUKS at boot (check 7)"
   gui_wait_for 'passphrase for disk|please unlock|luks' 120 'LUKS unlock prompt'
   story_snap 47 luks-prompt
   redact_boot_tokens 47-luks-prompt.png
   printf '%s' "${passphrase}" | "${GUESTCTL}" "${vm}" type-stdin >/dev/null
   story_snap 48 luks-passphrase-typed
   redact_boot_tokens 48-luks-passphrase-typed.png
   gui_scan 1c 9c
   sleep 3
   story_snap 49 luks-unlocked
   redact_boot_tokens 49-luks-unlocked.png

   printf '%s\n' "${me}: verify the installed system booted (R4)"
   gui_wait_for 'setup wizard|setup-wizard-dist|systemcheck' 180 'installed system first boot'

   ## --shot: capture the installed first-boot screen for the results plane (proof the
   ## install succeeded). Best-effort: a capture failure must never fail a passing install.
   if [ -n "${shot}" ]; then
      capture_frame "${shot}" >/dev/null 2>&1 || true
   fi
   ## Installed first boot is the default 'user' boot role, regardless of the live
   ## install session -- quiesce as 'user', not the live account.
   snap_account="user"
   snap 50 first-boot

   ## --mok-enroll: before the checks, read the per-machine MOK cert off the disk on
   ## the host and enroll it, then reboot, so tirdad loads under Secure Boot and
   ## check 8 is GREEN for the real reason (module loaded), not merely tolerated.
   if [ "${mok_enroll}" = 'true' ]; then
      mok_host_enroll
      story_card 51 mok-cert-enrolled "Per-machine MOK enrolled into the UEFI varstore"
      snap 52 mok-reboot-desktop
   fi

   if [ "${checks}" = 'true' ]; then
      printf '%s\n' "${me}: release-critical checks on the installed system"
      wait_ready 300
      ## Virtual-terminal lane on the ready desktop, BEFORE opening the check terminal and the
      ## battery's sysmaint reboot -- so it runs independently of any later check outcome and
      ## leaves the graphical session restored for the checks that follow.
      vt_console_lane
      open_terminal
      snap 60 terminal-open
      ## Iterate the SINGLE shared check table (release-checks.bsh): cal_exec runs
      ## each check via run_check (OCR, and the sole emitter of 'check N PASS'),
      ## cal_verify does the render-first check-6 assertion, cal_reboot_sysmaint
      ## reaches the sysmaint session for checks 2, 3. check-8 retry + check-1/2
      ## polarity + run order all come from the table, so the install gate and the
      ## R6 upgrade gate can never diverge about what a check is.
      run_release_check_battery cal_exec cal_reboot_sysmaint cal_verify \
         || die "${FAIL_RC}" "release check ${RELEASE_CHECK_FAILED_NUM} (${RELEASE_CHECK_FAILED_REASON}) FAILED"
      ## Surface the passed-check roster (incl. check 8 systemcheck) in the published record.
      write_pass_roster
      snap 66 checks-complete
   fi

   ## Gate the state CARDS (story_card -> dm-text-to-png): rendered text that MUST carry content
   ## -- a blank card is a real render bug (e.g. the ImageMagick '#111111' -fill quirk that
   ## produced all-white cards).
   if [ -n "${shot_dir}" ]; then
      local card card_shot card_shots=()
      for card in vm-defined vbox-host firmware-state vm-stopped-iso-detached mok-cert-enrolled failure-vm-state; do
         for card_shot in "${shot_dir}"/*-"${card}".png; do
            ## -f (regular file), not -e: a non-matching glob stays literal and drops here (no
            ## nullglob needed), and a directory cannot masquerade as a rendered card.
            [ -f "${card_shot}" ] && card_shots+=("${card_shot}")
         done
      done
      if [ "${#card_shots[@]}" -gt 0 ]; then
         "${IMAGE_BLANK_CHECK:-image-blank-check}" "${card_shots[@]}" \
            || die "${FAIL_RC}" "a state card rendered blank (dm-text-to-png); see image-blank-check output"
      fi
      ## VT console grabs (produced only when the --checks lane ran): framebuffer snaps, NOT the
      ## dense-card gate above -- require_vt_captures gates them UNIFORM-ONLY.
      if [ "${checks}" = 'true' ]; then
         require_vt_captures "${shot_dir}"
      fi
      ## Gate the milestone SCREENSHOTS by richness (milestone_blank_mode): a MUST-BE-RICH capture
      ## (desktop / GUI / installed GRUB / first boot / checks / final) that came back near-black is
      ## a real render failure -> FAIL (this closes the false-green where a near-black
      ## live-desktop-ready rode a PASS). Legitimately near-black frames (LUKS prompts, a
      ## powered-off VM) are checked UNIFORM-ONLY (a 2+ colour frame passes); pure transient frames
      ## (GRUB / kernel-boot / first-frame / firmware splash) + vt + cards are gated by their own
      ## paths or left best-effort, since they are legitimately uniform-black at capture.
      local ms ms_name ms_mode rich_shots=() sparse_shots=()
      for ms in "${shot_dir}"/*.png; do
         [ -f "${ms}" ] || continue
         ms_name="${ms##*/}"
         ms_name="${ms_name%.png}"
         ms_name="${ms_name#*-}"
         ms_mode="$(milestone_blank_mode "${ms_name}")"
         case "${ms_mode}" in
            rich)
               rich_shots+=("${ms}")
               ;;
            sparse)
               sparse_shots+=("${ms}")
               ;;
         esac
      done
      if [ "${#rich_shots[@]}" -gt 0 ]; then
         "${IMAGE_BLANK_CHECK:-image-blank-check}" "${rich_shots[@]}" \
            || die "${FAIL_RC}" "a content-rich milestone capture came back blank/near-black (desktop/GUI/menu did not render); see image-blank-check output"
      fi
      if [ "${#sparse_shots[@]}" -gt 0 ]; then
         "${IMAGE_BLANK_CHECK:-image-blank-check}" --uniform-only "${sparse_shots[@]}" \
            || die "${FAIL_RC}" "a milestone capture was entirely blank (1 colour); see image-blank-check output"
      fi
   fi

   printf '%s\n' "${me}: PASS -- R3 (install completes + LUKS unlock) and R4 (boot installed)"
   return "${PASS_RC}"
}

## Sourced (dm-release-test-tests) -> expose the functions without running;
## executed -> run.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
   main "$@"
fi
