#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## style-ok: no-has -- thin front; does not source helper-scripts.

## Thin front for the website-tests engine: gate EXACTLY ONE named family site. The site root is
## resolved from that site's _REPO env var (else its private-sources default), exactly as the
## engine does in the full-family run. site-deploy uses this so publishing a site gates ONLY that
## site -- an unrelated sibling-site regression cannot block the publish. The site is taken as an
## explicit argument, never an ambient env filter, so a stray sibling _REPO cannot widen the run.
## For the full family gate (all sites, cross-site checks) use website-tests-all.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

if [ "$#" -ne 1 ] || [ -z "$1" ]; then
   printf '%s\n' 'Usage: website-tests-single <site-name>' >&2
   exit 64
fi

self_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"
engine="${self_dir}/website-tests"
[ -x "${engine}" ] || engine='/usr/bin/website-tests'

## Last command: the front exits with the engine's status (gate pass/fail/skip propagates).
"${engine}" --site "$1"
