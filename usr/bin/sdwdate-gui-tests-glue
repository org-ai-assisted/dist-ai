#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## End-to-end harness for the sdwdate-gui Qubes BASH glue -- the untrusted
## surface the Python suite cannot reach: sdwdate-gui.ConnectCheck,
## sdwdate-gui-qubes-proxy, sdwdate-gui-qubes-proxy-helper. Each case runs the
## REAL script (no synthetic copy) inside `unshare --user --mount
## --map-root-user` with a private tmpfs /run, the checkout's config-read +
## scripts bind-mounted over the installed copy, a crafted /etc/sdwdate-gui.d,
## and PATH stubs for qrexec-client-vm / qubesdb-read.
##
## Registered NON-CORE. Two SKIP paths, each a distinct dist-ai result code so
## an absent target and an absent capability are not conflated -- and never a
## silent exit 0 (the module is run through run-unittest.py, which maps an
## all-skipped / nothing-collected run to 78 / 77 as a backstop):
##   77 target-absent  -- the sdwdate-gui subject (its python package) is not
##                        present; set SDWDATE_GUI_REPO to a component checkout.
##   78 env-unmet      -- user namespaces (unshare + an unprivileged tmpfs
##                        mount) are unavailable, as a restricted sandbox forbids.
## No root (only mapped-root inside the userns), no network, no live qrexec.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/sdwdate-gui-tests" ]; then
   tests_dir="${script_dir}/../share/sdwdate-gui-tests"
else
   tests_dir='/usr/share/sdwdate-gui-tests'
fi

if [ -r "${script_dir}/../share/dist-ai-tests-common/run-unittest.py" ]; then
   run_unittest="${script_dir}/../share/dist-ai-tests-common/run-unittest.py"
else
   run_unittest='/usr/share/dist-ai-tests-common/run-unittest.py'
fi

## Target marker: the sdwdate_gui python package dir -- the SAME marker the
## harness's _subject() keys off, so a partial checkout cannot slip past this
## gate into an all-skipped (exit-0) run. Absent -> SKIP target-absent (77).
[ -v SDWDATE_GUI_REPO ] || SDWDATE_GUI_REPO=""
subject=''
if [ -n "${SDWDATE_GUI_REPO}" ]; then
   subject="${SDWDATE_GUI_REPO%/}"
fi
if [ -z "${subject}" ] || \
   [ ! -d "${subject}/usr/lib/python3/dist-packages/sdwdate_gui" ]; then
   printf '%s\n' "sdwdate-gui-tests-glue: SKIP (sdwdate-gui subject not found)" >&2
   printf '%s\n' "set SDWDATE_GUI_REPO to a component checkout" >&2
   ## style-ok: allow-skip: sdwdate-gui subject absent -- set SDWDATE_GUI_REPO
   exit 77
fi

## The harness drives the real scripts inside a user+mount namespace; a
## restricted sandbox (seccomp/sysctl) may forbid unprivileged userns or the
## tmpfs mount. That is a runtime CAPABILITY gap -> SKIP env-unmet (78), not 77.
if ! unshare --user --mount --map-root-user \
   bash -c 'mount -t tmpfs tmpfs /run' >/dev/null 2>&1; then
   printf '%s\n' "sdwdate-gui-tests-glue: SKIP (user namespaces / unprivileged tmpfs unavailable)" >&2
   ## style-ok: allow-skip: user namespaces unavailable -- the e2e harness needs unshare + tmpfs /run
   exit 78
fi

## Named explicitly (NOT 'test_*.py'): the core and coverage runners discover
## 'test_*.py', so this module must not match that pattern or they would collect
## the userns e2e tests into the wrong lane.
"${run_unittest}" --start-directory "${tests_dir}" --pattern 'glue_e2e_suite.py' "$@"
