#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Comprehensive test + fuzz for strip-markup (the helper-scripts strip_markup
## HTML/markup stripper). Proves it removes complete markup tags, neutralizes
## every residual markup metacharacter ('<', '>', '&' -> '_') so no tag or
## entity can be smuggled back in, falls back to underscore-sanitization when
## the HTML parser raises, handles the CLI arg grammar (string arg, stdin, '-',
## usage errors, closed stdin), and -- over a random-input fuzz phase -- never
## crashes, never hangs, keeps exit in {0,1}, and NEVER leaves a '<', '>' or '&'
## in its output. No root, no network. Targets the installed tool by default;
## set STRIP_MARKUP_REPO to a helper-scripts checkout to test that instead.
## Extra args (e.g. --iterations N, --seed N) pass through.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/strip-markup-tests" ]; then
   tests_dir="${script_dir}/../share/strip-markup-tests"
else
   tests_dir='/usr/share/strip-markup-tests'
fi

rc=0
python3 -- "${tests_dir}/strip_markup_test.py" "$@" || rc=$?
exit "${rc}"
