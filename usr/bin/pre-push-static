#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Pre-push static-checks gate. Mechanically enforces the items
## in developer-meta-files' agents/pre-push-checklist.md "Static
## checks" plus a tier of
## one-line-grep style-guide rules (Tier 1 in bash-style-guide
## scriptability terms):
##   1. bash -n on every changed shell script
##   2. shellcheck --external-sources on the same set (R-020,
##      R-022, R-073, R-080 et al. via shellcheck's own codes)
##   3. LC_ALL=C grep -PlI '[^\x00-\x7F]' on changed files (R-001),
##      plus a trailing-whitespace floor (space/tab before EOL) on
##      text files -- the always-on native counterpart to item 18's
##      trailing-whitespace-fixer, which is skipped when pre-commit-hooks
##      is absent
##   4. LC_ALL=C grep -P  '[^\x00-\x7F]' on the commit-range
##      message (R-001)
##   5. R-010 strict-mode block in top 160 lines -- the seven directives
##      'set -o errexit/nounset/pipefail/errtrace', 'shopt -s
##      inherit_errexit/shift_verbose', and 'export LC_ALL=C' (+ the
##      shopt/LC_ALL half in a guarded source-able block)
##   6. R-011 no 'set +o errexit' toggling
##      R-013 shell options set by long '-o' name, one per line (even in
##      sh); no 'set -eu' short form, no >1 option on a 'set' line
##   7. R-030/R-031 no bare-newline printf ('printf \n' or bare
##      'printf %s\n' with the data arg omitted; a newline must be
##      written 'printf %s\n' "" -- that '' data-arg form is correct
##      and is NOT itself flagged)
##   8. R-051 no inline trap command strings (use named function)
##   9. R-070 no ';;' trailing other statements on the same line
##      R-074 no ';'-chained break/continue/return (own line)
##      R-062 no '--' end-of-options separator passed to a tool on
##      the verified reject-'--' denylist (git check-ref-format,
##      stcat)
##  10. R-026 no obsolete empty-array guard '${arr[@]+"${arr[@]}"}'
##      R-021 locals declared separately from assignment (ADVISORY)
##      (pre-bash-4.4 nounset workaround; drop the +alternate on
##      '[@]'). Does NOT flag '${#arr[@]}', a plain '${arr[@]}',
##      or the ':-'/':+' conditional-substitution forms.
##  11. R-080 'shellcheck source=...' is a relative source-tree
##      path (no absolute /usr/..., /home/..., /dev/null)
##  12. R-081 no 'shellcheck source=/dev/null'
##      R-085 no '# shellcheck disable=SC1091' paired with an
##      adjacent '# shellcheck source=' directive (ADVISORY): the
##      reusable gate checks out helper-scripts as the repo sibling
##      when the consumer sets 'dist-ai-tests: helper-scripts: true',
##      so shellcheck FOLLOWS the source= directive and the disable is
##      dead. A disable with NO adjacent source= directive governs a
##      source shellcheck can never follow (a runtime temp file, a venv
##      activate, /dev/stdin) -- load-bearing, not flagged. '## style-ok:
##      allow-sc1091-disable' waives. See the 'shellcheck' skill.
##  13. R-090 'has' not 'command -v' (allowlist for documented
##      bootstrap exceptions per R-093)
##  14. R-102 no 'bash' / 'sh' prepend on script invocations
##      (applies to shell + yml files)
##  15. R-120 'safe-rm' not 'rm' (with conservative carve-outs
##      for comments and known safe constructs)
##  16. R-130 No ':' as bare no-op placeholder on its own line
##      (does NOT flag the ': "${var:=default}"' parameter-default
##      idiom widely used in the codebase)
##  17. R-034 no 'echo' command (use printf); '## style-ok: allow-echo'
##      R-063 a 'printf -v <dynamic-name>' must be guarded by
##      check_variable_name (an unchecked name evaluates an array
##      subscript -- 'name[$(cmd)]' RUNS cmd);
##      '## style-ok: allow-unchecked-printf-v'
##  18. R-103 no process-replacement 'exec <cmd>' (fd-redirect exec
##      exempt); '## style-ok: allow-exec'
##  19. pre-commit-hooks (direct binary execution, no framework)
##      against the right file-type subsets: check-yaml,
##      check-json, check-toml, check-xml, check-ast,
##      check-added-large-files, check-merge-conflict,
##      detect-aws-credentials, detect-private-key,
##      end-of-file-fixer, trailing-whitespace-fixer, ...
##      Skipped with a note if the 'pre-commit-hooks' binaries
##      aren't on PATH (developer machines that haven't installed
##      them still get the bash-style-guide gate; CI runs in
##      debian:trixie-slim with them apt-installed).
##  20. debian/changelog is genmkfile-owned and must not be
##      hand-edited. A commit touching debian/changelog passes only
##      if it is a genmkfile auto-bump ('bumped changelog version'
##      subject, changelog-family-only diff) or carries a mandatory
##      'Changelog-manual-ok: <reason>' override trailer.
##  21. R-153 no help/usage scraped from the script's own comments
##      ('grep ^## "$0" | sed ...'); help prints strings you own.
##  22. R-191 a systemd unit must not embed a multi-statement shell
##      script in an 'Exec*=' directive ('bash -c "a; b"'); move it to
##      a script with a shebang. '## style-ok: allow-embedded-script'.
##  23. R-100 a workflow 'run: |' block of more than 5 shell statements must
##      be extracted to a ci/ script. '## style-ok: allow-inline-shell'.
##  24. R-172 a 'mkdir' creating a temp dir ($TMPDIR/$TMP/$TEMP/$TEMPDIR)
##      must set the mode ATOMICALLY via '--mode' (never a later 'chmod':
##      that is a TOCTOU window); the short '-m' must be the long '--mode'
##      (canonically '--mode=700'; the space form is equally atomic). Judged
##      per mkdir command, so a '--mode' elsewhere on the line does not count.
##      '## style-ok: allow-mkdir-no-mode'.
##  25. R-200 a 'timeout N cmd' in command position must carry a kill-after
##      option ('--kill-after='/'-k'); SIGTERM alone can be ignored by a wedged
##      child, so the follow-up SIGKILL is what guarantees it dies. A timeout in
##      a string or as another command's argument is spared (fix by hand).
##      '## style-ok: allow-bare-timeout'.
##  26. R-194 an apt config hook (Pre-Invoke / Post-Invoke / Pre-Install-Pkgs)
##      must not embed a multi-statement shell command in its quoted value
##      ('{"a; b"}'); move it to a script. Per-line, single-line directives
##      only. '// style-ok: allow-embedded-script'.
##  27. R-195 a cron entry (in '*/cron.d/*' or a 'crontab' file) must not embed
##      a multi-statement command ('cmd1; cmd2', 'cmd | proc'); move it to a
##      script. '&&'/'||' glue is tolerated (no native cron alternative).
##      '# style-ok: allow-embedded-script'.
##  28. R-210 'apt-get' in command position should be the helper-scripts wrapper
##      'apt-get-noninteractive' (sets DEBIAN_FRONTEND=noninteractive etc.).
##      ADVISORY (notify-only), never a gate failure: detecting a shell COMMAND
##      position by regex cannot be made exact without a bash parser (quoted
##      strings, 'FOO=a;b apt-get' arg lists, case-arm patterns all fooled it),
##      and per the no-bash-parser rule an honest flag-for-human beats a fragile
##      matcher that FAILS valid pushes. The wrapper file itself is exempt.
##      Suppress the note: '## style-ok: allow-apt-get'.
##  29. R-211 a STATE-CHANGING 'dpkg' (--install/-i, --unpack, --configure,
##      --remove/-r, --purge/-P, --record-avail/-A, --{set,clear}-selections,
##      --{update,merge}-avail, --forget-old-unavail, --triggers-only) should be
##      'dpkg-noninteractive'. ADVISORY (notify-only), same reason as R-210.
##      Read-only queries ('dpkg --compare-versions', '-l', '-L', '-s', ...) and
##      the 'dpkg-*' sub-tools ('dpkg-deb', 'dpkg-query') are NOT noted.
##      Suppress the note: '## style-ok: allow-dpkg'.
##  30. R-212 '--allow-downgrades' is forbidden (silent downgrades hide a
##      dependency/repo regression); prefer the default refuse-downgrade.
##      Human-operator override: '## style-ok: allow-downgrades'.
##  31. R-213 'make_use_lintian=false' disables lintian and is forbidden without
##      authorization -- fix the lintian findings instead. Human-operator
##      override: '## style-ok: allow-lintian-disable'.
##
## Scope: files changed in HEAD vs upstream tracking branch
## (@{u}). Pass an explicit base ref as $1 to override
## (e.g. 'origin/master').
##
## Per-commit mode: pass '--per-commit' before the base ref to
## check each commit in <base>..HEAD individually (detached
## checkout per commit). Catches violations that existed in
## intermediate commits but were fixed before the branch tip --
## the default 'union' mode misses these because it diffs the
## merge-base against HEAD.
##
##   pre-push-static --per-commit origin/master
##
## Staged mode: pass '--staged' to check the staged index instead of
## a commit range (pre-commit semantics). The file LIST comes from the
## index ('git diff --cached'), but content checks read each path's
## WORKING-TREE copy -- a per-file warning is emitted when they differ
## (re-stage to check the exact blob). '--all' instead checks all
## tracked modifications vs HEAD (what 'git commit --all' records).
## '--message-file <path>' supplies the pending message so the R-001
## commit-message and changelog-trailer checks can run pre-commit;
## without it those two are skipped (push/CI still enforce them).
## '--staged' and '--per-commit' are mutually exclusive. Used by the
## Claude commit-gate hook (private-ai-config claude/hooks/dmf-gate.py).
##
##   pre-push-static --staged [--all] [--message-file MSG]
##
##   pre-push-static --staged --all --paths -- usr/bin/tool
##
## Style-guide deviations, documented for reviewers:
##   * R-040 (log not printf): self-contained tool, must run on
##     a developer machine that may lack helper-scripts. Same
##     precedent as .github/actions/install-deps/install-helper-scripts.sh
##     per R-093.
##   * R-090 (has not command -v): same reason; cannot source
##     has.sh without bootstrapping the dependency check itself.
##
## Exit codes:
##   0  - all checks passed
##   1  - one or more checks failed
##   2  - environment problem (no upstream, etc.)

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## Mode flags. Must precede the base-ref positional.
per_commit_mode=0
staged_mode=0
staged_all=0
message_file=''
paths_mode=0
files_mode=0
path_specs=()
while [ "$#" -ge 1 ]; do
   case "${1}" in
      --files)
         ## Lint the given files/dirs from DISK, decoupled from any git diff (the
         ## whole rule set over an arbitrary tree). Consumes the rest of the line,
         ## like --paths; a leading '--' separator is accepted and skipped.
         shift
         if [ "$#" -ge 1 ] && [ "${1}" = '--' ]; then
            shift
         fi
         files_mode=1
         path_specs=( "${@}" )
         set --
         break
         ;;
      --per-commit)
         per_commit_mode=1
         shift
         ;;
      --staged)
         staged_mode=1
         shift
         ;;
      --all)
         staged_all=1
         shift
         ;;
      --message-file)
         shift
         if [ "$#" -lt 1 ]; then
            printf '%s\n' 'pre-push-static: --message-file requires an argument' >&2
            exit 2
         fi
         message_file="${1}"
         shift
         ;;
      --paths)
         ## Restricts staged mode to these pathspecs; must come LAST, since it
         ## consumes the rest of the command line. What a pathspec commit
         ## ('git commit -- a b') needs: that commit records ONLY those paths,
         ## so gating the whole index reports violations in files the commit
         ## does not touch -- in a SHARED checkout, another session's
         ## unfinished work then blocks every commit. Matching is git's own.
         shift
         ## Everything after this is a pathspec, INCLUDING a leading '--':
         ## git's own separator, passed straight through so a path that looks
         ## like an option still reaches git as a path.
         if [ "$#" -ge 1 ] && [ "${1}" = '--' ]; then
            shift
         fi
         paths_mode=1
         path_specs=( "${@}" )
         set --
         break
         ;;
      *)
         break
         ;;
   esac
done

if [ "${paths_mode}" -eq 1 ]; then
   if [ "${staged_mode}" -eq 0 ]; then
      printf '%s\n' 'pre-push-static: --paths only applies with --staged' >&2
      exit 2
   fi
   if [ "${#path_specs[@]}" -eq 0 ]; then
      printf '%s\n' 'pre-push-static: --paths requires at least one pathspec' >&2
      exit 2
   fi
fi

if [ "${files_mode}" -eq 1 ]; then
   if [ "${#path_specs[@]}" -eq 0 ]; then
      printf '%s\n' 'pre-push-static: --files requires at least one path' >&2
      exit 2
   fi
   if [ "${staged_mode}" -eq 1 ] || [ "${per_commit_mode}" -eq 1 ]; then
      printf '%s\n' 'pre-push-static: --files is exclusive with --staged / --per-commit' >&2
      exit 2
   fi
   ## Validate existence HERE, at top level: list_given_paths runs inside a
   ## process-substitution subshell where an 'exit' cannot stop the gate, so a
   ## mistyped path there would yield an empty file list and a false "all passed".
   for _spec in "${path_specs[@]}"; do
      if [ ! -e "${_spec}" ]; then
         printf '%s\n' "pre-push-static: no such path: '${_spec}'" >&2
         exit 2
      fi
   done
fi

if [ "${staged_mode}" -eq 1 ] && [ "${per_commit_mode}" -eq 1 ]; then
   printf '%s\n' 'pre-push-static: --staged and --per-commit are mutually exclusive' >&2
   exit 2
fi
if [ "${staged_all}" -eq 1 ] && [ "${staged_mode}" -eq 0 ]; then
   printf '%s\n' 'pre-push-static: --all only applies with --staged' >&2
   exit 2
fi

if [ -n "${message_file}" ] && [ ! -f "${message_file}" ]; then
   printf '%s\n' "pre-push-static: --message-file '${message_file}' not found" >&2
   exit 2
fi
## Canonicalize to an absolute path now, at the invocation directory:
## main() cd's to the repo root before any cat/head reads the message file,
## so a relative --message-file passed from a subdirectory would otherwise
## resolve against the wrong directory after the cd.
if [ -n "${message_file}" ]; then
   message_file="$(readlink --canonicalize -- "${message_file}")" || {
      printf '%s\n' "pre-push-static: could not resolve --message-file path" >&2
      exit 2
   }
fi

## Nested-brace expansion `${1:-@{u}}` mis-parses: bash terminates
## the outer expansion at the first `}`, leaving a literal `}`
## appended to the result. The no-arg case happens to reconstruct
## `@{u}` by accident; any explicit arg gets a spurious `}` glued
## on. Guard with a plain conditional instead.
##
## Hook-invocation note: when this script is wired as
## .git/hooks/pre-push, git invokes it with `$1=<remote-name>` (e.g.
## `origin`) and `$2=<remote-url>`. A bare remote name is NOT a
## resolvable base ref, so we detect that case by checking against
## `git remote` and fall back to `@{u}` (the upstream tracking
## branch, which is the right base for "what am I about to push").
if [ "${staged_mode}" -eq 1 ]; then
   ## Staged mode diffs the index against HEAD, so HEAD is the base a staged
   ## change is measured from. The push-mode default '@{u}' is wrong here and
   ## breaks on a branch with no upstream (unresolvable): the "already tracked"
   ## large-file exclusion runs 'git cat-file -e "${base_ref}:FILE"', which then
   ## fails for every path, so a pre-existing large file the change merely
   ## touches is misread as newly added and fails check-added-large-files.
   base_ref='HEAD'
elif [ "$#" -ge 1 ] && [ -n "${1}" ]; then
   if git remote 2>/dev/null | grep --line-regexp --fixed-strings -- "${1}" >/dev/null; then
      base_ref='@{u}'
   else
      base_ref="${1}"
   fi
else
   base_ref='@{u}'
fi
fail_count=0

## Untrusted content (a flagged source line, a commit-message line) is
## emitted as-is. Terminal-safe rendering is the DISPLAY layer's job, not
## this dependency-free hook's: pipe the output through 'sanitize-string' /
## 'stcat' if you need ANSI/control-byte defanging (R-140 display sink).
note() {
   printf '%s\n' "pre-push-static: ${1}" >&2
}

fail() {
   note "FAIL ${1}: ${2}"
   fail_count=$((fail_count + 1))
}

resolve_base() {
   local rc

   rc=0
   git rev-parse --verify --quiet "${base_ref}" >/dev/null || rc=$?
   if [ "${rc}" -ne 0 ]; then
      note "cannot resolve base ref '${base_ref}'. Pass a base, e.g. 'origin/master'."
      exit 2
   fi
}

## Emits the changed paths NUL-terminated. 'core.quotePath=false' stops git
## from C-quoting (wrapping in '"..."' with backslash escapes) paths that
## contain a tab, a byte >= 0x80, etc.; '-z' NUL-terminates so a path
## containing a newline or tab stays one record. Consumers must read with
## 'read -r -d ""' / 'mapfile -d ""'. Without this a hostile or merely
## awkward filename (e.g. $'x\ty.sh') was emitted as a quoted string that
## exists on no disk path, so every content check silently skipped it.
## --files mode: enumerate the given files/dirs from DISK (no git), NUL-delimited.
## A directory is walked (skipping .git); a missing path is a loud error, never a
## silent skip. Mirrors dist_ai.bash_ast.walk_files for the detector/fixer.
list_given_paths() {
   local spec
   for spec in "${path_specs[@]}"; do
      if [ -d "${spec}" ]; then
         find "${spec}" -name .git -prune -o -type f -print0
      elif [ -e "${spec}" ]; then
         printf '%s\0' "${spec}"
      else
         printf '%s\n' "pre-push-static: no such path: '${spec}'" >&2
         exit 2
      fi
   done
}

list_changed_files() {
   if [ "${files_mode}" -eq 1 ]; then
      list_given_paths
      return 0
   fi
   if [ "${staged_mode}" -eq 1 ]; then
      if [ "${paths_mode}" -eq 1 ]; then
         ## Pathspec matching is git's own, so a directory or glob behaves
         ## exactly as it does in the commit being gated.
         if [ "${staged_all}" -eq 1 ] && git rev-parse --verify --quiet HEAD >/dev/null; then
            git -c core.quotePath=false diff -z --name-only --diff-filter=ACMRT HEAD -- "${path_specs[@]}"
         else
            git -c core.quotePath=false diff -z --name-only --diff-filter=ACMRT --cached -- "${path_specs[@]}"
         fi
         return 0
      fi
      if [ "${staged_all}" -eq 1 ] && git rev-parse --verify --quiet HEAD >/dev/null; then
         git -c core.quotePath=false diff -z --name-only --diff-filter=ACMRT HEAD
      else
         git -c core.quotePath=false diff -z --name-only --diff-filter=ACMRT --cached
      fi
      return 0
   fi
   git -c core.quotePath=false diff -z --name-only --diff-filter=ACMRT "${base_ref}"...HEAD
}

is_shell_file() {
   local path first

   path="${1}"
   if [ ! -f "${path}" ]; then
      return 1
   fi
   case "${path}" in
      *.sh|*.bsh)
         return 0
         ;;
   esac
   first=""
   read -r first < "${path}" || true
   ## 'read' strips the trailing '\n' but NOT a '\r'; a CRLF-terminated
   ## shebang would leave 'first' ending in '\r', which the end-anchored
   ## globs below never match -- silently dropping the file from the shell
   ## tier (bash -n, shellcheck, every R-check). Strip one trailing CR so a
   ## CRLF shebang is still detected.
   first="${first%$'\r'}"
   ## Match ONLY a bash/sh/dash interpreter, anchored so the shell NAME is
   ## the command (preceded by '/' as in '#!/bin/bash', or by a space as in
   ## '#!/usr/bin/env bash'), optionally followed by args. The old '*sh'
   ## glob matched any interpreter ENDING in 'sh' -- '#!/bin/zsh',
   ## '#!/usr/bin/fish' -- which then failed 'bash -n' with a spurious
   ## parse error on valid zsh/fish syntax.
   case "${first}" in
      '#!'*/bash|'#!'*/bash' '*|'#!'*' bash'|'#!'*' bash '*)
         return 0
         ;;
      '#!'*/sh|'#!'*/sh' '*|'#!'*' sh'|'#!'*' sh '*)
         return 0
         ;;
      '#!'*/dash|'#!'*/dash' '*|'#!'*' dash'|'#!'*' dash '*)
         return 0
         ;;
   esac
   return 1
}

check_bash_n() {
   local script rc

   for script in "${@}"; do
      rc=0
      bash -n -- "${script}" || rc=$?
      if [ "${rc}" -ne 0 ]; then
         fail "bash -n" "'${script}' failed parse"
      fi
   done
}

check_shellcheck() {
   local script rc

   ## R-090 deviation: command -v used instead of has.sh; this
   ## script must be runnable as a bare git hook without
   ## helper-scripts on PATH.
   if ! command -v shellcheck >/dev/null 2>&1; then
      note "shellcheck not on PATH; skipping (apt-get install shellcheck)"
      return 0
   fi
   ## Optional checks, kept IDENTICAL to the set ai-review's static reviewer enables, so a
   ## file cannot be gate-green and still carry findings the reviewer reports. They diverged
   ## before: the gate ran the default set only, and R-020 (require-variable-braces) debt
   ## accumulated invisibly -- measured at 1786 findings across 44 of 60 derivative-maker
   ## scripts while the gate reported zero.
   ##
   ## 'add-default-case' (SC2249) is deliberately NOT in the set, and is excluded from the
   ## reviewer's list too so the two stay aligned. It has no autofix, and on this codebase it
   ## fires on match-or-ignore filters where no default action is wanted -- a loop that
   ## umounts only paths under the build tree, a dispatcher that returns early for skipped
   ## functions -- so satisfying it means appending a do-nothing '*) ;;' that states nothing.
   ## Its own advice, "even if it just exits with error", would be actively wrong there.
   local shellcheck_optional_checks
   shellcheck_optional_checks='avoid-nullary-conditions,check-unassigned-uppercase,deprecate-which,quote-safe-variables,require-variable-braces'

   for script in "${@}"; do
      rc=0
      ## '--source-path=SCRIPTDIR' because shellcheck otherwise resolves a
      ## '# shellcheck source=' path relative to the CURRENT WORKING DIRECTORY,
      ## not to the script's own directory. Every such directive in these repos
      ## is written script-relative -- helper-scripts' usr/bin/gpg-dearmor has
      ## 'source=../libexec/helper-scripts/has.sh', correct from usr/bin/ -- so
      ## running the gate from the repo root made them all resolve OUTSIDE the
      ## repo and report SC1091 "does not exist". Every SC2154 followed from
      ## that: with the sourced file unread, the variables it defines look
      ## unassigned.
      ##
      ## Measured before landing, because this changes the gate for every repo:
      ##   helper-scripts  155 bash files, 80 fail -> 46 fail  (34 fixed)
      ##   6 other packages, 67 files            no change at all
      ## It fixes files or leaves them alone; on that sample it made nothing
      ## worse. Regression test: tests/shellcheck-source-path-test.sh
      shellcheck --external-sources --source-path=SCRIPTDIR \
         --enable="${shellcheck_optional_checks}" -- "${script}" || rc=$?
      if [ "${rc}" -ne 0 ]; then
         fail "shellcheck" "'${script}'"
      fi
   done
}

check_ascii_files() {
   local hits line f
   local -a fs

   ## Same regular-file floor as check_trailing_whitespace: a submodule
   ## gitlink is a DIRECTORY in the work tree and grep errors on it.
   fs=()
   for f in "${@}"; do
      if [ ! -f "${f}" ] || [ -L "${f}" ]; then
         continue
      fi
      fs+=("${f}")
   done
   if [ "${#fs[@]}" -eq 0 ]; then
      return 0
   fi
   hits="$(LC_ALL=C grep --files-with-matches --binary-files=without-match --perl-regexp '[^\x00-\x7F]' -- "${fs[@]}" || true)"
   if [ -z "${hits}" ]; then
      return 0
   fi
   while IFS= read -r line; do
      ## File-based allowlist: a .gitattributes binary data file (a raw payload /
      ## captured byte stream / fixture) is exempt from the ASCII rule, like a
      ## PNG. Unlike the comment waiver below it needs no in-file marker, so it
      ## also covers a blob that cannot carry a '## style-ok' comment.
      if is_data_file "${line}"; then
         note "R-001 skipped: '${line}' is a .gitattributes binary data file"
         continue
      fi
      ## Per-file waiver: '## style-ok: allow-non-ascii' anywhere in the file.
      ## A test for a sanitizer has to CONTAIN the bytes it asserts are
      ## stripped -- stdisplay's suite pins ("O-umlaut ...", "_ or _") -- so the
      ## non-ASCII is the fixture, not a slip. Anchored regex and a per-file
      ## opt-in, mirroring the R-120 waiver, so the ASCII rule stays default-on
      ## everywhere else and each exception is visible in the file itself.
      if grep --quiet --extended-regexp \
         '^[[:space:]]*##[[:space:]]*style-ok:[[:space:]]*allow-non-ascii([[:space:]]|$)' \
         -- "${line}"; then
         note "R-001 skipped: 'style-ok: allow-non-ascii' waiver in '${line}'"
         continue
      fi
      fail "R-001 ASCII" "'${line}' contains non-ASCII bytes"
   done <<< "${hits}"
}

## Always-on floor for trailing whitespace (a space or tab immediately
## before end-of-line). The pre-commit 'trailing-whitespace-fixer'
## (check_precommit_hooks) is the richer superset that also autofixes, but
## it is SKIPPED whenever the pre-commit-hooks binaries are absent; this
## native grep runs unconditionally so a developer machine without them
## still enforces it. Scoped to text files (is_text_file), symlinks skipped.
check_trailing_whitespace() {
   local f hits rc
   local -a fs

   fs=()
   for f in "${@}"; do
      if [ ! -f "${f}" ] || [ -L "${f}" ]; then
         continue
      fi
      if is_text_file "${f}"; then
         fs+=("${f}")
      fi
   done
   if [ "${#fs[@]}" -eq 0 ]; then
      return 0
   fi
   ## '[[:blank:]]' is space or tab -- matches trailing-whitespace-fixer's
   ## default strip set. '\r?' also catches a blank BEFORE a CRLF line ending
   ## (grep strips only the '\n', leaving the '\r' between the blank and
   ## end-of-line); a bare '\r' (a clean CRLF line) is not flagged. PCRE
   ## ('--perl-regexp') so the '\r' escape is portable. '--binary-files=
   ## without-match' is belt-and-braces past the is_text_file filter so a
   ## mislabeled blob is skipped, not reported byte-by-byte.
   rc=0
   hits="$(grep --with-filename --line-number --binary-files=without-match \
      --perl-regexp '[[:blank:]]+\r?$' -- "${fs[@]}")" || rc=$?
   ## grep exit: 0 match, 1 no match, >1 a real error (unreadable / vanished
   ## file). An always-on floor must not silently pass on an error, so fail
   ## loudly rather than swallow a >1 status as 'clean'.
   if [ "${rc}" -gt 1 ]; then
      fail "trailing-whitespace" "grep failed (exit ${rc}) scanning changed files; cannot verify"
      return 0
   fi
   emit_hits "trailing-whitespace" "${hits}"
}

check_ascii_commit_msg() {
   local msg hits

   if [ "${staged_mode}" -eq 1 ]; then
      if [ -z "${message_file}" ]; then
         note "staged mode: no --message-file; skipping commit-message R-001 check"
         return 0
      fi
      msg="$(cat -- "${message_file}")"
   else
      msg="$(git log "${base_ref}..HEAD" --format='%B%n')"
   fi
   if [ -z "${msg}" ]; then
      return 0
   fi
   hits="$(LC_ALL=C grep --line-number --perl-regexp '[^\x00-\x7F]' <<< "${msg}" || true)"
   if [ -z "${hits}" ]; then
      return 0
   fi
   fail "R-001 ASCII" "commit-range message contains non-ASCII"
   note "offending line(s):"
   printf '%s\n' "${hits}" >&2
}

## --- Packaging-convention check: debian/changelog is genmkfile-owned ---
##
## debian/changelog must NOT be hand-edited; genmkfile auto-generates
## the version bumps (project convention: 'genmkfile
## deb-chl-bumpup-major'). A commit that modifies debian/changelog is
## accepted only when it is EITHER:
##   1. a genmkfile auto-bump commit -- subject is exactly
##      'bumped changelog version' (from 'deb-uachl-commit-changelog')
##      and it touches only changelog-family files (debian/changelog
##      and/or changelog.upstream); OR
##   2. an intentional manual edit carrying a mandatory override
##      trailer 'Changelog-manual-ok: <reason>' in its commit message.
## Any other commit touching debian/changelog FAILs the gate.
##
## Runs once over base..HEAD (independent of --per-commit), like the
## commit-message ASCII check: each commit is inspected individually so
## an auto-bump commit and a feature commit in the same range are judged
## on their own merits.
changelog_autobump_subject='bumped changelog version'

is_changelog_path() {
   case "${1}" in
      debian/changelog|*/debian/changelog)
         return 0
         ;;
   esac
   return 1
}

is_changelog_family_path() {
   case "${1}" in
      debian/changelog|*/debian/changelog|changelog.upstream|*/changelog.upstream)
         return 0
         ;;
   esac
   return 1
}

check_changelog_no_manual() {
   local sha subject body file touches_changelog only_family
   local -a changed

   while IFS= read -r sha; do
      if [ -z "${sha}" ]; then
         continue
      fi
      changed=()
      ## '-c' takes the COMBINED diff so a merge commit's own edits (an
      ## "evil merge" that hand-edits debian/changelog in the merge itself)
      ## are seen; a plain 'diff-tree -r' can emit nothing for a merge and
      ## the check would skip it. '-z' + quotePath=false keep awkward paths
      ## intact (see list_changed_files).
      mapfile -d '' -t changed < <(git -c core.quotePath=false diff-tree --no-commit-id --name-only -z -c -r "${sha}")
      if [ "${#changed[@]}" -eq 0 ]; then
         continue
      fi
      touches_changelog=0
      only_family=1
      for file in "${changed[@]}"; do
         if [ -z "${file}" ]; then
            continue
         fi
         if is_changelog_path "${file}"; then
            touches_changelog=1
         fi
         if ! is_changelog_family_path "${file}"; then
            only_family=0
         fi
      done
      if [ "${touches_changelog}" -eq 0 ]; then
         continue
      fi
      ## genmkfile auto-bump: exact subject AND changelog-family-only diff.
      subject="$(git log -1 --format=%s "${sha}")"
      if [ "${subject}" = "${changelog_autobump_subject}" ] && [ "${only_family}" -eq 1 ]; then
         continue
      fi
      ## Manual override: mandatory non-empty reason after the trailer.
      body="$(git log -1 --format=%B "${sha}")"
      if grep --quiet --ignore-case --extended-regexp \
         '^[[:space:]]*changelog-manual-ok:[[:space:]]*[^[:space:]]' <<< "${body}"; then
         continue
      fi
      fail "changelog manual-edit" "commit ${sha} edits debian/changelog (genmkfile-owned); bump via 'genmkfile deb-chl-bumpup-major', or add a 'Changelog-manual-ok: <reason>' trailer to the commit message"
   done < <(git rev-list --reverse "${base_ref}..HEAD")
}

## Staged-mode counterpart of check_changelog_no_manual: there is no
## commit yet, so judge the staged diff as a single pending commit.
## debian/changelog may be staged only as a genmkfile auto-bump
## (requires --message-file carrying the exact subject AND a
## changelog-family-only staged diff) or with a 'Changelog-manual-ok:'
## override trailer. Without a message file we cannot read the pending
## subject/trailer, so we defer to push/CI rather than fail blindly.
check_changelog_no_manual_staged() {
   local file subject body touches_changelog only_family
   local -a changed

   changed=()
   ## list_changed_files emits NUL-terminated records; read them NUL-safely
   ## (mapfile -d ''). A plain 'mapfile -t' collapses the whole NUL stream
   ## into one mangled element, so with more than one staged file the
   ## changelog paths are never recognized and a hand edit slips the gate.
   mapfile -d '' -t changed < <(list_changed_files)
   if [ "${#changed[@]}" -eq 0 ]; then
      return 0
   fi
   touches_changelog=0
   only_family=1
   for file in "${changed[@]}"; do
      if [ -z "${file}" ]; then
         continue
      fi
      if is_changelog_path "${file}"; then
         touches_changelog=1
      fi
      if ! is_changelog_family_path "${file}"; then
         only_family=0
      fi
   done
   if [ "${touches_changelog}" -eq 0 ]; then
      return 0
   fi
   if [ -z "${message_file}" ]; then
      note "staged mode: debian/changelog staged but no --message-file; deferring changelog-trailer check to push/CI"
      return 0
   fi
   subject="$(head --lines=1 -- "${message_file}")"
   if [ "${subject}" = "${changelog_autobump_subject}" ] && [ "${only_family}" -eq 1 ]; then
      return 0
   fi
   body="$(cat -- "${message_file}")"
   if grep --quiet --ignore-case --extended-regexp \
      '^[[:space:]]*changelog-manual-ok:[[:space:]]*[^[:space:]]' <<< "${body}"; then
      return 0
   fi
   fail "changelog manual-edit" "staged debian/changelog edit (genmkfile-owned); bump via 'genmkfile deb-chl-bumpup-major', or add a 'Changelog-manual-ok: <reason>' trailer to the commit message"
}

## --- Tier 1 style-guide checks (single-grep, near-zero false-positive) ---

## Match <regex> against each line of <file...> with shell COMMENTS REMOVED, and
## report the ORIGINAL line as 'file:lineno:text' (emit_hits' shape).
##
## A '#' begins a comment only at the start of a word -- line start, or after
## whitespace. The older '^[^#]*' anchor instead treated ANY '#' as the start of a
## comment, so a '${#var}' length expansion or a '$#' made the rest of the line
## unmatchable and a real violation went unreported. Concretely,
## '0) out+="${set:0:${#set}}" ;;' was NOT flagged while the identical
## '1) out+="${plain}" ;;' was.
##
## Residual (accepted, same class as R-034/R-120): a '#' preceded by whitespace
## but INSIDE a quoted string is treated as a comment, so a violation after it is
## missed. That is a false NEGATIVE, and far rarer than the '${#var}' one it
## replaces.
grep_code_lines() {
   local regex file lineno rest source_line
   local -a source_lines

   regex="${1}"
   shift
   for file in "${@}"; do
      [ -r "${file}" ] || continue
      mapfile -t source_lines < "${file}"
      while IFS=: read -r lineno rest; do
         ## Pre-compose: R-030 keeps the format fixed and the data in the
         ## argument, so a value containing a percent sign cannot be read as a
         ## conversion.
         source_line="${source_lines[$(( lineno - 1 ))]}"
         printf '%s\n' "${file}:${lineno}:${source_line}"
      done < <(sed -e 's/\(^\|[[:space:]]\)#.*$//' -- "${file}" 2>/dev/null \
         | grep --line-number --extended-regexp -- "${regex}" 2>/dev/null || true)
   done
}

emit_hits() {
   local rule_tag hits line

   rule_tag="${1}"
   hits="${2}"
   if [ -z "${hits}" ]; then
      return 0
   fi
   while IFS= read -r line; do
      fail "${rule_tag}" "${line}"
   done <<< "${hits}"
}

is_self_referential() {
   case "${1}" in
      usr/bin/pre-push-static)
         return 0
         ;;
   esac
   return 1
}


## Some scripts (including this one) carry long-form header
## docstrings before the strict-mode block; head -160 is generous
## enough to accommodate them without missing the rule's intent.
check_R010_strict_block() {
   local script header directive present shopt_missing
   local -a required

   required=(
      'set -o errexit'
      'set -o nounset'
      'set -o pipefail'
      'set -o errtrace'
      'shopt -s inherit_errexit'
      'shopt -s shift_verbose'
      'export LC_ALL=C'
   )
   for script in "${@}"; do
      ## Script-wide waiver: '## style-ok: no-strict' anywhere in the
      ## file exempts it ENTIRELY. For sourced-ONLY fragments never
      ## executed (so no was_executed()/was_sourced() guard): '/etc/
      ## profile.d/*.sh' login-shell fragments, '.bashrc.d' snippets, and
      ## dual-mode scripts that deliberately keep a MINIMAL strict set
      ## (e.g. helper-scripts 'onion-time-pre-script' omits nounset by
      ## design). Enabling strict-mode in a sourced fragment would leak
      ## 'set -o errexit'/'nounset' into (and could kill) the sourcing
      ## shell. Same escape-hatch shape as 'no-has'/'no-safe-rm'. Checked
      ## first so a waived script never reaches the shopt sub-check below.
      if grep --quiet --extended-regexp \
            '^[[:space:]]*##[[:space:]]*style-ok:[[:space:]]*no-strict([[:space:]]|$)' \
            -- "${script}"; then
         note "R-010 skipped: 'style-ok: no-strict' waiver in '${script}'"
         continue
      fi
      ## Count DISTINCT required directives present at column 0 (whole-line,
      ## fixed-string match), not matching LINES: seven copies of
      ## 'set -o errexit' must NOT satisfy the block. head -160 accommodates
      ## the long header docstrings some scripts carry before the block.
      header="$(head --lines=160 -- "${script}")"
      present=0
      for directive in "${required[@]}"; do
         if grep --quiet --line-regexp --fixed-strings -- "${directive}" <<< "${header}"; then
            present=$((present + 1))
         fi
      done
      ## Source-able dual-mode scripts (executed AND sourced for code
      ## reuse, e.g. usr/bin/update-torbrowser sourced by
      ## dist-installer-gui; or pure helper-script .bsh libraries) MUST
      ## NOT enable strict-mode at top level: 'set -o errexit'/'nounset'
      ## and 'shopt -s inherit_errexit' would leak into the sourcing
      ## shell. Such scripts therefore keep ZERO column-0 strict lines
      ## and guard the block behind the helper-scripts
      ## was_executed()/was_sourced() runtime check (indented, invisible
      ## to the whole-line match above). This shape -- fully guarded
      ## (present 0) AND the guard present -- is exempt from R-010's
      ## top-level all-7 requirement. A partial top-level block
      ## (present 1..6) is not a clean source-able script and stays
      ## subject to the all-7 check below. This condition also leaves this
      ## script itself enforced: it keeps all seven distinct column-0
      ## directives, so it never enters the guarded path despite naming
      ## the tokens.
      ## '^[^#]*' requires the guard in CODE, not a comment: without it a
      ## mere '## TODO: add was_executed guard' would exempt a script with no
      ## strict-mode block at all -- an unauditable bypass. The guard must be
      ## a real CALL, so the token sits in command position: preceded by
      ## line-start or a command separator ([[:space:];&|!(]) and followed by
      ## whitespace / a separator / end-of-line ([[:space:];&|)]|$). This
      ## rejects an ordinary assignment ('was_executed=1', token followed by
      ## '=') and a string/param-expansion mention ('"was_sourced"',
      ## '${was_sourced}', token preceded by a quote or brace), either of
      ## which would otherwise exempt a strict-mode-less script.
      if [ "${present}" -eq 0 ] \
         && grep --quiet --extended-regexp \
            '^[^#]*(^|[[:space:];&|!(])(was_executed|was_sourced)([[:space:];&|)]|$)' \
            -- "${script}"; then
         ## The guarded block is exempt from the all-7 top-level rule, but
         ## the SHOPT half of the strict block ('shopt -s inherit_errexit'
         ## and 'shopt -s shift_verbose') plus 'export LC_ALL=C' were
         ## repeatedly FORGOTTEN in this form -- authors copy the
         ## 'set -o errexit/nounset/pipefail/errtrace' lines but drop the
         ## rest -- precisely because nothing checked the indented block.
         ## Enforce them here.
         ## Only when the guard actually ENABLES errexit (an indented
         ## 'set -o errexit'): inherit_errexit completes errexit's contract
         ## ('$()' subshells respect it) and shift_verbose belongs with it.
         ## The 'set -o errexit/nounset/pipefail' choice itself stays the
         ## script's own -- some defer pipefail or omit nounset for
         ## documented reasons -- so it is NOT re-checked here.
         ## Scope is deliberately WHOLE-FILE: the strict block's guard is
         ## script-specific ('if was_executed ...', 'if [ "${X_sourced}" =
         ## false ]', ...), so there is no fixed delimiter to scope to. A
         ## false pass needs both shopt omitted from the guard yet present
         ## elsewhere -- and these strict-preamble-only builtins do not
         ## occur loose in function bodies, so that is not a real accident.
         if grep --quiet --extended-regexp \
               '^[[:space:]]+set -o errexit[[:space:]]*$' -- "${script}"; then
            shopt_missing=""
            grep --quiet --extended-regexp \
               '^[[:space:]]*shopt -s inherit_errexit[[:space:]]*$' -- "${script}" \
               || shopt_missing="shopt -s inherit_errexit"
            if ! grep --quiet --extended-regexp \
                  '^[[:space:]]*shopt -s shift_verbose[[:space:]]*$' -- "${script}"; then
               if [ -n "${shopt_missing}" ]; then
                  shopt_missing="${shopt_missing}, shopt -s shift_verbose"
               else
                  shopt_missing="shopt -s shift_verbose"
               fi
            fi
            ## 'export LC_ALL=C' MUST also live inside the guard, indented: an
            ## unguarded top-level 'export LC_ALL=C' in a source-able script
            ## leaks the C locale into the sourcing shell (worse than the shopt
            ## leak -- an env mutation, silent). Enforced alongside the shopt
            ## half for the same reason: copying the 'set -o' lines makes it
            ## easy to place at column 0 by reflex, where it would leak.
            ## Like the shopt half, this is a WHOLE-FILE match (the guard has no
            ## fixed delimiter to scope to), so an indented 'export LC_ALL=C'
            ## ELSEWHERE would satisfy it. Unlike the preamble-only shopt
            ## builtins an export could in principle sit loose in a function, so
            ## the guarantee is looser here -- accepted under the AI-accident
            ## threat model (the block is copied in as a unit); tightening it to
            ## the guarded block needs the bash-block parser the gate avoids.
            if ! grep --quiet --extended-regexp \
                  '^[[:space:]]+export LC_ALL=C[[:space:]]*$' -- "${script}"; then
               if [ -n "${shopt_missing}" ]; then
                  shopt_missing="${shopt_missing}, export LC_ALL=C"
               else
                  shopt_missing="export LC_ALL=C"
               fi
            fi
            if [ -n "${shopt_missing}" ]; then
               fail "R-010 shopt block" "source-able guarded script '${script}' enables errexit but its was_executed block is missing: ${shopt_missing}"
            else
               note "R-010: source-able guarded script '${script}' -- strict shopt block present"
            fi
         else
            note "R-010 skipped: source-able guarded script (no strict-mode enabled) '${script}'"
         fi
         continue
      fi
      if [ "${present}" -lt "${#required[@]}" ]; then
         fail "R-010 strict-mode block" "'${script}' has only ${present}/${#required[@]} distinct strict-mode directives in head -160"
      fi
   done
}

check_R011_errexit_toggle() {
   local script hits
   local -a unwaived_scripts

   ## Script-wide waiver: '## style-ok: allow-errexit-toggle' anywhere in a
   ## file disables R-011 for that file (same shape as the 'no-has' /
   ## 'no-safe-rm' waivers). R-011 targets the capture-an-exit-code toggle
   ## anti-pattern; a deliberate GLOBAL mode switch is legitimate --
   ## derivative-maker 'help-steps/pre' turns errexit off so its ERR-trap
   ## exception handler can RESUME execution (auto-retry / interactive
   ## continue), which errexit makes impossible. Anchored regex (not
   ## --fixed-strings) so a typo'd superset does not silently disable the
   ## check.
   unwaived_scripts=()
   for script in "${@}"; do
      if grep --quiet --extended-regexp \
         '^[[:space:]]*##[[:space:]]*style-ok:[[:space:]]*allow-errexit-toggle([[:space:]]|$)' \
         -- "${script}"; then
         note "R-011 skipped: 'style-ok: allow-errexit-toggle' waiver in '${script}'"
         continue
      fi
      unwaived_scripts+=( "${script}" )
   done
   [ "${#unwaived_scripts[@]}" -gt 0 ] || return 0

   ## Both the long form ('set +o errexit') and the short form ('set +e',
   ## 'set +ex', 'set +xe'): '\+([a-z]*e[a-z]*)' matches a short option
   ## bundle that contains 'e'. 'set +u'/'set +o pipefail' (no errexit) do
   ## not match. Anchored at 'set', so a '## set +e' comment is spared.
   hits="$(grep --with-filename --line-number --extended-regexp '^[[:space:]]*set[[:space:]]+\+(o[[:space:]]+errexit|[a-z]*e[a-z]*)' -- "${unwaived_scripts[@]}" 2>/dev/null || true)"
   emit_hits "R-011 errexit toggle" "${hits}"
}

check_R013_set_options() {
   local script hits
   local -a unwaived_scripts

   ## R-013: set shell options by long '-o' name, one per line, even in
   ## POSIX sh (dash / busybox sh both VALIDATE and IMPLEMENT 'set -o
   ## errexit' / 'nounset' / 'pipefail'). Script-wide waiver
   ## '## style-ok: allow-short-set'.
   unwaived_scripts=()
   for script in "${@}"; do
      if grep --quiet --extended-regexp \
         '^[[:space:]]*##[[:space:]]*style-ok:[[:space:]]*allow-short-set([[:space:]]|$)' \
         -- "${script}"; then
         note "R-013 skipped: 'style-ok: allow-short-set' waiver in '${script}'"
         continue
      fi
      unwaived_scripts+=( "${script}" )
   done
   [ "${#unwaived_scripts[@]}" -gt 0 ] || return 0

   ## Two shapes, both anchored at 'set' so a '## set -eu' comment is spared:
   ##  1. a SHORT-flag enable of errexit/nounset -- ANY '-'-flag token whose
   ##     bundle contains a lowercase 'e' or 'u', scanned across the OPTION
   ##     tokens only, so 'set -e', 'set -eu', 'set -euo pipefail', 'set -x -e'
   ##     (later token), 'set -Eeuo pipefail' (uppercase flags in the bundle) and
   ##     'set -o errexit -u' (long then short) all match. '[a-zA-Z]*[eu]'
   ##     requires the lowercase e/u, so 'set -E' (errtrace) and 'set -x' /
   ##     'set -f' (no e/u) are spared; 'set -o <name>' carries no such token.
   ##     The leading-token skip STOPS at a bare '--' (end-of-options: whatever
   ##     follows is positional, e.g. 'set -- -e', 'set -- "$@" -eu') and at a
   ##     '#' comment token ('set -o errexit # ...set -e'), so neither is a false
   ##     positive. The '+' toggle is R-011's job.
   ##  2. MORE THAN ONE option on one 'set' line -- two '[+-]o <name>'.
   hits="$(grep --with-filename --line-number --extended-regexp \
      '^[[:space:]]*set[[:space:]]+((-[^-[:space:]][^[:space:]]*|--[^[:space:]][^[:space:]]*|[^-#[:space:]][^[:space:]]*)[[:space:]]+)*-[a-zA-Z]*[eu]|^[[:space:]]*set[[:space:]]+[+-]o[[:space:]]+[^[:space:]]+[[:space:]]+[+-]o[[:space:]]' \
      -- "${unwaived_scripts[@]}" 2>/dev/null || true)"
   emit_hits "R-013 set options long-form one-per-line" "${hits}"
}

## Drops self-referential files (e.g., this script) from the list
## passed in; needed for R-051/R-081/R-102 whose grep
## needles appear literally in this script's own doc comments
## and/or code lines.
## Emits the kept paths NUL-terminated (not newline), so a path containing
## a newline survives the round trip; callers read with 'mapfile -d ""'.
## A newline-delimited re-emit here would undo run_file_checks's NUL-safe
## read and silently split/drop such a path from the self-filtered checks.
filter_self() {
   local f
   for f in "${@}"; do
      is_self_referential "${f}" && continue
      printf '%s\0' "${f}"
   done
}

check_R031_bare_newline() {
   local hits
   local -a fs

   mapfile -d '' -t fs < <(filter_self "${@}")
   if [ "${#fs[@]}" -eq 0 ]; then return 0; fi
   ## Bad pattern: a printf that emits a newline without passing the
   ## data as an explicit argument -- 'printf \n' (newline baked into
   ## the format string, R-031) or a bare 'printf %s\n' with the data
   ## argument omitted (R-030). Both must be written 'printf %s\n' "".
   ## The compliant '' data-arg form ('printf %s\n' "") is deliberately
   ## NOT matched here -- it is the correct newline spelling:
   ## the trailing group requires end-of-line or an immediately
   ## following redirect/pipe/';'/'&', or a '#' (trailing comment), so
   ## 'printf %s\n' "" (which has a following data arg) never trips it while
   ## a commented bare form ('printf %s\n' # x) still does. Covers single-
   ## and double-quoted format strings and repeated '\n'.
   ## '(^|[^-[:alnum:]])' guards the needle: find(1)'s '-printf' action
   ## ('find ... -printf '\n'' prints one newline per match, e.g. for
   ## counting with 'wc --lines') is a find flag, not the printf command,
   ## and must not be flagged.
   hits="$(grep --with-filename --line-number --extended-regexp \
      "(^|[^-[:alnum:]])printf[[:space:]]+['\"](%s)?(\\\\n)+['\"][[:space:]]*(\$|[|;&>#])" \
      -- "${fs[@]}" 2>/dev/null || true)"
   emit_hits "R-030/R-031 newline printf needs explicit \"\" arg" "${hits}"
}

r030_printf_is_command() {
   ## True when a 'printf' appears at quote depth zero, i.e. as a command rather
   ## than inside a quoted string that merely mentions it.
   local text="$1" index char quote=""

   for (( index=0; index<${#text}; index++ )); do
      char="${text:index:1}"
      ## Inside DOUBLE quotes a backslash escapes the next character, so '\"'
      ## does not close the string. Without this the tracker thought the string
      ## ended early and reported a quoted mention as a command -- exactly the
      ## false positive it exists to prevent.
      if [ "${quote}" = '"' ] && [ "${char}" = "\\" ]; then
         index=$(( index + 1 ))
         continue
      fi
      if [ -n "${quote}" ]; then
         if [ "${char}" = "${quote}" ]; then
            quote=""
         fi
         continue
      fi
      ## At quote depth zero a backslash escapes the next character, so an
      ## unquoted '\"' is a LITERAL quote, not a string opener. Skipping it keeps
      ## the tracker from entering a phantom string and missing a real command.
      if [ "${char}" = "\\" ]; then
         index=$(( index + 1 ))
         continue
      fi
      case "${char}" in
         "'"|'"')
            quote="${char}"
            continue
            ;;
      esac
      if [ "${text:index:6}" = "printf" ]; then
         return 0
      fi
   done
   return 1
}

r030_offset_is_command() {
   ## True when the character at TARGET index in TEXT sits at quote depth zero,
   ## i.e. a 'printf' token there is a command, not one nested inside a quoted
   ## argument (a canary payload / log line that merely spells 'printf'). Same
   ## quote + double-quote-backslash walk as r030_printf_is_command, stopped at
   ## TARGET. Without this the format-extraction loop re-scanned a printf inside
   ## an OUTER printf's double-quoted data argument and flagged the inner
   ## format -- a false positive on 'printf %s\n "... printf ... |cmd"'.
   local text="$1" target="$2" index char quote=""

   for (( index=0; index<target && index<${#text}; index++ )); do
      char="${text:index:1}"
      if [ "${quote}" = '"' ] && [ "${char}" = "\\" ]; then
         index=$(( index + 1 ))
         continue
      fi
      if [ -n "${quote}" ]; then
         if [ "${char}" = "${quote}" ]; then
            quote=""
         fi
         continue
      fi
      ## Unquoted backslash escapes the next character (a literal quote, not an
      ## opener); skip it so the state does not flip on '\"'.
      if [ "${char}" = "\\" ]; then
         index=$(( index + 1 ))
         continue
      fi
      case "${char}" in
         "'"|'"')
            quote="${char}"
            ;;
      esac
   done
   [ -z "${quote}" ]
}

line_code_length() {
   ## Echo the index of the first quote-depth-zero, unquoted '#' in TEXT (the start
   ## of an inline comment), or the full length if none. A rule scanning for a
   ## command must ignore text after it -- a 'printf'/'python3 --' spelled in a
   ## trailing comment is documentation, not code. Honours ' " ` and '$(...)' and
   ## an unquoted backslash escape.
   local text="$1" index char quote='' depth=0 prev
   local length="${#text}"

   for (( index=0; index<length; index++ )); do
      char="${text:index:1}"
      if [ -n "${quote}" ]; then
         if [ "${quote}" = '"' ] && [ "${char}" = "\\" ]; then
            index=$(( index + 1 )); continue
         fi
         if [ "${char}" = "${quote}" ]; then quote=''; fi
         continue
      fi
      if [ "${char}" = "\\" ]; then
         index=$(( index + 1 ))
         continue
      fi
      case "${char}" in
         "'"|'"')
            quote="${char}"
            continue
            ;;
         '`')
            continue
            ;;
      esac
      if [ "${char}" = '$' ] && [ "${text:index+1:1}" = '(' ]; then
         depth=$(( depth + 1 ))
         index=$(( index + 1 ))
         continue
      fi
      if [ "${char}" = ')' ] && [ "${depth}" -gt 0 ]; then
         depth=$(( depth - 1 ))
         continue
      fi
      if [ "${char}" = '#' ] && [ "${depth}" -eq 0 ]; then
         ## A '#' begins a comment ONLY at a word boundary -- start of line, or after
         ## whitespace or a command separator. A '#' inside a word (a substring-removal
         ## parameter expansion '${var#prefix}', or a literal 'foo#bar') is NOT a comment,
         ## so truncating there would mask any real command later on the line.
         prev=''
         [ "${index}" -gt 0 ] && prev="${text:index-1:1}"
         case "${prev}" in
            ''|[[:space:]]|';'|'|'|'&'|'('|'`')
               printf '%s\n' "${index}"
               return 0
               ;;
         esac
      fi
   done
   printf '%s\n' "${length}"
}


check_R030_format_string() {
   local hits script line_number line remainder format_literal format_inner
   local printf_command printf_redirects printf_scan
   local match pre grp1 printf_abs consumed code code_length
   local -a fs

   mapfile -d '' -t fs < <(filter_self "${@}")
   if [ "${#fs[@]}" -eq 0 ]; then return 0; fi
   ## R-030: the format string is FIXED -- all data goes in the data argument.
   ##
   ## WHY beyond tidiness: a format string carrying data INTERPRETS it. A value
   ## containing a percent sign consumes the next argument or prints garbage, and
   ## a DOUBLE-quoted format interpolates the variable straight into the format,
   ## which is the injection R-030 exists to prevent.
   ##
   ## Scans each printf OCCURRENCE, not each line, and both quote styles. A
   ## line-oriented invert-match got this wrong twice: it missed
   ## 'printf "text $var\n"' entirely (single-quote-only pattern), and on
   ## 'printf "bad %s" "$a" ; printf "%s\n" "$b"' the compliant second call made
   ## the whole line pass. Both verified as live misses before this rewrite.
   ##
   ## Allowed: %s, %q (shell-escaping, named by R-030) and %b (decoding octal
   ## escapes, e.g. /proc/mounts), each with or without a trailing newline, plus
   ## '%s\0' for NUL-delimited output that 'mapfile -d ""' consumes -- there is
   ## no %s\n spelling of that.
   ##
   ## Numeric-PROBE carve-out: a printf with a SINGLE-quoted literal format
   ## whose own command discards BOTH stdout and stderr emits nothing, so
   ## neither of R-030's failure modes is reachable -- there is no output to
   ## garble, and a single-quoted format interpolates nothing. Such a printf is
   ## a validator, not output: 'printf %d "$1" >/dev/null 2>&1 || return 1' is
   ## helper-scripts' is_integer(), the guard bash-style-guide R-141 mandates
   ## before an untrusted value reaches an arithmetic context or an array
   ## index. Its FAILURE is the check, so rewriting the format to '%s' would
   ## silently turn a security guard into a no-op that always succeeds. Same
   ## spirit as the unconditional '%q' allowance: a format verb with a
   ## genuine use the plain rule did not anticipate.
   ## Scoped to THIS printf -- the tail is cut at the first ';', '|' or '&&' --
   ## so a second, unredirected printf on the same line is still judged alone.
   ## Waiver: '## style-ok: printf-format', anchored, per file.
   hits=""
   for script in "${fs[@]}"; do
      if grep --quiet --extended-regexp \
         '^[[:space:]]*##[[:space:]]*style-ok:[[:space:]]*printf-format([[:space:]]|$)' \
         -- "${script}" 2>/dev/null; then
         continue
      fi
      line_number=0
      in_quoted_program='false'
      while IFS= read -r line; do
         line_number=$(( line_number + 1 ))
         ## Comments are prose; a comment describing this rule must not trip it.
         ## Strip the indent, then test for a LEADING '#'. The glob
         ## '[[:space:]]*#*' reads as "one whitespace char, then anything,
         ## then '#', then anything", so it exempted any indented line
         ## containing a '#' ANYWHERE -- a printf whose format holds a '#'
         ## banner was silently waived while the identical line without one
         ## was flagged. A gate that quietly exempts real violations is worse
         ## than no gate, because the green is trusted.
         trimmed="${line#"${line%%[![:space:]]*}"}"
         case "${trimmed}" in
            '#'*)
               continue
               ;;
         esac
         ## A printf inside a single-quoted program handed to ANOTHER
         ## interpreter is not shell printf, and R-030's failure modes do not
         ## exist there: awk's printf takes a comma-separated argument list and
         ## interpolates nothing from the shell. Flagging it demanded a rewrite
         ## that would have broken the awk program.
         ##
         ## Tracked ACROSS lines, because such a program opens its quote on one
         ## line and closes it on a later one -- 'awk -v x="${y}" \' then
         ## ''BEGIN { printf "%.2f", a / b }'' on the next. The single-line
         ## quote check below cannot see that, and read each body line as shell.
         ##
         ## Double-quoted spans are removed before counting so an apostrophe
         ## inside one ("it's") cannot toggle the state. A genuinely unbalanced
         ## quote is a shell syntax error that shellcheck reports separately, so
         ## a corrupted state here cannot hide a violation in valid code.
         quote_scan="${line}"
         while [[ "${quote_scan}" =~ \"[^\"]*\" ]]; do
            quote_scan="${quote_scan//"${BASH_REMATCH[0]}"/}"
         done
         single_quotes="${quote_scan//[!\']/}"
         if [ "${in_quoted_program}" = 'true' ]; then
            if [ $(( ${#single_quotes} % 2 )) -eq 1 ]; then
               in_quoted_program='false'
            fi
            continue
         fi
         if [ $(( ${#single_quotes} % 2 )) -eq 1 ]; then
            ## Opening line: the quote starts here, so anything BEFORE it on
            ## this line is still shell and is scanned normally below.
            in_quoted_program='true'
         fi
         ## Skip a printf that appears INSIDE a quoted string -- a log line
         ## QUOTING the command rather than running it. 1200_prepare-build-machine
         ## does exactly that and was a false positive. A plain quote-strip will
         ## not do: the format string's own quotes are part of the command, so
         ## the scan tracks quote state and keeps only a printf at depth zero.
         if ! r030_printf_is_command "${line}"; then
            continue
         fi
         ## Scan only the executable prefix: a printf spelled in a trailing '#'
         ## comment is documentation, not a call, and must not be flagged.
         code_length="$(line_code_length "${line}")"
         code="${line:0:code_length}"
         remainder="${code}"
         consumed=0
         while [[ "${remainder}" =~ (^|[^-[:alnum:]_])printf[[:space:]]+(\'[^\']*\'|\"[^\"]*\") ]]; do
            match="${BASH_REMATCH[0]}"
            grp1="${BASH_REMATCH[1]}"
            pre="${remainder%%"${match}"*}"
            ## Absolute index of the 'printf' token in the ORIGINAL line: chars
            ## already consumed + text before the match + the leading boundary
            ## char (group 1 is empty at line start, one char otherwise).
            printf_abs=$(( consumed + ${#pre} + ${#grp1} ))
            format_literal="${BASH_REMATCH[2]}"
            format_inner="${format_literal:1:${#format_literal}-2}"
            remainder="${remainder#*"${match}"}"
            consumed=$(( consumed + ${#pre} + ${#match} ))
            ## Only a printf at quote depth zero is a command; one nested inside
            ## a quoted argument (a canary payload) is data, not a call.
            if ! r030_offset_is_command "${code}" "${printf_abs}"; then
               continue
            fi
            ## Numeric-probe carve-out (see the block comment above). Only a
            ## single-quoted format qualifies, so nothing can be interpolated
            ## into it. Whitespace is squeezed out before matching so
            ## '> /dev/null 2>&1' reads the same as '>/dev/null 2>&1'.
            ## '2>&1 >/dev/null' is deliberately NOT accepted: it sends stderr
            ## to the ORIGINAL stdout, so that command does still emit.
            if [ "${format_literal:0:1}" = "'" ]; then
               printf_command="${remainder%%[;|]*}"
               printf_command="${printf_command%%&&*}"
               ## The discard must belong to the printf COMMAND. Text that
               ## cannot carry one for the printf itself is removed first:
               ## a redirect inside an argument's command substitution
               ## silences the SUBSTITUTED command while printf still writes
               ## to stdout, and one inside quotes is literal text. Without
               ## this, 'printf %d "$(probe >/dev/null 2>&1)"' was exempted
               ## even though it prints. Each pass strictly shortens the
               ## string, so the loops terminate.
               printf_scan="${printf_command}"
               while [[ "${printf_scan}" =~ \'[^\']*\' ]]; do
                  printf_scan="${printf_scan//"${BASH_REMATCH[0]}"/}"
               done
               while [[ "${printf_scan}" =~ \"[^\"]*\" ]]; do
                  printf_scan="${printf_scan//"${BASH_REMATCH[0]}"/}"
               done
               while [[ "${printf_scan}" =~ \$\([^()]*\) ]]; do
                  printf_scan="${printf_scan//"${BASH_REMATCH[0]}"/}"
               done
               while [[ "${printf_scan}" =~ \`[^\`]*\` ]]; do
                  printf_scan="${printf_scan//"${BASH_REMATCH[0]}"/}"
               done
               printf_redirects="${printf_scan//[[:space:]]/}"
               case "${printf_redirects}" in
                  *'>/dev/null2>&1'*|*'&>/dev/null'*|*'>/dev/null2>/dev/null'*)
                     continue
                     ;;
               esac
            fi
            case "${format_inner}" in
               '%s'|'%s\n'|'%s\0'|'%q'|'%q\n'|'%b'|'%b\n'|'0x%x'|'%x')
                  ;;
               *)
                  hits="${hits}${script}:${line_number}:${line}"$'\n'
                  ;;
            esac
         done
      done < "${script}"
   done
   hits="${hits%$'\n'}"
   emit_hits "R-030 printf format string must be fixed ('%s' / '%s\\n')" "${hits}"
}

check_R051_trap_inline() {
   local hits allow_regexp
   local -a fs

   mapfile -d '' -t fs < <(filter_self "${@}")
   if [ "${#fs[@]}" -eq 0 ]; then return 0; fi
   ## Bad pattern: trap followed by a single- OR double-quoted inline
   ## command string ('trap "rm -f ${t}" EXIT' as well as the single-quoted
   ## form). Named-function form is 'trap NAME SIG' (no quote). The
   ## '[^'\"]' after the opening quote requires a non-quote character
   ## inside, so 'trap "" EXIT' / 'trap '' EXIT' (clear/ignore a trap, not
   ## an inline command) are not flagged. The leading '^[^#]*' excludes a
   ## trap that sits in a '#' comment (e.g. a commented-out '#trap "sleep 1"
   ## DEBUG' debug line) -- that is documentation, not a live trap -- mirroring
   ## how R-070/R-074 skip comment lines.
   hits="$(grep --with-filename --line-number --extended-regexp "^[^#]*\\btrap[[:space:]]+['\"][^'\"]" -- "${fs[@]}" 2>/dev/null || true)"
   ## Spare the PARAMETERIZED named-function form: bash passes a trap
   ## handler no information about the firing signal, so
   ## 'trap "handler $signal" "$signal"' is the standard idiom for
   ## signal-aware dispatch to a named function -- the rule targets inline
   ## command LOGIC, not arguments. Spared iff the quoted string is exactly
   ## one function/variable name followed by VARIABLE-EXPANSION arguments
   ## only ('$signal', '${kind}'): literal arguments keep e.g.
   ## 'trap "rm -f ${t}" EXIT' (the rule's canonical bad case) flagged.
   ## PCRE with \x27 escapes for the quotes keeps the expression
   ## shell-quoting-safe; \1 backreference matches the closing quote to
   ## the opening one.
   ## The handler itself may be a VARIABLE too ('trap "${handler} ${signal}"',
   ## the dispatch-table form), and R-020 requires it braced, so accept
   ## '${name}' as well as '$name'/'name' in the leading position -- otherwise
   ## the two rules contradict each other and the R-020-correct spelling is
   ## the only one flagged. Non-capturing groups keep '\1' bound to the quote.
   allow_regexp='\btrap[[:space:]]+([\x27"])(?:[$][{][A-Za-z_][A-Za-z0-9_]*[}]|[$]?[A-Za-z_][A-Za-z0-9_]*)(?:[[:space:]]+[$][{]?[A-Za-z_][A-Za-z0-9_]*[}]?)*\1'
   if [ -n "${hits}" ]; then
      hits="$(printf '%s\n' "${hits}" | grep --invert-match --perl-regexp -- "${allow_regexp}" || true)"
   fi
   emit_hits "R-051 trap inline command" "${hits}"
}

check_R070_double_semi() {
   local hits

   ## R-070: ';;' must be on its own line (optional indent + ';;' only).
   ## Flag any ';;' at end-of-line with other non-whitespace before it --
   ## spaced ('bar ;;') OR jammed ('bar;;'). A compact one-line case arm is
   ## thus always caught; the arm must be written multi-line. Comments are
   ## stripped first, so an illustrative '#   ;;' in documentation is prose and
   ## does not match, while a '${#var}' earlier on a real arm no longer hides it.
   hits="$(grep_code_lines '[^[:space:]][[:space:]]*;;[[:space:]]*$' "${@}")"
   emit_hits "R-070 ';;' on own line" "${hits}"
}

check_R074_flow_chaining() {
   local hits
   local -a fs

   ## R-074 forbids gluing a next command onto a statement with ';'. The general
   ## form is too broad to grep without false positives, but the control-flow
   ## keywords break/continue/return are the low-false-positive subset: a ';'
   ## that FOLLOWS a statement (a non-whitespace char earlier on the line, allowing
   ## spaces before the ';' so 'foo ; break' is caught too) and is FOLLOWED by one
   ## of them is almost always the chaining R-074 forbids, never bash's syntactic
   ## ';' (';;', a C-style for-loop, or the keyword on its own line). The trailing
   ## group '([[:space:];&|]|$)' enforces a real word boundary after the keyword,
   ## so a mere prefix ('x=1; return_value=1', '; continue_calls') does NOT match;
   ## the leading '^[^#]*' excludes '#'-comment lines. filter_self keeps this
   ## script's own regex/examples from self-matching.
   ##
   ## 'exit' is deliberately NOT in the set. Unlike break/continue/return it
   ## is a frequent statement separator INSIDE inline awk/sed program strings
   ## (awk '{print; exit}'), which is not bash ';'-chaining and would be a
   ## false positive; and ';'-then-exit is common in the tolerated one-liner
   ## guard idiom '|| { printf ... >&2; exit 1; }' used by self-contained
   ## bootstrap scripts. So it is not the low-false-positive subset a
   ## single-grep Tier-1 rule needs.
   mapfile -d '' -t fs < <(filter_self "${@}")
   if [ "${#fs[@]}" -eq 0 ]; then return 0; fi
   hits="$(grep_code_lines \
      '[^[:space:]][[:space:]]*;[[:space:]]*(break|continue|return)([[:space:];&|]|$)' "${fs[@]}")"
   emit_hits "R-074 ';'-chained break/continue/return" "${hits}"
}

check_R062_dashdash_denylist() {
   local hits entry regex
   local -a denylist

   ## R-062 negative half: a '--' end-of-options separator handed to a tool
   ## that does NOT accept one is a bug -- the tool reads '--' as a literal
   ## argument or errors. The positive half ('prefer --' where supported) is
   ## manual review (whether a positional follows and could begin with '-' is
   ## undecidable by grep); THIS half is a finite, verified denylist.
   ##
   ## Each entry MUST be verified against the real binary before adding.
   ## Verified rejecters:
   ##   git check-ref-format -- <ref>  -> exit 129 (usage error)
   ##   stcat -- <file>                -> FileNotFoundError on '--': it takes
   ##                                     every argument as a path. This one
   ##                                     cost four e2e scenarios in
   ##                                     tb-updater, via helper-scripts'
   ##                                     read_integer_file.
   ## Entries are extended-regexp fragments for the command token(s); '[space]+'
   ## between words so the literal never self-matches this denylist line.
   denylist=(
      'git[[:space:]]+check-ref-format'
      'stcat'
   )
   for entry in "${denylist[@]}"; do
      ## Command-position tool token(s), then a STANDALONE '--' in any arg
      ## position (a run of complete 'token whitespace' groups may precede it;
      ## '--' must be followed by whitespace or EOL, so '--flag' and a glued
      ## 'foo--' are not it, and a first-position '-- x' still matches).
      ## The intermediate tokens exclude ';', '|' and '&' so the scan cannot
      ## cross a command boundary: without that, any legitimate '--' later on
      ## the line ('git check-ref-format x; grep -- foo') was blamed on the
      ## denylisted tool that merely came first.
      regex="(^|[[:space:];&|(){}])${entry}[[:space:]]([^[:space:];|&]*[[:space:]])*--([[:space:]]|$)"
      hits="$(grep_code_lines "${regex}" "${@}")"
      emit_hits "R-062 '--' passed to a tool that rejects it" "${hits}"
   done
}

check_R026_empty_array_guard() {
   local hits
   local -a fs

   ## R-026: the obsolete empty-array guard '${arr[@]+"${arr[@]}"}'. It existed
   ## only to work around bash BEFORE 4.4, where expanding an empty array under
   ## 'set -o nounset' raised 'arr: unbound variable'. Bash 4.4+ needs no guard
   ## (arrays are '=()'-initialized per R-025), so the '+alternate' operator
   ## applied directly to '[@]' is dead weight -- drop it and expand
   ## '"${arr[@]}"' plainly.
   ##
   ## Flag only '${name[@]+' -- a '${', an identifier, then '[@]' followed
   ## IMMEDIATELY by '+'. The legitimate neighbours are all spared by that
   ## anchoring: '${#arr[@]}' (length; '[@]' is followed by '}'), a plain
   ## '${arr[@]}' (same), '${arr[@]:-fallback}' and '${arr[@]:+word}' (a ':'
   ## sits between '[@]' and the operator), and a bare '[@]+' in a string or
   ## regex (no leading '${name'). grep_code_lines strips comments first so an
   ## illustrative guard in prose is not flagged; filter_self drops this
   ## script, whose own regex/message text carries the needle.
   mapfile -d '' -t fs < <(filter_self "${@}")
   if [ "${#fs[@]}" -eq 0 ]; then return 0; fi
   hits="$(grep_code_lines '\$\{[A-Za-z_][A-Za-z0-9_]*\[@\]\+' "${fs[@]}")"
   emit_hits "R-026 obsolete empty-array guard (bash 4.4+; drop the +alternate on [@])" "${hits}"
}

check_R021_local_assign() {
   local hits
   local -a fs

   ## R-021: declare locals at the top of the function, blank line, then the
   ## assignments. A combined 'local name=value' hides what state a function
   ## has behind its first use, and its command-substitution form (R-022)
   ## additionally swallows the exit status -- 'local' returns 0 even when the
   ## substitution failed, so errexit cannot fire.
   ##
   ## Flag 'local' followed by ONE identifier and an '='. Deliberately spared:
   ##   * a bare declaration list, 'local a b c' (no '='), which is the shape
   ##     the rule asks for;
   ##   * an explicitly typed declaration whose initialiser IS the declaration,
   ##     'local -a arr=()' / 'local -i n=0' -- the attribute must be set at
   ##     declaration time, so splitting it would change meaning;
   ##   * 'declare' / 'typeset', which are not function-local by default.
   mapfile -d '' -t fs < <(filter_self "${@}")
   if [ "${#fs[@]}" -eq 0 ]; then return 0; fi
   ##
   ## ADVISORY, not a failure -- deliberately, and measurably: 203 existing
   ## sites across 80 files carry this shape today. The gate greps whole
   ## CHANGED FILES, so failing would block a one-line edit to any of them on
   ## debt the editor did not create, in every session at once. Promote it by
   ## swapping this note for emit_hits once the debt is cleared.
   ## Any operand may carry the '=', not just the first: 'local first
   ## second="$(cmd)"' combines declaration and assignment on the SECOND name
   ## and masks the substitution's exit status exactly as the one-name form
   ## does. Leading bare names are consumed before the assigned one.
   hits="$(grep_code_lines '^[[:space:]]*local[[:space:]]+([A-Za-z_][A-Za-z0-9_]*[[:space:]]+)*[A-Za-z_][A-Za-z0-9_]*=' "${fs[@]}")"
   if [ -z "${hits}" ]; then return 0; fi
   note "R-021 local declared with an assignment (ADVISORY -- declare, blank line, then assign):"
   printf '%s\n' "${hits}"
}


check_R081_source_devnull() {
   local hits
   local -a fs

   mapfile -d '' -t fs < <(filter_self "${@}")
   if [ "${#fs[@]}" -eq 0 ]; then return 0; fi
   hits="$(grep --with-filename --line-number 'shellcheck source=/dev/null' -- "${fs[@]}" 2>/dev/null || true)"
   emit_hits "R-081 source=/dev/null" "${hits}"
}

## R-085: flag a '# shellcheck disable=SC1091' ONLY when it is paired with an
## adjacent '# shellcheck source=' directive (the canonical two-line directive
## stack above the source). That pairing is what the reusable-pre-push-static
## gate makes redundant: it checks out helper-scripts as the repo sibling when
## the consumer sets 'dist-ai-tests: helper-scripts: true', so 'shellcheck -x'
## FOLLOWS the source= directive instead of emitting SC1091 -- the per-line
## disable is then dead code; drop it and set the flag (see the 'shellcheck'
## skill). A disable with NO adjacent source= directive governs a source
## shellcheck can never follow -- a runtime-generated temp file
## ('source "${work_dir}/fn.bash"'), a venv activate, '/dev/stdin' -- so the
## disable is load-bearing and dropping it reintroduces SC1091; NOT flagged.
## ADVISORY while the tree is converted repo-by-repo, flips to a hard fail once
## every consumer is converted. Escape: '## style-ok: allow-sc1091-disable'.
check_R085_sc1091_disable() {
   local script hits i n
   local -a fs lines

   mapfile -d '' -t fs < <(filter_self "${@}")
   if [ "${#fs[@]}" -eq 0 ]; then return 0; fi
   for script in "${fs[@]}"; do
      [ -r "${script}" ] || continue
      if grep --quiet --extended-regexp \
         '^[[:space:]]*##[[:space:]]*style-ok:[[:space:]]*allow-sc1091-disable([[:space:]]|$)' \
         -- "${script}"; then
         continue
      fi
      mapfile -t lines < "${script}"
      hits=''
      n="${#lines[@]}"
      for (( i = 0; i < n; i++ )); do
         ## SC1091 as a token in the disable list: alone, or comma-joined with
         ## other codes on either side. Trailing '1' (e.g. SC10911) is not a match.
         if [[ ! "${lines[i]}" =~ ^[[:space:]]*#[[:space:]]*shellcheck[[:space:]]+disable=([A-Z0-9]+,)*SC1091([,[:space:]]|$) ]]; then
            continue
         fi
         ## Dead only when a '# shellcheck source=' directive sits on an adjacent
         ## line -- that is what 'shellcheck -x' follows under the sibling
         ## checkout. No adjacent source= -> nothing to follow -> load-bearing.
         if { [ "${i}" -gt 0 ] \
               && [[ "${lines[i - 1]}" =~ ^[[:space:]]*#[[:space:]]*shellcheck[[:space:]]+source= ]]; } \
            || { [ "$(( i + 1 ))" -lt "${n}" ] \
               && [[ "${lines[i + 1]}" =~ ^[[:space:]]*#[[:space:]]*shellcheck[[:space:]]+source= ]]; }; then
            hits+="${script}:$(( i + 1 )):${lines[i]}"$'\n'
         fi
      done
      if [ -n "${hits}" ]; then
         note "R-085 '# shellcheck disable=SC1091' is dead once the CI sibling checkout follows the source; drop it and set 'dist-ai-tests: helper-scripts: true' (see the shellcheck skill) (ADVISORY):"
         printf '%s' "${hits}"
      fi
   done
}

## R-002: the Copyright header leads the file. A '## style-ok:' waiver must not
## sit ABOVE the '## Copyright' line; waivers belong under the header, not before
## it. Only fires when both lines exist, so a file without either is unaffected.
check_R002_header_first() {
   local script style_hit copy_hit style_line copy_line

   for script in "${@}"; do
      is_self_referential "${script}" && continue
      ## '--text' so a stray NUL byte cannot turn grep's output into
      ## 'Binary file ... matches' and feed a non-numeric value to the arithmetic
      ## compare below. Both patterns anchor to a real header COMMENT line ('##'
      ## at line start) so a '## Copyright' mentioned inside a string or an echo
      ## does not count as the header.
      style_hit="$(grep --text --line-number --max-count=1 --extended-regexp '^[[:space:]]*##[[:space:]]*style-ok:' -- "${script}")" || true
      [ -n "${style_hit}" ] || continue
      copy_hit="$(grep --text --line-number --max-count=1 --extended-regexp '^[[:space:]]*##[[:space:]]+Copyright' -- "${script}")" || true
      [ -n "${copy_hit}" ] || continue
      style_line="${style_hit%%:*}"
      copy_line="${copy_hit%%:*}"
      if [ "${style_line}" -lt "${copy_line}" ]; then
         fail "R-002 header" "'${script}': '## style-ok' at line ${style_line} precedes '## Copyright' at line ${copy_line}; move the waiver below the header"
      fi
   done
}

check_R170_tmp_hardcode() {
   local script hits line

   for script in "${@}"; do
      ## This script carries '/tmp' in its own regex and message text.
      is_self_referential "${script}" && continue
      ## Script-wide waiver: '## style-ok: no-tmp-hardcode' anywhere in the
      ## file disables R-170 for that file. For the cases where /tmp is not a
      ## redirectable temp path at all: the X11 socket dir (/tmp/.X11-unix is
      ## fixed by the protocol), namespace construction (bwrap --tmpfs /tmp,
      ## whose private tmpfs has no per-user subdir), and administering the
      ## /tmp mount itself. Anchored regex, mirroring the R-120 waiver.
      if grep --quiet --extended-regexp \
         '^[[:space:]]*##[[:space:]]*style-ok:[[:space:]]*no-tmp-hardcode([[:space:]]|$)' \
         -- "${script}"; then
         continue
      fi
      ## '/tmp' as an absolute path: NOT preceded by a path/word character (so
      ## 'debian/tmp', './tmp' and '/var/tmp' are not matched) and NOT followed
      ## by one (so '/tmpfs' and '/tmp.bak' are not). A following '/' is a real
      ## path. '}', ')' and '~' are in the leading class too: a '/tmp' right
      ## after one of them is rooted in an expansion or in HOME
      ## ('${build_dir}/tmp', '$(pwd)/tmp', '~/tmp'), so it is a subdirectory
      ## named tmp, never the absolute system path. '-' is deliberately NOT in
      ## the class: it is the character before '/tmp' in the '${TMPDIR:-/tmp}'
      ## inline-fallback idiom, which is the form this rule mainly retires.
      ## The leading '^[^#]*' excludes '#'-comment lines, as R-070/R-074 do --
      ## prose about /tmp is not a hardcode.
      ##
      ## The invert spares the temp-dir variable INITIALISATIONS, the one place
      ## the literal has to appear: 'TMP=/tmp' and friends (optionally export/
      ## readonly/local/declare-prefixed, which covers the canonical
      ## '[ -v TMP ] || TMP=/tmp'), plus the bwrap '--setenv TMPDIR /tmp' form.
      ## ':' leads the allowed-prefix class because grep --line-number has
      ## already prefixed '<n>:' by the time the invert sees the line, so a
      ## start-of-line 'TMP=/tmp' is no longer at '^'.
      ## The init may be QUOTED ('TMP="/tmp"', "export TMPDIR='/tmp'"), so an
      ## optional quote is allowed on each side of the literal.
      ## Whole-line, so a line carrying BOTH an init and a real hardcode is
      ## spared -- a narrow accepted residual, as in R-120.
      hits="$(grep --line-number --extended-regexp \
         '^[^#]*(^|[^A-Za-z0-9._/}~)])/tmp($|[^A-Za-z0-9._-])' \
         -- "${script}" 2>/dev/null \
         | grep --invert-match --extended-regexp \
           "(^|[[:space:];&|(:])(export|readonly|local|declare)?[[:space:]]*(TMP|TMPDIR|TEMP|TEMPDIR)=['\"]?/tmp['\"]?([[:space:];&|)]|\$)|--setenv[[:space:]]+(TMP|TMPDIR|TEMP|TEMPDIR)[[:space:]]+['\"]?/tmp['\"]?([[:space:];&|)]|\$)" \
         || true)"
      if [ -z "${hits}" ]; then
         continue
      fi
      while IFS= read -r line; do
         fail "R-170 hardcoded /tmp (use \${TMP})" "'${script}:${line}'"
      done <<< "${hits}"
   done
}


is_installed_python_module() {
   local candidate
   candidate="${1}"

   ## A Python file inside an installed package directory is imported, never
   ## run: the package's entry points live in usr/bin and import it. Marking
   ## such a file executable is wrong (lintian objects, and Debian ships these
   ## 0644), so the shebang-and-executable rules do not apply to it.
   ## Anchored to a real Python library path. A bare '*/dist-packages/*.py'
   ## would exempt any script that merely happens to sit in a directory of
   ## that name, such as 'usr/bin/dist-packages/tool.py'.
   case "${candidate}" in
      */lib/python3*/dist-packages/*.py|*/lib/python3*/site-packages/*.py)
         return 0
         ;;
   esac
   return 1
}

check_R180_python_shebang() {
   local script hits first

   ## R-180: a Python file carries a shebang AND is executable, so it can be
   ## run directly when debugging. The two halves are enforced from opposite
   ## sides: check-shebang-scripts-are-executable already fails a shebang
   ## without '+x', and check-executables-have-shebangs fails '+x' without a
   ## shebang -- but a file with NEITHER slips past both, which is the gap
   ## this closes.
   ##
   ## An EMPTY file is exempt: a zero-byte '__init__.py' is a package marker,
   ## not code, and has nothing to interpret.
   for script in "${@}"; do
      if [ ! -s "${script}" ]; then
         continue
      fi
      if is_installed_python_module "${script}"; then
         continue
      fi
      first=""
      read -r first < "${script}" || true
      first="${first%$'\r'}"
      case "${first}" in
         '#!'*)
            continue
            ;;
      esac
      hits="${script}:1:${first}"
      fail "R-180 python file needs a shebang (and +x)" "'${hits}'"
   done
}


check_R102_interpreter_prepend() {
   local hits
   local -a fs

   ## Run on shell + yml/yaml files; .md is excluded by caller (the
   ## style guide itself self-cites the bad pattern as an example).
   ## Self-filter strips this script (whose docs cite the pattern).
   ##
   ## Two regexes:
   ##   1. 'bash foo.sh' / 'sh foo.bsh' / etc - explicit extension.
   ##   2. 'bash foo' / 'sh foo' where the operand is a PATH: it starts with
   ##      a path character (not '-', so a flag is skipped; not '$'/'"', so a
   ##      variable is skipped) and CONTAINS a '/'. Requiring a slash is what
   ##      separates a real extensionless invocation ('bash ci/dry-run-start',
   ##      'bash ./build', 'bash /usr/bin/x') from English prose ('a bash
   ##      script', 'foo.sh as a subprocess') which has no slash. The previous
   ##      regex 2 required a literal leading '.', so a bare 'bash ci/foo'
   ##      slipped; a slash-anywhere test catches it without matching prose.
   ##
   ## The interpreter word must sit at line start or after a genuine command
   ## separator/space -- NOT a plain '\b' word boundary. '\b' also matches
   ## after '-' and '.', so a short flag ending in sh ('du -sh /path') and a
   ## script run AS the command with a path argument ('wrapper.sh /etc/x')
   ## both false-positived as an 'sh' prepend. The explicit prefix class
   ## keeps every real form: line start, 'cd x && bash y', '$(bash y)',
   ## 'true; bash y', 'timeout 5 bash y'.
   mapfile -d '' -t fs < <(filter_self "${@}")
   if [ "${#fs[@]}" -eq 0 ]; then return 0; fi
   hits="$(grep --with-filename --line-number --extended-regexp \
      '(^|[[:space:]([;&|])(bash|sh)[[:space:]]+[^-[:space:]][^[:space:]]*\.(sh|bsh|bash)\b|(^|[[:space:]([;&|])(bash|sh)[[:space:]]+[^-$"[:space:]][A-Za-z0-9._-]*/[A-Za-z0-9._/-]*(\b|$)' \
      -- "${fs[@]}" 2>/dev/null \
      | grep --invert-match --extended-regexp \
         '\b(bash|sh)[[:space:]]+-[ceilnsxv]+(\b|[[:space:]])' \
      || true)"
   emit_hits "R-102 interpreter prepend (use shebang)" "${hits}"
}



check_R153_help_from_comments() {
   local script hits line
   local -a fs

   ## R-153: never build help/usage by scraping the running script's OWN comments
   ## (e.g. `grep '^##' -- "$0" | sed ...`). Help is a function that PRINTS strings
   ## you own; comment-scraping breaks on any comment-only edit and couples the
   ## help wording to comment syntax. Flags a NON-comment line that reads $0 or
   ## ${BASH_SOURCE} together with a '^#'/'^##' anchor -- the comment-scrape
   ## signature. A plain 'dirname "${BASH_SOURCE[0]}"' or 'head "$0"' has no '^#'
   ## anchor and is not matched. filter_self drops this checker, whose own regex
   ## literals carry both tokens.
   mapfile -d '' -t fs < <(filter_self "${@}")
   if [ "${#fs[@]}" -eq 0 ]; then return 0; fi
   for script in "${fs[@]}"; do
      ## Two orders: the '^#' anchor before the self-reference ('grep '^##' "$0"')
      ## or after it. The trailing '| grep -v' drops pure-comment lines (content
      ## starting with '#'), so a comment that merely NAMES the anti-pattern is
      ## spared.
      hits="$(grep --line-number --extended-regexp \
         --regexp='\^##?.*(\$0|\$\{?BASH_SOURCE)' \
         --regexp='(\$0|\$\{?BASH_SOURCE).*\^##?' \
         -- "${script}" 2>/dev/null \
         | grep --invert-match --extended-regexp '^[0-9]+:[[:space:]]*#' || true)"
      if [ -z "${hits}" ]; then
         continue
      fi
      while IFS= read -r line; do
         fail "R-153 help scraped from comments" "'${script}:${line}'"
      done <<< "${hits}"
   done
}


check_R080_shellcheck_source_path() {
   local hits

   ## R-080: a 'shellcheck source=' path must be a RELATIVE source-tree path
   ## anchored with './' or '../', i.e. it must start with '.'. This flags an
   ## absolute path ('source=/usr/...', and /dev/null), AND a bare relative
   ## name ('source=get_colors.sh' instead of './get_colors.sh') -- shellcheck
   ## resolves the bare form the same, but it breaks the codebase convention
   ## that anchors a same-directory sibling as './<file>'.
   hits="$(grep --with-filename --line-number --extended-regexp \
      '^[[:space:]]*#[[:space:]]*shellcheck[[:space:]]+source=[^.]' \
      -- "${@}" 2>/dev/null || true)"
   emit_hits "R-080 shellcheck source= must be relative (start with ./ or ../)" "${hits}"
}

is_python_file() {
   case "${1}" in
      *.py)
         return 0
         ;;
   esac
   return 1
}

is_yaml_file() {
   case "${1}" in
      *.yml|*.yaml)
         return 0
         ;;
   esac
   return 1
}

## File-based exception allowlist. A path DECLARED binary in .gitattributes is a
## data blob -- a raw payload, a fixture, a captured byte stream -- not code or
## prose, so the text-content rules (R-001 ASCII, trailing whitespace, line
## endings, and the end-of-file / BOM / trailing-whitespace fixers) do not apply
## to it, exactly as they already do not to a PNG. Opt a file out by adding a
## '<path> binary' line to .gitattributes; the allowlist lives in the repo, next
## to the file, and is reviewable in the diff. This mirrors the Unicode commit
## gate and the server-side check, which already skip git-binary files -- so a
## deliberately-classified data file is now treated the same by every gate.
## '<path>: binary: set' is git's answer for a file the macro-attribute covers;
## the suffix match tolerates a ':' in the path itself. '--cached' reads the attribute
## from the INDEX, not the working tree, so the opt-out only counts when the
## '.gitattributes' entry is itself part of the change being committed -- an unstaged or
## untracked '.gitattributes' cannot silently exempt a file that ships without it, and the
## allowlist stays reviewable in the diff.
is_data_file() {
   local out
   out="$(git check-attr --cached binary -- "${1}" 2>/dev/null)" || return 1
   case "${out}" in
      *': binary: set')
         return 0
         ;;
   esac
   return 1
}

is_text_file() {
   ## Cheap extension match first; fall back to file --mime for
   ## files lacking a known extension (e.g. shell scripts named
   ## 'foo' with a shebang).
   local f mime
   f="${1}"
   ## A file the repo declares binary in .gitattributes is data, never text,
   ## whatever its extension -- so every text-content check that filters on
   ## is_text_file (trailing whitespace, the pre-commit-hooks text fixers) skips it.
   if is_data_file "${f}"; then
      return 1
   fi
   case "${f}" in
      *.md|*.sh|*.bsh|*.bash|*.py|*.yml|*.yaml|*.json|*.toml \
      |*.xml|*.txt|*.csv|*.cfg|*.conf|*.ini|*.rst|*.html|*.css \
      |*.js|*.ts|*.c|*.h|*.cpp|*.hpp|*.go|*.rs|*.tex|*.dockerfile \
      |Dockerfile|Makefile|COPYING|README|LICENSE)
         return 0
         ;;
   esac
   if ! command -v file >/dev/null 2>&1; then
      return 1
   fi
   mime="$(file --brief --mime --dereference -- "${f}" 2>/dev/null || true)"
   case "${mime}" in
      text/* \
      |*x-shellscript* \
      |*x-python* \
      |*json* \
      |*xml* \
      |*yaml* \
      |*toml* \
      |*charset=us-ascii* \
      |*charset=utf-8*)
         return 0
         ;;
   esac
   return 1
}

## --- pre-commit-hooks integration (direct binary execution, no framework) ---
##
## Runs the curated upstream pre-commit-hooks binary set against
## the right file-type subsets, modeled on each hook's upstream
## 'types:' declaration. Probes for one representative
## (check-yaml); if absent, the whole set is skipped silently
## (developer machines without pre-commit-hooks installed still
## get the bash-style-guide gate).
##
## Hooks NOT run vs misc/pre-commit-config.yaml (with reasons):
##   no-commit-to-branch     pre-commit-stage hook; the gate
##                           runs at push (or in CI on PR/push),
##                           past the point this would matter.
##   unicode-merged-ref      stages: [pre-merge-commit, manual] only.
##   name-tests-test         dmf has no Python tests/ dir using
##                           the enforced naming convention.
##   file-contents-sorter    files: '^$' in the config (opt-in).
##   sort-simple-yaml        same.
##   fix-encoding-pragma     deprecated upstream.

run_precommit_hook() {
   local hook
   local -a flags files

   hook="${1}"
   shift
   ## Split the remaining args at '--' into leading hook flags and the
   ## trailing FILE list. Untrusted filenames MUST go after '--' so a path
   ## named like an option ('--fix=lf', '--maxkb=99999999') is a positional
   ## argument, not a flag the argparse-based hook honors (R-062). Without
   ## this a changed file could flip a fixer into rewrite mode or neuter a
   ## checker. Callers always pass '<hook> [flags...] -- <files...>'.
   flags=()
   while [ "$#" -ge 1 ] && [ "${1}" != "--" ]; do
      flags+=("${1}")
      shift
   done
   if [ "${1:-}" = "--" ]; then
      shift
   fi
   files=("${@}")
   if [ "${#files[@]}" -eq 0 ]; then
      return 0
   fi
   "${hook}" "${flags[@]}" -- "${files[@]}" \
      || fail "${hook}" "exited non-zero (hook output printed above)"
}

## Fixer hooks (end-of-file-fixer, trailing-whitespace-fixer, ...) REWRITE
## files in place. Run each against throwaway COPIES so the working tree
## (default mode) and the detached --per-commit checkout are never mutated:
## an in-place fix would silently edit the user's tree, and in --per-commit
## mode it dirties the checkout so the next 'git checkout <sha>' aborts and
## leaves a wedged detached HEAD. The non-zero exit (the hook's "would
## modify" signal) still fails the gate. Only pure file-content fixers use
## this; the git-aware hooks (check-added-large-files, ...) must see the
## real repo and stay on run_precommit_hook.
run_precommit_fixer() {
   local hook rc mirror f dir

   hook="${1}"
   shift
   if [ "$#" -eq 0 ]; then
      return 0
   fi
   mirror=""
   mirror="$(mktemp --directory)" || true
   if [ -z "${mirror}" ] || [ ! -d "${mirror}" ]; then
      fail "${hook}" "mktemp failed; cannot sandbox the fixer run"
      return 0
   fi
   for f in "${@}"; do
      dir="$(dirname -- "${f}")"
      mkdir --parents -- "${mirror}/${dir}"
      cp --no-dereference --preserve=mode -- "${f}" "${mirror}/${f}"
   done
   rc=0
   ## '--' so a filename that looks like a flag stays a positional arg (R-062).
   ( cd -- "${mirror}" && "${hook}" -- "${@}" ) || rc=$?
   ## Plain 'rm' on our own mktemp dir: this bootstrap script cannot depend
   ## on safe-rm (same deviation as the command -v use), and R-120 skips it.
   rm --recursive --force -- "${mirror}"
   if [ "${rc}" -ne 0 ]; then
      fail "${hook}" "would modify file(s) -- run '${hook}' locally and commit the result"
   fi
}

check_precommit_hooks() {
   if ! command -v check-yaml >/dev/null 2>&1; then
      note "pre-commit-hooks not on PATH; skipping (apt-get install pre-commit-hooks)"
      return 0
   fi

   local f
   local -a text_files exec_text_files symlink_files \
            yaml_files json_files json_fmt_files toml_files xml_files \
            python_files req_files

   text_files=()
   exec_text_files=()
   symlink_files=()
   yaml_files=()
   json_files=()
   json_fmt_files=()
   toml_files=()
   xml_files=()
   python_files=()
   req_files=()

   for f in "${@}"; do
      if [ ! -e "${f}" ]; then
         continue
      fi
      if [ -L "${f}" ]; then
         symlink_files+=("${f}")
         continue
      fi
      ## A submodule gitlink is a DIRECTORY here: no content to scan, and every
      ## content hook below errors on it. forbid-new-submodules takes the RAW
      ## list, so dropping it here does not blind that check.
      if [ ! -f "${f}" ]; then
         continue
      fi
      if is_text_file "${f}"; then
         text_files+=("${f}")
         if [ -x "${f}" ] && [ -f "${f}" ]; then
            exec_text_files+=("${f}")
         fi
      fi
      case "${f}" in
         *.yml|*.yaml)
            yaml_files+=("${f}")
            ;;
         *.json)
            json_files+=("${f}")
            ;;
         *.toml)
            toml_files+=("${f}")
            ;;
         *.xml)
            xml_files+=("${f}")
            ;;
         *.py)
            python_files+=("${f}")
            ;;
      esac
      case "${f}" in
         requirements*.txt|constraints*.txt \
         |*/requirements*.txt|*/constraints*.txt)
            req_files+=("${f}")
            ;;
      esac
   done

   ## filename-blind:
   ## '--enforce-all' so check-added-large-files inspects the files we pass
   ## instead of intersecting with 'git diff --staged' (empty at push time,
   ## which left it dead in default/union/per-commit mode).
   ##
   ## Restrict it to files this changeset ADDS, which is what the hook is named for.
   ## With '--enforce-all' over every changed file, a large file that has been tracked for
   ## years fails the gate on every commit that so much as appends to it -- observed on
   ## derivative-maker's 3.6 MB 'changelog.upstream', which blocked an otherwise-clean
   ## merge and cannot be "fixed" without rewriting project history. A file already present
   ## in the base ref was reviewed when it was added; only a NEW one is the hook's business.
   local -a added_files
   added_files=()
   for f in "${@}"; do
      ## A path ADDED and then DELETED within the same range is still a changed
      ## file, and is absent from the base ref, so it lands here -- but there is
      ## nothing on disk to stat and the hook dies with FileNotFoundError,
      ## failing the gate on a changeset that is perfectly fine. Observed after
      ## reverting a merge whose only effect had been to add a file. The typed
      ## lists below already guard this; the added-file list must too.
      if [ ! -e "${f}" ]; then
         continue
      fi
      if [ -n "${base_ref:-}" ] && git cat-file -e "${base_ref}:${f}" 2> /dev/null ; then
         continue
      fi
      added_files+=("${f}")
   done
   if [ "${#added_files[@]}" -gt 0 ]; then
      run_precommit_hook check-added-large-files --enforce-all -- "${added_files[@]}"
   fi
   run_precommit_hook check-case-conflict     -- "${@}"
   run_precommit_hook destroyed-symlinks      -- "${@}"
   ## forbid-new-submodules diffs '--staged' unless PRE_COMMIT_FROM_REF /
   ## PRE_COMMIT_TO_REF are set. In push mode nothing is staged, so without
   ## these it diffs an empty range and passes unconditionally -- a check that
   ## looks alive and inspects nothing. Exported around the call only, so the
   ## range does not leak into the other hooks.
   if [ -n "${base_ref:-}" ] && [ "${staged_mode}" -eq 0 ]; then
      export PRE_COMMIT_FROM_REF="${base_ref}"
      export PRE_COMMIT_TO_REF='HEAD'
   fi
   run_precommit_hook forbid-new-submodules   -- "${@}"
   unset PRE_COMMIT_FROM_REF PRE_COMMIT_TO_REF

   ## text-only:
   run_precommit_hook check-merge-conflict    -- "${text_files[@]}"
   run_precommit_hook check-vcs-permalinks    -- "${text_files[@]}"
   run_precommit_hook detect-aws-credentials --allow-missing-credentials -- "${text_files[@]}"
   run_precommit_hook detect-private-key      -- "${text_files[@]}"
   run_precommit_fixer fix-byte-order-marker     "${text_files[@]}"
   run_precommit_fixer end-of-file-fixer         "${text_files[@]}"
   run_precommit_fixer trailing-whitespace-fixer "${text_files[@]}"
   run_precommit_hook mixed-line-ending --fix=no -- "${text_files[@]}"
   ## A SOURCED fragment legitimately carries a shebang (shellcheck dialect
   ## detection, editor highlighting) and legitimately is not executable: running it
   ## standalone fails on helpers its sourcing context defines. Per-file waiver
   ## '## style-ok: sourced-fragment', anchored like the others.
   shebang_check_files=()
   for shebang_candidate in "${text_files[@]}"; do
      if grep --quiet --extended-regexp \
         '^[[:space:]]*##[[:space:]]*style-ok:[[:space:]]*sourced-fragment([[:space:]]|$)' \
         -- "${shebang_candidate}"; then
         note "check-shebang-scripts-are-executable skipped: 'style-ok: sourced-fragment' waiver in '${shebang_candidate}'"
         continue
      fi
      ## An imported module keeps its shebang for editors and for a direct
      ## 'python3 path/to/module.py' run, and stays non-executable because
      ## that is how Debian ships a package's modules. See R-180.
      if is_installed_python_module "${shebang_candidate}"; then
         note "check-shebang-scripts-are-executable skipped: '${shebang_candidate}' is an imported package module"
         continue
      fi
      shebang_check_files+=("${shebang_candidate}")
   done
   if [ "${#shebang_check_files[@]}" -gt 0 ]; then
      run_precommit_hook check-shebang-scripts-are-executable -- "${shebang_check_files[@]}"
   fi

   ## text AND executable:
   run_precommit_hook check-executables-have-shebangs -- "${exec_text_files[@]}"

   ## symlinks:
   run_precommit_hook check-symlinks -- "${symlink_files[@]}"

   ## type by extension:
   run_precommit_hook check-yaml             -- "${yaml_files[@]}"
   run_precommit_hook check-json             -- "${json_files[@]}"
   run_precommit_hook check-toml             -- "${toml_files[@]}"
   run_precommit_hook check-xml              -- "${xml_files[@]}"
   run_precommit_hook check-ast              -- "${python_files[@]}"
   run_precommit_hook check-builtin-literals -- "${python_files[@]}"
   run_precommit_hook debug-statement-hook   -- "${python_files[@]}"
   ## double-quote-string-fixer (pre-commit-hooks) is intentionally NOT run. It rewrites Python
   ## string literals to SINGLE quotes -- the exact opposite of black's DOUBLE-quote
   ## normalisation -- so on any repo that also runs black the two revert each other in a loop
   ## the gate can never satisfy (pre-commit/pre-commit-hooks#889:
   ## https://github.com/pre-commit/pre-commit-hooks/issues/889). Python quote style is left to
   ## each repo's own formatter rather than enforced here.
   ## pretty-format-json REWRITES (and by default key-SORTS) a JSON file. An
   ## app-MANAGED settings file -- Claude Code's claude/settings.json and
   ## settings.local.json -- is rewritten by the app itself, unsorted and
   ## human-grouped, on every settings change, so enforcing a sorted/reformatted
   ## shape here is both futile (the app re-writes it) and destructive (it flattens
   ## the app's grouping into alphabetical order). check-json above still validates
   ## its SYNTAX; only the formatter is skipped for it.
   ## Anchor 'claude'/'.claude' as a FULL path component (top-level or '/'-preceded), so
   ## 'myclaude/settings.json' does not match. Both spellings are covered: the repo that
   ## deploys ~/.claude/settings.json checks it in under a plain 'claude/' directory, while a
   ## live tree carries the hidden '.claude/'.
   for f in "${json_files[@]}"; do
      case "${f}" in
         claude/settings.json|.claude/settings.json \
         |*/claude/settings.json|*/.claude/settings.json \
         |claude/settings.local.json|.claude/settings.local.json \
         |*/claude/settings.local.json|*/.claude/settings.local.json)
            note "pretty-format-json skipped: '${f}' is an app-managed settings file (syntax still checked by check-json; the app owns its format)"
            continue
            ;;
         *)
            json_fmt_files+=("${f}")
            ;;
      esac
   done
   run_precommit_fixer pretty-format-json        "${json_fmt_files[@]}"
   run_precommit_fixer requirements-txt-fixer    "${req_files[@]}"
}

## Warn (do not fail) when a checked path's working-tree content differs
## from what the current mode actually records, so a "passed" result is not
## mistaken for a check of the exact bytes. 'ref' is the diff target: empty
## for STAGED mode (working tree vs the index), 'HEAD' for UNION/push mode
## (working tree vs the pushed commit). 'hint' is the mode-specific advice.
## Both modes would otherwise pass silently on content the check never saw.
warn_worktree_skew() {
   local mode ref hint file rc

   mode="${1}"
   ref="${2}"
   hint="${3}"
   shift 3
   for file in "${@}"; do
      rc=0
      if [ -n "${ref}" ]; then
         git diff --quiet "${ref}" -- "${file}" 2>/dev/null || rc=$?
      else
         git diff --quiet -- "${file}" 2>/dev/null || rc=$?
      fi
      if [ "${rc}" -ne 0 ]; then
         note "${mode}: '${file}' ${hint}"
      fi
   done
}

## R-151 comment auditor -- ADVISORY ONLY, never fails the gate. Surfaces
## comment-paraphrases-code candidates in the changed files for human review
## (the heuristic produces false positives, so it cannot be a pass/fail check).
## comments-audit ships beside this gate (dist-ai usr/bin) or installed on PATH.
check_comments_audit() {
   local auditor cand out
   auditor=""
   for cand in \
      "$( dirname -- "$( readlink --canonicalize -- "$0" )" )/comments-audit" \
      '/usr/bin/comments-audit'; do
      if [ -x "${cand}" ]; then
         auditor="${cand}"
         break
      fi
   done
   if [ -z "${auditor}" ]; then
      note "comments-audit not found; skipping the R-151 comment advisory"
      return 0
   fi
   out="$( "${auditor}" --files "$@" 2>/dev/null || true )"
   if [ -n "${out}" ] && ! grep --quiet -- '0 candidate findings' <<< "${out}"; then
      note "R-151 comment-audit candidates (ADVISORY -- review, not a gate failure):"
      printf '%s\n' "${out}" >&2
   fi
   return 0
}

## Parser-backed shell-structure rules (command position, quote/heredoc state),
## run via pre-push-detect over the shfmt AST -- exact where a regex could only
## approximate (a command inside a string / heredoc / array, a 'sudo'-wrapped
## invocation). Findings are rendered through this gate's own fail()/note(), so
## the output and every per-rule test are unchanged. pre-push-detect ships beside
## this gate (dist-ai usr/bin) or installed on PATH.
##
## A MISSING detector, or shfmt absent (exit 2), is a REQUIRED-tool FAILURE, not
## a skip: silently dropping these rules would be a false green. Same discipline
## as R-090's own no-unauthorized-skip rule.
run_ast_detector() {
   local detector cand output severity message location rc

   detector=""
   for cand in \
      "$( dirname -- "$( readlink --canonicalize -- "$0" )" )/dist-ai-style" \
      '/usr/bin/dist-ai-style'; do
      if [ -x "${cand}" ]; then
         detector="${cand}"
         break
      fi
   done
   if [ -z "${detector}" ]; then
      fail "dist-ai-style not found; parser-backed shell rules could not run" "(required tool)"
      return 0
   fi
   rc=0
   output="$( "${detector}" --detect "$@" )" || rc=$?
   if [ "${rc}" -eq 2 ]; then
      fail "dist-ai-style --detect could not run" "shfmt is required and absent"
      return 0
   fi
   ## Exit 0 = clean, 1 = findings (with output). ANYTHING ELSE is a crash where
   ## no parser-backed rule ran -- a false green if read as "no findings" -- so it
   ## is a hard FAILURE. A rc-1 with EMPTY output is the same anomaly (a crash that
   ## exited 1); the findings path always carries output.
   if [ "${rc}" -gt 2 ] || { [ "${rc}" -eq 1 ] && [ -z "${output}" ]; }; then
      fail "dist-ai-style --detect crashed (exit ${rc}); parser-backed rules did NOT run -- not a pass" "(traceback on stderr)"
      return 0
   fi
   if [ -z "${output}" ]; then
      return 0
   fi
   while IFS=$'\x1f' read -r severity message location; do
      case "${severity}" in
         FAIL)
            fail "${message}" "${location}"
            ;;
         NOTE)
            note "${message}"
            ;;
      esac
   done <<< "${output}"
}

warn_untracked_shell_files() {
   ## A brand-new script is invisible to 'git diff', so it contributes no
   ## changed file and every check silently skips it -- while the gate still
   ## prints "all static checks passed". Read as "my new tool passed", that is
   ## a false green: the gate never opened the file.
   ##
   ## Advisory, not a failure: an untracked file is genuinely not part of what
   ## is being pushed, and scratch files are normal. Naming them is what stops
   ## the misread.
   local line
   local -a untracked_shell

   untracked_shell=()
   while IFS= read -r -d '' line; do
      if [ -z "${line}" ]; then
         continue
      fi
      if is_shell_file "${line}"; then
         untracked_shell+=("${line}")
      fi
   done < <(git -c core.quotePath=false ls-files --others --exclude-standard -z)

   if [ "${#untracked_shell[@]}" -eq 0 ]; then
      return 0
   fi
   note "${#untracked_shell[@]} untracked shell file(s) NOT checked (git add them to gate their content):"
   for line in "${untracked_shell[@]}"; do
      note "  ${line}"
   done
}

run_file_checks() {
   ## Run all file-content checks given the current global
   ## base_ref. Caller controls base_ref (single union pass in
   ## default mode; per-commit loop in --per-commit mode).
   local line
   local -a shell_files yaml_files shell_or_yaml file_list python_source_files

   python_source_files=()
   shell_files=()
   yaml_files=()
   shell_or_yaml=()
   file_list=()
   while IFS= read -r -d '' line; do
      if [ -z "${line}" ]; then
         continue
      fi
      file_list+=("${line}")
      if is_python_file "${line}"; then
         python_source_files+=("${line}")
      fi
      if is_shell_file "${line}"; then
         shell_files+=("${line}")
         shell_or_yaml+=("${line}")
      elif is_yaml_file "${line}"; then
         yaml_files+=("${line}")
         shell_or_yaml+=("${line}")
      fi
   done < <(list_changed_files)

   if [ "${#shell_files[@]}" -gt 0 ]; then
      check_bash_n "${shell_files[@]}"
      check_shellcheck "${shell_files[@]}"
      check_R002_header_first "${shell_files[@]}"
      check_R010_strict_block "${shell_files[@]}"
      check_R011_errexit_toggle "${shell_files[@]}"
      check_R013_set_options "${shell_files[@]}"
      check_R031_bare_newline "${shell_files[@]}"
      check_R030_format_string "${shell_files[@]}"
      check_R051_trap_inline "${shell_files[@]}"
      check_R070_double_semi "${shell_files[@]}"
      check_R074_flow_chaining "${shell_files[@]}"
      check_R062_dashdash_denylist "${shell_files[@]}"
      check_R026_empty_array_guard "${shell_files[@]}"
      check_R080_shellcheck_source_path "${shell_files[@]}"
      check_R021_local_assign "${shell_files[@]}"
      check_R081_source_devnull "${shell_files[@]}"
      check_R085_sc1091_disable "${shell_files[@]}"
      check_R170_tmp_hardcode "${shell_files[@]}"
      ## Parser-backed shell-structure rules on the shfmt AST: R-090, R-103,
      ## R-120, R-034, R-130, R-161, R-172, R-200, R-210, R-211, R-212, R-213.
      ## One AST pass replaces the former per-rule regex bodies (the _pkg_*
      ## command-position approximation, the defang-based scans, the R-213
      ## assignment regex, and the quote/heredoc fail-open residuals each of
      ## those documented).
      check_R153_help_from_comments "${shell_files[@]}"
   else
      note "no changed shell files"
   fi

   if [ "${#python_source_files[@]}" -gt 0 ]; then
      check_R180_python_shebang "${python_source_files[@]}"
   fi

   if [ "${#shell_or_yaml[@]}" -gt 0 ]; then
      check_R102_interpreter_prepend "${shell_or_yaml[@]}"
   fi

   if [ "${#file_list[@]}" -gt 0 ]; then
      if [ "${staged_mode}" -eq 1 ] && [ "${staged_all}" -eq 0 ]; then
         warn_worktree_skew "staged mode" "" \
            "has unstaged changes; checks ran against the working tree, not the staged blob (re-stage to verify the exact committed content)" \
            "${file_list[@]}"
      fi
      if [ "${staged_mode}" -eq 0 ] && [ "${per_commit_mode}" -eq 0 ] \
         && [ "${files_mode}" -eq 0 ]; then
         warn_worktree_skew "push mode" "HEAD" \
            "differs between the working tree and HEAD; checks ran against the working tree, not the pushed commit (use --per-commit to check commit content exactly)" \
            "${file_list[@]}"
      fi
      check_ascii_files "${file_list[@]}"
      ## Parser-backed rules over ALL changed files, in one AST pass: the shell
      ## command-position / quote-state rules on shell files, and the embedded-
      ## shell config rules (R-191 systemd, R-192 shell -c, R-194 apt, R-195 cron,
      ## R-100 workflow YAML) self-selecting by path. Replaces the former regex
      ## bodies and the defang-based config-value scans.
      run_ast_detector "${file_list[@]}"
      check_trailing_whitespace "${file_list[@]}"
      ## pre-commit hooks are git-commit-time checks (some inspect the index, not
      ## file content), so they do not apply to the disk-linting --files mode.
      if [ "${files_mode}" -eq 0 ]; then
         check_precommit_hooks "${file_list[@]}"
      fi
      check_comments_audit "${file_list[@]}"
   fi
}

restore_head_ref=""

restore_head() {
   if [ -n "${restore_head_ref}" ]; then
      git checkout --quiet "${restore_head_ref}" 2>/dev/null || true
   fi
}

main() {
   local sha saved_base_ref toplevel
   local -a matched_paths

   ## Resolve everything from the repo root. list_changed_files yields
   ## repo-root-relative paths, but every content check reads them relative
   ## to the CWD. Invoked from a subdirectory (or by a hook whose CWD is not
   ## the root, e.g. the Claude commit-gate) each path would be missing and
   ## every check would silently pass. cd to the top level so the path list
   ## and the on-disk reads agree.
   ## --files mode lints paths on disk with no git diff, so it needs neither a
   ## repository nor a base ref, and must NOT cd to a repo root (the paths are
   ## relative to the invocation directory).
   if [ "${files_mode}" -eq 0 ]; then
      toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || true
      if [ -z "${toplevel}" ]; then
         note "not inside a git repository; cannot run"
         exit 2
      fi
      cd -- "${toplevel}"

      if [ "${staged_mode}" -eq 0 ]; then
         resolve_base
      fi
   fi

   ## A pathspec that matches nothing checks nothing, and a verdict of "all
   ## checks passed" over zero files is the silent-green shape this gate
   ## exists to prevent. It is not an error -- a deletion-only commit matches
   ## no ACMRT path -- so SAY it rather than fail.
   if [ "${paths_mode}" -eq 1 ]; then
      matched_paths=()
      mapfile -d '' -t matched_paths < <(list_changed_files)
      if [ "${#matched_paths[@]}" -eq 0 ]; then
         note "--paths matched no added/modified file; nothing was content-checked (a deletion-only commit looks like this)"
      fi
   fi

   ## Commit-message R-001 check covers the whole base..HEAD range
   ## once; per-commit iteration would re-check the same messages
   ## N times. The changelog check is likewise a commit-range scan
   ## (inspects each commit's diff + message) and runs once here.
   ## Commit-message and changelog checks are commit-range scans; --files mode
   ## has no commit range, so they are skipped there.
   if [ "${files_mode}" -eq 0 ]; then
      check_ascii_commit_msg
      if [ "${staged_mode}" -eq 1 ]; then
         check_changelog_no_manual_staged
      else
         check_changelog_no_manual
      fi
   fi

   if [ "${per_commit_mode}" -eq 1 ]; then
      ## Detached-checkout iteration. Capture the current ref so
      ## the trap can restore the working tree even on failure.
      restore_head_ref="$(git symbolic-ref --quiet --short HEAD \
         || git rev-parse HEAD)"
      trap restore_head EXIT
      saved_base_ref="${base_ref}"
      while IFS= read -r sha; do
         if [ -z "${sha}" ]; then
            continue
         fi
         note "per-commit: ${sha}"
         git checkout --quiet "${sha}"
         base_ref="${sha}^"
         run_file_checks
      done < <(git rev-list --reverse "${saved_base_ref}..HEAD")
      base_ref="${saved_base_ref}"
   else
      run_file_checks
   fi

   ## Once, after the checks and in every mode: the point is to qualify the
   ## verdict that is about to be printed, not to annotate each commit.
   ## --files mode is not git-scoped, so untracked-file reporting does not apply.
   if [ "${files_mode}" -eq 0 ]; then
      warn_untracked_shell_files
   fi

   if [ "${fail_count}" -gt 0 ]; then
      note "${fail_count} check(s) failed"
      exit 1
   fi
   note "all static checks passed"
}

main "${@}"
