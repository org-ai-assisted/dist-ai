#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Bounded smoke-fuzz of kloak's libFuzzer harnesses. Drives kloak's OWN
## ci/cfuzz-build.sh (no reimplementation) to build every fuzz/fuzz_*.c harness
## with clang + libFuzzer + ASAN/UBSAN -- kloak's own, PLUS the dist-ai-owned
## harnesses under usr/share/kloak-tests/ staged into the build tree's fuzz/
## (so a harness can be maintained here instead of vendored in the submodule).
## Each is then run for a short burst, failing on any crash. The full
## coverage-guided campaign is kloak's ClusterFuzzLite lane; this is the fast
## regression smoke.
##
## Subject resolved from KLOAK_REPO (its src/ + protocol/ + fuzz/ + ci/); unset
## -> no subject -> SKIP. Build happens in a throwaway copy so KLOAK_REPO (which
## may be the shared canonical checkout) is never dirtied by generated protocol
## code or fuzzer binaries.
##
## Needs clang, libclang-rt (libFuzzer/ASAN runtimes), wayland-scanner,
## pkg-config and the wayland/libinput/libevdev/xkbcommon dev headers -- declare
## them in kloak's dm-consumer.yml. Their absence is a FATAL environment bug.
##
## KLOAK_FUZZ_RUNS overrides the per-harness run count (default 20000).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

repo="${KLOAK_REPO:-}"
src_c="${repo}/src/kloak.c"
if [ -z "${repo}" ] || [ ! -f "${src_c}" ]; then
   printf '%s\n' "SKIP: kloak-tests-fuzz: kloak.c not found (set KLOAK_REPO)" >&2
   exit 77  ## style-ok: allow-skip: kloak source absent (not a --component run)
fi

for tool in clang wayland-scanner pkg-config; do
   if ! type -P "${tool}" >/dev/null; then
      printf '%s\n' "FATAL: ${tool} not found -- declare it in dm-consumer.yml apt-packages" >&2
      exit 1
   fi
done

runs="${KLOAK_FUZZ_RUNS:-20000}"

work="$(mktemp --directory)"
# shellcheck disable=SC2317  # reached only via the EXIT trap
cleanup() {
   safe-rm --recursive --force -- "${work}"
}
trap cleanup EXIT

## Throwaway kloak root: the build writes generated protocol code into src/ and
## binaries into out/, so copy (never build inside KLOAK_REPO).
for dir in src protocol fuzz ci; do
   cp -a -- "${repo}/${dir}" "${work}/${dir}"
done

## dist-ai-owned fuzz harnesses are maintained here, not vendored in the kloak
## submodule; stage them into the build tree's fuzz/ so kloak's cfuzz-build
## compiles them alongside kloak's own. The glob matches at least
## fuzz_parse_esc_key_str.c; a zero-match would fail loud under errexit.
if [ -d "${script_dir}/../share/kloak-tests" ]; then
   dist_ai_fuzz="${script_dir}/../share/kloak-tests"
else
   dist_ai_fuzz='/usr/share/kloak-tests'
fi
cp -a -- "${dist_ai_fuzz}"/fuzz_*.c "${work}/fuzz"/

out="${work}/out"
mkdir -p -- "${out}"
OUT="${out}" "${work}/ci/cfuzz-build.sh"

## LeakSanitizer needs ptrace, which the confined sandbox / CI container denies
## -- it fatal-errors at process exit and libFuzzer reads that as a crash (a
## false red). This lane is a build+run SMOKE (ASAN/UBSAN memory-safety + UB,
## crash-free); deep leak detection is kloak's full ClusterFuzzLite campaign,
## which runs in a privileged container. detect_leaks=0 goes LAST so it wins
## over any inherited ASAN_OPTIONS (LLVM parses the list left-to-right).
export ASAN_OPTIONS="${ASAN_OPTIONS:+${ASAN_OPTIONS}:}detect_leaks=0"

fail=0
pass=0
for binary in "${out}"/fuzz_*; do
   [ -x "${binary}" ] || continue
   name="$(basename -- "${binary}")"
   ## Capture output so a crash's sanitizer report + libFuzzer reproduction
   ## (the failing input) survive into the CI log, not just the binary name.
   log="${work}/${name}.log"
   if "${binary}" -runs="${runs}" -max_len=256 >"${log}" 2>&1; then
      printf '%s\n' "PASS: ${name} (${runs} runs, no crash)"
      pass=$(( pass + 1 ))
   else
      printf '%s\n' "FAIL: ${name} crashed during smoke-fuzz" >&2
      tail -n 60 -- "${log}" >&2
      fail=$(( fail + 1 ))
   fi
done

if [ "${pass}" -eq 0 ]; then
   printf '%s\n' "FAIL: no kloak fuzz harnesses were built" >&2
   exit 1
fi
printf '%s\n' "kloak-tests-fuzz: ${pass} pass, ${fail} fail, 0 skip"
[ "${fail}" -eq 0 ]
