#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Orchestrate an end-to-end image test of a published Kicksecure/Whonix release:
## resolve the version, pick the test account by bless-state, acquire + install
## (or import) the image, run the matching test, and publish the verdict to the
## results plane. The glue over iso-download / dm-calamares-install /
## dm-whonix-pair / the results publisher; manual-invoke (no scheduler).
##
## Account model (VBox state is per-$HOME, so the Linux user IS the isolation
## boundary):
##   - pre-bless candidate (resolved version != the wiki stable pin): a
##     disposable, version-named ephemeral account eph-run-<guest>-<version>,
##     created on demand and removed after (image-test-gc wipes eph-*; the host
##     nftables leak-drop covers eph-run-* by name).
##   - blessed (resolved == stable pin): the longitudinal golden account
##     persist-stable-<guest>; a non-blessed version is REFUSED there.
##   - leak lane (the Whonix pair + anon-leak-test battery): ALWAYS the dedicated,
##     persistent persist-leak-<guest>, never the shared persist-stable- or eph-run-
##     namespace -- a non-leak lane's dev-root/leaprun mutation of a shared account's
##     GW/WS would falsify the leak verdict. Pre-provisioned (pair imported once;
##     dm-whonix-pair restore_fresh gives a pristine pair each run), NEVER
##     host-sudo/leaprun-enabled, covered by the host nftables leak-drop. Not created
##     or gc'd here; a missing/privileged leak account fails SETUP, never a leak FAIL.
##
## Runs as root on the server (creates users, publishes to the web root); drops
## to the test account for every VM operation. Sourced by dm-release-test-tests
## to unit-test the pure-logic helpers.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"

## log / die / has / die_if_not_has (log_run_die.sh sources get_colors, strings
## and has.bsh itself).
# shellcheck disable=SC1091
if ! source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/log_run_die.sh 2>/dev/null; then
   printf '%s\n' "${me}: ERROR: cannot source helper-scripts log_run_die.sh (set HELPER_SCRIPTS_PATH)" >&2
   exit 3
fi

ISO_DOWNLOAD="${ISO_DOWNLOAD:-iso-download}"
DM_CALAMARES_INSTALL="${DM_CALAMARES_INSTALL:-dm-calamares-install}"
DM_WHONIX_PAIR="${DM_WHONIX_PAIR:-dm-whonix-pair}"
IMAGE_TEST_GC="${IMAGE_TEST_GC:-image-test-gc}"
VBOXMANAGE="${VBOXMANAGE:-VBoxManage}"
DIST_INSTALLER_CLI="${DIST_INSTALLER_CLI:-dist-installer-cli}"
## dist-installer-cli REFUSES to run as root; it must be invoked by a non-root,
## passwordless-sudo-capable user (it sudo's internally for apt/modprobe and run_as_target_user
## to the install account). dm-release-test runs as root, so rt_provision_leak drops to this
## invoker. Default matches the VBOX_INSTALL_USER convention on the derivative hosts.
DIST_INSTALLER_USER="${DIST_INSTALLER_USER:-${VBOX_INSTALL_USER:-user}}"
## Forward the AI-session identity ACROSS the sudo drop into a leaf VM tool, so dm-vm-lock
## (re-exec'd inside the leaf) records WHICH session holds the VM-work lock and another
## session can investigate a suspicious holder. sudo strips inherited env; running `env` as
## the sudo'd command re-sets it regardless of sudoers env policy. Empty outside a session
## -> dm-vm-lock falls back to 'none'.
rt_session_env=(env
   "CLAUDE_RC_SESSION_NAME=${CLAUDE_RC_SESSION_NAME:-}"
   "CLAUDE_CODE_SESSION_ID=${CLAUDE_CODE_SESSION_ID:-}")
## VBox extradata key pinning the imported leak pair's version. Set on BOTH VMs at
## provision time (rt_provision_leak) and read back by rt_lane_whonix, which REFUSES to
## attribute a verdict to a version the pair was not provisioned with.
PAIR_VERSION_KEY="${PAIR_VERSION_KEY:-leaktest/pair-version}"
## Best-effort host-firewall fleet-set refresh so a freshly-created eph account's
## leak-probe egress is dropped; the tool is a private-ai-config server script,
## not on PATH by default -- warn (do not fail) when absent.
NFT_FLEET_TOOL="${NFT_FLEET_TOOL:-provision-server-nftables.sh}"
## MAX seconds to wait for a killed VBoxSVC to reap before userdel (cleanup polls
## each second and stops as soon as the account's processes are gone). Test seam.
## Coerce a non-integer override back to the default so the poll's `[ -ge ]` cannot
## error (and spin) on a bad value.
EPH_CLEANUP_SETTLE="${EPH_CLEANUP_SETTLE:-20}"
case "${EPH_CLEANUP_SETTLE}" in
   ''|*[!0-9]*)
      EPH_CLEANUP_SETTLE=20
      ;;
esac
## Base dir for VBoxXPCOMIPCD's per-user IPC socket dir (.vbox-<user>-ipc). VBox
## puts it at /tmp/.vbox-<user>-ipc for the sudo'd eph account: sudo env_reset with
## no PAM session strips TMPDIR, so VBox falls back to /tmp (confirmed on the host).
## This is VBox's fixed socket location, not a redirectable temp path of ours; the
## unit test overrides it via the env var.
## style-ok: no-tmp-hardcode -- VBox's fixed per-user IPC socket dir for the sudo'd account
VBOX_IPC_BASE="${VBOX_IPC_BASE:-/tmp}"

ISO_DIR="${DM_RELEASE_TEST_ISO_DIR:-/var/lib/image-tests/iso}"
CERT_PATH="${DM_RELEASE_TEST_CERT:-/usr/share/keyrings/derivative.asc}"
RESULTS_ROOT="${IMAGE_TEST_RESULTS_ROOT:-/var/www/results}"
RESULTS_OWNER="${IMAGE_TEST_RESULTS_OWNER:-www-data}"
## A lane sets this to a FAILED release check's output file; rt_publish_result
## publishes it as the step's stderr tail, then resets it. Empty = nothing to add.
rt_check_log=""

SETUP_RC=2

guest=""
interface=""
desktop=""
channel="developers"
version_override=""
firmware="efi-secureboot"
run_checks='false'
dry_run='false'
provision_leak='false'
## --iso PATH: test a LOCALLY-BUILT ISO instead of downloading a published release.
## Empty = the normal download path; set = built-origin lane (no iso-download).
local_iso=""
## origin recorded in the result.json: downloaded (official release) or built (--iso).
rt_origin="downloaded"

## Trap state: the ephemeral account to remove on exit (set once created), so an
## abort between creation and the normal cleanup never leaks it. Empty => nothing.
eph_account=""

## fd holding the shared-account lock (rt_lock_account); held until this process exits.
rt_lock_fd=""

script_dir="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")"
if [ -d "${script_dir}/../libexec/image-test" ]; then
   image_test_libexec="${script_dir}/../libexec/image-test"
else
   image_test_libexec='/usr/libexec/image-test'
fi
# shellcheck source=../libexec/image-test/results-publish.bsh
source "${image_test_libexec}/results-publish.bsh"

die() {
   local code
   code="$1"
   shift
   printf '%s: ERROR: %s\n' "${me}" "$*" >&2
   exit "${code}"
}

print_usage() {
   printf '%s\n' "Usage:
  ${me} GUEST INTERFACE [--channel stable|developers] [--version VER]
        [--firmware bios|efi|efi-secureboot] [--iso PATH] [--checks] [--dry-run]
        [--provision-leak]

  GUEST      kicksecure | whonix
  INTERFACE  lxqt | xfce | cli (the published desktop flavor)
  --iso PATH test a LOCALLY-BUILT ISO (kicksecure only): skip iso-download, install
             PATH, record origin=built. Version LABEL is derived from the filename
             (override with --version); the run uses a disposable eph-run-GUEST-built
             account.

A pre-bless candidate installs under a disposable eph-run-GUEST-VERSION
account; a blessed release (version == stable pin) uses persist-stable-GUEST.
The whonix leak lane ALWAYS uses the dedicated persistent persist-leak-GUEST account.
--dry-run prints the resolved plan and runs nothing.
--provision-leak (whonix only) is the one-time setup of the leak pair: create the clean
persist-leak-GUEST account, import the GW+WS pair under it, and pin the version marker
each run then verifies; it prints the remaining one-time dev-root bake + snapshot step."
}

## ---------------------------------------------------------------------------
## pure logic (unit-tested by dm-release-test-tests; no VM, no network, no root)
## ---------------------------------------------------------------------------

## True for a supported guest.
rt_guest_valid() {
   case "$1" in
      kicksecure|whonix)
         return 0
         ;;
   esac
   return 1
}

## Map a lowercase interface to the published desktop token used in the image
## filename. Unknown -> fail (a wrong token silently 404s the download).
rt_desktop_token() {
   case "$1" in
      lxqt)
         printf '%s\n' "LXQt"
         ;;
      xfce)
         printf '%s\n' "Xfce"
         ;;
      cli)
         printf '%s\n' "CLI"
         ;;
      *)
         return 1
         ;;
   esac
}

## Map a dotted version to a Linux-username-safe token: dots (and any char
## outside [a-z0-9-]) become '-'. Rejects a version that is not [0-9.].
rt_version_token() {
   local version token
   version="$1"
   case "${version}" in
      ''|*[!0-9.]*)
         return 1
         ;;
   esac
   token="${version//./-}"
   ## Bound the token: it becomes a results-path component (and, for eph-run-, part of
   ## the account name). The leak/blessed lanes skip the account-name ceiling, so cap it
   ## here -- a garbage/overlong --version fails SETUP loudly, never a suppressed publish.
   [ "${#token}" -le 32 ] || return 1
   printf '%s\n' "${token}"
}

## Derive a build-version LABEL from a built ISO's filename
## (Kicksecure-<Desktop>-<version>.<arch>.iso). The git-describe <version>
## (e.g. 18.2.3.0-222-g<sha>) is NOT a release token (dashes + sha), so it never
## flows through rt_version_token / the eph account name -- a built run uses a FIXED
## eph-run-<guest>-built account; this label is only the results-matrix cell + --version.
rt_build_version_from_iso() {
   local base v
   base="${1##*/}"
   ## Match the exact built-ISO shape Kicksecure-<Desktop>-<version>.<arch>.iso with a
   ## KNOWN arch suffix and strip prefix+suffix in the arm -- never a blind last-dot strip
   ## (which would corrupt a dotted version with no arch component, 18.2.3.0 -> 18.2.3).
   ## Fail closed on any other shape (-> the caller requires --version).
   case "${base}" in
      Kicksecure-*-*.Intel_AMD64.iso)
         v="${base%.Intel_AMD64.iso}"
         v="${v#*-*-}"
         ;;
      Kicksecure-*-*.ARM64.iso)
         v="${base%.ARM64.iso}"
         v="${v#*-*-}"
         ;;
      *)
         return 1
         ;;
   esac
   [ -n "${v}" ] || return 1
   printf '%s\n' "${v}"
}

## Validate a built-ISO version label is a safe results-path component: no path
## separators / traversal, a bounded git-describe-ish charset.
rt_build_version_ok() {
   local v="$1"
   ## A leading '-' would be read as an option by the emitter's argparse (--version <v>
   ## exits 2 -> no result.json -> a false NO-DATA); '.'/'..' resolve to a directory, not
   ## a distinct results cell. Reject both, plus separators / traversal / bad charset.
   case "${v}" in
      '' | '.' | '..' | -* | */* | *..* | *[!A-Za-z0-9.+_-]*)
         return 1
         ;;
   esac
   [ "${#v}" -le 64 ] || return 1
   return 0
}

## Compose + validate the ephemeral install account name. Keeping the eph-run- prefix
## is load-bearing: image-test-gc only wipes eph-*, and the host nftables leak-drop
## resolves the fleet by persist-stable-*|eph-run-*|persist-leak-* name pattern.
## useradd's NAME_REGEX is ^[a-zA-Z][a-zA-Z0-9_-]*$ (no dots) with a 32-char ceiling.
rt_eph_account() {
   local guest_name token account
   guest_name="$1"
   token="$2"
   account="eph-run-${guest_name}-${token}"
   case "${account}" in
      [a-z]*)
         true
         ;;
      *)
         return 1
         ;;
   esac
   case "${account}" in
      *[!a-z0-9-]*)
         return 1
         ;;
   esac
   [ "${#account}" -le 32 ] || return 1
   printf '%s\n' "${account}"
}

## True when GUEST runs the leak lane (the Whonix GW/WS pair + anon-leak-test); the
## leak lane ALWAYS uses the dedicated persist-leak- account, regardless of bless-state.
rt_lane_is_leak() {
   [ "$1" = 'whonix' ]
}

## True only for a leak-namespace account name. Guards the invariant that the leak
## lane is never handed a shared persist-stable-/eph-run- account.
rt_account_is_leak() {
   case "$1" in
      persist-leak-*)
         return 0
         ;;
   esac
   return 1
}

## Pure host-privilege gate (unit-tested): a test account must not be uid 0, its PRIMARY
## group must be its own private group (name == account), and every group it holds must
## be that private group or vboxusers. Requiring a PRIVATE primary (not a shared users/
## vboxusers) keeps the account's files off a group other fleet accounts share -- a
## shared primary breaks per-account isolation. The allowlist is keyed on the account
## name, NOT blind-trusting the primary, so a privileged group (root/sudo/docker/disk)
## anywhere is rejected. $1=account $2=uid $3=primary-group (id -gn) $4=`id -nG` output.
## Precondition: callers pass a NAMESPACED account (eph-run-/persist-leak-/persist-stable-
## <...>), never a bare group name -- so an account that IS itself a privileged/shared
## group name (docker, sudo, users) cannot occur and is not special-cased.
## Scope: rejects every privilege-granting GROUP + a shared primary. A NON-group
## PASSWORDLESS-sudo grant (a NOPASSWD sudoers entry) is invisible here -- the companion
## rt_account_can_sudo EXERCISES sudo to catch it. A command-specific sudoers entry, a
## privleap/leaprun grant, polkit, file-caps, or a private group given an extra member
## are adversarial pre-provisioning (out of the accident model), prevented by creating
## the account clean. rt_create_clean_account forces the private primary with
## `useradd --user-group` and grants only vboxusers; the leak account is provisioned the
## same way (rt_provision_leak), so it is clean by construction.
rt_account_unprivileged() {
   local account uid primary grp
   account="$1"
   uid="$2"
   primary="$3"
   [ "${uid}" -ne 0 ] || return 1
   [ "${primary}" = "${account}" ] || return 1
   ## Fail CLOSED on an empty group list: `id -nG` on a valid account always lists at
   ## least the primary group, so an empty $4 means the lookup FAILED (NSS/initgroups) --
   ## without this the loop runs zero times and ACCEPTS. Mirrors rt_account_can_sudo's
   ## fail-closed-on-error stance.
   [ -n "$4" ] || return 1
   for grp in $4; do
      case "${grp}" in
         "${account}"|vboxusers)
            ;;
         *)
            return 1
            ;;
      esac
   done
   return 0
}

## True if ACCOUNT can obtain PASSWORDLESS root via sudo. Unlike `sudo -l` (a listing
## that exits 0 for everyone), this EXERCISES sudo AS the account: rc 0 only when a
## passwordless sudo grant covering a plain command genuinely works -- catching a
## NOPASSWD sudoers entry / sudo-group membership that the group allowlist alone would
## miss. FAILS CLOSED: if the probe tools are absent it returns "can sudo" so the caller
## REJECTS (a missing runuser must never read as "account is clean"). Needs root.
## Does NOT catch a command-SPECIFIC NOPASSWD entry or a privleap/leaprun grant (privleap
## is not sudo) -- those are adversarial pre-provisioning, out of the accident model.
rt_account_can_sudo() {
   has runuser && has sudo || return 0
   runuser -u "$1" -- sudo --non-interactive /usr/bin/true >/dev/null 2>&1
}

## Fail-closed privilege gate for an account about to run a test. Refuses (SETUP_RC)
## a host-privileged account (uid 0 or a group beyond vboxusers) or one with
## passwordless sudo. Applied to EVERY test account so the isolation invariant holds
## uniformly: the ephemeral account at creation, and the PRE-PROVISIONED blessed and
## leak accounts at run time (this run did not create them). $1=account $2=role-label.
## Needs root (reads id, exercises sudo). Precondition: the account exists.
rt_require_account_unprivileged() {
   local account role uid primary groups
   account="$1"
   role="$2"
   ## Enumerate identity + groups with each `id` checked on its OWN line. Folded into the
   ## `rt_account_unprivileged ... || die` arg list, a failing `id` is MASKED: errexit is
   ## suspended left of `||`, so the substitution passes its partial stdout and the non-zero
   ## exit is lost. GNU id on a getgrouplist() failure prints ONLY the primary group and
   ## exits non-zero -> a primary-only (non-empty) list clears the empty-list guard and a
   ## privileged account reads as unprivileged. Cannot enumerate identity -> cannot prove
   ## unprivileged -> REFUSE (SETUP_RC).
   uid="$(id -u "${account}")" \
      || die "${SETUP_RC}" "refusing ${role} account '${account}': cannot read uid (id -u failed)"
   primary="$(id -gn "${account}")" \
      || die "${SETUP_RC}" "refusing ${role} account '${account}': cannot read primary group (id -gn failed)"
   groups="$(id -nG "${account}")" \
      || die "${SETUP_RC}" "refusing ${role} account '${account}': cannot enumerate groups (id -nG failed)"
   rt_account_unprivileged "${account}" "${uid}" "${primary}" "${groups}" \
      || die "${SETUP_RC}" "refusing ${role} account '${account}': host-privileged (uid 0 or a group beyond vboxusers)"
   ! rt_account_can_sudo "${account}" \
      || die "${SETUP_RC}" "refusing ${role} account '${account}': has passwordless sudo (NOPASSWD root)"
}

## Extract the value from `VBoxManage getextradata` output. A set key prints
## "Value: <v>"; an unset key prints "No value set!". Returns 1 (empty) for unset or
## any other shape, so an unset marker is a MISS, never a spurious value. Pure.
rt_parse_extradata() {
   case "$1" in
      'Value: '*)
         printf '%s\n' "${1#Value: }"
         ;;
      *)
         return 1
         ;;
   esac
}

## True only when BOTH VMs carry the REQUESTED version marker. Rejects an empty
## requested version and any GW/WS marker that is empty or differs -- so an
## unprovisioned (markerless) or wrong-version pair can never be attributed a verdict.
## Pure. $1=requested $2=gw-marker $3=ws-marker.
rt_pair_version_ok() {
   [ -n "$1" ] && [ "$2" = "$1" ] && [ "$3" = "$1" ]
}

## "blessed" when the resolved version equals the stable pin, else "prebless".
rt_bless_state() {
   if [ "$1" = "$2" ]; then
      printf '%s\n' "blessed"
   else
      printf '%s\n' "prebless"
   fi
}

## Pick the account from bless-state. A non-blessed version is never allowed into
## the golden account.
rt_select_account() {
   local guest_name bless_state token
   guest_name="$1"
   bless_state="$2"
   token="$3"
   case "${bless_state}" in
      blessed)
         printf '%s\n' "persist-stable-${guest_name}"
         ;;
      prebless)
         rt_eph_account "${guest_name}" "${token}" || return 1
         ;;
      *)
         return 1
         ;;
   esac
}

## ---------------------------------------------------------------------------
## version discovery (iso-download --print-version, single source)
## ---------------------------------------------------------------------------

## Resolve the version for a channel without downloading. Whonix publishes OVAs,
## not ISOs, so iso-download's developers index (<base>/iso/) does not apply --
## a Whonix developers build must be named with --version.
rt_resolve_version() {
   local want_channel
   want_channel="$1"
   if [ -n "${version_override}" ]; then
      printf '%s\n' "${version_override}"
      return 0
   fi
   if [ "${guest}" = 'whonix' ] && [ "${want_channel}" = 'developers' ]; then
      die "${SETUP_RC}" "whonix developers-version auto-discovery is OVA-based and not wired; pass --version"
   fi
   "${ISO_DOWNLOAD}" --project "${guest}" --channel "${want_channel}" --print-version
}

## ---------------------------------------------------------------------------
## account lifecycle (root)
## ---------------------------------------------------------------------------

rt_refresh_fleet() {
   if has "${NFT_FLEET_TOOL}"; then
      "${NFT_FLEET_TOOL}" --refresh-fleet-set \
         || printf '%s: WARN: fleet-set refresh failed; run %s --refresh-fleet-set\n' "${me}" "${NFT_FLEET_TOOL}" >&2
   else
      printf '%s: NOTE: %s not on PATH; run it --refresh-fleet-set so the host firewall covers new fleet users\n' "${me}" "${NFT_FLEET_TOOL}" >&2
   fi
}

## Create ACCOUNT as a clean, unprivileged fleet member if absent (idempotent), and
## assert it is clean whether freshly created or pre-existing. Used for the ephemeral
## install account AND to PROVISION the persistent leak account, so both are clean by
## construction -- not merely rejected at run time. Needs root.
## Serialize operations on a shared PERSISTENT account (the leak pair is one account +
## fixed VM names, so two runs would corrupt each other's snapshot restore). Acquires a
## per-account flock held until THIS process exits; fail-fast (nonblock) so a second
## concurrent run errors clearly instead of racing. Covers both a provision and a run, so
## a reimport can never race a run.
##
## The lock dir is ROOT-ONLY (0700 under /run, which is itself root-writable only): a
## world-writable dir like /run/lock would let any local user pre-create the lock file and
## hold LOCK_EX on it, wedging every future run with a bogus "another run holds the lock".
## Child VM processes are spawned via sudo / run_as_target_user (closefrom 3), so they do
## not inherit this fd and cannot carry the lock past our exit. Test seam:
## DM_RELEASE_TEST_LOCK_DIR.
rt_lock_account() {
   local lockdir lockfile
   lockdir="${DM_RELEASE_TEST_LOCK_DIR:-/run/dm-release-test}"
   mkdir --parents -- "${lockdir}" \
      || die "${SETUP_RC}" "cannot create lock dir '${lockdir}'"
   ## Enforce 0700 even on a pre-existing dir (mkdir -m would skip that, and would only
   ## set the deepest path with -p); /run is root-only so no unprivileged pre-create races.
   chmod 0700 -- "${lockdir}" \
      || die "${SETUP_RC}" "cannot secure lock dir '${lockdir}'"
   lockfile="${lockdir}/dm-release-test-$1.lock"
   exec {rt_lock_fd}>"${lockfile}" \
      || die "${SETUP_RC}" "cannot open lock '${lockfile}'"
   flock --nonblock "${rt_lock_fd}" \
      || die "${SETUP_RC}" "another dm-release-test run holds '${lockfile}' -- serialize runs on the shared '$1' account"
}

## VBoxXPCOMIPCD keeps its per-user IPC socket under <base>/.vbox-<user>-ipc and
## REFUSES a dir it does not own -- so VBoxManage then fails "Failed to create the
## VirtualBox object" (COM/IPC daemon socket error). userdel leaves the dir behind,
## and an eph-run-<guest>-<version> account is REUSED by name across runs but gets a
## fresh UID each time; the old UID is later reused by another account, so the stale
## dir is now foreign-owned and poisons the next same-named account. Remove a stale,
## FOREIGN-owned dir before VBox is used; never touch one the account owns (a persist-*
## account legitimately keeps its dir across runs). Idempotent; self-heals a prior run
## that crashed before image-test-gc could clean up.
rt_purge_foreign_vbox_ipc() {
   local account dir owner
   account="$1"
   dir="${VBOX_IPC_BASE}/.vbox-${account}-ipc"
   ## A real IPC dir is a plain directory. This path lives in world-writable /tmp,
   ## so a symlink here is never ours (stale or planted): remove the LINK itself --
   ## never --recursive, never stat/rm through it to a target -- then stop.
   if [ -L "${dir}" ]; then
      safe-rm --force -- "${dir}"
      return 0
   fi
   [ -e "${dir}" ] || return 0
   owner="$(stat --format='%U' -- "${dir}" 2>/dev/null || true)"
   [ "${owner}" = "${account}" ] && return 0
   safe-rm --recursive --force -- "${dir}"
}

rt_create_clean_account() {
   local account
   account="$1"
   if ! id "${account}" >/dev/null 2>&1; then
      ## --user-group forces a private primary group (name == account) regardless of the
      ## host's USERGROUPS_ENAB, so the isolation invariant holds and rt_account_unprivileged
      ## never rejects a freshly-created, otherwise-clean account. No sudoers.d / privleap
      ## grant is created -- the account gets vboxusers and nothing else.
      useradd --create-home --user-group --shell /bin/bash -- "${account}"
   fi
   getent group vboxusers >/dev/null || groupadd --system vboxusers
   usermod --append --groups vboxusers -- "${account}"
   rt_purge_foreign_vbox_ipc "${account}"
   ## INVARIANT: a test account (above all a leak account) is never host-privileged.
   ## A privileged account could tamper with the nft leak-drop or the results plane and
   ## void the verdict. Enforced by group/uid allowlist AND a passwordless-sudo exercise
   ## check (a NOPASSWD sudoers entry is not group-based); the dedicated namespace + clean
   ## creation is the primary guarantee.
   rt_require_account_unprivileged "${account}" test
   rt_refresh_fleet
}

## Read the leak pair's version marker off VM (as ACCOUNT -- VBox state is per-$HOME).
## Prints the pinned version, or returns 1 when the key is unset. Needs root.
rt_pair_version() {
   local out
   out="$(sudo -u "$1" -- "${VBOXMANAGE}" getextradata "$2" "${PAIR_VERSION_KEY}" 2>/dev/null)" || return 1
   rt_parse_extradata "${out}"
}

## Pin VERSION onto VM's leak-pair marker (as ACCOUNT). Needs root.
rt_set_pair_version() {
   sudo -u "$1" -- "${VBOXMANAGE}" setextradata "$2" "${PAIR_VERSION_KEY}" "$3" \
      || die "${SETUP_RC}" "failed to set ${PAIR_VERSION_KEY} on '$2'"
}

## Provision the persistent leak pair end to end: create the clean leak account, import
## the GW+WS pair under it via dist-installer-cli (which self-locks against concurrent
## runs), and pin the version marker on both VMs. The one-time dev-root bake + 'clean-live'
## snapshot still runs on the live guests (printed as the next step) -- it needs a booted
## sysmaint session, not scriptable headless from here. Needs root.
rt_provision_leak() {
   local account version gw ws account_home
   account="$1"
   version="$2"
   gw="Whonix-Gateway-${desktop}"
   ws="Whonix-Workstation-${desktop}"
   rt_lock_account "${account}"
   rt_create_clean_account "${account}"
   ## dist-installer-cli runs the download AND import AS the target account
   ## (run_as_target_user), so the staging dir must be target-writable. Pin it to the
   ## target's OWN home (always writable by it) via --directory-prefix; otherwise it
   ## defaults to the invoker's home, which the target cannot write (mkdir fails). This
   ## matches what the sysmaint-invoker path does automatically, without needing sysmaint.
   account_home="$(getent passwd "${account}" | cut -d: -f6)"
   [ -n "${account_home}" ] || die "${SETUP_RC}" "cannot resolve home for '${account}'"
   log info "importing whonix ${version} pair under ${account} via ${DIST_INSTALLER_CLI} (as ${DIST_INSTALLER_USER}, prefix ${account_home})"
   ## Invoke as the sudo-capable invoker (NOT root -- dist-installer-cli refuses root);
   ## --user="${account}" is the INSTALL target (the leak account), distinct from the invoker.
   ## --noupdate/--noupgrade skip the installer's apt-update + "upgrade the OS first" gate.
   ## That gate guards a fresh VirtualBox INSTALL on a user machine; here VBox is already
   ## installed on the test host and we only re-import OVAs, so a pending host upgrade is
   ## irrelevant to the import -- not masked, just not this harness's concern.
   sudo -u "${DIST_INSTALLER_USER}" -- "${DIST_INSTALLER_CLI}" --guest=whonix --guest-version="${version}" \
      --interface="${interface}" --non-interactive --user="${account}" \
      --directory-prefix="${account_home}/dist-installer-cli-download" \
      --noupdate --noupgrade --no-boot --import-only=both --destroy-existing-guest \
      || die "${SETUP_RC}" "dist-installer-cli import failed for whonix ${version}"
   rt_set_pair_version "${account}" "${gw}" "${version}"
   rt_set_pair_version "${account}" "${ws}" "${version}"
   log info "leak pair ${version} imported + version-pinned under ${account}"
   log info "NEXT (one-time, per VM, in a booted sysmaint session): run 'dev-root force', power off, then '${VBOXMANAGE} snapshot <vm> take clean-live' so dm-whonix-pair restore_fresh has a pristine, root-capable pair"
}

## EXIT-trap handler: remove the ephemeral account if one was created. Single
## cleanup path, so an abort anywhere after creation still reclaims it.
rt_eph_cleanup() {
   [ -n "${eph_account}" ] || return 0
   "${IMAGE_TEST_GC}" "${eph_account}" || true
   ## A VBoxSVC/VBoxXPCOMIPCD owned by the account lingers after the VM stops and
   ## holds userdel open (userdel REFUSES while any process still has the uid).
   ## SIGKILL the account's processes and POLL until they are actually gone -- a
   ## fixed settle guesses wrong (the daemon outlived a 2s sleep), so userdel then
   ## failed and leaked the account. Bounded by EPH_CLEANUP_SETTLE so a wedged
   ## reaper cannot hang cleanup; re-send the kill each poll in case a child respawned.
   local waited=0
   pkill --kill --uid "${eph_account}" 2>/dev/null || true
   while pgrep --uid "${eph_account}" >/dev/null 2>&1; do
      if [ "${waited}" -ge "${EPH_CLEANUP_SETTLE}" ]; then
         break
      fi
      sleep 1
      waited=$(( waited + 1 ))
      pkill --kill --uid "${eph_account}" 2>/dev/null || true
   done
   if ! userdel --remove -- "${eph_account}"; then
      log warn "userdel '${eph_account}' failed -- reap stray processes of that account and 'userdel --remove' it manually"
   fi
   rt_refresh_fleet
}

## Publish one lane's verdict to the results plane and print a summary line. The
## results subtree carries guest, interface AND version so lxqt and cli (or two
## versions) never collide on one path.
rt_publish_result() {
   local guest_name version account mode rc shot outdir verdict tok
   local -a pub_expect=()
   local -a pub_stderr=()
   guest_name="$1"
   version="$2"
   account="$3"
   mode="$4"
   rc="$5"
   ## shot: optional screenshot path for the results plane ('' when none, e.g. a
   ## download failure before any VM, or the packet-based whonix lane).
   shot="$6"
   shift 6

   ## rc 0 = PASS; the reserved SETUP/inconclusive code 2 = INCONCLUSIVE (a provisioning
   ## gap or inconclusive probe -- NOT a leak); any other non-zero (incl dm-whonix-pair
   ## FAIL_RC=5) = FAIL. The publisher derives the same verdict from rc for result.json
   ## (one source); computed here only for the console line below.
   verdict="$(image_test_verdict_from_rc "${rc}")"
   for tok in "$@"; do
      pub_expect+=( --expect "${tok}" )
   done
   ## A lane may hand us the failed check's output (rt_check_log) to publish as the
   ## step's stderr tail, so the run record explains WHY it failed. Consumed once.
   if [ -n "${rt_check_log:-}" ] && [ -s "${rt_check_log}" ]; then
      pub_stderr=( --step-stderr-file "${rt_check_log}" )
   fi
   rt_check_log=""
   ## origin=downloaded: this lane downloads + signature-verifies the OFFICIAL
   ## release image, it does not build it. lane = guest-interface so the site groups
   ## lxqt vs cli (and distinct versions) as separate matrix cells.
   ## A publish failure must NOT change the TEST verdict: keep rc, log it, and
   ## report the lane's real result on the console line (the results plane simply
   ## has no entry for this run -- NO-DATA on the site, never a faked verdict).
   outdir="$(image_test_results_publish "${RESULTS_ROOT}" "${RESULTS_OWNER}" \
      "${guest_name}-${interface}-${version//./-}" "${account}" "${mode}" \
      "${rc}" "${shot}" \
      --lane "${guest_name}-${interface}" --version "${version}" \
      --builder dm-release-test --origin "${rt_origin}" \
      "${pub_expect[@]}" "${pub_stderr[@]}")" \
      || { log warn "results publish failed for ${guest_name} ${interface} ${version} (verdict ${verdict} preserved)"; outdir='(publish-failed)'; }
   printf '%s: %s %s %s -- %s (rc=%s) -> %s\n' \
      "${me}" "${guest_name}" "${interface}" "${version}" "${verdict}" "${rc}" "${outdir}"
}

## ---------------------------------------------------------------------------
## lanes
## ---------------------------------------------------------------------------

rt_lane_kicksecure() {
   local account version iso pass_file vmname rc shot shot_arg check_log rt_staged_iso
   rt_staged_iso=""
   local -a checks_arg=()

   account="$1"
   version="$2"

   ## Acquire the EXACT resolved version (pin it; never re-resolve in the lane),
   ## and FAIL the lane if the download/verification fails -- never fall through
   ## to an install with an empty --iso and publish a false PASS (errexit is off
   ## inside a function called as `... || rc=$?`, so check explicitly).
   rc=0
   if [ -n "${local_iso}" ]; then
      ## Built-ISO lane: STAGE the ISO into the account-readable ISO_DIR -- a build commonly
      ## sits under a 0700 home the unprivileged install account cannot traverse, so root
      ## copies it out (a+r). (The run is already serialized on the fixed account in main.)
      ## errexit is OFF in this lane (called `... || rc=$?`), so every staging step is checked
      ## explicitly: a silent mkdir/cp failure would install a missing/truncated ISO and
      ## mis-attribute the result to the install rather than to staging.
      if ! mkdir --parents -- "${ISO_DIR}"; then
         log error "cannot create ISO staging dir '${ISO_DIR}'"
         return "${SETUP_RC}"
      fi
      if ! chmod a+rx -- "${ISO_DIR}"; then
         log error "cannot make ISO staging dir '${ISO_DIR}' readable"
         return "${SETUP_RC}"
      fi
      iso="${ISO_DIR}/${local_iso##*/}"
      ## Skip the copy when --iso already IS the staged path (cp would fail "same file", and
      ## removing it afterwards would delete the caller's ISO). Otherwise copy via a .part
      ## temp + atomic mv so a crash never leaves a truncated ISO at the final path, and
      ## remember the staged COPY so it is removed after the run (a 1.5G file per run).
      if ! [ "${local_iso}" -ef "${iso}" ]; then
         if ! cp -- "${local_iso}" "${iso}.part"; then
            log error "staging copy of '${local_iso}' failed"
            safe-rm --force -- "${iso}.part"
            return "${SETUP_RC}"
         fi
         if ! mv --force -- "${iso}.part" "${iso}"; then
            log error "staging mv of '${local_iso}' failed"
            return "${SETUP_RC}"
         fi
         rt_staged_iso="${iso}"
      fi
      if ! chmod a+r -- "${iso}"; then
         log error "cannot make staged ISO '${iso}' readable"
         return "${SETUP_RC}"
      fi
   else
      iso="$("${ISO_DOWNLOAD}" --project kicksecure --vmname Kicksecure \
         --desktop "${desktop}" --channel "${channel}" --version "${version}" \
         --output-dir "${ISO_DIR}" --cert "${CERT_PATH}")" || rc=$?
      if [ "${rc}" -ne 0 ]; then
         log error "iso-download failed (rc=${rc}) for kicksecure '${version}' -- not installing"
         rt_publish_result kicksecure "${version}" "${account}" calamares-install "${rc}" "" Kicksecure
         return "${rc}"
      fi
   fi

   ## Disposable LUKS passphrase for the install, readable only by the account.
   pass_file="$(sudo -u "${account}" -- mktemp --tmpdir "dm-release-test-pass.XXXXXX")"
   printf '%s\n' "release-test-${version}" | sudo -u "${account}" -- tee -- "${pass_file}" >/dev/null
   ## Account-owned screenshot path; dm-calamares-install captures the R4 first boot here.
   shot="$(sudo -u "${account}" -- mktemp --tmpdir "dm-release-test-shot.XXXXXX.png")"
   ## Account-owned sink for a FAILED release check's own in-guest output, so the run
   ## record explains WHY it failed (otherwise lost on power-off).
   check_log="$(sudo -u "${account}" -- mktemp --tmpdir "dm-release-test-checklog.XXXXXX")"

   vmname="Kicksecure-release-${version//./-}"
   if [ "${run_checks}" = 'true' ]; then
      checks_arg=( --checks )
   fi

   rc=0
   sudo -u "${account}" -- "${rt_session_env[@]}" "${DM_CALAMARES_INSTALL}" --vm "${vmname}" \
      --iso "${iso}" --passphrase-file "${pass_file}" --firmware "${firmware}" \
      --shot "${shot}" --check-log "${check_log}" "${checks_arg[@]}" || rc=$?
   sudo -u "${account}" -- safe-rm --force -- "${pass_file}" || true

   ## Publish the screenshot only if it was actually captured (R4 reached); a pre-R4
   ## failure leaves the mktemp placeholder empty -- do not publish a 0-byte screenshot.
   shot_arg=""
   [ -s "${shot}" ] && shot_arg="${shot}"
   ## Thread the failed check's output into the published step's stderr tail (empty
   ## file = a pass or a pre-check failure -> no tail).
   rt_check_log=""
   [ -s "${check_log}" ] && rt_check_log="${check_log}"
   rt_publish_result kicksecure "${version}" "${account}" calamares-install "${rc}" "${shot_arg}" Kicksecure
   sudo -u "${account}" -- safe-rm --force -- "${shot}" "${check_log}" 2>/dev/null || true
   ## Drop the staged ISO copy (only a copy we made, never the caller's original) so built
   ## runs do not accumulate multi-GB files in ISO_DIR.
   if [ -n "${rt_staged_iso}" ]; then
      safe-rm --force -- "${rt_staged_iso}" 2>/dev/null || true
   fi
   return "${rc}"
}

rt_lane_whonix() {
   local account version gw ws rc
   account="$1"
   version="$2"
   gw="Whonix-Gateway-${desktop}"
   ws="Whonix-Workstation-${desktop}"

   ## Serialize concurrent whonix runs: they share this one persistent account + fixed VM
   ## names, so two runs would corrupt each other's snapshot restore. Fail-fast if another
   ## run (or a provision) holds the lock.
   rt_lock_account "${account}"

   ## The pair must already be imported under ${account} (rt_provision_leak) with a
   ## dev-root-baked 'clean-live' snapshot on each VM; dm-whonix-pair fails closed with a
   ## clear message if the snapshot is absent.
   ##
   ## Verify the imported pair IS ${version} before running: the lane attributes the leak
   ## verdict to ${version}, so a stale/wrong-version or unprovisioned (markerless) pair
   ## must not silently mislabel a PASS or a leak. Fail CLOSED -- a missing/mismatched
   ## marker is a provisioning gap (SETUP_RC), NEVER a leak FAIL. Read both VMs (a half-
   ## reprovisioned pair with one stale VM is caught too).
   local gw_ver ws_ver
   gw_ver="$(rt_pair_version "${account}" "${gw}")" || gw_ver=""
   ws_ver="$(rt_pair_version "${account}" "${ws}")" || ws_ver=""
   rt_pair_version_ok "${version}" "${gw_ver}" "${ws_ver}" \
      || die "${SETUP_RC}" "leak pair version mismatch: requested '${version}', GW marked '${gw_ver}', WS marked '${ws_ver}' -- re-provision with 'dm-release-test whonix ${interface} --version ${version} --provision-leak' or pass the matching --version"

   rc=0
   sudo -u "${account}" -- "${rt_session_env[@]}" "${DM_WHONIX_PAIR}" --gw "${gw}" --ws "${ws}" || rc=$?

   rt_publish_result whonix "${version}" "${account}" whonix-pair "${rc}" "" tor-confirm
   return "${rc}"
}

## ---------------------------------------------------------------------------
## arg parsing + main
## ---------------------------------------------------------------------------

parse_args() {
   local -a positional=()
   while [ "$#" -gt 0 ]; do
      case "$1" in
         --channel)
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "missing value for --channel"
            channel="$2"
            shift 2
            ;;
         --version)
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "missing value for --version"
            version_override="$2"
            shift 2
            ;;
         --firmware)
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "missing value for --firmware"
            firmware="$2"
            shift 2
            ;;
         --iso)
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "missing value for --iso"
            local_iso="$2"
            shift 2
            ;;
         --checks)
            run_checks='true'
            shift
            ;;
         --dry-run)
            dry_run='true'
            shift
            ;;
         --provision-leak)
            provision_leak='true'
            shift
            ;;
         -h|--help)
            print_usage
            exit 0
            ;;
         --)
            shift
            break
            ;;
         -*)
            print_usage >&2
            die "${SETUP_RC}" "unknown option '$1'"
            ;;
         *)
            positional+=( "$1" )
            shift
            ;;
      esac
   done
   positional+=( "$@" )
   [ "${#positional[@]}" -eq 2 ] || { print_usage >&2; die "${SETUP_RC}" "GUEST and INTERFACE are required"; }
   guest="${positional[0]}"
   interface="${positional[1]}"
}

main() {
   local version stable bless_state account account_kind token

   parse_args "$@"

   rt_guest_valid "${guest}" || { print_usage >&2; die "${SETUP_RC}" "unsupported GUEST '${guest}'"; }
   desktop="$(rt_desktop_token "${interface}")" || die "${SETUP_RC}" "unsupported INTERFACE '${interface}'"
   case "${channel}" in
      stable|developers)
         true
         ;;
      *)
         die "${SETUP_RC}" "unknown --channel '${channel}' (stable|developers)"
         ;;
   esac

   if [ -n "${local_iso}" ]; then
      ## Built-ISO lane: no download. kicksecure-only (whonix tests an imported pair, not
      ## an ISO install). A disposable eph-run-GUEST-built account installs it; the version
      ## is a results-matrix LABEL only (git-describe, not a release token).
      [ "${guest}" = 'kicksecure' ] || die "${SETUP_RC}" "--iso is kicksecure-only"
      [ -f "${local_iso}" ] || die "${SETUP_RC}" "--iso '${local_iso}' is not a regular file"
      ## The filename's desktop must match INTERFACE, else the lane would publish (say) an
      ## Xfce build into the lxqt results cell.
      local iso_base
      iso_base="${local_iso##*/}"
      [ "${iso_base#"Kicksecure-${desktop}-"}" != "${iso_base}" ] \
         || die "${SETUP_RC}" "--iso name does not match interface '${interface}' (expected Kicksecure-${desktop}-<version>.<arch>.iso)"
      version="${version_override}"
      [ -n "${version}" ] || version="$(rt_build_version_from_iso "${local_iso}")" \
         || die "${SETUP_RC}" "could not derive a version label from --iso '${local_iso}' -- pass --version"
      rt_build_version_ok "${version}" \
         || die "${SETUP_RC}" "built version label '${version}' is not path-safe (<=64 of [A-Za-z0-9.+_-], no leading '-', no '/' or '..')"
      ## A built result must NOT overwrite an official-release results cell: reject a
      ## release-shaped (pure dotted) label of ANY length. A build-distinct label carries a
      ## dash/letter (the git-describe <ver>-g<sha>); matching on the charset here avoids
      ## rt_version_token's 32-char cap letting a long pure-dotted label slip through.
      case "${version}" in
         *[!0-9.]*)
            true
            ;;
         *)
            die "${SETUP_RC}" "built label '${version}' looks like a release version -- use a build-distinct label (the git-describe <ver>-g<sha>) so it cannot overwrite an official-release cell"
            ;;
      esac
      rt_origin='built'
      account='eph-run-'"${guest}"'-built'
      account_kind='prebless'
      stable='(local build)'
   else
      has "${ISO_DOWNLOAD}" || die "${SETUP_RC}" "'${ISO_DOWNLOAD}' not on PATH"

      version="$(rt_resolve_version "${channel}")"
      [ -n "${version}" ] || die "${SETUP_RC}" "could not resolve version"
      token="$(rt_version_token "${version}")" || die "${SETUP_RC}" "resolved version '${version}' is not a safe token"
      stable="$("${ISO_DOWNLOAD}" --project "${guest}" --channel stable --print-version)"
      bless_state="$(rt_bless_state "${version}" "${stable}")"
      ## The leak lane ALWAYS runs in the dedicated, PERSISTENT persist-leak- account
      ## (never the shared persist-stable-/eph-run- namespace); every other lane selects
      ## by bless-state. account_kind in {blessed, prebless, leak}; only prebless is
      ## ephemeral (created + gc'd here) -- blessed and leak are pre-provisioned.
      if rt_lane_is_leak "${guest}"; then
         account="persist-leak-${guest}"
         rt_account_is_leak "${account}" \
            || die "${SETUP_RC}" "leak account '${account}' is not in the persist-leak- namespace"
         account_kind='leak'
      else
         account="$(rt_select_account "${guest}" "${bless_state}" "${token}")" \
            || die "${SETUP_RC}" "could not derive account for ${guest} ${version}"
         account_kind="${bless_state}"
      fi
   fi

   ## --provision-leak is a one-time setup of the dedicated leak pair, not a test run;
   ## only the leak lane has a pre-provisioned persistent account to build.
   if [ "${provision_leak}" = 'true' ]; then
      rt_lane_is_leak "${guest}" \
         || die "${SETUP_RC}" "--provision-leak is only for the whonix leak lane"
   fi

   if [ "${dry_run}" = 'true' ]; then
      printf '%s\n' "plan:" \
         "  guest=${guest} interface=${interface} desktop=${desktop}" \
         "  channel=${channel} resolved=${version} stable=${stable} state=${account_kind}" \
         "  origin=${rt_origin} iso=${local_iso:-<download>}" \
         "  account=${account} firmware=${firmware} checks=${run_checks}" \
         "  mode=$([ "${provision_leak}" = 'true' ] && printf 'provision-leak' || printf 'test')" \
         "  iso_dir=${ISO_DIR} results_root=${RESULTS_ROOT}"
      return 0
   fi

   [ "$(id -u)" -eq 0 ] || die "${SETUP_RC}" "must run as root (creates the test account, publishes to the web root)"

   if [ "${provision_leak}" = 'true' ]; then
      rt_provision_leak "${account}" "${version}"
      return 0
   fi

   ## The built lane uses a FIXED account: serialize concurrent built runs HERE, before the
   ## eph-cleanup trap is armed and before the account is (re)created. A second run's failed
   ## lock then dies with NO trap set, so it cannot fire rt_eph_cleanup (userdel/pkill) on
   ## the account the first run is actively using.
   if [ -n "${local_iso}" ]; then
      rt_lock_account "${account}"
   fi

   ## Arm the single cleanup path BEFORE creating the account, so an abort during
   ## creation or the run still reclaims the ephemeral account on exit.
   trap rt_eph_cleanup EXIT
   if [ "${account_kind}" = 'prebless' ]; then
      eph_account="${account}"
      rt_create_clean_account "${account}"
   fi

   ## The leak + blessed accounts are PRE-PROVISIONED (persistent); never created or
   ## removed here. Enforce the leak invariant at run time: a missing or host-privileged
   ## leak account fails SETUP (SETUP_RC) -- NOT a leak FAIL -- so a provisioning gap or
   ## a dev-root/leaprun/sudo-enabled account can never masquerade as (or taint) a leak
   ## verdict. rt_refresh_fleet re-asserts the host nftables leak-drop covers it.
   if [ "${account_kind}" = 'leak' ]; then
      id "${account}" >/dev/null 2>&1 \
         || die "${SETUP_RC}" "leak account '${account}' does not exist -- pre-provision it with the clean-live Whonix pair"
      rt_require_account_unprivileged "${account}" leak
      rt_refresh_fleet
   fi

   ## The blessed account (persist-stable-) is ALSO pre-provisioned, not created here,
   ## so re-assert the same fail-closed privilege gate at run time: a NOPASSWD sudoers
   ## entry or a privileged group on it would otherwise void the account-isolation
   ## boundary the suite depends on. No nft leak-drop applies (not a leak account).
   if [ "${account_kind}" = 'blessed' ]; then
      id "${account}" >/dev/null 2>&1 \
         || die "${SETUP_RC}" "blessed account '${account}' does not exist -- pre-provision persist-stable-${guest}"
      rt_require_account_unprivileged "${account}" blessed
   fi

   local rc
   rc=0
   case "${guest}" in
      kicksecure)
         rt_lane_kicksecure "${account}" "${version}" || rc=$?
         ;;
      whonix)
         rt_lane_whonix "${account}" "${version}" || rc=$?
         ;;
   esac
   return "${rc}"
}

## Sourced (dm-release-test-tests) -> expose the functions without running;
## executed -> run.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
   main "$@"
fi
