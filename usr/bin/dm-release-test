#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Orchestrate an end-to-end image test of a Kicksecure/Whonix image: resolve the version,
## pick the test account by bless-state, acquire + install (or import) the image, run the
## matching test, and publish the verdict to the results plane. The glue over iso-download /
## dm-calamares-install / dm-whonix-pair / the results publisher; manual-invoke (no scheduler).
##
## --source (MANDATORY, no default) picks the image under test: official downloads a published
## release (origin=downloaded); built tests a LOCAL artifact (origin=built) -- a kicksecure
## --iso, or a whonix --ova-gw/--ova-ws pair imported DIRECTLY via VBoxManage (no download).
## A built run carries a build-distinct --version LABEL (never a release-shaped pure-dotted
## one) so it can never overwrite an official-release results cell.
##
## Account model (VBox state is per-$HOME, so the Linux user IS the isolation
## boundary):
##   - pre-bless candidate (resolved version != the wiki stable pin): a
##     disposable, version-named ephemeral account eph-inst-<guest>-<version>,
##     created on demand and removed after (image-test-gc wipes eph-*; the host
##     nftables leak-drop covers eph-inst-* by name).
##   - blessed (resolved == stable pin): the longitudinal golden account
##     persist-inst-<guest>; a non-blessed version is REFUSED there.
##   - built pair (--source built, whonix inst): persist-inst-<guest> again, but the pair is
##     a LOCAL OVA import pinned with a build-distinct marker -- so it escapes the blessed
##     (version == stable pin) requirement while keeping the same clean-account privilege gate.
##     A whonix built LEAK run stays in the persist-leak- account (account_kind=leak), just
##     with a locally-imported, build-labelled pair.
##   - leak lane (the Whonix pair + anon-leak-test battery): ALWAYS the dedicated,
##     persistent persist-leak-<guest>, never the shared persist-inst- or eph-inst-
##     namespace -- a non-leak lane's dev-root/leaprun mutation of a shared account's
##     GW/WS would falsify the leak verdict. Pre-provisioned (pair imported once;
##     dm-whonix-pair restore_fresh gives a pristine pair each run), NEVER
##     host-sudo/leaprun-enabled, covered by the host nftables leak-drop. Not created
##     or gc'd here; a missing/privileged leak account fails SETUP, never a leak FAIL.
##
## Runs as root on the server (creates users, publishes to the web root); drops
## to the test account for every VM operation. Sourced by dm-release-test-tests
## to unit-test the pure-logic helpers.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"

## log / die / has / die_if_not_has (log_run_die.sh sources get_colors, strings
## and has.bsh itself).
# shellcheck disable=SC1091
if ! source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/log_run_die.sh 2>/dev/null; then
   printf '%s\n' "${me}: ERROR: cannot source helper-scripts log_run_die.sh (set HELPER_SCRIPTS_PATH)" >&2
   exit 3
fi

ISO_DOWNLOAD="${ISO_DOWNLOAD:-iso-download}"
DM_CALAMARES_INSTALL="${DM_CALAMARES_INSTALL:-dm-calamares-install}"
DM_WHONIX_PAIR="${DM_WHONIX_PAIR:-dm-whonix-pair}"
## Delivers + reports the LOCAL apt repo (--local-repo lane). Overridable so a test asserts the
## localRepo provenance read with a stubbed `repo-path`.
DM_SHARED_APT_REPO="${DM_SHARED_APT_REPO:-dm-shared-apt-repo}"
## Build/admin user's home: holds ~/derivative-maker (git) + ~/derivative-binary (dm-source-state),
## the source-state anchors the localRepo provenance records. Defaults to the install/build user's
## home (DIST_INSTALLER_USER); a test seam overrides it to a fixture home.
DM_SOURCE_HOME="${DM_SOURCE_HOME:-}"
## Standalone firmware-apply tool, shared with dm-calamares-install. Whonix uses it for BIOS only
## (a plain modifyvm, no NVRAM ops); a prebuilt OVA's firmware cannot be re-applied beyond that.
DM_VBOX_FIRMWARE="${DM_VBOX_FIRMWARE:-dm-vbox-firmware}"
## The VirtualBox backend of the dm-image boot/install harness. Its `emit-argv --op import`
## prints the canonical `VBoxManage import <ova> --vsys 0 --vmname <vm>` argv (one token per
## line) -- the SINGLE SOURCE for the import shape, reused by the whonix --source built path
## so the OVA pair is imported DIRECTLY (no dist-installer-cli -> no download, no wrong-subject
## risk). Overridable for the unit test.
DM_SMBIOS_READER_VBOX="${DM_SMBIOS_READER_VBOX:-/usr/share/dm-smbios-reader-boot-tests/dm-smbios-reader-vbox}"
IMAGE_TEST_GC="${IMAGE_TEST_GC:-image-test-gc}"
## 1 (default): a FAILED run keeps its ephemeral account, its running VM and its staged
## ISO for post-mortem inspection; the next run of the same account reclaims them first
## (rt_eph_reclaim). 0: tear down on every exit.
DM_RELEASE_TEST_KEEP_FAILED="${DM_RELEASE_TEST_KEEP_FAILED:-1}"
VBOXMANAGE="${VBOXMANAGE:-VBoxManage}"
## Dir holding the patched CorebootRom-aware VBoxManage (+ its shared libs), for the opt-in
## --coreboot-rom lane. Mirrors the dasharo firmware-port selector: a source-built VBoxManage
## resolves its libs from its own bin dir, so this dir is added to LD_LIBRARY_PATH too. Empty ->
## the normal lanes use the stock VBOXMANAGE and --coreboot-rom is refused (needs the patch).
DASHARO_VBOX_BIN="${DASHARO_VBOX_BIN:-}"
DIST_INSTALLER_CLI="${DIST_INSTALLER_CLI:-dist-installer-cli}"
## dist-installer-cli REFUSES to run as root; it must be invoked by a non-root,
## passwordless-sudo-capable user (it sudo's internally for apt/modprobe and run_as_target_user
## to the install account). dm-release-test runs as root, so rt_provision_pair drops to this
## invoker. Default matches the VBOX_INSTALL_USER convention on the derivative hosts.
DIST_INSTALLER_USER="${DIST_INSTALLER_USER:-${VBOX_INSTALL_USER:-user}}"
## Forward the AI-session identity ACROSS the sudo drop into a leaf VM tool, so dm-vm-lock
## (re-exec'd inside the leaf) records WHICH session holds the VM-work lock and another
## session can investigate a suspicious holder. sudo strips inherited env; running `env` as
## the sudo'd command re-sets it regardless of sudoers env policy. Empty outside a session
## -> dm-vm-lock falls back to 'none'.
rt_session_env=(env
   "CLAUDE_RC_SESSION_NAME=${CLAUDE_RC_SESSION_NAME:-}"
   "CLAUDE_CODE_SESSION_ID=${CLAUDE_CODE_SESSION_ID:-}")
## VBox extradata key pinning the imported pair's version. Set on BOTH VMs at provision
## time (rt_provision_pair) and read back by rt_whonix_pair_require (both lanes), which
## REFUSES to attribute a verdict to a version the pair was not provisioned with.
PAIR_VERSION_KEY="${PAIR_VERSION_KEY:-leaktest/pair-version}"
## Best-effort host-firewall fleet-set refresh so a freshly-created eph account's
## leak-probe egress is dropped; the tool is a private-ai-config server script,
## not on PATH by default -- warn (do not fail) when absent.
NFT_FLEET_TOOL="${NFT_FLEET_TOOL:-provision-server-nftables.sh}"
## MAX seconds to wait for a killed VBoxSVC to reap before userdel (cleanup polls
## each second and stops as soon as the account's processes are gone). Test seam.
## Coerce a non-integer override back to the default so the poll's `[ -ge ]` cannot
## error (and spin) on a bad value.
EPH_CLEANUP_SETTLE="${EPH_CLEANUP_SETTLE:-20}"
case "${EPH_CLEANUP_SETTLE}" in
   ''|*[!0-9]*)
      EPH_CLEANUP_SETTLE=20
      ;;
esac
## Base dir for VBoxXPCOMIPCD's per-user IPC socket dir (.vbox-<user>-ipc). VBox
## puts it at /tmp/.vbox-<user>-ipc for the sudo'd eph account: sudo env_reset with
## no PAM session strips TMPDIR, so VBox falls back to /tmp (confirmed on the host).
## This is VBox's fixed socket location, not a redirectable temp path of ours; the
## unit test overrides it via the env var.
## style-ok: no-tmp-hardcode -- VBox's fixed per-user IPC socket dir for the sudo'd account
VBOX_IPC_BASE="${VBOX_IPC_BASE:-/tmp}"

ISO_DIR="${DM_RELEASE_TEST_ISO_DIR:-/var/lib/image-tests/iso}"
CERT_PATH="${DM_RELEASE_TEST_CERT:-/usr/share/keyrings/derivative.asc}"
RESULTS_ROOT="${IMAGE_TEST_RESULTS_ROOT:-/var/www/results}"
RESULTS_OWNER="${IMAGE_TEST_RESULTS_OWNER:-www-data}"
## A lane sets this to a FAILED release check's output file; rt_publish_result
## publishes it as the step's stderr tail, then resets it. Empty = nothing to add.
rt_check_log=""
## A lane sets this to its lane key (inst|leak); rt_publish_result folds it into the
## results subtree + --lane so the two whonix lanes (inst vs leak) never collide on one
## cell, then resets it. Empty = no lane component (the kicksecure install lane).
rt_lane_key=""
## A lane sets these to the captured firmware-lane evidence; rt_publish_result forwards them to
## the results plane (environment.firmware), then resets them. Empty = nothing to add.
rt_fw_declared=""
rt_fw_detected=""
rt_fw_evidence=""
rt_fw_match=""
## The inst lane sets this to the localRepo provenance JSON on a --local-repo run; rt_publish_result
## forwards it to the emitter (--provenance-local-repo), then resets it. Empty = published-repo run.
rt_local_repo_json=""

SETUP_RC=2

guest=""
interface=""
desktop=""
channel="developers"
version_override=""
firmware="efi-secureboot"
## Whether --firmware was passed explicitly (vs the default), so whonix can reject an EXPLICIT
## non-bios firmware while still defaulting silently to bios.
firmware_explicit="false"
## Test lane: inst (functional release battery) | leak (anon-leak-test battery). No
## default -- mandatory for whonix (both lanes are real choices); kicksecure is always
## inst. Validated in main once guest is known.
lane=""
run_checks='false'
dry_run='false'
do_provision='false'
## --source official|built: MANDATORY, no default (absence fails loud, never a silently-picked
## source). official = download a published release (--channel picks the stream); built = test a
## LOCAL artifact (kicksecure --iso, whonix --ova-gw/--ova-ws). Validated + coupled to the
## artifact flags by rt_resolve_origin, which also derives rt_origin.
source_mode=""
## --iso PATH (kicksecure --source built only): the LOCALLY-BUILT ISO to install instead of a
## downloaded release. Empty = not a kicksecure built run.
local_iso=""
## --ova-gw / --ova-ws PATH (whonix --source built only): the locally-built Gateway and
## Workstation OVAs, imported DIRECTLY via VBoxManage (no dist-installer-cli, no download) under
## the same persistent account the official lane uses. Empty = not a whonix built run.
ova_gw=""
ova_ws=""
## --coreboot-rom PATH (kicksecure only): run the SAME default-EFI full Calamares install story,
## with ONLY the firmware swapped to the coreboot+UefiPayload ROM (a generic EFI firmware). Empty
## = the normal lanes, byte-unchanged. Forwarded to dm-calamares-install, which needs --firmware
## efi and the patched CorebootRom-aware VBoxManage (resolved via DASHARO_VBOX_BIN / VBOXMANAGE).
coreboot_rom=""
## --local-repo <kicksecure|whonix> (whonix cli inst lane ONLY): run the functional battery against
## the fast LOCAL apt repo (the freshly-built packages delivered over the 'shared' vboxsf) instead
## of the published repos, so the build->test loop actually tests THIS build. Empty = published
## repos (byte-unchanged). Validated in main (rejected outside the whonix cli inst lane).
local_repo=""
## origin recorded in the result.json: downloaded (official release) or built (--iso).
rt_origin="downloaded"

## Trap state: the ephemeral account to remove on exit (set once created), so an
## abort between creation and the normal cleanup never leaks it. Empty => nothing.
eph_account=""
## Per-run built-ISO staging dir (set by the kicksecure lane), removed by rt_eph_cleanup
## on ANY exit path so a staged multi-GB copy never leaks on an error return or a signal.
rt_staged_dir=""

## fd holding the shared-account lock (rt_lock_account); held until this process exits.
rt_lock_fd=""

script_dir="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")"
if [ -d "${script_dir}/../libexec/image-test" ]; then
   image_test_libexec="${script_dir}/../libexec/image-test"
else
   image_test_libexec='/usr/libexec/image-test'
fi
# shellcheck source=../libexec/image-test/results-publish.bsh
source "${image_test_libexec}/results-publish.bsh"

die() {
   local code
   code="$1"
   shift
   printf '%s\n' "${me}: ERROR: $*" >&2
   exit "${code}"
}

print_usage() {
   printf '%s\n' "Usage:
  ${me} GUEST INTERFACE --source official|built [--lane inst|leak]
        [--channel stable|developers] [--version VER] [--firmware bios|efi|efi-secureboot]
        [--iso PATH] [--ova-gw PATH --ova-ws PATH] [--checks] [--dry-run]
        [--coreboot-rom PATH] [--local-repo kicksecure|whonix] [--provision]

  GUEST      kicksecure | whonix
  INTERFACE  lxqt | cli (the published desktop flavor)
  --source   MANDATORY (no default). Picks the image under test:
               official  download a published release (--channel picks the stream);
                         origin=downloaded. NO artifact flag (--iso/--ova-*) may be set.
               built     test a LOCAL artifact; origin=built. One shape per guest:
                           kicksecure -- --iso PATH (the locally-built ISO)
                           whonix     -- --ova-gw PATH --ova-ws PATH (the built GW+WS pair,
                                         imported DIRECTLY via VBoxManage; no download)
                         A build-distinct --version LABEL is required for whonix built and
                         for a non-derivable kicksecure ISO name; a release-shaped (pure
                         dotted) label is rejected so a built run can never overwrite an
                         official-release results cell.
  --lane     inst (functional release-check battery) | leak (anon-leak-test battery).
             MANDATORY for whonix (both are real lanes; no default). kicksecure is always
             inst (--lane leak is rejected).
  --iso PATH kicksecure --source built only: the locally-built ISO to install. Version LABEL
             is derived from the filename (override with --version); the run uses a disposable
             eph-inst-GUEST-built account.
  --ova-gw / --ova-ws PATH
             whonix --source built --provision ONLY: the locally-built Gateway/Workstation OVAs,
             imported directly (no dist-installer-cli) under the SAME persistent account the
             official lane uses (leak -> persist-leak-GUEST, inst -> persist-inst-GUEST). A
             --source built TEST run takes NO ovas -- it only verifies the pinned marker (pass
             --version). Pass the Gateway OVA to --ova-gw and the Workstation OVA to --ova-ws for
             this INTERFACE (a built OVA filename is arbitrary, so it is not validated).

--local-repo kicksecure|whonix (whonix cli inst lane ONLY): run the functional battery against the
fast LOCAL apt repo (THIS build's freshly-built packages, delivered over the 'shared' vboxsf) so
check 3 (upgrade-nonroot) upgrades from it instead of the published repos -- closing the
build->test loop. The result.json records a localRepo provenance block (derivative, repoPath,
sourceSha, packages). Rejected for any other guest/interface/lane. Populate the repo first with
derivative-maker --skip-published-packages.

A pre-bless candidate installs under a disposable eph-inst-GUEST-VERSION
account; a blessed release (version == stable pin) uses persist-inst-GUEST.
The whonix leak lane ALWAYS uses the dedicated persistent persist-leak-GUEST account; the
whonix inst lane uses the pre-provisioned persist-inst-GUEST pair (blessed official, or a
--source built pair pinned with a build-distinct label).
--dry-run prints the resolved plan and runs nothing.
--provision (whonix only) is the one-time setup of a persistent pair for the selected lane
(persist-leak-GUEST for leak, persist-inst-GUEST for a blessed inst or a built pair): create
the clean account, import the GW+WS pair under it (via dist-installer-cli for --source
official, or a direct VBoxManage import of --ova-gw/--ova-ws for --source built), and pin the
version marker each run then verifies; it prints the remaining one-time dev-root/clean-live
snapshot step.
--coreboot-rom PATH (kicksecure only) runs the SAME default-EFI full Calamares install story
with ONLY the firmware swapped to the coreboot+UefiPayload ROM at PATH (a generic EFI firmware,
a drop-in for VBox's OVMF). Needs --firmware efi and the patched CorebootRom-aware VBoxManage:
set DASHARO_VBOX_BIN to its bin dir (preferred) or VBOXMANAGE to its path. PATH must be readable
by the install account. Default empty -> the normal lanes are unchanged."
}

## ---------------------------------------------------------------------------
## pure logic (unit-tested by dm-release-test-tests; no VM, no network, no root)
## ---------------------------------------------------------------------------

## True for a supported guest.
rt_guest_valid() {
   case "$1" in
      kicksecure|whonix)
         return 0
         ;;
   esac
   return 1
}

## Map a lowercase interface to the published desktop token used in the image
## filename. Unknown -> fail (a wrong token silently 404s the download).
rt_desktop_token() {
   case "$1" in
      lxqt)
         printf '%s\n' "LXQt"
         ;;
      cli)
         printf '%s\n' "CLI"
         ;;
      *)
         return 1
         ;;
   esac
}

## Map a dotted version to a Linux-username-safe token: dots (and any char
## outside [a-z0-9-]) become '-'. Rejects a version that is not [0-9.].
rt_version_token() {
   local version token
   version="$1"
   case "${version}" in
      ''|*[!0-9.]*)
         return 1
         ;;
   esac
   token="${version//./-}"
   ## Bound the token: it becomes a results-path component (and, for eph-inst-, part of
   ## the account name). The leak/blessed lanes skip the account-name ceiling, so cap it
   ## here -- a garbage/overlong --version fails SETUP loudly, never a suppressed publish.
   [ "${#token}" -le 32 ] || return 1
   printf '%s\n' "${token}"
}

## Derive a build-version LABEL from a built ISO's filename
## (Kicksecure-<Desktop>-<version>.<arch>.iso). The git-describe <version>
## (e.g. 18.2.3.0-222-g<sha>) is NOT a release token (dashes + sha), so it never
## flows through rt_version_token / the eph account name -- a built run uses a FIXED
## eph-inst-<guest>-built account; this label is only the results-matrix cell + --version.
rt_build_version_from_iso() {
   local base v
   base="${1##*/}"
   ## Match the exact built-ISO shape Kicksecure-<Desktop>-<version>.<arch>.iso with a
   ## KNOWN arch suffix and strip prefix+suffix in the arm -- never a blind last-dot strip
   ## (which would corrupt a dotted version with no arch component, 18.2.3.0 -> 18.2.3).
   ## Fail closed on any other shape (-> the caller requires --version).
   case "${base}" in
      Kicksecure-*-*.Intel_AMD64.iso)
         v="${base%.Intel_AMD64.iso}"
         v="${v#*-*-}"
         ;;
      Kicksecure-*-*.ARM64.iso)
         v="${base%.ARM64.iso}"
         v="${v#*-*-}"
         ;;
      *)
         return 1
         ;;
   esac
   [ -n "${v}" ] || return 1
   ## The dm dev build-version is <builder>_<basehash>-<count>-g<40-hex> -- a builder-id prefix
   ## plus TWO 40-char hashes, far over the 64-char path-component bound. Reduce a git-describe
   ## tail to a concise, MEANINGFUL, path-safe label <count>-g<12-hex> (commit count + short
   ## sha), so a built run needs no hand-passed --version and its cell is self-describing.
   local vcount vsha
   vsha="${v##*-g}"       # after the last -g (the commit sha)
   vcount="${v%-g*}"      # before the last -g
   vcount="${vcount##*-}" # the <count> just before -g
   case "${vcount}" in ''|*[!0-9]*) vcount='' ;; esac
   case "${vsha}" in ''|*[!0-9a-f]*) vsha='' ;; esac
   if [ -n "${vcount}" ] && [ -n "${vsha}" ] && [ "${#vsha}" -ge 7 ]; then
      v="${vcount}-g${vsha:0:12}"
   fi
   printf '%s\n' "${v}"
}

## Validate a built-ISO version label is a safe results-path component: no path
## separators / traversal, a bounded git-describe-ish charset.
rt_build_version_ok() {
   local v="$1"
   ## A leading '-' would be read as an option by the emitter's argparse (--version <v>
   ## exits 2 -> no result.json -> a false NO-DATA); '.'/'..' resolve to a directory, not
   ## a distinct results cell. Reject both, plus separators / traversal / bad charset.
   case "${v}" in
      '' | '.' | '..' | -* | */* | *..* | *[!A-Za-z0-9.+_-]*)
         return 1
         ;;
   esac
   [ "${#v}" -le 64 ] || return 1
   return 0
}

## True when a version LABEL is build-distinct, return 1 when it is release-shaped. A built
## result must NOT overwrite an official-release results cell, so the caller REJECTS a
## release-shaped label. The cell key is "${version//./-}" -- dots AND dashes both fold to '-'
## -- so a label of ONLY [0-9.-] (e.g. "18-2-3-0") collides with the official dotted release
## "18.2.3.0". Require a char OUTSIDE [0-9.-] (the git-describe <ver>-g<sha> always carries the
## letter 'g'); charset match (not length) so a long collider cannot slip past rt_version_token's
## 32-char cap. Pure; unit-tested.
rt_version_build_distinct() {
   case "$1" in
      *[!0-9.-]*)
         return 0
         ;;
   esac
   return 1
}

## The firmware enum, SINGLE source: --firmware validates against it, and rt_version_fw_distinct
## below reasons about its prefix pair (efi is a dash-prefix of efi-secureboot).
FIRMWARE_VALUES=(bios efi efi-secureboot)

## True when $1 is a known firmware value.
firmware_valid() {
   local want="$1" f
   for f in "${FIRMWARE_VALUES[@]}"; do
      [ "${f}" = "${want}" ] && return 0
   done
   return 1
}

## Reject a BUILT version that, folded into the results cell key after the firmware token, could
## impersonate a DIFFERENT firmware's official cell. The cell tail is "-${firmware}-${version//./-}";
## both the firmware and the dashed version use '-' separators and the enum has a prefix pair, so
## "--firmware efi --version secureboot-18.2.3.0" folds to the same "-efi-secureboot-18-2-3-0"
## cell as "--firmware efi-secureboot --version 18.2.3.0". For every enum value that strictly
## EXTENDS ${firmware} at a '-' boundary, forbid a dashed version opening with that extension, so
## the version cannot steal the firmware's trailing segment. rt_version_build_distinct already
## blocks the pure-release-shaped labels. Pure. $1 = firmware, $2 = version.
rt_version_fw_distinct() {
   local firmware="$1" dashed="${2//./-}" other suffix
   for other in "${FIRMWARE_VALUES[@]}"; do
      case "${other}" in
         "${firmware}-"*)
            suffix="${other#"${firmware}-"}"
            case "${dashed}" in
               "${suffix}" | "${suffix}-"*)
                  return 1
                  ;;
            esac
            ;;
      esac
   done
   return 0
}

## Compose + validate the ephemeral install account name. Keeping the eph-inst- prefix
## is load-bearing: image-test-gc only wipes eph-*, and the host nftables leak-drop
## resolves the fleet by persist-inst-*|eph-inst-*|persist-leak-*|eph-leak-* name pattern.
## useradd's NAME_REGEX is ^[a-zA-Z][a-zA-Z0-9_-]*$ (no dots) with a 32-char ceiling.
rt_eph_account() {
   local guest_name token account
   guest_name="$1"
   token="$2"
   account="eph-inst-${guest_name}-${token}"
   case "${account}" in
      [a-z]*)
         true
         ;;
      *)
         return 1
         ;;
   esac
   case "${account}" in
      *[!a-z0-9-]*)
         return 1
         ;;
   esac
   [ "${#account}" -le 32 ] || return 1
   printf '%s\n' "${account}"
}

## True when the run is the leak lane (the Whonix GW/WS pair + anon-leak-test battery);
## the leak lane ALWAYS uses the dedicated persist-leak- account, regardless of bless-
## state. Keyed on the selected LANE (not the guest): whonix supports both inst and leak,
## so the account/nft/provision decisions follow the lane, never a guest hardcode.
rt_lane_is_leak() {
   [ "$1" = 'leak' ]
}

## Validate the test lane for a guest and echo the EFFECTIVE lane. No default lane:
##   whonix    -- --lane is MANDATORY (inst|leak); both are real choices, so a missing
##                or invalid value fails loud (return 1), never a silently-picked lane.
##   kicksecure-- only the inst (Calamares install) lane exists; '' or 'inst' normalize
##                to inst, 'leak' is rejected.
## $1=guest $2=raw lane. Pure; unit-tested.
rt_effective_lane() {
   case "$1" in
      whonix)
         case "$2" in
            inst|leak)
               printf '%s\n' "$2"
               ;;
            *)
               return 1
               ;;
         esac
         ;;
      kicksecure)
         case "$2" in
            ''|inst)
               printf '%s\n' "inst"
               ;;
            *)
               return 1
               ;;
         esac
         ;;
      *)
         return 1
         ;;
   esac
}

## True only for a leak-namespace account name. Guards the invariant that the leak
## lane is never handed a shared persist-inst-/eph-inst- account.
rt_account_is_leak() {
   case "$1" in
      persist-leak-*)
         return 0
         ;;
   esac
   return 1
}

## Pure host-privilege gate (unit-tested): a test account must not be uid 0, its PRIMARY
## group must be its own private group (name == account), and every group it holds must
## be that private group or vboxusers. Requiring a PRIVATE primary (not a shared users/
## vboxusers) keeps the account's files off a group other fleet accounts share -- a
## shared primary breaks per-account isolation. The allowlist is keyed on the account
## name, NOT blind-trusting the primary, so a privileged group (root/sudo/docker/disk)
## anywhere is rejected. $1=account $2=uid $3=primary-group (id -gn) $4=`id -nG` output.
## Precondition: callers pass a NAMESPACED account (eph-inst-/persist-leak-/persist-inst-
## <...>), never a bare group name -- so an account that IS itself a privileged/shared
## group name (docker, sudo, users) cannot occur and is not special-cased.
## Scope: rejects every privilege-granting GROUP + a shared primary. A NON-group
## PASSWORDLESS-sudo grant (a NOPASSWD sudoers entry) is invisible here -- the companion
## rt_account_can_sudo EXERCISES sudo to catch it. A command-specific sudoers entry, a
## privleap/leaprun grant, polkit, file-caps, or a private group given an extra member
## are adversarial pre-provisioning (out of the accident model), prevented by creating
## the account clean. rt_create_clean_account forces the private primary with
## `useradd --user-group` and grants only vboxusers; the persistent leak/inst account is
## provisioned the same way (rt_provision_pair), so it is clean by construction.
rt_account_unprivileged() {
   local account uid primary grp
   account="$1"
   uid="$2"
   primary="$3"
   [ "${uid}" -ne 0 ] || return 1
   [ "${primary}" = "${account}" ] || return 1
   ## Fail CLOSED on an empty group list: `id -nG` on a valid account always lists at
   ## least the primary group, so an empty $4 means the lookup FAILED (NSS/initgroups) --
   ## without this the loop runs zero times and ACCEPTS. Mirrors rt_account_can_sudo's
   ## fail-closed-on-error stance.
   [ -n "$4" ] || return 1
   for grp in $4; do
      case "${grp}" in
         "${account}"|vboxusers)
            ;;
         *)
            return 1
            ;;
      esac
   done
   return 0
}

## True if ACCOUNT can obtain PASSWORDLESS root via sudo. Unlike `sudo -l` (a listing
## that exits 0 for everyone), this EXERCISES sudo AS the account: rc 0 only when a
## passwordless sudo grant covering a plain command genuinely works -- catching a
## NOPASSWD sudoers entry / sudo-group membership that the group allowlist alone would
## miss. FAILS CLOSED: if the probe tools are absent it returns "can sudo" so the caller
## REJECTS (a missing runuser must never read as "account is clean"). Needs root.
## Does NOT catch a command-SPECIFIC NOPASSWD entry or a privleap/leaprun grant (privleap
## is not sudo) -- those are adversarial pre-provisioning, out of the accident model.
rt_account_can_sudo() {
   has runuser && has sudo || return 0
   runuser -u "$1" -- sudo --non-interactive /usr/bin/true >/dev/null 2>&1
}

## Fail-closed privilege gate for an account about to run a test. Refuses (SETUP_RC)
## a host-privileged account (uid 0 or a group beyond vboxusers) or one with
## passwordless sudo. Applied to EVERY test account so the isolation invariant holds
## uniformly: the ephemeral account at creation, and the PRE-PROVISIONED blessed and
## leak accounts at run time (this run did not create them). $1=account $2=role-label.
## Needs root (reads id, exercises sudo). Precondition: the account exists.
rt_require_account_unprivileged() {
   local account role uid primary groups
   account="$1"
   role="$2"
   ## Enumerate identity + groups with each `id` checked on its OWN line. Folded into the
   ## `rt_account_unprivileged ... || die` arg list, a failing `id` is MASKED: errexit is
   ## suspended left of `||`, so the substitution passes its partial stdout and the non-zero
   ## exit is lost. GNU id on a getgrouplist() failure prints ONLY the primary group and
   ## exits non-zero -> a primary-only (non-empty) list clears the empty-list guard and a
   ## privileged account reads as unprivileged. Cannot enumerate identity -> cannot prove
   ## unprivileged -> REFUSE (SETUP_RC).
   uid="$(id -u "${account}")" \
      || die "${SETUP_RC}" "refusing ${role} account '${account}': cannot read uid (id -u failed)"
   primary="$(id -gn "${account}")" \
      || die "${SETUP_RC}" "refusing ${role} account '${account}': cannot read primary group (id -gn failed)"
   groups="$(id -nG "${account}")" \
      || die "${SETUP_RC}" "refusing ${role} account '${account}': cannot enumerate groups (id -nG failed)"
   rt_account_unprivileged "${account}" "${uid}" "${primary}" "${groups}" \
      || die "${SETUP_RC}" "refusing ${role} account '${account}': host-privileged (uid 0 or a group beyond vboxusers)"
   ! rt_account_can_sudo "${account}" \
      || die "${SETUP_RC}" "refusing ${role} account '${account}': has passwordless sudo (NOPASSWD root)"
}

## Extract the value from `VBoxManage getextradata` output. A set key prints
## "Value: <v>"; an unset key prints "No value set!". Returns 1 (empty) for unset or
## any other shape, so an unset marker is a MISS, never a spurious value. Pure.
rt_parse_extradata() {
   case "$1" in
      'Value: '*)
         printf '%s\n' "${1#Value: }"
         ;;
      *)
         return 1
         ;;
   esac
}

## True only when BOTH VMs carry the REQUESTED version marker. Rejects an empty
## requested version and any GW/WS marker that is empty or differs -- so an
## unprovisioned (markerless) or wrong-version pair can never be attributed a verdict.
## Pure. $1=requested $2=gw-marker $3=ws-marker.
rt_pair_version_ok() {
   [ -n "$1" ] && [ "$2" = "$1" ] && [ "$3" = "$1" ]
}

## "blessed" when the resolved version equals the stable pin, else "prebless".
rt_bless_state() {
   if [ "$1" = "$2" ]; then
      printf '%s\n' "blessed"
   else
      printf '%s\n' "prebless"
   fi
}

## Pick the account from bless-state. A non-blessed version is never allowed into
## the golden account.
rt_select_account() {
   local guest_name bless_state token
   guest_name="$1"
   bless_state="$2"
   token="$3"
   case "${bless_state}" in
      blessed)
         printf '%s\n' "persist-inst-${guest_name}"
         ;;
      prebless)
         rt_eph_account "${guest_name}" "${token}" || return 1
         ;;
      *)
         return 1
         ;;
   esac
}

## Validate the MANDATORY --source and its artifact-flag coupling by GUEST, and echo the origin
## (downloaded for official, built for built). Pure (no FS/VM/root); unit-tested.
## Rules (no default -- an empty source is rejected):
##   - official: a published-release download; NO artifact flag (--iso/--ova-*) may be set.
##   - built kicksecure: --iso (the ISO installed every run); --ova-* is whonix-only.
##   - built whonix: --iso is kicksecure-only. The --ova pair is a PROVISION-only input (the
##     two-phase flow: --provision imports the pair, a test run only verifies the pinned marker),
##     so its presence is enforced by main against --provision, NOT here.
## $1=source $2=guest $3=iso $4=ova_gw $5=ova_ws.
rt_resolve_origin() {
   local source guest iso ova_gw ova_ws
   source="$1"
   guest="$2"
   iso="$3"
   ova_gw="$4"
   ova_ws="$5"
   case "${source}" in
      official)
         ## No artifact flag may be set under official.
         [ -z "${iso}${ova_gw}${ova_ws}" ] || return 1
         printf '%s\n' "downloaded"
         ;;
      built)
         case "${guest}" in
            kicksecure)
               ## kicksecure built = --iso; --ova-* is whonix-only.
               [ -n "${iso}" ] || return 1
               [ -z "${ova_gw}${ova_ws}" ] || return 1
               ;;
            whonix)
               ## whonix built uses the --ova pair (provision-only, checked in main); --iso is
               ## kicksecure-only.
               [ -z "${iso}" ] || return 1
               ;;
            *)
               return 1
               ;;
         esac
         printf '%s\n' "built"
         ;;
      *)
         return 1
         ;;
   esac
}

## ---------------------------------------------------------------------------
## version discovery (iso-download --print-version, single source)
## ---------------------------------------------------------------------------

## Resolve the version for a channel without downloading. Whonix publishes OVAs,
## not ISOs, so iso-download's developers index (<base>/iso/) does not apply --
## a Whonix developers build must be named with --version.
rt_resolve_version() {
   local want_channel
   want_channel="$1"
   if [ -n "${version_override}" ]; then
      printf '%s\n' "${version_override}"
      return 0
   fi
   if [ "${guest}" = 'whonix' ] && [ "${want_channel}" = 'developers' ]; then
      die "${SETUP_RC}" "whonix developers-version auto-discovery is OVA-based and not wired; pass --version"
   fi
   "${ISO_DOWNLOAD}" --project "${guest}" --channel "${want_channel}" --print-version
}

## ---------------------------------------------------------------------------
## account lifecycle (root)
## ---------------------------------------------------------------------------

## Best-effort refresh after an account is REMOVED (exit cleanup): a stale uid left in
## the set only over-blocks, so a failure here warns instead of aborting cleanup.
rt_refresh_fleet() {
   "${NFT_FLEET_TOOL}" --refresh-fleet-set \
      || printf '%s\n' "${me}: WARN: fleet-set refresh failed; run ${NFT_FLEET_TOOL} --refresh-fleet-set" >&2
}

## Refresh the host leak-drop set and PROVE ACCOUNT is in the loaded set before its
## VMs run (fail-closed): a missing tool, a failed refresh, an unprovisioned table or a
## selector that does not match the account name would otherwise run it unprotected.
rt_require_fleet_member() {
   local account
   account="$1"
   "${NFT_FLEET_TOOL}" --refresh-fleet-set \
      || die "${SETUP_RC}" "fleet-set refresh failed ('${NFT_FLEET_TOOL}' --refresh-fleet-set)"
   "${NFT_FLEET_TOOL}" --assert-fleet-member "${account}" \
      || die "${SETUP_RC}" "account '${account}' is not covered by the host nftables leak-drop"
}

## Create ACCOUNT as a clean, unprivileged fleet member if absent (idempotent), and
## assert it is clean whether freshly created or pre-existing. Used for the ephemeral
## install account AND to PROVISION the persistent leak account, so both are clean by
## construction -- not merely rejected at run time. Needs root.
## Serialize operations on a shared PERSISTENT account (a persistent pair is one account +
## fixed VM names, so two runs would corrupt each other's snapshot restore). Acquires a
## per-account flock held until THIS process exits; fail-fast (nonblock) so a second
## concurrent run errors clearly instead of racing. Covers both a provision and a run, so
## a reimport can never race a run.
##
## The lock dir is ROOT-ONLY (0700 under /run, which is itself root-writable only): a
## world-writable dir like /run/lock would let any local user pre-create the lock file and
## hold LOCK_EX on it, wedging every future run with a bogus "another run holds the lock".
## Child VM processes are spawned via sudo / run_as_target_user (closefrom 3), so they do
## not inherit this fd and cannot carry the lock past our exit. Test seams:
## DM_RELEASE_TEST_LOCK_DIR, DM_RELEASE_TEST_STATE_DIR, DM_RELEASE_TEST_LOCK_WAIT.
##
## The dir helpers SET a global rather than print: a die inside "$(...)" only exits the
## substitution, leaving an empty prefix -- root would then write '/kept-ACCOUNT.staged'.

## Create root-only dir $1 (described as $2) 0700. Enforce 0700 even on a pre-existing dir
## (mkdir -m would skip that, and would only set the deepest path with -p).
rt_private_dir() {
   case "$1" in
      /?*)
         ;;
      *)
         die "${SETUP_RC}" "$2 dir '$1' is not an absolute path"
         ;;
   esac
   mkdir --parents -- "$1" \
      || die "${SETUP_RC}" "cannot create $2 dir '$1'"
   chmod 0700 -- "$1" \
      || die "${SETUP_RC}" "cannot secure $2 dir '$1'"
}

## Locks live in /run: they belong to running processes, so a reboot clearing them is right.
## Sets rt_lockdir.
rt_lock_dir() {
   rt_lockdir="${DM_RELEASE_TEST_LOCK_DIR:-/run/dm-release-test}"
   rt_private_dir "${rt_lockdir}" lock
}

## Kept-run markers outlive a reboot (the multi-GB staged ISO dir they name does), so they
## live in persistent root-only state. Sets rt_statedir.
rt_state_dir() {
   rt_statedir="${DM_RELEASE_TEST_STATE_DIR:-/var/lib/image-tests/dm-release-test}"
   rt_private_dir "${rt_statedir}" state
}

## A leftover sweep briefly holds a reclaimed account's lock (gc + process settle), so a run
## starting on that account waits for it, bounded and announced, instead of failing at once.
rt_lock_account() {
   local lockfile wait
   rt_lock_dir
   lockfile="${rt_lockdir}/dm-release-test-$1.lock"
   wait="${DM_RELEASE_TEST_LOCK_WAIT:-300}"
   exec {rt_lock_fd}>"${lockfile}" \
      || die "${SETUP_RC}" "cannot open lock '${lockfile}'"
   flock --nonblock "${rt_lock_fd}" && return 0
   log notice "waiting up to ${wait}s for '${lockfile}' (another run, or a leftover sweep reclaiming '$1')"
   flock --timeout "${wait}" "${rt_lock_fd}" \
      || die "${SETUP_RC}" "another dm-release-test run holds '${lockfile}' -- serialize runs on the shared '$1' account"
}

## VBoxXPCOMIPCD keeps its per-user IPC socket under <base>/.vbox-<user>-ipc and
## REFUSES a dir it does not own -- so VBoxManage then fails "Failed to create the
## VirtualBox object" (COM/IPC daemon socket error). userdel leaves the dir behind,
## and an eph-inst-<guest>-<version> account is REUSED by name across runs but gets a
## fresh UID each time; the old UID is later reused by another account, so the stale
## dir is now foreign-owned and poisons the next same-named account. Remove a stale,
## FOREIGN-owned dir before VBox is used; never touch one the account owns (a persist-*
## account legitimately keeps its dir across runs). Idempotent; self-heals a prior run
## that crashed before image-test-gc could clean up.
rt_purge_foreign_vbox_ipc() {
   local account dir owner
   account="$1"
   dir="${VBOX_IPC_BASE}/.vbox-${account}-ipc"
   ## A real IPC dir is a plain directory. This path lives in world-writable /tmp,
   ## so a symlink here is never ours (stale or planted): remove the LINK itself --
   ## never --recursive, never stat/rm through it to a target -- then stop.
   if [ -L "${dir}" ]; then
      safe-rm --force -- "${dir}"
      return 0
   fi
   [ -e "${dir}" ] || return 0
   owner="$(stat --format='%U' -- "${dir}" 2>/dev/null || true)"
   [ "${owner}" = "${account}" ] && return 0
   safe-rm --recursive --force -- "${dir}"
}

rt_create_clean_account() {
   local account
   account="$1"
   if ! id "${account}" >/dev/null 2>&1; then
      ## --user-group forces a private primary group (name == account) regardless of the
      ## host's USERGROUPS_ENAB, so the isolation invariant holds and rt_account_unprivileged
      ## never rejects a freshly-created, otherwise-clean account. No sudoers.d / privleap
      ## grant is created -- the account gets vboxusers and nothing else.
      useradd --create-home --user-group --shell /bin/bash -- "${account}"
   fi
   getent group vboxusers >/dev/null || groupadd --system vboxusers
   usermod --append --groups vboxusers -- "${account}"
   rt_purge_foreign_vbox_ipc "${account}"
   ## INVARIANT: a test account (above all a leak account) is never host-privileged.
   ## A privileged account could tamper with the nft leak-drop or the results plane and
   ## void the verdict. Enforced by group/uid allowlist AND a passwordless-sudo exercise
   ## check (a NOPASSWD sudoers entry is not group-based); the dedicated namespace + clean
   ## creation is the primary guarantee.
   rt_require_account_unprivileged "${account}" test
   rt_require_fleet_member "${account}"
}

## Read the pair's version marker off VM (as ACCOUNT -- VBox state is per-$HOME).
## Prints the pinned version, or returns 1 when the key is unset. Needs root.
rt_pair_version() {
   local out
   out="$(sudo -u "$1" -- "${VBOXMANAGE}" getextradata "$2" "${PAIR_VERSION_KEY}" 2>/dev/null)" || return 1
   rt_parse_extradata "${out}"
}

## Pin VERSION onto VM's pair marker (as ACCOUNT). Needs root.
rt_set_pair_version() {
   sudo -u "$1" -- "${VBOXMANAGE}" setextradata "$2" "${PAIR_VERSION_KEY}" "$3" \
      || die "${SETUP_RC}" "failed to set ${PAIR_VERSION_KEY} on '$2'"
}

## Import ONE locally-built OVA as VM under ACCOUNT, idempotently (needs root; runs VBox as
## the account -- state is per-$HOME). Reuses build_import_argv's canonical argv shape from
## ${DM_SMBIOS_READER_VBOX} (single source for `import <ova> --vsys 0 --vmname <vm>`) rather
## than reconstructing it here. $1=account $2=ova $3=vm.
rt_import_one_ova() {
   local account ova vm emitted
   account="$1"
   ova="$2"
   vm="$3"
   ## Idempotent re-provision: drop any same-named VM first (best-effort; a fresh account has
   ## none). Mirrors dist-installer-cli --destroy-existing-guest so a re-import never collides.
   sudo -u "${account}" -- "${VBOXMANAGE}" controlvm "${vm}" poweroff >/dev/null 2>&1 || true
   sudo -u "${account}" -- "${VBOXMANAGE}" unregistervm "${vm}" --delete >/dev/null 2>&1 || true
   emitted="$("${DM_SMBIOS_READER_VBOX}" emit-argv --op import --ova "${ova}" --vm "${vm}")" \
      || die "${SETUP_RC}" "could not build the import argv ('${DM_SMBIOS_READER_VBOX}' emit-argv --op import failed for '${ova}')"
   local -a imp=()
   mapfile -t imp <<< "${emitted}"
   ## imp[0] is the literal 'VBoxManage' binary name; run the import with THIS harness's
   ## overridable VBOXMANAGE (honors the unit-test stub / a dasharo build) plus the remaining
   ## argv, as the account.
   { [ "${#imp[@]}" -ge 2 ] && [ -n "${imp[0]}" ]; } \
      || die "${SETUP_RC}" "unexpected import argv for '${ova}': '${emitted}'"
   sudo -u "${account}" -- "${VBOXMANAGE}" "${imp[@]:1}" \
      || die "${SETUP_RC}" "VBoxManage import of '${ova}' as '${vm}' failed"
}

## Import a locally-built GW+WS OVA pair directly under ACCOUNT. $1=account $2=gw $3=ws.
rt_import_built_pair() {
   local account gw ws ova
   account="$1"
   gw="$2"
   ws="$3"
   { [ -n "${ova_gw}" ] && [ -n "${ova_ws}" ]; } \
      || die "${SETUP_RC}" "built-pair provisioning needs --ova-gw and --ova-ws"
   ## Verify BOTH ovas are readable BY THE IMPORT ACCOUNT before importing EITHER. The import
   ## runs `sudo -u account` (VBox state is per-$HOME) and rt_import_one_ova deletes any existing
   ## same-named VM first, so an ova the account cannot read (mode-0600 under /root, a 0700 build
   ## home) would otherwise destroy the existing pair and THEN fail -- a root `[ -f ]` does not
   ## prove the dropped account can read it.
   for ova in "${ova_gw}" "${ova_ws}"; do
      sudo -u "${account}" -- test -r "${ova}" \
         || die "${SETUP_RC}" "ova '${ova}' is not readable by the import account '${account}' -- place it where that account can read it"
   done
   rt_import_one_ova "${account}" "${ova_gw}" "${gw}"
   rt_import_one_ova "${account}" "${ova_ws}" "${ws}"
}

## Provision a persistent pair end to end (leak, blessed inst, OR a built pair): create the
## clean account, import the GW+WS pair under it, and pin the version marker on both VMs. The
## import path follows the ORIGIN:
##   - downloaded (official): dist-installer-cli (which self-locks + downloads + verifies).
##   - built: the local --ova-gw/--ova-ws imported DIRECTLY via VBoxManage (no download).
## The one-time 'clean-live' snapshot bake (and dev-root, needed by the leak lane; harmless
## for inst) still runs on the live guests (printed as the next step) -- it needs a booted
## sysmaint session, not scriptable headless from here. Needs root.
rt_provision_pair() {
   local account version gw ws account_home
   account="$1"
   version="$2"
   gw="Whonix-Gateway-${desktop}"
   ws="Whonix-Workstation-${desktop}"
   rt_lock_account "${account}"
   rt_create_clean_account "${account}"
   if [ "${rt_origin}" = 'built' ]; then
      log info "importing built whonix pair under ${account} via direct VBoxManage import (gw='${ova_gw}' ws='${ova_ws}')"
      rt_import_built_pair "${account}" "${gw}" "${ws}"
   else
      ## dist-installer-cli runs the download AND import AS the target account
      ## (run_as_target_user), so the staging dir must be target-writable. Pin it to the
      ## target's OWN home (always writable by it) via --directory-prefix; otherwise it
      ## defaults to the invoker's home, which the target cannot write (mkdir fails). This
      ## matches what the sysmaint-invoker path does automatically, without needing sysmaint.
      account_home="$(getent passwd "${account}" | cut -d: -f6)"
      [ -n "${account_home}" ] || die "${SETUP_RC}" "cannot resolve home for '${account}'"
      log info "importing whonix ${version} pair under ${account} via ${DIST_INSTALLER_CLI} (as ${DIST_INSTALLER_USER}, prefix ${account_home})"
      ## Invoke as the sudo-capable invoker (NOT root -- dist-installer-cli refuses root);
      ## --user="${account}" is the INSTALL target (the leak account), distinct from the invoker.
      ## --noupdate/--noupgrade skip the installer's apt-update + "upgrade the OS first" gate.
      ## That gate guards a fresh VirtualBox INSTALL on a user machine; here VBox is already
      ## installed on the test host and we only re-import OVAs, so a pending host upgrade is
      ## irrelevant to the import -- not masked, just not this harness's concern.
      sudo -u "${DIST_INSTALLER_USER}" -- "${DIST_INSTALLER_CLI}" --guest=whonix --guest-version="${version}" \
         --interface="${interface}" --non-interactive --user="${account}" \
         --directory-prefix="${account_home}/dist-installer-cli-download" \
         --noupdate --noupgrade --no-boot --import-only=both --destroy-existing-guest \
         || die "${SETUP_RC}" "dist-installer-cli import failed for whonix ${version}"
   fi
   ## Apply the firmware to BOTH freshly-imported VMs while powered off, AS the account (VBox state
   ## is per-$HOME; rt_provision_pair runs as root), so the one-time clean-live snapshot captures it.
   ## Whonix is BIOS-only (forced in main): a prebuilt OVA's firmware cannot be cleanly re-applied
   ## beyond a plain modifyvm -- enrolling Secure Boot keys (inituefivarstore) would WIPE the
   ## installed pair's NVRAM/MOK and brick it, so non-bios whonix firmware is rejected upstream.
   ## Forward VBOXMANAGE explicitly (sudo env_reset strips it) so dm-vbox-firmware uses the SAME
   ## binary the import + marker ops use, not a stray stock VBoxManage.
   sudo -u "${account}" -- env "VBOXMANAGE=${VBOXMANAGE}" "${DM_VBOX_FIRMWARE}" "${gw}" "${firmware}"
   sudo -u "${account}" -- env "VBOXMANAGE=${VBOXMANAGE}" "${DM_VBOX_FIRMWARE}" "${ws}" "${firmware}"
   rt_set_pair_version "${account}" "${gw}" "${version}"
   rt_set_pair_version "${account}" "${ws}" "${version}"
   log info "pair ${version} imported + firmware '${firmware}' applied + version-pinned under ${account}"
   log info "NEXT (one-time, per VM, in a booted sysmaint session): run 'dev-root force' (needed by the leak lane; harmless for inst), power off, then '${VBOXMANAGE} snapshot <vm> take clean-live' so dm-whonix-pair restore_fresh has a pristine, root-capable pair"
}

## Marker recording a kept run's staged ISO dir (the VM still has the ISO attached), so
## rt_eph_reclaim removes exactly that dir. Lives in the ROOT-ONLY state dir: root must
## never write into, or read from, a home the unprivileged account controls (a planted
## symlink would redirect root's write; a FIFO would hang the EXIT trap under the lock).
## Sets rt_marker.
rt_kept_marker() {
   rt_state_dir
   rt_marker="${rt_statedir}/kept-$1.staged"
}

## A kept VM must outlive this run. Under any systemd unit (systemd-run, a durable launcher)
## stopping the unit kills its whole cgroup, the kept VM's VBox processes included, so move
## the account's processes into a transient scope of their own. rt_eph_reclaim's per-uid
## kill empties the scope, which systemd then drops. An account with no running process
## has nothing a unit stop could kill, so its on-disk state stays keepable. Returns 1
## only when running processes cannot be moved.
rt_detach_kept_vm() {
   local account scope
   account="$1"
   scope="dm-release-test-kept-${account}-$$.scope"
   local -a pids=()
   mapfile -t pids < <(pgrep --uid "${account}" || true)
   if [ "${#pids[@]}" -eq 0 ]; then
      log notice "kept run: account '${account}' has no running processes -- keeping its on-disk state only"
      return 0
   fi
   if ! busctl call org.freedesktop.systemd1 /org/freedesktop/systemd1 \
         org.freedesktop.systemd1.Manager StartTransientUnit 'ssa(sv)a(sa(sv))' \
         "${scope}" fail 1 PIDs au "${#pids[@]}" "${pids[@]}" 0 >/dev/null; then
      log error "kept run: cannot move the processes of '${account}' into '${scope}' -- the kept VM dies as soon as this run's unit or session ends"
      return 1
   fi
   log notice "kept run: VM processes of '${account}' moved into '${scope}', independent of this run"
}

## EXIT-trap handler: remove the ephemeral account if one was created. Single
## cleanup path, so an abort anywhere after creation still reclaims it -- unless the
## run FAILED and DM_RELEASE_TEST_KEEP_FAILED=1, which keeps it for inspection. A run is
## kept only once its staged-ISO marker is written AND its VM is detached from this run;
## otherwise it is torn down like any other, never reported as kept. The marker is
## written first, in a subshell: a die (unusable state dir) inside this EXIT trap would
## otherwise end the trap before teardown, orphaning an already-detached VM.
rt_eph_cleanup() {
   local rc=$?
   if [ -n "${eph_account}" ] && [ "${rc}" -ne 0 ] && [ "${DM_RELEASE_TEST_KEEP_FAILED}" = '1' ]; then
      local keepable='true'
      if [ -n "${rt_staged_dir}" ] && ! (
            rt_kept_marker "${eph_account}"
            printf '%s\n' "${rt_staged_dir}" > "${rt_marker}"
         ); then
         log error "cannot record the kept staged ISO dir '${rt_staged_dir}'"
         keepable='false'
      fi
      if [ "${keepable}" = 'true' ] && rt_detach_kept_vm "${eph_account}"; then
         log notice "kept FAILED run for inspection: account '${eph_account}', VM left running with its network unplugged (sudo -u ${eph_account} ${VBOXMANAGE} list runningvms). The next ephemeral run reclaims it; DM_RELEASE_TEST_KEEP_FAILED=0 disables keeping."
         return 0
      fi
      log error "cannot keep the FAILED run of '${eph_account}' for inspection -- tearing it down"
   fi
   ## Reap the per-run built-ISO staging dir first, on ANY exit (error return, signal) and
   ## independent of the eph account -- it holds only files this run created.
   if [ -n "${rt_staged_dir}" ]; then
      safe-rm --recursive --force -- "${rt_staged_dir}" 2>/dev/null || true
      rt_staged_dir=""
   fi
   [ -n "${eph_account}" ] || return 0
   rt_eph_reclaim "${eph_account}"
}

## Reclaim every OTHER eph-inst-* account whose lock is free: every ephemeral run holds
## its account lock for its whole life, so a free lock means a leftover (a kept failed
## run or a crash), never a live run. Bounds kept VMs to the most recent failure.
rt_sweep_eph_leftovers() {
   local current other lockfile
   current="$1"
   ## Validate both dirs here, OUTSIDE the "( ... ) || true" below, so a die aborts the run.
   rt_lock_dir
   rt_state_dir
   while IFS= read -r other; do
      [ "${other}" = "${current}" ] && continue
      lockfile="${rt_lockdir}/dm-release-test-${other}.lock"
      (
         exec {sweep_fd}>"${lockfile}" || exit 0
         flock --nonblock "${sweep_fd}" || exit 0
         log notice "reclaiming leftover ephemeral account '${other}'"
         rt_eph_reclaim "${other}"
      ) || true
   done < <(getent passwd | cut -d: -f1 | grep -- '^eph-inst-' || true)
}

## Remove an ephemeral account and everything it owns: VirtualBox state (incl. a kept
## run's still-running VM), processes, home, and a kept run's staged ISO dir.
rt_eph_reclaim() {
   local account marker kept_dir
   account="$1"
   ## Reclaim runs inside the EXIT trap, where a die would skip the teardown below:
   ## an unusable state dir only loses the kept-ISO lookup, never the account removal.
   marker=""
   if ( rt_state_dir ) >/dev/null 2>&1; then
      rt_kept_marker "${account}"
      marker="${rt_marker}"
   else
      log warn "state dir unusable -- a kept staged ISO dir of '${account}' cannot be located"
   fi
   kept_dir=""
   if [ -n "${marker}" ] && [ -f "${marker}" ]; then
      kept_dir="$(cat -- "${marker}")"
   fi
   "${IMAGE_TEST_GC}" "${account}" || true
   ## A VBoxSVC/VBoxXPCOMIPCD owned by the account lingers after the VM stops and
   ## holds userdel open (userdel REFUSES while any process still has the uid).
   ## SIGKILL the account's processes and POLL until they are actually gone -- a
   ## fixed settle guesses wrong (the daemon outlived a 2s sleep), so userdel then
   ## failed and leaked the account. Bounded by EPH_CLEANUP_SETTLE so a wedged
   ## reaper cannot hang cleanup; re-send the kill each poll in case a child respawned.
   local waited=0
   pkill --kill --uid "${account}" 2>/dev/null || true
   while pgrep --uid "${account}" >/dev/null 2>&1; do
      if [ "${waited}" -ge "${EPH_CLEANUP_SETTLE}" ]; then
         break
      fi
      sleep 1
      waited=$(( waited + 1 ))
      pkill --kill --uid "${account}" 2>/dev/null || true
   done
   if ! userdel --remove -- "${account}"; then
      log warn "userdel '${account}' failed -- reap stray processes of that account and 'userdel --remove' it manually"
   fi
   ## Only a dir this harness staged (ISO_DIR/.built-*): the marker sits in a home the
   ## account owned, so never trust it as an arbitrary path.
   case "${kept_dir}" in
      "${ISO_DIR}"/.built-*)
         [[ "${kept_dir}" == *'/../'* ]] || safe-rm --recursive --force -- "${kept_dir}" 2>/dev/null || true
         ;;
   esac
   if [ -n "${marker}" ]; then
      safe-rm --force -- "${marker}" 2>/dev/null || true
   fi
   rt_refresh_fleet
}

## Publish one lane's verdict to the results plane and print a summary line. The
## results subtree carries guest, interface AND version so lxqt and cli (or two
## versions) never collide on one path.
rt_publish_result() {
   local guest_name version account mode rc shot outdir verdict tok lane_fw
   local -a pub_expect=()
   local -a pub_stderr=()
   guest_name="$1"
   version="$2"
   account="$3"
   mode="$4"
   rc="$5"
   ## shot: optional screenshot path for the results plane ('' when none, e.g. a
   ## download failure before any VM, or the packet-based whonix lane).
   shot="$6"
   shift 6

   ## rc 0 = PASS; the reserved SETUP/inconclusive code 2 = INCONCLUSIVE (a provisioning
   ## gap or inconclusive probe -- NOT a leak); any other non-zero (incl dm-whonix-pair
   ## FAIL_RC=5) = FAIL. The publisher derives the same verdict from rc for result.json
   ## (one source); computed here only for the console line below.
   verdict="$(image_test_verdict_from_rc "${rc}")"
   for tok in "$@"; do
      pub_expect+=( --expect "${tok}" )
   done
   ## A lane may hand us the failed check's output (rt_check_log) to publish as the
   ## step's stderr tail, so the run record explains WHY it failed. Consumed once.
   if [ -n "${rt_check_log:-}" ] && [ -s "${rt_check_log}" ]; then
      pub_stderr=( --step-stderr-file "${rt_check_log}" )
   fi
   rt_check_log=""
   ## The ISO sha256 (set by the lane via rt_artifact_sha256) identifies the EXACT artifact
   ## under test -- without it a downloaded run's result.json digest is null and the exact ISO
   ## is unidentifiable. Consumed once, like rt_check_log; empty on a pre-ISO failure.
   local -a pub_sha=()
   if [ -n "${rt_artifact_sha256:-}" ]; then
      pub_sha=( --provenance-artifact-sha256 "${rt_artifact_sha256}" )
   fi
   rt_artifact_sha256=""
   ## localRepo provenance block (set by the inst lane via rt_local_repo_json on a --local-repo
   ## run): the exact local build the verdict applies to. Consumed once; empty = a published-repo
   ## run (the emitter then omits the key entirely).
   local -a pub_local_repo=()
   if [ -n "${rt_local_repo_json:-}" ]; then
      pub_local_repo=( --provenance-local-repo "${rt_local_repo_json}" )
   fi
   rt_local_repo_json=""
   ## Firmware-lane evidence (set by the install lane via rt_fw_*): proof of the booted lane for
   ## the results plane's firmware panel. Consumed once. Empty detected = not captured.
   local -a pub_fw=()
   if [ -n "${rt_fw_detected:-}" ] || [ -n "${rt_fw_evidence:-}" ]; then
      pub_fw=( --env-firmware-declared "${rt_fw_declared:-}" \
         --env-firmware-detected "${rt_fw_detected:-}" \
         --env-firmware-evidence "${rt_fw_evidence:-}" )
      if [ "${rt_fw_match:-}" = "true" ] || [ "${rt_fw_match:-}" = "false" ]; then
         pub_fw+=( --env-firmware-match "${rt_fw_match}" )
      fi
   fi
   rt_fw_declared=""; rt_fw_detected=""; rt_fw_evidence=""; rt_fw_match=""
   ## Firmware is part of the run identity. For the Calamares INSTALL lane a BIOS install lays
   ## down a BIOS-boot partition and an EFI one an ESP -- a different screenshot sequence + golden
   ## set the overview must not collapse onto one matrix row (run_key is lane-derived). The whonix
   ## lanes are BIOS-only (dm-vbox-firmware applies bios to the imported pair at provision), so the
   ## suffix is always -bios there -- a stable, accurate label (never a non-bios firmware the pair
   ## cannot actually have).
   lane_fw=""
   case "${mode}" in
      calamares-install | whonix-pair | whonix-func)
         lane_fw="-${firmware}"
         ;;
   esac
   ## The whonix guest runs two lanes (inst vs leak) with no firmware axis, so WITHOUT a lane
   ## component both would publish to the same guest-interface cell and clobber each other.
   ## A lane sets rt_lane_key (inst|leak); fold it in as its own component. Empty (the
   ## kicksecure install lane) -> no component, so existing kicksecure cells are unchanged.
   ## Consumed once.
   local lane_sfx=""
   [ -n "${rt_lane_key:-}" ] && lane_sfx="-${rt_lane_key}"
   rt_lane_key=""
   ## origin=downloaded: this lane downloads + signature-verifies the OFFICIAL
   ## release image, it does not build it. lane = guest-interface[-lane][-firmware] so the
   ## site groups lxqt vs cli, inst vs leak, distinct versions, AND distinct firmware as
   ## separate cells. A publish failure must NOT change the TEST verdict: keep rc, log it,
   ## and report the lane's real result on the console line (the results plane simply
   ## has no entry for this run -- NO-DATA on the site, never a faked verdict).
   outdir="$(image_test_results_publish "${RESULTS_ROOT}" "${RESULTS_OWNER}" \
      "${guest_name}-${interface}${lane_sfx}${lane_fw}-${version//./-}" "${account}" "${mode}" \
      "${rc}" "${shot}" \
      --lane "${guest_name}-${interface}${lane_sfx}${lane_fw}" --version "${version}" \
      --builder dm-release-test --origin "${rt_origin}" \
      "${pub_expect[@]}" "${pub_stderr[@]}" "${pub_sha[@]}" "${pub_fw[@]}" "${pub_local_repo[@]}")" \
      || { log warn "results publish failed for ${guest_name} ${interface} ${version} (verdict ${verdict} preserved)"; outdir='(publish-failed)'; }
   printf '%s\n' \
      "${me}: ${guest_name} ${interface} ${version} -- ${verdict} (rc=${rc}) -> ${outdir}"
}

## ---------------------------------------------------------------------------
## lanes
## ---------------------------------------------------------------------------

## Resolve the coreboot install run's extra env + flag (TASK B helper; unit-tested by
## dm-release-test-tests via source). Sets cb_env (a VAR=VAL list spliced into the sudo'd
## install's `env` prefix) and cb_arg (the --coreboot-rom flag) from coreboot_rom + the
## patched-VBoxManage selector. A no-op (both empty) without --coreboot-rom; dies if
## --coreboot-rom was given but NO patched VBoxManage can be resolved -- the stock VBoxManage
## silently IGNORES CorebootRom, so letting it run would boot VBox's own EFI and pass a wrong
## subject. DASHARO_VBOX_BIN (a bin dir) is preferred; a non-default VBOXMANAGE is the fallback.
rt_resolve_coreboot() {
   cb_env=()
   cb_arg=()
   [ -n "${coreboot_rom}" ] || return 0
   cb_arg=( --coreboot-rom "${coreboot_rom}" )
   if [ -n "${DASHARO_VBOX_BIN}" ] && [ -x "${DASHARO_VBOX_BIN}/VBoxManage" ]; then
      ## A source-built VBoxManage resolves its shared libs from its own bin dir.
      cb_env=(
         "VBOXMANAGE=${DASHARO_VBOX_BIN}/VBoxManage"
         "LD_LIBRARY_PATH=${DASHARO_VBOX_BIN}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
      )
   elif [ "${VBOXMANAGE}" != 'VBoxManage' ]; then
      cb_env=( "VBOXMANAGE=${VBOXMANAGE}" )
   else
      die "${SETUP_RC}" "--coreboot-rom needs the patched CorebootRom-aware VBoxManage: set DASHARO_VBOX_BIN to its bin dir or VBOXMANAGE to its path"
   fi
}

rt_lane_kicksecure() {
   local account version iso pass_file vmname rc shot_dir shot_arg check_log
   local -a checks_arg=()
   local -a keep_arg=()
   local -a mok_arg=()
   local -a cb_env=()
   local -a cb_arg=()

   account="$1"
   version="$2"
   ## Resolve the opt-in coreboot firmware swap up front (fail fast on a missing patched
   ## VBoxManage, before the ~30 min install). A no-op on the normal lanes.
   rt_resolve_coreboot

   ## Acquire the EXACT resolved version (pin it; never re-resolve in the lane),
   ## and FAIL the lane if the download/verification fails -- never fall through
   ## to an install with an empty --iso and publish a false PASS (errexit is off
   ## inside a function called as `... || rc=$?`, so check explicitly).
   rc=0
   if [ -n "${local_iso}" ]; then
      ## Built-ISO lane: STAGE the ISO into the account-readable ISO_DIR -- a build commonly
      ## sits under a 0700 home the unprivileged install account cannot traverse, so root
      ## copies it out (a+r). (The run is already serialized on the fixed account in main.)
      ## errexit is OFF in this lane (called `... || rc=$?`), so every staging step is checked
      ## explicitly: a silent mkdir/cp failure would install a missing/truncated ISO and
      ## mis-attribute the result to the install rather than to staging.
      if ! mkdir --parents -- "${ISO_DIR}"; then
         log error "cannot create ISO staging dir '${ISO_DIR}'"
         return "${SETUP_RC}"
      fi
      ## Stage into a PER-RUN subdir (reaped on ANY exit by rt_eph_cleanup): a unique dir
      ## cannot collide with -- or clobber -- a same-basename downloaded ISO already in
      ## ISO_DIR, and whole-dir removal only ever touches files this run created. No .part/mv
      ## dance needed: a failed cp returns before install and the trap reaps the dir.
      if ! rt_staged_dir="$(mktemp --directory -- "${ISO_DIR}/.built-XXXXXX")"; then
         log error "cannot create per-run ISO staging dir under '${ISO_DIR}'"
         return "${SETUP_RC}"
      fi
      if ! chmod a+rx -- "${ISO_DIR}" "${rt_staged_dir}"; then
         log error "cannot make ISO staging dirs readable"
         return "${SETUP_RC}"
      fi
      iso="${rt_staged_dir}/${local_iso##*/}"
      if ! cp -- "${local_iso}" "${iso}"; then
         log error "staging copy of '${local_iso}' failed"
         return "${SETUP_RC}"
      fi
      if ! chmod a+r -- "${iso}"; then
         log error "cannot make staged ISO '${iso}' readable"
         return "${SETUP_RC}"
      fi
   else
      iso="$("${ISO_DOWNLOAD}" --project kicksecure --vmname Kicksecure \
         --desktop "${desktop}" --channel "${channel}" --version "${version}" \
         --output-dir "${ISO_DIR}" --cert "${CERT_PATH}")" || rc=$?
      if [ "${rc}" -ne 0 ]; then
         log error "iso-download failed (rc=${rc}) for kicksecure '${version}' -- not installing"
         rt_publish_result kicksecure "${version}" "${account}" calamares-install "${rc}" "" Kicksecure
         return "${rc}"
      fi
   fi

   ## errexit is OFF in this lane (called `... || rc=$?`), so a failed account-owned mktemp
   ## would silently yield an empty path and run the install with a broken --passphrase-file
   ## "" / --shot-dir "" / --check-log "". Check each explicitly (like the built-ISO staging
   ## guards above) and abort INCONCLUSIVE (SETUP_RC) before the install.
   ## Disposable LUKS passphrase for the install, readable only by the account.
   if ! pass_file="$(sudo -u "${account}" -- mktemp --tmpdir "dm-release-test-pass.XXXXXX")"; then
      log error "cannot allocate the install passphrase file"
      rt_publish_result kicksecure "${version}" "${account}" calamares-install "${SETUP_RC}" "" Kicksecure
      return "${SETUP_RC}"
   fi
   printf '%s\n' "release-test-${version}" | sudo -u "${account}" -- tee -- "${pass_file}" >/dev/null
   ## Account-owned shot DIR; dm-calamares-install drops milestone shots (NN-<milestone>.png,
   ## the install "full story") here, and image_test_results_publish publishes the whole
   ## ordered sequence. Account-owned + root forwards each path no-follow to the emitter.
   if ! shot_dir="$(sudo -u "${account}" -- mktemp --directory --tmpdir "dm-release-test-shots.XXXXXX")"; then
      log error "cannot allocate the install milestone-shot directory"
      sudo -u "${account}" -- safe-rm --force -- "${pass_file}" 2>/dev/null || true
      rt_publish_result kicksecure "${version}" "${account}" calamares-install "${SETUP_RC}" "" Kicksecure
      return "${SETUP_RC}"
   fi
   ## Account-owned sink for a FAILED release check's own in-guest output, so the run
   ## record explains WHY it failed (otherwise lost on power-off).
   if ! check_log="$(sudo -u "${account}" -- mktemp --tmpdir "dm-release-test-checklog.XXXXXX")"; then
      log error "cannot allocate the install check-log sink"
      sudo -u "${account}" -- safe-rm --recursive --force -- "${pass_file}" "${shot_dir}" 2>/dev/null || true
      rt_publish_result kicksecure "${version}" "${account}" calamares-install "${SETUP_RC}" "" Kicksecure
      return "${SETUP_RC}"
   fi
   ## Account-owned sink for the firmware-lane evidence the install captures in-guest.
   if ! firmware_evidence_file="$(sudo -u "${account}" -- mktemp --tmpdir "dm-release-test-fwevidence.XXXXXX")"; then
      log error "cannot allocate the firmware-evidence sink"
      sudo -u "${account}" -- safe-rm --recursive --force -- "${pass_file}" "${shot_dir}" "${check_log}" 2>/dev/null || true
      rt_publish_result kicksecure "${version}" "${account}" calamares-install "${SETUP_RC}" "" Kicksecure
      return "${SETUP_RC}"
   fi

   vmname="Kicksecure-release-${version//./-}"
   if [ "${run_checks}" = 'true' ]; then
      checks_arg=( --checks )
   fi
   if [ "${DM_RELEASE_TEST_KEEP_FAILED}" = '1' ] && [ -n "${eph_account}" ]; then
      keep_arg=( --keep-failed )
   fi
   ## Secure Boot is only meaningful if the installed system's out-of-tree modules (tirdad,
   ## Guest Additions) are DKMS-signed and their MOK enrolled; otherwise they silently fail to
   ## load under enforced SB and the lane would pass while testing nothing. --mok-enroll runs the
   ## Calamares MOK setup (MOK_ENROLL=1 -> sign the modules) and enrolls the resulting cert, so
   ## the installed system boots under SB with its modules loading. Only the efi-secureboot lane.
   if [ "${firmware}" = 'efi-secureboot' ]; then
      mok_arg=( --mok-enroll )
      ## --mok-enroll's host-side MOK read escalates via the 'vbox-disk-extract-mok'
      ## privleap action (so the deliberately sudo-less runner needs no host sudo). That
      ## needs the runner's per-user privleap comm socket, but a runner account never logs
      ## in, so leapctl@<uid>.service never fires -- create it here (root; the action
      ## config's [allowed-users] Group=vboxusers permits it). Best-effort: mok_host_enroll
      ## fails loud later if the socket / action is genuinely missing.
      leapctl --create "${account}" >/dev/null 2>&1 \
         || log warn "leapctl --create '${account}' failed; --mok-enroll will fail if the privleap comm socket is absent (is the vbox-disk-extract-mok privleap action installed?)"
   fi

   ## cb_env (patched VBoxManage + LD_LIBRARY_PATH) rides the same `env` prefix as the session
   ## identity; cb_arg adds --coreboot-rom. Both empty on the normal lanes -> the argv is unchanged.
   rc=0
   sudo -u "${account}" -- "${rt_session_env[@]}" "${cb_env[@]}" "${DM_CALAMARES_INSTALL}" --vm "${vmname}" \
      --iso "${iso}" --passphrase-file "${pass_file}" --firmware "${firmware}" \
      --shot-dir "${shot_dir}" --check-log "${check_log}" \
      --firmware-evidence-file "${firmware_evidence_file}" \
      "${cb_arg[@]}" "${checks_arg[@]}" "${keep_arg[@]}" "${mok_arg[@]}" || rc=$?
   sudo -u "${account}" -- safe-rm --force -- "${pass_file}" || true

   ## Publish the milestone-shot DIR: the publisher enumerates the valid, non-empty
   ## *.png milestones (the install "full story") and skips anything else. An empty /
   ## never-powered-on dir yields no attachments -- the verdict still publishes. Always
   ## forward the dir; do NOT pre-filter here with a glob ([ -e ] follows a dangling
   ## symlink that sorts first and would drop the whole real sequence).
   shot_arg="${shot_dir}"
   ## Thread the failed check's output into the published step's stderr tail (empty
   ## file = a pass or a pre-check failure -> no tail).
   rt_check_log=""
   [ -s "${check_log}" ] && rt_check_log="${check_log}"
   ## Firmware-lane evidence (DETECTED=, MATCH=, then the probe command/output). Empty file =
   ## not captured -> no firmware panel. declared = the lane we asked to build/boot.
   rt_fw_declared=""; rt_fw_detected=""; rt_fw_evidence=""; rt_fw_match=""
   if [ -s "${firmware_evidence_file}" ]; then
      rt_fw_declared="${firmware}"
      rt_fw_detected="$(sed -n 's/^DETECTED=//p' "${firmware_evidence_file}" | head -1)"
      rt_fw_match="$(sed -n 's/^MATCH=//p' "${firmware_evidence_file}" | head -1)"
      rt_fw_evidence="$(tail -n +3 -- "${firmware_evidence_file}")"
   fi
   ## Record the ISO sha256 so the run is identifiable to the exact artifact (built OR
   ## downloaded). The staged built ISO and the downloaded ISO both land in "${iso}".
   rt_artifact_sha256=""
   if [ -n "${iso:-}" ] && [ -f "${iso}" ]; then
      rt_artifact_sha256="$(sha256sum -- "${iso}" | { read -r h _ ; printf '%s' "${h}" ; })" || rt_artifact_sha256=""
   fi
   rt_publish_result kicksecure "${version}" "${account}" calamares-install "${rc}" "${shot_arg}" Kicksecure
   sudo -u "${account}" -- safe-rm --recursive --force -- "${shot_dir}" "${check_log}" "${firmware_evidence_file}" 2>/dev/null || true
   ## The per-run staged ISO dir (rt_staged_dir) is reaped by rt_eph_cleanup on exit.
   return "${rc}"
}

## Shared whonix-pair preamble (both lanes): serialize on the shared persistent account +
## verify the imported pair carries the REQUESTED version marker before running. The pair
## must already be imported under ${account} (rt_provision_pair) with a 'clean-live'
## snapshot on each VM; dm-whonix-pair fails closed if the snapshot is absent. Fail CLOSED
## on a stale/wrong-version/markerless pair (a provisioning gap, SETUP_RC) so a run never
## mislabels a verdict for the wrong version. Reads both VMs (a half-reprovisioned pair with
## one stale VM is caught too). $1=account $2=version $3=gw $4=ws.
rt_whonix_pair_require() {
   local account version gw ws gw_ver ws_ver reprovision gw_fw_actual ws_fw_actual
   account="$1"
   version="$2"
   gw="$3"
   ws="$4"
   rt_lock_account "${account}"
   gw_ver="$(rt_pair_version "${account}" "${gw}")" || gw_ver=""
   ws_ver="$(rt_pair_version "${account}" "${ws}")" || ws_ver=""
   ## --source is mandatory, so the recovery command must carry it (and, for a built pair, the
   ## --ova pair); a source-less hint would fail immediately when pasted.
   if [ "${rt_origin}" = 'built' ]; then
      reprovision="${me} whonix ${interface} --lane ${lane} --source built --ova-gw <gw.ova> --ova-ws <ws.ova> --version ${version} --provision"
   else
      reprovision="${me} whonix ${interface} --lane ${lane} --source official --version ${version} --provision"
   fi
   rt_pair_version_ok "${version}" "${gw_ver}" "${ws_ver}" \
      || die "${SETUP_RC}" "whonix pair version mismatch: requested '${version}', GW marked '${gw_ver}', WS marked '${ws_ver}' -- re-provision with '${reprovision}' or pass the matching --version"
   ## The published -${firmware} cell must match the pair's ACTUAL firmware, not just the requested
   ## value (firmware is applied at --provision, not re-applied per test run). whonix is BIOS-only,
   ## so verify both VMs really carry BIOS; a stale EFI pair is INCONCLUSIVE, never a mislabeled
   ## '-bios' pass (grok/codex firmware-honesty finding).
   if [ "${firmware}" = 'bios' ]; then
      gw_fw_actual="$(sudo -u "${account}" -- "${VBOXMANAGE}" showvminfo "${gw}" --machinereadable 2>/dev/null | sed -n 's/^firmware="\(.*\)"$/\1/p')"
      ws_fw_actual="$(sudo -u "${account}" -- "${VBOXMANAGE}" showvminfo "${ws}" --machinereadable 2>/dev/null | sed -n 's/^firmware="\(.*\)"$/\1/p')"
      { [ "${gw_fw_actual}" = 'BIOS' ] && [ "${ws_fw_actual}" = 'BIOS' ]; } \
         || die "${SETUP_RC}" "whonix pair firmware mismatch: lane is bios-only but GW firmware='${gw_fw_actual}' WS firmware='${ws_fw_actual}' -- re-provision the pair (firmware is applied at --provision), not publishing a mislabeled -bios cell"
   fi
}

## leak lane: the anon-leak-test battery on the dedicated persist-leak- pair.
rt_lane_whonix_leak() {
   local account version gw ws rc shot_dir shot_arg
   account="$1"
   version="$2"
   gw="Whonix-Gateway-${desktop}"
   ws="Whonix-Workstation-${desktop}"
   rt_whonix_pair_require "${account}" "${version}" "${gw}" "${ws}"
   rt_lane_key='leak'
   ## Account-owned shot DIR: dm-whonix-pair drops the leak run's milestone story here
   ## (NN-<milestone>.png shots + NN-<milestone>.card.txt text cards -- boot -> Tor -> battery
   ## -> canary -> verdict), and image_test_results_publish publishes the whole ordered
   ## sequence, exactly like the Calamares install lane's "full story". Account-owned so the
   ## unprivileged dm-whonix-pair can write it and root forwards each path no-follow to the
   ## emitter. errexit is OFF in this lane (called `... || rc=$?`), so a failed mktemp would
   ## silently run with `--shot-dir ""` (a valid but storyless run); check explicitly and abort
   ## INCONCLUSIVE (SETUP_RC) so a provisioning gap never hides as a storyless pass -- mirrors the
   ## inst lane's check-log guard.
   if ! shot_dir="$(sudo -u "${account}" -- mktemp --directory --tmpdir "dm-release-test-whonix-leak-shots.XXXXXX")"; then
      log error "cannot allocate the whonix leak milestone-shot directory"
      rt_publish_result whonix "${version}" "${account}" whonix-pair "${SETUP_RC}" "" tor-confirm
      return "${SETUP_RC}"
   fi
   rc=0
   sudo -u "${account}" -- "${rt_session_env[@]}" "${DM_WHONIX_PAIR}" --mode leak --shot-dir "${shot_dir}" --gw "${gw}" --ws "${ws}" || rc=$?
   ## Publish the milestone-shot DIR (empty/never-started -> no attachments, verdict still
   ## publishes); forward the dir unconditionally (see the kicksecure lane's note).
   shot_arg="${shot_dir}"
   rt_publish_result whonix "${version}" "${account}" whonix-pair "${rc}" "${shot_arg}" tor-confirm
   sudo -u "${account}" -- safe-rm --recursive --force -- "${shot_dir}" 2>/dev/null || true
   return "${rc}"
}

## Resolve the build/admin user's home (holds ~/derivative-maker + ~/derivative-binary). Test seam
## DM_SOURCE_HOME overrides; else the install/build user's home.
rt_source_home() {
   if [ -n "${DM_SOURCE_HOME}" ]; then
      printf '%s' "${DM_SOURCE_HOME}"
      return 0
   fi
   getent passwd "${DIST_INSTALLER_USER}" | cut -d: -f6
}

## The source sha anchoring a localRepo provenance record: the BUILD-TIME source state recorded when
## the local packages were built/signed (~/derivative-binary/dm-source-state's first line). The
## checkout's live git HEAD is deliberately NOT used -- a checkout that advanced after the build no
## longer matches the packages sitting in the local apt repo, so HEAD would misattribute the result
## to a newer commit. No build-time state -> empty (recorded honestly as "", never a guessed sha).
rt_local_repo_source_sha() {
   local state line sha=''
   state="$(rt_source_home)/derivative-binary/dm-source-state"
   if [ -r "${state}" ]; then
      ## dm-source-state's first line is 'Source-Commit: <sha>' (sign-and-tag), or
      ## 'Source-Commit: unrecorded' when the build did not record it. Extract the VALUE
      ## (publishing the whole label line would be an invalid commit id); the unrecorded
      ## sentinel -> empty (honest "").
      line="$(head -n1 -- "${state}" 2>/dev/null || true)"
      case "${line}" in
         'Source-Commit: '*)
            sha="${line#Source-Commit: }"
            [ "${sha}" = 'unrecorded' ] && sha=''
            ;;
      esac
   fi
   printf '%s' "${sha}"
}

## Generation id of the local apt repo under test: the sha256 of its Packages index. Captured BEFORE
## the guest upgrade (rt_lane_whonix_inst) and re-checked when building provenance, so provenance is
## bound to the generation the guest actually upgraded from. "" when the index is unreadable.
rt_local_repo_gen_id() {
   local deriv="$1" repo_path pkgs_file
   repo_path="$("${DM_SHARED_APT_REPO}" repo-path "${deriv}" 2>/dev/null || true)"
   pkgs_file="${repo_path}/dists/local/main/binary-amd64/Packages"
   [ -n "${repo_path}" ] && [ -r "${pkgs_file}" ] || return 0
   sha256sum -- "${pkgs_file}" 2>/dev/null | awk '{print $1}'
}

## Build the localRepo provenance JSON (host-side; no guest round-trip) for a --local-repo run:
## {derivative, repoPath, sourceSha, packages:[name=version,...]}. repoPath + the Packages index come
## from dm-shared-apt-repo repo-path (single source of the repo path -- never re-derive repo_parent
## here). gen_before is the pre-upgrade generation id (rt_local_repo_gen_id): if the repo's Packages
## changed since (a concurrent rebuild landed during the test window), the published versions may not
## be what the guest upgraded from, so provenance is OMITTED (return 1) rather than bound to the
## wrong generation -- CodeRabbit "omit when the tested generation cannot be verified". On a matching
## generation it emits the JSON on stdout; a Packages read gap degrades to an EMPTY packages list.
rt_build_local_repo_provenance() {
   local deriv="$1" gen_before="$2" repo_path pkgs_file sha pkgs_json gen_now
   repo_path="$("${DM_SHARED_APT_REPO}" repo-path "${deriv}" 2>/dev/null || true)"
   pkgs_file="${repo_path}/dists/local/main/binary-amd64/Packages"
   gen_now="$(rt_local_repo_gen_id "${deriv}")"
   if [ -z "${gen_before}" ] || [ -z "${gen_now}" ] || [ "${gen_before}" != "${gen_now}" ]; then
      return 1
   fi
   sha="$(rt_local_repo_source_sha)"
   if [ -n "${repo_path}" ] && [ -r "${pkgs_file}" ]; then
      pkgs_json="$(awk '/^Package: /{p=$2} /^Version: /{if(p!=""){print p"="$2; p=""}}' "${pkgs_file}" \
         | jq -R -s -c 'split("\n") | map(select(length>0))')"
   else
      pkgs_json='[]'
   fi
   jq -n -c \
      --arg deriv "${deriv}" \
      --arg repo "${repo_path}" \
      --arg sha "${sha}" \
      --argjson pkgs "${pkgs_json}" \
      '{derivative:$deriv, repoPath:$repo, sourceSha:$sha, packages:$pkgs}'
}

## inst lane: the functional release-check battery (>= the kicksecure coverage) run on the
## Workstation of a persist-inst- pair, after the Gateway's Tor bootstrap gate.
rt_lane_whonix_inst() {
   local account version gw ws rc check_log
   account="$1"
   version="$2"
   gw="Whonix-Gateway-${desktop}"
   ws="Whonix-Workstation-${desktop}"
   rt_whonix_pair_require "${account}" "${version}" "${gw}" "${ws}"
   rt_lane_key='inst'
   ## Account-owned sink for a FAILED release check's in-guest output, so the run record
   ## explains WHY it failed (mirrors the kicksecure lane's check-log handoff). Account-
   ## owned: the sudo'd dm-whonix-pair writes it, the root parent reads it to publish.
   ## errexit is OFF in this lane (called `... || rc=$?`), so a failed mktemp would yield
   ## check_log="" and run the battery with no diagnostic sink -- check explicitly and abort
   ## INCONCLUSIVE (SETUP_RC) before the battery, like the kicksecure lane's staging guards.
   if ! check_log="$(sudo -u "${account}" -- mktemp --tmpdir "dm-release-test-whonix-checklog.XXXXXX")"; then
      log error "cannot allocate the whonix functional-lane check-log sink"
      rt_publish_result whonix "${version}" "${account}" whonix-func "${SETUP_RC}" "" release-checks
      return "${SETUP_RC}"
   fi
   rc=0
   ## Map the guest desktop variant to dm-whonix-pair's battery edition: a cli guest has no
   ## desktop, so run the headless guestcontrol battery; every other interface (lxqt) uses the
   ## OCR real-session battery.
   local wp_interface='gui'
   [ "${interface}" = 'cli' ] && wp_interface='cli'
   ## --local-repo (gated to this lane in main) forwards to dm-whonix-pair, which attaches +
   ## enables the fast LOCAL apt repo so check 3 upgrades THIS build. Empty = published repos.
   ## Resolve the repo's SHARE HOST PATH here as ROOT (where dist_build_slot is set) and pass it
   ## down via --local-repo-base: the account-run attach in dm-whonix-pair otherwise re-derives a
   ## slot-less path and maps a DIFFERENT repo than the root-side provenance records (a false
   ## signal). repo-path prints <base>/aptrepo_local/<deriv>; strip to the base. On the non-slotted
   ## single-session host base == the derived default, so this is a no-op there.
   local -a lr_args=()
   if [ -n "${local_repo}" ]; then
      local lr_dir lr_base
      lr_dir="$("${DM_SHARED_APT_REPO}" repo-path "${local_repo}" 2>/dev/null || true)"
      lr_base="${lr_dir%/aptrepo_local/*}"
      ## The repo-path lookup runs HERE as root (where dist_build_slot is known). If it fails
      ## (empty) or returns an unexpected shape (no /aptrepo_local/<deriv> -> the strip is a no-op,
      ## lr_base == lr_dir), the account-run attach would re-derive a DIFFERENT (slot-less) path than
      ## the provenance records -- a verdict against the wrong repo. Fail INCONCLUSIVE (SETUP_RC)
      ## before the guest rather than attach a mismatched repo.
      if [ -z "${lr_dir}" ] || [ "${lr_base}" = "${lr_dir}" ]; then
         log error "repo-path lookup for ${local_repo} failed or had an unexpected shape ('${lr_dir}')"
         rt_publish_result whonix "${version}" "${account}" whonix-func "${SETUP_RC}" "" release-checks
         sudo -u "${account}" -- safe-rm --force -- "${check_log}" 2>/dev/null || true
         return "${SETUP_RC}"
      fi
      lr_args=( --local-repo "${local_repo}" --local-repo-base "${lr_base}" )
   fi
   ## Capture the local repo's generation id BEFORE the guest upgrade, so the provenance read below
   ## binds to the generation the guest actually upgraded from -- a concurrent rebuild landing in the
   ## test window otherwise swaps the published package versions under an unchanged verdict.
   local rt_local_repo_gen=""
   [ -n "${local_repo}" ] && rt_local_repo_gen="$(rt_local_repo_gen_id "${local_repo}")"
   sudo -u "${account}" -- "${rt_session_env[@]}" "${DM_WHONIX_PAIR}" --mode functional --interface "${wp_interface}" --check-log "${check_log}" "${lr_args[@]}" --gw "${gw}" --ws "${ws}" || rc=$?
   ## Thread a non-empty check-log into the published step's stderr tail (empty = a pass or a
   ## pre-check failure -> no tail). Consumed once by rt_publish_result.
   rt_check_log=""
   [ -s "${check_log}" ] && rt_check_log="${check_log}"
   ## HONEST provenance: on a --local-repo run record WHAT was delivered (derivative, host repoPath,
   ## build sourceSha, the Packages name=version list) as the result.json localRepo block, so the
   ## site shows the exact local build the verdict applies to. Host-side read (no guest round-trip);
   ## best-effort -- a read gap warns + publishes without the block rather than aborting the verdict.
   ## Consumed once by rt_publish_result; empty on a published-repo run (the key is then omitted).
   rt_local_repo_json=""
   if [ -n "${local_repo}" ]; then
      rt_local_repo_json="$(rt_build_local_repo_provenance "${local_repo}" "${rt_local_repo_gen}")" || rt_local_repo_json=""
      [ -n "${rt_local_repo_json}" ] \
         || log warn "could not record localRepo provenance for ${local_repo} for this test generation -- publishing without it"
   fi
   rt_publish_result whonix "${version}" "${account}" whonix-func "${rc}" "" release-checks
   sudo -u "${account}" -- safe-rm --force -- "${check_log}" 2>/dev/null || true
   return "${rc}"
}

## ---------------------------------------------------------------------------
## arg parsing + main
## ---------------------------------------------------------------------------

parse_args() {
   local -a positional=()
   while [ "$#" -gt 0 ]; do
      case "$1" in
         --source)
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "missing value for --source"
            ## Validate the value at PARSE time; the MANDATORY-presence + artifact-flag
            ## coupling is rt_resolve_origin's job in main (guest/lane known there).
            case "$2" in
               official | built)
                  source_mode="$2"
                  ;;
               *)
                  die "${SETUP_RC}" "--source must be official|built, got '$2'"
                  ;;
            esac
            shift 2
            ;;
         --channel)
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "missing value for --channel"
            channel="$2"
            shift 2
            ;;
         --version)
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "missing value for --version"
            version_override="$2"
            shift 2
            ;;
         --firmware)
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "missing value for --firmware"
            ## Validate at PARSE time: firmware is interpolated into the install lane's
            ## results subtree name + --lane, so an empty/garbage value would otherwise
            ## flow in (e.g. a malformed 'guest-interface--version' cell) before the
            ## downstream publisher's safe-name check. Reject anything but the known set.
            if firmware_valid "$2"; then
               firmware="$2"
               firmware_explicit="true"
            else
               die "${SETUP_RC}" "--firmware must be bios|efi|efi-secureboot, got '$2'"
            fi
            shift 2
            ;;
         --iso)
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "missing value for --iso"
            ## Reject an EMPTY value: an empty --iso cannot satisfy kicksecure --source built
            ## and must fail loud here, never read as "no artifact".
            [ -n "$2" ] || die "${SETUP_RC}" "empty value for --iso"
            local_iso="$2"
            shift 2
            ;;
         --ova-gw)
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "missing value for --ova-gw"
            [ -n "$2" ] || die "${SETUP_RC}" "empty value for --ova-gw"
            ## A newline/control char would split the one-token-per-line emit-argv output
            ## (mapfile) and inject extra VBoxManage args; a real OVA path carries none.
            case "$2" in
               *[[:cntrl:]]*)
                  die "${SETUP_RC}" "--ova-gw path contains a control character"
                  ;;
            esac
            ## Canonicalize to an ABSOLUTE path (lexical: -m does not require existence, so a
            ## missing file is still reported by the dedicated readability check, not here). A
            ## relative path passes the root-side `[ -f ]`/readability precheck relative to root's
            ## CWD but then fails in VBoxManage run as the account (different CWD) AFTER the import
            ## has already deleted the existing VM -- #814.
            ## Canonicalize to an ABSOLUTE path (lexical -m: existence not required, so a missing
            ## file is still reported by the dedicated readability check). -z + read -d '' so a
            ## TRAILING newline in a symlink target survives (command substitution would strip it,
            ## letting a crafted sibling through -- #814 / codex), then reject any control char on
            ## the resolved path (it would split the one-token-per-line emit-argv output).
            IFS= read -r -d '' ova_gw < <(realpath -mz -- "$2") \
               || die "${SETUP_RC}" "cannot canonicalize --ova-gw path '$2'"
            case "${ova_gw}" in
               *[[:cntrl:]]*)
                  die "${SETUP_RC}" "--ova-gw resolves to a path containing a control character"
                  ;;
            esac
            shift 2
            ;;
         --ova-ws)
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "missing value for --ova-ws"
            [ -n "$2" ] || die "${SETUP_RC}" "empty value for --ova-ws"
            case "$2" in
               *[[:cntrl:]]*)
                  die "${SETUP_RC}" "--ova-ws path contains a control character"
                  ;;
            esac
            IFS= read -r -d '' ova_ws < <(realpath -mz -- "$2") \
               || die "${SETUP_RC}" "cannot canonicalize --ova-ws path '$2'"
            case "${ova_ws}" in
               *[[:cntrl:]]*)
                  die "${SETUP_RC}" "--ova-ws resolves to a path containing a control character"
                  ;;
            esac
            shift 2
            ;;
         --coreboot-rom)
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "missing value for --coreboot-rom"
            [ -n "$2" ] || die "${SETUP_RC}" "empty value for --coreboot-rom"
            coreboot_rom="$2"
            shift 2
            ;;
         --lane)
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "missing value for --lane"
            ## Store raw; rt_effective_lane validates against the guest in main (the
            ## guest is a positional, not necessarily parsed yet).
            lane="$2"
            shift 2
            ;;
         --local-repo)
            [ "$#" -ge 2 ] || die "${SETUP_RC}" "missing value for --local-repo"
            case "$2" in
               kicksecure|whonix)
                  local_repo="$2"
                  ;;
               *)
                  die "${SETUP_RC}" "--local-repo must be kicksecure|whonix, got '$2'"
                  ;;
            esac
            shift 2
            ;;
         --checks)
            run_checks='true'
            shift
            ;;
         --dry-run)
            dry_run='true'
            shift
            ;;
         --provision)
            do_provision='true'
            shift
            ;;
         -h|--help)
            print_usage
            exit 0
            ;;
         --)
            shift
            break
            ;;
         -*)
            print_usage >&2
            die "${SETUP_RC}" "unknown option '$1'"
            ;;
         *)
            positional+=( "$1" )
            shift
            ;;
      esac
   done
   positional+=( "$@" )
   [ "${#positional[@]}" -eq 2 ] || { print_usage >&2; die "${SETUP_RC}" "GUEST and INTERFACE are required"; }
   guest="${positional[0]}"
   interface="${positional[1]}"
}

main() {
   local version stable bless_state account account_kind token

   parse_args "$@"

   rt_guest_valid "${guest}" || { print_usage >&2; die "${SETUP_RC}" "unsupported GUEST '${guest}'"; }
   ## --coreboot-rom is wired through the kicksecure Calamares lane only; fail CLOSED on any
   ## other guest rather than accept-then-silently-drop it (matches rt_resolve_coreboot's
   ## fail-closed stance -- the operator asked for a coreboot subject and must not get a normal one).
   if [ -n "${coreboot_rom}" ] && [ "${guest}" != 'kicksecure' ]; then
      print_usage >&2; die "${SETUP_RC}" "--coreboot-rom is kicksecure-only (got GUEST '${guest}')"
   fi
   ## whonix is BIOS-only: a prebuilt OVA is imported as-built and its firmware cannot be cleanly
   ## re-applied -- enrolling Secure Boot keys (inituefivarstore) would wipe the installed pair's
   ## NVRAM/MOK and brick it. Reject an EXPLICIT non-bios --firmware; default silently to bios (the
   ## efi-secureboot flagship is the kicksecure install lane, which handles firmware at install).
   if [ "${guest}" = 'whonix' ]; then
      if [ "${firmware_explicit}" = 'true' ] && [ "${firmware}" != 'bios' ]; then
         print_usage >&2; die "${SETUP_RC}" "whonix supports only --firmware bios (an imported OVA cannot be re-firmwared cleanly; efi-secureboot is the kicksecure lane)"
      fi
      firmware='bios'
   fi
   desktop="$(rt_desktop_token "${interface}")" || die "${SETUP_RC}" "unsupported INTERFACE '${interface}'"
   case "${channel}" in
      stable|developers)
         true
         ;;
      *)
         die "${SETUP_RC}" "unknown --channel '${channel}' (stable|developers)"
         ;;
   esac

   ## Resolve + validate the test lane now the guest is known. No default: whonix requires
   ## --lane inst|leak (both are real choices), kicksecure accepts only inst ('' -> inst).
   ## Capture into a temp first so a rejection still reports the RAW --lane the user passed
   ## (assigning the failed substitution straight into lane would blank it before the die).
   local eff_lane
   eff_lane="$(rt_effective_lane "${guest}" "${lane}")" \
      || { print_usage >&2; die "${SETUP_RC}" "whonix requires --lane inst|leak; kicksecure accepts only inst (got guest='${guest}' lane='${lane}')"; }
   lane="${eff_lane}"

   ## --local-repo is the whonix cli INST lane's fast local-upgrade seam: repo-add-local needs
   ## root, which only the split-free CLI edition's `user` has (the lxqt lane's user cannot, and
   ## its check 3 runs in a sysmaint session -- a tracked follow-up, not this lane). Reject any
   ## other guest/interface/lane fail-closed (SETUP_RC) so a misdirected flag never silently
   ## downgrades to a published-repo run while implying it tested the local build.
   if [ -n "${local_repo}" ] \
      && { [ "${guest}" != 'whonix' ] || [ "${interface}" != 'cli' ] || [ "${lane}" != 'inst' ]; }; then
      print_usage >&2
      die "${SETUP_RC}" "--local-repo is valid only for the whonix cli inst lane (got guest='${guest}' interface='${interface}' lane='${lane}')"
   fi

   ## Resolve + couple the MANDATORY --source to the artifact flags, deriving the origin
   ## (downloaded|built). rt_resolve_origin rejects an absent/invalid source and any
   ## source+artifact mismatch; the per-guest FS checks + version resolution follow here.
   rt_origin="$(rt_resolve_origin "${source_mode}" "${guest}" "${local_iso}" "${ova_gw}" "${ova_ws}")" \
      || { print_usage >&2; die "${SETUP_RC}" "invalid --source/artifact combination (source='${source_mode}' guest='${guest}' iso='${local_iso}' ova-gw='${ova_gw}' ova-ws='${ova_ws}'): --source is mandatory (official|built); official forbids --iso/--ova-gw/--ova-ws; kicksecure built needs --iso; whonix built needs --ova-gw + --ova-ws"; }

   if [ "${rt_origin}" = 'built' ] && [ "${guest}" = 'kicksecure' ]; then
      ## Built-ISO lane (kicksecure): no download. A disposable eph-inst-kicksecure-built
      ## account installs it; the version is a results-matrix LABEL only (git-describe, not a
      ## release token).
      [ -f "${local_iso}" ] || die "${SETUP_RC}" "--iso '${local_iso}' is not a regular file"
      ## The filename's desktop must match INTERFACE, else the lane would publish (say) a
      ## CLI build into the lxqt results cell.
      local iso_base
      iso_base="${local_iso##*/}"
      [ "${iso_base#"Kicksecure-${desktop}-"}" != "${iso_base}" ] \
         || die "${SETUP_RC}" "--iso name does not match interface '${interface}' (expected Kicksecure-${desktop}-<version>.<arch>.iso)"
      version="${version_override}"
      [ -n "${version}" ] || version="$(rt_build_version_from_iso "${local_iso}")" \
         || die "${SETUP_RC}" "could not derive a version label from --iso '${local_iso}' -- pass --version"
      rt_build_version_ok "${version}" \
         || die "${SETUP_RC}" "built version label '${version}' is not path-safe (<=64 of [A-Za-z0-9.+_-], no leading '-', no '/' or '..')"
      rt_version_build_distinct "${version}" \
         || die "${SETUP_RC}" "built label '${version}' looks like a release version -- use a build-distinct label (the git-describe <ver>-g<sha>) so it cannot overwrite an official-release cell"
      rt_version_fw_distinct "${firmware}" "${version}" \
         || die "${SETUP_RC}" "built label '${version}' with --firmware ${firmware} folds into another firmware's cell -- pick a label that does not begin with another firmware's suffix"
      account='eph-inst-'"${guest}"'-built'
      account_kind='prebless'
      stable='(local build)'
   elif [ "${rt_origin}" = 'built' ]; then
      ## Built-pair lane (whonix): the --ova pair is a PROVISION input. --provision imports it
      ## DIRECTLY via VBoxManage (rt_provision_pair; no dist-installer-cli, no download) + pins
      ## the build label; a TEST run carries NO ovas and only verifies the pinned marker -- the
      ## SAME shape as the official lane (a pre-provisioned pair). The pair lives under the same
      ## persistent account the official lane uses (leak -> persist-leak, inst -> persist-inst);
      ## a build-distinct --version LABEL (REQUIRED; no OVA-filename derivation -- out of scope)
      ## distinguishes its results cell AND pins the marker each run verifies, so a built run can
      ## never overwrite an official-release cell or boot a stale/official pair. NOTE: the OPERATOR
      ## is responsible for passing the Gateway OVA to --ova-gw and the Workstation OVA to --ova-ws
      ## for this INTERFACE -- a built OVA filename is arbitrary (binary_image_ova_file), so there
      ## is no canonical name to validate against (unlike the kicksecure ISO).
      if [ "${do_provision}" = 'true' ]; then
         { [ -n "${ova_gw}" ] && [ -n "${ova_ws}" ]; } \
            || { print_usage >&2; die "${SETUP_RC}" "whonix --source built --provision requires --ova-gw PATH --ova-ws PATH"; }
         [ -f "${ova_gw}" ] || die "${SETUP_RC}" "--ova-gw '${ova_gw}' is not a regular file"
         [ -f "${ova_ws}" ] || die "${SETUP_RC}" "--ova-ws '${ova_ws}' is not a regular file"
      else
         [ -z "${ova_gw}${ova_ws}" ] \
            || { print_usage >&2; die "${SETUP_RC}" "--ova-gw/--ova-ws are only for --provision; a whonix --source built TEST run verifies the pre-imported pair (pass --version only)"; }
      fi
      version="${version_override}"
      [ -n "${version}" ] || { print_usage >&2; die "${SETUP_RC}" "whonix --source built requires --version <build-distinct label>"; }
      rt_build_version_ok "${version}" \
         || die "${SETUP_RC}" "built version label '${version}' is not path-safe (<=64 of [A-Za-z0-9.+_-], no leading '-', no '/' or '..')"
      rt_version_build_distinct "${version}" \
         || die "${SETUP_RC}" "built label '${version}' looks like a release version -- use a build-distinct label (the git-describe <ver>-g<sha>) so it cannot overwrite an official-release cell"
      rt_version_fw_distinct "${firmware}" "${version}" \
         || die "${SETUP_RC}" "built label '${version}' with --firmware ${firmware} folds into another firmware's cell -- pick a label that does not begin with another firmware's suffix"
      stable='(local build)'
      if rt_lane_is_leak "${lane}"; then
         account="persist-leak-${guest}"
         rt_account_is_leak "${account}" \
            || die "${SETUP_RC}" "leak account '${account}' is not in the persist-leak- namespace"
         account_kind='leak'
      else
         account="persist-inst-${guest}"
         account_kind='built'
      fi
   else
      has "${ISO_DOWNLOAD}" || die "${SETUP_RC}" "'${ISO_DOWNLOAD}' not on PATH"

      version="$(rt_resolve_version "${channel}")"
      [ -n "${version}" ] || die "${SETUP_RC}" "could not resolve version"
      token="$(rt_version_token "${version}")" || die "${SETUP_RC}" "resolved version '${version}' is not a safe token"
      stable="$("${ISO_DOWNLOAD}" --project "${guest}" --channel stable --print-version)"
      bless_state="$(rt_bless_state "${version}" "${stable}")"
      ## The leak lane ALWAYS runs in the dedicated, PERSISTENT persist-leak- account
      ## (never the shared persist-inst-/eph-inst- namespace); the inst lane selects by
      ## bless-state. account_kind in {blessed, prebless, leak}; only prebless is
      ## ephemeral (created + gc'd here) -- blessed and leak are pre-provisioned.
      if rt_lane_is_leak "${lane}"; then
         account="persist-leak-${guest}"
         rt_account_is_leak "${account}" \
            || die "${SETUP_RC}" "leak account '${account}' is not in the persist-leak- namespace"
         account_kind='leak'
      else
         ## inst lane. whonix inst runs the functional battery on a PRE-PROVISIONED pair
         ## (persist-inst-whonix), so a non-blessed (ephemeral) whonix inst run has no
         ## durable pair to boot -- fail loud with how to proceed, rather than create an
         ## eph account and then fail on the absent version marker. kicksecure inst self-
         ## creates its install account (ephemeral prebless is fine there).
         if [ "${guest}" = 'whonix' ] && [ "${bless_state}" != 'blessed' ]; then
            die "${SETUP_RC}" "whonix inst lane needs a pre-provisioned pair (persist-inst-whonix); version '${version}' != stable pin '${stable}'. Pass a blessed --version, or provision + pin that pair with --provision."
         fi
         account="$(rt_select_account "${guest}" "${bless_state}" "${token}")" \
            || die "${SETUP_RC}" "could not derive account for ${guest} ${version}"
         account_kind="${bless_state}"
      fi
   fi

   ## --provision is a one-time setup of a dedicated PERSISTENT pair, not a test run:
   ## whonix only, and only a persistent account (leak, a blessed inst, or a built pair) can
   ## be built -- an ephemeral eph-inst account has no durable pair to provision.
   if [ "${do_provision}" = 'true' ]; then
      [ "${guest}" = 'whonix' ] \
         || die "${SETUP_RC}" "--provision is whonix-only"
      [ "${account_kind}" = 'leak' ] || [ "${account_kind}" = 'blessed' ] || [ "${account_kind}" = 'built' ] \
         || die "${SETUP_RC}" "--provision needs a persistent account (leak, a blessed inst version == stable pin '${stable}', or a --source built pair), got state '${account_kind}'"
   fi

   if [ "${dry_run}" = 'true' ]; then
      printf '%s\n' "plan:" \
         "  guest=${guest} interface=${interface} desktop=${desktop} lane=${lane}" \
         "  channel=${channel} resolved=${version} stable=${stable} state=${account_kind}" \
         "  origin=${rt_origin} source=${source_mode}" \
         "  iso=${local_iso:-<none>} ova_gw=${ova_gw:-<none>} ova_ws=${ova_ws:-<none>}" \
         "  account=${account} firmware=${firmware} checks=${run_checks}" \
         "  mode=$([ "${do_provision}" = 'true' ] && printf '%s' "provision" || printf '%s' "test")" \
         "  iso_dir=${ISO_DIR} results_root=${RESULTS_ROOT}"
      return 0
   fi

   [ "$(id -u)" -eq 0 ] || die "${SETUP_RC}" "must run as root (creates the test account, publishes to the web root)"

   if [ "${do_provision}" = 'true' ]; then
      rt_provision_pair "${account}" "${version}"
      return 0
   fi

   ## The kicksecure built-ISO lane uses a FIXED eph account (eph-inst-kicksecure-built):
   ## serialize concurrent built runs HERE, before the eph-cleanup trap is armed and before the
   ## account is (re)created. A second run's failed lock then dies with NO trap set, so it cannot
   ## fire rt_eph_cleanup (userdel/pkill) on the account the first run is actively using. (The
   ## whonix built pair uses a PERSISTENT account, locked inside rt_whonix_pair_require instead.)
   if [ -n "${local_iso}" ]; then
      rt_lock_account "${account}"
   fi

   ## Arm the single cleanup path BEFORE creating the account, so an abort during
   ## creation or the run still reclaims the ephemeral account on exit.
   trap rt_eph_cleanup EXIT
   if [ "${account_kind}" = 'prebless' ]; then
      ## Hold the account lock for the whole run (the --iso lane took it above): a
      ## concurrent same-version run must not have its live account reclaimed below.
      [ -n "${rt_lock_fd}" ] || rt_lock_account "${account}"
      rt_sweep_eph_leftovers "${account}"
      ## A same-named account left by a KEPT failed run (or a crash) still holds its VM
      ## and state; reclaim it so this run starts from a genuinely clean account.
      if id "${account}" >/dev/null 2>&1; then
         log notice "reclaiming leftover ephemeral account '${account}' from a previous run"
         rt_eph_reclaim "${account}"
      fi
      eph_account="${account}"
      rt_create_clean_account "${account}"
   fi

   ## The leak + blessed accounts are PRE-PROVISIONED (persistent); never created or
   ## removed here. Enforce the leak invariant at run time: a missing or host-privileged
   ## leak account fails SETUP (SETUP_RC) -- NOT a leak FAIL -- so a provisioning gap or
   ## a dev-root/leaprun/sudo-enabled account can never masquerade as (or taint) a leak
   ## verdict. rt_require_fleet_member proves the host nftables leak-drop covers it.
   if [ "${account_kind}" = 'leak' ]; then
      id "${account}" >/dev/null 2>&1 \
         || die "${SETUP_RC}" "leak account '${account}' does not exist -- pre-provision it with the clean-live Whonix pair"
      rt_require_account_unprivileged "${account}" leak
      rt_require_fleet_member "${account}"
   fi

   ## The blessed account (persist-inst-) is ALSO pre-provisioned, not created here,
   ## so re-assert the same fail-closed privilege gate at run time: a NOPASSWD sudoers
   ## entry or a privileged group on it would otherwise void the account-isolation
   ## boundary the suite depends on. No nft leak-drop applies (not a leak account).
   if [ "${account_kind}" = 'blessed' ]; then
      id "${account}" >/dev/null 2>&1 \
         || die "${SETUP_RC}" "blessed account '${account}' does not exist -- pre-provision persist-inst-${guest}"
      rt_require_account_unprivileged "${account}" blessed
   fi

   ## The built-pair account (persist-inst- carrying a build-distinct marker instead of the
   ## stable pin) is ALSO pre-provisioned, not created here -- re-assert the same fail-closed
   ## privilege gate as blessed. It shares persist-inst-${guest} with the official blessed lane;
   ## the version marker (not the account) is what distinguishes a built pair from an official one.
   if [ "${account_kind}" = 'built' ]; then
      id "${account}" >/dev/null 2>&1 \
         || die "${SETUP_RC}" "built pair account '${account}' does not exist -- provision it: ${me} whonix ${interface} --lane inst --source built --ova-gw <gw.ova> --ova-ws <ws.ova> --version ${version} --provision"
      rt_require_account_unprivileged "${account}" built
   fi

   local rc
   rc=0
   case "${guest}" in
      kicksecure)
         rt_lane_kicksecure "${account}" "${version}" || rc=$?
         ;;
      whonix)
         if rt_lane_is_leak "${lane}"; then
            rt_lane_whonix_leak "${account}" "${version}" || rc=$?
         else
            rt_lane_whonix_inst "${account}" "${version}" || rc=$?
         fi
         ;;
   esac
   return "${rc}"
}

## Sourced (dm-release-test-tests) -> expose the functions without running;
## executed -> run.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
   main "$@"
fi
