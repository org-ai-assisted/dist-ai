#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## safe-pgrep: pgrep --full without the self-match trap. Read-only sibling of safe-pkill.
##
## 'pgrep --full PATTERN' matches against the WHOLE command line. pgrep drops its own PID from
## the result, but NOT the shell that invoked it -- and that shell's argv contains PATTERN
## whenever PATTERN is written literally into the command running pgrep (which is almost always).
## So a bare 'pgrep -f localbuild-driver' matches the very 'bash -c "... localbuild-driver ..."'
## that ran it (plus any qube-ctl / ssh wrapper up the chain), inflating counts and, when the
## output is piped into kill, killing the caller. The tell is a count that is one-too-high, or a
## kill list that contains your own shell.
##
## safe-pgrep matches other processes exactly like 'pgrep --full' but first computes the CALLER'S
## OWN PROCESS ANCESTRY (this process + every ancestor up to PID 1) and drops it from the result,
## plus its own transient descendants (the pgrep helper). It is READ-ONLY: it prints, never
## signals. Feed its PIDs to kill safely, or use safe-pkill to signal in one step.
##
## LIMITATION (same as safe-pkill): the exclusion is the caller's ancestry AT INVOCATION. If
## safe-pgrep is launched DETACHED from the pattern-carrying shell -- via 'systemd-run' /
## 'bgjob-run' / 'setsid' etc. -- that shell is NOT an ancestor and is NOT excluded. Run it
## SYNCHRONOUSLY from the shell whose command line carries PATTERN. For a read-only match that is
## self-safe without ancestry logic, 'pgrep --exact NAME' (process name, <= 15 chars) also cannot
## match a pattern buried in a long argv.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

usage() {
   cat -- <<'EOF'
Usage: safe-pgrep [--name] [--full] [--list-full|-a] [--count|-c] PATTERN

  --name             match the process NAME (pgrep --exact) instead of the full command line
  --full             match the full command line (default)
  --list-full, -a    print "PID <command line>" per match, like 'pgrep -a', not bare PIDs
  --count, -c        print only the number of matches (after exclusions)
  --help, -h         this help

PATTERN is matched against the full command line (like 'pgrep --full') unless --name is given.
The caller's own process and all its ancestors are ALWAYS excluded (see the LIMITATION about
detached invocation in the script header). Read-only: prints, never signals. Exit: 0 if >= 1
process matched (after exclusions), 1 if none matched, 2 on a usage error or a pgrep pattern error.
EOF
}

## PPid of $1 read from /proc/PID/status (robust: no /proc/PID/stat comm-in-parens parsing).
proc_ppid() {
   local pid="$1" key val
   [ -r "/proc/${pid}/status" ] || return 1
   while IFS=$'\t' read -r key val; do
      if [ "${key}" = "PPid:" ]; then
         printf '%s' "${val}"
         return 0
      fi
   done < "/proc/${pid}/status"
   return 1
}

## True if $1 is this process or one of its descendants (walk its ancestry until $$, or PID
## 1/0). Drops safe-pgrep's OWN transient children -- notably the pgrep helper, whose inherited
## argv contains PATTERN. Parentage-based, so unlike a process-NAME match it cannot be evaded by
## a rename and never skips an unrelated 'pgrep' / 'safe-pgrep'.
is_own_descendant() {
   local p="$1"
   while [ -n "${p}" ] && [ "${p}" != "1" ] && [ "${p}" != "0" ]; do
      if [ "${p}" = "$$" ]; then
         return 0
      fi
      p="$(proc_ppid "${p}")" || return 1
   done
   return 1
}

match_mode='full'
output='pids'

while [ "$#" -gt 0 ]; do
   case "$1" in
      --name)
         match_mode='name'
         shift
         ;;
      --full)
         match_mode='full'
         shift
         ;;
      --list-full|-a)
         output='listing'
         shift
         ;;
      --count|-c)
         output='count'
         shift
         ;;
      --help|-h)
         usage
         exit 0
         ;;
      --)
         shift
         break
         ;;
      '-'*)
         printf 'safe-pgrep: unknown option: %s\n' "$1" >&2
         exit 2
         ;;
      *)
         break
         ;;
   esac
done

if [ "$#" -lt 1 ]; then
   printf 'safe-pgrep: PATTERN required\n' >&2
   usage >&2
   exit 2
fi
pattern="$1"
shift
if [ "$#" -gt 0 ]; then
   printf 'safe-pgrep: too many arguments -- exactly one PATTERN is allowed (got extra: %s)\n' "$*" >&2
   exit 2
fi

## Protected set: this process plus its whole ancestor chain up to PID 1. A pattern that matches
## the caller's argv (the trap) matches an ANCESTOR of safe-pgrep, so excluding the ancestry is
## exactly what removes the false self-match.
declare -A protected=()
protected["$$"]=1
walk="$$"
while [ "${walk}" != "1" ] && [ "${walk}" != "0" ] && [ -n "${walk}" ]; do
   ppid=''
   ppid="$(proc_ppid "${walk}")" || break
   [ -n "${ppid}" ] || break
   protected["${ppid}"]=1
   walk="${ppid}"
done

## Candidate PIDs. Forgive ONLY pgrep exit 1 (no match); exit 2 (syntax) / 3 (fatal) mean a bad
## pattern and must NOT be silently reported as "nothing matched".
pgrep_cmd=(pgrep --full)
if [ "${match_mode}" = 'name' ]; then
   pgrep_cmd=(pgrep --exact)
fi
pgrep_out=''
pgrep_rc=0
pgrep_out="$("${pgrep_cmd[@]}" -- "${pattern}")" || pgrep_rc="$?"
case "${pgrep_rc}" in
   0 | 1)
      true
      ;;
   *)
      printf 'safe-pgrep: pgrep failed (exit %s) for pattern -- bad regex? : %s\n' "${pgrep_rc}" "${pattern}" >&2
      exit 2
      ;;
esac
candidates=()
if [ -n "${pgrep_out}" ]; then
   mapfile -t candidates <<< "${pgrep_out}"
fi

targets=()
for candidate in "${candidates[@]}"; do
   [ -n "${candidate}" ] || continue
   if [ -n "${protected["${candidate}"]:-}" ]; then
      continue
   fi
   ## Drop safe-pgrep's own descendants (its pgrep helper carries PATTERN in argv).
   if is_own_descendant "${candidate}"; then
      continue
   fi
   targets+=("${candidate}")
done

if [ "${output}" = 'count' ]; then
   printf '%s\n' "${#targets[@]}"
   [ "${#targets[@]}" -gt 0 ] || exit 1
   exit 0
fi

if [ "${#targets[@]}" -eq 0 ]; then
   exit 1
fi

for target in "${targets[@]}"; do
   if [ "${output}" = 'listing' ]; then
      ## Reconstruct the command line from /proc so the listing needs no second (self-matching)
      ## pgrep -a pass. argv is NUL-separated; render as spaces. A target can exit between the
      ## pgrep snapshot and now: the '2>/dev/null || true' keeps that race from aborting under
      ## errexit, and an unreadable/empty cmdline prints the bare PID rather than 'PID '.
      cmdline=''
      if [ -r "/proc/${target}/cmdline" ]; then
         cmdline="$(tr '\0' ' ' < "/proc/${target}/cmdline" 2>/dev/null || true)"
         cmdline="${cmdline% }"
      fi
      if [ -n "${cmdline}" ]; then
         printf '%s %s\n' "${target}" "${cmdline}"
      else
         printf '%s\n' "${target}"
      fi
   else
      printf '%s\n' "${target}"
   fi
done
exit 0
