#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Bump derivative-maker's submodule gitlinks to the submodule work you have
## ALREADY committed and published, in ONE parent commit -- the step that is
## forgotten after a submodule commit, leaving CI to build the stale pin.
##
## WHY A TOOL, NOT A HABIT: a submodule advanced + pushed but whose parent
## pointer never moved is invisible to the author (a fresh checkout shows the
## submodule AT the pin) yet builds the wrong tree in CI. dm-push stays
## push-only; this is the sole thing that touches gitlinks.
##
## WHAT IT BUMPS -- a direct submodule qualifies only when ALL hold:
##   - on branch 'ai' (the single work branch) and clean (no uncommitted work)
##   - its HEAD is strictly AHEAD of the recorded gitlink (pin is an ancestor)
##   - its HEAD EQUALS a remote-tracking 'ai' tip (LOCAL check, no network): the
##     local ai is exactly at a known published fork tip, so the new pin is
##     fetchable AND current -- not an intermediate published commit.
## A submodule ahead but NOT at a published ai tip is left alone and reported:
## it is either unpushed WIP, or a local ai behind the fork tip. Publish
## (dm-push) or fetch, then re-run to advance the pin. Behind / diverged /
## detached / dirty submodules are skipped. Freshness of the "published tip" is
## bounded by the last fetch -- a fetch refreshes it; the tool never reaches out.
##
## The bump is a parent commit of ONLY the gitlink paths. It sets the sanctioned
## commit-guard overrides for itself (GIT_BRANCH_GUARD_ALLOW + GIT_GITLINK_GUARD_ALLOW):
## the gitlink guard exists to catch ACCIDENTAL pointer bumps, and this is the
## DELIBERATE, reviewed bumper.
##
## Usage:
##   dm-gitlink-bump [--dir <derivative-maker checkout>] [--dry-run]
##   dm-gitlink-bump --check [--dir <checkout>]
##
## --check  detect only, no commit. Exit 0 = nothing to bump (or not a
##          derivative-maker checkout); exit 3 = a published-ahead submodule is
##          unpinned (the pre-push hook rejects on this). No network either way.
##          It inspects the CHECKED-OUT superproject + submodule HEADs (the 'ai'
##          working checkout, the supported workflow), not an arbitrary ref a
##          push might carry from a different checked-out branch.
##
## Exit: 0 done / nothing to do | 2 usage / not a checkout | 3 (--check) bump needed.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

AI_BRANCH="ai"
## The ONE remote CI/builds fetch and dm-git-sync publishes to (its PUBLISH_REMOTE
## / dm-submodule-ai-sync's FORK_REMOTE). A tip only on a mirror (assisted-by-ai,
## gitlab-adrelanos) or upstream lives under another remote name -> not pinnable.
AI_REMOTE="org-ai-assisted"

source_dir=""
dry_run="false"
check_only="false"

while [ "$#" -gt 0 ]; do
   case "$1" in
      --dir)
         [ "$#" -ge 2 ] || { printf '%s\n' "${0##*/}: --dir requires a value." >&2 ; exit 2 ; }
         source_dir="$2"
         shift 2
         ;;
      --dry-run)
         dry_run="true"
         shift
         ;;
      --check)
         check_only="true"
         shift
         ;;
      -h|--help)
         printf '%s\n' \
            "Bump derivative-maker submodule gitlinks to committed+published" \
            "submodule HEADs, in one parent commit. dm-push stays push-only." \
            "" \
            "Usage: ${0##*/} [--dir <derivative-maker checkout>] [--dry-run]" \
            "       ${0##*/} --check [--dir <checkout>]" \
            "" \
            "  --dir      the checkout to operate on (default: current directory)" \
            "  --dry-run  report what would be bumped; make no commit" \
            "  --check    detect only; exit 3 if a published-ahead pin is unbumped" \
            "" \
            "Exit: 0 done/nothing | 2 usage/not a checkout | 3 (--check) bump needed."
         exit 0
         ;;
      *)
         printf '%s\n' "${0##*/}: unknown argument: '$1'" >&2
         exit 2
         ;;
   esac
done

[ -n "${source_dir}" ] || source_dir="${PWD}"

## Not a derivative-maker checkout: nothing to enforce. --check is invoked
## unconditionally by the pre-push hook on EVERY push, so this must be a clean
## no-op (exit 0) outside derivative-maker, not an error.
if [ ! -d "${source_dir}/build-steps.d" ] || [ ! -d "${source_dir}/help-steps" ]; then
   if [ "${check_only}" = "true" ]; then
      exit 0
   fi
   printf '%s\n' "${0##*/}: '${source_dir}' is not a derivative-maker checkout (no build-steps.d + help-steps)." >&2
   exit 2
fi

top="$( git -C "${source_dir}" rev-parse --show-toplevel 2>/dev/null || true )"
if [ -z "${top}" ]; then
   [ "${check_only}" = "true" ] && exit 0
   printf '%s\n' "${0##*/}: '${source_dir}' is not inside a git worktree." >&2
   exit 2
fi
if [ ! "$( readlink -f -- "${top}" )" = "$( readlink -f -- "${source_dir}" )" ]; then
   [ "${check_only}" = "true" ] && exit 0
   printf '%s\n' "${0##*/}: '${source_dir}' is not the worktree ROOT (that is '${top}')." >&2
   exit 2
fi

## Direct submodule paths from .gitmodules (relative to the superproject root).
## Read the config, NOT 'git submodule foreach': foreach aborts at the first
## broken/absent submodule and its non-zero exit would be swallowed, hiding
## every submodule after it -- a gate must never fail OPEN. Uninitialized or
## broken paths are filtered per-iteration below. A path is the value after the
## key; paths with spaces survive, the (non-occurring) newline case does not.
sub_paths=()
while IFS= read -r path; do
   [ -n "${path}" ] && sub_paths+=( "${path}" )
done < <( git -C "${top}" config --file "${top}/.gitmodules" \
   --get-regexp '^submodule\..*\.path$' 2>/dev/null | sed 's/^[^ ]* //' )

## Classify each submodule. A submodule qualifies for a bump only if it is on
## 'ai', clean, strictly ahead of the pin, and its HEAD is exactly a published
## ai tip.
to_bump_paths=()
to_bump_shas=()
skipped_notes=()

## Sample the compare-and-swap anchor BEFORE classification, so a concurrent sibling commit that
## lands DURING the validation window (between reading a pin below and installing the bump) is
## caught by the update-ref CAS at the end -- a post-validation sample would miss it and let the
## bump REGRESS a gitlink the sibling just advanced. Tolerant: a --check / no-op run off 'ai'
## never commits, so a missing branch is fine here; the commit path re-requires it non-empty.
branch_ref="refs/heads/${AI_BRANCH}"
old_tip="$( git -C "${top}" rev-parse --verify --quiet "${branch_ref}" 2>/dev/null || true )"

for path in "${sub_paths[@]}"; do
   [ -n "${path}" ] || continue
   sub="${top}/${path}"
   [ -d "${sub}/.git" ] || [ -f "${sub}/.git" ] || continue

   ## On branch 'ai'? Compare the FULL ref, not '--short': 'symbolic-ref --short'
   ## disambiguates to 'heads/ai' when a tag named 'ai' also exists.
   ref="$( git -C "${sub}" symbolic-ref --quiet HEAD 2>/dev/null || true )"
   [ "${ref}" = "refs/heads/${AI_BRANCH}" ] || continue

   ## Inspectable: a FAILED 'git status' (corrupt index, unreadable submodule)
   ## means HEAD cannot be trusted -- skip rather than bump blind. Uncommitted
   ## tracked changes do NOT disqualify it: the gitlink pin is the committed
   ## HEAD, independent of the worktree, so a sibling session's WIP in the
   ## submodule must not hide a published-ahead (stale) pin -- that would make it
   ## invisible to --check, a false green on the shared multi-session tree.
   git -C "${sub}" status --porcelain --untracked-files=no >/dev/null 2>&1 || continue

   head_sha="$( git -C "${sub}" rev-parse --verify HEAD 2>/dev/null || true )"
   [ -n "${head_sha}" ] || continue

   pin_sha="$( git -C "${top}" rev-parse --verify "HEAD:${path}" 2>/dev/null || true )"
   [ -n "${pin_sha}" ] || continue
   [ "${head_sha}" != "${pin_sha}" ] || continue

   ## Strictly AHEAD: the pin is an ancestor of HEAD. Behind or diverged -> skip.
   git -C "${sub}" merge-base --is-ancestor "${pin_sha}" "${head_sha}" 2>/dev/null || continue

   ## Published AT a tip: HEAD must EQUAL the remote-tracking 'ai' tip of the
   ## CI-fetched org remote (AI_REMOTE) -- the ONE remote dm-git-sync publishes to
   ## and builds fetch. NOT merely contained in that tip (a stale local ai behind
   ## the fork would pin an intermediate commit). A tip only on a mirror
   ## (assisted-by-ai, gitlab-adrelanos) or upstream lives under a DIFFERENT
   ## remote name, so its tracking ref is not consulted and the pin is refused --
   ## CI cannot fetch it ('not our ref'). Local ref only, no network.
   ##
   ## The remote NAME is trusted as the canonical signal; the resolved URL is
   ## deliberately NOT re-verified. The workflow DEPENDS on a preconfigured
   ## 'org-ai-assisted' remote (name -> github.com/org-ai-assisted): dm-git-sync
   ## publishes to it and dm-submodule-ai-sync fetches it, neither sets its URL.
   ## So a remote correctly named org-ai-assisted yet pointing elsewhere (local
   ## path, mirror, stale url) is a hand-misconfiguration outside the supported
   ## workflow -- an accepted, unlikely risk. A URL check here would re-add the
   ## url parser dropped for its own bugs (look-alike hosts, '..' tricks,
   ## false-rejected case/port variants); not worth it for that accident.
   at_published_tip="false"
   rt_tip="$( git -C "${sub}" rev-parse --verify --quiet "refs/remotes/${AI_REMOTE}/${AI_BRANCH}" 2>/dev/null || true )"
   if [ "${rt_tip}" = "${head_sha}" ]; then
      at_published_tip="true"
   fi

   if [ "${at_published_tip}" = "true" ]; then
      to_bump_paths+=( "${path}" )
      to_bump_shas+=( "${head_sha}" )
   else
      skipped_notes+=( "${path} (HEAD ${head_sha:0:12} ahead of pin but not at a published ai tip; dm-push or fetch, then re-run)" )
   fi
done

## --check: the pre-push gate. A published-ahead pin left unbumped is the bug.
if [ "${check_only}" = "true" ]; then
   [ "${#to_bump_paths[@]}" -eq 0 ] && exit 0
   printf '%s\n' "${0##*/}: ${#to_bump_paths[@]} submodule gitlink(s) behind published HEAD:" >&2
   for i in "${!to_bump_paths[@]}"; do
      printf '%s\n' "   ${to_bump_paths[${i}]} -> ${to_bump_shas[${i}]:0:12}" >&2
   done
   exit 3
fi

## Report ahead-but-not-at-a-published-tip submodules (WIP or stale local; not
## an error).
for note in "${skipped_notes[@]}"; do
   printf '%s\n' "NOTE: ${note}" >&2
done

if [ "${#to_bump_paths[@]}" -eq 0 ]; then
   printf '%s\n' "${0##*/}: every dm gitlink is current; nothing to bump."
   exit 0
fi

## The parent commit must land on 'ai'. Full ref, not '--short' (a tag named
## 'ai' would make --short report 'heads/ai').
super_ref="$( git -C "${top}" symbolic-ref --quiet HEAD 2>/dev/null || true )"
if [ "${super_ref}" != "refs/heads/${AI_BRANCH}" ]; then
   printf '%s\n' "${0##*/}: superproject is not on '${AI_BRANCH}' (HEAD '${super_ref:-DETACHED}'); refusing to bump." >&2
   exit 2
fi

printf '%s\n' "${0##*/}: bumping ${#to_bump_paths[@]} gitlink(s):"
for i in "${!to_bump_paths[@]}"; do
   printf '%s\n' \
      "   ${to_bump_paths[${i}]}: $( git -C "${top}" rev-parse --verify --short "HEAD:${to_bump_paths[${i}]}" 2>/dev/null ) -> ${to_bump_shas[${i}]:0:12}"
done

if [ "${dry_run}" = "true" ]; then
   printf '%s\n' "${0##*/}: --dry-run; no commit made."
   exit 0
fi

## Commit the VALIDATED shas, NOT the live submodule HEADs. A pathspec commit
## ('git commit -- <path>') re-reads each submodule's worktree HEAD, so a sibling
## committing an unpublished c2 in the window between the validation above and
## the commit would be pinned (TOCTOU) -- a gitlink CI cannot fetch, caught by
## neither --check nor the build. Instead stage each VALIDATED sha into a PRIVATE
## index seeded from the branch tip (only these gitlinks move; an unrelated staged
## change in the shared index never rides along) and commit that tree with plumbing:
## the pin is exactly what was validated, whatever the live submodule HEAD is now.
##
## commit-tree is not 'git commit', so the safety the porcelain gave is restored
## explicitly below: a merge/sequencer-in-progress refusal, and a compare-and-swap
## branch update (a concurrent superproject commit fails the bump LOUD instead of
## being reverted or dropped), and honoring commit.gpgsign. The pre-commit /
## commit-msg hooks do NOT run -- acceptable: the commit is a gitlink pointer plus a
## FIXED message, so there is no file content, PII, Unicode or style for a hook to
## catch, and the branch / gitlink guards the porcelain path waived are not wanted.
## Residual: if '.git/index.lock' is held by a concurrent op exactly when the final
## index sync runs, that sync fails after the ref moved, leaving a cosmetic staged
## gitlink diff (no data loss; a re-run or 'git reset -- <paths>' clears it).

## Refuse while a merge or sequencer operation is unfinished: a single-parent
## plumbing commit would drop the second parent / staged result and leave the
## operation half-applied (the porcelain 'git commit' refused this outright).
for merge_state in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD REBASE_HEAD; do
   ## Resolve the pseudo-ref in ${top}'s repo, NOT a filesystem probe: 'rev-parse
   ## --git-path' prints a path relative to GIT's cwd, which 'test -e' would then
   ## wrongly resolve against the shell's cwd (a stray MERGE_HEAD in an unrelated
   ## repo at the cwd would false-trip it). --verify is cwd-independent.
   if git -C "${top}" rev-parse --verify --quiet "${merge_state}" >/dev/null 2>&1; then
      printf '%s\n' "${0##*/}: '${merge_state}' present (merge/sequencer in progress); refusing to bump." >&2
      exit 2
   fi
done

## Identity: pin author/committer NAME to 'claude' -- the harness exports
## GIT_AUTHOR_NAME / GIT_COMMITTER_NAME with a session-id suffix that would
## otherwise land in the public object; email stays git config (noreply), never
## set here (PII risk).
## branch_ref/old_tip were sampled BEFORE classification (so the CAS spans the whole validation
## window); old_tip is non-empty here because the superproject-on-'ai' guard above proved
## refs/heads/ai exists.
[ -n "${old_tip}" ] \
   || { printf '%s\n' "${0##*/}: '${branch_ref}' not found; refusing to bump." >&2; exit 2; }

## shellcheck cannot see the trap invocation below.
# shellcheck disable=SC2317
remove_tmp_index() {
   safe-rm -f -- "${tmp_index:-}"
}
tmp_index="$( mktemp )"
trap remove_tmp_index EXIT
GIT_INDEX_FILE="${tmp_index}" git -C "${top}" read-tree "${old_tip}"
for i in "${!to_bump_paths[@]}"; do
   GIT_INDEX_FILE="${tmp_index}" git -C "${top}" update-index --add \
      --cacheinfo "160000,${to_bump_shas[${i}]},${to_bump_paths[${i}]}"
done
new_tree="$( GIT_INDEX_FILE="${tmp_index}" git -C "${top}" write-tree )"

sign_opt=()
if [ "$( git -C "${top}" config --bool --get commit.gpgsign 2>/dev/null || true )" = "true" ]; then
   sign_opt=( -S )
fi
new_commit="$( GIT_AUTHOR_NAME=claude GIT_COMMITTER_NAME=claude \
   git -C "${top}" commit-tree "${new_tree}" -p "${old_tip}" "${sign_opt[@]}" \
   -m "Bump submodule gitlinks to published ai tips" )"

## Compare-and-swap: install the bump only if the branch is STILL at old_tip. A
## concurrent commit (another session on this shared tree) moved it -> update-ref
## fails, errexit aborts, nothing is clobbered; a re-run picks up the new tip. The
## specific branch ref is named (not HEAD), so a checkout in the window cannot
## redirect the update onto another branch.
git -C "${top}" update-ref "${branch_ref}" "${new_commit}" "${old_tip}"

## Sync the SHARED index for the bumped paths to the committed shas so 'git
## status' is clean and a later sibling commit cannot carry a stale pin. Scoped
## to our paths only -- never the whole index.
for i in "${!to_bump_paths[@]}"; do
   git -C "${top}" update-index --add \
      --cacheinfo "160000,${to_bump_shas[${i}]},${to_bump_paths[${i}]}"
done

printf '%s\n' "${0##*/}: committed. Push with dm-push (submodules first if any were unpublished)."
exit 0
