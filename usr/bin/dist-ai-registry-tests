#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Consistency lint over dist-ai's own suite registry: asserts every registered
## suite has an executable entrypoint, a debian/*.install entry, a wire() case
## and a suite_component() mapping, and that no *-tests entrypoint is left
## registered nowhere. Each of those failures otherwise shows up as a SILENT
## green -- a skipped or never-selected suite, not a red run.
##
## Source-tree lint: set DIST_AI_REPO, or run it from a checkout. Exits 77
## (SKIP) without one. No root, no network.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/dist-ai-registry-tests" ]; then
   share="${script_dir}/../share/dist-ai-registry-tests"
else
   share='/usr/share/dist-ai-registry-tests'
fi

rc=0
bash -- "${share}/registry_test.sh" "$@" || rc=$?
exit "${rc}"
