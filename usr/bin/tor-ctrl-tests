#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Test suite for the tor-ctrl package. Runs every case script in
## usr/share/tor-ctrl-tests and fails if any of them does.
##
## The subject is resolved by each case script:
##   * TOR_CTRL_REPO=/path/to/tor-ctrl -> that checkout's usr/bin, OR
##   * unset -> the installed package (/usr/bin).
##
## Cases that need a controller start their OWN tor on a private DataDirectory
## with DisableNetwork -- never a system tor, never a production onion.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/tor-ctrl-tests" ]; then
   tests_dir="${script_dir}/../share/tor-ctrl-tests"
else
   tests_dir='/usr/share/tor-ctrl-tests'
fi

if [ ! -d "${tests_dir}" ]; then
   printf '%s\n' "SKIP: tor-ctrl-tests payload not found at '${tests_dir}'" >&2
   exit 77
fi

## A suite that runs zero cases must not report success: that is the shape of a
## payload that failed to install.
case_count=0
failures=0
skips=0

for case_script in "${tests_dir}"/*-test.sh; do
   [ -e "${case_script}" ] || break
   case_count=$(( case_count + 1 ))
   printf '%s\n' "=== ${case_script##*/}"
   case_status=0
   "${case_script}" "$@" || case_status=$?
   if [ "${case_status}" -eq 0 ]; then
      continue
   fi
   if [ "${case_status}" -eq 77 ]; then
      skips=$(( skips + 1 ))
      printf '%s\n' "SKIP  ${case_script##*/} (exit 77)"
      continue
   fi
   failures=$(( failures + 1 ))
   printf '%s\n' "FAIL  ${case_script##*/} (exit ${case_status})"
done

if [ "${case_count}" -eq 0 ]; then
   printf '%s\n' "FAIL: no case scripts found in '${tests_dir}'" >&2
   exit 1
fi

printf '%s\n' "" "${case_count} case(s), ${failures} failed, ${skips} skipped"

## A SKIP is not a pass: report it through the suite's own exit code so
## dist-ai-tests-all records it rather than showing a clean run.
[ "${failures}" -eq 0 ] || exit 1
[ "${skips}" -eq 0 ] || exit 77
exit 0
