#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Single entry point for ALL of the secure-terminal.github.io screenshots. The
## generators live together in usr/share/secure-terminal-shots/ (see its README).
##
## Usage: secure-terminal-shots [refresh|review|modes|tooltip|compat|zoom-live|comparison|clipboard] [ARGS...]
##        secure-terminal-shots --cleanup
##
##   refresh     regenerate EVERY deterministic offscreen SITE gallery in one run (review +
##               modes -> the site's shots/, compat -> compatibility/shots/), so a deploy
##               cannot refresh one lane and leave another stale. NOTIFY-only for the
##               X/labwc comparison lane (run that via secure-terminal-shots-sandbox).
##               OUTPUT: the site checkout (arg 1, default under private-sources).
##
##   compat      deterministic compatibility-page program shots -- each line-oriented
##               program is RUN for real against a fixed fixture (no network/clock)
##               and what secure-terminal DISPLAYS of its output is grabbed, headless
##               and byte-reproducible (same offscreen-Qt path as modes). One
##               webp per compatibility-table row, into the site's compatibility/shots/.
##
##   --cleanup   reap any leftover capture process groups (the terminals + the secure-terminal
##               GUI) a crashed/interrupted comparison run left behind. Marker-scoped -- only
##               reaps a registered run's own processes, never anything else. Needs no checkout.
##
##   clipboard   the OSC 52 clipboard-write VERDICT lane -- per-terminal honored/refused,
##               read back from the real X clipboard via PyQt6 (no screenshot). NEEDS an X
##               server; run it in a sandbox. Writes shots/clipboard-verdict.tsv.
##
##   review      (default) the paste + copy REVIEW-BAR shots -- headless, offscreen
##               Qt grab of the real ReviewBar, deterministic. OUTPUT_DIR defaults
##               to the site's shots/. This is the safe, no-display path.
##   modes       the four unicode DISPLAY MODES (box/show/reveal/detail) of one
##               hostile payload, as a single labelled grid -- same headless
##               offscreen-Qt path as review. OUTPUT_DIR defaults to the site's
##               shots/.
##   zoom-live   DIAGNOSTIC (not a site asset): the REAL-GUI live-zoom sweep -- one secure-terminal
##               launch under the real labwc/Xwayland capture chain running a full-screen TUI, the
##               font zoom stepped LIVE via `secure-terminal ctl zoom` on the SAME instance (no
##               restarts), the real decorated window screenshotted at each level, so it sees the
##               actual horizontal scrollbar + any white band. NEEDS an X server + labwc (run in a
##               sandbox). Levels: trailing args, else the default band. Writes zoom-live-<pct>.png
##               into the local shots/ dir.
##   comparison  the terminal-COMPARISON shots -- real Debian terminal emulators as
##               NATIVE WAYLAND clients (the X11-only trio xterm/urxvt/st via labwc's
##               Xwayland) under a private headless labwc compositor, captured with grim.
##               Needs NO host X server (labwc runs WLR_BACKENDS=headless); run it in a
##               sandbox. Writes to its own shots/; copy them to the site's
##               comparison/shots/. Forwards ST_REPO etc. Extra args pass through:
##               --only NAME / --case C / --quick / --st-only / --no-st / --jobs N.
##
## Both target a secure-terminal checkout resolved from SECURE_TERMINAL_REPO (or a
## default under the operator's private-sources); an absent checkout is FATAL (exit 1).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/secure-terminal-shots" ]; then
   shots_dir="${script_dir}/../share/secure-terminal-shots"
else
   shots_dir='/usr/share/secure-terminal-shots'
fi

## --cleanup: reap any leftover capture process groups (terminals + the secure-terminal GUI) a
## crashed/interrupted run left behind. Marker-scoped; needs no secure-terminal checkout, so it
## runs BEFORE the repo resolution + SKIP logic below.
if [ "${1:-}" = '--cleanup' ]; then
   run_rc=0
   "${shots_dir}/shots-cleanup" || run_rc="$?"
   exit "${run_rc}"
fi

optimize_to_webp() {  ## $@=produced PNG shots -> convert each to webp in place
   ## The site references these shots as .webp; convert a freshly generated PNG (removing it)
   ## with the bundled image-optimize sibling in THIS bin dir, so a regenerated shot lands
   ## optimized rather than being caught later by the pre-commit image gate. Required, bundled,
   ## resolved by path (not PATH -- $0 is readlink-canonicalized, so a ~/.local/bin symlink
   ## still points script_dir at the real dist-ai/usr/bin); no fallback.
   local shot
   for shot in "$@"; do
      [ -f "${shot}" ] || continue
      "${script_dir}/image-optimize" --webp --quiet -- "${shot}" >/dev/null
   done
}

repo=''
[ -v SECURE_TERMINAL_REPO ] || SECURE_TERMINAL_REPO=''
if [ -n "${SECURE_TERMINAL_REPO}" ]; then
   repo="${SECURE_TERMINAL_REPO}"
elif [ -d "${HOME}/private-sources/secure-terminal/usr/lib/python3/dist-packages/secure_terminal" ]; then
   repo="${HOME}/private-sources/secure-terminal"
elif [ -d "${script_dir}/../../../../secure-terminal/usr/lib/python3/dist-packages/secure_terminal" ]; then
   repo="${script_dir}/../../../../secure-terminal"
fi

if [ -z "${repo}" ] || [ ! -d "${repo}/usr/lib/python3/dist-packages/secure_terminal" ]; then
   printf '%s\n' 'secure-terminal-shots: ERROR (secure_terminal not found; set SECURE_TERMINAL_REPO)' >&2
   exit 1
fi

mode='review'
if [ "$#" -ge 1 ] && { [ "$1" = 'review' ] || [ "$1" = 'modes' ] \
      || [ "$1" = 'tooltip' ] || [ "$1" = 'zoom-live' ] \
      || [ "$1" = 'comparison' ] \
      || [ "$1" = 'clipboard' ] || [ "$1" = 'compat' ] || [ "$1" = 'refresh' ]; }; then
   mode="$1"
   shift
fi

export SECURE_TERMINAL_REPO="${repo}"
export ST_REPO="${repo}"

if [ "${mode}" = 'refresh' ]; then
   ## Regenerate EVERY deterministic offscreen SITE gallery in ONE run, so a deploy can
   ## never refresh one lane and leave another stale (the /shots/ review+modes lane going
   ## stale while /comparison/shots/ was regenerated is exactly the drift this closes).
   ## Each offscreen site lane is ONE line below -- the single place that lists them all;
   ## re-invoking this wrapper per lane keeps the sizing/output logic in one place. The
   ## comparison lane needs X/labwc, so it is NOT run here: NOTIFY that it is regenerated
   ## separately via the sandbox driver, never silently claim it was done.
   site="${1:-${HOME}/private-sources/secure-terminal.github.io}"
   if [ ! -d "${site}/shots" ] || [ ! -d "${site}/compatibility/shots" ]; then
      printf '%s\n' "secure-terminal-shots: site galleries not found under '${site}' (set the site checkout path)" >&2
      exit 1
   fi
   self="$(readlink --canonicalize -- "$0")"
   "${self}" review  "${site}/shots"
   "${self}" modes   "${site}/shots"
   "${self}" tooltip "${site}/shots"
   "${self}" compat  "${site}/compatibility/shots"
   printf '%s\n' \
      "secure-terminal-shots: refreshed the offscreen site galleries (review + modes -> shots/, compat -> compatibility/shots/)." \
      "secure-terminal-shots: NOTE: the /comparison/shots/ lane needs X/labwc and was NOT regenerated here." \
      "secure-terminal-shots:       run it via:  secure-terminal-shots-sandbox comparison   (or: secure-terminal-shots-sandbox refresh, which does both)." >&2
   exit 0
fi

## The comparison + zoom-live lanes bring up their OWN private headless labwc compositor
## (WLR_BACKENDS=headless + WLR_RENDERER=pixman, no host X server, no GPU) and capture with
## grim, so they need NO outer Xvfb -- a bare `secure-terminal-shots comparison` just works in
## a headless sandbox. The X11-only trio (xterm/urxvt/st) reach labwc's own Xwayland. Only the
## clipboard lane below still needs a real X clipboard (run under xvfb-run).

if [ "${mode}" = 'comparison' ]; then
   ## Real-terminal comparison capture; it resolves ST_REPO / SECURE_TERMINAL_REPO itself,
   ## brings up its own headless labwc, and writes to its own shots/. --jobs N is handled inside
   ## comparison-capture.sh (N parallel headless compositors, one per lane). Forward its exit.
   run_rc=0
   "${shots_dir}/comparison-capture.sh" "$@" || run_rc="$?"
   exit "${run_rc}"
fi

if [ "${mode}" = 'zoom-live' ]; then
   ## Real-GUI live-zoom DIAGNOSTIC (not a site asset): launch secure-terminal ONCE under the
   ## real labwc/Xwayland capture chain (the comparison path, NOT offscreen), run a full-screen
   ## TUI, and step the font zoom LIVE via `secure-terminal ctl zoom` on the SAME instance --
   ## screenshotting the real decorated window at each level, no restarts. It can see the
   ## actual horizontal scrollbar and any white band a widget grab cannot. Levels: trailing
   ## args, else the default band.
   ## comparison-capture.sh brings up its own headless labwc (no Xvfb) and writes PNGs to shots/.
   run_rc=0
   "${shots_dir}/comparison-capture.sh" --zoom-live "$@" || run_rc="$?"
   ## Only claim success when the capture actually succeeded: '|| run_rc=' catches the
   ## failure so errexit does not stop us, so the success line must be gated on run_rc --
   ## else a failed sweep (unreachable ctl, zero valid shots) still prints "wrote ... shots"
   ## on stdout while exiting non-zero, misleading a stdout-scraping caller (false green).
   if [ "${run_rc}" = '0' ]; then
      printf '%s\n' "secure-terminal-shots: wrote real-GUI zoom-live shots to ${shots_dir}/shots"
   fi
   exit "${run_rc}"
fi

if [ "${mode}" = 'clipboard' ]; then
   ## The OSC 52 clipboard-write VERDICT lane (not a screenshot): per-terminal
   ## honored/refused, read back from the real X clipboard. xvfb-run + forward its exit.
   run_rc=0
   xvfb-run --auto-servernum --server-args='-screen 0 1600x1000x24' \
      "${shots_dir}/clipboard-verdict.sh" "$@" || run_rc="$?"
   exit "${run_rc}"
fi

if [ "${mode}" = 'compat' ]; then
   ## Deterministic compatibility-program shots into the site's compatibility/shots/.
   ## Same offscreen-Qt path as modes: each program is RUN for real against a
   ## fixed fixture and what secure-terminal DISPLAYS of its output is grabbed, so the
   ## picture backs the page's "was run and verified" claim. One PNG per program
   ## (webp-optimized), named for its compatibility-table row.
   out_dir="${1:-${HOME}/private-sources/secure-terminal.github.io/compatibility/shots}"
   if [ ! -d "${out_dir}" ]; then
      printf '%s\n' "secure-terminal-shots: output dir does not exist: ${out_dir}" >&2
      exit 1
   fi
   export PYTHONPATH="${repo}/usr/lib/python3/dist-packages${PYTHONPATH:+:${PYTHONPATH}}"
   "${shots_dir}/compat-shot.py" "${out_dir}"
   ## --list returns before importing Qt, so this is a cheap name enumeration; webp
   ## each produced PNG (the site references <name>.webp). Capture the names in a
   ## variable FIRST (not inline in the for-list): under errexit a failed --list then
   ## aborts the lane, instead of a `for x in $(failed)` silently looping zero times.
   compat_names="$("${shots_dir}/compat-shot.py" --list)"
   ## Split the (newline-separated) names into an ARRAY rather than an unquoted word-split, so a
   ## name is never glob-expanded or re-split. Capture-first (above) keeps the errexit guard.
   mapfile -t compat_arr <<< "${compat_names}"
   for name in "${compat_arr[@]}"; do
      [ -n "${name}" ] || continue
      optimize_to_webp "${out_dir}/${name}.png"
   done
   printf '%s\n' "secure-terminal-shots: wrote compatibility shots to ${out_dir}"
   exit 0
fi

if [ "${mode}" = 'modes' ] || [ "${mode}" = 'tooltip' ]; then
   if [ "${mode}" = 'tooltip' ]; then
      gen='tooltip-shot.py'; outfile='tooltip.png'
   else
      gen='display-modes-shot.py'; outfile='display-modes.png'
   fi
   ## Headless shot into the site's shots/. Same offscreen-Qt path as review: the
   ## real renderer, no display, byte-for-byte regenerable.
   out_dir="${1:-${HOME}/private-sources/secure-terminal.github.io/shots}"
   if [ ! -d "${out_dir}" ]; then
      printf '%s\n' "secure-terminal-shots: output dir does not exist: ${out_dir}" >&2
      exit 1
   fi
   export PYTHONPATH="${repo}/usr/lib/python3/dist-packages${PYTHONPATH:+:${PYTHONPATH}}"
   "${shots_dir}/${gen}" "${out_dir}/${outfile}"
   optimize_to_webp "${out_dir}/${outfile}"
   exit 0
fi

## review mode: headless review-bar shots into the site's shots/.
out_dir="${1:-${HOME}/private-sources/secure-terminal.github.io/shots}"
if [ ! -d "${out_dir}" ]; then
   printf '%s\n' "secure-terminal-shots: output dir does not exist: ${out_dir}" >&2
   exit 1
fi

shot_script="${shots_dir}/paste-warning-shot.py"
if [ ! -f "${shot_script}" ]; then
   printf '%s\n' "secure-terminal-shots: shot generator missing: ${shot_script}" >&2
   exit 1
fi

export PYTHONPATH="${repo}/usr/lib/python3/dist-packages${PYTHONPATH:+:${PYTHONPATH}}"

## One entry per shot: <kind> <output-file>. Add a line here to grow the set.
for spec in \
   'paste paste-warning.png' \
   'copy copy-warning.png'; do
   read -r kind file <<< "${spec}"
   "${shot_script}" "${out_dir}/${file}" "${kind}"
   optimize_to_webp "${out_dir}/${file}"
done

printf '%s\n' "secure-terminal-shots: wrote paste-warning + copy-warning shots to ${out_dir}"
