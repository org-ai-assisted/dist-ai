#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Randomized fuzz run of sdwdate's untrusted-input parsers (the HTTP Date
## header parsing in url_to_unixtime and the pool-config sort_pool text
## parser). See fuzz_sdwdate.py for the properties checked. Override the sweep
## length with --iterations N and reproduce a failure with --seed N. The
## sdwdate package under test is resolved by SDWDATE_REPO=<checkout> else the
## installed package.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/sdwdate-tests" ]; then
   tests_dir="${script_dir}/../share/sdwdate-tests"
else
   tests_dir='/usr/share/sdwdate-tests'
fi

iterations='20000'

rc=0
## style-ok: allow-python-interpreter -- run through PATH python3 for venv/user-site test deps
python3 -- "${tests_dir}/fuzz_sdwdate.py" --iterations "${iterations}" "$@" || rc=$?
exit "${rc}"
