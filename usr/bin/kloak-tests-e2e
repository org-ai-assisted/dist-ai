#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Daemon-level END-TO-END lane for kloak: runs the real privsep daemon pair
## (kloak + the sandboxed kloakwl adapter) built from KLOAK_REPO against a
## headless wlroots compositor, covering the connected+privsep path and the
## degraded-mode fallback.
##
## An --e2e-category suite, not run by the default --core PR gate. Needs root,
## /dev/uinput, and labwc + python3-evdev on the target; off-target it reports an
## authorized SKIP (never a false pass). The subject is resolved from KLOAK_REPO.
##
## Any extra arguments are forwarded to the unittest runner.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/kloak-tests-e2e" ]; then
   tests_dir="${script_dir}/../share/kloak-tests-e2e"
else
   tests_dir='/usr/share/kloak-tests-e2e'
fi

run_unittest="${script_dir}/../share/dist-ai-tests-common/run-unittest.py"
[ -r "${run_unittest}" ] || run_unittest='/usr/share/dist-ai-tests-common/run-unittest.py'

"${run_unittest}" \
   --start-directory "${tests_dir}" \
   --pattern 'test_*.py' \
   "$@"
