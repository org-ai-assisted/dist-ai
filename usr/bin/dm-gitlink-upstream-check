#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Enforce two independent gitlink invariants on derivative-maker master:
##
##   1. RESOLVABLE   -- every submodule gitlink points to a commit reachable on
##                      that submodule's canonical upstream (Kicksecure /
##                      Whonix) master.
##   2. NO-DEVIATION -- master moves no gitlink at all relative to its merge
##                      base with the parent upstream, Kicksecure/derivative-
##                      maker master.
##
##   dm-gitlink-upstream-check [--repo-root DIR] [--parent-check MODE] [--self-test]
##
## Why this lives as a CI check, not a git hook: a fork-only gitlink bump
## reaches derivative-maker master through a GitHub PR MERGE -- a server-side
## merge that runs NO local git hook, so the branch / no-gitlink-on-master
## guards (private-ai-config claude/hooks/git_policy.py, enforced at pre-commit
## and PreToolUse) never see it. A push-to-master CI check is the only
## enforcement point in that path. It also does not check upstream-resolvability,
## which those hooks never did at all.
##
## Resolvable == the pinned SHA is an ancestor of, or equal to, the upstream
## master tip (GitHub compare status 'behind' / 'identical'). An ahead /
## diverged / absent SHA is fork-only and fails. A newer-than-master upstream
## commit (rare; races a just-merged pin) shows 'ahead' and is reported, not
## silently passed.
##
## Resolvable is strictly WEAKER than no-deviation, and the gap is not academic:
## a pointer that is merely BEHIND the submodule's upstream tip passes check 1
## while still failing check 2. Merging such a master upstream conflicts on the
## submodule for anyone who has not checked it out -- git needs the submodule's
## own objects to decide which side's pointer wins, and without them it stops at
## 'Failed to merge submodule <path> (not checked out)'. A maintainer's clone is
## exactly that state, so the invariant that matters for an upstream merge is
## no-deviation, not resolvability.
##
## Check 2 runs only on a master checkout by default (--parent-check auto): the
## 'ai' branch legitimately carries as-yet-unmerged pins for CI testing and must
## not be flagged.
##
## derivative-maker's CI checks out dist-ai beside its workspace and calls this
## as dist-ai/usr/bin/dm-gitlink-upstream-check --repo-root . (mirrors dm-boot-
## test). '--self-test' is the offline regression test for both evaluators.
##
## style-ok: no-has -- this runs in a bare Debian CI container (git,
## ca-certificates, curl, python3), where helper-scripts is not installed and
## 'has' therefore does not exist. 'command -v' is the only probe available.
## style-ok: no-safe-rm -- same container: safe-rm is a workstation helper.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## An inherited GIT_DIR / GIT_WORK_TREE outranks every 'git -C', so a run from
## inside a hook, 'rebase --exec' or 'submodule foreach' would silently inspect
## whatever repository the environment names instead of --repo-root.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
## The sweep still reports EVERY unresolvable/erroring submodule in one run, not
## just the first: each resolver catches its own failure and returns 0 with an
## 'error' verdict, so errexit never fires mid-loop. The only intentional
## non-zero (a not-resolvable verdict, EOF on a read) is captured explicitly.

## Upstream branch every Kicksecure / Whonix submodule uses as its default.
readonly UPSTREAM_BASE='master'

## Field separator of the records passed from the enumerators to the evaluators.
## printf format strings stay fixed (R-030), so the tab travels as data.
readonly TAB=$'\t'

## The derivative-maker checkout whose gitlinks are checked. Overridden by
## --repo-root; defaults to the current directory.
repo_root='.'

## Indirection point so the offline self-test can substitute a stub resolver for
## the network one without touching the evaluator.
STATUS_FN='upstream_status'

## Same, for the merge-base lookup: it lets the self-test drive the deviation
## evaluator without a fetch.
MERGE_BASE_FN='parent_merge_base'

## Canonical derivative-maker, the merge target this fork's master must stay
## gitlink-identical to. Overridden by --parent-upstream, which is what the
## self-test points at a local fixture instead of the network.
parent_upstream_url='https://github.com/Kicksecure/derivative-maker.git'

## Branch on the parent upstream that master is compared against.
parent_upstream_branch='master'

## Branch whose checkout the no-deviation check applies to under 'auto'.
readonly PARENT_CHECK_BRANCH='master'

## auto   run the no-deviation check only on a PARENT_CHECK_BRANCH checkout
## always run it whatever branch is checked out
## never  skip it
parent_check='auto'

## Attribution for the resolvable check (invariant 1), populated by main() from
## the no-deviation set (invariant 2). A gitlink this fork INHERITED verbatim
## from the parent upstream (equal SHA at the merge base) is upstream's to
## answer for -- this fork may not deviate from it without failing invariant 2 --
## so an unresolvable/problem verdict on an inherited pin is a WARNING, never a
## red gate. Only a pin this fork INTRODUCED is held to 'must be upstream-merged'.
## The defaults leave every pin attributed to this branch (the conservative
## standalone-audit behavior) until main() proves inheritance.
declare -gA EVAL_INHERITED=()
EVAL_ATTRIBUTION_KNOWN='false'

## Set by check_parent_deviation as a side effect so main() can reuse the one
## merge-base diff for both invariants: PARENT_DEV_PATHS keys the gitlink paths
## this checkout moves relative to the parent upstream, and PARENT_ATTRIBUTION_
## KNOWN is 'true' only when that comparison actually ran (a reachable upstream
## and a real merge base), so a network failure cannot masquerade as 'nothing
## deviated, everything inherited'.
declare -gA PARENT_DEV_PATHS=()
PARENT_ATTRIBUTION_KNOWN='false'

## Paths whose .gitmodules URL differs between the merge base and HEAD (a
## repoint). Kept separate from PARENT_DEV_PATHS because a URL change is not a
## gitlink-SHA deviation (invariant 2 stays SHA-only), but it DOES disqualify the
## path from being treated as inherited: a submodule repointed while keeping the
## merge-base SHA must not have its resolvable check demoted to a warning.
declare -gA PARENT_URL_CHANGED_PATHS=()

## Fixture directory of the running parent self-test, for its cleanup trap.
parent_self_test_tmp=''

## Where this script lives, so the github-api shipped beside it can be found when
## dist-ai is checked out rather than installed.
script_dir="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")"


usage() {
  printf '%s\n' \
    'Usage: dm-gitlink-upstream-check [--repo-root DIR] [--parent-check MODE]' \
    '                                 [--parent-upstream URL] [--self-test]' \
    '' \
    '  --repo-root DIR      derivative-maker checkout to inspect (default: .)' \
    '  --parent-check MODE  no-deviation check: auto (default, master only),' \
    '                       always, or never' \
    '  --parent-upstream U  parent upstream repo URL to compare against' \
    '  --self-test          run the offline regression tests and exit' \
    '' \
    'Exit: 0 both invariants hold; 1 at least one gitlink is unresolvable or' \
    'deviates from the parent upstream merge base; 2 usage / setup error.'
}


github_get() {
  ## Fetch a GitHub REST path, printing the raw JSON body (even on 4xx, so the
  ## caller can classify a 404 as a definitive 'not in this repo': github-api does
  ## not pass --fail, and exits 0 printing '{"message": "Not Found"}').
  ##
  ## Always through the github-api wrapper, never a hand-rolled curl: the wrapper
  ## is what keeps the token off argv and refuses to attach it to a non-GitHub
  ## host. It ships beside this script, so CI has it from the dist-ai checkout
  ## without anything being installed.
  local path="$1"
  "$(git_api_program)" GET "${path}"
}


git_api_program() {
  ## Prefer an installed github-api; otherwise the one shipped beside this script,
  ## which is how CI reaches it (the workflow checks dist-ai out as ./dist-ai).
  if command -v github-api >/dev/null 2>&1; then
    printf '%s\n' 'github-api'
    return 0
  fi
  local sibling="${script_dir}/github-api"
  if [ -x "${sibling}" ]; then
    printf '%s\n' "${sibling}"
    return 0
  fi
  printf '%s\n' \
    "::error::github-api not found on PATH nor beside ${BASH_SOURCE[0]}" >&2
  return 2
}


classify_compare_program() {
  ## The compare-body classifier, shipped under libexec in the same tree (CI
  ## reaches it from the dist-ai checkout; installed it is under /usr/libexec).
  local installed='/usr/libexec/dist-ai/dm-gitlink-classify-compare.py'
  local sibling
  sibling="$( dirname -- "$( dirname -- "$( readlink -f -- "${BASH_SOURCE[0]}" )" )" )/libexec/dist-ai/dm-gitlink-classify-compare.py"
  if [ -r "${sibling}" ]; then
    printf '%s\n' "${sibling}"
    return 0
  fi
  if [ -r "${installed}" ]; then
    printf '%s\n' "${installed}"
    return 0
  fi
  printf '%s\n' \
    "::error::dm-gitlink-classify-compare.py not found under libexec/dist-ai" >&2
  return 2
}


classify_compare() {
  ## Map a compare-endpoint JSON body to one token on stdout:
  ##   resolvable      status behind / identical (ancestor-or-equal of master)
  ##   not-resolvable  status ahead / diverged, OR the head SHA is not in the
  ##                   upstream repo at all ('message': 'Not Found')
  ##   error           anything else (rate limit, transient 5xx, bad JSON) --
  ##                   never fails the check, only warns, to avoid a flaky red
  ##
  ## A missing classifier (broken / partial install) must degrade to an 'error'
  ## verdict, NOT crash the sweep: '"$(classify_compare_program)"' as a bare
  ## command would expand to the empty string on failure and abort under errexit
  ## (empty command -> 127), killing the run on the first gitlink instead of
  ## reporting every one, contrary to this tool's own no-abort contract.
  local prog verdict
  if ! prog="$(classify_compare_program)"; then
    printf '%s\n' 'error'
    return 0
  fi
  if ! verdict="$("${prog}")"; then
    printf '%s\n' 'error'
    return 0
  fi
  printf '%s\n' "${verdict}"
}


upstream_status() {
  ## echo resolvable|not-resolvable|error for owner/repo@sha vs upstream master.
  local owner="$1" repo="$2" sha="$3"
  local json
  if ! json="$(github_get "/repos/${owner}/${repo}/compare/${UPSTREAM_BASE}...${sha}")"; then
    printf '%s\n' 'error'
    return 0
  fi
  printf '%s' "${json}" | classify_compare
}


canonical_owner() {
  ## The upstream orgs derivative-maker's submodules may live under. The URL in
  ## .gitmodules is data in the tree being checked, so it cannot be trusted to
  ## name the canonical upstream: repointing a submodule at a fork would
  ## otherwise make any fork-only commit 'resolvable'. Extend this list when a
  ## new upstream org is genuinely adopted.
  ## Compared case-insensitively: GitHub owner names are, so a URL spelling of
  ## 'kicksecure' is the same org and must not be reported as a fork.
  case "${1,,}" in
    kicksecure|whonix)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}


safe_slug_component() {
  ## An owner or repo is interpolated into a REST path. A '#' or '?' there
  ## truncates the request into a DIFFERENT, valid endpoint whose body has no
  ## 'status', which downgrades a hard failure to a warning. A '.' or '..'
  ## component is a path-traversal segment (from a URL like
  ## 'github.com/Kicksecure/../evil.git' -> repo '..'); curl normalises dot
  ## segments, so it would reach an endpoint other than the intended compare --
  ## reject those exact components too. Real GitHub owners/repos are never '.' or
  ## '..', so this rejects nothing legitimate.
  case "$1" in
    ''|'.'|'..'|*[!A-Za-z0-9._-]*)
      return 1
      ;;
    *)
      return 0
      ;;
  esac
}


github_owner_repo() {
  ## Print "owner<TAB>repo" for a URL whose HOST is exactly github.com
  ## (case-insensitive); return 1 for any other URL. The .gitmodules URL is
  ## untrusted tree data (the whole point of this check), so the host must be
  ## parsed and compared, never substring-matched: 'notgithub.com' contains the
  ## literal 'github.com', and 'https://attacker.example/github.com/o/r' carries
  ## it in the PATH -- both must be rejected, and a legitimate 'GitHub.com' host
  ## accepted. Handles scheme URLs (https/http/ssh/git, with optional userinfo
  ## and port) and the scp-like 'git@github.com:owner/repo' form.
  local url="$1" rest authority host path before
  case "${url}" in
    *://*)
      ## scheme://[userinfo@]authority[/path]. The authority ends at the FIRST
      ## of '/', '?' or '#' (RFC 3986), and only THEN is userinfo stripped:
      ##  - terminating on '/' alone let 'attacker.example?@github.com/o/r' keep
      ##    '?@github.com' in the authority and parse as github.com;
      ##  - stripping '@' from the whole remainder let a '@' in the PATH
      ##    ('attacker.example/a@github.com/o/r') hide the real host.
      rest="${url#*://}"
      authority="${rest%%/*}"
      authority="${authority%%\?*}"
      authority="${authority%%#*}"
      ## path = whatever follows the authority, minus any query/fragment. The
      ## leading slash(es) are stripped below with the trailing ones.
      path="${rest#"${authority}"}"
      path="${path%%\?*}"
      path="${path%%#*}"
      authority="${authority##*@}"
      host="${authority%%:*}"
      ;;
    *)
      ## Possible scp-like '[userinfo@]host:path' -- but ONLY when the part
      ## before the first ':' has no '/', '?' or '#', matching git (a '/' before
      ## the ':' makes it a local path, not a remote). Otherwise a '@' + ':' in a
      ## path ('attacker.example:fake@github.com:o/r') or a '?@'
      ## ('attacker.example?@github.com:o/r') would spoof the host too.
      before="${url%%:*}"
      if [ "${before}" = "${url}" ]; then
        return 1
      fi
      case "${before}" in
        */*|*\?*|*'#'*)
          return 1
          ;;
      esac
      host="${before##*@}"
      path="${url#*:}"
      path="${path%%\?*}"
      path="${path%%#*}"
      ;;
  esac
  case "${host,,}" in
    github.com)
      true "INFO: the authority is exactly github.com"
      ;;
    *)
      return 1
      ;;
  esac
  ## Trailing slashes off BEFORE '.git' then again after: '.../repo.git/' must
  ## strip to 'repo', and '%.git' does not match a string ending in a slash.
  while [ "${path}" != "${path%/}" ]; do
    path="${path%/}"
  done
  path="${path%.git}"
  while [ "${path}" != "${path%/}" ]; do
    path="${path%/}"
  done
  ## ALL leading slashes (a URL may spell 'github.com///owner/repo'); a single
  ## strip would leave a slash and make owner empty.
  while [ "${path}" != "${path#/}" ]; do
    path="${path#/}"
  done
  local owner repo
  owner="${path%%/*}"
  if [ "${owner}" = "${path}" ]; then
    ## No '/' separator: not an owner/repo pair.
    return 1
  fi
  repo="${path#*/}"
  repo="${repo%%/*}"
  if [ -z "${owner}" ] || [ -z "${repo}" ]; then
    return 1
  fi
  printf '%s%s%s\n' "${owner}" "${TAB}" "${repo}"
  return 0
}


gitmodules_url_for() {
  ## Print the .gitmodules URL declared for tree path ${1}; return 1 if the
  ## path has no stanza.
  ##
  ## On a duplicate path (two stanzas naming the same path) return the LAST
  ## one's URL, matching real git: 'git submodule init' registers the last
  ## stanza's URL for a path, so a decoy canonical stanza placed before an
  ## attacker one must not be what this check verifies.
  local wanted="$1"
  local modules="${repo_root}/.gitmodules"
  local entry key value name last_name=''
  if [ ! -f "${modules}" ]; then
    return 1
  fi
  ## -z output: each pair is 'key<newline>value<NUL>'. Splitting on the first
  ## newline is unambiguous where a space split is not -- a submodule NAME may
  ## itself contain spaces ('submodule.a name.path'), and a path may carry
  ## leading/trailing spaces; a 'key%% *' split mangles both.
  while IFS= read -r -d '' entry; do
    key="${entry%%$'\n'*}"
    value="${entry#*$'\n'}"
    if [ "${value}" != "${wanted}" ]; then
      continue
    fi
    name="${key#submodule.}"
    name="${name%.path}"
    last_name="${name}"
  done < <(git config --file "${modules}" -z --get-regexp '^submodule\..*\.path$')
  if [ -z "${last_name}" ]; then
    return 1
  fi
  ## --get returns the last value if the url is itself multi-valued, which is
  ## again what git resolves.
  git config --file "${modules}" --get "submodule.${last_name}.url" || return 1
  return 0
}


gitmodules_pairs() {
  ## Emit "path<TAB>url" for every submodule stanza in the .gitmodules file ${1}.
  ## Consumers key by path, so a duplicate path's later value overwrites -- the
  ## same last-wins git applies. Used to detect a repoint (URL change) between
  ## two refs. Missing file -> nothing, not an error.
  local modules="$1"
  if [ ! -f "${modules}" ]; then
    return 0
  fi
  local entry key value name url
  ## -z for the same reason as gitmodules_url_for (spaced names / paths). The
  ## emitted value AND url are neutralised for TAB / newline: git config decodes
  ## a quoted '\n'/'\t' in a URL into real bytes, which -- unsanitised -- would
  ## split this function's own tab-delimited output and let a crafted .gitmodules
  ## forge path/url pairs, defeating repoint detection.
  while IFS= read -r -d '' entry; do
    key="${entry%%$'\n'*}"
    value="${entry#*$'\n'}"
    name="${key#submodule.}"
    name="${name%.path}"
    url="$(git config --file "${modules}" --get "submodule.${name}.url")" || url=''
    value="${value//${TAB}/<TAB>}"
    value="${value//$'\n'/<LF>}"
    url="${url//${TAB}/<TAB>}"
    url="${url//$'\n'/<LF>}"
    printf '%s%s%s\n' "${value}" "${TAB}" "${url}"
  done < <(git config --file "${modules}" -z --get-regexp '^submodule\..*\.path$')
}


enumerate_gitlinks() {
  ## Emit "path<TAB>owner<TAB>repo<TAB>sha<TAB>problem" for every gitlink in the
  ## repo_root checkout's HEAD.
  ##
  ## The TREE is the source of truth, not .gitmodules: enumerating from the
  ## stanzas means a committed 160000 entry with no stanza -- or one whose
  ## stanza path does not match the tree exactly, e.g. a trailing slash -- is
  ## never looked at, and an unchecked pin must never be indistinguishable from
  ## a checked one. Anything that cannot be resolved to a canonical upstream is
  ## emitted WITH a problem rather than skipped, for the same reason.
  local record meta rest
  local mode otype sha path url owner_repo owner repo problem path_safe
  ## Capture ls-tree to a file and check its exit BEFORE the loop, rather than
  ## piping it in via process substitution: if ls-tree dies mid-stream on a
  ## corrupt/unreadable tree object it still prints the records up to that point,
  ## and a process substitution hides that failure from the loop -- enumerate
  ## would return 0 with a PARTIAL gitlink set, so a pin sorting after the
  ## corruption (e.g. a fork-only one) is silently never checked. -z output holds
  ## NUL bytes, so a file (not a command-substitution variable, which strips
  ## NUL) is the way to capture it. Fail closed on a bad enumeration.
  local ls_tree_out
  ls_tree_out="$(mktemp)"
  if ! git -C "${repo_root}" ls-tree -r -z HEAD > "${ls_tree_out}"; then
    rm --force -- "${ls_tree_out}"
    printf '%s\n' "::error::git ls-tree failed for ${repo_root}; enumeration incomplete" >&2
    return 1
  fi
  ## The record is split by hand rather than by 'read mode otype sha path':
  ## word splitting strips leading and trailing IFS whitespace from the last
  ## field, so a submodule path with a leading or trailing space would come
  ## back altered and then fail to match its own .gitmodules stanza.
  while IFS= read -r -d '' record; do
    meta="${record%%"${TAB}"*}"
    path="${record#*"${TAB}"}"
    mode="${meta%% *}"
    rest="${meta#* }"
    otype="${rest%% *}"
    sha="${rest##* }"
    if [ "${mode}" != '160000' ]; then
      continue
    fi
    problem=''
    owner=''
    repo=''
    ## -z output is unquoted, so a path may hold anything except NUL. A tab or
    ## a newline would split the record this function emits, so such a path is
    ## reported, never carried.
    path_safe="${path//${TAB}/<TAB>}"
    path_safe="${path_safe//$'\n'/<LF>}"
    if [ "${path_safe}" != "${path}" ]; then
      problem='submodule path contains a tab or newline'
    elif ! url="$(gitmodules_url_for "${path}")"; then
      problem='gitlink has no .gitmodules stanza, so its upstream is unknown'
    elif ! owner_repo="$(github_owner_repo "${url}")"; then
      ## Relative ('../foo.git'), non-GitHub, or host-spoofing URLs cannot be
      ## resolved against the GitHub API; sending them anyway produced a bogus
      ## request and a false verdict.
      problem="submodule URL is not a canonical github.com URL: ${url}"
    else
      owner="${owner_repo%%"${TAB}"*}"
      repo="${owner_repo#*"${TAB}"}"
      if ! safe_slug_component "${owner}" || ! safe_slug_component "${repo}"; then
        problem="unusable owner/repo in submodule URL: ${url}"
      elif ! canonical_owner "${owner}"; then
        problem="upstream owner '${owner}' is not a canonical upstream org"
      fi
    fi
    ## owner / repo / problem carry untrusted .gitmodules bytes (git config
    ## decodes a quoted '\n'/'\t' in a URL into real newline/tab). A newline
    ## here would split this line-oriented record in two, and every downstream
    ## consumer would read the forged half as a clean gitlink -- its owner/repo
    ## reaching the REST path never having passed safe_slug_component. Neutralise
    ## the framing bytes, exactly as path_safe already does for the path.
    owner="${owner//${TAB}/<TAB>}"
    owner="${owner//$'\n'/<LF>}"
    repo="${repo//${TAB}/<TAB>}"
    repo="${repo//$'\n'/<LF>}"
    problem="${problem//${TAB}/<TAB>}"
    problem="${problem//$'\n'/<LF>}"
    printf '%s\n' \
      "${path_safe}${TAB}${owner}${TAB}${repo}${TAB}${sha}${TAB}${problem}"
  done < "${ls_tree_out}"
  rm --force -- "${ls_tree_out}"
}


evaluate() {
  ## Read "path<TAB>owner<TAB>repo<TAB>sha<TAB>problem" lines on stdin, classify
  ## each via ${STATUS_FN}, print a report, and return 1 iff any pin THIS BRANCH
  ## introduced is not-resolvable. Errors (network / rate limit) are reported but
  ## do NOT fail the check.
  ##
  ## A not-resolvable / structurally-problematic gitlink is a HARD failure only
  ## when this branch INTRODUCED it relative to the parent-upstream merge base.
  ## A pin inherited verbatim from upstream (its path is absent from
  ## EVAL_INHERITED's complement -- i.e. present in EVAL_INHERITED) is upstream's
  ## to answer for: this fork may not deviate from it without failing the
  ## no-deviation invariant, so its unresolvable/problem verdict is a WARNING,
  ## never a red gate. That resolves the otherwise-standing conflict where the
  ## parent upstream's own master pins a submodule to a commit not on that
  ## submodule's GitHub mirror (canonical dev is elsewhere), which this fork
  ## faithfully mirrors. When attribution is unknown (EVAL_ATTRIBUTION_KNOWN
  ## false: no merge base, upstream unreachable, or the deviation check did not
  ## run) every verdict is treated as this branch's -- the conservative default
  ## for a standalone resolvability audit.
  local path owner repo sha problem verdict rest record
  local -a bad=() errored=() inherited=()
  local count=0 verified=0
  local attribution="${EVAL_ATTRIBUTION_KNOWN:-false}"
  ## Split each record by hand rather than 'IFS="${TAB}" read path owner repo
  ## sha problem'. A tab is IFS-whitespace, so read COLLAPSES a run of them: a
  ## problem record with empty owner AND repo (an orphan gitlink with no stanza,
  ## a non-github URL, a tab/newline path -- exactly the shapes that must fail)
  ## comes back with its fields shifted left, the problem text landing in 'repo'
  ## and 'problem' emptied, so the hard-fail branch is silently skipped and the
  ## pin is only warned. Manual %%/# splitting preserves empty interior fields.
  while IFS= read -r record; do
    if [ -z "${record}" ]; then
      continue
    fi
    path="${record%%"${TAB}"*}"
    rest="${record#*"${TAB}"}"
    owner="${rest%%"${TAB}"*}"
    rest="${rest#*"${TAB}"}"
    repo="${rest%%"${TAB}"*}"
    rest="${rest#*"${TAB}"}"
    ## 'rest' is now 'sha' (a 4-field self-test record) or 'sha<TAB>problem' (the
    ## 5-field enumerate record, whose problem may be empty but whose tab is
    ## present). No trailing tab means no problem field.
    sha="${rest%%"${TAB}"*}"
    if [ "${rest}" = "${sha}" ]; then
      problem=''
    else
      problem="${rest#*"${TAB}"}"
    fi
    if [ -z "${path}" ]; then
      continue
    fi
    count=$(( count + 1 ))
    ## A pin whose upstream could not even be determined is ALWAYS a hard
    ## failure, never inheritance-cleared: a structural problem lives in the
    ## .gitmodules DEFINITION (a repoint, a missing stanza, a non-github URL),
    ## and inheritance here is judged by the gitlink SHA at the merge base, which
    ## a definition change does not move. Downgrading it to a warning would let a
    ## submodule repointed at a fork while keeping the same SHA pass as
    ## 'inherited'. It is exactly the shape a repointed submodule takes.
    if [ -n "${problem}" ]; then
      bad+=("${path} @ ${sha} -- ${problem}")
      continue
    fi
    verdict="$("${STATUS_FN}" "${owner}" "${repo}" "${sha}")"
    case "${verdict}" in
      resolvable)
        verified=$(( verified + 1 ))
        ;;
      not-resolvable)
        if [ "${attribution}" = 'true' ] && [ -n "${EVAL_INHERITED[${path}]:-}" ]; then
          inherited+=("${path} @ ${sha} -- upstream ${owner}/${repo}")
        else
          bad+=("${path} @ ${sha} -- upstream ${owner}/${repo}")
        fi
        ;;
      *)
        errored+=("${path} @ ${sha} -- upstream ${owner}/${repo} (${verdict})")
        ;;
    esac
  done

  local entry
  if (( ${#errored[@]} > 0 )); then
    printf '%s\n' \
      '::warning::could not verify some gitlinks (network / rate limit); not failing on these' >&2
    for entry in "${errored[@]}"; do
      printf '%s\n' "  [warn] ${entry}" >&2
    done
  fi

  ## Inherited-from-upstream pins that do not resolve on their submodule mirror:
  ## reported so the upstream-lag signal is not lost, but never a red gate here.
  if (( ${#inherited[@]} > 0 )); then
    printf '%s\n' \
      '::warning::gitlink(s) not on the submodule upstream master, but INHERITED verbatim from the parent upstream (equal at the merge base); upstream owns these and this fork may not deviate, so not failing:' >&2
    for entry in "${inherited[@]}"; do
      printf '%s\n' "  [warn:upstream] ${entry}" >&2
    done
  fi

  if (( ${#bad[@]} > 0 )); then
    printf '%s\n' \
      '::error::submodule gitlink(s) NOT verified against a canonical upstream master:' >&2
    for entry in "${bad[@]}"; do
      printf '%s\n' "  [FAIL] ${entry}" >&2
    done
    printf '%s\n' \
      'A gitlink this branch introduces must point to a commit that exists on the' \
      "submodule upstream's master, under a canonical upstream org. Bump the pin to" \
      'an upstream-merged commit, or land the submodule work upstream first. See' \
      'the git / derivative-maker skills.' >&2
    return 1
  fi

  ## Some pins erroring is tolerated so a flaky API does not turn CI red. NONE
  ## of them resolving is a different thing: the sweep did not happen, and a
  ## run that verified nothing must not report success. An all-INHERITED run is
  ## NOT that case: those pins provably equal upstream master's, which is exactly
  ## this fork's compliance, so it passes even with zero independently resolved.
  if (( count > 0 )) && (( verified == 0 )) && (( ${#inherited[@]} == 0 )); then
    printf '%s\n' \
      "::error::not one of the ${count} gitlink(s) could be verified; the upstream sweep did not run (no token? rate limited?)" >&2
    return 2
  fi

  ## Report what was actually verified. Counting the errored pins here would
  ## claim a rate-limited run checked them.
  local suffix=''
  if (( ${#inherited[@]} > 0 )); then
    suffix="; ${#inherited[@]} inherited from upstream (see warnings)"
  fi
  if (( ${#errored[@]} > 0 )); then
    printf '%s\n' \
      "PASSED: ${verified} of ${count} gitlink(s) reachable on upstream master; ${#errored[@]} NOT verified (see warnings above)${suffix}."
    return 0
  fi
  printf '%s\n' "PASSED: ${verified} gitlink(s) reachable on upstream master${suffix}."
  return 0
}


deepen_history() {
  ## merge-base needs this checkout's history back to the fork point. A shallow
  ## clone (actions/checkout's default depth 1) has none of it, and only the
  ## repo's OWN origin carries the fork-only commits, so upstream cannot supply
  ## them. Returns 2 when the history is unobtainable: a setup error is loud and
  ## deterministic, unlike a network warning, and must not read as a pass.
  ## Guard the probe: as the left side of 'deepen_history || rc=$?', errexit is
  ## suspended for this whole call, so an unguarded failing rev-parse (a corrupt
  ## or truncated .git/shallow) would leave 'shallow' empty, read as 'not
  ## shallow', return 0, and the later merge-base fetch would then misreport a
  ## LOCAL fault as a network warning -- silently skipping invariant 2. A probe
  ## that cannot answer is a setup error.
  local shallow
  if ! shallow="$(git -C "${repo_root}" rev-parse --is-shallow-repository)"; then
    printf '%s\n' \
      '::error::could not determine whether the checkout is shallow (corrupt .git/shallow?)' >&2
    return 2
  fi
  if [ "${shallow}" != 'true' ]; then
    return 0
  fi
  if ! git -C "${repo_root}" remote get-url origin >/dev/null 2>&1; then
    printf '%s\n' \
      '::error::shallow checkout with no origin remote to deepen from; cannot compute the merge base' >&2
    return 2
  fi
  if ! git -C "${repo_root}" fetch --quiet --no-tags --filter=blob:none --unshallow origin; then
    printf '%s\n' '::error::could not deepen the shallow checkout from origin' >&2
    return 2
  fi
  return 0
}


parent_merge_base() {
  ## Print the merge base of the parent upstream branch and this checkout's
  ## HEAD. --filter=blob:none keeps the fetch to commits and trees; gitlink
  ## entries live in trees, so no blob is ever needed.
  ##
  ## The two failure modes are NOT the same and must not share an exit code:
  ##   1  the fetch did not get through -- transport, warn, do not fail a run
  ##   2  there is no merge base, or HEAD is unusable -- nothing was checked,
  ##      which is a setup error and must never read as a pass
  local base
  if ! git -C "${repo_root}" fetch --quiet --no-tags --filter=blob:none \
       -- "${parent_upstream_url}" "${parent_upstream_branch}"; then
    return 1
  fi
  if ! base="$(git -C "${repo_root}" merge-base FETCH_HEAD HEAD)"; then
    return 2
  fi
  if [ -z "${base}" ]; then
    return 2
  fi
  printf '%s\n' "${base}"
}


valid_upstream_url() {
  ## A git URL may name a remote HELPER ('ext::sh -c ...'), which git executes.
  ## Only the transports this check needs are accepted, so an argv assembled
  ## from an untrusted value cannot turn into command execution.
  case "$1" in
    https://*|http://*|git://*|ssh://*|file://*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}


parent_deviations() {
  ## Emit "path<TAB>base_sha<TAB>head_sha" for every gitlink this checkout moves
  ## relative to ${1}, the merge base. Either side being mode 160000 counts, so
  ## an added or removed submodule is caught as well as a moved pointer.
  ## Returns 1 if the diff itself fails.
  local base="$1"
  local raw_file meta oldmode newmode oldsha newsha status path
  ## -z output, to a FILE: the path must come back with the EXACT bytes
  ## enumerate_gitlinks emits (it uses 'ls-tree -z', raw), or main()'s
  ## attribution keyed on those bytes mis-matches. Without -z, git C-quotes any
  ## path holding a '"', '\', tab, newline or control byte (even under
  ## core.quotePath=false, which only governs bytes >0x80), so 'weird"path'
  ## comes back as '"weird\"path"' -- a different key -- and a genuinely
  ## deviating pin is then mis-attributed as inherited. -z emits the raw path;
  ## a file (not a command-substitution variable, which strips the NUL) carries
  ## the NUL-delimited stream, and > redirection surfaces a git failure.
  ##   --no-abbrev: SHAs meant to be pasted into a git command.
  ##   --no-renames: rename detection would emit TWO paths in one record.
  ##   --ignore-submodules=none: load-bearing -- a committed '.gitmodules'
  ##     'ignore = all' (or a diff.ignoreSubmodules config) otherwise hides a
  ##     160000 SHA move, so a moved pin would look inherited and be downgraded
  ##     to a warning, a bypass of BOTH invariants. The flag overrides it.
  raw_file="$(mktemp)"
  if ! git -C "${repo_root}" -c core.quotePath=false \
       diff --raw --no-abbrev --no-renames --ignore-submodules=none -z \
       "${base}" HEAD > "${raw_file}"; then
    rm --force -- "${raw_file}"
    return 1
  fi
  ## -z raw format per record: ':mode mode oldsha newsha status' NUL, then the
  ## path NUL. Read them as two NUL-delimited fields, so the path is verbatim.
  while IFS= read -r -d '' meta; do
    IFS= read -r -d '' path || break
    read -r oldmode newmode oldsha newsha status <<< "${meta}"
    if [ "${oldmode#:}" != '160000' ] && [ "${newmode}" != '160000' ]; then
      continue
    fi
    ## Neutralise TAB/LF in the path IDENTICALLY to enumerate_gitlinks'
    ## path_safe. A git tree path may hold any byte but NUL and '/', so a raw
    ## TAB/LF (now that -z stopped git from C-quoting them) would desync this
    ## function's own tab-delimited, line-oriented record -- keying
    ## PARENT_DEV_PATHS by a truncated path and poisoning an UNRELATED
    ## submodule's attribution. Using the same neutralisation on both sides
    ## keeps the keys byte-identical.
    path="${path//${TAB}/<TAB>}"
    path="${path//$'\n'/<LF>}"
    printf '%s\n' "${path}${TAB}${oldsha}${TAB}${newsha}"
  done < "${raw_file}"
  rm --force -- "${raw_file}"
}


check_parent_deviation() {
  ## Fail iff this checkout moves any gitlink relative to its merge base with
  ## the parent upstream. Returns 0 clean, 1 deviating, 2 setup error.
  ##
  ## Side effect: on a definitive comparison (base reached and diffed) sets
  ## PARENT_ATTRIBUTION_KNOWN=true and keys every moved gitlink path into
  ## PARENT_DEV_PATHS, so main() can scope invariant 1's blame to what this
  ## branch actually introduced without a second fetch. A transport failure or
  ## setup error leaves PARENT_ATTRIBUTION_KNOWN=false, so attribution is never
  ## faked from a run that did not compare.
  PARENT_ATTRIBUTION_KNOWN='false'
  PARENT_DEV_PATHS=()
  PARENT_URL_CHANGED_PATHS=()

  local rc=0
  deepen_history || rc=$?
  if (( rc != 0 )); then
    return "${rc}"
  fi

  local base mb_rc=0
  base="$("${MERGE_BASE_FN}")" || mb_rc=$?
  if (( mb_rc == 1 )); then
    printf '%s\n' \
      "::warning::could not reach ${parent_upstream_url}; no-deviation check not run" >&2
    return 0
  fi
  if (( mb_rc != 0 )); then
    printf '%s\n' \
      "::error::no merge base between ${parent_upstream_url} ${parent_upstream_branch} and HEAD of ${repo_root}" >&2
    return 2
  fi

  ## Same reason as in parent_deviations: a failure here must not arrive as an
  ## empty result set, which would print PASSED.
  local raw
  if ! raw="$(parent_deviations "${base}")"; then
    printf '%s\n' \
      "::error::could not diff ${repo_root} against merge base ${base}" >&2
    return 2
  fi

  local path base_sha head_sha
  local -a deviations=()
  while IFS="${TAB}" read -r path base_sha head_sha; do
    if [ -z "${path}" ]; then
      continue
    fi
    deviations+=("${path}: ${base_sha} (merge base) -> ${head_sha} (this branch)")
    PARENT_DEV_PATHS["${path}"]=1
  done <<< "${raw}"

  ## Repoint detection: a path whose .gitmodules URL changed vs the merge base is
  ## disqualified from inheritance even with an unchanged gitlink SHA. Read both
  ## .gitmodules blobs; if EITHER read fails (a blob:none partial clone whose
  ## promisor is now unreachable, or base predates .gitmodules), SKIP detection
  ## rather than mark everything changed -- marking all-changed would demote no
  ## pin and instead HARD-FAIL every inherited unresolvable pin, the exact
  ## false-red this tool exists to avoid. SHA-only attribution is the safe
  ## fallback there.
  local gm_base gm_head
  gm_base="$(mktemp)"
  gm_head="$(mktemp)"
  if git -C "${repo_root}" show "${base}:.gitmodules" > "${gm_base}" 2>/dev/null \
     && git -C "${repo_root}" show 'HEAD:.gitmodules' > "${gm_head}" 2>/dev/null; then
    local -A _base_url=() _head_url=()
    local gp_line gp_path gp_url up
    ## Split each 'path<TAB>url' line by hand, NOT 'IFS="${TAB}" read gp_path
    ## gp_url': a tab is IFS-whitespace, so read collapses a LEADING tab -- and
    ## gitmodules_pairs legitimately emits '<TAB>url' for a stanza with an empty
    ## 'path =' value. A collapsing read would then take that url AS the path and
    ## clobber a real entry (a decoy stanza 'path = ' / 'url = <victim-path>'
    ## would empty the victim's recorded url, hiding a repoint). Manual %%/#
    ## keeps the empty first field, so the empty-path record is skipped.
    while IFS= read -r gp_line; do
      gp_path="${gp_line%%"${TAB}"*}"
      gp_url="${gp_line#*"${TAB}"}"
      if [ -n "${gp_path}" ]; then
        _base_url["${gp_path}"]="${gp_url}"
      fi
    done < <(gitmodules_pairs "${gm_base}")
    while IFS= read -r gp_line; do
      gp_path="${gp_line%%"${TAB}"*}"
      gp_url="${gp_line#*"${TAB}"}"
      if [ -n "${gp_path}" ]; then
        _head_url["${gp_path}"]="${gp_url}"
      fi
    done < <(gitmodules_pairs "${gm_head}")
    for up in "${!_head_url[@]}" "${!_base_url[@]}"; do
      if [ "${_head_url[${up}]:-}" != "${_base_url[${up}]:-}" ]; then
        PARENT_URL_CHANGED_PATHS["${up}"]=1
      fi
    done
  fi
  rm --force -- "${gm_base}" "${gm_head}"

  ## The comparison ran to a verdict (zero or more deviations); attribution is
  ## now trustworthy.
  PARENT_ATTRIBUTION_KNOWN='true'

  local entry
  if (( ${#deviations[@]} > 0 )); then
    printf '%s\n' \
      '::error::submodule gitlink(s) deviate from the parent upstream merge base:' >&2
    for entry in "${deviations[@]}"; do
      printf '%s\n' "  [FAIL] ${entry}" >&2
    done
    printf '%s\n' \
      'An upstream merge of this branch then conflicts on the submodule for anyone' \
      'who has not checked it out: git needs the submodule objects to decide which' \
      "pointer wins, and a maintainer's clone does not have them. Restore the SHA the" \
      "merge base records, and carry submodule bumps on the 'ai' branch instead." >&2
    return 1
  fi

  printf '%s\n' \
    "PASSED: no gitlink deviates from ${parent_upstream_url} at merge base ${base:0:9}."
  return 0
}


parent_check_applies() {
  ## Decide whether the no-deviation check runs against this checkout.
  local branch head ref candidate
  case "${parent_check}" in
    never)
      return 1
      ;;
    always)
      return 0
      ;;
    *)
      true "INFO: auto mode; the checkout decides"
      ;;
  esac
  branch="$(git -C "${repo_root}" branch --show-current)"
  if [ "${branch}" = "${PARENT_CHECK_BRANCH}" ]; then
    return 0
  fi
  ## A detached HEAD is not evidence that this is not master: a tag build or a
  ## workflow_dispatch can check the master commit out detached, and skipping
  ## there would silently drop the check on the very branch it guards. Treat a
  ## detached HEAD that IS the master commit as master.
  if [ -z "${branch}" ]; then
    head="$(git -C "${repo_root}" rev-parse HEAD)"
    for ref in "refs/heads/${PARENT_CHECK_BRANCH}" \
               "refs/remotes/origin/${PARENT_CHECK_BRANCH}"; do
      candidate="$(git -C "${repo_root}" rev-parse --verify --quiet "${ref}")" || continue
      if [ "${candidate}" = "${head}" ]; then
        return 0
      fi
    done
  fi
  printf '%s\n' \
    "SKIPPED: no-deviation check applies to ${PARENT_CHECK_BRANCH} only (on ${branch:-a detached HEAD})."
  return 1
}


self_test() {
  ## Offline regression test for evaluate(): stub the resolver by SHA prefix
  ## (bad* -> not-resolvable, err* -> error, else resolvable) and assert the
  ## exit code AND the reported list in both directions. FAILS on a tree without
  ## this tool, which is the point of the regression.
  STATUS_FN='_self_test_status'
  _self_test_status() {
    case "$3" in
      bad*)
        printf '%s\n' 'not-resolvable'
        ;;
      err*)
        printf '%s\n' 'error'
        ;;
      *)
        printf '%s\n' 'resolvable'
        ;;
    esac
  }

  local rc fails=0 out

  ## Case A: all resolvable -> exit 0.
  rc=0
  printf '%s\n' \
    "sub-a${TAB}Kicksecure${TAB}a${TAB}good1" \
    "sub-b${TAB}Kicksecure${TAB}b${TAB}good2" \
    | evaluate >/dev/null 2>&1 || rc=$?
  if (( rc != 0 )); then
    printf '%s\n' "self-test FAIL: all-resolvable set returned ${rc}, expected 0" >&2
    fails=$(( fails + 1 ))
  fi

  ## Case B: one fork-only pin -> exit 1, and it is named.
  rc=0
  out="$(printf '%s\n' \
    "sub-a${TAB}Kicksecure${TAB}a${TAB}good1" \
    "sub-b${TAB}Whonix${TAB}b${TAB}bad9" \
    | evaluate 2>&1)" || rc=$?
  if (( rc != 1 )); then
    printf '%s\n' "self-test FAIL: fork-only set returned ${rc}, expected 1" >&2
    fails=$(( fails + 1 ))
  fi
  case "${out}" in
    *'sub-b @ bad9'*)
      true "INFO: the fork-only pin was named, as required"
      ;;
    *)
      printf '%s\n' 'self-test FAIL: fork-only pin not reported in output' >&2
      fails=$(( fails + 1 ))
      ;;
  esac

  ## Case C: an errored pin only (no fork-only) -> exit 0 (errors do not fail).
  rc=0
  printf '%s\n' \
    "sub-a${TAB}Kicksecure${TAB}a${TAB}good1" \
    "sub-c${TAB}Kicksecure${TAB}c${TAB}err7" \
    | evaluate >/dev/null 2>&1 || rc=$?
  if (( rc != 0 )); then
    printf '%s\n' "self-test FAIL: error-only set returned ${rc}, expected 0" >&2
    fails=$(( fails + 1 ))
  fi

  ## Case D: a missing classifier degrades to an 'error' verdict, it does NOT
  ## crash the sweep. The old body ran '"$(classify_compare_program)"' bare, so a
  ## failed lookup expanded to the empty string and aborted the whole run under
  ## errexit (empty command -> 127) on the first gitlink. The stub is scoped to a
  ## subshell so it cannot leak into the other self-test suites.
  local cc_out cc_rc=0
  cc_out="$(
    classify_compare_program() {
      printf '%s\n' '::error::classifier missing' >&2
      return 2
    }
    printf '%s' '{}' | classify_compare 2>/dev/null
  )" || cc_rc=$?
  if (( cc_rc != 0 )); then
    printf '%s\n' "self-test FAIL: missing classifier returned ${cc_rc}, expected 0 (must not crash)" >&2
    fails=$(( fails + 1 ))
  fi
  if [ "${cc_out}" != 'error' ]; then
    printf '%s\n' "self-test FAIL: missing classifier verdict '${cc_out}', expected 'error'" >&2
    fails=$(( fails + 1 ))
  fi

  if (( fails > 0 )); then
    printf '%s\n' "self-test: ${fails} assertion(s) FAILED" >&2
    return 1
  fi
  printf '%s\n' 'self-test: PASSED (4 cases)'
  return 0
}


enumerate_self_test() {
  ## Regression test for the enumerator against a real tree: every gitlink is
  ## reported, and one whose upstream cannot be established as canonical comes
  ## back WITH a problem instead of being silently dropped.
  local tmp fails=0 records
  local sha='4444444444444444444444444444444444444444'
  parent_self_test_tmp="$(mktemp --directory)"
  tmp="${parent_self_test_tmp}"
  trap parent_self_test_cleanup RETURN

  fixture_git init --quiet "${tmp}/tree"
  ## The 'sneaky' URL is quoted in the fixture on purpose: unquoted, git config
  ## strips from '#' onward as a comment, and the stanza would no longer carry
  ## the character the case exists to test.
  {
    printf '%s\n' '[submodule "good"]' \
      '	path = good' \
      '	url = https://github.com/Kicksecure/good.git' \
      '[submodule "forked"]' \
      '	path = forked' \
      '	url = https://github.com/attacker/forked.git' \
      '[submodule "elsewhere"]' \
      '	path = elsewhere' \
      '	url = ../elsewhere.git' \
      '[submodule "sneaky"]' \
      '	path = sneaky' \
      '	url = "https://github.com/Kicksecure/sneaky#x.git"' \
      '[submodule "lower"]' \
      '	path = lower' \
      '	url = https://github.com/kicksecure/lower.git' \
      '[submodule "slash"]' \
      '	path = slash' \
      '	url = https://github.com/Kicksecure/slash.git/' \
      '[submodule "spaced"]' \
      '	path = " a spaced path "' \
      '	url = https://github.com/Kicksecure/spaced.git' \
      '[submodule "hostspoof"]' \
      '	path = hostspoof' \
      '	url = https://notgithub.com/Kicksecure/hostspoof.git' \
      '[submodule "pathspoof"]' \
      '	path = pathspoof' \
      '	url = https://attacker.example/github.com/Kicksecure/pathspoof.git' \
      '[submodule "mixedcase"]' \
      '	path = mixedcase' \
      '	url = https://GitHub.com/Kicksecure/mixedcase.git' \
      '[submodule "dup-decoy"]' \
      '	path = dup' \
      '	url = https://github.com/Kicksecure/legit.git' \
      '[submodule "dup-real"]' \
      '	path = dup' \
      '	url = https://github.com/attacker/evil.git' \
      '[submodule "atpath"]' \
      '	path = atpath' \
      '	url = https://attacker.example/a@github.com/Kicksecure/atpath.git' \
      '[submodule "atscp"]' \
      '	path = atscp' \
      '	url = attacker.example:fake@github.com:Kicksecure/atscp.git' \
      '[submodule "multislash"]' \
      '	path = multislash' \
      '	url = https://github.com///Kicksecure/multislash.git' \
      '[submodule "a spaced name"]' \
      '	path = spacedname' \
      '	url = https://github.com/Kicksecure/spacedname.git' \
      '[submodule "evilnl"]' \
      '	path = evilnl' \
      '	url = "https://evil.example/x\ninjected\tKicksecure\tgoodrepo\t1111111111111111111111111111111111111111\t"' \
      '[submodule "queryspoof"]' \
      '	path = queryspoof' \
      '	url = https://attacker.example?@github.com/Kicksecure/queryspoof.git' \
      '[submodule "fragspoof"]' \
      '	path = fragspoof' \
      '	url = "https://attacker.example#@github.com/Kicksecure/fragspoof.git"' \
      '[submodule "scpqspoof"]' \
      '	path = scpqspoof' \
      '	url = attacker.example?@github.com:Kicksecure/scpqspoof.git' \
      '[submodule "unsafeslug"]' \
      '	path = unsafeslug' \
      '	url = "https://github.com/Kicksecure/unsafe slug.git"' \
      '[submodule "dotdot"]' \
      '	path = dotdot' \
      '	url = https://github.com/Kicksecure/../evilrepo.git' \
      '[submodule "singledot"]' \
      '	path = singledot' \
      '	url = https://github.com/Kicksecure/./repo.git'
  } > "${tmp}/tree/.gitmodules"
  fixture_git -C "${tmp}/tree" add .gitmodules
  local sub
  ## 'orphan' deliberately gets NO stanza.
  for sub in good forked elsewhere sneaky orphan lower slash ' a spaced path ' \
             hostspoof pathspoof mixedcase dup atpath atscp multislash \
             spacedname evilnl queryspoof fragspoof scpqspoof unsafeslug \
             dotdot singledot; do
    fixture_git -C "${tmp}/tree" update-index --add --cacheinfo "160000,${sha},${sub}"
  done
  fixture_git -C "${tmp}/tree" commit --quiet --message 'fixture tree'

  repo_root="${tmp}/tree"
  records="$(enumerate_gitlinks)"

  assert_record() {
    ## Assert the record for tree path ${2} carries ${3} in its problem field.
    ## Matching on path plus problem, not on the exact field layout, so the
    ## test does not break when a diagnostic gains a field.
    local label="$1" want_path="$2" pattern="$3"
    local line found='false'
    while IFS= read -r line; do
      case "${line}" in
        "${want_path}${TAB}"*)
          case "${line}" in
            *"${pattern}"*)
              found='true'
              ;;
            *)
              true "INFO: right path, wrong problem; keep looking"
              ;;
          esac
          ;;
        *)
          true "INFO: a different submodule's record"
          ;;
      esac
    done <<< "${records}"
    if [ "${found}" = 'true' ]; then
      return 0
    fi
    printf '%s\n' "enumerate self-test FAIL: ${label}; got:" "${records}" >&2
    fails=$(( fails + 1 ))
  }

  assert_clean_record() {
    ## Assert the record for ${2} is EXACTLY path/owner/repo/sha with an empty
    ## problem field. A substring match would also match the same record
    ## carrying a problem, so it could not tell acceptance from rejection --
    ## which is how the first version of these cases passed a canary it should
    ## have failed.
    local label="$1" want_path="$2" want_owner="$3" want_repo="$4"
    local want line
    want="${want_path}${TAB}${want_owner}${TAB}${want_repo}${TAB}${sha}${TAB}"
    while IFS= read -r line; do
      if [ "${line}" = "${want}" ]; then
        return 0
      fi
    done <<< "${records}"
    printf '%s\n' "enumerate self-test FAIL: ${label}; got:" "${records}" >&2
    fails=$(( fails + 1 ))
  }

  ## The canonical one resolves, with an empty problem field.
  assert_clean_record 'canonical pin resolves' 'good' 'Kicksecure' 'good'
  ## A repointed submodule must not be able to vouch for itself.
  assert_record 'fork owner rejected' 'forked' \
    "upstream owner 'attacker' is not a canonical upstream org"
  ## A relative URL must not be sent to the GitHub API.
  assert_record 'relative URL rejected' 'elsewhere' \
    'submodule URL is not a canonical github.com URL'
  ## A '#' AFTER the owner/repo is a fragment (git/curl drop it), so it resolves
  ## cleanly to Kicksecure/sneaky -- and crucially the '#' never reaches the REST
  ## path. (An authority-position '#'/'?' spoof is the queryspoof/fragspoof case.)
  assert_clean_record 'path fragment stripped, resolves clean' 'sneaky' \
    'Kicksecure' 'sneaky'
  ## An owner/repo left unsafe AFTER parsing (a space here) is still rejected, so
  ## no unusable slug reaches the REST path.
  assert_record 'unsafe slug rejected' 'unsafeslug' \
    'unusable owner/repo in submodule URL'
  ## A '..' or '.' repo component is a path-traversal segment curl would
  ## normalise into a different endpoint; reject it, do not query it live.
  assert_record 'dotdot repo component rejected' 'dotdot' \
    'unusable owner/repo in submodule URL'
  assert_record 'singledot repo component rejected' 'singledot' \
    'unusable owner/repo in submodule URL'
  ## A gitlink with no stanza used to be invisible.
  assert_record 'orphan gitlink reported' 'orphan' \
    'gitlink has no .gitmodules stanza'
  ## GitHub owners are case-insensitive, so this is the same org, not a fork.
  assert_clean_record 'lowercase owner accepted' 'lower' 'kicksecure' 'lower'
  ## '.git/' must strip to the repo name, not leave 'slash.git'.
  assert_clean_record 'trailing slash stripped' 'slash' 'Kicksecure' 'slash'
  ## Word splitting used to eat the surrounding spaces, after which the path
  ## no longer matched its own stanza and was reported as an orphan.
  assert_clean_record 'spaced path keeps its spaces' ' a spaced path ' \
    'Kicksecure' 'spaced'
  ## Host-spoof: 'github.com' as a SUBSTRING of the real host must be rejected,
  ## not read as a canonical GitHub URL.
  assert_record 'notgithub.com host rejected' 'hostspoof' \
    'not a canonical github.com URL'
  ## ... and 'github.com' in the URL PATH, real host elsewhere, likewise.
  assert_record 'github.com in path rejected' 'pathspoof' \
    'not a canonical github.com URL'
  ## A real GitHub host differing only in letter case is canonical, not a
  ## structural problem (was a false-positive hard failure).
  assert_clean_record 'mixed-case host accepted' 'mixedcase' 'Kicksecure' 'mixedcase'
  ## Duplicate path: real git registers the LAST stanza's URL, so the attacker
  ## stanza (second) is what must be checked, not the canonical decoy (first).
  assert_record 'duplicate path uses last stanza' 'dup' \
    "upstream owner 'attacker' is not a canonical upstream org"
  ## A '@' in the PATH of a scheme URL must not hide the real host: the
  ## authority is split off before userinfo is stripped.
  assert_record 'scheme userinfo-in-path spoof rejected' 'atpath' \
    'not a canonical github.com URL'
  ## Same for an scp-like URL with a '@' + ':' further along.
  assert_record 'scp userinfo-in-path spoof rejected' 'atscp' \
    'not a canonical github.com URL'
  ## Multiple leading slashes after the host must all strip, not leave an empty
  ## owner (was a false-positive rejection of a canonical URL).
  assert_clean_record 'multiple slashes stripped' 'multislash' \
    'Kicksecure' 'multislash'
  ## A submodule NAME containing spaces must still resolve its url (the -z parse
  ## keeps key and value unambiguous where a space split does not).
  assert_clean_record 'spaced submodule name resolves' 'spacedname' \
    'Kicksecure' 'spacedname'
  ## Newline injection: git config decodes a quoted '\n' in a url to a real
  ## newline; unsanitised it would split evilnl's record and forge a clean
  ## 'Kicksecure/goodrepo' pin. The whole url must stay on one line.
  assert_record 'newline url stays one record' 'evilnl' \
    'not a canonical github.com URL'
  ## A '?' or '#' terminates the authority (RFC 3986): a userinfo-looking
  ## '?@github.com' / '#@github.com' after the real host must not spoof it.
  assert_record 'query-delimited authority spoof rejected' 'queryspoof' \
    'not a canonical github.com URL'
  assert_record 'fragment-delimited authority spoof rejected' 'fragspoof' \
    'not a canonical github.com URL'
  assert_record 'scp query-in-host spoof rejected' 'scpqspoof' \
    'not a canonical github.com URL'
  case "${records}" in
    *"${TAB}goodrepo${TAB}"*)
      printf '%s\n' 'enumerate self-test FAIL: newline-injected forged record present' >&2
      fails=$(( fails + 1 ))
      ;;
    *)
      true "INFO: no forged record framed by the injected newline"
      ;;
  esac

  ## Each problem must FAIL the evaluator, not warn.
  local rc=0 out
  STATUS_FN='_enumerate_self_test_status'
  _enumerate_self_test_status() {
    printf '%s\n' 'resolvable'
  }
  out="$(evaluate <<< "${records}" 2>&1)" || rc=$?
  if (( rc != 1 )); then
    printf '%s\n' "enumerate self-test FAIL: problem records returned ${rc}, expected 1" >&2
    fails=$(( fails + 1 ))
  fi

  ## And each empty-owner-AND-repo problem record must fail ON ITS OWN. These
  ## ('orphan' has no stanza; 'elsewhere' is a relative URL) carry two adjacent
  ## tabs, which a tab-collapsing read shifts into the wrong fields, emptying the
  ## problem and downgrading the pin to a resolvable-looking warning. Fed with
  ## the batch above they hide behind 'forked'/'sneaky', which parse cleanly, so
  ## this asserts them singly. STATUS_FN returns resolvable, so the ONLY thing
  ## that can fail the run is the problem branch actually firing.
  local prob_path prob_rec
  for prob_path in orphan elsewhere; do
    prob_rec=''
    while IFS= read -r line; do
      case "${line}" in
        "${prob_path}${TAB}"*)
          prob_rec="${line}"
          ;;
        *)
          true "INFO: a different submodule's record"
          ;;
      esac
    done <<< "${records}"
    if [ -z "${prob_rec}" ]; then
      printf '%s\n' "enumerate self-test FAIL: no record enumerated for '${prob_path}'" >&2
      fails=$(( fails + 1 ))
      continue
    fi
    rc=0
    printf '%s\n' "${prob_rec}" | evaluate >/dev/null 2>&1 || rc=$?
    if (( rc != 1 )); then
      printf '%s\n' "enumerate self-test FAIL: lone '${prob_path}' problem record returned ${rc}, expected 1 (tab-collapse misparse?)" >&2
      fails=$(( fails + 1 ))
    fi
  done

  ## The PASSED line must not claim unverified pins were verified. 'b' errors,
  ## 'a' resolves, so the run is a partial success and stays green.
  STATUS_FN='_enumerate_self_test_one_error'
  _enumerate_self_test_one_error() {
    case "$3" in
      err*)
        printf '%s\n' 'error'
        ;;
      *)
        printf '%s\n' 'resolvable'
        ;;
    esac
  }
  rc=0
  out="$(printf '%s\n' \
    "a${TAB}Kicksecure${TAB}a${TAB}good1${TAB}" \
    "b${TAB}Kicksecure${TAB}b${TAB}err2${TAB}" \
    | evaluate 2>&1)" || rc=$?
  case "${out}" in
    *'PASSED: 1 of 2 gitlink(s)'*'1 NOT verified'*)
      true "INFO: the count reflects what was actually verified"
      ;;
    *)
      printf '%s\n' 'enumerate self-test FAIL: PASSED line overcounts; got:' "${out}" >&2
      fails=$(( fails + 1 ))
      ;;
  esac

  ## The wrapper must be found from the checkout, not only from an install:
  ## in CI nothing is installed and github-api is simply the file next to this
  ## script. Asserted with a PATH that deliberately has no github-api.
  local saved_script_dir="${script_dir}"
  mkdir -p "${tmp}/withapi" "${tmp}/without"
  printf '%s\n' '#!/bin/bash' 'true' > "${tmp}/withapi/github-api"
  chmod 0755 "${tmp}/withapi/github-api"

  script_dir="${tmp}/withapi"
  local resolved
  resolved="$(PATH="${tmp}/without" git_api_program)"
  if [ "${resolved}" != "${tmp}/withapi/github-api" ]; then
    printf '%s\n' \
      "enumerate self-test FAIL: sibling github-api not resolved; got '${resolved}'" >&2
    fails=$(( fails + 1 ))
  fi

  ## And with neither, it must say so rather than silently doing nothing.
  script_dir="${tmp}/without"
  rc=0
  out="$(PATH="${tmp}/without" git_api_program 2>&1)" || rc=$?
  if (( rc != 2 )); then
    printf '%s\n' \
      "enumerate self-test FAIL: absent github-api returned ${rc}, expected 2" >&2
    fails=$(( fails + 1 ))
  fi
  case "${out}" in
    *'github-api not found'*)
      true "INFO: the absence is reported"
      ;;
    *)
      printf '%s\n' 'enumerate self-test FAIL: absent github-api not reported; got:' "${out}" >&2
      fails=$(( fails + 1 ))
      ;;
  esac
  script_dir="${saved_script_dir}"

  ## Nothing verified at all is a setup error, not a pass with warnings.
  STATUS_FN='_enumerate_self_test_errors'
  _enumerate_self_test_errors() {
    printf '%s\n' 'error'
  }
  rc=0
  out="$(printf '%s\n' \
    "a${TAB}Kicksecure${TAB}a${TAB}err1${TAB}" \
    "b${TAB}Kicksecure${TAB}b${TAB}err2${TAB}" \
    | evaluate 2>&1)" || rc=$?
  if (( rc != 2 )); then
    printf '%s\n' \
      "enumerate self-test FAIL: wholly unverified sweep returned ${rc}, expected 2; got:" \
      "${out}" >&2
    fails=$(( fails + 1 ))
  fi
  STATUS_FN='upstream_status'

  ## A mid-stream ls-tree failure must fail closed (rc != 0), never return a
  ## PARTIAL gitlink set as success -- a pin after the corruption would be
  ## silently unchecked. The git stub prints one record then dies; the subshell
  ## keeps it from leaking.
  local et_rc=0
  (
    git() {
      case "$*" in
        *ls-tree*)
          printf 'partial-record\0'
          return 128
          ;;
        *)
          command git "$@"
          ;;
      esac
    }
    enumerate_gitlinks >/dev/null 2>&1
  ) || et_rc=$?
  if (( et_rc == 0 )); then
    printf '%s\n' 'enumerate self-test FAIL: mid-stream ls-tree failure read as success' >&2
    fails=$(( fails + 1 ))
  fi

  if (( fails > 0 )); then
    printf '%s\n' "enumerate self-test: ${fails} assertion(s) FAILED" >&2
    return 1
  fi
  printf '%s\n' 'enumerate self-test: PASSED (34 cases)'
  return 0
}


fixture_git() {
  ## git inside a self-test fixture: never the operator's hooks (the fixture is
  ## not testing them) and never their identity.
  git -c core.hooksPath=/dev/null \
      -c user.name='dist-ai self-test' \
      -c user.email='self-test@example.com' \
      -c commit.gpgsign=false \
      -c init.defaultBranch=master \
      -c advice.detachedHead=false \
      "$@"
}


fixture_pin() {
  ## Record a gitlink at ${2} for path 'sub' in the repo at ${1} and commit it.
  ## A gitlink is just a tree entry, so the pointed-at commit need not exist --
  ## which is the point: the check must never need the submodule's objects.
  local repo="$1" sha="$2" message="$3"
  fixture_git -C "${repo}" update-index --add --cacheinfo "160000,${sha},sub"
  fixture_git -C "${repo}" commit --quiet --message "${message}"
}


parent_self_test_cleanup() {
  ## Trap target for parent_self_test's fixtures.
  if [ -z "${parent_self_test_tmp}" ]; then
    return 0
  fi
  rm --recursive --force -- "${parent_self_test_tmp}"
  parent_self_test_tmp=''
}


parent_self_test() {
  ## End-to-end regression test for the no-deviation check, against real git
  ## fixtures and no network: a fork that moves a gitlink its merge base
  ## records must FAIL, and one that moves only files must PASS -- even while
  ## upstream has moved that same gitlink on its side.
  local tmp fails=0 rc out
  local sha_base='1111111111111111111111111111111111111111'
  local sha_upstream='2222222222222222222222222222222222222222'
  local sha_fork='3333333333333333333333333333333333333333'
  parent_self_test_tmp="$(mktemp --directory)"
  tmp="${parent_self_test_tmp}"
  trap parent_self_test_cleanup RETURN

  ## Upstream: one commit carrying the shared gitlink, then a bump of its own.
  fixture_git init --quiet "${tmp}/upstream"
  printf '%s\n' 'shared' > "${tmp}/upstream/file.txt"
  fixture_git -C "${tmp}/upstream" add file.txt
  fixture_pin "${tmp}/upstream" "${sha_base}" 'base'

  ## Fork branches here, so this commit is the merge base.
  fixture_git clone --quiet "${tmp}/upstream" "${tmp}/fork"
  fixture_pin "${tmp}/upstream" "${sha_upstream}" 'upstream moves the pin'

  repo_root="${tmp}/fork"
  ## file:// rather than a bare path: a partial fetch registers the URL as a
  ## promisor remote name, and git warns on every use of one starting with '/'.
  parent_upstream_url="file://${tmp}/upstream"
  parent_upstream_branch='master'

  ## Case A: fork changed files only. Upstream moving the pin on its own side
  ## is theirs-only and merges clean, so this must not be flagged.
  printf '%s\n' 'fork work' > "${tmp}/fork/file.txt"
  fixture_git -C "${tmp}/fork" add file.txt
  fixture_git -C "${tmp}/fork" commit --quiet --message 'fork changes a file'
  rc=0
  check_parent_deviation >/dev/null 2>&1 || rc=$?
  if (( rc != 0 )); then
    printf '%s\n' "parent self-test FAIL: file-only fork returned ${rc}, expected 0" >&2
    fails=$(( fails + 1 ))
  fi

  ## Case B: fork moves the gitlink. This is the defect the check exists for.
  fixture_pin "${tmp}/fork" "${sha_fork}" 'fork moves the pin'
  rc=0
  out="$(check_parent_deviation 2>&1)" || rc=$?
  if (( rc != 1 )); then
    printf '%s\n' "parent self-test FAIL: deviating fork returned ${rc}, expected 1" >&2
    fails=$(( fails + 1 ))
  fi
  case "${out}" in
    *"sub: ${sha_base} (merge base) -> ${sha_fork}"*)
      true "INFO: the deviation was reported with both SHAs, as required"
      ;;
    *)
      printf '%s\n' \
        'parent self-test FAIL: deviation not reported with both SHAs; got:' \
        "${out}" >&2
      fails=$(( fails + 1 ))
      ;;
  esac

  ## Case C: 'never' suppresses the check even on a deviating tree.
  parent_check='never'
  rc=0
  parent_check_applies >/dev/null 2>&1 || rc=$?
  if (( rc != 1 )); then
    printf '%s\n' 'parent self-test FAIL: --parent-check never still applied' >&2
    fails=$(( fails + 1 ))
  fi

  ## Case D: under 'auto' a non-master checkout is skipped -- the 'ai' branch
  ## carries deliberate pins and must not be flagged.
  parent_check='auto'
  fixture_git -C "${tmp}/fork" checkout --quiet -b ai
  rc=0
  parent_check_applies >/dev/null 2>&1 || rc=$?
  if (( rc != 1 )); then
    printf '%s\n' 'parent self-test FAIL: auto mode applied on a non-master branch' >&2
    fails=$(( fails + 1 ))
  fi

  ## Case E: ... and is applied on master.
  fixture_git -C "${tmp}/fork" checkout --quiet master
  rc=0
  parent_check_applies >/dev/null 2>&1 || rc=$?
  if (( rc != 0 )); then
    printf '%s\n' 'parent self-test FAIL: auto mode skipped a master checkout' >&2
    fails=$(( fails + 1 ))
  fi

  ## Case F: the CI shape -- a depth-1 clone, whose history does not reach the
  ## merge base until deepen_history() pulls it back from origin.
  fixture_git clone --quiet --depth 1 "file://${tmp}/fork" "${tmp}/shallow"
  if [ "$(fixture_git -C "${tmp}/shallow" rev-parse --is-shallow-repository)" != 'true' ]; then
    printf '%s\n' 'parent self-test FAIL: fixture clone is not shallow, case F proves nothing' >&2
    fails=$(( fails + 1 ))
  fi
  repo_root="${tmp}/shallow"
  rc=0
  out="$(check_parent_deviation 2>&1)" || rc=$?
  if (( rc != 1 )); then
    printf '%s\n' \
      "parent self-test FAIL: shallow deviating clone returned ${rc}, expected 1; got:" \
      "${out}" >&2
    fails=$(( fails + 1 ))
  fi

  ## Case G: a failing diff must be a loud setup error, never an empty result
  ## set that prints PASSED.
  _parent_self_test_bogus_base() {
    printf '%s\n' '0000000000000000000000000000000000000000'
  }
  MERGE_BASE_FN='_parent_self_test_bogus_base'
  rc=0
  out="$(check_parent_deviation 2>&1)" || rc=$?
  if (( rc != 2 )); then
    printf '%s\n' \
      "parent self-test FAIL: unusable merge base returned ${rc}, expected 2; got:" \
      "${out}" >&2
    fails=$(( fails + 1 ))
  fi
  ## Case J: no merge base at all is a setup error, not a transport warning --
  ## the two must not share the fail-open path.
  _parent_self_test_no_base() {
    return 2
  }
  MERGE_BASE_FN='_parent_self_test_no_base'
  rc=0
  out="$(check_parent_deviation 2>&1)" || rc=$?
  if (( rc != 2 )); then
    printf '%s\n' \
      "parent self-test FAIL: absent merge base returned ${rc}, expected 2; got:" \
      "${out}" >&2
    fails=$(( fails + 1 ))
  fi

  ## Case K: only real transports are accepted, so a remote-helper URL cannot
  ## turn --parent-upstream into command execution.
  MERGE_BASE_FN='parent_merge_base'
  local url
  for url in 'ext::sh -c id' '-upload-pack=id' 'rubbish'; do
    rc=0
    valid_upstream_url "${url}" || rc=$?
    if (( rc == 0 )); then
      printf '%s\n' "parent self-test FAIL: accepted a non-transport URL: ${url}" >&2
      fails=$(( fails + 1 ))
    fi
  done
  for url in 'https://example.com/a.git' 'file:///tmp/a' 'ssh://git@example.com/a'; do
    rc=0
    valid_upstream_url "${url}" || rc=$?
    if (( rc != 0 )); then
      printf '%s\n' "parent self-test FAIL: rejected a valid URL: ${url}" >&2
      fails=$(( fails + 1 ))
    fi
  done

  ## Case H: a detached HEAD sitting on the master commit is still master, and
  ## must not silently skip the check.
  repo_root="${tmp}/fork"
  fixture_git -C "${tmp}/fork" checkout --quiet --detach master
  rc=0
  parent_check_applies >/dev/null 2>&1 || rc=$?
  if (( rc != 0 )); then
    printf '%s\n' 'parent self-test FAIL: detached HEAD on the master commit was skipped' >&2
    fails=$(( fails + 1 ))
  fi

  ## Case I: a submodule relocated WITHOUT bumping its pin. git rename-detects
  ## a gitlink whose SHA is unchanged (R100, two paths in one record), which
  ## shifts every field after it, so both ends must come back named and intact.
  ## The pin must stay at the merge-base SHA or there is no exact match and the
  ## rename path is never taken -- the case would then prove nothing.
  local zero='0000000000000000000000000000000000000000'
  fixture_git -C "${tmp}/fork" checkout --quiet master
  fixture_git -C "${tmp}/fork" update-index --force-remove sub
  fixture_git -C "${tmp}/fork" update-index --add --cacheinfo "160000,${sha_base},sub-moved"
  fixture_git -C "${tmp}/fork" commit --quiet --message 'fork moves the submodule path'
  rc=0
  out="$(check_parent_deviation 2>&1)" || rc=$?
  if (( rc != 1 )); then
    printf '%s\n' "parent self-test FAIL: moved submodule returned ${rc}, expected 1" >&2
    fails=$(( fails + 1 ))
  fi
  case "${out}" in
    *"[FAIL] sub: ${sha_base} (merge base) -> ${zero} (this branch)"*)
      true "INFO: the vacated path was reported intact"
      ;;
    *)
      printf '%s\n' 'parent self-test FAIL: vacated submodule path garbled; got:' "${out}" >&2
      fails=$(( fails + 1 ))
      ;;
  esac
  case "${out}" in
    *"[FAIL] sub-moved: ${zero} (merge base) -> ${sha_base} (this branch)"*)
      true "INFO: the new path was reported intact"
      ;;
    *)
      printf '%s\n' 'parent self-test FAIL: new submodule path garbled; got:' "${out}" >&2
      fails=$(( fails + 1 ))
      ;;
  esac

  ## Case L: a submodule 'ignore = all' must NOT blind the deviation diff. With
  ## it set, an unguarded 'git diff' omits the 160000 change, the move looks
  ## inherited, and both invariants are bypassed. Isolated fixtures, and the
  ## config form of 'ignore' is set so the blinding is guaranteed on unpatched
  ## code (the whole point of --ignore-submodules=none is to override it).
  fixture_git init --quiet "${tmp}/upstream2"
  printf '%s\n' '[submodule "sub"]' '	path = sub' \
    '	url = https://github.com/Kicksecure/sub.git' '	ignore = all' \
    > "${tmp}/upstream2/.gitmodules"
  fixture_git -C "${tmp}/upstream2" add .gitmodules
  fixture_pin "${tmp}/upstream2" "${sha_base}" 'base with ignore=all'
  fixture_git clone --quiet "${tmp}/upstream2" "${tmp}/fork2"
  fixture_git -C "${tmp}/fork2" config diff.ignoreSubmodules all
  repo_root="${tmp}/fork2"
  parent_upstream_url="file://${tmp}/upstream2"
  parent_upstream_branch='master'
  fixture_pin "${tmp}/fork2" "${sha_fork}" 'fork moves the pin despite ignore=all'
  rc=0
  out="$(check_parent_deviation 2>&1)" || rc=$?
  if (( rc != 1 )); then
    printf '%s\n' \
      "parent self-test FAIL: ignore=all hid the gitlink move; returned ${rc}, expected 1; got:" \
      "${out}" >&2
    fails=$(( fails + 1 ))
  fi

  ## Case M: a repoint (.gitmodules URL change) with an UNCHANGED gitlink SHA is
  ## recorded in PARENT_URL_CHANGED_PATHS so main() will not treat the pin as
  ## inherited, WITHOUT counting as a gitlink deviation (invariant 2 stays
  ## SHA-only). Isolated fixtures.
  fixture_git init --quiet "${tmp}/upstream3"
  printf '%s\n' '[submodule "sub"]' '	path = sub' \
    '	url = https://github.com/Kicksecure/sub.git' \
    > "${tmp}/upstream3/.gitmodules"
  fixture_git -C "${tmp}/upstream3" add .gitmodules
  fixture_pin "${tmp}/upstream3" "${sha_base}" 'base'
  fixture_git clone --quiet "${tmp}/upstream3" "${tmp}/fork3"
  printf '%s\n' '[submodule "sub"]' '	path = sub' \
    '	url = https://github.com/attacker/sub.git' \
    > "${tmp}/fork3/.gitmodules"
  fixture_git -C "${tmp}/fork3" add .gitmodules
  fixture_git -C "${tmp}/fork3" commit --quiet --message 'fork repoints the submodule URL'
  repo_root="${tmp}/fork3"
  parent_upstream_url="file://${tmp}/upstream3"
  parent_upstream_branch='master'
  rc=0
  check_parent_deviation >/dev/null 2>&1 || rc=$?
  if (( rc != 0 )); then
    printf '%s\n' "parent self-test FAIL: repoint (same SHA) returned ${rc}, expected 0" >&2
    fails=$(( fails + 1 ))
  fi
  if [ -z "${PARENT_URL_CHANGED_PATHS[sub]:-}" ]; then
    printf '%s\n' 'parent self-test FAIL: repoint not recorded in PARENT_URL_CHANGED_PATHS' >&2
    fails=$(( fails + 1 ))
  fi
  if [ -n "${PARENT_DEV_PATHS[sub]:-}" ]; then
    printf '%s\n' 'parent self-test FAIL: unchanged SHA wrongly flagged as a gitlink deviation' >&2
    fails=$(( fails + 1 ))
  fi

  ## Case N: parent_deviations must key a path with the EXACT raw bytes
  ## enumerate_gitlinks emits, or main() mis-attributes it. The key here holds a
  ## '"' AND surrounding spaces: a non-z diff C-quotes the '"' (to
  ## '"w\"eird path "') and a plain read strips the spaces, either of which
  ## breaks the match. -z to a file keeps it verbatim.
  local spaced_key='w"eird path '
  fixture_git init --quiet "${tmp}/upstream5"
  fixture_git -C "${tmp}/upstream5" update-index --add \
    --cacheinfo "160000,${sha_base},${spaced_key}"
  fixture_git -C "${tmp}/upstream5" commit --quiet --message 'base spaced'
  fixture_git clone --quiet "${tmp}/upstream5" "${tmp}/fork5"
  fixture_git -C "${tmp}/fork5" update-index \
    --cacheinfo "160000,${sha_fork},${spaced_key}"
  fixture_git -C "${tmp}/fork5" commit --quiet --message 'move spaced pin'
  repo_root="${tmp}/fork5"
  parent_upstream_url="file://${tmp}/upstream5"
  parent_upstream_branch='master'
  rc=0
  check_parent_deviation >/dev/null 2>&1 || rc=$?
  if [ -z "${PARENT_DEV_PATHS[${spaced_key}]:-}" ]; then
    printf '%s\n' 'parent self-test FAIL: special-byte/spaced path not preserved verbatim in PARENT_DEV_PATHS' >&2
    fails=$(( fails + 1 ))
  fi

  ## Case P: a path with a literal TAB must be neutralised before emission, or
  ## the raw TAB desyncs parent_deviations' own record and keys PARENT_DEV_PATHS
  ## by the truncated prefix -- poisoning an UNRELATED submodule named that
  ## prefix. The key must be the neutralised form, and the bare prefix must NOT
  ## appear.
  local tab_path="sub-a${TAB}decoy"
  local tab_key_safe='sub-a<TAB>decoy'
  fixture_git init --quiet "${tmp}/upstream6"
  fixture_git -C "${tmp}/upstream6" update-index --add \
    --cacheinfo "160000,${sha_base},${tab_path}"
  fixture_git -C "${tmp}/upstream6" commit --quiet --message 'base tab'
  fixture_git clone --quiet "${tmp}/upstream6" "${tmp}/fork6"
  fixture_git -C "${tmp}/fork6" update-index \
    --cacheinfo "160000,${sha_fork},${tab_path}"
  fixture_git -C "${tmp}/fork6" commit --quiet --message 'move tab pin'
  repo_root="${tmp}/fork6"
  parent_upstream_url="file://${tmp}/upstream6"
  rc=0
  check_parent_deviation >/dev/null 2>&1 || rc=$?
  if [ -n "${PARENT_DEV_PATHS[sub-a]:-}" ]; then
    printf '%s\n' 'parent self-test FAIL: raw-TAB path poisoned an unrelated key (sub-a)' >&2
    fails=$(( fails + 1 ))
  fi
  if [ -z "${PARENT_DEV_PATHS[${tab_key_safe}]:-}" ]; then
    printf '%s\n' 'parent self-test FAIL: TAB path not keyed by its neutralised form' >&2
    fails=$(( fails + 1 ))
  fi

  ## Case Q: a repoint hidden behind a decoy stanza. The base stanza has NO url
  ## (base url ''); the fork repoints it AND adds a decoy 'path = ' (empty) /
  ## 'url = <victim-path>'. gitmodules_pairs emits the decoy as a leading-tab
  ## record; a tab-collapsing read would take its url as the path and clobber the
  ## victim's real head url back to '' -- matching the empty base url and hiding
  ## the repoint. The manual split skips the empty-path record, so the repoint is
  ## still detected.
  fixture_git init --quiet "${tmp}/upstream7"
  printf '%s\n' '[submodule "victim"]' '	path = fake-path-name' \
    > "${tmp}/upstream7/.gitmodules"
  fixture_git -C "${tmp}/upstream7" add .gitmodules
  fixture_git -C "${tmp}/upstream7" update-index --add \
    --cacheinfo "160000,${sha_base},fake-path-name"
  fixture_git -C "${tmp}/upstream7" commit --quiet --message 'base no-url'
  fixture_git clone --quiet "${tmp}/upstream7" "${tmp}/fork7"
  printf '%s\n' '[submodule "victim"]' '	path = fake-path-name' \
    '	url = https://github.com/Kicksecure/some-other-repo.git' \
    '[submodule "decoy"]' '	path = ' '	url = fake-path-name' \
    > "${tmp}/fork7/.gitmodules"
  fixture_git -C "${tmp}/fork7" add .gitmodules
  fixture_git -C "${tmp}/fork7" commit --quiet --message 'repoint behind decoy'
  repo_root="${tmp}/fork7"
  parent_upstream_url="file://${tmp}/upstream7"
  rc=0
  check_parent_deviation >/dev/null 2>&1 || rc=$?
  if [ -z "${PARENT_URL_CHANGED_PATHS[fake-path-name]:-}" ]; then
    printf '%s\n' 'parent self-test FAIL: decoy empty-path stanza hid the repoint' >&2
    fails=$(( fails + 1 ))
  fi

  ## Case O: a failing is-shallow-repository probe (corrupt .git/shallow) is a
  ## setup error (rc 2), not a silent 'not shallow' pass that would misreport a
  ## local fault as a network warning and skip invariant 2. Subshell-scoped stub.
  rc=0
  (
    git() {
      case "$*" in
        *is-shallow-repository*)
          return 128
          ;;
        *)
          command git "$@"
          ;;
      esac
    }
    deepen_history
  ) >/dev/null 2>&1 || rc=$?
  if (( rc != 2 )); then
    printf '%s\n' "parent self-test FAIL: corrupt-shallow probe returned ${rc}, expected 2" >&2
    fails=$(( fails + 1 ))
  fi

  if (( fails > 0 )); then
    printf '%s\n' "parent self-test: ${fails} assertion(s) FAILED" >&2
    return 1
  fi
  printf '%s\n' 'parent self-test: PASSED (18 cases)'
  return 0
}


inherited_self_test() {
  ## Regression for the attribution scoping (invariant 1 vs the inherited set).
  ## Every pin here is not-resolvable, so only attribution decides the verdict:
  ##   - a pin INHERITED from upstream warns and passes (the standing false-red
  ##     this fixes -- the parent upstream pins commits not on the submodule
  ##     GitHub mirror, and this fork mirrors them and may not deviate);
  ##   - a pin this branch INTRODUCED still hard-fails;
  ##   - with attribution UNKNOWN every not-resolvable pin hard-fails (the
  ##     conservative standalone-audit default);
  ##   - an all-inherited sweep is a PASS, not a 'nothing verified' setup error.
  ## FAILS on the pre-attribution evaluator, which failed the gate for inherited
  ## pins too -- which is the whole bug.
  local rc fails=0 out
  STATUS_FN='_inherited_self_test_status'
  _inherited_self_test_status() {
    printf '%s\n' 'not-resolvable'
  }

  ## Case A: an inherited not-resolvable pin warns and passes.
  EVAL_ATTRIBUTION_KNOWN='true'
  EVAL_INHERITED=()
  EVAL_INHERITED['sub-inherited']=1
  rc=0
  out="$(printf '%s\n' \
    "sub-inherited${TAB}Kicksecure${TAB}a${TAB}dead1${TAB}" \
    | evaluate 2>&1)" || rc=$?
  if (( rc != 0 )); then
    printf '%s\n' "inherited self-test FAIL: inherited not-resolvable pin returned ${rc}, expected 0" >&2
    fails=$(( fails + 1 ))
  fi
  case "${out}" in
    *'[warn:upstream]'*'sub-inherited'*)
      true "INFO: the inherited pin was warned, not failed"
      ;;
    *)
      printf '%s\n' 'inherited self-test FAIL: inherited pin not reported as a warning; got:' "${out}" >&2
      fails=$(( fails + 1 ))
      ;;
  esac

  ## Case B: a not-resolvable pin this branch INTRODUCED still fails the gate,
  ## and the inherited one beside it must stay OUT of the FAIL set.
  EVAL_ATTRIBUTION_KNOWN='true'
  EVAL_INHERITED=()
  EVAL_INHERITED['sub-inherited']=1
  rc=0
  out="$(printf '%s\n' \
    "sub-inherited${TAB}Kicksecure${TAB}a${TAB}dead1${TAB}" \
    "sub-introduced${TAB}Kicksecure${TAB}b${TAB}dead2${TAB}" \
    | evaluate 2>&1)" || rc=$?
  if (( rc != 1 )); then
    printf '%s\n' "inherited self-test FAIL: introduced not-resolvable pin returned ${rc}, expected 1" >&2
    fails=$(( fails + 1 ))
  fi
  case "${out}" in
    *'[FAIL]'*'sub-introduced'*)
      true "INFO: the introduced pin failed the gate"
      ;;
    *)
      printf '%s\n' 'inherited self-test FAIL: introduced pin not failed; got:' "${out}" >&2
      fails=$(( fails + 1 ))
      ;;
  esac
  case "${out}" in
    *'[FAIL]'*'sub-inherited'*)
      printf '%s\n' 'inherited self-test FAIL: inherited pin wrongly failed alongside; got:' "${out}" >&2
      fails=$(( fails + 1 ))
      ;;
    *)
      true "INFO: the inherited pin stayed out of the FAIL set"
      ;;
  esac

  ## Case C: attribution UNKNOWN -> a not-resolvable pin hard-fails (the
  ## conservative default, unchanged from the standalone audit).
  EVAL_ATTRIBUTION_KNOWN='false'
  EVAL_INHERITED=()
  rc=0
  printf '%s\n' \
    "sub-x${TAB}Kicksecure${TAB}a${TAB}dead1${TAB}" \
    | evaluate >/dev/null 2>&1 || rc=$?
  if (( rc != 1 )); then
    printf '%s\n' "inherited self-test FAIL: unknown-attribution not-resolvable pin returned ${rc}, expected 1" >&2
    fails=$(( fails + 1 ))
  fi

  ## Case D: an all-inherited sweep (nothing independently resolvable) PASSES --
  ## the inherited pins ARE the compliance, so it is not a 'nothing verified'
  ## setup error (exit 2).
  EVAL_ATTRIBUTION_KNOWN='true'
  EVAL_INHERITED=()
  EVAL_INHERITED['only-inherited']=1
  rc=0
  out="$(printf '%s\n' \
    "only-inherited${TAB}Kicksecure${TAB}a${TAB}dead1${TAB}" \
    | evaluate 2>&1)" || rc=$?
  if (( rc != 0 )); then
    printf '%s\n' "inherited self-test FAIL: all-inherited sweep returned ${rc}, expected 0; got:" "${out}" >&2
    fails=$(( fails + 1 ))
  fi

  ## Case E: an INHERITED structural problem STILL hard-fails. A .gitmodules
  ## definition defect (missing stanza, repoint) is not cleared by a matching
  ## gitlink SHA, so a submodule repointed at a fork while keeping the merge-base
  ## SHA -- which looks 'inherited' -- must not be downgraded to a warning.
  EVAL_ATTRIBUTION_KNOWN='true'
  EVAL_INHERITED=()
  EVAL_INHERITED['sub-problem']=1
  rc=0
  out="$(printf '%s\n' \
    "sub-problem${TAB}${TAB}${TAB}dead1${TAB}gitlink has no .gitmodules stanza, so its upstream is unknown" \
    | evaluate 2>&1)" || rc=$?
  if (( rc != 1 )); then
    printf '%s\n' "inherited self-test FAIL: inherited problem pin returned ${rc}, expected 1; got:" "${out}" >&2
    fails=$(( fails + 1 ))
  fi
  case "${out}" in
    *'[FAIL]'*'sub-problem'*)
      true "INFO: the inherited-but-repointed pin failed the gate"
      ;;
    *)
      printf '%s\n' 'inherited self-test FAIL: inherited problem pin not in FAIL set; got:' "${out}" >&2
      fails=$(( fails + 1 ))
      ;;
  esac

  STATUS_FN='upstream_status'
  EVAL_ATTRIBUTION_KNOWN='false'
  EVAL_INHERITED=()

  if (( fails > 0 )); then
    printf '%s\n' "inherited self-test: ${fails} assertion(s) FAILED" >&2
    return 1
  fi
  printf '%s\n' 'inherited self-test: PASSED (5 cases)'
  return 0
}


main() {
  local self_test_mode='false'
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --repo-root)
        if [ "$#" -lt 2 ]; then
          printf '%s\n' '::error::--repo-root needs an argument' >&2
          return 2
        fi
        repo_root="$2"
        shift 2
        ;;
      --parent-check)
        if [ "$#" -lt 2 ]; then
          printf '%s\n' '::error::--parent-check needs an argument' >&2
          return 2
        fi
        case "$2" in
          auto|always|never)
            parent_check="$2"
            ;;
          *)
            printf '%s\n' "::error::--parent-check must be auto, always or never: $2" >&2
            return 2
            ;;
        esac
        shift 2
        ;;
      --parent-upstream)
        if [ "$#" -lt 2 ]; then
          printf '%s\n' '::error::--parent-upstream needs an argument' >&2
          return 2
        fi
        if ! valid_upstream_url "$2"; then
          printf '%s\n' \
            "::error::--parent-upstream must be an http(s), git, ssh or file URL: $2" >&2
          return 2
        fi
        parent_upstream_url="$2"
        shift 2
        ;;
      --self-test)
        self_test_mode='true'
        shift
        ;;
      --help|-h)
        usage
        return 0
        ;;
      *)
        printf '%s\n' "::error::unknown argument: $1" >&2
        usage >&2
        return 2
        ;;
    esac
  done

  local rc=0
  if [ "${self_test_mode}" = 'true' ]; then
    ## Both suites run even when the first fails, so one invocation reports
    ## every broken assertion.
    self_test || rc=$?
    enumerate_self_test || rc=$?
    parent_self_test || rc=$?
    inherited_self_test || rc=$?
    return "${rc}"
  fi

  if [ ! -f "${repo_root}/.gitmodules" ]; then
    printf '%s\n' \
      "::error::no .gitmodules under --repo-root ${repo_root} (not a derivative-maker checkout?)" >&2
    return 2
  fi

  ## An unusable HEAD used to be absorbed per-entry, leaving a run that checked
  ## nothing at all printing PASSED.
  if ! git -C "${repo_root}" rev-parse --verify --quiet HEAD >/dev/null; then
    printf '%s\n' "::error::HEAD is not usable in ${repo_root}; nothing could be checked" >&2
    return 2
  fi

  local records
  if ! records="$(enumerate_gitlinks)"; then
    printf '%s\n' "::error::could not enumerate the gitlinks of ${repo_root}" >&2
    return 2
  fi
  if [ -z "${records}" ]; then
    printf '%s\n' \
      "::error::no submodule gitlink found in HEAD of ${repo_root}; a derivative-maker checkout has many" >&2
    return 2
  fi

  ## No-deviation (invariant 2) runs FIRST: its deviation set is what scopes
  ## invariant 1's blame to pins this branch introduced, so a pin inherited
  ## verbatim from upstream is not failed for upstream's own mirror lag. Let the
  ## worse exit code win (2 setup error over 1 violation) rather than
  ## short-circuiting on the first.
  local parent_rc=0
  if parent_check_applies; then
    check_parent_deviation || parent_rc=$?
  fi

  ## Attribute inherited (== upstream at the merge base) pins for evaluate(). Only
  ## when the comparison actually ran; otherwise every pin stays this branch's.
  EVAL_ATTRIBUTION_KNOWN="${PARENT_ATTRIBUTION_KNOWN}"
  EVAL_INHERITED=()
  if [ "${EVAL_ATTRIBUTION_KNOWN}" = 'true' ]; then
    local irecord ipath
    while IFS= read -r irecord; do
      if [ -z "${irecord}" ]; then
        continue
      fi
      ## Path is the first field; take it by prefix, not by a tab-collapsing read.
      ## Inherited == unchanged gitlink SHA AND unchanged .gitmodules URL: a
      ## repoint (URL change) disqualifies the pin even at the same SHA.
      ipath="${irecord%%"${TAB}"*}"
      if [ -z "${PARENT_DEV_PATHS[${ipath}]:-}" ] \
         && [ -z "${PARENT_URL_CHANGED_PATHS[${ipath}]:-}" ]; then
        EVAL_INHERITED["${ipath}"]=1
      fi
    done <<< "${records}"
  fi

  evaluate <<< "${records}" || rc=$?

  if (( parent_rc > rc )); then
    rc="${parent_rc}"
  fi
  return "${rc}"
}

main "$@"
