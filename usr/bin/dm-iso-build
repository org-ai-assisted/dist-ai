#!/bin/bash

## Copyright (C) 2025 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Fast single-flavor derivative-maker ISO/image builder that drives the OFFICIAL
## build orchestration (help-steps/dm-build-official-one), invoked as:
##
##   dm-iso-build [extra derivative-maker args...]
##
## Defaults (override via env): kicksecure-lxqt / amd64 / iso / frozen.
##
## WHY the official path (not a bare ./derivative-maker):
##   A test/gate image must be as close to a RELEASE image as possible. Most
##   importantly the derivative APT repository must ship ENABLED. dm-build-official-one
##   sets dist_build_redistributable=true, which is what enables the repo (+ --tb
##   closed + --freedom false) and writes /var/lib/repository-dist/derivative_apt_repository_opts
##   into the image so the first-boot repository-dist-initializer.service can create
##   /etc/apt/sources.list.d/derivative.sources. A plain `./derivative-maker` build
##   leaves build_remote_repo_enable at its false default, the opts file is never
##   written, and the ISO ships the repo DISABLED (systemcheck check_apt_repository
##   == Disabled). repo=ENABLED is therefore the official path's IMPLICIT DEFAULT --
##   do NOT pass --repo (true or false) here; dm-build-official-one owns it.
##
## NEVER UPLOADS: this is a test/gate builder, not a publisher. Uploads are forced
## to simulate unconditionally (rsync_cmd), so a test image can never reach the
## release server -- publishing an untested image as a release would be an incident.
## This holds even though CI=true is set (below): rsync_cmd pins uploads to simulate
## regardless, so CI build mode cannot turn real uploads back on.
##
## Build hygiene -- deliberately NOT overridable, so the safe path is the default
## and there is nothing to remember:
##   - lintian fails CLOSED (make_lintian_fail_open_versus_closed left unset; any
##     lintian warning fails the build -- fix it, do not paper over it).
##   - the tree must be fully committed: --allow-uncommitted false, so
##     derivative-maker's own git_sanity_test refuses a dirty tree.
##   - --sign-and-tag true (allow-unsigned is forbidden for AI sessions).
##   - CI=true: help-steps/sign-and-tag REFUSES a redistributable sign+tag
##     (dist_build_redistributable=true) unless CI=true -- its only allow-path, so the
##     --sign-and-tag true above cannot run without it. CI=true also makes
##     dm-build-official-one build derivative packages from source
##     (--remote-derivative-packages false): slower but release-grade. Uploads stay off
##     (rsync_cmd simulate). On native amd64 this is a real build; parse-cmd's CI
##     dry-run triggers only on a CROSS build.
##
## Speed (default ON -- reuse the prior build's work, far short of a ~1h cold build):
##   --reuse-cowbuilder-base    reuse the cowbuilder base chroot
## (dm-build-official-one ALWAYS rebuilds only changed packages via its own
## --skip-published-packages, so this wrapper does not pass that flag itself.)
##
## This wrapper builds ONLY the frozen snapshot -- freshness is hardcoded, NOT overridable.
## derivative-maker shares one cowbuilder base chroot, one local package repo, and one
## source-hash manifest keyed by ARCH, not snapshot, so mixing snapshots cross-contaminates
## in BOTH directions (a later frozen build reusing a current-populated base, or vice versa).
## Building a single snapshot makes reuse unconditionally safe: no marker, no per-snapshot
## dirs, no switch logic.
##
## DM_CLEAN=1 drops --reuse-cowbuilder-base so the cowbuilder base chroot is rebuilt
## from scratch. It does NOT disable package-level reuse: the official path always passes
## --skip-published-packages (a bare flag with no opt-out), so unchanged packages are still
## reused from ~/derivative-binary. For a full package reset, remove ~/derivative-binary.
##
## Scope: this locks only the --freshness it passes. It does NOT police derivative-maker's
## OWN snapshot knobs (a buildconfig.d setting, or an env override such as
## dist_build_sources_list_primary) -- keep those frozen too. Signing is enforced by
## derivative-maker itself, not this wrapper.
##
## The ISO is intrinsic to a kicksecure flavor build in the official path. VM images
## are selected via DM_TARGET (mapped to dist_build_multi_target_list): DM_TARGET=iso
## builds the ISO only; any other value also builds that VM image. The ISO is produced
## only for the kicksecure-lxqt / kicksecure-ci-tiny-do-not-use flavors, exactly as
## dm-build-official-one does for a release.
##
## Env overrides: DM_REPO DM_FLAVOR DM_ARCH DM_TARGET DM_FREEDOM DM_USER DM_CLEAN

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

dm_repo="${DM_REPO:-${HOME}/derivative-maker}"
flavor="${DM_FLAVOR:-kicksecure-lxqt}"
arch="${DM_ARCH:-amd64}"
target="${DM_TARGET:-iso}"
freshness="frozen"   ## hardcoded, not overridable -- see header (single-snapshot safety)
freedom="${DM_FREEDOM:-false}"
build_user="${DM_USER:-$(id -un)}"

## This builder ALWAYS produces a repo-ENABLED, release-faithful image; --repo is the
## official path's implicit default and must not be fiddled per-caller. Refuse any --repo
## arg early and clearly, rather than letting it ride through to a late, cryptic
## redistributable-incompatibility error (--repo false) or silently duplicate the default
## (--repo true). See the WHY-the-official-path note above.
for dm_iso_build_arg in "$@"; do
   case "${dm_iso_build_arg}" in
      --repo|--repo=*)
         printf '%s\n' "${BASH_SOURCE[0]}: refusing '--repo': this builder always builds the derivative repository ENABLED via the official path; do not pass --repo." >&2
         exit 1
         ;;
   esac
done
unset dm_iso_build_arg

cd -- "${dm_repo}"

## dm-build-official-one gates a non-CI, non-dry-run build on an existing ~/.ssh (its
## upload-readiness check). This builder simulates uploads unconditionally and never uses
## ssh keys, so that guard is spurious here -- create the dir (mode 0700) when absent so a
## fresh build machine does not fail the check; leave an existing dir's mode untouched.
[ -d "${HOME}/.ssh" ] || mkdir --mode=0700 -- "${HOME}/.ssh"

## dm-build-official-one consumes the flavor, arch and VM-target set from the
## environment (NOT from --flavor/--arch/--target on its own argv). An empty
## multi-target list == ISO-only; a non-iso DM_TARGET requests that VM image too.
multi_target_list=""
if [ "${target}" != "iso" ]; then
   multi_target_list="${target}"
fi

## Reuse the prior build's work (far short of a ~1h cold build). Always safe: this wrapper
## only ever builds the frozen snapshot. DM_CLEAN=1 forces a from-scratch build -- dropping
## both knobs makes derivative-maker rebuild the base and all packages.
speed=(--reuse-cowbuilder-base)
if [ "${DM_CLEAN:-0}" = "1" ]; then
   speed=()
   printf '%s\n' "${BASH_SOURCE[0]}: DM_CLEAN -- fresh cowbuilder base (package reuse still applies via the official path; rm ~/derivative-binary for a full reset)"
fi

printf '%s\n' "${BASH_SOURCE[0]}: flavor=${flavor} arch=${arch} target=${target} freshness=${freshness} freedom=${freedom} user=${build_user} knobs=[${speed[*]:-none}]"

## Caller's extra args go FIRST so the flags below always win: derivative-maker's
## parse_cmd is last-flag-wins, so a passed-through --allow-uncommitted true or
## --sign-and-tag false cannot defeat the hygiene defaults. --allow-unsigned stays
## refused by derivative-maker itself for AI sessions. NO --repo is passed: the repo
## is enabled by the official path's dist_build_redistributable default (see header).
rc=0
CI=true \
flavors_list="${flavor}" \
dist_build_target_arch="${arch}" \
dist_build_multi_target_list="${multi_target_list}" \
user_name="${build_user}" \
dist_build_unlock_dangerous_options=true \
rsync_cmd="true simulate-only" \
   ./help-steps/dm-build-official-one \
      "$@" \
      --freshness "${freshness}" --freedom "${freedom}" \
      --allow-uncommitted false \
      --sign-and-tag true \
      "${speed[@]}" || rc="$?"

printf '%s\n' "${BASH_SOURCE[0]}: dm-build-official-one exit code: ${rc}"
exit "${rc}"
