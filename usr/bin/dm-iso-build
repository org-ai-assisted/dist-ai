#!/bin/bash

## Copyright (C) 2025 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Fast derivative-maker image/ISO build wrapper with build-hygiene defaults
## baked in, invoked as:
##
##   dm-iso-build [extra derivative-maker args...]
##
## Defaults (override via env): kicksecure-lxqt / amd64 / iso / frozen.
##
## Build hygiene -- deliberately NOT overridable here, so the safe path is the
## default and there is nothing to remember:
##   - lintian fails CLOSED (the make_lintian_fail_open_versus_closed var is left
##     unset; any lintian warning fails the build -- fix it, do not paper over it).
##   - the tree must be fully committed: --allow-uncommitted is NOT passed, so
##     derivative-maker's own git_sanity_test refuses a dirty tree.
##   - --sign-and-tag true (allow-unsigned is forbidden for AI sessions).
##
## Speed (default ON -- reuse the prior build's work, far short of a ~1h cold build):
##   --skip-published-packages  rebuild only packages whose source changed
##   --reuse-cowbuilder-base    reuse the cowbuilder base chroot
##
## derivative-maker's --reuse-cowbuilder-base shares ONE base chroot keyed by arch, NOT by
## snapshot, so reusing it is safe only within a single freshness. The default frozen build
## reuses it (fast); a non-frozen DM_FRESHNESS -- or DM_CLEAN=1 -- builds FROM SCRATCH, so a
## different snapshot never reuses the frozen base. No marker/state: the reuse decision is a
## pure function of DM_FRESHNESS and DM_CLEAN.
##
## Env overrides: DM_REPO DM_FLAVOR DM_ARCH DM_TARGET DM_FRESHNESS DM_FREEDOM
##                DM_USER DM_CLEAN

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

dm_repo="${DM_REPO:-${HOME}/derivative-maker}"
flavor="${DM_FLAVOR:-kicksecure-lxqt}"
arch="${DM_ARCH:-amd64}"
target="${DM_TARGET:-iso}"
freshness="${DM_FRESHNESS:-frozen}"
freedom="${DM_FREEDOM:-false}"
build_user="${DM_USER:-$(id -un)}"

cd -- "${dm_repo}"

## Reuse the prior build's work (far short of a ~1h cold build) for the default frozen
## snapshot. A non-frozen freshness or DM_CLEAN builds from scratch: dropping the reuse
## knobs makes derivative-maker build a fresh base, so a different snapshot cannot reuse the
## frozen base (which --reuse-cowbuilder-base shares by arch, not by snapshot).
speed=(--skip-published-packages --reuse-cowbuilder-base)
if [ "${DM_CLEAN:-0}" = "1" ] || [ "${freshness}" != "frozen" ]; then
   speed=()
   printf '%s\n' "${BASH_SOURCE[0]}: from-scratch build (no package reuse, fresh cowbuilder base) -- DM_CLEAN or non-frozen freshness='${freshness}'"
fi

printf '%s\n' "${BASH_SOURCE[0]}: flavor=${flavor} arch=${arch} target=${target} freshness=${freshness} freedom=${freedom} user=${build_user} knobs=[${speed[*]:-none}]"

## Caller's extra args go FIRST so the flags below always win: derivative-maker's
## parse_cmd is last-flag-wins, so a passed-through --allow-uncommitted true or
## --sign-and-tag false cannot defeat the hygiene defaults. --allow-unsigned stays
## refused by derivative-maker itself for AI sessions.
rc=0
user_name="${build_user}" \
dist_build_unlock_dangerous_options=true \
   ./derivative-maker \
      "$@" \
      --flavor "${flavor}" --arch "${arch}" --target "${target}" \
      --freshness "${freshness}" --type vm --freedom "${freedom}" \
      --allow-uncommitted false \
      --sign-and-tag true \
      "${speed[@]}" || rc="$?"

printf '%s\n' "${BASH_SOURCE[0]}: derivative-maker exit code: ${rc}"
exit "${rc}"
