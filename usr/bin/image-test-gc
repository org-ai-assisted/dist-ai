#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Reset an EPHEMERAL test user's VirtualBox state between image-test runs: power
## off + delete every VM it has registered and remove its VM/disk folder, so
## ephemeral runs never accumulate state (disk exhaustion) or cross-contaminate.
## REFUSES a persistent golden-fleet user (persist-*) and root -- those are never
## wiped. The eph-* allow spans BOTH ephemeral namespaces -- install (eph-run-) and
## leak (eph-leak-) -- so a future narrowing of it is a conscious, tested choice.
## VBox internal networks are per-VM and vanish with the VMs, so deleting the VMs is
## enough; no separate intnet cleanup.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"
VBOXMANAGE="${VBOXMANAGE:-VBoxManage}"

die() {
   printf '%s: ERROR: %s\n' "${me}" "$2" >&2
   exit "$1"
}

main() {
   local user home vmname vms_raw
   local -a vmnames=()
   user="${1:-}"
   [ -n "${user}" ] || die 2 "usage: ${me} EPHEMERAL_USER (eph-*)"
   [ "${user}" != 'root' ] || die 2 "refusing root"
   id "${user}" >/dev/null 2>&1 || die 2 "no such user: '${user}'"
   ## Guard: only an ephemeral pool user is wipeable; the golden fleet never is.
   case "${user}" in
      persist-*)
         die 2 "refusing persistent-fleet user '${user}' (never wiped)"
         ;;
      eph-*)
         true
         ;;
      *)
         die 2 "'${user}' is not an ephemeral pool user (eph-*); refusing"
         ;;
   esac

   home="$(getent passwd "${user}" | cut -d: -f6)"
   printf '%s\n' "${me}: wiping VirtualBox state for ${user}"
   ## Capture the VM list with an rc-checked command substitution (separate from
   ## `local`, which would mask the rc) -- NOT process substitution, whose failure
   ## never reaches errexit and would let a broken `list vms` fall through to the
   ## folder wipe while registrations survive, then print a false "done".
   vms_raw="$(sudo -u "${user}" "${VBOXMANAGE}" list vms)"
   mapfile -t vmnames < <(printf '%s\n' "${vms_raw}" | sed -n 's/^"\(.*\)" .*/\1/p')
   ## poweroff + unregister --delete every VM the user has registered.
   for vmname in "${vmnames[@]}"; do
      [ -n "${vmname}" ] || continue
      sudo -u "${user}" "${VBOXMANAGE}" controlvm "${vmname}" poweroff 2>/dev/null || true
      sleep 1
      ## unregister --delete MUST succeed: safe-rm does not unregister, so a
      ## swallowed failure here strands a registration pointing at a wiped folder.
      sudo -u "${user}" "${VBOXMANAGE}" unregistervm "${vmname}" --delete
   done
   ## drop any leftover VM/disk folder.
   safe-rm --recursive --force -- "${home}/VirtualBox VMs"
   printf '%s\n' "${me}: done"
}

main "$@"
