#!/usr/bin/python3 -Bsu
## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Shell-invocation guard: under bash/sh the shebang is ignored and the `import`
## lines below would run as shell commands (`import` is ImageMagick -> XGrabServer,
## which freezes X). Re-exec under python3; inert as a string literal in python3.
"exec" "python3" "-Bsu" "$0" "$@"

## Inventory guard for the secure-terminal.github.io shot galleries: every committed shot
## file must be a page-referenced generator artifact, and every page reference into a shot
## gallery must resolve to a committed file. This is the cheap "no hand-rolled screenshot"
## guard -- it needs NO Qt and NO regeneration (just file listing + HTML parsing), so it
## runs on every push (site CI) and pre-deploy, unlike a per-push regenerate-and-diff.
##
## It catches:
##   - an ORPHAN shot: a file under shots/, comparison/shots/ or compatibility/shots/ that
##     no page references (a hand-added image, or a stale shot left behind after a rename);
##   - a DANGLING reference: a page <img>/<a> into a shot gallery whose target file is
##     missing (a renamed/deleted shot still referenced).
## It does NOT re-render or byte-compare shots, nor check pixel dimensions (the sibling
## secure-terminal-shots-dims owns declared-vs-intrinsic dimensions); shot CONTENT
## freshness is the generators' + reviewers' job.
##
## Usage: secure-terminal-shots-inventory [SITE_DIR]
##   SITE_DIR defaults to ~/private-sources/secure-terminal.github.io (override with
##   SECURE_TERMINAL_SITE_REPO). Exit 0 = clean, 1 = drift found, 2 = usage/environment.

import os
import sys

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.realpath(__file__)), os.pardir, 'share', 'secure-terminal-shots'))
import shots_site_refs as ssr  # noqa: E402  (path set above so both install + checkout resolve)


def main():
    if len(sys.argv) > 2:
        sys.stderr.write('usage: secure-terminal-shots-inventory [SITE_DIR]\n')
        return 2
    try:
        site, present_galleries = ssr.resolve_site(sys.argv[1] if len(sys.argv) == 2 else None)
    except ssr.SiteError as exc:
        sys.stderr.write('FATAL: %s\n' % exc)
        return 2

    shot_files = ssr.collect_shot_files(site, present_galleries)

    ## Every local image reference, resolved to a site-relative path, from every page.
    referenced = set()
    try:
        pages = ssr.collect_from_pages(site, ssr.RefCollector)
    except ssr.SiteError as exc:
        sys.stderr.write('FATAL: %s\n' % exc)
        return 2
    for html_path, parser in pages:
        for ref in parser.refs:
            rel = ssr.resolve_ref(ref, html_path, site)
            if rel is not None:
                referenced.add(rel)

    failures = []
    ## ORPHAN: a shot file no page references.
    for rel in sorted(shot_files - referenced):
        failures.append('orphan shot (no page references it): %s' % rel)
    ## DANGLING: a reference INTO a gallery whose file is missing.
    for rel in sorted(referenced):
        if ssr.in_gallery(rel) and rel not in shot_files:
            failures.append('dangling reference (no such shot file): %s' % rel)

    if failures:
        sys.stderr.write('secure-terminal-shots-inventory: FAIL (%d)\n' % len(failures))
        for line in failures:
            sys.stderr.write('  ' + line + '\n')
        return 1
    print('ok: %d shot files, all page-referenced; no dangling shot references (%s)'
          % (len(shot_files), ', '.join(present_galleries)))
    return 0


if __name__ == '__main__':
    sys.exit(main())
