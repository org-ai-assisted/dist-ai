#!/usr/bin/python3 -Bsu

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Shell-invocation guard.
"exec" "bash" "-c" "printf '%s\n' '$0: ERROR: Do not execute this script with bash!' >&2; exit 1"

"""Generate the static test-results verification site from the results plane.

Reads a results plane (<name>/<ts>/result.json + step screenshots), normalizes
(masks the clock + any configured privacy rects) and publishes every screenshot,
and emits a static, strict-CSP site under <site-out>/automated-test-results/: an
overview matrix (lane x version x builder x provenance) with a legend, plus one
page per run.

No-false-green: the run-cell status comes from dm_test_results.site and is OBJECTIVE
-- green requires finished + fresh + functional PASS on the declared firmware lane.
Screenshots do NOT gate status and there is no human approval step: a blank must-render
milestone is caught at RUN time (image-blank-check, source-encoded per milestone in
dm-calamares-install), so a PASS verdict already means every gated shot rendered. Shots
are always published for inspection; one that cannot be read shows alt text, never a
silent blank. stale / unknown / inconclusive / no-data all render non-green, age always
shown.

Deterministic: the generated timestamp is pinned to SOURCE_DATE_EPOCH (or
--source-date-epoch), ordering is sorted, and normalized shots are re-encoded as
lossless webp by Pillow -- so regenerating identical input yields byte-identical
output (verified by a canary).

Exit: 0 ok, 2 usage/error.
"""

import argparse
import datetime
import hashlib
import html
import json
import os
import shutil
import sys

_LIB = os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
    "lib", "python3", "dist-packages")
if os.path.isdir(_LIB) and _LIB not in sys.path:
    sys.path.insert(0, _LIB)

from dm_test_results import imaging, model, ocr, site  # noqa: E402

RESULTS_SUBDIR = "automated-test-results"
IMAGE_MEDIA_PREFIX = "image/"
TEXT_MEDIA = "text/plain"
## An OCR sidecar text attachment's path is its shot's stored path + this suffix, so the
## generator pairs it to the shot (a link under the image). Any OTHER text attachment is a
## standalone state-card text panel.
OCR_SUFFIX = ".ocr.txt"
## Bound the per-shot OCR sidecar / state-card text the generator reads from the (account-owned)
## plane -- a runaway text file must never bloat the page. Matches the emitter's text cap.
MAX_TEXT_ASSET_BYTES = 256 * 1024

## Per-shot CONTENT-validation presentation. Orthogonal to the step's functional status: it says
## whether the shot showed the RIGHT thing for its stage. Only 'validated' is green; 'unvalidated'
## (incl. an ABSENT field -- an old result.json or a stage with no golden) and 'ocr-error' are
## inconclusive (never green); a 'mismatch' is a hard fail. Mapped to the frozen st-* classes --
## NO new CSS class (style.css lives in a separate repo gated by the undefined-classes check).
_VALIDATION_CLASS = {
    model.VALIDATION_VALIDATED: site.STATUS_PASS,
    model.VALIDATION_MISMATCH: site.STATUS_FAIL,
    model.VALIDATION_UNVALIDATED: site.STATUS_INCONCLUSIVE,
    model.VALIDATION_OCR_ERROR: site.STATUS_INCONCLUSIVE,
}
_VALIDATION_LABEL = {
    model.VALIDATION_VALIDATED: "content: validated",
    model.VALIDATION_MISMATCH: "content: MISMATCH",
    model.VALIDATION_UNVALIDATED: "content: UNVALIDATED (no golden)",
    model.VALIDATION_OCR_ERROR: "content: OCR error",
}


def _validation_of(attachment):
    """The attachment's content-validation token, fail-closed: an absent or out-of-enum value
    reads as 'unvalidated' (never shown green), matching the model's absent-key contract."""
    v = attachment.get("validation")
    return v if v in model.VALID_VALIDATION else model.VALIDATION_UNVALIDATED

## Incremental-regenerate cache format version. The lossless method=6 webp re-encode dominates
## the generate cost, and a deploy re-runs it for every run on every invocation even when nothing
## changed. The cache lets an unchanged run reuse its already-encoded webps + cached status
## instead of re-encoding. BUMP this on ANY change to how a run's page assets are produced,
## so a generator change invalidates every cache entry (no stale output served).
## v3: shots carry validation + a copied OCR sidecar, and runs carry state-card text panels.
## v4: shots/cards carry a capture-order key (interleaved render) + OCR publication is suppressed
## for privacy-masked lanes -- both change a run's published assets, so old entries must not be reused.
## v5: privacy-masked lanes get PER-RECT OCR redaction (re-OCR + drop in-rect tokens) instead of a
## whole-lane drop, so a masked lane's published OCR asset differs from a v4 entry.
CACHE_FORMAT_VERSION = 5

## Legend: status -> human label. Order is display order on the page.
STATUS_LABEL = [
    (site.STATUS_PASS, "pass"),
    (site.STATUS_FAIL, "fail"),
    (site.STATUS_INCONCLUSIVE, "inconclusive"),
    (site.STATUS_INCOMPLETE, "did not finish"),
    (site.STATUS_STALE, "stale (too old)"),
    (site.STATUS_UNKNOWN, "unknown"),
    (site.STATUS_NODATA, "no data"),
]


## Overview SORT order, worst (most attention) first. Distinct from STATUS_LABEL,
## which is legend/display order (pass first).
_SORT_ORDER = [
    site.STATUS_FAIL, site.STATUS_UNKNOWN, site.STATUS_INCOMPLETE, site.STATUS_NODATA,
    site.STATUS_INCONCLUSIVE, site.STATUS_STALE,
    site.STATUS_PASS,
]
_SORT_SEVERITY = {status: i for i, status in enumerate(_SORT_ORDER)}


def _sort_severity(status):
    return _SORT_SEVERITY.get(status, len(_SORT_ORDER))


def _view_stop_unix(view):
    if isinstance(view.result, dict):
        stop = (view.result.get("run") or {}).get("stop") or {}
        unix = stop.get("unix")
        if isinstance(unix, int) and not isinstance(unix, bool):
            return unix
    return 0


def esc(value):
    ## Captured terminal output (e.g. systemcheck's colored ERROR lines) carries raw ANSI
    ## escape sequences + C0 control bytes -- non-ASCII control chars with no place in the
    ## HTML (they render as garbage and trip the ASCII-only commit guard). Strip them
    ## centrally here: every rendered field goes through esc(). Keep \t and \n.
    import re
    s = "" if value is None else str(value)
    s = re.sub(r"\x1b\[[0-9;?]*[ -/]*[@-~]", "", s)          # ANSI CSI (colors)
    s = re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]", "", s)   # other C0 controls + DEL
    ## ASCII-fold: captured program output (step logs, firmware evidence) carries non-ASCII
    ## (e.g. U+2026 ellipsis from Calamares); numeric-escape it so the emitted page is
    ## ASCII-only (policy + the pre-commit gate) while still displaying the original glyph.
    ## No rstrip here: esc() also renders identifiers/URLs (run.id, hrefs), where trimming
    ## trailing whitespace would desync a dir name from its link. Logs use esc_log().
    return html.escape(s, quote=True).encode("ascii", "xmlcharrefreplace").decode("ascii")


def esc_log(value):
    ## esc() for captured MULTI-LINE output: strip per-line trailing whitespace first (the logs
    ## end many lines with spaces, which the ASCII-only commit gate flags as suspicious), then
    ## escape. Only for free-text log/evidence blocks, never identifiers.
    s = "" if value is None else str(value)
    s = "\n".join(line.rstrip() for line in s.split("\n"))
    return esc(s)


## Names under the output root the generator owns and must never let a run id
## shadow (colliding with the overview index.html).
RESERVED_RUN_DIRS = frozenset({"index.html"})


def safe_run_dir(run_id):
    """A run id is written as a directory name; refuse a '/' or '..' (escape) or a
    reserved name (which would hijack the overview index.html)."""
    if ("/" in run_id or run_id in (".", "..") or run_id == ""
            or run_id in RESERVED_RUN_DIRS):
        raise ValueError("unsafe or reserved run id: %r" % run_id)
    return run_id


def _sanitize_component(value):
    import re

    cleaned = re.sub(r"[^A-Za-z0-9._-]", "-", value or "")
    return cleaned or "run"


def run_dir_id(run_dir):
    """A unique, filesystem-safe id derived from <name>/<ts>, for a NO-DATA run (or
    one whose own id is unusable) -- so two lanes failing at the same timestamp do
    not collide and the lane name is not lost."""
    ts = os.path.basename(run_dir)
    name = os.path.basename(os.path.dirname(run_dir))
    return "%s__%s" % (_sanitize_component(name), _sanitize_component(ts))


def age_text(age_seconds):
    if age_seconds is None:
        return "unknown"
    if age_seconds < 0:
        return "in the future"
    days, rem = divmod(int(age_seconds), 86400)
    hours = rem // 3600
    if days > 0:
        return "%dd %dh ago" % (days, hours)
    minutes = (rem % 3600) // 60
    if hours > 0:
        return "%dh %dm ago" % (hours, minutes)
    return "%dm ago" % minutes


def load_mask_config(path):
    """lane -> list of [x, y, w, h] rects. Absent -> {} (a per-image top-right clock
    rect is then used)."""
    if not path:
        return {}
    with open(path, "r", encoding="utf-8") as handle:
        data = json.load(handle)
    if not isinstance(data, dict):
        raise ValueError("mask config must be a JSON object of lane -> rects")
    for lane, rects in data.items():
        if not isinstance(rects, list):
            raise ValueError("mask config: rects for %r must be a list" % lane)
        for rect in rects:
            if not (isinstance(rect, list) and len(rect) == 4
                    and all(isinstance(n, int) and not isinstance(n, bool) for n in rect)):
                raise ValueError(
                    "mask config: each rect for %r must be [x, y, w, h] ints" % lane)
    return data


def discover_runs(results_root):
    """Yield (run_dir, result_or_None) for every <name>/<ts>/ under results_root,
    sorted deterministically. A missing/invalid result.json yields None (NO-DATA)."""
    runs: list = []
    if not os.path.isdir(results_root):
        return runs
    for name in sorted(os.listdir(results_root)):
        name_dir = os.path.join(results_root, name)
        ## Skip a symlinked name dir or the 'latest' run symlink -- never traverse a
        ## symlink into the plane (it could point anywhere root can read).
        if os.path.islink(name_dir) or not os.path.isdir(name_dir):
            continue
        for ts in sorted(os.listdir(name_dir)):
            run_dir = os.path.join(name_dir, ts)
            if os.path.islink(run_dir) or not os.path.isdir(run_dir):
                continue
            result = _load_result(os.path.join(run_dir, "result.json"))
            runs.append((run_dir, result))
    return runs


def _load_result(path):
    ## result.json is untrusted plane input: ANY read / parse / shape error yields
    ## NO-DATA (never a crash that denies the whole site). A symlinked result.json
    ## is refused outright rather than followed.
    if os.path.islink(path):
        return None
    try:
        with open(path, "r", encoding="utf-8") as handle:
            result = json.load(handle)
        model.validate(result)
    except (OSError, ValueError, model.ModelError, AttributeError, TypeError, KeyError):
        return None
    return result


def rects_for(lane, image_size, mask_config):
    rects = mask_config.get(lane)
    if rects:
        return [tuple(rect) for rect in rects]
    ## No configured rect: blank the usual top-right clock corner.
    return [imaging.top_right_rect(image_size)]


class RunView:
    """Everything the templates need about one run, computed once."""

    def __init__(self, run_id, run_dir, result, status, age, shots, cards=None):
        self.run_id = run_id
        self.run_dir = run_dir
        self.result = result
        self.status = status
        self.age = age
        self.shots = shots  # list of dicts: sid, step, name, webp, validation, ocr
        ## State-card TEXT panels (synthetic cards published as text, not an image): list of
        ## dicts {step, name, text}. Separate from shots so the image harvest never grows one.
        self.cards = cards if cards is not None else []

    @property
    def is_green(self):
        return site.is_green(self.status)

    def key(self):
        if isinstance(self.result, dict):
            return site.run_key(self.result)
        ## NO-DATA run: key off the results-plane NAME (not the unique run id), so
        ## repeated NO-DATA runs of the same lane collapse to the latest and older
        ## ones get pruned -- else every emitter-failure dir would accumulate forever.
        name = os.path.basename(os.path.dirname(self.run_dir))
        return (name, "", "", "__nodata__")


def desired_run_id(run_dir, result):
    """The run's own id if valid + not reserved, else a unique dir-derived id. Does
    NOT guarantee global uniqueness -- main() resolves collisions before processing,
    since the page dir must be settled before shots are written into it."""
    if not isinstance(result, dict):
        return run_dir_id(run_dir)
    try:
        return safe_run_dir(result["run"]["id"])
    except (ValueError, KeyError, TypeError):
        return run_dir_id(run_dir)


def process_run(run_dir, result, run_id, out_root, mask_config, now_unix, stale_seconds):
    """Normalize + publish a run's screenshots into the run's output dir (run_id,
    already made unique by main), and compute the objective status."""
    if not isinstance(result, dict):
        return RunView(run_id, run_dir, None, site.STATUS_NODATA, None, [])

    run = result["run"]
    lane = run["lane"]
    page_dir = os.path.join(out_root, run_id)

    ## Rebuild the run dir from scratch: drop any stale artifact a prior generate wrote but
    ## this one no longer emits, so a lingering committed file is not flagged orphaned by the
    ## asset check and does not block the publish. The dir is fully generator-owned. Skip a
    ## symlink (match prune(): never rmtree THROUGH one).
    if os.path.isdir(page_dir) and not os.path.islink(page_dir):
        shutil.rmtree(page_dir)

    shots = []
    cards = []
    ## OCR sidecars publish the RECOGNIZED TEXT of a frame, which a pixel privacy mask cannot blank
    ## (the mask hides image regions; the text is not spatial). A lane with CONFIGURED privacy rects
    ## gets PER-RECT redaction: re-OCR the shot and drop only the tokens that overlap a rect, still
    ## publishing the rest (operator decision). A lane with only the default clock mask (no entry)
    ## is not sensitive, so its run-time OCR sidecar is published verbatim.
    lane_rects = mask_config.get(lane)
    for step in result["steps"]:
        ## `seq` is each attachment's index in attachments[], carried onto shots/cards so an
        ## equal-NN tie breaks in attachments[] order (not "all shots then all cards").
        indexed = list(enumerate(step["attachments"]))
        image_atts = [(i, a) for i, a in indexed
                      if str(a.get("mediaType", "")).startswith(IMAGE_MEDIA_PREFIX)]
        text_atts = [(i, a) for i, a in indexed if str(a.get("mediaType", "")) == TEXT_MEDIA]
        step_shots = {}  # stored attachment path -> its shot dict, for OCR pairing
        for seq, attachment in image_atts:
            shot = _process_shot(
                run_dir, page_dir, lane, step, attachment, mask_config, len(image_atts))
            shot["seq"] = seq
            shots.append(shot)
            step_shots[attachment["path"]] = shot
        ## A text/plain attachment is EITHER a shot's OCR sidecar (path == a shot path + .ocr.txt)
        ## OR a standalone state-card text. Classify by the .ocr.txt SUFFIX, never by pairing: an
        ## ORPHAN .ocr.txt (its shot missing/dropped, or a crafted untrusted result.json) must NOT
        ## fall through to the card branch -- that would embed the OCR text as a panel and bypass
        ## the privacy-mask suppression below. OCR links only when the shot exists AND the lane is
        ## not privacy-masked; otherwise the sidecar is simply not published.
        for seq, attachment in text_atts:
            path = str(attachment.get("path", ""))
            if path.endswith(OCR_SUFFIX):
                shot_path = path[:-len(OCR_SUFFIX)]
                paired = step_shots.get(shot_path)
                if paired is not None:
                    if lane_rects:
                        ## Privacy-masked lane: re-OCR + drop tokens inside a rect (per-rect redaction).
                        ocr_name = _attach_redacted_ocr(
                            run_dir, page_dir, paired["sid"], shot_path, lane_rects)
                    else:
                        ## Not privacy-masked: publish the run-time OCR sidecar verbatim.
                        ocr_name = _attach_ocr(run_dir, page_dir, paired["sid"], path)
                    if ocr_name:
                        paired["ocr"] = ocr_name
            else:
                text = _read_text_asset(run_dir, path)
                if text is not None:
                    cards.append(
                        {"step": step["name"], "name": attachment.get("name") or "", "text": text,
                         "order": _milestone_order(step["name"], path), "seq": seq})

    status, age = site.run_cell_status(result, now_unix, stale_seconds)
    return RunView(run_id, run_dir, result, status, age, shots, cards)


def _screenshot_id(lane, step_name, attachment_name, shot_count):
    base = "%s/%s" % (lane, step_name)
    ## Only disambiguate by attachment when a step carries more than one shot.
    if shot_count > 1:
        base = "%s/%s" % (base, attachment_name)
    return base


def _milestone_order(step_name, path):
    """Capture-sequence key from a stored attachment path's NN- prefix: the publisher names shots
    '<step>-NN-name.png' and cards 'NN-name.card.txt', so shots and cards must render INTERLEAVED in
    capture order, not grouped (all images then all cards would drop a pre-boot card below the whole
    screenshot run). Strip an optional '<step>-' prefix, then read the leading digits; no NN -> 0 (a
    lone/unprefixed shot keeps a stable position). Ordered by NN -- NOT by milestone name, which is
    alphabetical and NOT capture order."""
    import re
    base = path
    prefix = step_name + "-"
    if base.startswith(prefix):
        base = base[len(prefix):]
    ## An NN is a handful of digits. Match the FULL leading digit run, but treat an absurdly long
    ## one (a crafted/garbage path) as UNORDERABLE -> 0, rather than (a) int()-ing it, which raises
    ## ValueError past CPython's 4300-digit limit and would crash the whole generate, or (b) a
    ## fixed-width cap, which would TRUNCATE a long NN and silently misorder it. 9 digits
    ## (<= 999,999,999) is far beyond any real milestone and cannot overflow.
    match = re.match(r"(\d+)", base)
    if match is None or len(match.group(1)) > 9:
        return 0
    return int(match.group(1))


def _process_shot(run_dir, page_dir, lane, step, attachment, mask_config, shot_count):
    step_name = step["name"]
    sid = _screenshot_id(lane, step_name, attachment["name"], shot_count)
    ## attachment["path"] was validated as a safe basename by model.validate, so it
    ## cannot escape run_dir. Still refuse a SYMLINK: its versioned name is safe but
    ## its target could be any file root could read -- never follow it.
    current_path = os.path.join(run_dir, attachment["path"])

    ## `validation` is the per-shot CONTENT verdict (did it show the right thing), SEPARATE from
    ## the step's functional pass/fail; `ocr` is the served OCR-sidecar filename (set later when a
    ## matching text attachment is paired in). Both default fail-closed / absent.
    base = {"sid": sid, "step": step_name, "name": attachment["name"], "webp": None,
            "validation": _validation_of(attachment), "ocr": None,
            "order": _milestone_order(step_name, attachment["path"])}
    if os.path.islink(current_path):
        return base

    ## Normalize (mask the clock + any configured privacy rects) and publish. A per-shot
    ## read/encode error leaves webp=None (shown as missing), never aborts the run/site.
    try:
        rects = rects_for(lane, imaging.normalize_image(current_path, None).size, mask_config)
        current = imaging.normalize_image(current_path, rects)
        os.makedirs(page_dir, exist_ok=True)
        out_name = _flatten(sid) + ".webp"
        _save_webp(current, os.path.join(page_dir, out_name))
        base["webp"] = out_name
    except Exception:  # noqa: BLE001 -- any shot error is per-shot, never aborts the run/site
        base["webp"] = None
    return base


def _read_text_asset(run_dir, path):
    """Read a text asset (a state-card body) from the plane for INLINE embedding. Refuse a symlink
    (never follow one into a root-only file, same discipline as a shot read) and bound the read, so
    a runaway/oversized source cannot bloat the page. Returns the text, or None (a
    missing/symlinked/unreadable asset simply renders no panel -- never aborts the run/site).

    Scope: the generator reads the plane AFTER the emitter ingested it (root copies each account
    source no-follow, then chowns the run dir), so at generate time these files are root/owner-owned,
    NOT adversary-writable -- the islink guard matches the existing shot read and no O_NOFOLLOW/
    openat-chain is owed here (that defense lives in the emitter, where the source IS account-owned)."""
    src = os.path.join(run_dir, path)
    if os.path.islink(src):
        return None
    try:
        with open(src, "rb") as handle:
            data = handle.read(MAX_TEXT_ASSET_BYTES + 1)
    except OSError:
        return None
    if len(data) > MAX_TEXT_ASSET_BYTES:
        data = data[:MAX_TEXT_ASSET_BYTES]
    return data.decode("utf-8", errors="replace")


def _tokens_overlap_rect(left, top, width, height, rect):
    """True if a tesseract word box (left, top, width, height) overlaps a privacy mask rect
    (x, y, w, h). Half-open intervals: touching edges do NOT overlap. Both are in native image
    pixel space (normalize_image does not resize), so the comparison is direct."""
    x, y, rect_w, rect_h = rect[0], rect[1], rect[2], rect[3]
    return left < x + rect_w and left + width > x and top < y + rect_h and top + height > y


def _redact_ocr_text(words, rects):
    """Join the OCR word tokens whose box does NOT overlap ANY privacy mask rect, in tesseract's
    reading order. Fail-closed PER TOKEN: a token whose box overlaps a rect AT ALL is dropped (a
    pixel mask cannot blank recognized text, so an overlapping token could leak masked content).
    Tokens outside every rect are kept, so the rest of the frame's OCR still publishes."""
    kept = []
    for left, top, width, height, text in words:
        if any(_tokens_overlap_rect(left, top, width, height, rect) for rect in rects):
            continue
        kept.append(text)
    return " ".join(kept)


def _attach_redacted_ocr(run_dir, page_dir, sid, shot_rel_path, rects):
    """Publish a PER-RECT-REDACTED OCR sidecar for a privacy-masked lane: re-OCR the shot for word
    boxes, drop every token overlapping a configured rect, and write the surviving text. Used
    instead of copying the run-time .ocr.txt (which is the UNmasked full text). Fail-closed: if
    tesseract is unavailable or the OCR/read fails, publish NO sidecar (never the unmasked text).
    Returns the served basename, or None."""
    src = os.path.join(run_dir, shot_rel_path)
    if os.path.islink(src) or not os.path.isfile(src):
        return None
    try:
        words = ocr.tesseract_words(src)
    except Exception:  # noqa: BLE001 -- fail-closed: ANY OCR error (no tesseract, CalledProcessError,
        ## bad image) publishes NO sidecar, never the unmasked run-time text.
        return None
    redacted = _redact_ocr_text(words, rects)
    out_name = _flatten(sid) + OCR_SUFFIX
    try:
        os.makedirs(page_dir, exist_ok=True)
        with open(os.path.join(page_dir, out_name), "w", encoding="utf-8") as out:
            out.write(redacted)
    except OSError:
        return None
    return out_name


def _attach_ocr(run_dir, page_dir, sid, path):
    """Copy a shot's OCR sidecar from the plane into the page dir so it can be LINKED under the
    image as evidence. Refuse a symlink + bound the copy (as the shot read does). Returns the
    served basename, or None (a missing/symlinked/unreadable sidecar just drops the link)."""
    src = os.path.join(run_dir, path)
    if os.path.islink(src):
        return None
    try:
        with open(src, "rb") as handle:
            data = handle.read(MAX_TEXT_ASSET_BYTES + 1)
    except OSError:
        return None
    if len(data) > MAX_TEXT_ASSET_BYTES:
        data = data[:MAX_TEXT_ASSET_BYTES]
    out_name = _flatten(sid) + OCR_SUFFIX
    try:
        os.makedirs(page_dir, exist_ok=True)
        with open(os.path.join(page_dir, out_name), "wb") as out:
            out.write(data)
    except OSError:
        return None
    return out_name


def _flatten(sid):
    """A screenshot id (lane/step[/name]) -> a flat, filesystem-safe basename for
    the per-run page dir."""
    return sid.replace("/", "__")


def _save_webp(image, path):
    ## Lossless webp, deterministic for a given input + params.
    image.save(path, format="WEBP", lossless=True, quality=100, method=6)


def _file_sha256(path):
    """sha256 hex of a file's bytes, following a symlink as the generator's own reads do; a fixed
    sentinel if it cannot be read. A per-file read error must DEGRADE the fingerprint, never abort
    the whole generate -- process_run already isolates the same error per shot as UNKNOWN."""
    digest = hashlib.sha256()
    try:
        with open(path, "rb") as handle:
            for chunk in iter(lambda: handle.read(1 << 16), b""):
                digest.update(chunk)
    except OSError:
        return "unreadable"
    return digest.hexdigest()


def _path_sha256_or_empty(path):
    ## Follow a symlink (os.path.isfile is true for a symlink-to-file), because
    ## load_mask_config follows it -- hashing by content keeps the fingerprint tracking what
    ## the generator reads, so an edit to a symlinked mask config invalidates the cache.
    if path and os.path.isfile(path):
        return _file_sha256(path)
    return ""


def shared_input_fingerprint(mask_config_path):
    """Digest of every GENERATE-WIDE input that affects a run's page assets: the cache format
    version and the mask config. Folded into every run's fingerprint, so a mask change
    invalidates the whole cache. Hashes files by raw bytes (no parse-shape assumptions)."""
    digest = hashlib.sha256()
    digest.update(("cachefmt=%d\0" % CACHE_FORMAT_VERSION).encode("ascii"))
    digest.update(("mask=%s\0" % _path_sha256_or_empty(mask_config_path)).encode("ascii"))
    return digest.hexdigest()


def run_source_fingerprint(run_dir, result, shared_fp):
    """Digest of one run's own inputs -- its result record (steps, attachments, exit/status/tails,
    lane, id, stop time) plus the content of every source screenshot it references. With
    shared_fp it fully determines the run's page assets."""
    digest = hashlib.sha256()
    digest.update(shared_fp.encode("ascii"))
    digest.update(b"\0")
    digest.update(json.dumps(result, ensure_ascii=True, sort_keys=True,
                             separators=(",", ":")).encode("ascii"))
    digest.update(b"\0")
    ## Hash the source bytes of every attachment that AFFECTS a page asset -- image shots AND text
    ## assets (OCR sidecars, state cards) -- so an edited sidecar or card body invalidates the
    ## cache, not just a changed image. Skip any other mediaType: it is never rendered, so hashing
    ## it would only let an untrusted plane stall the generate by referencing a huge unrelated file.
    for step in result["steps"]:
        for attachment in step["attachments"]:
            media = str(attachment.get("mediaType", ""))
            if not (media.startswith(IMAGE_MEDIA_PREFIX) or media == TEXT_MEDIA):
                continue
            token = str(attachment.get("path", ""))
            path = os.path.join(run_dir, token)
            if os.path.isfile(path) and not os.path.islink(path):
                sha = _file_sha256(path)
            else:
                sha = "absent-or-symlink"
            digest.update(("%s=%s\0" % (token, sha)).encode("utf-8", "surrogatepass"))
    return digest.hexdigest()


def resolve_cache_dir(cache_dir_arg, site_out):
    if cache_dir_arg:
        return cache_dir_arg
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    ## Key the default cache by the absolute site-out path, so two different sites never share a
    ## cache dir (a run id collision between sites would otherwise cross-contaminate).
    key = hashlib.sha256(
        os.path.abspath(site_out).encode("utf-8", "surrogatepass")).hexdigest()[:16]
    return os.path.join(base, "test-results-site-generate", key)


def load_cached_view(cache_dir, run_id, fingerprint, out_root, run_dir, result,
                     now_unix, stale_seconds):
    """A RunView rebuilt from cache when the fingerprint matches AND every cached webp is still
    present on disk; else None (caller does a full build). Status/age are recomputed from the
    CURRENT clock, so freshness/stale stay correct with no image work."""
    path = os.path.join(cache_dir, run_id + ".json")
    try:
        with open(path, "r", encoding="utf-8") as handle:
            cached = json.load(handle)
    except (OSError, ValueError):
        return None
    if cached.get("fingerprint") != fingerprint:
        return None
    shots = cached.get("shots")
    if not isinstance(shots, list):
        return None
    cards = cached.get("cards")
    if not isinstance(cards, list):
        return None
    webp_sha = cached.get("webp_sha")
    if not isinstance(webp_sha, dict):
        return None
    page_dir = os.path.join(out_root, run_id)
    ## The reuse is valid only if the page dir holds EXACTLY the generator-owned files this run
    ## produces, with the SAME BYTES: every cached asset (webp shot + copied OCR sidecar) present
    ## and matching its recorded sha, and NO extra file. A stray file (an artifact a prior generate
    ## no longer emits, a planted file) or a changed/corrupt asset means the full build is still
    ## owed -- fall back so process_run's rmtree + re-encode run. (Cards embed inline, no file.)
    expected = {"index.html"}
    for shot in shots:
        for name in (shot.get("webp"), shot.get("ocr")):
            if name:
                expected.add(name)
                full = os.path.join(page_dir, name)
                if not os.path.isfile(full) or _file_sha256(full) != webp_sha.get(name):
                    return None
    try:
        present = set(os.listdir(page_dir))
    except OSError:
        return None
    if present - expected:
        return None
    status, age = site.run_cell_status(result, now_unix, stale_seconds)
    return RunView(run_id, run_dir, result, status, age, shots, cards)


def store_cached_view(cache_dir, run_id, fingerprint, view, out_root):
    """Persist a fully-built run's fingerprint + classification + the sha of each webp it wrote,
    so the next generate can verify the on-disk bytes before reusing them. A cache write failure
    never fails the generate -- it only forfeits the next run's speedup."""
    if not isinstance(view.result, dict):
        return
    page_dir = os.path.join(out_root, run_id)
    webp_sha = {}
    for shot in view.shots:
        for name in (shot.get("webp"), shot.get("ocr")):
            if name:
                webp_sha[name] = _file_sha256(os.path.join(page_dir, name))
    try:
        os.makedirs(cache_dir, exist_ok=True)
        payload = json.dumps({"fingerprint": fingerprint, "shots": view.shots,
                              "cards": view.cards, "webp_sha": webp_sha},
                             ensure_ascii=True, sort_keys=True, indent=2) + "\n"
        tmp = os.path.join(cache_dir, run_id + ".json.tmp")
        with open(tmp, "w", encoding="utf-8") as handle:
            handle.write(payload)
        os.replace(tmp, os.path.join(cache_dir, run_id + ".json"))
    except (OSError, TypeError, ValueError):
        ## Best-effort cache write: a failure only forfeits the next run's
        ## incremental speedup, never the correctness of this run's output.
        pass


def select_keep(views, history):
    """Keep the latest run per (lane, version, builder, provenance) plus the
    `history` most recent runs overall. Deterministic."""
    def sort_key(view):
        stop = 0
        if isinstance(view.result, dict):
            stop = ((view.result.get("run") or {}).get("stop") or {}).get("unix") or 0
        return (stop, view.run_id)

    ordered = sorted(views, key=sort_key, reverse=True)
    keep = set()
    seen_keys = set()
    for view in ordered:
        if view.key() not in seen_keys:
            seen_keys.add(view.key())
            keep.add(view.run_id)
    for view in ordered[:history]:
        keep.add(view.run_id)
    return keep


def prune(out_root, keep_ids):
    """Remove per-run dirs under out_root that are not in keep_ids. Never touches
    the overview index.html."""
    if not os.path.isdir(out_root):
        return
    for entry in sorted(os.listdir(out_root)):
        if entry in RESERVED_RUN_DIRS:
            continue
        full = os.path.join(out_root, entry)
        ## Skip symlinks: os.path.isdir follows them, and rmtree on a symlinked
        ## dir raises; a run dir the generator writes is never a symlink.
        if os.path.islink(full):
            continue
        if os.path.isdir(full) and entry not in keep_ids:
            shutil.rmtree(full)


## --------------------------------------------------------------------------
## HTML (strict CSP, no inline JS; status via st-<status> classes in style.css)
## --------------------------------------------------------------------------

CSP = (
    "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; "
    "img-src 'self' data:; base-uri 'none'; form-action 'none'"
)

## Built-in header fallback (used when --chrome-from is not given, e.g. standalone
## or in the suite). For the real site, --chrome-from an existing family page lifts
## that page's exact masthead so the uniform-nav gate (identical header across all
## pages) passes without this needing to track family nav edits.
_DEFAULT_HEADER = (
    '<header class="nav"><div class="wrap">'
    '<a class="brand" href="/">org-ai-assisted</a>'
    '<nav aria-label="Primary"><a href="/automated-test-results/">Test results</a>'
    '<a href="https://github.com/org-ai-assisted">GitHub</a>'
    '<a href="https://output-lies.github.io">output lies</a>'
    '<a href="https://secure-terminal.github.io">secure-terminal</a></nav>'
    "</div></header>"
)

## Footer is ALWAYS built here, never lifted: a family page's footer carries that
## page's own on-page section anchors (#overview, ...), which do not exist on a
## results page and would read as broken links. This footer carries only the three
## family URLs the family-footer gate requires, with no on-page anchors.
##
## Structure: each gutter-bearing row (.ftop, .fbot) is a DIRECT <footer> child, as
## in every family footer. style.css gives .ftop and .fbot their own
## max-width/margin:auto + 22px horizontal padding, so wrapping them in an extra
## .wrap double-applies the gutter and misaligns the rows -- the broken-footer bug
## the website-tests footer-structure gate now catches.
_FOOTER = (
    '<footer><div class="ftop"><nav class="fcols" aria-label="Footer"><div class="fcol">'
    "<h3>Family</h3>"
    '<a href="https://output-lies.github.io">output lies</a>'
    '<a href="https://secure-terminal.github.io">secure-terminal</a>'
    '<a class="self" href="https://org-ai-assisted.github.io" aria-current="page">org-ai-assisted</a>'
    '</div></nav></div>'
    '<div class="fbot"><span class="fcopy">AI-assisted. Automated OS-image test results.</span></div>'
    "</footer>"
)


def extract_header(path):
    """Lift the verbatim <header>...</header> from an existing family page so every
    generated page carries an identical masthead (the uniform-nav gate). The footer
    is NOT lifted (see _FOOTER)."""
    import re

    with open(path, "r", encoding="utf-8") as handle:
        text = handle.read()
    header = re.search(r"<header\b.*?</header>", text, re.DOTALL)
    if not header:
        raise ValueError("could not find <header> in %s" % path)
    return header.group(0)


def page(title, description, header, footer, body, noindex=False):
    # A per-run detail page is ephemeral (pruned as runs roll over), so it opts out
    # of indexing + the sitemap -- otherwise sitemap.xml churns every run. The
    # overview is the stable landing page and stays indexable.
    robots = '<meta name="robots" content="noindex">\n' if noindex else ''
    return (
        "<!DOCTYPE html>\n"
        '<html lang="en">\n'
        '<meta charset="utf-8">\n'
        '<meta http-equiv="Content-Security-Policy" content="%s">\n'
        '<meta name="viewport" content="width=device-width, initial-scale=1">\n'
        '<meta name="ai-disclosure" content="ai-assisted">\n'
        "%s"
        "<title>%s</title>\n"
        '<meta name="description" content="%s">\n'
        '<link rel="stylesheet" href="/style.css">\n'
        "%s\n<main>\n%s\n</main>\n%s\n"
        "</html>\n"
    ) % (CSP, robots, esc(title), esc(description), header, body, footer)


def status_chip(status):
    label = dict(STATUS_LABEL).get(status, status)
    return '<span class="chip %s">%s</span>' % (site.css_class(status), esc(label))


def run_fields(view):
    run = view.result["run"] if isinstance(view.result, dict) else {}
    prov = view.result.get("provenance", {}) if isinstance(view.result, dict) else {}
    env = view.result.get("environment") if isinstance(view.result, dict) else None
    fw = (env or {}).get("firmware") or {}
    return {
        "lane": run.get("lane", view.run_id),
        "version": run.get("version", ""),
        "builder": run.get("builder", ""),
        "origin": (prov or {}).get("origin", ""),
        "verdict": run.get("verdict", ""),
        ## The artifact's sha256 (provenance.artifact.digest.sha256) pins the exact ISO a
        ## run tested; absent/old results leave it "".
        "sha256": ((((prov or {}).get("artifact") or {}).get("digest")) or {}).get("sha256") or "",
        ## Firmware-lane EVIDENCE: what the guest actually booted (environment.firmware). Absent
        ## on old runs -> "" / None, so no panel is rendered.
        "fw_declared": fw.get("declared", "") or "",
        "fw_detected": fw.get("detected", "") or "",
        "fw_evidence": fw.get("evidence", "") or "",
        "fw_match": fw.get("match"),
    }


def render_overview(views, header, footer, generated_utc):
    rows = []
    for view in views:
        f = run_fields(view)
        rows.append(
            "<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td>"
            "<td>%s</td><td>%s</td><td><a href=\"%s/\">details</a></td></tr>"
            % (
                esc(f["lane"]), esc(f["version"]), esc(f["builder"]), esc(f["origin"]),
                status_chip(view.status), esc(age_text(view.age)), esc(view.run_id),
            )
        )
    matrix = (
        '<section class="cat" id="matrix"><div class="wrap">'
        "<h2 class=\"catname\">Runs</h2>"
        '<div class="matrix-wrap"><table class="matrix"><thead><tr><th>lane</th>'
        "<th>version</th><th>builder</th><th>provenance</th><th>status</th>"
        "<th>age</th><th>details</th></tr></thead><tbody>%s</tbody></table></div>"
        "</div></section>"
    ) % ("".join(rows) if rows else '<tr><td colspan="7">no runs</td></tr>')

    legend_items = "".join(
        "<li>%s</li>" % status_chip(status) for status, _ in STATUS_LABEL
    )
    legend = (
        '<section class="cat" id="legend"><div class="wrap">'
        '<h2 class="catname">Legend</h2><ul class="legend">%s</ul>'
        "<p>Only pass is green. Stale, unknown, inconclusive and no-data are never "
        "green, and the age is always shown.</p>"
        "</div></section>"
    ) % legend_items

    body = (
        '<section class="hero"><div class="wrap">'
        '<p class="kicker">automated test suite</p>'
        "<h1>Test results</h1>"
        '<p class="line">OS-image install + boot runs. Status is objective: a run is '
        "green only when it finished with a PASS verdict on the declared firmware lane "
        "and is still fresh; every must-render milestone screenshot is checked for a "
        "blank render at run time. Generated %s.</p></div></section>%s%s"
    ) % (esc(generated_utc), matrix, legend)
    return page(
        "Test results", "Automated OS-image install + boot test-run results.",
        header, footer, body,
    )


def _firmware_block(f):
    ## Evidence of the firmware lane the guest ACTUALLY booted (environment.firmware): declared
    ## vs detected + the probe command/output, with a match/mismatch chip. "" when not captured
    ## (old runs), so no panel is rendered.
    if not (f["fw_detected"] or f["fw_evidence"]):
        return ""
    match = f["fw_match"]
    if match is True:
        chip, note = status_chip(site.STATUS_PASS), "verified against the declared lane"
    elif match is False:
        chip, note = status_chip(site.STATUS_FAIL), "MISMATCH: the guest did not boot the declared lane"
    else:
        chip, note = status_chip(site.STATUS_UNKNOWN), "unverified"
    pre = ('<pre class="steplog" tabindex="0">%s</pre>' % esc_log(f["fw_evidence"])) if f["fw_evidence"] else ""
    return (
        '<div class="issue"><h3>Firmware lane %s</h3>'
        "<p>declared <code>%s</code> &middot; detected <code>%s</code> &middot; %s</p>%s</div>"
    ) % (chip, esc(f["fw_declared"] or "?"), esc(f["fw_detected"] or "?"), esc(note), pre)


def _validation_tally_line(view):
    ## Per-run content-validation tally over the published SHOTS (cards are authoritative text, not
    ## validated): "screenshots: X validated, Y unvalidated, Z mismatch, W OCR error". So the
    ## operator sees at a glance how much of the story is actually content-checked vs just green.
    ## "" when the run has no shots (e.g. a packet lane).
    if not view.shots:
        return ""
    counts = {key: 0 for key in model.VALID_VALIDATION}
    for shot in view.shots:
        v = shot.get("validation")
        counts[v if v in counts else model.VALIDATION_UNVALIDATED] += 1
    return (
        '<p class="line">screenshots: %d validated, %d unvalidated, %d mismatch, %d OCR error</p>'
    ) % (
        counts[model.VALIDATION_VALIDATED], counts[model.VALIDATION_UNVALIDATED],
        counts[model.VALIDATION_MISMATCH], counts[model.VALIDATION_OCR_ERROR],
    )


def render_run(view, header, footer, generated_utc):
    f = run_fields(view)
    ## Firmware-lane evidence is a one-line attestation, NOT a peer of the test steps --
    ## side-by-side in the .fg grid it left a near-empty half-column next to the tall
    ## step card. Render it full-width ABOVE the steps instead ("" -> omitted). The steps
    ## stay in the .fg grid, so a single step is grid-only-child (full width) and multiple
    ## steps still tile; the firmware card always stacks above them.
    fw_block = _firmware_block(f)
    step_blocks = []
    if isinstance(view.result, dict):
        for step in view.result["steps"]:
            step_blocks.append(render_step(view, step))
    else:
        step_blocks.append(
            '<div class="issue"><h3>No data</h3><p>This run has no readable '
            "result.json.</p></div>"
        )
    ## The exact ISO sha256 (when recorded): a long unbreakable token, so it wraps and is
    ## shown on its own line rather than crammed into the summary line.
    sha_line = (
        '<p class="line">sha256 <code class="runid">%s</code></p>' % esc(f["sha256"])
    ) if f["sha256"] else ""
    tally_line = _validation_tally_line(view)
    body = (
        '<section class="hero"><div class="wrap">'
        # .runid: a machine run-id is a long unbreakable token; the default hero h1
        # is white-space:nowrap, so it must opt into wrapping or it overflows mobile.
        '<p class="kicker">%s</p><h1 class="runid">%s</h1>'
        '<p class="line">%s %s &middot; builder %s &middot; provenance %s &middot; '
        "%s &middot; %s</p>"
        "%s%s"
        '<p class="sub"><a href="../">back to all results</a></p>'
        "</div></section>"
        '<section class="cat"><div class="wrap"><h2 class="catname">Run detail</h2>'
        "%s<div class=\"fg\">%s</div></div></section>"
    ) % (
        esc(f["lane"]), esc(view.run_id), esc(f["lane"]), esc(f["version"]),
        esc(f["builder"]), esc(f["origin"]), status_chip(view.status),
        esc(age_text(view.age)), sha_line, tally_line, fw_block, "".join(step_blocks),
    )
    return page(
        "Run %s" % view.run_id, "Test run %s" % view.run_id, header, footer, body,
        noindex=True,
    )


def _card_html(card):
    ## A synthetic state card published as TEXT (vm-defined, vbox-host, ...): rendered as a text
    ## panel, never an <img>. The text is authoritative (no OCR round-trip, no golden), so there
    ## is NO content-validation chip here -- only shots get one. Reuses the frozen steplog/stage
    ## classes; no new CSS class.
    parts = ["<p>"]
    name = card.get("name") or ""
    if name:
        parts.append("<strong>%s</strong>" % esc(name))
        stage = _milestone_stage(name)
        if stage:
            parts.append(' <span class="stage">(%s)</span>' % esc(stage))
    parts.append("</p>")
    parts.append('<pre class="steplog" tabindex="0">%s</pre>' % esc_log(card.get("text", "")))
    return "".join(parts)


def render_step(view, step):
    shots = [s for s in view.shots if s["step"] == step["name"]]
    cards = [c for c in view.cards if c["step"] == step["name"]]
    status_cls = _step_status_class(step.get("status"))
    ## Render the FULL stored step tails -- no second truncation here. The emitter already
    ## bounds them (TAIL_BYTES) and prepends an honest marker when it clipped a larger log, so
    ## a re-cut here only hid real output (a full systemcheck run exceeds the old 1200-char cut
    ## and showed as "...emcheck#" mid-word). The <pre> blocks scroll (style.css) so a long log
    ## never blows out the page.
    caption = (
        "<h3>%s %s</h3>"
        "<p>exit %s</p>"
        "<pre class=\"steplog\" tabindex=\"0\">%s</pre><pre class=\"steplog\" tabindex=\"0\">%s</pre>"
    ) % (
        esc(step["name"]), status_chip(status_cls), esc(step.get("exit")),
        esc_log(step.get("stdout_tail", "") or ""), esc_log(step.get("stderr_tail", "") or ""),
    )
    if not shots and not cards:
        ## Text-only step: NO image slot, never a broken-image blank.
        return '<div class="issue">%s</div>' % caption

    ## Render the milestone sequence in CAPTURE order. Shots and cards INTERLEAVE (a card like
    ## vm-defined at NN=10 precedes screenshots, while vm-stopped-iso-detached at NN=41 sits mid-run),
    ## so order the combined set by (NN capture key, attachments[] index) -- NOT by milestone name
    ## (alphabetical != capture order). The seq tiebreak keeps an equal-NN shot/card pair in the
    ## order result.json listed them, not "all shots then all cards".
    items = [("shot", s) for s in shots] + [("card", c) for c in cards]
    items.sort(key=lambda it: (it[1].get("order", 0), it[1].get("seq", 0)))
    body = []
    for kind, item in items:
        if kind == "shot":
            body.append(_shot_html(view, item, status_cls))
        else:
            body.append(_card_html(item))
    return '<div class="issue">%s%s</div>' % (caption, "".join(body))


def _milestone_stage(name):
    """Boot PHASE for a milestone, derived from its name, so every screenshot states which stage
    it is from -- live/pre-install vs the installed system's first boot vs post-boot checks -- and
    the two firmware shots (live 'firmware-state' vs installed 'installed-firmware-logo') are never
    ambiguous. Returns '' for an unrecognized name (never a guessed phase)."""
    n = (name or "").lower()
    ## Installed-system milestones FIRST, so 'installed-*' is not mis-split by the 'install-'
    ## (Calamares, live) prefix, and 'sysmaint'/'luks' boot phases win over a bare substring.
    if n.startswith("installed-") or n.startswith("mok-reboot") or n.startswith("first-boot"):
        return "installed system / first boot"
    if n.startswith("mok-"):
        return "installed system / MOK enrollment"
    if n.startswith("sysmaint"):
        return "installed system / sysmaint boot"
    if n.startswith("luks"):
        return "boot / LUKS unlock"
    ## Live environment: the boot into it AND the Calamares installer that runs there
    ## (welcome / partitions / install-done) -- all pre-install. 'install-' (dash) must NOT catch
    ## 'installed-' above (it does not: 'installed' has no dash after 'install').
    if (n.startswith("live-") or n == "firmware-state" or n.startswith("welcome")
            or n.startswith("partitions") or n.startswith("install-")):
        return "live / pre-install"
    if n.startswith("check") or n.startswith("vt-") or n == "vt":
        return "post-boot checks"
    return ""


def _validation_chip(validation):
    ## The per-shot CONTENT verdict as a SECOND chip (explicit text), beside the functional one.
    ## "unvalidated != pass": it is coloured via the mapped st-* class (validated->pass,
    ## mismatch->fail, unvalidated/ocr-error->inconclusive), reusing the frozen class contract --
    ## NO new CSS class. A shot with no recorded validation reads UNVALIDATED here, never green.
    cls = _VALIDATION_CLASS.get(validation, site.STATUS_INCONCLUSIVE)
    label = _VALIDATION_LABEL.get(validation, _VALIDATION_LABEL[model.VALIDATION_UNVALIDATED])
    return '<span class="chip %s">%s</span>' % (site.css_class(cls), esc(label))


def _shot_html(view, shot, step_status_cls=None):
    ## A published shot carries the STEP's functional status chip PLUS a second CONTENT-validation
    ## chip. The functional chip says the step passed; the content chip says whether THIS frame
    ## showed the right thing for its stage -- so an unvalidated shot on a passing run is visibly
    ## NOT green (inconclusive), closing the "every screenshot reads green" false-green.
    shot_cls = step_status_cls if step_status_cls is not None else site.STATUS_PASS
    parts = ["<p>%s %s" % (status_chip(shot_cls), _validation_chip(shot.get("validation")))]
    ## Label the milestone (welcome, partitions, first-boot, ...) so a multi-shot "full
    ## story" is readable. A lone unnamed shot carries the placeholder name "screenshot"
    ## (one-shot runs) -- omit the redundant caption there.
    milestone = shot.get("name") or ""
    if milestone and milestone != "screenshot":
        parts.append(" <strong>%s</strong>" % esc(milestone))
        ## State the boot PHASE (live / installed-first-boot / post-boot checks) so a milestone's
        ## stage is explicit -- the operator must never have to guess whether a firmware shot is
        ## the live or the installed system.
        stage = _milestone_stage(milestone)
        if stage:
            parts.append(' <span class="stage">(%s)</span>' % esc(stage))
    parts.append("</p>")
    if shot["webp"]:
        parts.append(
            '<a href="%s"><img loading="lazy" src="%s" alt="%s"></a>'
            % (esc(shot["webp"]), esc(shot["webp"]), esc("screenshot %s" % shot["sid"]))
        )
    else:
        parts.append("<p>screenshot missing or unreadable</p>")
    ## Link the OCR sidecar (the recognized text of the frame) as evidence, when published.
    if shot.get("ocr"):
        parts.append('<p><a href="%s">OCR text</a></p>' % esc(shot["ocr"]))
    return "".join(parts)


def _step_status_class(step_status):
    ## Map a step functional status to a cell status class.
    if step_status == model.STATUS_PASSED:
        return site.STATUS_PASS
    if step_status == model.STATUS_FAILED:
        return site.STATUS_FAIL
    if step_status == model.STATUS_TIMEDOUT:
        return site.STATUS_FAIL
    if step_status in (model.STATUS_BROKEN, model.STATUS_SKIPPED):
        return site.STATUS_INCONCLUSIVE
    return site.STATUS_UNKNOWN


def resolve_source_date_epoch(arg_value):
    raw = arg_value if arg_value is not None else os.environ.get("SOURCE_DATE_EPOCH")
    if raw is None:
        import time

        return int(time.time())
    try:
        return int(raw)
    except ValueError:
        print("test-results-site-generate: bad SOURCE_DATE_EPOCH: %r" % raw, file=sys.stderr)
        raise SystemExit(2)


def main(argv):
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--results-root", required=True)
    parser.add_argument("--site-out", required=True)
    parser.add_argument("--mask-config", default=None)
    parser.add_argument("--chrome-from", default=None)
    parser.add_argument("--stale-days", type=int, default=30)
    parser.add_argument("--history", type=int, default=20)
    parser.add_argument("--source-date-epoch", default=None)
    parser.add_argument("--cache-dir", default=None,
                        help="incremental-regenerate cache location "
                             "(default: a per-site dir under XDG_CACHE_HOME)")
    parser.add_argument("--full-rebuild", action="store_true",
                        help="ignore the incremental cache and re-encode every run "
                             "(the cache is still refreshed)")
    args = parser.parse_args(argv)

    out_root = os.path.join(args.site_out, RESULTS_SUBDIR)
    now_unix = resolve_source_date_epoch(args.source_date_epoch)
    stale_seconds = args.stale_days * 86400
    generated_utc = datetime.datetime.fromtimestamp(
        now_unix, tz=datetime.timezone.utc
    ).strftime("%Y-%m-%dT%H:%M:%SZ")

    try:
        mask_config = load_mask_config(args.mask_config)
        header = extract_header(args.chrome_from) if args.chrome_from else _DEFAULT_HEADER
        footer = _FOOTER
    except ValueError as exc:
        raise SystemExit("test-results-site-generate: %s" % exc)

    os.makedirs(out_root, exist_ok=True)

    ## Assign a GLOBALLY-UNIQUE run id to each run BEFORE processing, so two runs
    ## with the same (possibly crafted) run.id cannot write into the same page dir
    ## and silently overwrite / drop one another. The page dir must be settled
    ## before shots are written, hence the up-front pass.
    used_ids = set()
    assigned = []
    for run_dir, result in discover_runs(args.results_root):
        rid = desired_run_id(run_dir, result)
        if rid in used_ids:
            rid = run_dir_id(run_dir)
        base = rid
        suffix = 1
        while rid in used_ids:
            rid = "%s-%d" % (base, suffix)
            suffix += 1
        used_ids.add(rid)
        assigned.append((run_dir, result, rid))

    cache_dir = resolve_cache_dir(args.cache_dir, args.site_out)
    shared_fp = shared_input_fingerprint(args.mask_config)

    views = []
    for run_dir, result, rid in assigned:
        ## Incremental fast path: a run whose inputs are byte-identical to a prior generate reuses
        ## its already-encoded webps (status/age recomputed from the clock), skipping the dominant
        ## method=6 re-encode. A NODATA (non-dict) run is cheap -- never cached.
        view = None
        fingerprint = None
        if isinstance(result, dict):
            fingerprint = run_source_fingerprint(run_dir, result, shared_fp)
            if not args.full_rebuild:
                view = load_cached_view(cache_dir, rid, fingerprint, out_root, run_dir,
                                        result, now_unix, stale_seconds)
        if view is None:
            view = process_run(run_dir, result, rid, out_root, mask_config,
                               now_unix, stale_seconds)
            if fingerprint is not None:
                store_cached_view(cache_dir, rid, fingerprint, view, out_root)
        views.append(view)

    ## Overview order: newest-first, then worst-severity-first, deterministic. The
    ## freshest run goes to the top; among runs with the same stop time the ones
    ## needing attention (worse severity) come first, run_id as the final tiebreak
    ## for determinism.
    views.sort(key=lambda v: (-_view_stop_unix(v), _sort_severity(v.status), v.run_id))

    keep = select_keep(views, args.history)
    shown = [v for v in views if v.run_id in keep]

    for view in shown:
        html_text = render_run(view, header, footer, generated_utc)
        _write(os.path.join(out_root, view.run_id, "index.html"), html_text)

    _write(os.path.join(out_root, "index.html"),
           render_overview(shown, header, footer, generated_utc))

    prune(out_root, keep)
    return 0


def _write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        handle.write(text)
    os.replace(tmp, path)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
