#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Fast-iteration local apt repo for the VBox image-test fleet, delivered over a
## VirtualBox SHARED FOLDER (no network -- no NAT, no Whonix-Gateway relay, no Tor;
## a Whonix-Workstation on an internal-only net gets the .debs just the same).
##
## This tool only DELIVERS. derivative-maker owns repo creation -- do not run
## reprepro / dm-reprepro-wrapper by hand:
##
##   POPULATE (cache-fast, only changed packages rebuild -- no package list needed):
##     derivative-maker --skip-published-packages ...
##   dm builds into the local apt repo store aptrepo_local/<derivative> (codename
##   local) via its own genmkfile reprepro-remove + reprepro-add -- a same-version
##   rebuild replaces content, nothing stale.
##
## Then this tool:
##   prepare <kicksecure|whonix>   make the repo _apt-readable
##   attach <vm> [--transient]     attach the `shared` folder to a VM
##   status [vm]                   show repo + (optional) VM mapping
##
## Delivery reuses Kicksecure vm-config-dist: the share is named exactly `shared`;
## mnt-shared-vbox.service auto-mounts it to /mnt/shared on every boot. So this tool
## does NOT pass VBox --automount (that double-mounts to /media/sf_shared). In the
## guest, enable it with the shipped helper-scripts tool: 'sudo repo-add-local'.
##
## SECURITY: the guest trusts this repo [trusted=yes] (installs as root, no sig check)
## over a READ-ONLY vboxsf mount. Trust anchor = the host build user who owns the
## local apt repo store -- exactly the freshly-built .debs under test.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"
VBOXMANAGE="${VBOXMANAGE:-VBoxManage}"

## dm's LOCAL apt repo store is the share host path; the reprepro repos live in its
## aptrepo_local/<derivative> subdirs, codename `local`. dm serves it from a
## build-user-owned, FHS-served /srv dir (variables.d/05_load-config.bsh's
## local_apt_repository_base), slot-aware like the build dir. Follow the slot when set
## in the env; LOCAL_APT_REPOSITORY_BASE overrides outright (e.g. a CI build that kept
## the repo under binary_build_folder_dist). This reads an EXISTING build's repo, so it
## does NOT invent a slot (that could miss a flat build) -- it matches whatever lane the
## build used. The slot comes from the trusted env/command line (same as dm's own
## --build-slot), used as-is -- a broken value is a caller error with worse consequences
## elsewhere.
repo_parent="${LOCAL_APT_REPOSITORY_BASE:-/srv/derivative-maker${dist_build_slot:+/${dist_build_slot}}}"
codename="local"

share_name="shared"
guest_mount="/mnt/shared"

die() {
   printf '%s\n' "${me}: ERROR: ${2}" >&2
   exit "$1"
}

usage() {
   printf '%s\n' "usage: ${me} prepare <kicksecure|whonix>
       ${me} attach <vm> [--transient]
       ${me} status [vm]
       ${me} repo-path <kicksecure|whonix>

Populate the repo first with: derivative-maker --skip-published-packages ...
Share host path: ${repo_parent}   (shared read-only as '${share_name}' -> ${guest_mount})
Repo per derivative: ${repo_parent}/aptrepo_local/<derivative>  (codename ${codename})"
}

check_derivative() {
   if [ "$1" != "kicksecure" ] && [ "$1" != "whonix" ]; then
      die 1 "derivative must be 'kicksecure' or 'whonix', got: ${1:-<none>}"
   fi
}

repo_dir_for() { printf '%s' "${repo_parent}/aptrepo_local/${1}"; }

do_prepare() {
   local d="$1" rd
   check_derivative "${d}"
   rd="$(repo_dir_for "${d}")"
   [ -d "${rd}" ] || die 1 "repo not found: ${rd} (populate it with: derivative-maker --only-packages '<pkgs>')"
   ## dm's create-local-apt-repo perms fix: a user-owned repo under umask 027 is
   ## unreadable by the unprivileged _apt user. Matters for the /srv (real-fs) and
   ## host-parity case. Over the read-only vboxsf mount this chmod is a NO-OP: vboxsf
   ## derives guest perms from its mount options (uid/gid/umask), not the inode mode,
   ## so _apt still cannot read /mnt/shared. apt then retries the fetch unsandboxed as
   ## root ("Download is performed unsandboxed as root ...") and succeeds via
   ## [trusted=yes]. That warning is expected and benign on a disposable test VM --
   ## accepted; not worth a dedicated permissive remount or an APT::Sandbox::User knob.
   chmod --recursive o+r -- "${rd}"
   ## Run find from INSIDE the repo so it never needs to restore an inaccessible
   ## caller CWD (e.g. invoked from another user's home) -- that failure is non-zero
   ## and would abort under errexit.
   ( cd -- "${rd}" && find . -type d -exec chmod o+rx -- {} + )
   printf '%s\n' \
      "${me}: prepared ${rd} (codename ${codename}); guest: run 'sudo repo-add-local'"
}

## Print the VM's VMState (empty if unknown). Must never return non-zero: a
## failing showvminfo under errexit+pipefail would otherwise abort the caller's
## `state="$(vm_state ...)"` assignment before its `[ -n ... ] || die` can report.
vm_state() {
   "${VBOXMANAGE}" showvminfo "$1" --machinereadable 2>/dev/null \
      | sed --quiet 's/^VMState="\([^"]*\)"/\1/p' || true
}

do_attach() {
   local vm="$1" transient="$2" state add_args=() rm_args=()
   [ -n "${vm}" ] || { usage; exit 1; }
   [ -d "${repo_parent}" ] || die 1 "share host path not found: ${repo_parent}"

   state="$(vm_state "${vm}")"
   [ -n "${state}" ] || die 1 "no such VM: ${vm}"

   if [ "${transient}" = "true" ]; then
      [ "${state}" = "running" ] || die 1 "--transient needs a RUNNING vm (state=${state})"
      add_args=(--transient); rm_args=(--transient)
   else
      [ "${state}" = "poweroff" ] || die 1 "vm must be powered off to attach permanently (state=${state}); power it off, or use --transient"
   fi

   ## Idempotent: drop any prior `shared` mapping (e.g. an old host path) first.
   "${VBOXMANAGE}" sharedfolder remove "${vm}" --name "${share_name}" "${rm_args[@]}" >/dev/null 2>&1 || true
   "${VBOXMANAGE}" sharedfolder add "${vm}" --name "${share_name}" \
      --hostpath "${repo_parent}" --readonly "${add_args[@]}"

   printf '%s\n' \
      "${me}: attached ${share_name} -> ${repo_parent} on ${vm}$([ "${transient}" = "true" ] && printf '%s' " (transient)")"
   if [ "${transient}" = "true" ]; then
      printf '%s\n' "${me}: running vm -- in the guest: systemctl restart mnt-shared-vbox.service"
   else
      printf '%s\n' "${me}: mounts at ${guest_mount} on the next boot (mnt-shared-vbox.service)"
   fi
}

do_status() {
   local vm="${1:-}" d rd d_col
   printf '%s\n' "share host path: ${repo_parent}"
   for d in kicksecure whonix; do
      rd="$(repo_dir_for "${d}")"
      printf -v d_col '%-10s' "${d}"
      if [ -d "${rd}/dists/${codename}" ]; then
         printf '%s\n' "  ${d_col} : repo present (${rd})"
      else
         printf '%s\n' "  ${d_col} : no repo yet (${rd})"
      fi
   done
   if [ -n "${vm}" ]; then
      printf -- '%s\n' "--- ${vm} ---"
      "${VBOXMANAGE}" showvminfo "${vm}" --machinereadable 2>/dev/null \
         | grep --ignore-case --extended-regexp 'SharedFolder' || printf '%s\n' "no shared folders mapped"
   fi
}

[ "$#" -ge 1 ] || { usage; exit 1; }
cmd="$1"; shift
case "${cmd}" in
   prepare)
      do_prepare "${1:-}"
      ;;
   attach)
      vm="${1:-}"; shift || true
      transient="false"
      [ "${1:-}" = "--transient" ] && transient="true"
      do_attach "${vm}" "${transient}"
      ;;
   status)
      do_status "${1:-}"
      ;;
   repo-path)
      ## Single source of the per-derivative host repo dir, for a caller that records
      ## provenance (dm-release-test's localRepo block) without re-deriving repo_parent.
      check_derivative "${1:-}"
      printf '%s\n' "$(repo_dir_for "${1}")"
      ;;
   -h|--help|help)
      usage
      ;;
   *)
      die 1 "unknown subcommand: ${cmd}"
      ;;
esac
