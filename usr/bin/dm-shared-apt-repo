#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Fast-iteration local apt repo for the VBox image-test fleet, delivered over a
## VirtualBox SHARED FOLDER (no network -- no NAT, no Whonix-Gateway relay, no Tor;
## a Whonix-Workstation on an internal-only net gets the .debs just the same).
##
## This tool only DELIVERS. derivative-maker owns repo creation -- do not run
## reprepro / dm-reprepro-wrapper by hand:
##
##   POPULATE (cache-fast, only changed packages rebuild -- no package list needed):
##     derivative-maker --skip-published-packages ...
##   dm builds into the local apt repo store aptrepo_local/<derivative> (codename
##   local) via its own genmkfile reprepro-remove + reprepro-add -- a same-version
##   rebuild replaces content, nothing stale.
##
## Then this tool:
##   prepare <kicksecure|whonix>   make the repo _apt-readable
##   attach <vm> [--transient]     attach the `shared` folder to a VM
##   status [vm]                   show repo + (optional) VM mapping
##
## Delivery reuses Kicksecure vm-config-dist: the share is named exactly `shared`;
## mnt-shared-vbox.service auto-mounts it to /mnt/shared on every boot. So this tool
## does NOT pass VBox --automount (that double-mounts to /media/sf_shared). In the
## guest, 'prepare' also drops the dev-only enabler at the share root; enable with
## 'sudo bash /mnt/shared/repo-add-local' (bash-invoked so /mnt noexec cannot refuse it).
##
## SECURITY: the guest trusts this repo [trusted=yes] (installs as root, no sig check)
## over a READ-ONLY vboxsf mount. Trust anchor = the host build user who owns the
## local apt repo store -- exactly the freshly-built .debs under test.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"
VBOXMANAGE="${VBOXMANAGE:-VBoxManage}"

## The guest-side enabler repo-add-local is a dist-ai sibling (same usr/bin), not shipped
## in the image; 'prepare' delivers it into the share root so the guest can run it. Resolve
## it next to this script (works installed at /usr/bin and from a checkout).
dm_shared_apt_repo_bindir="$( cd -- "$( dirname -- "$( readlink -f -- "${BASH_SOURCE[0]}" )" )" && pwd )"
repo_add_local_src="${REPO_ADD_LOCAL_SRC:-${dm_shared_apt_repo_bindir}/repo-add-local}"

## dm's LOCAL apt repo store is the share host path; the reprepro repos live in its
## aptrepo_local/<derivative> subdirs, codename `local`. dm serves it from a
## build-user-owned, FHS-served /srv dir (variables.d/05_load-config.bsh's
## local_apt_repository_base), slot-aware like the build dir.
##
## resolve_repo_parent reads an EXISTING build's repo, so it MUST match whatever lane that
## build used and must NOT invent a slot a flat build never created. It returns ONE share
## base that holds BOTH derivatives plus aptcache -- the SAME base repo-path, attach, expose
## and cache-path all use, so a single run never reports one tree and shares another.
## Resolution:
##   - LOCAL_APT_REPOSITORY_BASE set -> use it verbatim (a caller that already pinned the
##     base, e.g. a CI build that kept the repo under binary_build_folder_dist; the
##     orchestrator threads the resolved base down this way to attach/expose/cache-path).
##     Must be ABSOLUTE and whitespace-free: a relative value, or a stray newline command
##     substitution would strip, would otherwise root a (sudo) mount at '/aptcache' or an
##     unintended tree (derivative-maker forbids whitespace in this base too, 05_load-config).
##   - else, under repo_root (/srv/derivative-maker; DM_SHARED_APT_REPO_ROOT overrides for
##     tests): prefer the slotted base <root>/<slot> ONLY when it holds a BUILT repo (an
##     aptrepo_local subtree), else fall back to flat <root>. Keying on <slot>/aptrepo_local,
##     NOT the bare <slot> dir, matters: `expose` mkdir's <slot>/aptcache as a side effect,
##     so the bare slot dir can exist with no repo. A requested derivative ABSENT from the
##     chosen base is caught loud by do_prepare's 'repo not found', never silently mis-shared.
## An ambient dist_build_slot left from a different lane (e.g. a session slug) with no
## populated slot dir degrades to flat (the flat-build + slotted-run 404 this fixes). The
## slot is trusted (same as dm's own --build-slot) but restricted to one safe path segment
## so it cannot traverse or escape repo_root into an attacker-writable path.
repo_root="${DM_SHARED_APT_REPO_ROOT:-/srv/derivative-maker}"

die() {
   printf '%s\n' "${me}: ERROR: ${2}" >&2
   exit "$1"
}

## A forwarded slot must be ONE safe path segment under repo_root: a strict allowlist rejects
## '', '.', '..' and any character outside [A-Za-z0-9._-] -- so '/', whitespace (incl. a
## newline command substitution would strip) and other traversal/escape bytes are refused.
slot_is_single_segment() {
   case "${1}" in
      ''|.|..)
         return 1
         ;;
      *[!A-Za-z0-9._-]*)
         return 1
         ;;
      *)
         return 0
         ;;
   esac
}

resolve_repo_parent() {
   if [ -n "${LOCAL_APT_REPOSITORY_BASE:-}" ]; then
      case "${LOCAL_APT_REPOSITORY_BASE}" in
         *[[:space:]]*)
            die 1 "LOCAL_APT_REPOSITORY_BASE must not contain whitespace, got: '${LOCAL_APT_REPOSITORY_BASE}'"
            ;;
         /*)
            printf '%s' "${LOCAL_APT_REPOSITORY_BASE}"
            return 0
            ;;
         *)
            die 1 "LOCAL_APT_REPOSITORY_BASE must be an absolute path, got: '${LOCAL_APT_REPOSITORY_BASE}'"
            ;;
      esac
   fi
   if [ -n "${dist_build_slot:-}" ] && slot_is_single_segment "${dist_build_slot}" \
      && [ -d "${repo_root}/${dist_build_slot}/aptrepo_local" ]; then
      printf '%s' "${repo_root}/${dist_build_slot}"
      return 0
   fi
   printf '%s' "${repo_root}"
}
repo_parent="$(resolve_repo_parent)"
codename="local"

share_name="shared"
guest_mount="/mnt/shared"

## Local COMPLETE Debian mirror exposed file-based to the guest: bind-mounted READ-ONLY under the
## shared tree so the single 'shared' vboxsf carries it to ${guest_mount}/aptcache. A guest full
## upgrade then pulls the DEBIAN BASE from local file: content (no Tor) -- fast + offline, testing
## the built packages against a current base. The mirror (private-ai-config's debian-mirror-sync,
## server-only) holds debian/ + debian-security/, each a genuine signed archive. Overridable +
## absent-safe: a host without the mirror skips this and the guest base stays on its normally-
## configured sources (generic for any image type / non-mirror host).
mirror_dir="${DEBIAN_MIRROR_DIR:-/srv/debian-mirror}"
cache_mount="${repo_parent}/aptcache"

usage() {
   printf '%s\n' "usage: ${me} prepare <kicksecure|whonix>
       ${me} attach <vm> [--transient]
       ${me} expose
       ${me} status [vm]
       ${me} repo-path <kicksecure|whonix>
       ${me} cache-path
       ${me} guest-cache-path

Populate the repo first with: derivative-maker --skip-published-packages ...
Share host path: ${repo_parent}   (shared read-only as '${share_name}' -> ${guest_mount})
Repo per derivative: ${repo_parent}/aptrepo_local/<derivative>  (codename ${codename})"
}

check_derivative() {
   if [ "$1" != "kicksecure" ] && [ "$1" != "whonix" ]; then
      die 1 "derivative must be 'kicksecure' or 'whonix', got: ${1:-<none>}"
   fi
}

## Per-derivative: resolve the base for THIS derivative (so a slot holding only the other
## derivative does not shadow a flat build of this one), then its aptrepo_local/<deriv> dir.
repo_dir_for() { printf '%s' "${repo_parent}/aptrepo_local/${1}"; }

## Expose the local Debian mirror under the shared tree (read-only bind-mount) so the guest reaches
## it at ${guest_mount}/aptcache via the existing 'shared' vboxsf. Idempotent (mountpoint-guarded)
## and GENERIC: a host without the mirror skips silently, so the guest base simply stays on its
## configured sources. Needs root for the bind-mount (sudo; dm's build user has it). A plain
## 'mount --bind' is read-write, so a second remount pass makes it read-only (the guest must not
## mutate the host mirror).
expose_cache() {
   if [ ! -d "${mirror_dir}" ]; then
      printf '%s\n' "${me}: no Debian mirror at ${mirror_dir}; Debian base stays on its configured sources (ok)"
      return 0
   fi
   ## mirror_dir is a FIXED path (/srv/debian-mirror) and cache_mount is PER-SLOT, so a given
   ## cache_mount is only ever bound to this one source -- there is no override-change / wrong-source
   ## case to guard here (a findmnt source-check is both unnecessary and hard to get right: --first-only
   ## reports the shadowed lower mount, a suffix compare over-matches, and an EBUSY umount is easy to
   ## mis-handle). Bind if not yet mounted, then ALWAYS (re)assert ro + nosymfollow below.
   if ! mountpoint --quiet -- "${cache_mount}" 2>/dev/null; then
      mkdir --parents -- "${cache_mount}"
      sudo mount --bind -- "${mirror_dir}" "${cache_mount}"
   fi
   ## ALWAYS (re)assert ro + nosymfollow, even when already a mountpoint: a plain '--bind' is
   ## read-write, and an earlier run interrupted between the bind and this remount could have left
   ## it rw -- the mountpoint check alone would then pass over an rw mount. 'nosymfollow' stops the
   ## guest's vboxsf from following a symlink inside the mirror tree out to an arbitrary host file
   ## (the guest sources name the suites directly, so a blocked suite-alias symlink is harmless).
   ## Idempotent.
   sudo mount -o remount,ro,nosymfollow,bind -- "${cache_mount}"
   printf '%s\n' "${me}: exposed Debian mirror ${mirror_dir} -> ${cache_mount} ro,nosymfollow (guest: ${guest_mount}/aptcache)"
}

do_prepare() {
   local d="$1" rd
   check_derivative "${d}"
   rd="$(repo_dir_for "${d}")"
   [ -d "${rd}" ] || die 1 "repo not found: ${rd} (populate it with: derivative-maker --only-packages '<pkgs>')"
   ## dm's create-local-apt-repo perms fix: a user-owned repo under umask 027 is
   ## unreadable by the unprivileged _apt user. Matters for the /srv (real-fs) and
   ## host-parity case. Over the read-only vboxsf mount this chmod is a NO-OP: vboxsf
   ## derives guest perms from its mount options (uid/gid/umask), not the inode mode,
   ## so _apt still cannot read /mnt/shared. apt then retries the fetch unsandboxed as
   ## root ("Download is performed unsandboxed as root ...") and succeeds via
   ## [trusted=yes]. That warning is expected and benign on a disposable test VM --
   ## accepted; not worth a dedicated permissive remount or an APT::Sandbox::User knob.
   chmod --recursive o+r -- "${rd}"
   ## Run find from INSIDE the repo so it never needs to restore an inaccessible
   ## caller CWD (e.g. invoked from another user's home) -- that failure is non-zero
   ## and would abort under errexit.
   ( cd -- "${rd}" && find . -type d -exec chmod o+rx -- {} + )
   ## Also expose the local Debian mirror (Debian base) under the shared tree, so the guest's full
   ## upgrade can pull the base locally too, not just the derivative repo. Absent-safe (skips).
   expose_cache
   ## Deliver the guest-side enabler over the SAME share: repo-add-local is dev-only (not shipped
   ## in the image), so drop it at the share root -> guest /mnt/shared/repo-add-local. World-readable
   ## so the guest user can read it; it is RUN via the interpreter (sudo bash ...), which bypasses
   ## /mnt's security-misc noexec (an interpreter reads the file as data, it is not execve'd).
   [ -r "${repo_add_local_src}" ] \
      || die 1 "repo-add-local not found at ${repo_add_local_src} (dist-ai sibling of ${me}); set REPO_ADD_LOCAL_SRC"
   install -m 0644 -- "${repo_add_local_src}" "${repo_parent}/repo-add-local"
   printf '%s\n' \
      "${me}: prepared ${rd} (codename ${codename}); guest: run 'sudo bash /mnt/shared/repo-add-local ${d}'"
}

## Print the VM's VMState (empty if unknown). Must never return non-zero: a
## failing showvminfo under errexit+pipefail would otherwise abort the caller's
## `state="$(vm_state ...)"` assignment before its `[ -n ... ] || die` can report.
vm_state() {
   "${VBOXMANAGE}" showvminfo "$1" --machinereadable 2>/dev/null \
      | sed --quiet 's/^VMState="\([^"]*\)"/\1/p' || true
}

do_attach() {
   local vm="$1" transient="$2" state add_args=() rm_args=()
   [ -n "${vm}" ] || { usage; exit 1; }
   [ -d "${repo_parent}" ] || die 1 "share host path not found: ${repo_parent}"

   state="$(vm_state "${vm}")"
   [ -n "${state}" ] || die 1 "no such VM: ${vm}"

   if [ "${transient}" = "true" ]; then
      [ "${state}" = "running" ] || die 1 "--transient needs a RUNNING vm (state=${state})"
      add_args=(--transient); rm_args=(--transient)
   else
      [ "${state}" = "poweroff" ] || die 1 "vm must be powered off to attach permanently (state=${state}); power it off, or use --transient"
   fi

   ## Idempotent: drop any prior `shared` mapping (e.g. an old host path) first.
   "${VBOXMANAGE}" sharedfolder remove "${vm}" --name "${share_name}" "${rm_args[@]}" >/dev/null 2>&1 || true
   "${VBOXMANAGE}" sharedfolder add "${vm}" --name "${share_name}" \
      --hostpath "${repo_parent}" --readonly "${add_args[@]}"

   printf '%s\n' \
      "${me}: attached ${share_name} -> ${repo_parent} on ${vm}$([ "${transient}" = "true" ] && printf '%s' " (transient)")"
   if [ "${transient}" = "true" ]; then
      printf '%s\n' "${me}: running vm -- in the guest: systemctl restart mnt-shared-vbox.service"
   else
      printf '%s\n' "${me}: mounts at ${guest_mount} on the next boot (mnt-shared-vbox.service)"
   fi
}

do_status() {
   local vm="${1:-}" d rd d_col
   printf '%s\n' "share host path: ${repo_parent}"
   for d in kicksecure whonix; do
      rd="$(repo_dir_for "${d}")"
      printf -v d_col '%-10s' "${d}"
      if [ -d "${rd}/dists/${codename}" ]; then
         printf '%s\n' "  ${d_col} : repo present (${rd})"
      else
         printf '%s\n' "  ${d_col} : no repo yet (${rd})"
      fi
   done
   if [ -n "${vm}" ]; then
      printf -- '%s\n' "--- ${vm} ---"
      "${VBOXMANAGE}" showvminfo "${vm}" --machinereadable 2>/dev/null \
         | grep --ignore-case --extended-regexp 'SharedFolder' || printf '%s\n' "no shared folders mapped"
   fi
}

[ "$#" -ge 1 ] || { usage; exit 1; }
cmd="$1"; shift
case "${cmd}" in
   prepare)
      do_prepare "${1:-}"
      ;;
   attach)
      vm="${1:-}"; shift || true
      transient="false"
      [ "${1:-}" = "--transient" ] && transient="true"
      do_attach "${vm}" "${transient}"
      ;;
   expose)
      ## Bind-mount the local Debian mirror under the shared tree (root context). Standalone so the
      ## root orchestrator can expose the base BEFORE the account-run lane attaches + boots.
      expose_cache
      ;;
   status)
      do_status "${1:-}"
      ;;
   repo-path)
      ## Single source of the per-derivative host repo dir, for a caller that records
      ## provenance (dm-release-test's localRepo block) without re-deriving repo_parent.
      check_derivative "${1:-}"
      printf '%s\n' "$(repo_dir_for "${1}")"
      ;;
   cache-path)
      ## Single source of the exposed apt-cache mount path ON THE HOST (the bind-mount a caller
      ## READS residency from); for provenance + host-side source generation.
      printf '%s\n' "${cache_mount}"
      ;;
   guest-cache-path)
      ## The path the GUEST sees the same tree at (file: URI root for the emitted base sources).
      printf '%s\n' "${guest_mount}/aptcache"
      ;;
   -h|--help|help)
      usage
      ;;
   *)
      die 1 "unknown subcommand: ${cmd}"
      ;;
esac
