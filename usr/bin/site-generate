#!/usr/bin/python3 -Bsu

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

"""Regenerate a static site's DERIVED artifacts so they cannot drift by hand.

Derived from the real content-page set (check_site.html_files) and the site's
canonical host:

  - sitemap.xml -- one <loc> per navigable page (render sources are excluded).
  - robots.txt  -- allow-all plus the Sitemap: line for this host.
  - favicon.png -- a FAVICON_SIZE render of favicon.svg (when present), losslessly
    minimized via image-optimize so the raster fallback + apple-touch-icon match
    the SVG.

The website-tests drift gate (check_site.check_seo) re-derives the text artifacts
and byte-compares them, so a stale sitemap/robots cannot be published; favicon.png
is gated structurally (raster bytes are not reproducible across librsvg versions).
Run this whenever a page is added/removed or favicon.svg changes.

Usage: site-generate [--check] [--force] <site-root>
  --check  report drift, write nothing (exit 1 if anything is stale/missing).
  --force  write even if the git work tree is dirty (default: refuse, so the
           regeneration lands as its own clean commit).

Exit: 0 ok, 1 on error/drift, 2 on usage error.
"""

import os
import shutil
import subprocess
import sys

_SELF_DIR = os.path.dirname(os.path.abspath(__file__))


def _load_check_site():
    """Import check_site from the co-located tree or /usr/share; None if absent."""
    for candidate in (os.path.join(_SELF_DIR, '..', 'share', 'website-tests'),
                      '/usr/share/website-tests'):
        tests_dir = os.path.normpath(candidate)
        if os.path.isfile(os.path.join(tests_dir, 'check_site.py')):
            sys.path.insert(0, tests_dir)
            import check_site
            return check_site
    return None


def _require(tool):
    path = shutil.which(tool)
    if not path:
        sys.stderr.write('site-generate: required tool not found: %s\n' % tool)
        sys.exit(1)
    return path


def _refuse_dirty(root, force):
    ## Regeneration rewrites tracked files; a concurrent session's uncommitted
    ## work (or your own) would be swept into this change. Keep it its own clean
    ## commit unless --force says otherwise.
    if force:
        return
    top = subprocess.run(['git', '-C', root, 'rev-parse', '--show-toplevel'],
                         capture_output=True, text=True)
    if top.returncode != 0:
        sys.stderr.write('site-generate: refusing to run -- %s is not a git '
                         'work tree. Pass --force to override.\n' % root)
        sys.exit(1)
    dirty = subprocess.run(['git', '-C', root, 'status', '--porcelain'],
                           capture_output=True, text=True)
    if dirty.returncode != 0:
        ## Cannot verify the tree is clean -> fail CLOSED (a corrupt index or a
        ## permission error must not read as "clean" and let a write proceed).
        sys.stderr.write('site-generate: refusing to run -- cannot determine '
                         'work-tree status (git status exited %d). Pass --force '
                         'to override.\n' % dirty.returncode)
        sys.exit(1)
    if dirty.stdout.strip():
        sys.stderr.write('site-generate: refusing to run -- the git work tree '
                         'at %s has uncommitted changes; commit them first, or '
                         'pass --force.\n' % top.stdout.strip())
        sys.exit(1)


def _write_if_changed(path, text):
    try:
        with open(path, encoding='utf-8') as handle:
            if handle.read() == text:
                return False
    except OSError:
        ## Missing or unreadable target -> treat as changed and (re)write it.
        pass
    ## Write to a temp then os.replace: atomic, and replace swaps the directory
    ## entry itself (so it never writes THROUGH a symlink at `path`).
    tmp = path + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as handle:
        handle.write(text)
    os.replace(tmp, path)
    return True


def _render_favicon(root, check_site):
    ## Raster the SVG at the declared favicon size, then hand it to image-optimize
    ## for the same lossless minimization every other site raster gets. Render via
    ## a temp path and replace only on a real byte change, so an unchanged SVG
    ## leaves the committed favicon (and its mtime) untouched.
    svg = os.path.join(root, 'favicon.svg')
    if not os.path.isfile(svg):
        return False
    png = os.path.join(root, 'favicon.png')
    ## Keep a .png extension: image-optimize dispatches on it and would skip an
    ## unrecognized suffix, leaving the render unminimized.
    tmp = os.path.join(root, '.favicon.generate.png')
    size = str(check_site.FAVICON_SIZE)
    rsvg = _require('rsvg-convert')
    optimize = os.environ.get('IMAGE_OPTIMIZE_BIN') or _require('image-optimize')
    try:
        subprocess.run([rsvg, '-w', size, '-h', size, '-o', tmp, '--', svg],
                       check=True)
        subprocess.run([optimize, '--', tmp], check=True)
        with open(tmp, 'rb') as handle:
            rendered = handle.read()
        try:
            with open(png, 'rb') as handle:
                if handle.read() == rendered:
                    return False
        except OSError:
            ## No existing favicon (or unreadable) -> the render is a change.
            pass
        os.replace(tmp, png)
        return True
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)


def _generate(root, force, check_site):
    host = check_site.seo_host(root)
    if not host:
        sys.stderr.write('site-generate: %s/index.html has no <link '
                         'rel="canonical">; cannot derive the host.\n' % root)
        return 1
    ## Refuse to write THROUGH a symlink: a tracked or planted link could
    ## redirect a write outside the checkout. Mirrors site-image-optimize's
    ## symlink stance. Covers the outputs and the temp names they write via.
    for name in ('sitemap.xml', 'sitemap.xml.tmp', 'robots.txt',
                 'robots.txt.tmp', 'favicon.png', '.favicon.generate.png'):
        if os.path.islink(os.path.join(root, name)):
            sys.stderr.write('site-generate: refusing -- %s is a symlink; a '
                             'derived artifact must be a real file.\n' % name)
            return 1
    ## Resolve the favicon tools BEFORE any write: a missing tool must fail
    ## before sitemap/robots land, or a partial write dirties the tree and
    ## blocks a retry without --force.
    if os.path.isfile(os.path.join(root, 'favicon.svg')):
        _require('rsvg-convert')
        if not os.environ.get('IMAGE_OPTIMIZE_BIN'):
            _require('image-optimize')
    _refuse_dirty(root, force)
    changed = []
    if _write_if_changed(os.path.join(root, 'sitemap.xml'),
                         check_site.render_sitemap(root, host)):
        changed.append('sitemap.xml')
    if _write_if_changed(os.path.join(root, 'robots.txt'),
                         check_site.render_robots(host)):
        changed.append('robots.txt')
    if _render_favicon(root, check_site):
        changed.append('favicon.png')
    if changed:
        sys.stdout.write('site-generate: wrote %s\n' % ', '.join(changed))
    else:
        sys.stdout.write('site-generate: already current\n')
    return 0


def main(argv):
    check = force = False
    root = None
    for arg in argv:
        if arg == '--check':
            check = True
        elif arg == '--force':
            force = True
        elif arg.startswith('-'):
            sys.stderr.write('site-generate: unknown option %s\n' % arg)
            return 2
        elif root is None:
            root = arg
        else:
            sys.stderr.write('site-generate: too many arguments\n')
            return 2
    if root is None:
        sys.stderr.write('Usage: site-generate [--check] [--force] '
                         '<site-root>\n')
        return 2
    root = os.path.normpath(root)
    if not os.path.isdir(root):
        sys.stderr.write('site-generate: not a directory: %s\n' % root)
        return 2
    if not os.path.isfile(os.path.join(root, 'index.html')):
        sys.stderr.write('site-generate: %s has no index.html; not a site '
                         'root.\n' % root)
        return 2
    check_site = _load_check_site()
    if check_site is None:
        sys.stderr.write('site-generate: check_site.py not found (looked in '
                         "'%s/../share/website-tests' and "
                         '/usr/share/website-tests)\n' % _SELF_DIR)
        return 1
    if check:
        problems = check_site.check_seo(root)
        for problem in problems:
            sys.stderr.write('site-generate: %s\n' % problem)
        if not problems:
            sys.stdout.write('site-generate: derived artifacts are current\n')
        return 1 if problems else 0
    return _generate(root, force, check_site)


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
