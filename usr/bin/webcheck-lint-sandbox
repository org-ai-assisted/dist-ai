#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## style-ok: no-has -- standalone host/sandbox driver; does not source helper-scripts.

## Run the CONFINED html-tidy + stylelint lane over each family site checkout, inside
## the review sandbox qube under bwrap (no network; the tools -- tidy, stylelint -- live
## there). Sibling of website-tests-sandbox (which owns the Playwright browser lanes);
## this one owns the static CLI linters, which need no browser, so a plain sandbox-confine
## profile (not --profile playwright).
##
##   webcheck-lint-sandbox <site-root> [<site-root> ...]
##
## Exit: 0 all clean, 1 a tidy error or stylelint finding in any site.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

readonly SANDBOX_WORKDIR="/home/user/webcheck-lint-sandbox-run.$$"

die(){
   printf '%s\n' "webcheck-lint-sandbox: $1" >&2
   exit 1
}

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"
if [ -d "${script_dir}/../share/website-tests" ]; then
   tests_dir="${script_dir}/../share/website-tests"
else
   tests_dir='/usr/share/website-tests'
fi

if [ "$#" -eq 0 ]; then
   die 'usage: webcheck-lint-sandbox <site-root> [<site-root> ...]'
fi

helper="${tests_dir}/webcheck-lint-built-tree.sh"
sl_config="${tests_dir}/lint-assets/stylelint.config.json"
[ -f "${helper}" ]    || die "missing confined helper: ${helper}"
[ -f "${sl_config}" ] || die "missing stylelint config: ${sl_config}"

## Local-first: when tidy + stylelint + node resolve on this host, run the lint
## helper DIRECTLY per site root -- no sandbox. Lets the lane run in CI / in
## sandbox-direct, not only delegate. WEBCHECK_NO_LOCAL=1 forces the sandbox path.
if [ "${WEBCHECK_NO_LOCAL:-}" != '1' ] && command -v tidy >/dev/null 2>&1 \
   && command -v stylelint >/dev/null 2>&1 && command -v node >/dev/null 2>&1; then
   lint_rc=0
   for root in "$@"; do
      [ -f "${root}/index.html" ] || die "not a site root (no index.html): ${root}"
      bash "${helper}" "${root}" "${sl_config}" || lint_rc=1
   done
   exit "${lint_rc}"
fi

## No local linters. Reach the review sandbox -- unless we are inside it already
## (cannot nest) or there is none: then the lane is env-unmet, so exit 77 (the
## launcher treats 77 as SKIP). Never a masked failure: a lane that RAN exits
## 0/non-77 above.
if [ "${DIST_AI_IN_SANDBOX:-}" = '1' ] || [ "${WEBSITE_TESTS_NO_SANDBOX:-}" = '1' ] \
   || ! command -v sandbox >/dev/null 2>&1; then
   printf '%s\n' 'webcheck-lint-sandbox: tidy/stylelint absent locally and no usable sandbox -- SKIP (77)' >&2
   ## style-ok: allow-skip: env-unmet -- tidy/stylelint absent locally and no usable sandbox; launcher maps 77 to SKIP, never a masked pass
   exit 77
fi

## `sandbox` requires a target; the local review sandbox is the forget-proof default.
: "${QUBE_CTL_TARGET:=temp-claude}"
export QUBE_CTL_TARGET

sandbox exec --pid-scope private -- type sandbox-confine >/dev/null 2>&1 \
   || die 'sandbox is missing sandbox-confine (bwrap confinement)'

## Stage the confined helper + the stylelint config + each site root (no .git) into one
## tree, sync it in, run the lane per root confined. Basenames must be unique across roots.
## Stage on ample persistent disk, not the small /tmp tmpfs -- a large tree overflows it mid-rsync
## (ENOSPC reads as a lane failure). Mirrors webcheck-vnu-sandbox. Override WEBCHECK_LINT_TMP.
: "${WEBCHECK_LINT_TMP:=${XDG_CACHE_HOME:-${HOME}/.cache}/webcheck-lint-sandbox-tmp}"
mkdir --parents -- "${WEBCHECK_LINT_TMP}"
staging="$(mktemp --directory -- "${WEBCHECK_LINT_TMP}/webcheck-lint-sandbox.XXXXXX")"
synced=0
cleanup(){
   # shellcheck disable=SC2317  # invoked indirectly via the EXIT trap
   safe-rm --recursive --force -- "${staging}" || true
   # shellcheck disable=SC2317
   if [ "${synced}" = '1' ]; then
      sandbox exec --pid-scope private -- safe-rm --recursive --force -- "${SANDBOX_WORKDIR}" >/dev/null 2>&1 || true
   fi
   # shellcheck disable=SC2317
   return 0
}
trap cleanup EXIT

mkdir --parents -- "${staging}/lint" "${staging}/roots"
cp --archive -- "${helper}" "${staging}/lint/webcheck-lint-built-tree.sh"
cp --archive -- "${sl_config}" "${staging}/lint/stylelint.config.json"

declare -a remote_roots=()
declare -A seen_base=()
for root in "$@"; do
   [ -f "${root}/index.html" ] || die "not a site root (no index.html): ${root}"
   root="$(readlink --canonicalize -- "${root}")"
   base="$(basename -- "${root}")"
   if [ -n "${seen_base[${base}]:-}" ]; then
      die "duplicate site-root basename '${base}' -- roots must have distinct names"
   fi
   seen_base[${base}]=1
   rsync --archive --exclude='.git' -- "${root}/" "${staging}/roots/${base}/"
   remote_roots+=( "roots/${base}" )
done

sandbox sync --delete "${staging}" "$(basename -- "${SANDBOX_WORKDIR}")" >&2 \
   || die 'failed to sync the staging tree into the sandbox'
synced=1

overall=0
for remote_root in "${remote_roots[@]}"; do
   sandbox exec --pid-scope private -- sandbox-confine --workdir "${SANDBOX_WORKDIR}" -- \
      bash lint/webcheck-lint-built-tree.sh "${remote_root}" lint/stylelint.config.json \
      || overall=1
done

exit "${overall}"
