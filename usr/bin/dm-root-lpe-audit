#!/usr/bin/python3 -Bsu

## Shell-invocation guard.
"exec" "bash" "-c" "printf '%s\n' '$0: ERROR: Do not execute this script with bash!' >&2; exit 1"

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

"""Audit the root-privileged script surface of derivative-maker for Local
Privilege Escalation (root operating on user-controlled paths, and the related
LPE classes).

This is the exploitability LAYER on top of dm-root-scripts-enum: the enum says
WHAT runs as root; this says WHERE that root privilege meets a user-controlled
path and could be turned into an escalation. It reuses the enum (subprocess, its
stable JSON) and the shfmt AST (dist_ai.bash_ast, via dist_ai.lpe_sinks) -- no
regex-guessing of shell structure.

Reachability (which tree files run as root), from three sources:
  1. enum targets -- every program the enum attributes to a root category:
     a maintainer script or path-surface script directly; a systemd Exec*, a
     privleap Command=, a sudoers/polkit/udev/pam/modprobe/calamares program,
     or a privileged-call command, resolved from its INSTALLED path back to the
     tree file that ships it (the unit and its ExecStart target routinely live
     in different submodules; genmkfile '#pkg' suffixes are stripped).
  2. root-guarded scripts -- a script that self-asserts it must run as root
     (a root_check/require_root helper, or a 'must be run as root' guard). The
     enum is reference-driven and cannot see a script invoked only by an
     out-of-tree hook, so this catches the self-gated root helpers (e.g.
     virusforget). HONEST SCOPE: a high-precision textual signal, NOT a parse
     of the '[ "$(id -u)" != 0 ]' conditional (that bash-conditional parser is
     the trap this deliberately avoids) -- so an unnamed inline gate is missed.
  3. one hop of source/'.'/direct-exec from any reachable script into a sibling
     script in the same tree.

Exploitability is a REVIEW verdict a human makes per candidate; this tool emits
candidates with the evidence (rule, tainted operand, why, root_reason) and
NEVER claims a candidate is exploitable. Coverage counts are always printed so a
zero-finding run is visibly a real scan, not a silent 'clean'.

Usage:  dm-root-lpe-audit [<derivative-maker-root>]
Output: JSON on stdout; a ranked human summary on stderr.
"""

import ast
import bisect
import io
import json
import os
import re
import subprocess
import sys
import tokenize
import warnings
from typing import Any

_LIB = os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
    "lib", "python3", "dist-packages")
if os.path.isdir(_LIB) and _LIB not in sys.path:
    sys.path.insert(0, _LIB)

from dist_ai import bash_ast, lpe_sinks  # noqa: E402
from dist_ai.dm_tree import (  # noqa: E402
    component_for,
    install_name,
    is_shell,
    name_has_ext,
    read_text,
    submodule_paths,
    walk_tree,
)


ENUM_TOOL = "dm-root-scripts-enum"

## Filesystem-root dirs a package mirrors; the install path starts at the first.
FHS_TOPS = ("usr", "etc", "bin", "sbin", "lib", "lib64", "opt", "var", "run", "srv")

## Enum categories whose 'path' IS the root-run script (no target to resolve).
DIRECT_SCRIPT_CATEGORIES = frozenset((
    "maintainer-script", "build-chroot", "grub-script", "grub-default-config",
    "qubes-rpc", "qubes-hook", "update-motd", "policy-rc-d",
    "initramfs-kernel-hook",
))

## A script self-asserting it must run as root -- a root entry point the
## reference-driven enum cannot see. Simple textual signals only (no parse of
## the conditional): a require-root helper name, or a 'must be run as root'
## message. The not-root direction ('must NOT be run as root', not_as_root) is
## explicitly excluded so a refusal guard is not mistaken for a root gate.
ROOT_REQUIRE_FUNCS = ("root_check", "require_root", "check_root", "ensure_root",
                      "assert_root", "must_be_root")
## '\broot\b' so 'needs rootless mode' does not read as 'needs root'.
ROOT_REQUIRE_TEXT_RE = re.compile(
    r"must (?:be run|run) as \broot\b|needs? (?:to be )?\broot\b"
    r"|run this as \broot\b",
    re.IGNORECASE)
## The refusal direction only; kept NARROW (an over-broad phrase like 'as user'
## would wrongly cancel a real root gate). At most ONE word between 'run' and
## 'as root' ('this', '${SCRIPTNAME}'), so 'do not run the browser as root' or
## 'do not run as a user, must be run as root' does not read as a refusal. It
## masks root-require text inside a refusal phrase, and cancels a root-require
## FUNCTION call only when it matches that function's OWN in-script body (see
## is_root_guarded).
NOT_ROOT_RE = re.compile(r"must not be run as root|do not run (?:\S+ )?as root\b"
                         r"|\bnot_as_root\b",
                         re.IGNORECASE)

## Blast-radius weight of the root category -- shifts a rule's base severity.
CATEGORY_WEIGHT = {
    "maintainer-script": 1, "systemd-unit": 1, "systemd-activation": 1,
    "privleap-action": 1, "sudoers": 1, "polkit": 1, "udev-rule": 1,
    "pam-exec": 1, "modprobe-hook": 1, "grub-script": 1,
    "grub-default-config": 1, "qubes-rpc": 1, "qubes-hook": 1,
    "update-motd": 1, "policy-rc-d": 1, "initramfs-kernel-hook": 1,
    "systemd-dropin": 0, "privileged-call": 0, "calamares-job": 0,
    "root-guarded-script": 0, "sourced": 0,
    "build-chroot": -1,
}

SEVERITY_ORDER = ("INFO", "LOW", "MEDIUM", "HIGH")
RULE_BASE = {
    "symlink-follow": "HIGH",
    "untrusted-source-eval": "HIGH",
    "home-recursive-write": "MEDIUM",
    "trust-sudo-user": "MEDIUM",
    "tmp-race": "MEDIUM",
    "world-writable-perms": "MEDIUM",
    "path-hijack": "MEDIUM",
    "root-write-user-path": "LOW",
    "python-advisory": "INFO",
}

## ADVISORY (regex, mirrors the enum's nonshell-escalation): a root Python
## script doing a privileged filesystem op near a user-controlled location.
PYTHON_SINK_RE = re.compile(
    r"\b(?:os\.(?:chown|chmod|lchown)|shutil\.(?:chown|copytree|rmtree|copy2?|move)"
    r"|os\.remove|os\.unlink)\b")
PYTHON_TAINT_RE = re.compile(r"/home/|/tmp/|/var/tmp/|/dev/shm/|SUDO_USER|home_dir|"
                             r"home_folder|user_name|target_user")


def install_path_for(rel_path, submodule):
    """The absolute install path a source file maps to under the FHS mirror, or
    None for a source that does not install into the root filesystem. A package
    mirrors '/' at its OWN root, so the FHS top must be the FIRST component after
    the submodule -- a 'tests/usr/bin/foo' or 'debian/...' is NOT installed.
    '#pkg' rename suffixes are stripped."""
    remainder = rel_path[len(submodule) + 1:] if submodule else rel_path
    parts = remainder.split("/")
    if not parts or parts[0] not in FHS_TOPS:
        return None
    parts[-1] = install_name(parts[-1])
    return "/" + "/".join(parts)


def build_index(tree_files, submodules):
    """Map every source file's install path (and basename) to the tree file(s)
    that ship it, so a root category's installed program target resolves back
    across submodule boundaries. A path maps to a LIST: two packages CAN ship
    the same install path (e.g. '#pkgA'/'#pkgB' variants), and dropping the
    later one would skip a real root target."""
    by_path: dict[str, list[str]] = {}
    by_base: dict[str, set[str]] = {}
    for abs_path, rel_path in tree_files:
        _component, sub = component_for(rel_path, submodules)
        install = install_path_for(rel_path, sub)
        if install is not None:
            by_path.setdefault(install, []).append(abs_path)
            by_base.setdefault(os.path.basename(install), set()).add(abs_path)
    return by_path, by_base


def resolve_targets(program, by_path, by_base):
    """The tree file(s) a root category's program target refers to (a list, maybe
    empty). Try the exact install path, then a UNIQUE basename match; an external
    tool (apt, systemctl) or an ambiguous basename stays unresolved (not our
    code). The FIRST whitespace token is the program; a surrounding quote on that
    token is stripped AFTER the split, so '"/usr/bin/foo" arg' resolves."""
    if not program:
        return []
    tokens = program.strip().split()
    if not tokens:
        return []
    token = tokens[0].strip('"').strip("'")
    if not token:
        return []
    if token.startswith("/") and token in by_path:
        return list(by_path[token])
    matches = by_base.get(install_name(os.path.basename(token)))
    if matches and len(matches) == 1:
        return list(matches)
    return []


def entry_targets(entry):
    """Yield the installed program strings a root-category entry points at. A
    DIRECT category yields None (its own 'path' is the script)."""
    category = entry["category"]
    if category in DIRECT_SCRIPT_CATEGORIES:
        yield None
    elif category in ("systemd-unit", "systemd-activation", "systemd-dropin"):
        for program in entry.get("exec") or ():
            yield program
        for program in entry.get("root_forced_exec") or ():
            yield program
    elif category == "privleap-action":
        for action in entry.get("actions") or ():
            yield action.get("command")
    elif category == "sudoers":
        for command in entry.get("commands") or ():
            yield command
    elif category == "polkit":
        for action in entry.get("actions") or ():
            if action.get("exec_path"):
                yield action["exec_path"]
    elif category in ("udev-rule", "pam-exec", "modprobe-hook", "calamares-job"):
        for program in entry.get("programs") or ():
            yield program
    elif category == "privileged-call":
        if entry.get("command"):
            yield entry["command"]
    ## nonshell-escalation is handled as a direct Python file separately.


def _requires_root_text(text):
    ## Root-require text left once the refusal phrases are removed ('Do not run
    ## this as root' contains 'run this as root'). Text carrying both directions
    ## stays a root gate.
    return bool(ROOT_REQUIRE_TEXT_RE.search(NOT_ROOT_RE.sub(" ", text)))


def _is_refusal_body(body):
    return bool(NOT_ROOT_RE.search(body)) and not _requires_root_text(body)


def _local_refusal_func(tree, raw, name):
    """True if every in-script definition of NAME is a refusal guard. The
    helper names are conventions, not contracts: tb-starter's root_check
    REFUSES root. No local definition -> False."""
    bodies = [raw[decl["Pos"]["Offset"]:decl["End"]["Offset"]]
              .decode("utf-8", errors="replace")
              for decl in bash_ast.func_decls(tree)
              if (decl.get("Name") or {}).get("Value") == name]
    return bool(bodies) and all(_is_refusal_body(body) for body in bodies)


def is_root_guarded(source):
    ## A root-require FUNCTION call is authoritative -- a script that calls
    ## root_check IS a root entry point even if it elsewhere mentions a refusal
    ## phrase -- unless the script defines that function itself as a refusal.
    ## The weaker TEXT signal counts only root-require text that is not part of
    ## a refusal phrase.
    try:
        tree = bash_ast.parse_normalized(source)
    except bash_ast.BashParseError:
        tree = None
    raw = source.encode("utf-8")
    for name in ROOT_REQUIRE_FUNCS:
        if not re.search(r"\b" + re.escape(name) + r"\b", source):
            continue
        if tree is not None and _local_refusal_func(tree, raw, name):
            continue
        return True
    return _requires_root_text(source)


def sourced_targets(tree, source, by_path, by_base):
    """One hop: the tree files a reachable script sources/'.'s or directly execs
    by an ABSOLUTE path. A '/'-path is never a shell function, so no
    function-shadow check applies; a leading '--' after source is skipped."""
    for call in bash_ast.call_exprs(tree):
        cmd = bash_ast.command_basename(call)
        if cmd is None:
            continue
        args = bash_ast.args(call)
        name_full = bash_ast.command_name(call)
        if cmd in (".", "source"):
            rest = args[1:]
            if rest and bash_ast.word_string(rest[0]) == "--":
                rest = rest[1:]
            candidates = rest[:1]
        elif name_full and name_full.startswith("/"):
            candidates = args[:1]
        else:
            continue
        for word in candidates:
            program = bash_ast.word_string(word)
            if not program or not program.startswith("/"):
                continue
            for resolved in resolve_targets(program, by_path, by_base):
                yield resolved


def severity_of(rule, factors, weight):
    base = RULE_BASE.get(rule, "LOW")
    if rule == "home-recursive-write":
        if factors.get("symlink") or factors.get("deletion") or (
                factors.get("find_walk") and factors.get("action")):
            base = "HIGH"
    elif rule == "symlink-follow" and not factors.get("symlink_explicit", True):
        ## An IMPLICIT default-follow (chown/chmod of a named symlink, no
        ## explicit -L) is a real but lower-confidence vector than a deliberate
        ## --dereference; rank it MEDIUM so explicit -L stands out as HIGH.
        base = "MEDIUM"
    index = SEVERITY_ORDER.index(base) + weight
    index = max(0, min(len(SEVERITY_ORDER) - 1, index))
    return SEVERITY_ORDER[index]


def python_advisory(abs_path, rel_path):
    findings = []
    ## Split on '\n' ONLY, like ast/tokenize: str.splitlines() also breaks on
    ## form feed / vertical tab / etc., shifting finding lines off the
    ## statement spans and comment lines the waivers are matched against.
    for lineno, raw in enumerate(read_text(abs_path).split("\n"), start=1):
        if raw.lstrip().startswith("#"):
            continue
        match = PYTHON_SINK_RE.search(raw)
        if match and PYTHON_TAINT_RE.search(raw):
            findings.append({
                "rule": "python-advisory", "sink": "python", "line": lineno,
                ## Byte column of the sink, matching ast col_offset (also bytes),
                ## so a waiver's block-above scope can tell a one-liner suite body
                ## from the header that shares its line.
                "col": len(raw[:match.start()].encode("utf-8")),
                "tainted_operand": raw.strip()[:120],
                "factors": {"taint": "regex"},
                "why": "root Python script does a privileged fs op near a "
                       "user-controlled location (advisory, regex)",
            })
    return findings


def run_enum(dm_root, tool_dir):
    enum = os.path.join(tool_dir, ENUM_TOOL)
    if not os.path.isfile(enum):
        raise SystemExit("ERROR: sibling %s not found beside this tool" % ENUM_TOOL)
    ## A nonzero exit is NOT a degradation signal: the enum prints a COMPLETE report
    ## and then exits nonzero as a "wrong root?" advisory (zero examined files or zero
    ## entries), and the audit's own root-guarded scan (collect_reachable source 2)
    ## must still run on that report -- aborting on the exit code hides real LPE
    ## findings. Fail closed on UNUSABLE output instead: no output, non-JSON/undecodable
    ## bytes, or a non-object document (a crashed enum emits a traceback or partial
    ## bytes, never a complete report). Capture bytes so invalid UTF-8 is a clean error,
    ## not a traceback.
    result = subprocess.run([enum, dm_root], capture_output=True)
    stderr = result.stderr.decode("utf-8", "replace").strip()
    if not result.stdout.strip():
        raise SystemExit("ERROR: %s produced no output:\n%s" % (ENUM_TOOL, stderr))
    try:
        report = json.loads(result.stdout)
    except (json.JSONDecodeError, UnicodeDecodeError) as exc:
        raise SystemExit("ERROR: %s produced unparseable output: %s"
                         % (ENUM_TOOL, exc))
    if not isinstance(report, dict):
        raise SystemExit("ERROR: %s did not produce a JSON object" % ENUM_TOOL)
    ## Fail closed on a DEGRADED enumeration: parse_errors (a shell file shfmt could
    ## not parse, so its privileged calls were never extracted) or walk_errors (a
    ## directory that could not be traversed) mean the inventory is INCOMPLETE, so a
    ## missing finding is indistinguishable from a clean file. This is the real
    ## degradation signal (the exit code is not -- see above); keying on it does not
    ## touch the legitimate zero-entries advisory, whose errors lists are empty.
    degraded = []
    for key, label in (("parse_errors", "parse error(s)"),
                       ("walk_errors", "walk error(s)")):
        value = report.get(key)
        if not value:
            continue
        ## Tolerate a malformed field (not a list) -- a misbehaving enum must
        ## still fail CLEANLY here, never crash with a TypeError traceback.
        count = len(value) if isinstance(value, list) else 1
        degraded.append("%d %s" % (count, label))
    if degraded:
        raise SystemExit(
            "ERROR: %s reported a DEGRADED enumeration (%s) -- the inventory is "
            "incomplete, refusing to report a clean audit:\n%s"
            % (ENUM_TOOL, ", ".join(degraded), stderr))
    return report


def collect_reachable(dm_root, enum_report, tree_files, submodules,
                      by_path, by_base, coverage):
    """Map abs tree file -> list of root_reason strings (why it runs as root)."""
    reachable: dict[str, list[str]] = {}

    def add(abs_path, reason):
        reachable.setdefault(abs_path, [])
        if reason not in reachable[abs_path]:
            reachable[abs_path].append(reason)

    ## Source 1: enum targets.
    for entry in enum_report.get("entries", []):
        category = entry["category"]
        if category == "nonshell-escalation":
            add(os.path.join(dm_root, entry["path"]), "nonshell-escalation")
            continue
        for target in entry_targets(entry):
            if target is None:
                add(os.path.join(dm_root, entry["path"]), category)
                continue
            resolved = resolve_targets(target, by_path, by_base)
            if not resolved:
                coverage["unresolved_targets"] += 1
                continue
            for tree_file in resolved:
                add(tree_file, "%s:%s" % (category, os.path.basename(entry["path"])))

    ## Source 2: root-guarded scripts that SHIP into the filesystem. A self-gated
    ## script under ci/ or a test/build dir (no FHS install path) is not a root
    ## entry point on a user system, so it is not part of the root surface.
    for abs_path, rel_path in tree_files:
        if not is_shell(abs_path, rel_path):
            continue
        _component, sub = component_for(rel_path, submodules)
        if install_path_for(rel_path, sub) is None:
            continue
        if is_root_guarded(read_text(abs_path)):
            add(abs_path, "root-guarded-script")

    ## Source 3: one hop of source/exec from each reachable shell file.
    for abs_path in list(reachable):
        if not is_shell(abs_path, os.path.relpath(abs_path, dm_root)):
            continue
        try:
            tree = bash_ast.parse_normalized(read_text(abs_path))
        except bash_ast.BashParseError:
            continue
        source = read_text(abs_path)
        for resolved in sourced_targets(tree, source, by_path, by_base):
            add(resolved, "sourced")

    return reachable


def weight_for(reasons):
    """The strongest (highest) blast-radius weight among a file's root reasons."""
    weights = [CATEGORY_WEIGHT.get(r.split(":", 1)[0], 0) for r in reasons]
    return max(weights) if weights else 0


## Per-line by-design waiver for the LPE rules. Shape:
##   ## style-ok: lpe-<rule>[,lpe-<rule>...] -- <why>
## 'lpe-all' waives every rule for that statement. A non-empty reason after
## '--' is REQUIRED so a waiver is self-documenting; a reason-less waiver is
## ignored and the finding still fires. The marker must OPEN the comment
## (matched, not searched), so prose that merely quotes the syntax mid-comment
## is not a waiver. The waiver must be a REAL comment (located via the shfmt
## AST / Python tokenize, not a textual scan) -- a 'style-ok: lpe-...'
## inside a heredoc body or a quoted string is DATA, not a waiver. Waived
## findings stay VISIBLE (counted and listed under 'suppressed'), so a
## mis-waiver is auditable, never a silent drop.
LPE_WAIVER_RE = re.compile(
    r"#+\s*style-ok:\s*"
    r"(?P<rules>lpe-[a-z][a-z-]*(?:\s*,\s*lpe-[a-z][a-z-]*)*)"
    r"\s*--\s*(?P<why>\S.*)")


def _continues(line):
    """True if LINE ends in a line-continuation: an ODD run of trailing
    backslashes escapes the newline (an even run is literal backslashes). A CRLF
    '\\r' is stripped first. This is the exact parity test shfmt/bash use (see
    bash_ast.parse_normalized), applied to ONE physical line -- not a multi-line
    scan -- so the line below a continuation is known to belong to the statement
    above it, not to be a standalone comment."""
    body = line[:-1] if line.endswith("\r") else line
    trailing = len(body) - len(body.rstrip("\\"))
    return trailing % 2 == 1


def _py_comment_text_by_line(source):
    """Map line -> comment text ('#...') for every real Python comment in SOURCE,
    via tokenize -- a '#' inside a string (including a multi-line triple-quoted
    one) is a STRING token, never a COMMENT, so it cannot pose as a waiver. Fails
    SAFE: a tokenize error yields {} (nothing waived, so findings stay)."""
    comments: dict[int, str] = {}
    try:
        for tok in tokenize.generate_tokens(io.StringIO(source).readline):
            if tok.type == tokenize.COMMENT:
                comments[tok.start[0]] = tok.string
    except (tokenize.TokenError, IndentationError, SyntaxError, ValueError):
        return {}
    return comments


## Fields holding a compound statement's nested SUITES: their statements get
## their own spans, so the compound's span stops at its header.
_PY_SUITE_FIELDS = frozenset(("body", "orelse", "finalbody", "handlers", "cases"))
_PY_LOGICAL_LINE_BREAKS = frozenset((tokenize.NEWLINE, tokenize.INDENT,
                                     tokenize.DEDENT))


def _py_case_keyword_lines(source):
    """Sorted lines where a logical line OPENS with the name 'case' -- the
    soft-keyword line of a match clause. ast.match_case carries no position,
    and its pattern may start lines below the keyword ('case (' + newline)."""
    lines = []
    prev_type = tokenize.NEWLINE
    for tok in tokenize.generate_tokens(io.StringIO(source).readline):
        if tok.type in (tokenize.COMMENT, tokenize.NL):
            continue
        if (tok.type == tokenize.NAME and tok.string == "case"
                and prev_type in _PY_LOGICAL_LINE_BREAKS):
            lines.append(tok.start[0])
        prev_type = tok.type
    return lines


def _py_stmt_spans(source):
    """(start_line, start_col, end_line, end_col) POSITION spans of every Python
    statement in SOURCE, via ast -- the Python counterpart of the shfmt CallExpr
    spans, so a finding on a later physical line of a wrapped statement resolves
    to that statement's first line. Positions (not just lines) because a one-liner
    colon-suite puts the header and its body on the SAME line: a simple statement
    spans its own start..end, a compound one (if/for/def/with/except/case/...)
    spans only its HEADER (own position + non-suite children), never its suites,
    so a header span ENDS before a body sink that shares its line. That lets the
    caller attribute a body sink to the body, not the header, and so keep a waiver
    above an 'if' from reaching the body (as a shell waiver above 'if' cannot
    reach the commands inside it). Returns None on a parse error: an unparseable
    file has no trustworthy statement boundaries, so the caller waives nothing."""
    try:
        with warnings.catch_warnings():
            ## Invalid-escape SyntaxWarnings in an audited file are not ours to
            ## print on stderr.
            warnings.simplefilter("ignore")
            tree = ast.parse(source)
        case_lines = _py_case_keyword_lines(source)
    except (SyntaxError, ValueError, RecursionError, tokenize.TokenError):
        return None
    src_lines = source.split("\n")
    spans = []
    for node in ast.walk(tree):
        ## 'except' and 'case' clauses are not ast.stmt, but their headers are
        ## statement-like regions a finding can wrap inside.
        if not isinstance(node, (ast.stmt, ast.ExceptHandler, ast.match_case)):
            continue
        suite_fields = _PY_SUITE_FIELDS.intersection(node._fields)
        if not suite_fields:
            ## Only a plain statement reaches here: ExceptHandler and match_case
            ## always carry a 'body' suite.
            if isinstance(node, ast.stmt):
                spans.append((node.lineno, node.col_offset,
                              node.end_lineno or node.lineno,
                              node.end_col_offset or node.col_offset))
            continue
        ## Header start. A match_case has no position of its own: its line is the
        ## nearest 'case' keyword at or above its pattern, and that keyword begins
        ## at the line's indent.
        if isinstance(node, ast.match_case):
            index = bisect.bisect_right(case_lines, node.pattern.lineno)
            own_line = case_lines[index - 1] if index else None
            own_col = (_indent(src_lines[own_line - 1])
                       if own_line and 1 <= own_line <= len(src_lines) else None)
        else:
            own_line = node.lineno
            own_col = node.col_offset
        if own_line is None or own_col is None:
            continue
        ## Header = own position plus every non-suite child's bounding box;
        ## decorators sit ABOVE lineno, so the start widens to them too. The body
        ## suites are skipped, so the header END stops before a one-liner body.
        points = [(own_line, own_col)]
        for field, value in ast.iter_fields(node):
            if field in suite_fields:
                continue
            for child in value if isinstance(value, list) else [value]:
                if not isinstance(child, ast.AST):
                    continue
                ## A decorator's '@' is not an AST node, so the expression's
                ## col_offset is indent+1; the statement really begins at the
                ## '@' (the line's indent). Anchor the start there, else a
                ## decorated def/class reads as NOT leading its line and loses a
                ## waiver block above it.
                if (field == "decorator_list" and isinstance(child, ast.expr)
                        and 1 <= child.lineno <= len(src_lines)):
                    points.append((child.lineno,
                                   _indent(src_lines[child.lineno - 1])))
                for sub in ast.walk(child):
                    for line, col in ((getattr(sub, "lineno", None),
                                       getattr(sub, "col_offset", None)),
                                      (getattr(sub, "end_lineno", None),
                                       getattr(sub, "end_col_offset", None))):
                        if line is not None and col is not None:
                            points.append((line, col))
        start_line, start_col = min(points)
        end_line, end_col = max(points)
        spans.append((start_line, start_col, end_line, end_col))
    return spans


def _indent(line):
    """Width of LINE's leading whitespace."""
    return len(line) - len(line.lstrip(" \t"))


def lpe_waivers(comment_text_by_line, standalone_lines, call_spans, finding_line,
                source_lines, finding_col=None):
    """Map rule -> reason for waivers covering the command at finding_line.

    A waiver is honored (a) on the finding's own line or the owning command's
    first line -- as a trailing OR standalone comment, since it sits ON that
    statement -- or (b) anywhere in the CONTIGUOUS block of STANDALONE comment
    lines directly above the command, so a reason wrapped over several comment
    lines still waives. The block walk stops at the first line that is not a
    standalone comment (code, blank, a trailing comment, a heredoc/string line)
    or that is indented DEEPER than the command: a TRAILING comment belongs to
    the preceding statement, so honoring it would let 'x=1  # style-ok: ...'
    silently suppress the finding on the next line; a blank or code line ends
    the comment block that documents this statement; a deeper-indented comment
    closes an enclosing suite (a Python 'if' body) the command is not in. The
    nearest waiver for a rule wins, and its reason absorbs the plain comment
    lines wrapped below it in the block (up to the next waiver), so the
    'suppressed' entry carries the whole reason. The owning command + its span
    come from CALL_SPANS: shell (FINDING_COL is None) gives line pairs
    (start, end); Python gives position quads (start_line, start_col, end_line,
    end_col) so a header and its one-liner body on the same line are separable by
    column. The waiver is matched against the real COMMENT TEXT
    (COMMENT_TEXT_BY_LINE: line -> '#...'), never the raw source line, so a
    'style-ok: lpe-...' in a QUOTED STRING is data, not a waiver. Association is
    AST-truthful, never a textual '\\'-continuation scan. A rule of 'all' waives
    every rule for that command.
    """
    waivers: dict[str, str] = {}
    if finding_line < 1:
        return waivers
    ## Owning statement, EARLIEST start -- so 'cmd ... \\<nl> arg || rc=1' and a
    ## wrapped operand attribute to the outer statement, not to an assignment
    ## that also begins on the operand's line. OWNER_LEADS: does that statement
    ## BEGIN its physical line? A waiver block above a line documents the
    ## statement that LEADS the line; a statement nested or trailing inside it (a
    ## one-liner colon-suite body, a post-';' statement, an 'else:'/'finally:'
    ## one-liner body) must NOT inherit it. Shell spans are line-only and carry
    ## no compound headers, so the owner leads by construction; Python spans are
    ## position quads, so the owner leads iff it starts at its line's indent.
    if finding_col is None:
        containing = [start for start, end in call_spans
                      if start <= finding_line <= end]
        stmt_start = min(containing) if containing else finding_line
        owner_leads = True
    else:
        pos = (finding_line, finding_col)
        owners = [(sl, sc) for sl, sc, el, ec in call_spans
                  if (sl, sc) <= pos <= (el, ec)]
        stmt_start, owner_col = (min(owners) if owners
                                 else (finding_line, finding_col))
        owner_leads = (1 <= stmt_start <= len(source_lines)
                       and owner_col <= _indent(source_lines[stmt_start - 1]))
    stmt_indent = (_indent(source_lines[stmt_start - 1])
                   if 1 <= stmt_start <= len(source_lines) else 0)
    ## Standalone comment block above the statement, nearest first -- only when
    ## the owning statement leads its line (else the block is the LEADER's).
    block = []
    if owner_leads:
        above = stmt_start - 1
        while (above >= 1 and above in standalone_lines
               and _indent(source_lines[above - 1]) <= stmt_indent):
            block.append(above)
            above -= 1
    ## Wrapped-reason text: the block's plain comment lines BELOW each waiver.
    wrapped: dict[int, str] = {}
    tail: list[str] = []
    for ln in block:
        text = comment_text_by_line[ln]
        if LPE_WAIVER_RE.match(text):
            wrapped[ln] = " ".join(tail)
            tail = []
        else:
            prose = text.lstrip("#").strip()
            tail = [prose] + tail if prose else tail
    for cand in [finding_line, stmt_start] + block:
        text = comment_text_by_line.get(cand)
        if text is None:
            continue
        match = LPE_WAIVER_RE.match(text)
        if match is None:
            continue
        reason = match.group("why").strip()
        if not reason:
            continue
        if wrapped.get(cand):
            reason = reason + " " + wrapped[cand]
        for token in match.group("rules").split(","):
            token = token.strip()
            rule = "all" if token == "lpe-all" else token[len("lpe-"):]
            waivers.setdefault(rule, reason)
    return waivers


def audit(dm_root):
    tool_dir = os.path.dirname(os.path.realpath(__file__))
    enum_report = run_enum(dm_root, tool_dir)
    submodules = submodule_paths(dm_root)
    walk_errors: list[str] = []
    tree_files = list(walk_tree(dm_root, walk_errors))
    by_path, by_base = build_index(tree_files, submodules)

    coverage: dict[str, Any] = {
        "root_files": 0, "shell_scanned": 0, "python_advisory": 0,
        "sinks_examined": 0, "unresolved_targets": 0, "suppressed": 0,
        "parse_errors": [], "walk_errors": walk_errors,
    }
    reachable = collect_reachable(dm_root, enum_report, tree_files, submodules,
                                  by_path, by_base, coverage)
    coverage["root_files"] = len(reachable)

    findings = []
    suppressed = []
    for abs_path in sorted(reachable):
        rel_path = os.path.relpath(abs_path, dm_root)
        reasons = reachable[abs_path]
        weight = weight_for(reasons)
        component, submodule = component_for(rel_path, submodules)
        root_reason = ", ".join(reasons)
        if is_shell(abs_path, rel_path):
            coverage["shell_scanned"] += 1
            source = read_text(abs_path)
            try:
                tree = bash_ast.parse_normalized(source)
            except bash_ast.BashParseError as exc:
                coverage["parse_errors"].append({"path": rel_path,
                                                 "error": str(exc)})
                continue
            coverage["sinks_examined"] += sum(1 for _ in bash_ast.call_exprs(tree))
            raw_findings = lpe_sinks.iter_findings(tree, source)
            ## Waiver association is AST-truthful: the waiver is matched against
            ## the real comment TEXT (shfmt), and the statement via command line
            ## spans -- never the raw source line, never a continuation scan.
            comment_text_by_line = {
                c.get("Hash", {}).get("Line"): "#" + (c.get("Text") or "")
                for c in bash_ast.comments(tree)}
            call_spans = [((ce.get("Pos") or {}).get("Line"),
                           (ce.get("End") or {}).get("Line"))
                          for ce in bash_ast.call_exprs(tree)]
            call_spans = [(s, e) for s, e in call_spans
                          if s is not None and e is not None]
        elif name_has_ext(rel_path, ".py"):
            coverage["python_advisory"] += 1
            source = read_text(abs_path)
            raw_findings = python_advisory(abs_path, rel_path)
            ## Python comment lines via tokenize: a '#' inside a string (even a
            ## MULTI-LINE triple-quoted one) is a STRING token, not a COMMENT, so
            ## it cannot masquerade as a waiver -- the same robustness the shfmt
            ## path gets. Fail SAFE on a parse error (empty -> nothing waived ->
            ## findings stay). Statement spans come from ast, so a finding on a
            ## wrapped statement's later line finds the waiver above its first
            ## line; an ast parse error drops every waiver (fail SAFE).
            comment_text_by_line = _py_comment_text_by_line(source)
            py_spans = _py_stmt_spans(source)
            if py_spans is None:
                comment_text_by_line = {}
            call_spans = py_spans or []
        else:
            continue
        ## A comment line is STANDALONE when only whitespace precedes its '#'
        ## (language-agnostic) AND the physical line before it is not a '\\' line
        ## continuation (else this line belongs to the statement above it, not a
        ## standalone comment). A '\\' that ends a COMMENT is comment text, not a
        ## continuation (bash and Python both end a comment at the newline).
        ## Split on '\\n' ONLY -- str.splitlines() also breaks on vertical tab /
        ## form feed / etc., which shfmt does not count as newlines, desyncing
        ## these indices from the AST line numbers.
        source_lines = source.split("\n")
        standalone_lines = {
            ln for ln in comment_text_by_line
            if ln and 1 <= ln <= len(source_lines)
            and source_lines[ln - 1].lstrip().startswith("#")
            and (ln < 2 or (ln - 1) in comment_text_by_line
                 or not _continues(source_lines[ln - 2]))}
        for finding in raw_findings:
            entry = {
                "component": component,
                "submodule": submodule,
                "path": rel_path,
                "line": finding["line"],
                "rule": finding["rule"],
                "sink": finding["sink"],
                "tainted_operand": finding["tainted_operand"],
                "severity": severity_of(finding["rule"], finding["factors"],
                                        weight),
                "why": finding["why"],
                "root_reason": root_reason,
                "factors": finding["factors"],
            }
            ## A per-line '## style-ok: lpe-<rule> -- <why>' waiver routes a
            ## reviewed by-design finding to 'suppressed' (still visible) rather
            ## than dropping it -- so a rescan no longer re-flags a settled line.
            waived = lpe_waivers(comment_text_by_line, standalone_lines,
                                 call_spans, finding["line"], source_lines,
                                 finding_col=finding.get("col"))
            reason = waived.get(finding["rule"]) or waived.get("all")
            if reason is not None:
                entry["waiver_reason"] = reason
                suppressed.append(entry)
            else:
                findings.append(entry)

    ## Dedupe identical (path, line, rule, operand); keep the highest severity.
    findings = _dedupe(findings)
    suppressed = _dedupe(suppressed)
    coverage["suppressed"] = len(suppressed)

    return {
        "schema": "dm-root-lpe-audit/1",
        "dm_root": os.path.abspath(dm_root),
        "enum_schema": enum_report.get("schema"),
        "coverage": coverage,
        "severity_counts": _severity_counts(findings),
        "findings": findings,
        "suppressed": suppressed,
    }


def _dedupe(items):
    """Dedupe identical (path, line, rule, operand); keep the highest severity,
    then sort HIGH-first by component/path/line."""
    unique: dict[tuple, dict] = {}
    for item in items:
        key = (item["path"], item["line"], item["rule"],
               item["tainted_operand"])
        current = unique.get(key)
        if current is None or SEVERITY_ORDER.index(item["severity"]) > \
                SEVERITY_ORDER.index(current["severity"]):
            unique[key] = item
    ordered = list(unique.values())
    ordered.sort(key=lambda f: (
        -SEVERITY_ORDER.index(f["severity"]), f["component"], f["path"],
        f["line"] or 0))
    return ordered


def _severity_counts(findings):
    counts = {level: 0 for level in SEVERITY_ORDER}
    for finding in findings:
        counts[finding["severity"]] += 1
    return counts


def _print_report(report):
    cov = report["coverage"]
    print("dm-root-lpe-audit: %d root files, %d shell scanned, %d python "
          "advisory, %d sinks examined, %d unresolved targets, %d parse errors"
          % (cov["root_files"], cov["shell_scanned"], cov["python_advisory"],
             cov["sinks_examined"], cov["unresolved_targets"],
             len(cov["parse_errors"])), file=sys.stderr)
    counts = report["severity_counts"]
    print("findings: %d HIGH, %d MEDIUM, %d LOW, %d INFO"
          % (counts["HIGH"], counts["MEDIUM"], counts["LOW"], counts["INFO"]),
          file=sys.stderr)
    for finding in report["findings"]:
        if finding["severity"] in ("HIGH", "MEDIUM"):
            print("  [%-6s] %s:%s  %s  %s  (%s)" % (
                finding["severity"], finding["path"], finding["line"],
                finding["rule"], finding["tainted_operand"],
                finding["root_reason"]), file=sys.stderr)

    ## Suppressed findings stay VISIBLE (count + list): a by-design waiver is a
    ## reviewed exclusion, never a silent clean.
    suppressed = report.get("suppressed", [])
    print("suppressed: %d (waived by-design)" % len(suppressed), file=sys.stderr)
    for finding in suppressed:
        if finding["severity"] in ("HIGH", "MEDIUM"):
            print("  [WAIVED %-6s] %s:%s  %s  %s  -- %s" % (
                finding["severity"], finding["path"], finding["line"],
                finding["rule"], finding["tainted_operand"],
                finding.get("waiver_reason", "")), file=sys.stderr)


def main(argv):
    dm_root = argv[1] if len(argv) > 1 else os.path.join(
        os.path.expanduser("~"), "derivative-maker")
    if not os.path.isdir(dm_root):
        print("ERROR: not a directory: %s" % dm_root, file=sys.stderr)
        return 1
    if not bash_ast.shfmt_available():
        print("ERROR: shfmt not found -- required to parse shell.",
              file=sys.stderr)
        return 1
    report = audit(dm_root)
    print(json.dumps(report, indent=2, sort_keys=False))
    _print_report(report)
    if report["coverage"]["root_files"] == 0:
        print("ERROR: no root-reachable files found -- wrong root?",
              file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
