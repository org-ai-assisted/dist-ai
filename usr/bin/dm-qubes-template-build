#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Build a Qubes OS template (kicksecure / whonix-gateway / whonix-workstation) on a plain
## Debian host WITHOUT Qubes, in ONE command -- the proper entry point so the qubes-builderv2
## invocation is never hand-rolled.
##
## The official community templates build with qubes-builderv2's QUBES executor (disposable
## qubes). This drives the DOCKER executor instead: it runs the builder container privileged
## with /dev/loop-control bind-mounted -- exactly what the template prepare-image /
## qubeize-image loop-mount + debootstrap steps need -- so the same build runs on any Linux
## host. podman is NOT usable (it cannot build DEB packages, qubes-issues #10280), so DEB-based
## templates require docker.
##
## Pins org-ai-assisted/qubes-builderv2 @ ai (repo + branch are constants, not flags), which
## carries the trixie archive-keyring fix: upstream ships trixie-debian-archive-keyring.gpg as a
## symlink to the bookworm keyring, which no longer verifies Debian 13's Release, so debootstrap
## aborts on an unknown key (762F67A0B2C39DE4, the Debian Stable Release Key 13/trixie).
##
## Runs as the invoking NON-root user (needs passwordless sudo for apt and the docker group).
## Provisioning is idempotent: clone/update the pinned checkout, install dependencies-debian.txt
## (which installs docker.io), ensure the docker group, build the builder container image if
## absent -- then build the template. Multi-user by design: every path derives from the invoking
## user's HOME; nothing is hardcoded to a specific account.
##
## E2E-verified for kicksecure-18 (built on a plain Debian 13 host). whonix-gateway-18 /
## whonix-workstation-18 are config-complete (use-qubes-repo injected) but NOT yet E2E-verified
## here.
##
## core.symlinks: a hardened host (security-misc) may set core.symlinks=false, under which the
## upstream 'qb' entry point checks out as a dead text file. We invoke qubesbuilder-cli directly
## (the symlink's target), so the build never depends on that symlink. The wiki documentation
## calls qubesbuilder-cli for the same reason.
##
## Stages default to 'fetch prep build', producing the template .noarch.rpm but NOT signing or
## publishing it (those need the Qubes templates-community signing key).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C
export DEBIAN_FRONTEND=noninteractive

me="${0##*/}"

## Constants (the pin): changing these would defeat the whole point of this helper.
readonly repo_url="https://github.com/org-ai-assisted/qubes-builderv2.git"
readonly branch="ai"
## The only tag tools/generate-container-image.sh produces.
readonly image="qubes-builder-fedora:latest"

flavor="kicksecure-18"
stages="fetch prep build"
dir="${HOME}/qubes-builderv2"

## --local-repo: build against a LOCAL on-disk apt repo (locally-built packages not yet
## uploaded to a remote repo) instead of the remote testers repo. Repoints the fetch at our
## org-ai-assisted fork (carrying the local-repo.conf hook) and STAGES the repo into the fetched
## template content: the executor copies it into the build cage, and the in-template hook
## bind-mounts it into the chroot so apt installs from file:///mnt-local-repo (no container->host
## networking, which a Qubes build qube blocks). Empty => off.
local_repo=""
local_repo_dir="/srv/derivative-maker/aptrepo_local"
## derivative-maker's local reprepro store publishes under this fixed codename (not a Debian
## suite), matching dm's own add-local-test-repo / create-local-temp-apt-repo. The apt stanza's
## Suites: and the dists/<codename>/ existence check both use it.
readonly local_repo_codename="local"

usage() {
  printf '%s\n' "usage: ${me} [--flavor F] [--dir DIR] [--stages 'S..']

Build a Qubes template on this Debian host via qubes-builderv2's docker executor.
Pins org-ai-assisted/qubes-builderv2 @ ai.

  --flavor   kicksecure-18 | whonix-gateway-18 | whonix-workstation-18 (default: ${flavor})
  --dir      qubes-builderv2 checkout directory (default: \${HOME}/qubes-builderv2)
  --stages   template stages to run (default: '${stages}')
  --local-repo        build against a local apt repo instead of the remote testers repo,
                      to test against locally-built packages not yet uploaded
  --local-repo-dir D  local apt repo base, per-derivative subdirs (default: ${local_repo_dir})

Produces <dir>/artifacts/templates/rpm/qubes-template-<flavor>-*.noarch.rpm" >&2
  exit "${1:-2}"
}

## Map a template flavor to its qubes-builderv2 example-config. Pure (stdout + return code),
## so it is unit-testable without docker or network.
flavor_to_config() {
  local flavor_in="$1"
  case "${flavor_in}" in
  kicksecure-18)
    printf '%s\n' "example-configs/kicksecure.yml"
    ;;
  whonix-gateway-18 | whonix-workstation-18)
    printf '%s\n' "example-configs/qubes-os-r4.3.yml"
    ;;
  *)
    return 1
    ;;
  esac
}

## True if the flavor's example-config lacks use-qubes-repo and the generated builder.yml must
## supply it (qubes-os-r4.3.yml does not set it; kicksecure.yml does).
flavor_needs_qubes_repo() {
  case "$1" in
  whonix-gateway-18 | whonix-workstation-18)
    return 0
    ;;
  *)
    return 1
    ;;
  esac
}

## Map a template flavor to its qubes-builderv2 component name. --local-repo repoints this
## component at our fork and injects local-repo.conf into its fetched content.
flavor_to_component() {
  case "$1" in
  kicksecure-18)
    printf '%s\n' "template-kicksecure"
    ;;
  whonix-gateway-18 | whonix-workstation-18)
    printf '%s\n' "template-whonix"
    ;;
  *)
    return 1
    ;;
  esac
}

## Map a template flavor to our org-ai-assisted fork URL (the branch is always 'ai'). The fork
## carries the local-repo.conf hook that upstream lacks, so --local-repo must fetch from here.
flavor_to_fork_url() {
  case "$1" in
  kicksecure-18)
    printf '%s\n' "https://github.com/org-ai-assisted/qubes-template-kicksecure"
    ;;
  whonix-gateway-18 | whonix-workstation-18)
    printf '%s\n' "https://github.com/org-ai-assisted/qubes-template-whonix"
    ;;
  *)
    return 1
    ;;
  esac
}

## The PRIMARY derivative a flavor's own packages come from. --local-repo MUST override this one
## (and fail loud if it is absent locally) -- otherwise the very packages under test would be
## pulled from the remote testers repo.
flavor_to_derivative() {
  case "$1" in
  kicksecure-18)
    printf '%s\n' "kicksecure"
    ;;
  whonix-gateway-18 | whonix-workstation-18)
    printf '%s\n' "whonix"
    ;;
  *)
    return 1
    ;;
  esac
}


## True if STAGE (or its one-letter qubes-builderv2 alias) is among the space-separated ${stages}.
stages_build_requested() {
  case " ${stages} " in
  *" build "* | *" b "*)
    return 0
    ;;
  *)
    return 1
    ;;
  esac
}

## True if USER is in the docker group.
in_docker_group() {
  case " $(id -nG -- "$1") " in
  *" docker "*)
    return 0
    ;;
  *)
    return 1
    ;;
  esac
}

## Ensure docker is usable by the invoking user. Runs AFTER install_deps (which installs
## docker.io and creates the docker group). A freshly-joined group is not active in this
## session, so we add the user and ask them to re-run rather than re-exec through a shell whose
## quoting we cannot control.
ensure_docker() {
  if docker ps >/dev/null 2>&1; then
    return 0
  fi
  local user
  user="$(id -un)"
  if in_docker_group "${user}"; then
    printf '%s\n' "${me}: docker is not usable in this session though ${user} is in the docker group" >&2
    printf '%s\n' "${me}: open a new login session (or run 'newgrp docker'), or start the docker service, then re-run" >&2
    exit 1
  fi
  printf '%s\n' "${me}: adding ${user} to the docker group (sudo)" >&2
  sudo usermod --append --groups docker -- "${user}"
  printf '%s\n' "${me}: ${user} added to the docker group; open a new login session (or 'newgrp docker') and re-run" >&2
  exit 1
}

clone_or_update() {
  if [ -d "${dir}/.git" ]; then
    local origin
    origin="$(git -C "${dir}" remote get-url origin 2>/dev/null || true)"
    if [ "${origin}" != "${repo_url}" ]; then
      ## Do not echo the existing origin -- it may embed credentials.
      printf '%s\n' "${me}: ${dir} is a git checkout whose origin is not the pinned fork -- remove it or pass --dir" >&2
      exit 1
    fi
    ## reset --hard below pins to the fork tip and would silently discard tracked edits; refuse
    ## if any exist. Untracked files (the generated builder.yml is gitignored) are unaffected.
    if ! git -C "${dir}" diff --quiet || ! git -C "${dir}" diff --cached --quiet; then
      printf '%s\n' "${me}: ${dir} has uncommitted changes to tracked files -- refusing to reset --hard; commit/stash them or pass a fresh --dir" >&2
      exit 1
    fi
    git -C "${dir}" fetch --quiet origin "${branch}"
    git -C "${dir}" checkout --quiet "${branch}"
    git -C "${dir}" reset --quiet --hard "origin/${branch}"
  else
    git clone --branch "${branch}" -- "${repo_url}" "${dir}"
  fi
  ## No submodule init: the fetch/prep/build stages need only in-tree plugins. The sole
  ## submodule (publish/mirrors, publish-only) uses a relative URL that resolves against the
  ## fork's org, where the sibling repo was never forked -- and we never publish.
}

install_deps() {
  ## style-ok: allow-apt-get -- runs on a generic Debian build host where the
  ## apt-get-noninteractive wrapper is not present; DEBIAN_FRONTEND is exported above.
  sudo apt-get update
  ## dependencies-debian.txt is one package per line; word-splitting is intended. '--' stops a
  ## stray leading-dash line from being read as an apt option.
  # shellcheck disable=SC2046
  ## style-ok: allow-apt-get -- see above.
  sudo apt-get install --yes -- $(cat -- "${dir}/dependencies-debian.txt")
}

ensure_image() {
  if ! docker image inspect "${image}" >/dev/null 2>&1; then
    printf '%s\n' "${me}: building the builder container image ${image}" >&2
    (cd -- "${dir}" && tools/generate-container-image.sh docker)
  fi
}

provision() {
  clone_or_update
  install_deps
  ensure_docker
  ensure_image
}

## --local-repo helpers -------------------------------------------------------

## The derivatives this flavor pulls that we override with the local repo: the flavor's own, plus
## kicksecure for a whonix flavor when kicksecure is also published locally (a whonix template
## installs kicksecure packages too). The caller guarantees the flavor's own derivative is present.
local_repo_derivatives() {
  local primary
  primary="$(flavor_to_derivative "${flavor}")"
  printf '%s\n' "${primary}"
  if [ "${primary}" = "whonix" ] && [ -d "${local_repo_dir}/kicksecure/dists/${local_repo_codename}" ]; then
    printf '%s\n' "kicksecure"
  fi
}

## Emit local-repo.conf for the flavor under build. The flavor's OWN derivative MUST be published
## locally under the reprepro codename, else --local-repo would silently leave the packages under
## test to the remote testers repo -- fail loud instead. URIs are file:///mnt-local-repo/<deriv>:
## the in-template hook bind-mounts the staged repo there inside the build chroot. Suites/Components
## match dm's canonical local stanza (codename 'local', all three components); 'Trusted: yes' for
## the unsigned local packages.
build_local_repo_conf() {
  local primary d derivs
  primary="$(flavor_to_derivative "${flavor}")"
  if [ ! -d "${local_repo_dir}/${primary}/dists/${local_repo_codename}" ]; then
    printf '%s\n' "${me}: --local-repo: no ${primary} '${local_repo_codename}' packages under ${local_repo_dir}/${primary}/dists/${local_repo_codename} -- build ${primary} packages into the local repo first" >&2
    exit 1
  fi
  mapfile -t derivs < <(local_repo_derivatives)
  for d in "${derivs[@]}"; do
    printf '%s\n' \
      "${d}_repository_sources=\"Types: deb" \
      "URIs: file:///mnt-local-repo/${d}" \
      "Suites: ${local_repo_codename}" \
      "Components: main contrib non-free" \
      "Enabled: yes" \
      "Trusted: yes\"" \
      ""
  done
}

## Stage the local repo into the fetched template content and write local-repo.conf beside it. The
## executor's copy_in carries both into the build cage (at FLAVORS_DIR); the in-template hook binds
## the repo into the chroot. The fork is fetched fresh (force-fetch), so the content dir is clean.
inject_local_repo_conf() {
  local component content_dir repo_dst d derivs
  component="$(flavor_to_component "${flavor}")"
  content_dir="${dir}/artifacts/sources/${component}"
  if [ ! -d "${content_dir}" ]; then
    printf '%s\n' "${me}: fetched template content not found at ${content_dir} (did fetch run?)" >&2
    exit 1
  fi
  ## Validates the flavor's derivative is published + emits the file:// stanzas; fails loud here
  ## (direct redirection, not a subshell) before any bytes are copied.
  build_local_repo_conf >"${content_dir}/local-repo.conf"
  repo_dst="${content_dir}/aptrepo"
  mkdir -p -- "${repo_dst}"
  mapfile -t derivs < <(local_repo_derivatives)
  for d in "${derivs[@]}"; do
    ## Dereference symlinks (-L): a derivative repo, or an entry inside it, may be an absolute
    ## symlink to a host path that is absent inside the build cage. Copy real content so the staged
    ## file:// tree is self-contained once copied into the cage.
    cp --recursive --dereference -- "${local_repo_dir}/${d}" "${repo_dst}/${d}"
  done
  printf '%s\n' "${me}: staged local repo (${derivs[*]}) + local-repo.conf into ${content_dir}" >&2
}

## Strip the fetch stage from ${stages}: --local-repo runs fetch on its own, then injects.
stages_without_fetch() {
  local s out=""
  # shellcheck disable=SC2086
  for s in ${stages}; do
    case "${s}" in
    fetch | f)
      ;;
    *)
      out="${out:+${out} }${s}"
      ;;
    esac
  done
  printf '%s\n' "${out}"
}

write_builder_conf() {
  local config="$1"
  {
    printf '%s\n' "include:"
    printf '%s\n' "  - ${config}"
    printf '%s\n' ""
    if flavor_needs_qubes_repo "${flavor}"; then
      printf '%s\n' "use-qubes-repo:"
      printf '%s\n' "  version: '4.3'"
      printf '%s\n' ""
    fi
    printf '%s\n' "executor:"
    printf '%s\n' "  type: docker"
    printf '%s\n' "  options:"
    printf '%s\n' "    image: \"${image}\""
    if [ -n "${local_repo}" ]; then
      ## Repoint the template component at our fork (carries the local-repo.conf hook) and skip
      ## its git-signature check: the fork's 'ai' commits are not signed by the upstream
      ## maintainer key, so verification is disabled for this component only (testing).
      ## NO force-fetch: it re-clones the component during prep/build and WIPES the injected repo.
      ## build() pre-removes the component dir so the first fetch still clones the fork fresh.
      printf '%s\n' ""
      printf '%s\n' "+components:"
      printf '%s\n' "  - $(flavor_to_component "${flavor}"):"
      printf '%s\n' "      url: $(flavor_to_fork_url "${flavor}")"
      printf '%s\n' "      branch: ai"
      printf '%s\n' ""
      printf '%s\n' "insecure-skip-checking:"
      printf '%s\n' "  - $(flavor_to_component "${flavor}")"
    fi
  } >"${dir}/builder.yml"
}

build() {
  local rest
  rest="$(stages_without_fetch)"
  if [ -n "${local_repo}" ]; then
    ## Remove any prior component checkout so 'package fetch' clones the FORK fresh (the +components
    ## override sets the url). Replaces force-fetch, which would re-clone during prep/build and wipe
    ## the injected repo; without it a stale upstream checkout would otherwise be reused as-is.
    ## style-ok: no-safe-rm -- one-shot clean of a build-artifact dir, not an interactive rm.
    rm --recursive --force -- "${dir}/artifacts/sources/$(flavor_to_component "${flavor}")"
  fi
  ## Fetch the template COMPONENT source into artifacts/sources/template-<flavor>. A 'template
  ## fetch' is a no-op here: the template content lives in the template-<flavor> component
  ## (packages: False), obtained by the package/fetch plugin. For --local-repo, the +components
  ## override in builder.yml points it at the fork carrying the local-repo.conf hook.
  ## Call qubesbuilder-cli directly ('qb' is just a symlink to it, dead on a core.symlinks=false host).
  (cd -- "${dir}" && ./qubesbuilder-cli package fetch)
  if [ -n "${local_repo}" ]; then
    ## Stage the local repo + local-repo.conf into the fetched content before prep/build. The
    ## executor copies the staged repo into the cage; the in-template hook installs from it via file://.
    inject_local_repo_conf
  fi
  if [ -n "${rest}" ]; then
    ## Unquoted ${rest} intentionally splits into separate stage words.
    # shellcheck disable=SC2086
    (cd -- "${dir}" && ./qubesbuilder-cli -t "${flavor}" template ${rest})
  fi
}

report() {
  ## Only a run that included the build stage (or its 'b' alias) produces a template rpm.
  if ! stages_build_requested; then
    printf '%s\n' "${me}: stages '${stages}' complete (no build stage -> no template rpm)"
    return 0
  fi
  local rpm
  ## Newest by mtime; '|| true' so a missing artifacts dir hits the diagnostic below, not errexit.
  rpm="$(find "${dir}/artifacts/templates/rpm" -name "qubes-template-${flavor}-*.noarch.rpm" -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2- || true)"
  if [ -n "${rpm}" ]; then
    printf '%s\n' "${me}: built ${rpm}"
    printf '%s\n' "DM-QUBES-TEMPLATE-BUILD-DONE rpm=${rpm}"
  else
    printf '%s\n' "${me}: no template rpm under ${dir}/artifacts/templates/rpm -- inspect the log" >&2
    exit 1
  fi
}

main() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
    --flavor)
      flavor="$2"
      shift 2
      ;;
    --dir)
      dir="$2"
      shift 2
      ;;
    --stages)
      stages="$2"
      shift 2
      ;;
    --local-repo)
      local_repo=1
      shift
      ;;
    --local-repo-dir)
      local_repo_dir="$2"
      shift 2
      ;;
    --help | -h)
      usage 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      printf '%s\n' "${me}: unknown option: $1" >&2
      usage 2
      ;;
    *)
      printf '%s\n' "${me}: unexpected argument: $1" >&2
      usage 2
      ;;
    esac
  done

  if [ "$#" -gt 0 ]; then
    printf '%s\n' "${me}: unexpected argument: $1" >&2
    usage 2
  fi

  if [ "$(id -u)" = "0" ]; then
    printf '%s\n' "${me}: run as a non-root user with docker-group access, not root" >&2
    exit 1
  fi

  local config
  if ! config="$(flavor_to_config "${flavor}")"; then
    printf '%s\n' "${me}: unknown --flavor: ${flavor}" >&2
    usage 2
  fi

  ## Absolutize so build()/report() agree on the path regardless of the current directory.
  dir="$(readlink -m -- "${dir}")"

  if [ -n "${local_repo}" ] && [ ! -d "${local_repo_dir}" ]; then
    printf '%s\n' "${me}: --local-repo-dir does not exist: ${local_repo_dir}" >&2
    printf '%s\n' "${me}: populate it first with a local derivative-maker package build" >&2
    exit 1
  fi

  provision
  write_builder_conf "${config}"
  build
  report
}

## Sourced (dm-qubes-template-build-tests) -> expose the functions without running; executed -> run.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  main "$@"
fi
