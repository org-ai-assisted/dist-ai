#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## style-ok: no-has -- standalone host/sandbox driver; does not source helper-scripts.

## Run the WCAG 2.5.8 target-size (tap-target) geometric gate for each site root inside the review
## sandbox qube, serving each checkout from a localhost mount and measuring every page in the
## sandbox's Playwright chromium at a phone AND a desktop viewport. A HARD gate (no baseline): it
## fails on any undersized, under-spaced, non-exempt standalone content link.
##
##   webcheck-taptarget-sandbox [--paths-file FILE] <site-root> [<site-root> ...]
##
## Sibling of webcheck-axe-sandbox (same a11y family, same serve-in-sandbox model) but simpler:
## no axe-core (pure geometry, no npm), no per-site baseline (a size regression is never
## "accepted"). The engine lives in the importable core dist_ai.webcheck.taptarget; this drives the
## sandbox's Playwright venv python (a plain python3 there has no playwright) at that module.
##
## Exit: 0 all clean, 1 a violation / unauditable page, 77 Playwright/chromium absent and
## un-provisionable. Fails CLOSED: a missing sandbox, a failed provision, or a 77 SKIP from inside
## the sandbox (the gate did not actually run) is a hard error, never a silent pass.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## The sandbox Playwright venv + its chromium engine (provisioned by `provision playwright`; the
## same path web-render / webcheck-axe-sandbox bind).
readonly SANDBOX_VENV_PY='/home/user/.venvs/web-render/bin/python'
## Per-run working dir inside the sandbox. PID-unique so two concurrent gates never clobber each
## other's staging through `sandbox sync --delete`.
readonly SANDBOX_WORKDIR="/home/user/webcheck-taptarget-sandbox-run.$$"

die(){
   printf '%s\n' "webcheck-taptarget-sandbox: $1" >&2
   exit 1
}

paths_file=''
while [ "$#" -gt 0 ]; do
   case "$1" in
      '--paths-file')
         [ "$#" -ge 2 ] || die '--paths-file requires a FILE value'
         paths_file="$2"
         shift 2
         ;;
      *)
         break
         ;;
   esac
done
[ "$#" -gt 0 ] || die 'usage: webcheck-taptarget-sandbox [--paths-file FILE] <site-root> [...]'
[ -z "${paths_file}" ] || [ -f "${paths_file}" ] || die "paths-file not found: ${paths_file}"

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"
if [ -d "${script_dir}/../lib/python3/dist-packages/dist_ai/webcheck" ]; then
   core_src="${script_dir}/../lib/python3/dist-packages/dist_ai"
else
   core_src='/usr/lib/python3/dist-packages/dist_ai'
fi
[ -d "${core_src}/webcheck" ] || die "missing webcheck core: ${core_src}/webcheck"

## Local-first: when the Playwright venv resolves in THIS environment (in-sandbox-direct, where
## provision placed it), run the gate DIRECTLY -- no nested sandbox. A 77 (playwright absent) falls
## through to the sandbox path below. WEBCHECK_NO_LOCAL=1 forces the sandbox path.
if [ "${WEBCHECK_NO_LOCAL:-}" != '1' ] && [ -x "${SANDBOX_VENV_PY}" ]; then
   declare -a local_args=()
   [ -z "${paths_file}" ] || local_args+=( --paths-file "${paths_file}" )
   local_err="$(mktemp)"
   local_rc=0
   PYTHONPATH="${core_src%/dist_ai}" \
      "${SANDBOX_VENV_PY}" -Bsu -m dist_ai.webcheck.taptarget \
      "${local_args[@]}" "$@" 2>"${local_err}" || local_rc="$?"
   if [ "${local_rc}" != '77' ]; then
      cat -- "${local_err}" >&2
      safe-rm -f -- "${local_err}"
      exit "${local_rc}"
   fi
   safe-rm -f -- "${local_err}"
fi

## No local Playwright. Reach the review sandbox -- unless we are inside it already (cannot nest)
## or there is none: then env-unmet, exit 77 (launcher treats as SKIP). Never a masked failure: a
## gate that RAN exits 0/non-77 above.
if [ "${DIST_AI_IN_SANDBOX:-}" = '1' ] || [ "${WEBSITE_TESTS_NO_SANDBOX:-}" = '1' ] \
   || ! command -v sandbox >/dev/null 2>&1; then
   printf '%s\n' 'webcheck-taptarget-sandbox: no local Playwright and no usable sandbox -- SKIP (77)' >&2
   ## style-ok: allow-skip: env-unmet -- no local Playwright and no usable sandbox; launcher maps 77 to SKIP, never a masked pass
   exit 77
fi
## `sandbox` requires a target; the local review sandbox is the forget-proof default.
: "${QUBE_CTL_TARGET:=temp-claude}"
export QUBE_CTL_TARGET

## Playwright venv + chromium engine. Provision once if absent; a failed provision fails the gate,
## never skips (mirrors webcheck-axe-sandbox).
if ! sandbox exec --pid-scope private -- test -x "${SANDBOX_VENV_PY}" >/dev/null 2>&1; then
   printf '%s\n' 'webcheck-taptarget-sandbox: provisioning Playwright in the sandbox (one-time)...' >&2
   provision --target "${QUBE_CTL_TARGET}" playwright >&2 \
      || die "sandbox is not provisioned for Playwright and provisioning failed (provision --target ${QUBE_CTL_TARGET} playwright)"
   sandbox exec --pid-scope private -- test -x "${SANDBOX_VENV_PY}" >/dev/null 2>&1 \
      || die 'Playwright venv still absent after provisioning'
fi

## Host staging holds a COPY of the webcheck core + every site tree before the sandbox sync; the
## wiki trees are large and overflow the small /tmp tmpfs, so stage on ample persistent disk under
## $HOME (an ENOSPC mid-rsync reads as a lane failure, not a result). Mirrors webcheck-axe-sandbox.
: "${WEBCHECK_TAPTARGET_TMP:=${XDG_CACHE_HOME:-${HOME}/.cache}/webcheck-taptarget-sandbox-tmp}"
mkdir --parents -- "${WEBCHECK_TAPTARGET_TMP}"
staging="$(mktemp --directory -- "${WEBCHECK_TAPTARGET_TMP}/webcheck-taptarget-sandbox.XXXXXX")"
synced=0
cleanup(){
   # shellcheck disable=SC2317  # invoked indirectly via the EXIT trap
   safe-rm --recursive --force -- "${staging}" || true
   # shellcheck disable=SC2317
   if [ "${synced}" = '1' ]; then
      sandbox exec --pid-scope private -- safe-rm --recursive --force -- "${SANDBOX_WORKDIR}" >/dev/null 2>&1 || true
   fi
   # shellcheck disable=SC2317
   return 0
}
trap cleanup EXIT

staged_pylib="${staging}/usr/lib/python3/dist-packages"
mkdir --parents -- "${staged_pylib}" "${staging}/roots"
cp --archive -- "${core_src}" "${staged_pylib}/dist_ai"
[ -z "${paths_file}" ] || cp -- "${paths_file}" "${staging}/paths-file.txt"

declare -a remote_roots=()
declare -A seen_base=()
for root in "$@"; do
   [ -f "${root}/index.html" ] || die "not a site root (no index.html): ${root}"
   root="$(readlink --canonicalize -- "${root}")"
   base="$(basename -- "${root}")"
   [ -z "${seen_base[${base}]:-}" ] || die "duplicate site-root basename '${base}'"
   seen_base[${base}]=1
   rsync --archive --exclude='.git' -- "${root}/" "${staging}/roots/${base}/"
   remote_roots+=( "${SANDBOX_WORKDIR}/roots/${base}" )
done

sandbox sync --delete "${staging}" "$(basename -- "${SANDBOX_WORKDIR}")" >&2 \
   || die 'failed to sync the staging tree into the sandbox'
synced=1

declare -a mod_args=()
[ -z "${paths_file}" ] || mod_args+=( --paths-file "${SANDBOX_WORKDIR}/paths-file.txt" )

rc=0
sandbox exec --pid-scope private -- env \
   "PYTHONPATH=${SANDBOX_WORKDIR}/usr/lib/python3/dist-packages" \
   "${SANDBOX_VENV_PY}" -Bsu -m dist_ai.webcheck.taptarget "${mod_args[@]}" "${remote_roots[@]}" || rc="$?"

## A 77 SKIP from inside the sandbox means the gate did not actually run (Playwright/chromium
## missing) -- which defeats the purpose after we provisioned it. Treat it as failure, never a pass
## (mirrors webcheck-axe-sandbox).
if [ "${rc}" = '77' ]; then
   printf '%s\n' 'webcheck-taptarget-sandbox: the lane SKIPped inside the sandbox (gate did not run) -- treating as failure' >&2
   rc=1
fi

exit "${rc}"
