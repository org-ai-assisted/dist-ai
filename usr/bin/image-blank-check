## AI-Assisted

## Shell-invocation guard.
"exec" "bash" "-c" "printf '%s\n' '$0: ERROR: Do not execute this script with bash!' >&2; exit 1"

"""Flag degenerate (blank) screenshots: an all-white or all-black frame, or one so
close to it that it carries no content -- a broken capture (compositor not painted,
headless firmware, a state card whose text failed to render). Exits non-zero when any
flagged, so a release-test run that produced a blank milestone frame FAILS the run
instead of silently publishing a black rectangle.

Usage:
  image-blank-check [--max-colors N] [--near D] [--frac F] [--allow NAME]... PATH...

PATH is a PNG/WEBP file or a directory (scanned for *.png and *.webp, non-recursive).
A frame is degenerate when it is uniform white/black, OR has <= --max-colors distinct
colors AND its dominant color covers >= --frac of pixels AND that color is within --near
of pure black or pure white on every channel. The --max-colors gate is what keeps a
content-rich dark frame (a grub menu, a boot console: hundreds of distinct colors, >90%
black background) from being flagged -- a pixel-fraction rule alone would flag it. --allow excludes a shot whose name equals NAME or
whose stem ends with '-'+NAME (a dash-delimited suffix token, not a raw substring -- so
'' or '.' cannot silently exempt everything); for a frame legitimately blank by design --
use sparingly, and say why."""

import argparse
import os
import sys

from PIL import Image

_LIB = os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
    "lib", "python3", "dist-packages")
if os.path.isdir(_LIB) and _LIB not in sys.path:
    sys.path.insert(0, _LIB)

from dm_test_results.image_gate import is_allowed, iter_images  # noqa: E402


def classify(path, max_colors, near, frac, uniform_only=False):
    """Return a short reason string if PATH is degenerate, else None.

    uniform_only: flag ONLY a truly-uniform (single near-black/white colour) frame --
    for gating a real framebuffer grab (a tty/console, a boot screen) where a frame
    that is mostly black but carries sparse real content (a login prompt, a cursor,
    a few log lines: 2+ colours) is LEGITIMATE and must not be a false positive. The
    near-blank frac heuristic is skipped in this mode."""
    with Image.open(path) as im:
        im = im.convert("RGB")
        total = im.width * im.height
        if total == 0:
            return "empty image (0 px)"
        extrema = im.getextrema()
        uniform = all(mn == mx for mn, mx in extrema)
        ## getcolors(maxcolors=N) returns None the moment the palette exceeds N, so a
        ## content-rich frame short-circuits here -- no full per-pixel histogram is built,
        ## bounding time + memory on large frames. We only care whether the frame is
        ## near a SINGLE colour (<= max_colors distinct).
        colors = im.getcolors(maxcolors=max_colors)

    def near_bw(rgb):
        return all(c <= near for c in rgb), all(c >= 255 - near for c in rgb)

    if uniform:
        is_black, is_white = near_bw(tuple(mn for mn, _mx in extrema))
        if is_black:
            return "uniform black"
        if is_white:
            return "uniform white"
        return None
    ## uniform-only: a non-uniform frame has >=2 colours -> some content rendered -> not
    ## degenerate here (a sparse tty login is not a false-positive all-black).
    if uniform_only:
        return None
    ## More than max_colors distinct colours -> real content, never near-blank.
    if colors is None:
        return None
    dom_count, dom_rgb = max(colors)
    is_black, is_white = near_bw(dom_rgb)
    dom_frac = dom_count / total
    if dom_frac >= frac and (is_black or is_white):
        shade = "black" if is_black else "white"
        return ("near-blank %s (%.2f%% one colour, %d distinct)"
                % (shade, dom_frac * 100.0, len(colors)))
    return None


def parse_args(argv):
    parser = argparse.ArgumentParser(prog="image-blank-check", add_help=True)
    parser.add_argument("--max-colors", type=int, default=8,
                        help="a frame with more distinct colours than this is never "
                             "near-blank (default 8)")
    parser.add_argument("--near", type=int, default=6,
                        help="how close (0-255) the dominant colour must be to pure "
                             "black/white (default 6)")
    parser.add_argument("--frac", type=float, default=0.90,
                        help="dominant-colour share for near-blank: a frame >= this one "
                             "near-black/white colour (and <= --max-colors distinct) is "
                             "degenerate (default 0.90)")
    parser.add_argument("--allow", action="append", default=[],
                        help="skip a shot whose name equals this, or whose stem ends "
                             "with '-'+this (a dash-delimited suffix token); an empty "
                             "value never matches")
    parser.add_argument("--uniform-only", action="store_true",
                        help="flag ONLY a truly-uniform (single near-black/white colour) "
                             "frame; for gating a framebuffer grab (tty/console, boot "
                             "screen) where sparse real content is legitimate")
    parser.add_argument("paths", nargs="+")
    return parser.parse_args(argv[1:])


def main(argv):
    args = parse_args(argv)
    flagged = []
    checked = 0
    for path in iter_images(args.paths):
        base = os.path.basename(path)
        if is_allowed(base, args.allow):
            continue
        checked += 1
        try:
            reason = classify(path, args.max_colors, args.near, args.frac,
                               args.uniform_only)
        except (OSError, ValueError) as exc:
            ## An unreadable/corrupt frame is itself a bad capture -> flag it.
            flagged.append((path, "unreadable: %s" % exc))
            continue
        if reason is not None:
            flagged.append((path, reason))
    for path, reason in flagged:
        sys.stderr.write("image-blank-check: DEGENERATE %s -- %s\n" % (path, reason))
    sys.stdout.write("image-blank-check: %d checked, %d degenerate\n"
                     % (checked, len(flagged)))
    return 1 if flagged else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
