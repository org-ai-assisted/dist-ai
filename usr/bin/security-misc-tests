#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Runs security-misc's dist-ai tests via pytest: the SSH client/server
## hardening validation (test_ssh_config.py, driving the shipped ssh-audit-test
## tool and ssh-audit against a throwaway sshd / client built from the real
## config) and the PAM config checks (test_pam_configs_prerm_sync.py). The
## security-misc checkout is resolved by SECURITY_MISC_REPO (wired by
## dist-ai-tests-all). Works installed (/usr/share/security-misc-tests) or from
## a git checkout.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/security-misc-tests" ]; then
   tests_dir="${script_dir}/../share/security-misc-tests"
else
   tests_dir='/usr/share/security-misc-tests'
fi

## Resolve the subject by a FEATURE-AGNOSTIC marker (the security-misc libexec
## dir), from the checkout (SECURITY_MISC_REPO, wired by dist-ai-tests-all) or
## the installed package, so every test runs -- not only the SSH ones that a
## single-config sentinel would gate. Absent both, security-misc is not present
## to test -- an OPTIONAL target, so skip cleanly rather than fail, matching the
## rest of the registry's unresolved-target contract.
subject_present="false"
if [ -n "${SECURITY_MISC_REPO:-}" ] \
   && [ -d "${SECURITY_MISC_REPO}/usr/libexec/security-misc" ]; then
   subject_present="true"
elif [ -d "/usr/libexec/security-misc" ]; then
   subject_present="true"
fi
if [ "${subject_present}" = "false" ]; then
   printf '%s\n' "${0##*/}: SKIP: security-misc not present (no SECURITY_MISC_REPO checkout, not installed)" >&2
   ## style-ok: allow-skip: security-misc not checked out or installed -- optional target
   exit 77
fi

rc=0
python3 -m pytest --import-mode=importlib -q "${tests_dir}" "$@" || rc=$?
## pytest exit 5 = no tests collected. python3-pytest is in this consumer's CI
## apt list, so collecting nothing means the suite is not being run at all;
## record it as a failure rather than a green lane testing nothing.
if [ "${rc}" = "5" ]; then
   printf '%s\n' 'FAIL: pytest collected no tests; the suite is not being run.' >&2
   rc=1
fi

exit "${rc}"
