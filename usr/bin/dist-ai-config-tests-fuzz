#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Fuzz lane of the dist-ai-config test surface: randomized property/oracle
## fuzzing of the sandbox-run / qube-ctl / container-guard / sandbox-view
## argument parsers, checking that adversarial quoting round-trips and never
## escapes into the executing shell. No root, no network, no Qubes.
##
## Targets a dist-ai-config checkout via DIST_AI_CONFIG_PATH. Exits 77 (SKIP)
## when the checkout is unavailable. Reproduce a reported case with
## --seed N; --iters N sets the per-phase budget.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/dist-ai-config-tests" ]; then
   share="${script_dir}/../share/dist-ai-config-tests"
else
   share='/usr/share/dist-ai-config-tests'
fi

rc=0
bash -- "${share}/run-tests.sh" --lane fuzz "$@" || rc=$?
exit "${rc}"
