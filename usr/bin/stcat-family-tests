#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Comprehensive test + fuzz for the stcat family (the stdisplay CLI tools:
## stcat, stcatn, stecho, stprint, stsponge, sttee). Proves no Unicode /
## control / escape bypass: output is pure ASCII (+ newline/tab, + SGR colour
## only when colour is enabled), for a hostile corpus and a byte-level fuzzer,
## and that each tool still performs its function on benign input. No root, no
## network. Targets the installed tools by default; set STDISPLAY_REPO to a
## helper-scripts checkout to test that instead. Extra args (e.g. --iterations
## N, --seed N) pass through.

## check_runtime.bsh provides was_executed + the strict-mode gate below. If it is
## absent the source fails BEFORE strict mode, was_executed is undefined (127), both
## guards read false, main never runs, and the suite exits 0 -- a false PASS for a
## file that was never tested. Fail loud (SKIP) instead. A source-able test
## caller runs in an env that HAS the helper, so the guard never fires there.
if [ ! -r /usr/libexec/helper-scripts/check_runtime.bsh ]; then
   printf '%s\n' 'stcat-family-tests: SKIP (helper-scripts check_runtime.bsh not found)' >&2
   exit 77
fi
source /usr/libexec/helper-scripts/check_runtime.bsh

if was_executed "${BASH_SOURCE[0]}"; then
   set -o errexit
   set -o nounset
   set -o pipefail
   set -o errtrace
   shopt -s inherit_errexit
   shopt -s shift_verbose
fi

main() {
   script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

   if [ -d "${script_dir}/../share/stcat-family-tests" ]; then
      tests_dir="${script_dir}/../share/stcat-family-tests"
   else
      tests_dir='/usr/share/stcat-family-tests'
   fi

   rc=0
   python3 -- "${tests_dir}/stcat_family_test.py" "$@" || rc=$?
   exit "${rc}"
}

if was_executed "${BASH_SOURCE[0]}"; then
   main "$@"
fi
