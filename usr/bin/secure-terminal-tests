#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Tests for secure-terminal's pure, Qt-free sanitization core
## (secure-terminal: usr/lib/python3/dist-packages/secure_terminal/sanitize.py):
## the display-mode renderer (strip/show/reveal), paste sanitization and
## classification, the safe-colour SGR parser and its contrast guard, and the
## NO_COLOR / TERM=dumb environment handling, plus a static check that the widget
## layer never routes untrusted text into an HTML sink. The core has no GUI
## dependency, so this runs it directly under python3 with no PyQt6. No root, no
## network. It targets a secure-terminal checkout resolved from
## SECURE_TERMINAL_REPO (or a default under the operator's private-sources); an absent
## checkout is FATAL (exit 1) unless the caller authorized the skip
## (DIST_AI_SKIP_AUTHORIZED=1, which dist-ai-tests-all sets for a --allow-skip'd or a
## lenient non-strict run), in which case it SKIPs (exit 77).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/secure-terminal-tests" ]; then
   tests_dir="${script_dir}/../share/secure-terminal-tests"
else
   tests_dir='/usr/share/secure-terminal-tests'
fi

## Each suite runs IN PARALLEL under its OWN headless-Wayland compositor (labwc, via
## wl-headless-run) so it uses the 'wayland' QPA platform -- the only supported platform (no
## offscreen). A single shared compositor cannot serve parallel suites (its wayland socket +
## the single-instance socket namespace collide), so the dispatch (suite-parallel.bash) mints
## one compositor per suite. Sequential-in-one-compositor overran the CI per-suite timeout once
## the Qt suites moved to real software rendering. Both helpers are REQUIRED tooling -> FATAL if
## absent, never a silent skip.
if [ -x "${script_dir}/../share/dist-ai-tests-common/wl-headless-run" ]; then
   wl_headless_run="${script_dir}/../share/dist-ai-tests-common/wl-headless-run"
elif [ -x /usr/share/dist-ai-tests-common/wl-headless-run ]; then
   wl_headless_run='/usr/share/dist-ai-tests-common/wl-headless-run'
else
   printf '%s\n' 'secure-terminal-tests: FATAL: wl-headless-run not found (install dist-ai-tests-common); cannot start a headless Wayland compositor' >&2
   exit 1
fi
if [ -f "${script_dir}/../share/dist-ai-tests-common/suite-parallel.bash" ]; then
   suite_parallel_lib="${script_dir}/../share/dist-ai-tests-common/suite-parallel.bash"
elif [ -f /usr/share/dist-ai-tests-common/suite-parallel.bash ]; then
   suite_parallel_lib='/usr/share/dist-ai-tests-common/suite-parallel.bash'
else
   printf '%s\n' 'secure-terminal-tests: FATAL: suite-parallel.bash not found (install dist-ai-tests-common)' >&2
   exit 1
fi
# shellcheck source=../share/dist-ai-tests-common/suite-parallel.bash
source "${suite_parallel_lib}"

repo=''
[ -v SECURE_TERMINAL_REPO ] || SECURE_TERMINAL_REPO=''
if [ -n "${SECURE_TERMINAL_REPO}" ]; then
   repo="${SECURE_TERMINAL_REPO}"
elif [ -d "${HOME}/private-sources/secure-terminal/usr/lib/python3/dist-packages/secure_terminal" ]; then
   repo="${HOME}/private-sources/secure-terminal"
elif [ -d "${script_dir}/../../../../secure-terminal/usr/lib/python3/dist-packages/secure_terminal" ]; then
   repo="${script_dir}/../../../../secure-terminal"
fi

if [ -z "${repo}" ] || [ ! -d "${repo}/usr/lib/python3/dist-packages/secure_terminal" ]; then
   ## The secure_terminal checkout IS the target under test. Absent, there is nothing to
   ## test -- but a bare SKIP reads green, so an absent target is FATAL unless the run that
   ## invoked us authorized the skip: DIST_AI_SKIP_AUTHORIZED=1, which dist-ai-tests-all
   ## sets for a --allow-skip'd (or lenient non-strict) run. The gate/CI env always provides
   ## the checkout, so there it simply runs; a standalone or unauthorized run FATALs.
   if [ "${DIST_AI_SKIP_AUTHORIZED:-}" = '1' ]; then
      printf '%s\n' 'secure-terminal-tests: SKIP (secure_terminal not found; set SECURE_TERMINAL_REPO) [authorized]' >&2
      ## style-ok: allow-skip: target checkout absent AND the skip was authorized by the orchestrator
      exit 77
   fi
   printf '%s\n' 'secure-terminal-tests: FATAL: secure_terminal not found; set SECURE_TERMINAL_REPO (unauthorized absent-target skip)' >&2
   exit 1
fi

## No interpreter check: a missing python3 is a hard FAIL, not a SKIP -- the
## tests below invoke python3 directly and fail loudly if it is absent
## (security by default: a test dependency that is missing must not be silently
## skipped). The only SKIP is a genuinely absent target checkout (above).

export PYTHONPATH="${repo}/usr/lib/python3/dist-packages${PYTHONPATH:+:${PYTHONPATH}}"

## Pin the font DPI to 72 for every suite process BEFORE Qt starts, so the Qt
## suites' font-metric-derived geometry (the responsive-toolbar tier widths in
## test_mainwin especially) is deterministic without each module having to
## remember its own setdefault. Honour an explicit override (e.g. a real-compositor
## run) so this is a safe default, not a lock.
export QT_FONT_DPI="${QT_FONT_DPI:-72}"

work="$(mktemp --directory)"
# shellcheck disable=SC2317  # invoked via the EXIT trap
cleanup() { safe-rm --recursive --force -- "${work}" 2>/dev/null || true; }
trap cleanup EXIT

## Extra args are forwarded to every suite, unchanged from the sequential form.
forward_args=("$@")

## Run one suite under its OWN headless-Wayland compositor. suite-parallel.bash captures its
## stdout+stderr and exit status; this fn only launches it.
# shellcheck disable=SC2317  # invoked indirectly by run_suites_parallel via its name
plain_run_one_suite() {  ## $1 = suite .py path
   ## Invoke the suite through python3 from PATH (matching its '#!/usr/bin/python3 -Bsu'
   ## shebang), NOT by exec'ing the file. The runner already controls the suite environment
   ## (PYTHONPATH, QT_FONT_DPI), so the interpreter must be controllable the same way: a stubbed
   ## python3 on PATH can drive a suite's exit code (the authorized-skip aggregation test does
   ## this), and a suite file no longer needs +x to run. The sequential runner invoked suites
   ## via python3; the parallel split regressed to exec-by-shebang, which silently disabled both.
   "${wl_headless_run}" --no-autoconfirm -- python3 -Bsu "$1" "${forward_args[@]}"
}

## The pure, Qt-free tests always run; the Qt suites fail closed (exit 1) on a
## missing PyQt6/pyte rather than skipping. The suite fails if any test fails,
## and SKIPs only when the pure test cannot import the module at all.
##
## test_fuzz_harnesses drives the atheris harnesses in secure-terminal/fuzz/ with
## a stubbed atheris, so a harness that no longer builds or that trips its own
## invariant is caught HERE rather than in a nightly nothing blocks on.
## test_fuzz_widget drives the live-widget GUI fuzzer deterministically.
##
## Run them ALL in parallel, each under its own compositor (SECURE_TERMINAL_TESTS_JOBS overrides
## the core/RAM-aware concurrency cap); the exit status of each is judged below in canonical
## order, so the pass/skip/fail policy is exactly the sequential one.
suites=(
   "${tests_dir}/test_secure_terminal.py"
   "${tests_dir}/test_fuzz.py"
   "${tests_dir}/test_fuzz_harnesses.py"
   "${tests_dir}/test_corpus.py"
   "${tests_dir}/test_invariants.py"
   "${tests_dir}/verify_formal.py"
   "${tests_dir}/verify_formal_absint.py"
   "${tests_dir}/test_unicode_gallery.py"
   "${tests_dir}/test_cli.py"
   "${tests_dir}/test_unicode_tag.py"
   "${tests_dir}/test_sclip.py"
   "${tests_dir}/test_clipboard_watch.py"
   "${tests_dir}/test_modules.py"
   "${tests_dir}/test_review.py"
   "${tests_dir}/test_mainwin.py"
   "${tests_dir}/test_mainwin2.py"
   "${tests_dir}/test_mainwin3.py"
   "${tests_dir}/test_mainwin4.py"
   "${tests_dir}/test_mainwin5.py"
   "${tests_dir}/test_instances.py"
   "${tests_dir}/test_widget.py"
   "${tests_dir}/test_widget2.py"
   "${tests_dir}/test_state_dump.py"
   "${tests_dir}/test_zoom_regression.py"
   "${tests_dir}/test_fuzz_widget.py"
)
run_suites_parallel "${work}" "${repo}/usr/lib/python3/dist-packages/secure_terminal" \
   "${SECURE_TERMINAL_TESTS_JOBS:-}" plain_run_one_suite "${suites[@]}"

overall=0
authorized_skip=0
for test_file in "${suites[@]}"; do
   [ -f "${test_file}" ] || continue
   ## Read the suite's captured exit status. A missing rc file (a job killed before it recorded
   ## one) is fail-closed, never a silent pass.
   rc="$(cat -- "${work}/rc-$(basename -- "${test_file}" .py)" 2>/dev/null || true)"
   [ -n "${rc}" ] || rc=1
   if [ "${rc}" = '0' ]; then
      continue
   fi
   if [ "${rc}" = '77' ]; then
      ## A suite that exits 77 SKIPPED instead of running (a Qt suite on missing PyQt6/pyte, or
      ## the pure canary that could not import the module). Required tooling, not an optional
      ## target, so an unauthorized skip fails closed rather than reading green; an authorized
      ## (--allow-skip / lenient) run may still skip. A genuinely-absent checkout is already
      ## caught by the top-of-file guard before any suite runs. NEVER early-exit here: a LATER
      ## suite's real failure (rc 1) must still be seen, never masked by this one's skip.
      if [ "${DIST_AI_SKIP_AUTHORIZED:-}" = '1' ]; then
         printf '%s\n' "secure-terminal-tests: SKIP ${test_file##*/} (exit 77) [authorized]" >&2
         authorized_skip=1
         continue
      fi
      printf '%s\n' "secure-terminal-tests: FATAL: ${test_file##*/} exited 77 (skipped); its deps are required (set DIST_AI_SKIP_AUTHORIZED to allow)" >&2
      overall=1
      continue
   fi
   overall=1
done
## An authorized skip of a required suite must not read as a clean full pass: if nothing
## failed but a suite was authorized-skipped, exit 77 (SKIP) so the caller can tell a
## lenient-skipped run from a full pass -- matching the module-absent block above, which
## also signals the skip via exit 77 rather than a silent 0.
if [ "${overall}" = '0' ] && [ "${authorized_skip}" = '1' ]; then
   ## style-ok: allow-skip: a required suite was authorized-skipped; report SKIP, not PASS
   exit 77
fi
exit "${overall}"
