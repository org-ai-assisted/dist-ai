#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Shell-coverage lane for private-ai-config: re-runs the core lane under kcov and
## gates the argument parsers the injection corpus targets against a measured
## per-tool floor. The counterpart to secure-terminal-tests-coverage, which
## gates the python side.
##
## Targets a private-ai-config checkout via PRIVATE_AI_CONFIG_PATH. Exits 77 (SKIP)
## when the checkout, kcov or jq is unavailable. No root, no network.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/private-ai-config-tests" ]; then
   share="${script_dir}/../share/private-ai-config-tests"
else
   share='/usr/share/private-ai-config-tests'
fi

rc=0
bash -- "${share}/coverage.sh" "$@" || rc=$?
exit "${rc}"
