#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Thin wrapper: run the Qt-WIDGET tier of the secure-terminal coverage gate as its OWN
## dist-ai-tests-all entry so it fits the per-suite timeout. It runs the headless-Wayland widget
## suites, asserts the gated_qt (Qt-widget) tier at 100%, and runs the fuzz-widget self-coverage.
## The Qt-free tier + formal proofs are the -free entry. See secure-terminal-tests-coverage.
## style-ok: R-103 -- a thin wrapper is MEANT to exec the real runner unchanged.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

exec env ST_COV_TIER=qt \
   "$(dirname -- "$(readlink --canonicalize -- "$0")")/secure-terminal-tests-coverage" "$@"
