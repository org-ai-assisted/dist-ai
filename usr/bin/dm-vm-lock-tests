#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Suite for dm-vm-lock, the VM-work concurrency mutex on the shared OVH test server:
## class exclusion (leak vs work), shared-work coexistence, reentrancy no-op, the TTL
## self-release backstop, stale-holder reaping + registry format, error paths, and that the
## real VM entry points self-lock with the correct class. Real flock on a temp lock dir
## (DM_VM_LOCK_DIR seam) -- no root, no VM, no /run.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/dm-vm-lock-tests" ]; then
   tests_dir="${script_dir}/../share/dm-vm-lock-tests"
else
   tests_dir='/usr/share/dm-vm-lock-tests'
fi

shopt -s nullglob
failures=0
skips=0
ran=0
for test_script in "${tests_dir}"/*_test.sh; do
   ran=$(( ran + 1 ))
   printf '\n########## %s ##########\n' "$(basename -- "${test_script}")"
   rc=0
   bash -- "${test_script}" "$@" || rc=$?
   if [ "${rc}" -eq 77 ]; then
      printf '########## SKIPPED: %s ##########\n' "$(basename -- "${test_script}")"
      skips=$(( skips + 1 ))
   elif [ "${rc}" -ne 0 ]; then
      printf '########## FAILED (%s): %s ##########\n' "${rc}" "$(basename -- "${test_script}")"
      failures=$(( failures + 1 ))
   fi
done

if [ "${ran}" -eq 0 ]; then
   printf 'ERROR: no *_test.sh found in %s\n' "${tests_dir}" >&2
   exit 1
fi
if [ "${failures}" -ne 0 ]; then
   printf '\nFAILED: %s dm-vm-lock test script(s) failed\n' "${failures}" >&2
   exit 1
fi
printf '\nOK: all dm-vm-lock test scripts passed (%s skipped)\n' "${skips}"
