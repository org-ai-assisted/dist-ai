#!/usr/bin/python3

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

"""Deterministic style AUTO-FIXER -- the write-side twin of pre-push-static.

pre-push-static DETECTS violations; the model then spends a turn CORRECTING
them. This tool removes that round trip for the MECHANICAL, provably
semantics-preserving rules: it rewrites the fixable violations in place, so
the gate that follows passes silently and the model never sees them.

Bucket-1 transforms only (see the plan):
  * R-001  -- substitute the KNOWN confusable set (em/en dash, smart quotes,
              ellipsis, arrows, nbsp, bullet) to its intended ASCII form,
              plus the HTML-entity spellings in prose/markup files.
  * trailing-whitespace -- strip blanks before end-of-line.

HARD SAFETY LINE: only the known-confusable table is touched. Any OTHER
non-ASCII byte is left exactly as-is for pre-push-static to report (bucket-2)
-- so an intentional UTF-8 test fixture is never silently rewritten.

Exemptions are kept in lockstep with pre-push-static's R-001 / trailing-
whitespace checks (a .gitattributes binary data file, the per-file
'## style-ok: allow-non-ascii' waiver, symlinks, non-regular files, and the
is_text_file set for whitespace). test_pre_push_fix.sh pins that parity so
detector and fixer cannot drift.

Idempotent: a second run over its own output changes nothing.

Usage:
  pre-push-fix [--check] FILE...     fix (or, with --check, only report) FILEs
  pre-push-fix [--check] --staged    fix the repo's staged text files

Exit: 0 success; in --check mode 1 means "changes are needed"; 2 usage/error.
"""

import argparse
import os
import subprocess
import sys

## R-001 raw-codepoint confusables -> intended ASCII. Deliberately SMALL and
## explicit: every entry is a character whose ASCII intent is unambiguous.
## Anything not here stays a reported violation, never a guess. Keys are \u
## escapes so THIS source stays ASCII (the tool must pass its own R-001).
CONFUSABLES = {
    "\u2014": "--",   ## em dash
    "\u2013": "-",    ## en dash
    "\u2018": "'",    ## left single quote
    "\u2019": "'",    ## right single quote / apostrophe
    "\u201c": '"',    ## left double quote
    "\u201d": '"',    ## right double quote
    "\u2026": "...",  ## horizontal ellipsis
    "\u2192": "->",   ## rightwards arrow
    "\u2190": "<-",   ## leftwards arrow
    "\u00a0": " ",    ## no-break space
    "\u2022": "-",    ## bullet
}

## HTML-entity spellings that RENDER as an em/en dash. Applied only to markup
## files (an entity in a shell script is literal text, not a dash). Mirrors
## emdash-check.py's set.
ENTITIES = {
    "&mdash;": "--",
    "&ndash;": "-",
    "&#8212;": "--",
    "&#8211;": "-",
    "&#x2014;": "--",
    "&#x2013;": "-",
    "&#X2014;": "--",
    "&#X2013;": "-",
}

MARKUP_EXTS = (".html", ".htm", ".md", ".markdown", ".css", ".txt", ".rst")

## is_text_file's extension set, mirrored from pre-push-static so the
## trailing-whitespace transform covers exactly the same files. The gate falls
## back to file(1) --mime for extensionless files; so do we, below.
TEXT_EXTS = (
    ".md", ".sh", ".bsh", ".bash", ".py", ".yml", ".yaml", ".json", ".toml",
    ".xml", ".txt", ".csv", ".cfg", ".conf", ".ini", ".rst", ".html", ".css",
    ".js", ".ts", ".c", ".h", ".cpp", ".hpp", ".go", ".rs", ".tex",
    ".dockerfile",
)
TEXT_BASENAMES = ("Dockerfile", "Makefile", "COPYING", "README", "LICENSE")


def have(name):
    return any(
        os.access(os.path.join(directory, name), os.X_OK)
        for directory in os.environ.get("PATH", "").split(os.pathsep)
        if directory
    )


def is_data_file(path):
    """True when .gitattributes marks PATH binary -- exempt, same as the gate."""
    try:
        out = subprocess.run(
            ["git", "check-attr", "--cached", "binary", "--", path],
            capture_output=True, text=True,
        )
    except OSError:
        return False
    return (
        out.returncode == 0
        and out.stdout.rstrip("\n").endswith(": binary: set")
    )


def is_text_file(path):
    """Mirror pre-push-static's is_text_file: extension set, else file --mime."""
    if is_data_file(path):
        return False
    base = os.path.basename(path)
    if base in TEXT_BASENAMES or path.endswith(TEXT_EXTS):
        return True
    if not have("file"):
        return False
    try:
        mime = subprocess.run(
            ["file", "--brief", "--mime", "--dereference", "--", path],
            capture_output=True, text=True,
        ).stdout
    except OSError:
        return False
    needles = ("text/", "x-shellscript", "x-python", "json", "xml", "yaml",
               "toml", "charset=us-ascii", "charset=utf-8")
    return any(needle in mime for needle in needles)


def has_non_ascii_waiver(text):
    """The gate's per-file '## style-ok: allow-non-ascii' R-001 opt-out."""
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped.startswith("##"):
            continue
        body = stripped[2:].strip()
        if body == "style-ok: allow-non-ascii" or body.startswith(
                "style-ok: allow-non-ascii "):
            return True
    return False


def substitute_confusables(text):
    count = 0
    for char, repl in CONFUSABLES.items():
        found = text.count(char)
        if found:
            text = text.replace(char, repl)
            count += found
    return text, count


def substitute_entities(text):
    count = 0
    for entity, repl in ENTITIES.items():
        found = text.count(entity)
        if found:
            text = text.replace(entity, repl)
            count += found
    return text, count


def strip_trailing_whitespace(text):
    """Strip trailing space/tab before end-of-line; preserve CR and the
    presence/absence of a final newline."""
    count = 0
    out = []
    ## keepends so CRLF vs LF and a final no-newline line are preserved.
    for line in text.splitlines(keepends=True):
        newline = ""
        body = line
        if body.endswith("\r\n"):
            newline = "\r\n"
            body = body[:-2]
        elif body.endswith("\n"):
            newline = "\n"
            body = body[:-1]
        elif body.endswith("\r"):
            newline = "\r"
            body = body[:-1]
        stripped = body.rstrip(" \t")
        if stripped != body:
            count += 1
        out.append(stripped + newline)
    return "".join(out), count


def fix_file(path, check):
    """Return a dict of change counts for PATH; write in place unless CHECK.

    None -> the file was skipped (not a regular file, symlink, data file, or
    undecodable). An empty dict -> examined, already clean."""
    if not os.path.isfile(path) or os.path.islink(path):
        return None
    if is_data_file(path):
        return None
    try:
        with open(path, "rb") as handle:
            raw = handle.read()
    except OSError:
        return None
    ## A file we cannot decode as UTF-8 is not one we can safely rewrite:
    ## leave it for the gate to report rather than risk mangling bytes.
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        return None

    original = text
    changes = {}

    ## R-001: raw confusables, unless the file carries the non-ASCII waiver.
    if not has_non_ascii_waiver(text):
        text, num = substitute_confusables(text)
        if num:
            changes["R-001"] = num
        if path.lower().endswith(MARKUP_EXTS):
            text, num = substitute_entities(text)
            if num:
                changes["R-001-entity"] = num

    ## Trailing whitespace: same file scope as the gate (is_text_file).
    if is_text_file(path):
        text, num = strip_trailing_whitespace(text)
        if num:
            changes["trailing-whitespace"] = num

    if text == original:
        return {}
    if not check:
        with open(path, "wb") as handle:
            handle.write(text.encode("utf-8"))
    return changes


def staged_files():
    try:
        out = subprocess.run(
            ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR",
             "-z"],
            capture_output=True, text=True, check=True,
        ).stdout
    except (OSError, subprocess.CalledProcessError):
        return []
    top = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True, text=True,
    ).stdout.strip()
    if not top:
        return []
    return [os.path.join(top, name) for name in out.split("\0") if name]


def main():
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--check", action="store_true",
                        help="report only; exit 1 if changes are needed")
    parser.add_argument("--staged", action="store_true",
                        help="operate on the repo's staged text files")
    parser.add_argument("files", nargs="*")
    args = parser.parse_args()

    targets = list(args.files)
    if args.staged:
        targets.extend(staged_files())
    if not targets:
        return 0

    any_changed = False
    for path in targets:
        changes = fix_file(path, args.check)
        if changes:
            any_changed = True
            summary = ", ".join(
                f"{rule} x{num}" for rule, num in changes.items())
            verb = "would fix" if args.check else "fixed"
            print(f"pre-push-fix: {verb} {path}: {summary}", file=sys.stderr)

    if args.check and any_changed:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
