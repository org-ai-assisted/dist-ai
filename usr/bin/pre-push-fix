#!/usr/bin/python3

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

"""Deterministic style AUTO-FIXER -- the write-side twin of pre-push-static.

pre-push-static DETECTS violations; the model then spends a turn CORRECTING
them. This tool removes that round trip for the MECHANICAL, provably
structure-preserving rules: it rewrites the fixable violations in place, so the
gate that follows passes silently and the model never sees them.

Transforms:
  * R-001  -- substitute the KNOWN confusable set to its intended ASCII form.
              The always-safe set (em/en dash, ellipsis, arrows, nbsp, bullet)
              maps to characters that are never quote/syntax, so it applies to
              every file. SMART QUOTES map to ASCII quote characters, which ARE
              shell/python syntax -- a smart apostrophe inside a single-quoted
              string would become a real quote and break it -- so they are
              substituted ONLY in prose/markup files (with the HTML-entity
              spellings); in code they stay a reported R-001 for a human.
  * trailing-whitespace -- strip blanks before end-of-line.
  * R-172  -- upgrade a temp-dir mkdir's short '-m 700' / '-m700' to the long
              '--mode=700', and insert a '# shellcheck disable=SC2174' above the
              atomic '--parents ... --mode' form (which SC2174 flags by design)
              so the mandated form stays shellcheck-clean. A missing-mode or
              'chmod'-split mkdir is NOT fixed (a mode value cannot be guessed
              and a re-merge is multi-line) -- pre-push-static FAILS those.
  * R-161  -- expand a grep SHORT quiet cluster ('-iq' -> '--ignore-case
              --quiet') to its long-option form. The PIPE half of R-161 (a
              quiet grep consuming a pipe) is NOT fixed here -- relocating a
              redirect is multi-token, so pre-push-static FAILS it.
  * R-200  -- insert '--kill-after=<N>' into a bare 'timeout <N> cmd', so a
              wedged child ignoring SIGTERM still gets SIGKILL. Only the
              no-option LITERAL-duration form is rewritten; an option-carrying
              ('timeout --signal=TERM 5') or expression-duration ('timeout
              "$T"') timeout is left for the gate.

REAL PARSER, NOT A HAND-ROLLED ONE. The structural rewriters (R-172 mkdir, R-161
grep, R-200 timeout) act on the shfmt AST (dist_ai.bash_ast, wrapping
'shfmt --to-json'), never on a regex guess of shell structure. The parser tells a
COMMAND from data that only looks like one -- a token inside a string, a heredoc,
an array, or after a 'VAR=value' assignment prefix -- so these files, which the
former regex fixer DECLINED wholesale, are now fixed correctly. The style rule is
"never HAND-ROLL a parser", not "never parse": here we use the canonical shell
parser and query its typed tree. A file shfmt cannot parse is DECLINED by the
structural rewriters (left for the gate, which also runs 'bash -n'); the text
transforms (R-001, whitespace) still apply, since they need no parse.

Edits are SURGICAL: the byte span of each target node is spliced in the original
source, so existing formatting is preserved (no whole-file reprint).

HARD SAFETY LINE for R-001: only the known confusable table is touched. Any OTHER
non-ASCII byte is left as-is for pre-push-static to report -- so an intentional
UTF-8 test fixture is never silently rewritten.

Exemptions are kept in lockstep with pre-push-static (a .gitattributes binary
data file, the per-file '## style-ok: allow-non-ascii' waiver, the per-rule
'allow-mkdir-no-mode' / 'allow-bare-timeout' waivers, symlinks, non-regular
files, and the is_text_file set for whitespace). test_pre_push_fix.sh pins that
parity so detector and fixer cannot drift.

Idempotent: a second run over its own output changes nothing.

Usage:
  pre-push-fix [--check] FILE...     fix (or, with --check, only report) FILEs
  pre-push-fix [--check] --staged    fix the repo's staged text files

Exit: 0 success; in --check mode 1 means "changes are needed"; 2 usage/error
(includes a required tool, shfmt, being absent when a shell file must be parsed).
"""

import argparse
import os
import re
import subprocess
import sys

## Self-locate the shared library: '<root>/usr/bin/pre-push-fix' ->
## '<root>/usr/lib/python3/dist-packages'. Works both installed (/usr) and from a
## checkout with no env wiring -- the safe path is the DEFAULT, not a thing to
## remember. Harmless when installed (that dir is already on sys.path).
_LIB = os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
    "lib", "python3", "dist-packages")
if os.path.isdir(_LIB) and _LIB not in sys.path:
    sys.path.insert(0, _LIB)

from dist_ai import bash_ast  # noqa: E402

## Always-safe confusables: the ASCII form is never a quote or other
## syntactically significant character, so substituting cannot change code
## STRUCTURE -- only string CONTENT, which the ASCII policy mandates anyway.
## Keys are \u escapes so THIS source stays ASCII (it must pass its own R-001).
CONFUSABLES = {
    "\u2014": "--",   ## em dash
    "\u2013": "-",    ## en dash
    "\u2026": "...",  ## horizontal ellipsis
    "\u2192": "->",   ## rightwards arrow
    "\u2190": "<-",   ## leftwards arrow
    "\u00a0": " ",    ## no-break space
    "\u2022": "-",    ## bullet
}

## Smart quotes -> ASCII quote characters. These ARE syntax in code, so applied
## MARKUP-ONLY (see the module docstring).
QUOTES = {
    "\u2018": "'",    ## left single quote
    "\u2019": "'",    ## right single quote / apostrophe
    "\u201c": '"',    ## left double quote
    "\u201d": '"',    ## right double quote
}

## HTML-entity spellings that RENDER as an em/en dash. Markup-only, like QUOTES
## (an entity in a shell script is literal text). Mirrors emdash-check.py's set.
ENTITIES = {
    "&mdash;": "--",
    "&ndash;": "-",
    "&#8212;": "--",
    "&#8211;": "-",
    "&#x2014;": "--",
    "&#x2013;": "-",
    "&#X2014;": "--",
    "&#X2013;": "-",
}

MARKUP_EXTS = (".html", ".htm", ".md", ".markdown", ".css", ".txt", ".rst")

## is_text_file's extension set, mirrored from pre-push-static so the
## trailing-whitespace transform covers exactly the same files. The gate falls
## back to file(1) --mime for extensionless files; so do we, below.
TEXT_EXTS = (
    ".md", ".sh", ".bsh", ".bash", ".py", ".yml", ".yaml", ".json", ".toml",
    ".xml", ".txt", ".csv", ".cfg", ".conf", ".ini", ".rst", ".html", ".css",
    ".js", ".ts", ".c", ".h", ".cpp", ".hpp", ".go", ".rs", ".tex",
    ".dockerfile",
)
TEXT_BASENAMES = ("Dockerfile", "Makefile", "COPYING", "README", "LICENSE")

## The gate's R-001 waiver grammar, mirrored EXACTLY so the fixer's exemption
## stays in lockstep: '## style-ok: allow-non-ascii' with any (or no) horizontal
## whitespace around the tokens, terminated by whitespace or end-of-line.
WAIVER_RE = re.compile(
    r'^[ \t]*##[ \t]*style-ok:[ \t]*allow-non-ascii(?:[ \t]|$)', re.MULTILINE)

## Script-wide waivers, in lockstep with pre-push-static: a file carrying the
## R-172 waiver opts out of the mkdir-mode rule; one carrying the R-200 waiver has
## DELIBERATELY bare timeouts (a child that must finish its own SIGTERM cleanup).
## The fixer must not rewrite an opted-out file (else it forces a change the gate
## exempts).
MKDIR_WAIVER_RE = re.compile(
    r'^[ \t]*##[ \t]*style-ok:[ \t]*allow-mkdir-no-mode(?:[ \t]|$)',
    re.MULTILINE)
TIMEOUT_WAIVER_RE = re.compile(
    r'^[ \t]*##[ \t]*style-ok:[ \t]*allow-bare-timeout(?:[ \t]|$)',
    re.MULTILINE)

SHELL_EXTS = (".sh", ".bsh")
SHELL_SHEBANG_RE = re.compile(r'#!.*(/|\s)(bash|sh|dash)(\s|$)')

## Temp-dir parameter names: a mkdir whose operand expands one of these is the
## security-relevant surface R-172 governs.
TMP_PARAMS = {"TMPDIR", "TEMPDIR", "TEMP", "TMP"}

## A standalone short '-m' option carrying a numeric mode, either jammed ('-m700')
## or as the flag alone ('-m', with the mode in the following argument word).
MKDIR_M_JAMMED = re.compile(r'^-m([0-7]{3,4})$')

## The atomic idempotent form 'mkdir --parents ... --mode=' trips shellcheck
## SC2174 (with -p, -m applies only to the deepest dir) -- the intent for a temp
## dir whose parents pre-exist. Insert the disable so R-172's own mandated form
## stays shellcheck-clean.
SC2174_DISABLE = re.compile(
    r'#[ \t]*shellcheck[ \t]+disable=[A-Z0-9, ]*SC2174(?![0-9])')
SC2174_DIRECTIVE = "# shellcheck disable=SC2174"

## R-161: a bundled grep short cluster carrying 'q' is expanded to its long
## spelling. GREP_LONG maps each NO-ARG short option; a cluster containing any
## letter outside it is left as-is. The ARG-TAKING short options end an option
## expecting a value -- a following '-q'-shaped token could be that value, so a
## grep carrying one is left ENTIRELY for the gate (matches the former fixer).
GREP_LONG = {
    "i": "--ignore-case", "q": "--quiet", "v": "--invert-match",
    "n": "--line-number", "c": "--count", "l": "--files-with-matches",
    "L": "--files-without-match", "w": "--word-regexp", "x": "--line-regexp",
    "E": "--extended-regexp", "F": "--fixed-strings", "G": "--basic-regexp",
    "P": "--perl-regexp", "o": "--only-matching", "s": "--no-messages",
    "h": "--no-filename", "H": "--with-filename", "r": "--recursive",
    "R": "--dereference-recursive", "a": "--text", "z": "--null-data",
    "Z": "--null", "b": "--byte-offset",
}
GREP_ARG_TAKING_SHORT = set("efmABCdD")
GREP_ARG_TAKING_LONG = {
    "--regexp", "--file", "--max-count", "--after-context",
    "--before-context", "--context", "--color", "--colour",
    "--binary-files", "--devices", "--directories", "--label",
    "--group-separator", "--exclude", "--exclude-dir", "--exclude-from",
    "--include",
}

## R-200: a bare 'timeout <DURATION> cmd' where DURATION is a POSITIVE literal
## number (GNU strtod-style, optional [smhd] unit). A zero duration ('0', '.0',
## '0s') is a no-op timeout (no bound); inserting '--kill-after=0' there would
## emit a DISABLED escalation reading as compliant, a semi-false-green, so it is
## left untouched (the gate exempts it as a no-op).
TIMEOUT_DURATION = re.compile(
    r'^(?:[0-9]*[1-9][0-9]*(?:\.[0-9]*)?|[0-9]*\.[0-9]*[1-9][0-9]*)[smhd]?$')


class StagedDiscoveryError(Exception):
    """git could not enumerate the staged set -- distinct from 'nothing staged'."""


def have(name):
    return any(
        os.access(os.path.join(directory, name), os.X_OK)
        for directory in os.environ.get("PATH", "").split(os.pathsep)
        if directory
    )


def is_data_file(path):
    """True when .gitattributes marks PATH binary -- exempt, same as the gate."""
    try:
        out = subprocess.run(
            ["git", "check-attr", "--cached", "binary", "--", path],
            capture_output=True, text=True,
        )
    except OSError:
        return False
    return (
        out.returncode == 0
        and out.stdout.rstrip("\n").endswith(": binary: set")
    )


def is_text_file(path):
    """Mirror pre-push-static's is_text_file: extension set, else file --mime."""
    if is_data_file(path):
        return False
    base = os.path.basename(path)
    if base in TEXT_BASENAMES or path.endswith(TEXT_EXTS):
        return True
    if not have("file"):
        return False
    try:
        mime = subprocess.run(
            ["file", "--brief", "--mime", "--dereference", "--", path],
            capture_output=True, text=True,
        ).stdout
    except OSError:
        return False
    needles = ("text/", "x-shellscript", "x-python", "json", "xml", "yaml",
               "toml", "charset=us-ascii", "charset=utf-8")
    return any(needle in mime for needle in needles)


def is_shell_file(path):
    """True for a shell script: a .sh/.bsh extension, or a bash/sh/dash shebang.
    Mirrors pre-push-static's is_shell_file so the structural transforms touch
    exactly the file set the gate checks those rules against."""
    if path.endswith(SHELL_EXTS):
        return True
    try:
        with open(path, "rb") as handle:
            first = handle.readline()
    except OSError:
        return False
    return bool(SHELL_SHEBANG_RE.match(
        first.decode("utf-8", "replace").rstrip("\r\n")))


def has_non_ascii_waiver(text):
    return bool(WAIVER_RE.search(text))


def substitute(text, table):
    count = 0
    for char, repl in table.items():
        found = text.count(char)
        if found:
            text = text.replace(char, repl)
            count += found
    return text, count


def strip_trailing_whitespace(text):
    """Strip trailing space/tab before end-of-line; preserve CR and the
    presence/absence of a final newline."""
    count = 0
    out = []
    ## keepends so CRLF vs LF and a final no-newline line are preserved.
    for line in text.splitlines(keepends=True):
        newline = ""
        body = line
        if body.endswith("\r\n"):
            newline = "\r\n"
            body = body[:-2]
        elif body.endswith("\n"):
            newline = "\n"
            body = body[:-1]
        elif body.endswith("\r"):
            newline = "\r"
            body = body[:-1]
        stripped = body.rstrip(" \t")
        if stripped != body:
            count += 1
        out.append(stripped + newline)
    return "".join(out), count


def _grep_option_words(call):
    """The leading option Words of a grep CALL: Args[1:] up to (not including) the
    first operand or a '--' end-of-options token. Returns (options, saw_unparsed)
    where saw_unparsed is True if a non-literal (quoted/expanded) option-region
    word was seen -- then the caller declines, since it cannot classify it."""
    options = []
    for word in bash_ast.args(call)[1:]:
        lit = bash_ast.word_lit(word)
        if lit is None:
            ## A quoted/expanded word: could be the pattern operand or an option
            ## value. Stop scanning; earlier options are already collected.
            return options, False
        if lit == "--":
            break
        if not lit.startswith("-") or lit == "-":
            ## First non-option operand: options end here.
            break
        options.append((word, lit))
    return options, False


def _grep_has_arg_taker(options):
    """True if any grep option in OPTIONS expects a separate value -- a short
    cluster containing an arg-taking letter, or a long arg-taking option without
    an '=' value. Then a following '-q'-shaped token is ambiguous, so the whole
    grep is left for the gate."""
    for _word, lit in options:
        if lit.startswith("--"):
            name = lit.split("=", 1)[0]
            if "=" not in lit and name in GREP_ARG_TAKING_LONG:
                return True
        elif lit.startswith("-"):
            if set(lit[1:]) & GREP_ARG_TAKING_SHORT:
                return True
    return False


def mkdir_edits(text, tree):
    """Edits for R-172: upgrade a temp-dir mkdir's short '-m' to '--mode=', and
    insert a '# shellcheck disable=SC2174' above an atomic '--parents ... --mode'
    form. Per COMMAND via the AST, so a second command on the line is untouched
    and a '-m' inside a quoted path or an array is never seen as a flag. The
    shared option scanner skips a value-taking option's value, so a space-form
    '--mode 700 -p' still sees the '-p'."""
    data = text.encode("utf-8")
    edits = []
    disabled_lines = set()
    count = 0
    for call in bash_ast.call_exprs(tree):
        if bash_ast.command_name(call) != "mkdir":
            continue
        call_args = bash_ast.args(call)
        ## Temp-dir mkdir only: some operand expands a TMP* parameter.
        if not any(bash_ast.word_param_names(word) & TMP_PARAMS
                   for word in call_args[1:]):
            continue
        has_parents = False
        has_mode = False
        ## '-m' and '--mode' take a value; the scanner yields the value as 'value'
        ## so it is never mistaken for an operand and a following '-p' is seen.
        tokens = list(bash_ast.command_tokens(
            call, text, frozenset("m"), frozenset({"mode"})))
        for index, (kind, word, lit) in enumerate(tokens):
            if kind != "opt":
                continue
            if lit == "--mode" or lit.startswith("--mode="):
                has_mode = True
                continue
            if not lit.startswith("--"):
                cluster = lit[1:]
                if "p" in cluster:
                    has_parents = True
                jammed = MKDIR_M_JAMMED.match(lit)
                if jammed:
                    start, end = bash_ast.word_span(word)
                    edits.append((start, end, "--mode=" + jammed.group(1)))
                    has_mode = True
                    count += 1
                elif lit == "-m" and index + 1 < len(tokens) \
                        and tokens[index + 1][0] == "value":
                    mode_word = tokens[index + 1][1]
                    mode_lit = bash_ast.word_lit(mode_word)
                    if mode_lit and re.fullmatch(r'[0-7]{3,4}', mode_lit):
                        start, _ = bash_ast.word_span(word)
                        _, end = bash_ast.word_span(mode_word)
                        edits.append((start, end, "--mode=" + mode_lit))
                        has_mode = True
                        count += 1
            elif lit == "--parents":
                has_parents = True
        if has_parents and has_mode:
            ## Insert the disable above the mkdir's line. All offsets here are
            ## BYTE offsets (apply_edits splices bytes; shfmt Pos.Offset is a byte
            ## index), so a non-ASCII char earlier in the file cannot shift the
            ## insertion into the wrong line.
            line_start = data.rfind(b"\n", 0, call["Pos"]["Offset"]) + 1
            if line_start in disabled_lines:
                continue
            line_end = data.find(b"\n", line_start)
            line = data[line_start:(line_end if line_end != -1 else len(data))] \
                .decode("utf-8", "replace")
            prev_start = data.rfind(b"\n", 0, line_start - 1) + 1 \
                if line_start > 0 else 0
            prev_line = data[prev_start:max(line_start - 1, 0)] \
                .decode("utf-8", "replace").rstrip("\r")
            if SC2174_DISABLE.search(line) or SC2174_DISABLE.search(prev_line):
                continue
            ## A line continues onto the mkdir only on an ODD run of trailing
            ## backslashes; inserting a comment there would break the
            ## continuation. The trailing CR (CRLF) is stripped above, else it
            ## would hide the backslash and detach the continued line.
            trailing = len(prev_line) - len(prev_line.rstrip("\\"))
            if trailing % 2 == 1:
                continue
            indent = line[:len(line) - len(line.lstrip())]
            edits.append(
                (line_start, line_start, indent + SC2174_DIRECTIVE + "\n"))
            disabled_lines.add(line_start)
            count += 1
    return edits, count


def grep_edits(text, tree):
    """Edits for R-161: expand each grep short cluster carrying 'q' to its long
    spelling. Per COMMAND via the AST; a grep with an arg-taking option is left
    for the gate (a following '-q'-shaped token could be that option's value)."""
    edits = []
    count = 0
    for call in bash_ast.call_exprs(tree):
        if bash_ast.command_name(call) != "grep":
            continue
        options, _ = _grep_option_words(call)
        if _grep_has_arg_taker(options):
            continue
        for word, lit in options:
            cluster = lit[1:]
            if "q" not in cluster:
                continue
            if not all(char in GREP_LONG for char in cluster):
                continue
            start, end = bash_ast.word_span(word)
            edits.append(
                (start, end,
                 " ".join(GREP_LONG[char] for char in cluster)))
            count += 1
    return edits, count


def timeout_edits(text, tree):
    """Edits for R-200: insert '--kill-after=<DURATION>' into a bare
    'timeout <DURATION> cmd'. Declines the whole file if it defines its own
    timeout() (a call targets that function, not coreutils)."""
    if bash_ast.defines_function(tree, "timeout"):
        return [], 0
    edits = []
    count = 0
    for call in bash_ast.call_exprs(tree):
        if bash_ast.command_name(call) != "timeout":
            continue
        call_args = bash_ast.args(call)
        if len(call_args) < 3:
            ## Need a duration and at least one wrapped command word.
            continue
        duration = bash_ast.word_lit(call_args[1])
        if not duration or not TIMEOUT_DURATION.match(duration):
            continue
        start, _ = bash_ast.word_span(call_args[1])
        edits.append((start, start, "--kill-after=%s " % duration))
        count += 1
    return edits, count


def structural_fixes(text):
    """Apply the AST-backed structural rewriters (R-172, R-161, R-200) to TEXT
    and return (new_text, {rule: count}). Parses TEXT ONCE. Raises ShfmtMissing
    if shfmt is absent (a required tool -- never a silent skip). A parse failure
    means the caller DECLINES structural fixes (returns TEXT unchanged, empty
    counts) -- the gate reports it and 'bash -n' catches the syntax error."""
    try:
        tree = bash_ast.parse_normalized(text)
    except bash_ast.BashParseError:
        return text, {}
    edits = []
    changes = {}
    if not MKDIR_WAIVER_RE.search(text):
        rule_edits, num = mkdir_edits(text, tree)
        if num:
            edits.extend(rule_edits)
            changes["R-172"] = num
    rule_edits, num = grep_edits(text, tree)
    if num:
        edits.extend(rule_edits)
        changes["R-161"] = num
    if not TIMEOUT_WAIVER_RE.search(text):
        rule_edits, num = timeout_edits(text, tree)
        if num:
            edits.extend(rule_edits)
            changes["R-200"] = num
    return bash_ast.apply_edits(text, edits), changes


def fix_file(path, check):
    """Return a dict of change counts for PATH; write in place unless CHECK.

    None -> skipped (not a regular file, symlink, data file, undecodable, or
    unwritable). Empty dict -> examined, already clean. Raises ShfmtMissing when
    a shell file must be parsed but shfmt is absent."""
    if not os.path.isfile(path) or os.path.islink(path):
        return None
    if is_data_file(path):
        return None
    try:
        with open(path, "rb") as handle:
            raw = handle.read()
    except OSError:
        return None
    ## A file we cannot decode as UTF-8 is not one we can safely rewrite:
    ## leave it for the gate to report rather than risk mangling bytes.
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        return None

    original = text
    changes = {}

    ## Structural rewriters FIRST, on the original text, so the node byte offsets
    ## from the parse stay valid (the text transforms below shift offsets).
    if is_shell_file(path):
        text, structural_changes = structural_fixes(text)
        changes.update(structural_changes)

    ## R-001: always-safe confusables (unless the file carries the waiver);
    ## quote-like substitutions and entities only in prose/markup files.
    if not has_non_ascii_waiver(text):
        text, num = substitute(text, CONFUSABLES)
        if num:
            changes["R-001"] = num
        if path.lower().endswith(MARKUP_EXTS):
            text, num_q = substitute(text, QUOTES)
            text, num_e = substitute(text, ENTITIES)
            if num_q + num_e:
                changes["R-001-markup"] = num_q + num_e

    ## Trailing whitespace: same file scope as the gate (is_text_file).
    if is_text_file(path):
        text, num = strip_trailing_whitespace(text)
        if num:
            changes["trailing-whitespace"] = num

    if text == original:
        return {}
    if not check:
        try:
            with open(path, "wb") as handle:
                handle.write(text.encode("utf-8"))
        except OSError:
            ## Readable but not writable: leave it for the gate to report rather
            ## than crash the whole fix-then-verify pass on one file.
            return None
    return changes


def staged_files():
    """Absolute paths of staged text files. Raises StagedDiscoveryError on a git
    failure so the caller can exit non-zero rather than mistake a broken git
    invocation for 'nothing staged' (a false green). Filenames are decoded with
    surrogateescape, since git permits bytes invalid in the locale encoding."""
    try:
        names = subprocess.run(
            ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMRT",
             "-z"],
            capture_output=True, check=True,
        ).stdout
        top = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, check=True,
        ).stdout
    except (OSError, subprocess.CalledProcessError) as exc:
        raise StagedDiscoveryError(str(exc)) from exc
    root = os.fsdecode(top.strip())
    return [
        os.path.join(root, os.fsdecode(name))
        for name in names.split(b"\0") if name
    ]


def main():
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--check", action="store_true",
                        help="report only; exit 1 if changes are needed")
    parser.add_argument("--staged", action="store_true",
                        help="operate on the repo's staged text files")
    parser.add_argument("files", nargs="*")
    args = parser.parse_args()

    ## A directory arg is walked recursively; a missing path is a loud error, not
    ## a silent skip (the false-green a bare directory used to produce).
    try:
        targets = list(bash_ast.walk_files(args.files))
    except FileNotFoundError as exc:
        print("pre-push-fix: no such path: %s" % exc, file=sys.stderr)
        return 2
    if args.staged:
        try:
            targets.extend(staged_files())
        except StagedDiscoveryError as exc:
            print("pre-push-fix: could not list staged files: %s" % exc,
                  file=sys.stderr)
            return 2
    if not targets:
        return 0

    any_changed = False
    for path in targets:
        try:
            changes = fix_file(path, args.check)
        except bash_ast.ShfmtMissing as exc:
            print("pre-push-fix: shfmt is required to parse shell files "
                  "but is unavailable: %s" % exc, file=sys.stderr)
            return 2
        if changes:
            any_changed = True
            summary = ", ".join(
                "%s x%d" % (rule, num) for rule, num in changes.items())
            verb = "would fix" if args.check else "fixed"
            print("pre-push-fix: %s %s: %s" % (verb, path, summary),
                  file=sys.stderr)

    if args.check and any_changed:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
