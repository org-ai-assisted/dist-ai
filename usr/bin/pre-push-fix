#!/usr/bin/python3

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

"""Deterministic style AUTO-FIXER -- the write-side twin of pre-push-static.

pre-push-static DETECTS violations; the model then spends a turn CORRECTING
them. This tool removes that round trip for the MECHANICAL, provably
structure-preserving rules: it rewrites the fixable violations in place, so the
gate that follows passes silently and the model never sees them.

Bucket-1 transforms only (see the plan):
  * R-001  -- substitute the KNOWN confusable set to its intended ASCII form.
              The always-safe set (em/en dash, ellipsis, arrows, nbsp, bullet)
              maps to characters that are never quote/syntax, so it applies to
              every file. SMART QUOTES map to ASCII quote characters, which ARE
              shell/python syntax -- a smart apostrophe inside a single-quoted
              string would become a real quote and break it -- so they are
              substituted ONLY in prose/markup files (with the HTML-entity
              spellings); in code they stay a reported R-001 for a human.
  * trailing-whitespace -- strip blanks before end-of-line.
  * R-172  -- upgrade a temp-dir mkdir's short '-m 700' / '-m700' to the long
              '--mode=700' (shell files only), and insert a
              '# shellcheck disable=SC2174' above the atomic '--parents
              ... --mode' form (which SC2174 flags by design) so the mandated
              form stays shellcheck-clean. The missing-mode and 'chmod'-split
              forms are NOT fixed here -- a mode value cannot be guessed and a
              re-merge is multi-line, so pre-push-static FAILS those.
  * R-161  -- expand a grep SHORT quiet cluster ('-iq' -> '--ignore-case
              --quiet') to its long-option form (shell files only). The PIPE
              half of R-161 (a quiet grep consuming a pipe) is NOT fixed here --
              relocating a redirect / switching to a here-string is multi-token,
              so pre-push-static FAILS it.

HARD SAFETY LINE: only the known table is touched. Any OTHER non-ASCII byte is
left exactly as-is for pre-push-static to report (bucket-2) -- so an intentional
UTF-8 test fixture is never silently rewritten.

Exemptions are kept in lockstep with pre-push-static (a .gitattributes binary
data file, the per-file '## style-ok: allow-non-ascii' waiver matched by the
gate's own grammar, symlinks, non-regular files, and the is_text_file set for
whitespace). test_pre_push_fix.sh pins that parity so detector and fixer cannot
drift.

Idempotent: a second run over its own output changes nothing.

Usage:
  pre-push-fix [--check] FILE...     fix (or, with --check, only report) FILEs
  pre-push-fix [--check] --staged    fix the repo's staged text files

Exit: 0 success; in --check mode 1 means "changes are needed"; 2 usage/error.
"""

import argparse
import os
import re
import subprocess
import sys

## Always-safe confusables: the ASCII form is never a quote or other
## syntactically significant character, so substituting cannot change code
## STRUCTURE -- only string CONTENT, which the ASCII policy mandates anyway.
## Keys are \u escapes so THIS source stays ASCII (it must pass its own R-001).
CONFUSABLES = {
    "\u2014": "--",   ## em dash
    "\u2013": "-",    ## en dash
    "\u2026": "...",  ## horizontal ellipsis
    "\u2192": "->",   ## rightwards arrow
    "\u2190": "<-",   ## leftwards arrow
    "\u00a0": " ",    ## no-break space
    "\u2022": "-",    ## bullet
}

## Smart quotes -> ASCII quote characters. These ARE syntax in code, so applied
## MARKUP-ONLY (see the module docstring).
QUOTES = {
    "\u2018": "'",    ## left single quote
    "\u2019": "'",    ## right single quote / apostrophe
    "\u201c": '"',    ## left double quote
    "\u201d": '"',    ## right double quote
}

## HTML-entity spellings that RENDER as an em/en dash. Markup-only, like QUOTES
## (an entity in a shell script is literal text). Mirrors emdash-check.py's set.
ENTITIES = {
    "&mdash;": "--",
    "&ndash;": "-",
    "&#8212;": "--",
    "&#8211;": "-",
    "&#x2014;": "--",
    "&#x2013;": "-",
    "&#X2014;": "--",
    "&#X2013;": "-",
}

MARKUP_EXTS = (".html", ".htm", ".md", ".markdown", ".css", ".txt", ".rst")

## is_text_file's extension set, mirrored from pre-push-static so the
## trailing-whitespace transform covers exactly the same files. The gate falls
## back to file(1) --mime for extensionless files; so do we, below.
TEXT_EXTS = (
    ".md", ".sh", ".bsh", ".bash", ".py", ".yml", ".yaml", ".json", ".toml",
    ".xml", ".txt", ".csv", ".cfg", ".conf", ".ini", ".rst", ".html", ".css",
    ".js", ".ts", ".c", ".h", ".cpp", ".hpp", ".go", ".rs", ".tex",
    ".dockerfile",
)
TEXT_BASENAMES = ("Dockerfile", "Makefile", "COPYING", "README", "LICENSE")

## The gate's R-001 waiver grammar, mirrored EXACTLY so the fixer's exemption
## stays in lockstep: '## style-ok: allow-non-ascii' with any (or no) horizontal
## whitespace around the tokens, terminated by whitespace or end-of-line.
WAIVER_RE = re.compile(
    r'^[ \t]*##[ \t]*style-ok:[ \t]*allow-non-ascii(?:[ \t]|$)', re.MULTILINE)

## R-172 (temp-dir mkdir mode) -- the write side of pre-push-static's rule.
## A 'mkdir' whose operand is a TMPDIR/TMP/TEMP/TEMPDIR variable is the
## security-relevant surface; only there is the short '-m' upgraded to the long
## '--mode='. The missing-mode / 'chmod'-split forms are NOT rewritten here (a
## multi-line structure change is out of the bucket-1 remit) -- they stay a gate
## FAIL for a human to correct.
##
## MKDIR_TMP_LINE is only a cheap PRE-FILTER (is a temp mkdir plausibly on this
## line -- command position includes a leading backtick command substitution).
## The real work is per-COMMAND: MKDIR_SPAN isolates each 'mkdir ...' command up
## to the next separator (';' '&&' '||' '|' '&') or '#' comment, so a second
## command sharing the line ('mkdir ... && install -m 755 x') is never
## rewritten. TMPVAR (name bounded by a non-word char, so '$TMPFILE' and
## '$TMPDIR_SUFFIX' are NOT it) says a span creates a temp dir. OPT_END marks
## where the mkdir OPTIONS stop -- a standalone '--' end-of-options token or the
## first quote -- so an '-m' inside a quoted path or after '--' (a literal
## directory name, not a flag) is never rewritten.
MKDIR_TMP_LINE = re.compile(
    r'(^|[\s(;&|`])mkdir\s.*\$\{?(TMPDIR|TEMPDIR|TEMP|TMP)([^A-Za-z0-9_]|$)')
MKDIR_SPAN = re.compile(r'mkdir\b[^;&|#]*')
TMPVAR = re.compile(r'\$\{?(?:TMPDIR|TEMPDIR|TEMP|TMP)(?:[^A-Za-z0-9_]|$)')
OPT_END = re.compile(r'(?<=\s)--(?=\s|$)|["\']')
## Standalone short '-m' with a numeric mode ('-m 700' or '-m700'); the
## lookbehind rules out the '-m' inside '--mode' and a bundled '-pm700' (whose
## 'm' is preceded by a letter, not the leading '-'), both left untouched so
## the rewrite is provably structure-preserving and idempotent.
SHORT_MODE = re.compile(r'(?<![\w-])-m[ \t]*([0-7]{3,4})\b')

## The atomic idempotent form 'mkdir --parents ... --mode=' trips shellcheck
## SC2174 (with -p, -m applies only to the deepest dir) -- which is the intent
## for a temp dir whose parents pre-exist. Insert the disable so R-172's own
## mandated form stays shellcheck-clean, rather than trade one gate failure for
## another. PARENTS matches '--parents' or a short cluster carrying 'p' ('-p',
## '-pv'); LONG_MODE the post-upgrade '--mode'; DISABLE an existing SC2174
## waiver (so a second run is a no-op).
PARENTS = re.compile(r'(?:^|\s)(?:--parents\b|-[A-Za-z]*p[A-Za-z]*)(?:\s|$)')
LONG_MODE = re.compile(r'--mode(=|[ \t])')
SC2174_DISABLE = re.compile(
    r'#[ \t]*shellcheck[ \t]+disable=[A-Z0-9, ]*SC2174(?![0-9])')
SC2174_DIRECTIVE = "# shellcheck disable=SC2174"
## Script-wide waiver, in lockstep with pre-push-static's R-172: a file
## carrying it opts out of the whole rule, so the fixer must not rewrite it
## either (otherwise the fixer forces a change the gate would have exempted).
MKDIR_WAIVER_RE = re.compile(
    r'^[ \t]*##[ \t]*style-ok:[ \t]*allow-mkdir-no-mode(?:[ \t]|$)',
    re.MULTILINE)

SHELL_EXTS = (".sh", ".bsh")
SHELL_SHEBANG_RE = re.compile(r'#!.*(/|\s)(bash|sh|dash)(\s|$)')

## R-161 (grep short quiet flag) -- the write side of pre-push-static's
## short-quiet ban. A bundled short cluster carrying 'q' ('-q','-iq','-Fq') is
## expanded to its long-option spelling ('--quiet', '--ignore-case --quiet',
## '--fixed-strings --quiet'). Only NO-ARG grep short options are mappable;
## GREP_LONG is that table. The PIPE half of R-161 (a quiet grep consuming a
## pipe) is NOT rewritten here -- relocating a redirect / switching to a
## here-string is a multi-token structural change, so the gate FAILS it for a
## human, exactly like R-172's missing-mode mkdir.
GREP_LONG = {
    "i": "--ignore-case", "q": "--quiet", "v": "--invert-match",
    "n": "--line-number", "c": "--count", "l": "--files-with-matches",
    "L": "--files-without-match", "w": "--word-regexp", "x": "--line-regexp",
    "E": "--extended-regexp", "F": "--fixed-strings", "G": "--basic-regexp",
    "P": "--perl-regexp", "o": "--only-matching", "s": "--no-messages",
    "h": "--no-filename", "H": "--with-filename", "r": "--recursive",
    "R": "--dereference-recursive", "a": "--text", "z": "--null-data",
    "Z": "--null", "b": "--byte-offset",
}
## Each 'grep ...' command isolated up to the next separator / '#' comment, so a
## second command sharing the line is never rewritten (mirrors MKDIR_SPAN).
GREP_SPAN = re.compile(r'grep\b[^;&|#]*')
## 'grep' must be in COMMAND position for a rewrite -- checked against the text
## BEFORE the match. Valid: line start, right after a separator ';&|(){}`', or
## after a control keyword, each with an optional '!' negation and any run of
## leading VAR=value assignments ('LC_ALL=C grep ...'). 'in' is NOT a command
## introducer -- it heads a word list ('for x in grep ...'), so it is excluded.
## This is stricter than the gate's REPORT-side match on purpose: the fixer
## WRITES, so it only touches the unambiguously-safe subset.
GREP_CMD_POS = re.compile(
    r'(?:^\s*|[;&|(){}`]\s*'
    r'|(?:^|[^\w])(?:then|do|else|if|elif|while|until)\s+)'
    r'(?:!\s+)?'
    r'(?:[A-Za-z_]\w*=\S*\s+)*$')
## Any quote, backslash or '#' in the text BEFORE grep means the line carries
## quoting / escaping / comment structure a single regex cannot resolve
## (backslash escapes in "..." but is literal in '...'; '#' may or may not open a
## comment). Rather than parse shell, the fixer BAILS on such a line -- grep
## might be string data or a comment -- and leaves it for the gate to REPORT.
GREP_UNSAFE_PREFIX = re.compile(r'''["'\\#]''')
## A single-dash short cluster containing 'q' -- the candidate to expand. The
## lookbehind rules out '--quiet' (preceded by '-') and a bundled value; the
## lookahead pins the token to a whole word so a quoted pattern is untouched.
GREP_SHORT_Q = re.compile(r'(?<![\w-])-[A-Za-z]*q[A-Za-z]*(?![\w-])')
## An ARG-TAKING grep option anywhere in the option region makes a following
## '-iq'-shaped run ambiguous (it could be that option's VALUE), so the whole
## grep span is left for the gate rather than risk a wrong rewrite. Short
## arg-takers end a cluster in one of 'efmABCdD'; the long arg-takers are named.
GREP_ARG_TAKING = re.compile(
    r'(?<![\w-])-[A-Za-z]*[efmABCdD](?![\w-])'
    r'|(?<![\w-])--(?:regexp|file|max-count|after-context|before-context'
    r'|context|colou?r|binary-files|devices|directories|label'
    r'|group-separator|exclude(?:-dir|-from)?|include)(?:=|\b)')


class StagedDiscoveryError(Exception):
    """git could not enumerate the staged set -- distinct from 'nothing staged'."""


def have(name):
    return any(
        os.access(os.path.join(directory, name), os.X_OK)
        for directory in os.environ.get("PATH", "").split(os.pathsep)
        if directory
    )


def is_data_file(path):
    """True when .gitattributes marks PATH binary -- exempt, same as the gate."""
    try:
        out = subprocess.run(
            ["git", "check-attr", "--cached", "binary", "--", path],
            capture_output=True, text=True,
        )
    except OSError:
        return False
    return (
        out.returncode == 0
        and out.stdout.rstrip("\n").endswith(": binary: set")
    )


def is_text_file(path):
    """Mirror pre-push-static's is_text_file: extension set, else file --mime."""
    if is_data_file(path):
        return False
    base = os.path.basename(path)
    if base in TEXT_BASENAMES or path.endswith(TEXT_EXTS):
        return True
    if not have("file"):
        return False
    try:
        mime = subprocess.run(
            ["file", "--brief", "--mime", "--dereference", "--", path],
            capture_output=True, text=True,
        ).stdout
    except OSError:
        return False
    needles = ("text/", "x-shellscript", "x-python", "json", "xml", "yaml",
               "toml", "charset=us-ascii", "charset=utf-8")
    return any(needle in mime for needle in needles)


def has_non_ascii_waiver(text):
    return bool(WAIVER_RE.search(text))


def substitute(text, table):
    count = 0
    for char, repl in table.items():
        found = text.count(char)
        if found:
            text = text.replace(char, repl)
            count += found
    return text, count


def strip_trailing_whitespace(text):
    """Strip trailing space/tab before end-of-line; preserve CR and the
    presence/absence of a final newline."""
    count = 0
    out = []
    ## keepends so CRLF vs LF and a final no-newline line are preserved.
    for line in text.splitlines(keepends=True):
        newline = ""
        body = line
        if body.endswith("\r\n"):
            newline = "\r\n"
            body = body[:-2]
        elif body.endswith("\n"):
            newline = "\n"
            body = body[:-1]
        elif body.endswith("\r"):
            newline = "\r"
            body = body[:-1]
        stripped = body.rstrip(" \t")
        if stripped != body:
            count += 1
        out.append(stripped + newline)
    return "".join(out), count


def is_shell_file(path):
    """True for a shell script: a .sh/.bsh extension, or a bash/sh/dash
    shebang. Mirrors pre-push-static's is_shell_file so the R-172 transform
    touches exactly the file set the gate checks that rule against -- the
    style-guide markdown that cites the pattern is never rewritten."""
    if path.endswith(SHELL_EXTS):
        return True
    try:
        with open(path, "rb") as handle:
            first = handle.readline()
    except OSError:
        return False
    return bool(SHELL_SHEBANG_RE.match(
        first.decode("utf-8", "replace").rstrip("\r\n")))


def upgrade_mkdir_mode(text):
    """Per temp-dir mkdir COMMAND (not per line):
      1. upgrade a short '-m <mode>' to the long '--mode=<mode>' within THAT
         command's span, so a second command on the same line is untouched;
      2. if a temp-dir mkdir span is the atomic idempotent form
         '--parents ... --mode', insert a '# shellcheck disable=SC2174' above
         the line -- unless one already precedes it -- so R-172's mandated form
         does not fail shellcheck.
    Idempotent: the long form never re-matches, and the disable is inserted
    only when absent."""
    count = 0
    out = []
    for line in text.splitlines(keepends=True):
        if line.lstrip().startswith("#") or not MKDIR_TMP_LINE.search(line):
            out.append(line)
            continue
        ## Rebuild the line span by span; only a temp-dir mkdir command's own
        ## OPTION text is ever rewritten.
        pieces = []
        pos = 0
        needs_disable = False
        for match in MKDIR_SPAN.finditer(line):
            span = match.group(0)
            if not TMPVAR.search(span):
                continue
            ## Confine the rewrite to the option region (before '--' / the first
            ## quote): an '-m 700' inside a quoted path or after '--' is a
            ## literal directory name, never a flag.
            stop = OPT_END.search(span)
            cut = stop.start() if stop else len(span)
            newopts, num = SHORT_MODE.subn(r"--mode=\1", span[:cut])
            newspan = newopts + span[cut:]
            if newspan != span:
                count += num
                pieces.append(line[pos:match.start()])
                pieces.append(newspan)
                pos = match.end()
            if PARENTS.search(newopts) and LONG_MODE.search(newopts):
                needs_disable = True
        pieces.append(line[pos:])
        new = "".join(pieces)
        ## Insert the disable ONLY when safe: never between a '\'-continued line
        ## and its continuation (a comment there breaks the continuation), and
        ## not when a disable already covers the line. A line continues only on
        ## an ODD run of trailing backslashes ('echo \\' is an escaped
        ## backslash, not a continuation).
        prev_bs = 0
        if out:
            prev_bs = len(out[-1].rstrip("\r\n")) \
                - len(out[-1].rstrip("\r\n").rstrip("\\"))
        prev_continues = prev_bs % 2 == 1
        if (needs_disable and not prev_continues
                and not SC2174_DISABLE.search(new)
                and not (out and SC2174_DISABLE.search(out[-1]))):
            indent = new[:len(new) - len(new.lstrip())]
            newline = "\r\n" if new.endswith("\r\n") else "\n"
            out.append(indent + SC2174_DIRECTIVE + newline)
            count += 1
        out.append(new)
    return "".join(out), count


def expand_grep_short_quiet(text):
    """Per grep COMMAND (not per line): expand a short cluster carrying 'q'
    ('-iq' -> '--ignore-case --quiet') to its long-option spelling. Confined to
    the OPTION region (before the first quote or '--'), only when grep is in
    command position (GREP_CMD_POS) and the region carries no arg-taking grep
    option (GREP_ARG_TAKING) -- otherwise a '-iq'-shaped run could be another
    option's value. A token with a letter outside GREP_LONG is left as-is.
    Idempotent: a long option never re-matches GREP_SHORT_Q."""
    count = 0
    out = []
    for line in text.splitlines(keepends=True):
        if "grep" not in line:
            out.append(line)
            continue
        pieces = []
        pos = 0
        for match in GREP_SPAN.finditer(line):
            ## Safety FIRST (the HARD SAFETY LINE): only rewrite a grep in an
            ## UNAMBIGUOUS command position. A quote / backslash / '#' anywhere
            ## before grep means the line has quoting or comment structure a
            ## regex cannot safely resolve, so bail -- grep may be string data or
            ## a comment. The gate still REPORTS the violation.
            prefix = line[:match.start()]
            if GREP_UNSAFE_PREFIX.search(prefix):
                continue
            if not GREP_CMD_POS.search(prefix):
                continue
            span = match.group(0)
            stop = OPT_END.search(span)
            cut = stop.start() if stop else len(span)
            optregion = span[:cut]
            if GREP_ARG_TAKING.search(optregion):
                continue
            rebuilt = []
            last = 0
            local = 0
            for tok in GREP_SHORT_Q.finditer(optregion):
                letters = tok.group(0)[1:]
                if not all(char in GREP_LONG for char in letters):
                    continue
                rebuilt.append(optregion[last:tok.start()])
                rebuilt.append(" ".join(GREP_LONG[char] for char in letters))
                last = tok.end()
                local += 1
            if local:
                newspan = "".join(rebuilt) + optregion[last:] + span[cut:]
                pieces.append(line[pos:match.start()])
                pieces.append(newspan)
                pos = match.end()
                count += local
        pieces.append(line[pos:])
        out.append("".join(pieces))
    return "".join(out), count


def fix_file(path, check):
    """Return a dict of change counts for PATH; write in place unless CHECK.

    None -> skipped (not a regular file, symlink, data file, undecodable, or
    unwritable). Empty dict -> examined, already clean."""
    if not os.path.isfile(path) or os.path.islink(path):
        return None
    if is_data_file(path):
        return None
    try:
        with open(path, "rb") as handle:
            raw = handle.read()
    except OSError:
        return None
    ## A file we cannot decode as UTF-8 is not one we can safely rewrite:
    ## leave it for the gate to report rather than risk mangling bytes.
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        return None

    original = text
    changes = {}

    ## R-001: always-safe confusables (unless the file carries the waiver);
    ## quote-like substitutions and entities only in prose/markup files.
    if not has_non_ascii_waiver(text):
        text, num = substitute(text, CONFUSABLES)
        if num:
            changes["R-001"] = num
        if path.lower().endswith(MARKUP_EXTS):
            text, num_q = substitute(text, QUOTES)
            text, num_e = substitute(text, ENTITIES)
            if num_q + num_e:
                changes["R-001-markup"] = num_q + num_e

    ## Trailing whitespace: same file scope as the gate (is_text_file).
    if is_text_file(path):
        text, num = strip_trailing_whitespace(text)
        if num:
            changes["trailing-whitespace"] = num

    ## R-172: upgrade a temp-dir mkdir's short '-m' to the long '--mode='
    ## (shell files only, and not when the file waives the rule -- lockstep with
    ## the gate). The missing-mode / chmod-split forms are not rewritten -- the
    ## gate FAILS those for a human to fix atomically.
    if is_shell_file(path) and not MKDIR_WAIVER_RE.search(text):
        text, num = upgrade_mkdir_mode(text)
        if num:
            changes["R-172"] = num

    ## R-161: expand a grep short quiet cluster ('-iq') to its long form. Shell
    ## files only, mirroring the gate's shell scope. The pipe half of R-161 is
    ## left for the gate (a redirect/here-string move is not a single-token
    ## edit).
    if is_shell_file(path):
        text, num = expand_grep_short_quiet(text)
        if num:
            changes["R-161"] = num

    if text == original:
        return {}
    if not check:
        try:
            with open(path, "wb") as handle:
                handle.write(text.encode("utf-8"))
        except OSError:
            ## Readable but not writable: leave it for the gate to report rather
            ## than crash the whole fix-then-verify pass on one file.
            return None
    return changes


def staged_files():
    """Absolute paths of staged text files. Raises StagedDiscoveryError on a git
    failure so the caller can exit non-zero rather than mistake a broken git
    invocation for 'nothing staged' (a false green). Filenames are decoded with
    surrogateescape, since git permits bytes invalid in the locale encoding."""
    try:
        names = subprocess.run(
            ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMRT",
             "-z"],
            capture_output=True, check=True,
        ).stdout
        top = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, check=True,
        ).stdout
    except (OSError, subprocess.CalledProcessError) as exc:
        raise StagedDiscoveryError(str(exc)) from exc
    root = os.fsdecode(top.strip())
    return [
        os.path.join(root, os.fsdecode(name))
        for name in names.split(b"\0") if name
    ]


def main():
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--check", action="store_true",
                        help="report only; exit 1 if changes are needed")
    parser.add_argument("--staged", action="store_true",
                        help="operate on the repo's staged text files")
    parser.add_argument("files", nargs="*")
    args = parser.parse_args()

    targets = list(args.files)
    if args.staged:
        try:
            targets.extend(staged_files())
        except StagedDiscoveryError as exc:
            print("pre-push-fix: could not list staged files: %s" % exc,
                  file=sys.stderr)
            return 2
    if not targets:
        return 0

    any_changed = False
    for path in targets:
        changes = fix_file(path, args.check)
        if changes:
            any_changed = True
            summary = ", ".join(
                "%s x%d" % (rule, num) for rule, num in changes.items())
            verb = "would fix" if args.check else "fixed"
            print("pre-push-fix: %s %s: %s" % (verb, path, summary),
                  file=sys.stderr)

    if args.check and any_changed:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
