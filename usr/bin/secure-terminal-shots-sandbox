#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Forget-proof host-side driver for the secure-terminal comparison shots. The in-sandbox
## runner (secure-terminal-shots) captures against WHATEVER trees are present; if the operator
## forgets to sync a fresh secure-terminal / dist-ai / terminal-poc-corpus into temp-claude,
## it silently shoots a STALE install -- confidently-wrong screenshots (the shot analogue of
## the PYTHONPATH stale-install trap). This driver removes that step from memory: it ALWAYS
## fresh-syncs all three trees into the sandbox, runs the real lane there, and pulls the shots
## back into the site. No stale copy is ever reused; a missing tree or a failed sync HARD-FAILS.
##
## Usage: secure-terminal-shots-sandbox [refresh|comparison|compat|zoom-live|tooltip] [ARGS...]
##   (these are the lanes this driver pulls back -- the clipboard lane writes a TSV and is run
##   directly in the sandbox). `refresh` regenerates EVERY site gallery in one command: the
##   offscreen lanes on the host (review/modes/compat) THEN the comparison lane AND the tooltip
##   lane in the sandbox, so none is ever missed. compat regenerates the compatibility-page program
##   shots (offscreen, deterministic) and pulls them into the site's compatibility/shots/. tooltip
##   regenerates the InfoTip risk-tooltip shot (native-Wayland, tooltip-capture.sh) into the site's
##   shots/tooltip.webp. ARGS
##   pass through: for comparison e.g. --only NAME
##   / --case C / --st-only; for zoom-live the zoom-level list (default 50 75 100 125 150 175 200).
##   zoom-live is the REAL-GUI white-band/scrollbar diagnostic (one ST launch under labwc, zoom
##   stepped live via `ctl zoom`); it pulls PNGs into ZOOM_OUT_DIR (default
##   ~/secure-terminal-zoom-shots), NOT the site.
##
## Env overrides (all default to ~/private-sources/<name>):
##   SECURE_TERMINAL_REPO   the Qt app source (holds usr/lib/.../secure_terminal)
##   CORPUS_REPO            terminal-poc-corpus (payload source)
##   SECURE_TERMINAL_SITE   the site checkout (shots land in its comparison/shots/)
##   SANDBOX_TARGET         non-default sandbox qube (passed to `sandbox --target`)

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

die() {
   printf '%s\n' "secure-terminal-shots-sandbox: $*" >&2
   exit 1
}

pull_tmp=''
cleanup() {
   [ -n "${pull_tmp}" ] || return 0
   safe-rm --recursive --force -- "${pull_tmp}" 2>/dev/null || true
}
trap cleanup EXIT

lane='comparison'
refresh_all=0
if [ "$#" -ge 1 ]; then
   case "$1" in
      comparison|compat|zoom-live|tooltip)
         lane="$1"
         shift
         ;;
      refresh)
         ## Regenerate EVERY site gallery in ONE command: the deterministic offscreen lanes
         ## on the host (review/modes/compat, no display) THEN the comparison lane in the
         ## sandbox -- so no lane is ever missed. Handled as the comparison flow plus a
         ## host-side offscreen refresh (see below).
         lane='comparison'
         refresh_all=1
         shift
         ;;
      clipboard)
         die "this driver auto-syncs + pulls the 'comparison', 'compat' and 'zoom-live' shots only; 'clipboard' writes a .tsv, not shots. Run that lane directly in the sandbox."
         ;;
   esac
fi

## --assume-synced: skip the fresh tree sync when the sandbox already holds a matching
## checkout (verified below with `sandbox assert-synced`), so a repeat reshoot starts
## capturing at once instead of re-syncing the repos each run. Stripped from the args here
## so it never reaches the in-sandbox lane. Without it the trees are always freshly synced
## (the safe default). assert-synced refuses a dirty or stale local tree, so the fast path
## can never shoot a stale tree.
assume_synced=0
rest_args=()
for arg in "$@"; do
   if [ "${arg}" = '--assume-synced' ]; then
      assume_synced=1
   else
      rest_args+=("${arg}")
   fi
done
set -- "${rest_args[@]}"

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

## dist-ai is the tree THIS driver ships in: script is at dist-ai/usr/bin, so ../.. is the root.
dist_ai="$(readlink --canonicalize -- "${script_dir}/../..")"

secure_terminal="${SECURE_TERMINAL_REPO:-${HOME}/private-sources/secure-terminal}"
corpus="${CORPUS_REPO:-${HOME}/private-sources/terminal-poc-corpus}"
site="${SECURE_TERMINAL_SITE:-${HOME}/private-sources/secure-terminal.github.io}"

[ -d "${secure_terminal}/usr/lib/python3/dist-packages/secure_terminal" ] \
   || die "secure-terminal source not found at '${secure_terminal}' (set SECURE_TERMINAL_REPO)"
## compat builds its own fixture (no corpus); every other lane cats corpus payloads.
[ "${lane}" = 'compat' ] || [ -f "${corpus}/tools/reproduce.py" ] \
   || die "terminal-poc-corpus not found at '${corpus}' (set CORPUS_REPO)"
[ -f "${dist_ai}/usr/bin/secure-terminal-shots" ] \
   || die "dist-ai runner not found at '${dist_ai}/usr/bin/secure-terminal-shots'"
## The site is a pull target for comparison (comparison/shots) and compat
## (compatibility/shots); the zoom-live lane writes diagnostic PNGs to a local dir, so it
## needs no site checkout.
if [ "${lane}" = 'compat' ]; then
   [ -d "${site}/compatibility/shots" ] \
      || die "site compat shots dir not found at '${site}/compatibility/shots' (set SECURE_TERMINAL_SITE)"
elif [ "${lane}" = 'tooltip' ]; then
   [ -d "${site}/shots" ] \
      || die "site shots dir not found at '${site}/shots' (set SECURE_TERMINAL_SITE)"
elif [ "${lane}" != 'zoom-live' ]; then
   [ -d "${site}/comparison/shots" ] \
      || die "site shots dir not found at '${site}/comparison/shots' (set SECURE_TERMINAL_SITE)"
fi

## refresh: before the sandbox comparison flow, regenerate the deterministic OFFSCREEN site
## galleries on the host (review/modes -> shots/, compat -> compatibility/shots/) via the
## wrapper's own `refresh` -- so one `secure-terminal-shots-sandbox refresh` regenerates
## EVERY gallery and none is missed. Offscreen + deterministic, so it needs no sandbox; a
## failure here HARD-fails before any sandbox work.
if [ "${refresh_all}" = 1 ]; then
   [ -d "${site}/shots" ] && [ -d "${site}/compatibility/shots" ] \
      || die "refresh: site galleries not found under '${site}' (need shots/ and compatibility/shots/; set SECURE_TERMINAL_SITE)"
   printf '%s\n' "secure-terminal-shots-sandbox: refresh -- regenerating the offscreen site galleries on the host ..." >&2
   SECURE_TERMINAL_REPO="${secure_terminal}" "${dist_ai}/usr/bin/secure-terminal-shots" refresh "${site}" \
      || die "refresh: the offscreen lane (review/modes/compat) failed"
fi

## Transport check AFTER the tree checks so a missing tree is reported first and the preflight
## is testable without a sandbox: a bad SECURE_TERMINAL_REPO refuses here, never a stale capture.
type -P sandbox >/dev/null || die "the 'sandbox' driver is absent (private-ai-config); cannot reach temp-claude"

target_arg=()
[ -n "${SANDBOX_TARGET:-}" ] && target_arg=(--target "${SANDBOX_TARGET}")

## Preflight the capture stack in the sandbox. Without it (labwc / Xwayland / the
## window + screenshot + webp tools) the capture renders 0 shots and fails deep
## inside the lane with a cryptic message; check the load-bearing binaries up front
## and point at the one-shot provisioner instead. `sandbox exec` passes the remote
## exit code through, so a missing binary makes the loop exit 1 here.
## compat is a headless OFFSCREEN-Qt grab (no labwc / X / window tools), so it skips the
## heavy capture-stack preflight -- but it webp-optimizes, so it still needs optipng/jpegoptim/cwebp.
if [ "${lane}" != 'compat' ] \
   && ! sandbox "${target_arg[@]}" exec 'for b in labwc Xwayland wlr-randr grim wtype convert compare identify optipng jpegoptim cwebp; do type -P "$b" >/dev/null 2>&1 || exit 1; done'; then
   die "the comparison-shot capture stack (labwc/Xwayland/wlr-randr/grim/wtype/imagemagick/optipng/jpegoptim/cwebp) is missing or incomplete in the sandbox -- run:  sandbox provision shots"
fi
if [ "${lane}" = 'compat' ] \
   && ! sandbox "${target_arg[@]}" exec 'for b in optipng jpegoptim cwebp; do type -P "$b" >/dev/null 2>&1 || exit 1; done'; then
   die "compat webp optimization needs optipng/jpegoptim/cwebp in the sandbox -- run:  sandbox provision shots"
fi

base='st-shots-sandbox'

## compat builds its OWN fixture and reads no corpus payloads (see the presence
## check above), so it syncs two trees, not three -- skip the corpus sync for it.
if [ "${assume_synced}" = 1 ]; then
   printf '%s\n' "secure-terminal-shots-sandbox: --assume-synced: verifying the sandbox already matches (no re-sync) ..." >&2
   sandbox "${target_arg[@]}" assert-synced "${secure_terminal}" \
      || die "--assume-synced: secure-terminal not verifiably in sync (dirty/stale); re-run WITHOUT --assume-synced"
   sandbox "${target_arg[@]}" assert-synced "${dist_ai}" \
      || die "--assume-synced: dist-ai not verifiably in sync (dirty/stale); re-run WITHOUT --assume-synced"
   if [ "${lane}" != 'compat' ]; then
      sandbox "${target_arg[@]}" assert-synced "${corpus}" \
         || die "--assume-synced: terminal-poc-corpus not verifiably in sync (dirty/stale); re-run WITHOUT --assume-synced"
   fi
else
   if [ "${lane}" = 'compat' ]; then
      printf '%s\n' "secure-terminal-shots-sandbox: fresh-syncing two trees into the sandbox (compat needs no corpus) ..." >&2
   else
      printf '%s\n' "secure-terminal-shots-sandbox: fresh-syncing three trees into the sandbox ..." >&2
   fi
   sandbox "${target_arg[@]}" sync --delete "${secure_terminal}" "${base}/secure-terminal" \
      || die "sync of secure-terminal into the sandbox failed"
   sandbox "${target_arg[@]}" sync --delete "${dist_ai}" "${base}/dist-ai" \
      || die "sync of dist-ai into the sandbox failed"
   if [ "${lane}" != 'compat' ]; then
      sandbox "${target_arg[@]}" sync --delete "${corpus}" "${base}/terminal-poc-corpus" \
         || die "sync of terminal-poc-corpus into the sandbox failed"
   fi
fi

printf '%s\n' "secure-terminal-shots-sandbox: running '${lane}' in the sandbox ..." >&2
remote_shots="${base}/dist-ai/usr/share/secure-terminal-shots/shots"

## Honest, monotonic phase reporting. The old loop reprinted one "N shot(s)
## rendered" line every poll, which FABRICATES progress once the count freezes
## in the compress+pull tail -- masking a real wedge from byte-growth supervision
## and false-stalling distinct-content readers. phase-progress.sh prints a line
## only when the phase truly changes; see its header.
## style-ok: shellcheck-source -- sourced sibling resolved from this driver's own dist-ai tree.
# shellcheck source=../share/secure-terminal-shots/phase-progress.sh
source "${dist_ai}/usr/share/secure-terminal-shots/phase-progress.sh"

## Run the capture in the BACKGROUND and derive local phase from the sandbox shot count.
## `sandbox exec` buffers the qrexec stream, so the lane's own per-terminal output never reaches
## the caller until it exits -- a long silent run then false-stalls the durable-bg supervisor
## (which watches the progress file for growth). Polling the rendered-shot count is a REAL
## liveness signal that still exposes a genuine wedge (the count stops advancing, and -- unlike
## the old reprinting loop -- the progress file then stops growing too). Delegates to the synced
## sibling script, NOT an inline bash -lc.
## ${HOME} must expand on the REMOTE sandbox (its user home), not the host: the tree was
## synced to "${base}/dist-ai" relative to the sandbox's own $HOME, which differs from the
## host's when dom0/host and the target qube are different users. A host-expanded path fails
## to exist in the sandbox. Single-quote $HOME so the remote bash expands it (same pattern as
## the rendered-count probe below); ${base}/${lane}/"$@" ride as positional args.
sandbox "${target_arg[@]}" exec -- bash -c \
   '"${HOME}/'"${base}"'/dist-ai/usr/share/secure-terminal-shots/run-lane-in-sandbox.sh" "$@"' \
   bash "${base}" "${lane}" "$@" &
capture_pid=$!
pp_begin "${lane}"
while kill -0 "${capture_pid}" 2>/dev/null; do
   sleep 20
   rendered="$(sandbox "${target_arg[@]}" exec -- bash -c 'ls "$HOME/'"${remote_shots}"'"/*.png "$HOME/'"${remote_shots}"'"/*.webp 2>/dev/null | wc -l' 2>/dev/null || printf '?')"
   pp_capture_tick "${rendered}"
done
wait "${capture_pid}" || die "the in-sandbox '${lane}' run failed"
pp_pull_begin

## Pull the freshly captured shots back.
pull_tmp="$(mktemp --directory)"

if [ "${lane}" = 'zoom-live' ]; then
   ## The zoom-live lane is a DIAGNOSTIC: it writes real-GUI per-level PNGs, not site webp. Pull
   ## them into a local diagnostic dir (override with ZOOM_OUT_DIR) and print the path -- never
   ## into the site, which references none of them. zoom-live's shots are prefixed zoom-live-<pct>.
   zoom_out="${ZOOM_OUT_DIR:-${HOME}/secure-terminal-zoom-shots}"
   mkdir --parents -- "${zoom_out}"
   sandbox "${target_arg[@]}" pull "${remote_shots}" "${pull_tmp}/" \
      || die "pull of the captured zoom shots out of the sandbox failed"
   shopt -s nullglob
   pngs=("${pull_tmp}/shots/"*.png)
   [ "${#pngs[@]}" -gt 0 ] || die "no zoom PNGs were produced in the sandbox (capture failed silently?)"
   cp --force -- "${pngs[@]}" "${zoom_out}/"
   pp_done "pulled ${#pngs[@]} zoom PNG(s) into ${zoom_out}/"
   exit 0
fi

## The comparison + compat lanes write webp into secure-terminal-shots/shots/; copy only the
## webp into the site (never the .png/.log noise). comparison lands in comparison/shots, compat
## in compatibility/shots.
if [ "${lane}" = 'compat' ]; then
   site_dest="${site}/compatibility/shots"
elif [ "${lane}" = 'tooltip' ]; then
   site_dest="${site}/shots"
else
   site_dest="${site}/comparison/shots"
fi
printf '%s\n' "secure-terminal-shots-sandbox: pulling shots back into ${site_dest}/ ..." >&2
sandbox "${target_arg[@]}" pull "${remote_shots}" "${pull_tmp}/" \
   || die "pull of the captured shots out of the sandbox failed"

shopt -s nullglob
webp=("${pull_tmp}/shots/"*.webp)
[ "${#webp[@]}" -gt 0 ] || die "no .webp shots were produced in the sandbox (capture failed silently?)"
cp --force -- "${webp[@]}" "${site_dest}/"

## Re-pin every on-page <img> width/height to the freshly pulled assets' intrinsic size. A
## capture that changed a shot's dimensions otherwise leaves a stale, layout-shifting pin that
## only secure-terminal-shots-dims catches at gate time -- so re-pin here, at the pull, and the
## drift cannot arise. Bundled dist-ai sibling; an absent one is a broken checkout (fail loud).
dims_tool="${script_dir}/secure-terminal-shots-dims"
[ -x "${dims_tool}" ] || die "required sibling ${dims_tool} not found (broken checkout); cannot re-pin on-page <img> dimensions"
"${dims_tool}" --fix "${site}" || die "re-pinning on-page <img> dimensions to the pulled assets failed"

pp_done "pulled ${#webp[@]} shot(s) into ${site_dest}/ (on-page dimensions re-pinned)"

## refresh regenerates EVERY gallery, and the tooltip shot is now its OWN native-Wayland lane
## (not part of comparison), so a `refresh` must run it too -- else `secure-terminal-shots-sandbox
## refresh` silently skips tooltip.webp despite the wrapper NOTE promising it. Re-run this driver
## for the tooltip lane with the trees ALREADY synced (assert-synced verifies), so refresh stays
## one command. A plain call (not exec): errexit aborts refresh if tooltip fails, and this run's
## EXIT trap still cleans its pull_tmp. Env (SECURE_TERMINAL_*/SANDBOX_TARGET) is inherited, so no
## positional site (which would be a host path, wrong inside the sandbox).
if [ "${refresh_all}" = 1 ]; then
   printf '%s\n' "secure-terminal-shots-sandbox: refresh -- regenerating the tooltip shot (native-Wayland) ..." >&2
   "${script_dir}/secure-terminal-shots-sandbox" tooltip --assume-synced
fi
