#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Regression suite for the secure-terminal comparison SHOTS harness (the shell capture
## pipeline in usr/share/secure-terminal-shots: lib-capture.sh + comparison-capture.sh
## + the secure-terminal-shots wrapper). No display, no real capture.
##
## The shots harness itself ships in dist-ai and is resolved checkout-relative, so the
## pure-shell payloads run anywhere. Some payloads drive the real secure-terminal app or
## the terminal-poc-corpus generators and read SECURE_TERMINAL_REPO / CORPUS_REPO plus
## PyQt6 / Pillow / coverage; those are REQUIRED subjects there and absent -> exit 1
## (FATAL, R-220), not SKIP. dist-ai-tests-all wires SECURE_TERMINAL_REPO / CORPUS_REPO
## via its secure-terminal-shots wire() case (component: secure-terminal), where the
## secure-terminal CI provides those checkouts and deps.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## Canonical suite exit (fail > skip > pass): a per-case skip surfaces as
## SKIP so the orchestrator's --allow-skip governs it, instead of being
## folded into a passing suite.
suite_exit_helper="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")/../share/dist-ai-tests-common/suite-exit.bash"
[ -r "${suite_exit_helper}" ] || suite_exit_helper='/usr/share/dist-ai-tests-common/suite-exit.bash'
# shellcheck source=../share/dist-ai-tests-common/suite-exit.bash
source "${suite_exit_helper}"

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/secure-terminal-shots-tests" ]; then
   tests_dir="${script_dir}/../share/secure-terminal-shots-tests"
else
   tests_dir='/usr/share/secure-terminal-shots-tests'
fi

## Run every *_test.sh. Exit 77 from a payload means SKIP (subject absent) and is not a
## failure; any other non-zero is a failure.
shopt -s nullglob
failures=0
skipped=0
env_unmet=0
ran=0
for test_script in "${tests_dir}"/*_test.sh; do
   ran=$(( ran + 1 ))
   name="$(basename -- "${test_script}")"
   printf '%s\n' '' "########## ${name} ##########"
   rc=0
   bash -- "${test_script}" "$@" || rc=$?
   if [ "${rc}" -eq 77 ]; then
      printf '%s\n' "########## SKIPPED: ${name} ##########"
      skipped=$(( skipped + 1 ))
   elif [ "${rc}" -eq 78 ]; then
      env_unmet=$(( env_unmet + 1 ))
   elif [ "${rc}" -ne 0 ]; then
      printf '%s\n' "########## FAILED (${rc}): ${name} ##########"
      failures=$(( failures + 1 ))
   fi
done

if [ "${ran}" -eq 0 ]; then
   printf '%s\n' "ERROR: no *_test.sh found in ${tests_dir}" >&2
   exit 1
fi
printf '%s\n' '' "${ran} secure-terminal-shots case(s): ${failures} failed, ${skipped} skipped, ${env_unmet} env-unmet"
suite_exit "${failures}" "${skipped}" "${env_unmet}"
