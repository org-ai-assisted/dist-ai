#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Regression suite for the secure-terminal comparison SHOTS harness (the shell capture
## pipeline in usr/share/secure-terminal-shots: lib-capture.sh + comparison-capture.sh
## + wayland-capture.sh + the secure-terminal-shots wrapper). No display, no real capture.
##
## The shots harness itself ships in dist-ai and is resolved checkout-relative, so the
## pure-shell payloads run anywhere. Some payloads drive the real secure-terminal app or
## the terminal-poc-corpus generators and read SECURE_TERMINAL_REPO / CORPUS_REPO plus
## PyQt6 / Pillow / coverage; those are REQUIRED subjects there and absent -> exit 1
## (FATAL, R-220), not SKIP. dist-ai-tests-all wires SECURE_TERMINAL_REPO / CORPUS_REPO
## via its secure-terminal-shots wire() case (component: secure-terminal), where the
## secure-terminal CI provides those checkouts and deps.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/secure-terminal-shots-tests" ]; then
   tests_dir="${script_dir}/../share/secure-terminal-shots-tests"
else
   tests_dir='/usr/share/secure-terminal-shots-tests'
fi

## Run every *_test.sh. Exit 77 from a payload means SKIP (subject absent) and is not a
## failure; any other non-zero is a failure.
shopt -s nullglob
failures=0
skipped=0
ran=0
for test_script in "${tests_dir}"/*_test.sh; do
   ran=$(( ran + 1 ))
   name="$(basename -- "${test_script}")"
   printf '%s\n' '' "########## ${name} ##########"
   rc=0
   bash -- "${test_script}" "$@" || rc=$?
   if [ "${rc}" -eq 77 ]; then
      printf '%s\n' "########## SKIPPED: ${name} ##########"
      skipped=$(( skipped + 1 ))
   elif [ "${rc}" -ne 0 ]; then
      printf '%s\n' "########## FAILED (${rc}): ${name} ##########"
      failures=$(( failures + 1 ))
   fi
done

if [ "${ran}" -eq 0 ]; then
   printf '%s\n' "ERROR: no *_test.sh found in ${tests_dir}" >&2
   exit 1
fi
if [ "${failures}" -ne 0 ]; then
   printf '%s\n' '' "FAILED: ${failures} secure-terminal-shots test script(s) failed" >&2
   exit 1
fi
## All payloads skipped means the SUITE skipped -- exit 77 so nothing reads as a false green.
## A required-dep absence is a per-payload FATAL (exit 1); this aggregate 77 is reached only
## when every payload independently, legitimately SKIPPED -- a genuine no-subject run.
if [ "${skipped}" -eq "${ran}" ]; then
   printf '%s\n' '' "SKIP: all ${skipped} secure-terminal-shots test script(s) skipped"
   ## style-ok: allow-skip: every payload independently reported a genuine SKIP (see above)
   exit 77
fi
printf '%s\n' '' 'OK: all secure-terminal-shots test scripts passed'
