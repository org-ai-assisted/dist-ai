#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Offline regression suite for the secure-terminal comparison SHOTS harness (the shell
## capture pipeline in usr/share/secure-terminal-shots: lib-capture.sh + comparison-capture.sh
## + wayland-capture.sh + the secure-terminal-shots wrapper). Pure shell, no display, no real
## capture -- runs in the dist-ai container in milliseconds.
##
## Each payload resolves its subject (the shots harness) and exits 77 (SKIP) if it is absent,
## never FAIL.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/secure-terminal-shots-tests" ]; then
   tests_dir="${script_dir}/../share/secure-terminal-shots-tests"
else
   tests_dir='/usr/share/secure-terminal-shots-tests'
fi

## Run every *_test.sh. Exit 77 from a payload means SKIP (subject absent) and is not a
## failure; any other non-zero is a failure.
shopt -s nullglob
failures=0
skipped=0
ran=0
for test_script in "${tests_dir}"/*_test.sh; do
   ran=$(( ran + 1 ))
   name="$(basename -- "${test_script}")"
   printf '%s\n' '' "########## ${name} ##########"
   rc=0
   bash -- "${test_script}" "$@" || rc=$?
   if [ "${rc}" -eq 77 ]; then
      printf '%s\n' "########## SKIPPED: ${name} ##########"
      skipped=$(( skipped + 1 ))
   elif [ "${rc}" -ne 0 ]; then
      printf '%s\n' "########## FAILED (${rc}): ${name} ##########"
      failures=$(( failures + 1 ))
   fi
done

if [ "${ran}" -eq 0 ]; then
   printf '%s\n' "ERROR: no *_test.sh found in ${tests_dir}" >&2
   exit 1
fi
if [ "${failures}" -ne 0 ]; then
   printf '%s\n' '' "FAILED: ${failures} secure-terminal-shots test script(s) failed" >&2
   exit 1
fi
## All payloads skipped means the SUITE skipped -- exit 77 so nothing reads as a false green.
if [ "${skipped}" -eq "${ran}" ]; then
   printf '%s\n' '' "SKIP: all ${skipped} secure-terminal-shots test script(s) skipped"
   exit 77
fi
printf '%s\n' '' 'OK: all secure-terminal-shots test scripts passed'
