#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Thin wrapper: coverage CHUNK 1 of the secure-terminal gate, as its OWN dist-ai-tests-all entry
## so it fits the 600s per-suite timeout. COLLECTS coverage for its suite subset into the shared
## per-run data dir -- NO assertion. The -combine entry unions all chunks + gates 100%. See
## secure-terminal-tests-coverage (ST_COV_TIER) for the whole gate + the chunk suite lists.
## style-ok: R-103 -- a thin wrapper is MEANT to exec the real runner unchanged.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

exec env ST_COV_TIER=chunk1 \
   "$(dirname -- "$(readlink --canonicalize -- "$0")")/secure-terminal-tests-coverage" "$@"
