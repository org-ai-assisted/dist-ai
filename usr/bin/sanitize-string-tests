#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Deep test + fuzz for the helper-scripts sanitize family (stdisplay,
## strip_markup, sanitize-string) as consumed by msgcollector's Qt dialog.
## Drives the real sanitize-string over an adversarial corpus and a biased
## fuzzer, asserting terminal-safety invariants, the no-'<' HTML-safety
## invariant, and a real-Qt cross-parser differential (no revived anchor or
## image). Proves the markup-injection bypass and that the strip_markup fix
## closes it. No root, no network; Qt runs offscreen and is skipped if PyQt5 is
## absent. Targets the installed sanitize-string by default; set
## SANITIZE_STRING_BIN / SANITIZE_ECHO_BIN to test a checkout / not-yet-installed fix. Extra args
## (e.g. --iterations N, --seed N) pass through to the harness.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/sanitize-string-tests" ]; then
   tests_dir="${script_dir}/../share/sanitize-string-tests"
else
   tests_dir='/usr/share/sanitize-string-tests'
fi

rc=0
python3 -- "${tests_dir}/sanitize_family_test.py" "$@" || rc=$?

## sanitize_echo_test.py is a unittest module, not a standalone script, and it
## subclasses TestStripMarkupBase from helper-scripts' own in-tree test package.
## Both that base class and the sanitize_echo module under test resolve from the
## helper-scripts dist-packages root already on PYTHONPATH (wire() sets it);
## tests_dir is prepended so the module itself is importable by name.
## Run unconditionally rather than short-circuiting on the first failure, so one
## broken family does not hide the other.

## The subject of this lane, sanitize_string/sanitize_echo.py, is shipped by the
## COMPONENT under test, so a component checkout older than the tool has no
## subject at all -- that is an absent-subject SKIP (77), the same verdict every
## other suite gives for a target it cannot resolve, not an ImportError that
## reads as a broken test suite.
## Probe the module SPEC, never a caught ImportError: a module that EXISTS but
## fails to import is a real defect and has to stay red. Widening this probe
## would turn every such defect into a silent skip.
subject_probe='
import importlib.util
import sys

try:
    spec = importlib.util.find_spec("sanitize_string.sanitize_echo")
except ImportError:
    spec = None
sys.exit(0 if spec is not None else 1)
'

echo_rc=0
subject_present='true'
PYTHONPATH="${tests_dir}${PYTHONPATH:+:${PYTHONPATH}}" \
   python3 -c "${subject_probe}" || subject_present='false'

if [ "${subject_present}" = 'false' ]; then
   printf '%s\n' 'SKIP: sanitize_echo lane: the component under test ships no sanitize_string/sanitize_echo.py, so there is no subject to test.' >&2
   echo_rc=77
else
   ## 'python3 -m unittest <module>' exits 0 when it collects ZERO tests. The
   ## TestCase base class is imported from helper-scripts, so a change in ANOTHER
   ## repo could empty this module and the suite would still report success.
   ## Require the run to say how many tests it ran.
   echo_out=''
   echo_out="$( PYTHONPATH="${tests_dir}${PYTHONPATH:+:${PYTHONPATH}}" \
      python3 -m unittest --verbose sanitize_echo_test 2>&1 )" || echo_rc=$?
   printf '%s\n' "${echo_out}"
   if [ "${echo_rc}" -eq 0 ]; then
      case "${echo_out}" in
         *'Ran 0 tests'*|*'Ran 0 test'*)
            printf '%s\n' 'FAIL: sanitize_echo_test collected ZERO tests -- the TestCase base class it imports from helper-scripts is gone or is no longer a TestCase.' >&2
            echo_rc=1
            ;;
         *'Ran '*)
            ;;
         *)
            printf '%s\n' 'FAIL: sanitize_echo_test produced no "Ran N tests" line; unittest did not run.' >&2
            echo_rc=1
            ;;
      esac
   fi
fi

## The two lanes get SEPARATE verdicts. Folding them into one status let the
## family test's 77 (absent subject) mask a lane in which 15 tests really ran and
## passed, reporting the whole suite as SKIP -- which a --component run then
## treats as an unauthorized skip, i.e. a failure.
## echo_rc 77 is the mirror case: the echo lane had no subject, so the family
## lane's verdict stands as the suite's on its own -- including its own 77 when
## neither lane had a subject and the whole suite is genuinely a SKIP.
if [ "${echo_rc}" -ne 77 ]; then
   if [ "${rc}" -eq 77 ] && [ "${echo_rc}" -eq 0 ]; then
      ## One lane skipped, the other genuinely passed: that is a pass, not a skip.
      rc=0
   elif [ "${echo_rc}" -ne 0 ]; then
      rc="${echo_rc}"
   fi
fi

exit "${rc}"
