#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Suite runner for qubes-whonix.
##
## Runs every *_test.sh in usr/share/qubes-whonix-tests and fails if any of
## them does. Discovery is a glob so a new lane needs no edit here.
##
## Targets the installed package by default; set QUBES_WHONIX_REPO to test a
## checkout. A lane that cannot resolve its subject exits 77 and is reported as
## SKIPPED, never folded into a pass. No root, no network.

## check_runtime.bsh provides was_executed + the strict-mode gate below. If it is
## absent the source fails BEFORE strict mode, was_executed is undefined (127), both
## guards read false, main never runs, and the suite exits 0 -- a false PASS for a
## file that was never tested. Fail loud (SKIP) instead. A source-able test
## caller runs in an env that HAS the helper, so the guard never fires there.
if [ ! -r /usr/libexec/helper-scripts/check_runtime.bsh ]; then
   printf '%s\n' 'qubes-whonix-tests: SKIP (helper-scripts check_runtime.bsh not found)' >&2
   exit 77
fi
source /usr/libexec/helper-scripts/check_runtime.bsh

if was_executed "${BASH_SOURCE[0]}"; then
   set -o errexit
   set -o nounset
   set -o pipefail
   set -o errtrace
   shopt -s inherit_errexit
   shopt -s shift_verbose
fi

main() {
   script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

   if [ -d "${script_dir}/../share/qubes-whonix-tests" ]; then
      tests_dir="${script_dir}/../share/qubes-whonix-tests"
   else
      tests_dir='/usr/share/qubes-whonix-tests'
   fi

   shopt -s nullglob
   case_scripts=( "${tests_dir}"/*_test.sh )
   shopt -u nullglob

   if [ "${#case_scripts[@]}" -eq 0 ]; then
      printf '%s\n' "FATAL: no case scripts found in '${tests_dir}'" >&2
      exit 1
   fi

   rc=0
   failed=0
   skipped=0
   for case_script in "${case_scripts[@]}"; do
      printf '%s\n' "== $(basename -- "${case_script}") =="
      case_rc=0
      "${case_script}" "$@" || case_rc=$?
      if [ "${case_rc}" -eq 77 ]; then
         skipped=$(( skipped + 1 ))
      elif [ "${case_rc}" -ne 0 ]; then
         failed=$(( failed + 1 ))
         rc=1
      fi
   done

   printf '%s\n' ""
   printf '%s\n' "${#case_scripts[@]} case(s), ${failed} failed, ${skipped} skipped"
   exit "${rc}"
}

if was_executed "${BASH_SOURCE[0]}"; then
   main "$@"
fi
