#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Thin VBox/VM-aware wrapper over the generic image-mount engine. Takes a VM NAME, resolves the
## VM's system disk image AND its qemu-nbd format (installed_disk_path + disk_format_for from
## vbox-vm-lib.bsh), then calls image-mount with an explicit --disk + pinned --format. This is the
## VBox layer that knows VM disks; image-mount itself is image-agnostic and never touches VBox.
##
## Mounts the disk read-WRITE, runs ONE caller command against the mounted filesystem, then always
## unmounts -- without booting the VM. Optionally unlocks a single LUKS volume (pass the install
## passphrase file). The VM MUST be powered off (image-mount refuses a VM-locked disk).
##
## Invoke via sudo: image-mount (qemu-nbd / cryptsetup / mount) must run as root. VBoxManage is
## PER-USER, so the VM-disk resolution is run as the INVOKING user (SUDO_USER) -- a sudo run's
## euid-0 / HOME=/root would otherwise read root's registry and miss the caller's VM (or hit a
## same-named root VM). The mount still runs as root. It has NO privleap action of its own.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"
FAIL_RC=1

## VBoxManage reads the per-user registry. When run under sudo (root + SUDO_USER), resolve the VM
## as the invoking user so the right registry is read; a direct (non-sudo) run uses the caller's
## own VBoxManage. A unit test overrides VBOXMANAGE with a stub path, which is used as-is.
vbox_manage() {
   if [ "$(id -u)" = '0' ] && [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != 'root' ]; then
      runuser -u "${SUDO_USER}" -- VBoxManage "$@"
   else
      VBoxManage "$@"
   fi
}
VBOXMANAGE="${VBOXMANAGE:-vbox_manage}"

vm=""
passphrase_file=""
cmd=()

usage() {
   printf '%s\n' "usage: ${me} run --vm NAME [--passphrase-file PATH] -- CMD [ARGS...]

run                resolve the VM's disk + format, mount it read-write, run CMD, then unmount.
--vm               VirtualBox VM name; its first attached writable disk is resolved, and the
                   qemu-nbd format is derived from the disk extension (never probed).
--passphrase-file  0600 file with the LUKS passphrase; given -> the disk's single LUKS
                   volume is opened read-WRITE before the filesystem search.
CMD [ARGS...]      run after '--' with \$MOUNTPOINT set and CWD = the mounted filesystem.

CMD and the disk image are TRUSTED: CMD runs as root and can follow a guest symlink out of the
mount. Power the VM off first. Run as root (via sudo)." >&2
}

## 2-arg die (code, message) -- the contract vbox-vm-lib.bsh's helpers call with FAIL_RC.
die() {
   printf '%s\n' "${me}: ERROR: ${2}" >&2
   exit "$1"
}

## VM-disk helpers (installed_disk_path + disk_format_for) -- single source shared with the
## offline boot-mode selector (grub-boot-select.bsh).
lib_dir="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")"
if [ -r "${lib_dir}/../libexec/image-test/vbox-vm-lib.bsh" ]; then
   vbox_vm_lib="${lib_dir}/../libexec/image-test/vbox-vm-lib.bsh"
else
   vbox_vm_lib='/usr/libexec/image-test/vbox-vm-lib.bsh'
fi
# shellcheck source=../libexec/image-test/vbox-vm-lib.bsh
source "${vbox_vm_lib}"

## The generic engine (overridable for tests).
if [ -n "${IMAGE_MOUNT:-}" ]; then
   image_mount="${IMAGE_MOUNT}"
elif [ -x "${lib_dir}/image-mount" ]; then
   image_mount="${lib_dir}/image-mount"
else
   image_mount='/usr/bin/image-mount'
fi

parse_args() {
   [ "${1:-}" = 'run' ] || { usage; die "${FAIL_RC}" "first argument must be the 'run' subcommand"; }
   shift
   while [ "$#" -gt 0 ]; do
      case "$1" in
         --vm)
            vm="$2"
            shift 2
            ;;
         --passphrase-file)
            passphrase_file="$2"
            shift 2
            ;;
         --)
            shift
            cmd=( "$@" )
            break
            ;;
         -h|--help)
            usage
            exit 0
            ;;
         *)
            usage
            die "${FAIL_RC}" "unexpected argument '$1'"
            ;;
      esac
   done
   [ -n "${vm}" ]         || { usage; die "${FAIL_RC}" "--vm required"; }
   [ "${#cmd[@]}" -gt 0 ] || { usage; die "${FAIL_RC}" "a command after '--' is required"; }
   [ -z "${passphrase_file}" ] || [ -r "${passphrase_file}" ] \
      || die "${FAIL_RC}" "passphrase file not readable: '${passphrase_file}'"
}

main() {
   parse_args "$@"

   local disk format
   disk="$(installed_disk_path "${vm}")"
   format="$(disk_format_for "${disk}")"

   local args=(run --disk "${disk}" --format "${format}")
   if [ -n "${passphrase_file}" ]; then
      args+=(--passphrase-file "${passphrase_file}")
   fi
   "${image_mount}" "${args[@]}" -- "${cmd[@]}"
}

## Sourced (a unit test) -> expose the functions without running; executed -> run.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
   main "$@"
fi
