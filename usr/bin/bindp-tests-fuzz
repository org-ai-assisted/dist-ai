#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Bounded smoke-fuzz of bindp's untrusted-input parsers. Compiles every
## usr/share/bindp-tests/fuzz_*.c harness with clang + libFuzzer + ASAN + UBSAN
## (each #includes the REAL usr/src/bindp/bindp.c via -I) and runs it for a short
## burst, failing on any crash, sanitizer report, or invariant assert. This is
## the fast regression smoke; the exhaustive proof of the same functions is the
## CBMC lane (bindp_cbmc.c), and the coverage-guided campaign would be a
## ClusterFuzzLite lane.
##
## Two dependency classes, deliberately different on absence:
##   * clang (+ the libFuzzer / ASAN / UBSAN runtimes in libclang-rt) is a
##     REQUIRED build tool: its absence is a FATAL environment bug, NEVER a skip.
##   * bindp.c (the subject, resolved from BINDP_REPO) is the OPTIONAL per-
##     component target: absent, there is nothing to fuzz and the suite SKIPs.
##
## BINDP_FUZZ_RUNS overrides the per-harness run count (default 30000).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/bindp-tests" ]; then
  tests_dir="${script_dir}/../share/bindp-tests"
else
  tests_dir='/usr/share/bindp-tests'
fi

repo="${BINDP_REPO:-}"
src_dir="${repo}/usr/src/bindp"
if [ -z "${repo}" ] || [ ! -f "${src_dir}/bindp.c" ]; then
  printf '%s\n' "SKIP: bindp-tests-fuzz: bindp.c not found (set BINDP_REPO)" >&2
  exit 77  ## style-ok: allow-skip: bindp source absent (not a --component run)
fi

if ! type -P clang >/dev/null; then
  printf '%s\n' "FATAL: clang not found -- declare it in dm-consumer.yml apt-packages" >&2
  exit 1
fi

runs="${BINDP_FUZZ_RUNS:-30000}"

work="$(mktemp --directory)"
# shellcheck disable=SC2317  # reached only via the EXIT trap
cleanup() {
  safe-rm --recursive --force -- "${work}"
}
trap cleanup EXIT

## LeakSanitizer needs ptrace, which the confined sandbox / CI container denies
## -- it fatal-errors at exit and libFuzzer reads that as a crash (a false red).
## This lane is a memory-safety + UB crash smoke, not leak detection. Put
## detect_leaks=0 LAST so it wins over any inherited ASAN_OPTIONS.
export ASAN_OPTIONS="${ASAN_OPTIONS:+${ASAN_OPTIONS}:}detect_leaks=0"
export UBSAN_OPTIONS="${UBSAN_OPTIONS:+${UBSAN_OPTIONS}:}halt_on_error=1:print_stacktrace=1"

fail=0
pass=0
for harness in "${tests_dir}"/fuzz_*.c; do
  name="$(basename --suffix=.c -- "${harness}")"
  binary="${work}/${name}"
  ## -fno-sanitize-recover=undefined makes a UBSAN finding abort (libFuzzer
  ## then reports a crash) rather than log-and-continue.
  clang -g -O1 \
    -fsanitize=fuzzer,address,undefined -fno-sanitize-recover=undefined \
    -I "${src_dir}" "${harness}" -o "${binary}"
  corpus="${work}/${name}.corpus"
  mkdir -p -- "${corpus}"
  log="${work}/${name}.log"
  if "${binary}" -runs="${runs}" -max_len=512 "${corpus}" >"${log}" 2>&1; then
    printf '%s\n' "PASS: ${name} (${runs} runs, no crash)"
    pass=$(( pass + 1 ))
  else
    printf '%s\n' "FAIL: ${name} crashed during smoke-fuzz" >&2
    tail -n 60 -- "${log}" >&2
    fail=$(( fail + 1 ))
  fi
done

if [ "${pass}" -eq 0 ]; then
  printf '%s\n' "FAIL: no bindp fuzz harnesses were built" >&2
  exit 1
fi
printf '%s\n' "bindp-tests-fuzz: ${pass} pass, ${fail} fail, 0 skip"
[ "${fail}" -eq 0 ]
