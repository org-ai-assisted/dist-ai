#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Release leaked nbd devices and the mounts sitting on them.
##
## WHY THIS EXISTS: image comparison and inspection run inside the
## derivative-maker container, which is torn down with SIGKILL. Its EXIT traps
## therefore never run, and because the container is --privileged with /dev
## shared, the mounts it made survive in the HOST namespace. The next inspection
## then attaches a DIFFERENT image to the same /dev/nbdN while a stale mount
## still points at it, and every read returns EIO -- which looks like a corrupt
## image rather than a stale mount.
##
## Cost when that happened: a debugging detour chasing "I/O error" on a
## perfectly good CI image. The tell is the same device appearing twice in
## `mount`, one of them at a path nobody remembers creating.
##
## Idempotent and safe to run before any image inspection. Refuses nothing,
## reports everything.
##
## Usage: dm-nbd-cleanup [--dry-run]

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

dry_run=false

while [ "$#" -gt 0 ]; do
   case "$1" in
      --dry-run)
         dry_run=true
         shift
         ;;
      -h|--help)
         grep '^##' -- "${BASH_SOURCE[0]}" | sed 's/^## \{0,1\}//'
         exit 0
         ;;
      *)
         printf '%s\n' "${0##*/}: unknown argument: '$1'" >&2
         exit 2
         ;;
   esac
done

if [ ! -e /dev/nbd0 ]; then
   printf '%s\n' "${0##*/}: no /dev/nbd* devices; nothing to release."
   exit 0
fi

## Unmount FIRST, then disconnect. A disconnect while a mount still holds the
## device is what leaves the unreadable half-state this exists to clear.
released_mounts=0
while IFS= read -r mount_point; do
   [ -n "${mount_point}" ] || continue
   if [ "${dry_run}" = "true" ]; then
      printf '  would umount %s\n' "${mount_point}"
      released_mounts=$(( released_mounts + 1 ))
      continue
   fi
   ## --lazy: a container that died mid-read can leave a process holding the
   ## mount, and EBUSY here would leave exactly the state being cleaned up.
   if sudo --non-interactive umount --lazy -- "${mount_point}" 2>/dev/null; then
      printf '  umounted %s\n' "${mount_point}"
      released_mounts=$(( released_mounts + 1 ))
   else
      printf '  FAILED to umount %s\n' "${mount_point}" >&2
   fi
done < <( mount | sed -n 's|^\(/dev/nbd[0-9p]*\) on \([^ ]*\) .*|\2|p' )

released_devices=0
for nbd_device in /dev/nbd[0-9] /dev/nbd[0-9][0-9]; do
   [ -e "${nbd_device}" ] || continue
   ## An unconnected device has size 0, so only touch the ones actually in use.
   size_path="/sys/block/${nbd_device##*/}/size"
   [ -r "${size_path}" ] || continue
   if [ "$( cat -- "${size_path}" )" = "0" ]; then
      continue
   fi
   if [ "${dry_run}" = "true" ]; then
      printf '  would disconnect %s\n' "${nbd_device}"
      released_devices=$(( released_devices + 1 ))
      continue
   fi
   if sudo --non-interactive qemu-nbd --disconnect "${nbd_device}" >/dev/null 2>&1; then
      printf '  disconnected %s\n' "${nbd_device}"
      released_devices=$(( released_devices + 1 ))
   else
      printf '  FAILED to disconnect %s\n' "${nbd_device}" >&2
   fi
done

printf '%s: %s mount(s), %s device(s)%s\n' \
   "${0##*/}" "${released_mounts}" "${released_devices}" \
   "$( [ "${dry_run}" = "true" ] && printf ' (dry run)' || true )"
