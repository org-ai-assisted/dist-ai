#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Build a derivative-maker ISO locally on the test server in a clean, ISOLATED,
## scheme-compliant way -- the non-ad-hoc replacement for hand-run build wrappers.
##
## Runs as root. For GUEST it:
##   1. ensures the dedicated build account persist-bild-<guest> (dm-build-account) --
##      privileged + networked, outside the install-account leak-drop;
##   2. seeds that account's OWN derivative-maker checkout from a reference checkout
##      (rsync; source + .git + submodules, NOT the separate derivative-binary output),
##      so builds never share admin's tree;
##   3. AS the account: SIGNS HEAD with an ephemeral key (signing-key-create + sign-and-tag)
##      so git_sanity_test passes legitimately -- no goodlist / ignore-flag hacks;
##   4. builds AS the account with its own HOMEVAR and dist_build_slot=persist-bild-<guest>
##      (per-slot cowbuilder base -> parallel-safe);
##   5. prints the built ISO path on the last line (for dm-release-test --iso).
##
## Local test build: --repo false (LOCAL packages, so a patched submodule lands in the
## ISO) and --sign-and-tag true (output signed; never --allow-unsigned, which is
## policy-refused for AI).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"

die() {
   printf '%s\n' "${me}: ERROR: ${2}" >&2
   exit "$1"
}

## Resolve the sibling provisioner by a SELF-ANCHORED path, not a bare name: in a checkout
## it is not on PATH (both live in the same bin dir, installed or in-tree).
dm_developers_build_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"
DM_BUILD_ACCOUNT="${DM_BUILD_ACCOUNT:-${dm_developers_build_dir}/dm-build-account}"
source_checkout="${DM_SOURCE_CHECKOUT:-/home/admin/derivative-maker}"
flavor=''

print_usage() {
   printf '%s\n' "Usage: ${me} <kicksecure|whonix> [--flavor FLAVOR] [--source-checkout DIR]

Build a <flavor> ISO as the dedicated persist-bild-<guest> account (default flavor
kicksecure-lxqt for kicksecure; whonix has no default, pass e.g. whonix-gateway-lxqt;
FLAVOR must belong to GUEST). Seeds the account's checkout from --source-checkout (default
/home/admin/derivative-maker). Prints the built ISO path on the last line. Must run as root."
}

case "${1:-}" in
   kicksecure | whonix)
      guest="$1"
      shift
      ;;
   -h | --help)
      print_usage
      exit 0
      ;;
   *)
      print_usage >&2
      die 2 "GUEST must be kicksecure or whonix, got '${1:-}'"
      ;;
esac

while [ "$#" -ge 1 ]; do
   case "$1" in
      --flavor)
         flavor="$2"
         shift 2
         ;;
      --source-checkout)
         source_checkout="$2"
         shift 2
         ;;
      *)
         die 2 "unknown option '$1'"
         ;;
   esac
done

## The ISO flavor of each guest, so 'whonix' never silently builds a Kicksecure image.
## Whonix has no single ISO (gateway and workstation are separate flavors, and
## derivative-maker does not implement whonix-host-*), so it must be named explicitly.
if [ -z "${flavor}" ]; then
   case "${guest}" in
      kicksecure)
         flavor='kicksecure-lxqt'
         ;;
      whonix)
         die 2 "guest whonix needs --flavor (e.g. whonix-gateway-lxqt or whonix-workstation-lxqt)"
         ;;
   esac
fi
case "${flavor}" in
   "${guest}"-*)
      ;;
   *)
      die 2 "flavor '${flavor}' does not belong to guest '${guest}'"
      ;;
esac

[ "$(id -u)" = '0' ] || die 1 "must run as root"
[ -d "${source_checkout}/.git" ] || die 2 "source checkout '${source_checkout}' is not a git checkout"

## 1. ensure the build account; capture its name from the helper's last line.
account="$("${DM_BUILD_ACCOUNT}" "${guest}" | tail -1)"
case "${account}" in
   persist-bild-*)
      ;;
   *)
      die 1 "dm-build-account did not yield a persist-bild-* name: '${account}'"
      ;;
esac
home="$(getent passwd "${account}" | cut -d: -f6)"
[ -n "${home}" ] || die 1 "cannot resolve home for ${account}"
checkout="${home}/derivative-maker"
binary_out="${home}/derivative-binary"

## 2a. The ISO version comes from `git describe`, which needs the RELEASE TAGS present.
## A seed checkout can lack newer release tags (it only carries whatever tags it fetched),
## so describe falls back to an older tag and the ISO is MISLABELLED (e.g. 18.2.3.3 when
## the tip is really 18.2.3.6). Fetch tags into the reference AS ITS OWNER (which holds the
## remote credentials; the build account does not) BEFORE seeding, so the slot inherits a
## complete tag set and describes the correct version. Fail LOUD when the fetch fails or
## the describe is not a release tag. A remote that itself lacks the newest release tag
## still yields an older, valid-looking describe; that case is not detectable here.
## Same describe as derivative-maker's version derivation: annotated tags only, and
## '--exclude *_*_*' skips the ephemeral '<tag>_<commit>_<fingerprint>' tags that
## help-steps/sign-tag-head leaves on locally signed builds (release tags carry no
## underscore).
ref_owner="$(stat -c '%U' "${source_checkout}")"
runuser -u "${ref_owner}" -- git -C "${source_checkout}" fetch --tags --quiet \
   || die 1 "tag fetch into ${source_checkout} failed; refusing to build with a possibly stale version label"
desc="$(runuser -u "${ref_owner}" -- git -C "${source_checkout}" describe --exclude '*_*_*' 2>/dev/null || true)"
## Anchored: a dotted numeric version, exactly one channel suffix, then at most git's
## '-<count>-g<sha>' tail -- so a tag like '18.2.3.6-stable-backup' is not a release.
release_describe_regex='^[0-9]+(\.[0-9]+)*-(developers-only|testers-only|stable)(-[0-9]+-g[0-9a-f]+)?$'
[[ "${desc}" =~ ${release_describe_regex} ]] \
   || die 1 "reference describe is '${desc:-<none>}', not a release tag (developers-only, testers-only or stable); release tags are missing and the ISO version label would be wrong"
printf '%s\n' "${me}: reference describes as ${desc}"

## 2b. seed the account's own checkout (source + .git + submodules; NOT derivative-binary).
printf '%s\n' "${me}: seeding ${account} checkout from ${source_checkout}"
rsync --archive --delete --hard-links "${source_checkout}/" "${checkout}/"
chown --recursive "${account}:${account}" "${checkout}"

## 3 + 4. sign HEAD then build, AS the account, with its own slot. The per-account build
## log lives in the account's OWN home (not /var/tmp): the account creates+writes it
## directly, so there is no cross-owner write into a sticky world-writable dir (which
## fs.protected_regular=2 blocks even for root). A durable supervisor watches it grow.
log="${home}/derivative-build.log"

## ISO set BEFORE the build, keyed by path + inode + ctime: the freshly built ISO is the
## key present AFTER but not before. A rebuild of the same version reuses the PATH (the
## output dir persists), so path alone misses it; ctime, unlike mtime (which reproducible
## builds clamp to a fixed past), always moves on a rewrite.
iso_snapshot() {
   find "${binary_out}" -name '*.Intel_AMD64.iso' -printf '%p\t%i\t%C@\n' 2>/dev/null | sort
}
mkdir --parents -- "${binary_out}"
chown "${account}:${account}" "${binary_out}"
before="$(iso_snapshot)"

## Values reach the account's shell via `env` (NOT spliced into the single-quoted program
## -- that quote-nesting silently eats values). The inner program reads them from the
## environment; a login shell keeps exported vars.
build_rc=0
## The single-quoted program below is intentional: its DM_* / $(date) refs expand in the
## INNER account shell (DM_* come from the env above), not in this one.
# shellcheck disable=SC2016
runuser -u "${account}" -- \
   env DM_LOGF="${log}" DM_ACCT="${account}" DM_FLAV="${flavor}" \
   bash -lc '
   set -o errexit
   set -o nounset
   set -o pipefail
   cd ~/derivative-maker || exit 1
   exec >"${DM_LOGF}" 2>&1
   printf "SIGN-START %s\n" "$(date -u +%FT%TZ)"
   export dist_build_sign_and_tag=true
   export dist_build_unlock_dangerous_options=true
   ./help-steps/signing-key-create
   ./help-steps/sign-and-tag
   printf "BUILD-START %s\n" "$(date -u +%FT%TZ)"
   user_name="${DM_ACCT}" \
   dist_build_slot="${DM_ACCT}" \
   make_lintian_fail_open_versus_closed=open \
   dist_build_ignore_uncommitted=true \
      ./derivative-maker \
         --flavor "${DM_FLAV}" --arch amd64 --target iso \
         --freshness frozen --type vm --freedom false \
         --allow-uncommitted true --sign-and-tag true \
         --repo false --skip-published-packages true
   printf "BUILD-DONE %s\n" "$(date -u +%FT%TZ)"
' || build_rc=$?

if [ "${build_rc}" -ne 0 ]; then
   printf '%s\n' "${me}: build FAILED (rc=${build_rc}); see ${log}" >&2
   exit "${build_rc}"
fi

## 5. locate the freshly built (new or rewritten) ISO by set difference against the
## pre-build snapshot. Exactly one ISO per build.
after="$(iso_snapshot)"
changed="$(comm -13 <(printf '%s\n' "${before}") <(printf '%s\n' "${after}") | cut -f1)"
if [ -z "${changed}" ]; then
   die 1 "no new or rewritten ISO appeared under ${binary_out} after the build"
fi
## More than one changed ISO is ambiguous: never guess which one this build produced.
[ "$(printf '%s\n' "${changed}" | wc -l)" -eq 1 ] \
   || die 1 "more than one ISO changed under ${binary_out} during the build: ${changed//$'\n'/ }"
iso="${changed}"
[ -f "${iso}" ] || die 1 "built ISO ${iso} is not a regular file"

printf '%s\n' "${me}: built ${iso}"
printf '%s\n' "${iso}"
