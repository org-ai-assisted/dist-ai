#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Runs tb-updater's core tests (pytest): the GUI-mode wiring contract between
## update-torbrowser and the msgcollector dialogs, and update-torbrowser's
## input-routing logic. Drives the REAL shipped code -- runs the desktop wrapper
## with a stub update-torbrowser, and sources update-torbrowser's confirmation
## functions and drives their TB_INPUT dispatch with a stub dialog -- so no
## install, no network, no display are needed. Works installed
## (/usr/share/tb-updater-tests) or from a git checkout. The tb-updater scripts
## under test are resolved by tb_updater_testlib (TB_UPDATER_REPO=<checkout>
## else the installed scripts).

## check_runtime.bsh provides was_executed + the strict-mode gate below. If it is
## absent the source fails BEFORE strict mode, was_executed is undefined (127), both
## guards read false, main never runs, and the suite exits 0 -- a false PASS for a
## file that was never tested. Fail loud (SKIP) instead. A source-able test
## caller runs in an env that HAS the helper, so the guard never fires there.
## Resolve it from HELPER_SCRIPTS_PATH (the wire's helper-scripts checkout),
## falling back to the installed path -- in CI nothing is installed.
[ -v HELPER_SCRIPTS_PATH ] || HELPER_SCRIPTS_PATH=""
check_runtime_bsh="${HELPER_SCRIPTS_PATH:+${HELPER_SCRIPTS_PATH%/}}/usr/libexec/helper-scripts/check_runtime.bsh"
if [ ! -r "${check_runtime_bsh}" ]; then
   printf '%s\n' "tb-updater-tests: SKIP (helper-scripts check_runtime.bsh not found at '${check_runtime_bsh}')" >&2
   exit 77
fi
# shellcheck disable=SC1090  # dynamic path: check_runtime.bsh from the checkout or install
source "${check_runtime_bsh}"

if was_executed "${BASH_SOURCE[0]}"; then
   set -o errexit
   set -o nounset
   set -o pipefail
   set -o errtrace
   shopt -s inherit_errexit
   shopt -s shift_verbose
   export LC_ALL=C
fi

main() {
   script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

   if [ -d "${script_dir}/../share/tb-updater-tests" ]; then
      tests_dir="${script_dir}/../share/tb-updater-tests"
   else
      tests_dir='/usr/share/tb-updater-tests'
   fi

   ## Resolve the target up front. When the tb-updater checkout/install cannot be
   ## found, the test modules skip at import with a module-level pytest.skip -- for
   ## which pytest exits 0, not 5 -- so the suite would report PASS though nothing
   ## ran. Detect the unavailable target here and report SKIP (77) instead.
   if ! python3 -c "import sys; sys.path.insert(0, '${tests_dir}'); \
import tb_updater_testlib as T; T.update_torbrowser_script(); \
T.desktop_starter_wrapper()"; then
      exit 77
   fi

   rc=0
   python3 -m pytest --import-mode=importlib -q "${tests_dir}" "$@" || rc=$?
   ## pytest exit 5 = no tests collected; report the suite as SKIP (77), not a
   ## failure.
   if [ "${rc}" = "5" ]; then
      exit 77
   fi
   exit "${rc}"
}

if was_executed "${BASH_SOURCE[0]}"; then
   main "$@"
fi
