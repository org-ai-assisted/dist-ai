#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Formal-verification (CBMC) suite for kloak's pure arithmetic. Reuses kloak's
## existing KLOAK_FUZZING seam to compile the REAL src/kloak.c -- no source
## change. The subject is resolved by the test from:
##   * KLOAK_REPO=/path/to/kloak -> that checkout's src/ + protocol/, OR
##   * unset -> '/' (kloak.c under /src, i.e. a missing subject -> SKIP).
##
## Needs cbmc, wayland-scanner and the wayland/libinput/libevdev/xkbcommon dev
## headers (declared in kloak's dm-consumer.yml apt-packages). Their absence is
## a FATAL environment bug, not a skip.
##
## Any extra arguments are forwarded to "python3 -m unittest".

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/kloak-tests" ]; then
   tests_dir="${script_dir}/../share/kloak-tests"
else
   tests_dir='/usr/share/kloak-tests'
fi

## Driven through run-unittest.py so a subject-absent run (the whole suite
## skips from setUpClass when KLOAK_REPO lacks src/kloak.c) surfaces as a skip
## exit (78), not a bare `unittest discover` exit 0 the orchestrator reads as a
## false-green PASS.
run_unittest="${script_dir}/../share/dist-ai-tests-common/run-unittest.py"
[ -r "${run_unittest}" ] || run_unittest='/usr/share/dist-ai-tests-common/run-unittest.py'

"${run_unittest}" \
   --start-directory "${tests_dir}" \
   --pattern 'test_*.py' \
   "$@"
