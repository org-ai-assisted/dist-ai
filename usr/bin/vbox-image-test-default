#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## The DEFAULT VBox image-test batch -- a CONSERVATIVE set of the important lanes, run + published
## in one command via vbox-image-test. This encodes the lane-importance policy:
##
##   Each lane carries the MANDATORY --source: kicksecure is --source built when --iso is given
##   (tests THIS build), else --source official; the whonix lanes are --source official (the
##   pre-imported release pair).
##   DEFAULT (run every batch):
##     - kicksecure lxqt  EFI+SecureBoot  (built --iso if given, else --channel release) <- flagship
##     - kicksecure lxqt  BIOS            (legacy boot must stay tested)
##     - whonix     lxqt  BIOS  --lane inst   (Whonix primary real usage = VBox BIOS)
##     - whonix     lxqt  BIOS  --lane leak   (network-isolation leak battery)
##     - whonix     cli   BIOS  --lane inst   (CLI edition; its gateway is the CLI gateway)
##
##   INTENDED-BUT-NOT-YET-SUPPORTED:
##     - kicksecure VM-IMAGE (OVA) lxqt EFI -- dm-release-test has NO kicksecure OVA-import path
##       (kicksecure = ISO download+install only); needs a new harness lane before it can default.
##
##   OPT-IN ONLY (never in the default set; add with a flag):
##     --coreboot-rom R  the kicksecure coreboot/dasharo firmware lane (efi, ROM at R)
##     --add 'LANE'      any extra raw dm-release-test lane (repeatable)
##
## Whonix lanes use the pre-imported pairs, so they assume those pairs are provisioned at the
## resolved --channel version (re-provision a stale pair; see dm-release-test --provision).
## The whonix INST lanes in particular need a pre-provisioned pair at the resolved version, so
## with --channel developers run `dm-release-test <guest> <iface> --lane inst --provision ...`
## FIRST -- a developers INST lane has no blessed stable pin to fall back on.
##
## A full batch EXECUTES the real multi-hour OVH server-exec jobs merely by invoking this tool;
## pass --dry-run (alias --print-lanes) to print the resolved lanes and exit WITHOUT running them.
##
## Usage: vbox-image-test-default [--iso KS_ISO] [--channel stable|developers]
##                                [--coreboot-rom ROM] [--add 'LANE']... [--no-publish] [--dry-run]
## A full batch is HOURS -- drive it durably under bgjob-run.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"

usage() {
   printf '%s\n' \
      "Usage: ${me} [--iso KS_ISO] [--channel stable|developers] [--version VER] [--coreboot-rom ROM] [--add 'LANE']... [--no-publish] [--dry-run]" \
      "Runs the DEFAULT lane batch (kicksecure lxqt EFI+SecureBoot + BIOS; whonix lxqt BIOS inst + leak;" \
      "whonix cli BIOS inst) then publishes once (via vbox-image-test)." \
      "--version VER is REQUIRED with --channel developers (whonix developers OVAs are not auto-discoverable);" \
      "it is threaded into the whonix lanes only. The whonix INST lanes need a pre-provisioned pair at the" \
      "resolved version (with --channel developers, run dm-release-test ... --lane inst --provision first)." \
      "--dry-run (alias --print-lanes): print the resolved lanes and exit WITHOUT running the OVH batch." \
      "Opt-in: --coreboot-rom ROM, --add 'LANE'." \
      "A full batch is HOURS -- drive it durably under bgjob-run."
}

iso=""
channel="stable"
version=""
coreboot_rom=""
no_publish="false"
dry_run="false"
extra=()

while [ "$#" -ge 1 ]; do
   case "$1" in
      --iso)
         [ "$#" -ge 2 ] || { printf '%s\n' "${me}: --iso needs a path" >&2; exit 64; }
         ## A lane is a single space-joined string that the remote shell re-splits into
         ## dm-release-test args, so a path with whitespace mis-splits (and vbox-image-test
         ## cannot embed a space in one token). Reject it early rather than fail cryptically.
         case "$2" in
            *[[:space:]]*)
               printf '%s\n' "${me}: --iso path must not contain whitespace" >&2
               exit 64
               ;;
         esac
         iso="$2"
         shift 2
         ;;
      --channel)
         [ "$#" -ge 2 ] || { printf '%s\n' "${me}: --channel needs stable|developers" >&2; exit 64; }
         channel="$2"
         shift 2
         ;;
      --version)
         [ "$#" -ge 2 ] || { printf '%s\n' "${me}: --version needs a value" >&2; exit 64; }
         ## --version is threaded verbatim into a lane spec that the remote side re-splits on
         ## whitespace into dm-release-test args; a value with a space would inject extra options
         ## (e.g. --version '18.9 --lane leak' turns an inst lane into a leak lane). Reject it.
         case "$2" in
            *[[:space:]]*)
               printf '%s\n' "${me}: --version must not contain whitespace (would inject extra dm-release-test options)" >&2
               exit 64
               ;;
         esac
         version="$2"
         shift 2
         ;;
      --coreboot-rom)
         [ "$#" -ge 2 ] || { printf '%s\n' "${me}: --coreboot-rom needs a ROM path" >&2; exit 64; }
         case "$2" in
            *[[:space:]]*)
               printf '%s\n' "${me}: --coreboot-rom path must not contain whitespace" >&2
               exit 64
               ;;
         esac
         coreboot_rom="$2"
         shift 2
         ;;
      --add)
         [ "$#" -ge 2 ] || { printf '%s\n' "${me}: --add needs a 'LANE' string" >&2; exit 64; }
         extra+=("$2")
         shift 2
         ;;
      --no-publish)
         no_publish="true"
         shift
         ;;
      --dry-run | --print-lanes)
         dry_run="true"
         shift
         ;;
      -h | --help)
         usage
         exit 0
         ;;
      *)
         printf '%s\n' "${me}: unknown argument '$1' (see --help)" >&2
         exit 64
         ;;
   esac
done

## Validate the channel enum locally so a real run AND --dry-run reject the same inputs -- else
## --dry-run would print lanes carrying an invalid --channel that every lane then rejects.
case "${channel}" in
   stable | developers)
      true
      ;;
   *)
      printf '%s\n' "${me}: --channel must be stable|developers, got '${channel}'" >&2
      exit 64
      ;;
esac

## Whonix developers builds publish OVAs, not an auto-discoverable ISO index, so dm-release-test
## cannot resolve a whonix developers version without --version. Reject early (before a HOURS-long
## batch) rather than emit whonix lanes that die at version resolution.
if [ "${channel}" = 'developers' ] && [ -z "${version}" ]; then
   printf '%s\n' "${me}: --channel developers needs --version VER for the whonix lanes (whonix developers OVAs are not auto-discoverable)" >&2
   exit 64
fi

## The flagship Kicksecure source + its MANDATORY --source: a built ISO when given (tests THIS
## build, --source built), else the published release (--source official, --channel picks the
## stream). Kicksecure auto-discovers its version per channel, so --version is NOT threaded here.
ks_src="--source official --channel ${channel}"
[ -z "${iso}" ] || ks_src="--source built --iso ${iso}"

## Whonix source: the pre-imported release pair (--source official). --version, when given, is
## threaded ONLY here -- the whonix lanes need it for developers, and a whonix version must not
## pin kicksecure's. Firmware is applied to the imported pair by dm-release-test.
whonix_src="--source official --channel ${channel}"
[ -z "${version}" ] || whonix_src="${whonix_src} --version ${version}"

lanes=(
   "kicksecure lxqt ${ks_src} --firmware efi-secureboot"
   "kicksecure lxqt ${ks_src} --firmware bios"
   "whonix lxqt --lane inst ${whonix_src} --firmware bios"
   "whonix lxqt --lane leak ${whonix_src} --firmware bios"
   "whonix cli --lane inst ${whonix_src} --firmware bios"
)

## Opt-in additions.
[ -z "${coreboot_rom}" ] || lanes+=( "kicksecure lxqt ${ks_src} --firmware efi --coreboot-rom ${coreboot_rom}" )
[ "${#extra[@]}" -eq 0 ] || lanes+=( "${extra[@]}" )

args=()
[ "${no_publish}" = "false" ] || args+=( --no-publish )

## Safe inspection path: running this tool otherwise EXECUTES the real multi-hour OVH batch,
## so --dry-run prints the resolved lanes and exits WITHOUT touching vbox-image-test.
if [ "${dry_run}" = "true" ]; then
   printf '%s\n' "${lanes[@]}"
   exit 0
fi

vbox-image-test "${args[@]}" "${lanes[@]}"
