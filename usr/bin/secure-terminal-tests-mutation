#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Targeted mutation-testing lane for secure-terminal's security-critical code
## (sanitize.py paste + marking boundaries, the terminal.py paste path). Applies a
## hand-picked set of high-value mutants to a COPY of the real package, runs the
## REAL killer suite for each, and asserts each mutant is KILLED. Nothing is written
## back to the source tree. TRUSTED TOOLING: needs an ai-review pass before a CI
## gate relies on its verdict.
##
## The secure_terminal checkout IS the target under test, so an absent checkout is
## FATAL (exit 1) unless the caller authorized the skip (DIST_AI_SKIP_AUTHORIZED=1),
## in which case it SKIPs (exit 77).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

if [ -d "${script_dir}/../share/secure-terminal-tests" ]; then
   tests_dir="${script_dir}/../share/secure-terminal-tests"
else
   tests_dir='/usr/share/secure-terminal-tests'
fi

repo=''
[ -v SECURE_TERMINAL_REPO ] || SECURE_TERMINAL_REPO=''
if [ -n "${SECURE_TERMINAL_REPO}" ]; then
   repo="${SECURE_TERMINAL_REPO}"
elif [ -d "${HOME}/private-sources/secure-terminal/usr/lib/python3/dist-packages/secure_terminal" ]; then
   repo="${HOME}/private-sources/secure-terminal"
elif [ -d "${script_dir}/../../../../secure-terminal/usr/lib/python3/dist-packages/secure_terminal" ]; then
   repo="${script_dir}/../../../../secure-terminal"
fi

if [ -z "${repo}" ] || [ ! -d "${repo}/usr/lib/python3/dist-packages/secure_terminal" ]; then
   ## The secure_terminal checkout IS the target under test. Absent, there is nothing to
   ## test -- but a bare SKIP reads green, so an absent target is FATAL unless the run that
   ## invoked us authorized the skip: DIST_AI_SKIP_AUTHORIZED=1, which dist-ai-tests-all
   ## sets for a --allow-skip'd (or lenient non-strict) run. The gate/CI env always provides
   ## the checkout, so there it simply runs; a standalone or unauthorized run FATALs.
   if [ "${DIST_AI_SKIP_AUTHORIZED:-}" = '1' ]; then
      printf '%s\n' 'secure-terminal-tests-mutation: SKIP (secure_terminal not found; set SECURE_TERMINAL_REPO) [authorized]' >&2
      ## style-ok: allow-skip: target checkout absent AND the skip was authorized by the orchestrator
      exit 77
   fi
   printf '%s\n' 'secure-terminal-tests-mutation: FATAL: secure_terminal not found; set SECURE_TERMINAL_REPO (unauthorized absent-target skip)' >&2
   exit 1
fi

export SECURE_TERMINAL_REPO="${repo}"
export QT_QPA_PLATFORM=offscreen
"${tests_dir}/mutation_lane.py" "$@"
