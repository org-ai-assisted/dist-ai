## Only what EVERY suite needs to start. The per-suite extras are Suggests, not
## Depends, because each suite exits 77 (SKIP) when its subject or its tooling is
## absent -- so a lean install degrades to "that suite skipped", never to a
## broken run. Pulling qemu, both Qt bindings, playwright, weston and chromium
## onto every machine that wants one shell test would be the wrong trade.
Depends: ${misc:Depends},
 bash (>= 4),
 python3,
 git,
 grep,
 sed,
 diffutils,
 helper-scripts,
 safe-rm
